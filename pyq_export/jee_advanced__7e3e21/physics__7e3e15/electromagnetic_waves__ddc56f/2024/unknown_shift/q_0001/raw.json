  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned} & \\frac{1}{\\lambda_\\alpha}=\\frac{3}{4} R(Z-1)^2 p \\\\ & \\lambda_{\\text {cut }}=\\frac{h c}{e V} \\\\ & \\Rightarrow \\text { Ratio } \\propto \\frac{1}{(Z-1)^2} \\text { for same beam } \\\\ & \\frac{Z}{x}=\\frac{40^2}{45^2} \\\\ & \\Rightarrow x=\\frac{45^2}{40^2} .2 \\approx 2.53 \\end{aligned}\\)",
    "image": null
