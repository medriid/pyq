    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>22</mn><mo>&#177;</mo><mn>0</mn><mo>.</mo><mn>02</mn><mi>mm</mi><mo>,</mo><mo>&#160;</mo><mi>&#960;</mi><mfenced><mrow><mn>1</mn><mo>.</mo><mn>23</mn><mo>&#160;</mo><mo>&#177;</mo><mo>&#160;</mo><mn>0</mn><mo>.</mo><mn>02</mn></mrow></mfenced><msup><mi>mm</mi><mn>2</mn></msup></math>",
