    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>22</mn><mo>&#177;</mo><mn>0</mn><mo>.</mo><mn>01</mn><mi>mm</mi><mo>,</mo><mi>&#960;</mi><mfenced><mrow><mn>1</mn><mo>.</mo><mn>23</mn><mo>&#177;</mo><mn>0</mn><mo>.</mo><mn>01</mn></mrow></mfenced><msup><mi>mm</mi><mn>2</mn></msup></math>",
      "is_correct": false
