mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mo>⇒</mo><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><msqrt><mfrac><mrow><mn>3</mn><mi>h</mi></mrow><mrow><mi>g</mi><mi> </mi><msup><mi>sin</mi><mn>2</mn></msup><mtext>θ</mtext></mrow></mfrac></msqrt><mo>=</mo><msqrt><mfrac><mrow><mn>4</mn><mi>h</mi></mrow><mi>g</mi></mfrac></msqrt></math><br ><math><mo>⇒</mo><mi> </mi><mi> </mi><msqrt><mfrac><mrow><mn>16</mn><mi>h</mi></mrow><mrow><mn>3</mn><mi>g</mi></mrow></mfrac></msqrt><mo>-</mo><msqrt><mfrac><mrow><mn>4</mn><mi>h</mi></mrow><mrow><mi>g</mi></mrow></mfrac></msqrt><mo>=</mo><mfrac><mrow><mn>2</mn><mo>-</mo><msqrt><mn>3</mn></msqrt></mrow><mrow><msqrt><mn>10</mn></msqrt></mrow></mfrac></math><br ><math><msqrt><mi>h</mi></msqrt><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mn>4</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><mn>2</mn><mo>-</mo><msqrt><mn>3</mn></msqrt></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mi>h</mi></msqrt><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mo>-</mo><msqrt><mn>3</mn></msqrt></mrow></mfenced><msqrt><mn>3</mn></msqrt></mrow><mfenced separators=\"|\"><mrow><mn>4</mn><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></mrow></mfenced></mfrac><mo>=</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mo>⇒</mo><mi>h</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac><mo>=</mo><mn>0.75</mn><mi> </mi><mi mathvariant=\"normal\">m</mi></math><br/>",
