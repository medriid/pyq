  "solution": {
    "text": "<math><mover accent=\"true\"><mrow><mi>F</mi></mrow><mo>→</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mi>α</mi><mi>t</mi></mrow></mfenced><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mi>β</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math>               <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>a</mi><mi>t</mi><mi> </mi><mi>t</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi> </mi><mi>v</mi><mo>=</mo><mn>0</mn><mo>,</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mn>0</mn></mrow><mo>→</mo></mover></mrow></mfenced></math> <br > <math><mi>α</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi> </mi><mi>β</mi><mo>=</mo><mn>1</mn></math> <br > <math><mover accent=\"true\"><mrow><mi>F</mi></mrow><mo>→</mo></mover><mo>=</mo><mi>t</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br > <math><mi>m</mi><mfrac><mrow><mi>d</mi><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mi>t</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br >On integrating<br > <math><mi>m</mi><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover><mo>=</mo><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mi>t</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math>               <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>m</mi><mo>=</mo><mn>1</mn><mi>k</mi><mi>g</mi></mrow></mfenced></math> <br > <math><mfrac><mrow><mi>d</mi><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mi>t</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math>               <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mn>0</mn></mrow><mo>→</mo></mover><mi> </mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi> </mi><mi>t</mi><mo>=</mo><mn>0</mn></mrow></mfenced></math> <br >On integrating<br > <math><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>=</mo><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>6</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br > <math><mover accent=\"true\"><mrow><mi>τ</mi></mrow><mo>→</mo></mover><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math> <br > <math><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover><mo>=</mo><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mi>t</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br >At  <math><mi>t</mi><mo>=</mo><mn>1</mn><mi> </mi><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mover accent