  "solution": {
    "text": "<p><math><mi mathvariant=\"normal\">K</mi><mo>.</mo><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi></mrow></msub><mo>=</mo><mi mathvariant=\"normal\">K</mi><mo>.</mo><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msub><mo>+</mo><mi mathvariant=\"normal\">K</mi><mo>.</mo><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">t</mi></mrow></msub></math><br ><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/image5-4c0aca5f-f276-4e40-b0c6-ce9b5bb384d0.png\"/><br ><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\">m</mi><msup><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></mrow></msub><msup><mrow><mi mathvariant=\"normal\">w</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br ><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\">m</mi><msup><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">m</mi><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br ><math><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"normal\">m</mi><msup><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br ><math><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">W</mi></mrow><mrow><mi mathvariant=\"normal\">g</mi></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac><msubsup><mrow><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">g</mi><mo>×</mo><mn>30</mn><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></math><br ><math><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">C</mi></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">W</mi></mrow><mrow><mi mathvariant=\"normal\">g</mi></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">D</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"normal\">m</mi><msubsup><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">g</mi><mo>×</mo><mn>27</mn><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">D</mi></mrow></msub></math><br ><math><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">D</mi></mrow></msub></math> (Conversation of energy)<br ><math><mo>⇒</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"n