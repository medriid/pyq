  "type": "multipleCorrect",
  "level": 2,
  "question": {
    "text": "<p>A rod of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> and length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>,</mo></math> pivoted at one of its ends, is hanging vertically. A bullet of the same mass moving at speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> strikes the rod horizontally at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> from its pivoted end and gets embedded in it. The combined system now rotates with an angular speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ω</mi></math> about the pivot. The maximum angular speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>ω</mi><mi mathvariant=\"normal\">M</mi></msub></math> is achieved for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><msub><mi>x</mi><mi mathvariant=\"normal\">M</mi></msub></math>. Then</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/99ef344b-db43-4bbb-8159-6d88ebd91855-D494.png\"/></p>",
    "image": null
  },
  "options": [
    {
      "id": "eifMn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>v</mi><mi>x</mi></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "xWFlx",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi><mo>=</mo><mfrac><mrow><mn>12</mn><mi>v</mi><mi>x</mi></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo>+</mo><mn>12</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "UKGC4",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>x</mi><mi>M</mi></msub><mo>=</mo><mfrac><mi>L</mi><msqrt><mn>3</mn></msqrt></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "KIh7B",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#969;</mi><mi>M</mi></msub><mo>=</mo><mfrac><mi>v</mi><mrow><mn>2</mn><mi>L</mi></mrow></mfrac><msqrt><mn>3</mn></msqrt></math>",
      "isCorrect": true,
