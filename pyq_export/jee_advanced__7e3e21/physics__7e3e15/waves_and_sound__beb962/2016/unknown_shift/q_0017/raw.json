    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/Phy_13_ANS_.jpg\"/><br ><math><msub><mrow><mi>f</mi></mrow><mrow><mi>M</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>C</mi><mo>+</mo><mi>V</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow><mrow><mi>C</mi></mrow></mfrac><mi> </mi><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br ><math><msub><mrow><mi>f</mi></mrow><mrow><mi>N</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>C</mi><mo>+</mo><mi>V</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow><mrow><mi>C</mi></mrow></mfrac><mi> </mi><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br ><math><mi mathvariant=\"normal\">Δ</mi><mi>f</mi><mo>=</mo><msub><mrow><mi>f</mi></mrow><mrow><mi>N</mi></mrow></msub><mo>-</mo><msub><mrow><mi>f</mi></mrow><mrow><mi>M</mi></mrow></msub></math><br ><math><mo>=</mo><mfrac><mrow><mi>C</mi><mo>+</mo><mi>V</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow><mrow><mi>C</mi></mrow></mfrac><mi> </mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math><br ><math><mfrac><mrow><mi>d</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">Δ</mi><mi>f</mi></mrow></mfenced></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mi> </mi><mo>-</mo><mfrac><mrow><mi>V</mi></mrow><mrow><mi>C</mi></mrow></mfrac><mi> </mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow><mi> </mi><mfrac><mrow><mi>d</mi><mi>θ</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></math><br ><math><mo>∴</mo></math> and <math><mfrac><mrow><mi>d</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">Δ</mi><mi>f</mi></mrow></mfenced></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></math> is maximum when <math><mi>θ</mi><mo>=</mo><msup><mrow><mn>90</mn></mrow><mrow><mi>o</mi></mrow></msup></math><br ><math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>∴</mo><mi> </mi><mi> </mi><mi> </mi><mi> </mi><mi> </mi><mi> </mi><mfenced separators=\"|\"><mrow><mi>i</mi><mi>i</mi><mi>i</mi></mrow></mfenced><mi> </mi><mi>i</mi><mi>s</mi><mi> </mi><mi>c</mi><mi>o</mi><mi>r</mi><mi>r</mi><mi>e</mi><mi>c</mi><mi>t</mi></mrow></mfenced></math><br ><math><msub><mrow><mi>v</mi></mrow><mrow><mi>P</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mi>V</mi></mrow><mrow><mi>C</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow></mfenced><mi mathvariant=\"normal\">Δ</mi><mi>f</mi></math><br ><math><msub><mrow><mi>v</mi></mrow><mrow><mi>Q</mi></mrow></msub><mo>=</mo><mi mathvariant=\"normal\">Δ</mi><mi>f</mi></math><br ><math><msub><mrow><mi>v</mi></mrow><mrow><mi>R</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mfrac><mrow><mi>V</mi></mrow><mrow><mi>C</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow></mfenced><mi mathvariant=\"normal\">Δ</mi><mi>f</mi></math><br ><math><mo>∴</mo></math> <math><msub><mrow><mi>v</mi></mrow><mrow><mi>P</mi></mrow></msub><mo>+</mo><msub><mrow><mi>v</mi></mrow><mrow><mi>r</mi></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>v</mi></mrow><mrow><mi>Q</mi></mrow></msub></math>",
