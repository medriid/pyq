    {
      "text": "If the wind blows from the observer to the source, f<sub>2</sub> &lt; f<sub>1</sub>.",
      "is_correct": false
    },
    {
      "text": "If the wind blows from the source to the observer, f<sub>2</sub> &lt; f<sub>1</sub>.",
      "is_correct": false
