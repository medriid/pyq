  "correctValue": null,
  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>d</mi><mtext>&#160;sin</mtext><mi>&#160;&#952;</mi><mo>=</mo><mi>&#955;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>=</mo><mfrac><mi>&#955;</mi><mrow><mtext>2 sin</mtext><mi>&#160;&#952;</mi></mrow></mfrac></math><br />Differentiate on both the sides,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8706;</mo><mfenced><mi>d</mi></mfenced><mo>=</mo><mfrac><mi>&#955;</mi><mn>2</mn></mfrac><mo>&#8706;&#160;</mo><mfenced><mrow><mtext>cosec</mtext><mi>&#160;&#952;</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8706;</mo><mfenced><mi>d</mi></mfenced><mo>=</mo><mfrac><mi>&#955;</mi><mn>2</mn></mfrac><mfenced><mrow><mo>-</mo><mtext>cosec&#160;</mtext><mi>&#952;&#160;</mi><mtext>cot</mtext><mi>&#160;&#952;</mi></mrow></mfenced><mo>&#8706;</mo><mi>&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8706;</mo><mfenced><mi>d</mi></mfenced><mo>=</mo><mfrac><mrow><mo>-</mo><mi>&#955;</mi><mtext>&#160;cos&#160;</mtext><mi>&#160;&#952;</mi></mrow><mrow><mn>2&#160;</mn><msup><mtext>sin</mtext><mn>2</mn></msup><mi>&#160;&#952;</mi></mrow></mfrac><mo>&#8706;</mo><mi>&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#160;&#952;</mi><mo>=</mo></math>increases and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>&#955;</mi><mo>&#160;</mo><mtext>cos</mtext><mo>&#160;</mo><mi>&#952;</mi></mrow><mrow><mn>2</mn><mo>&#160;</mo><msup><mtext>sin</mtext><mn>2</mn></msup><mo>&#160;</mo><mi>&#952;</mi></mrow></mfrac></math>&nbsp;decreases.<br /><u><strong>Alternate solution</strong></u><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>=</mo><mfrac><mi>&#955;</mi><mrow><mtext>2 sin</mtext><mi>&#160;&#952;</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#8467;</mi><mi>n</mi><mo>&#160;</mo><mi>d</mi><mo>=</mo><mi>&#8467;</mi><mi>n</mi><mo>&#160;</mo><mi>&#955;</mi><mo>-</mo><mi>&#8467;</mi><mi>n</mi><mo>&#160;</mo><mn>2</mn><mo>-</mo><mi>&#8467;</mi><mi>n</mi><mtext>&#160;sin</mtext><mi>&#160;&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mo>&#916;</mo><mfenced><mi>d</mi></mfenced></mrow><mi>d</mi></mfrac><mo>=</mo><mn>0</mn><mo>-</mo><mn>0</mn><mo>-</mo><mfrac><mn>1</mn><mrow><mtext>sin</mtext><mi>&#160;&#952;</mi></mrow></mfrac><mo>&#215;</mo><mtext>cos</mtext><mi>&#160;&#952;</mi><mfenced><mrow><mo>&#916;</mo><mtext>&#952;</mtext></mrow></mfenced></math><br />Fractional error,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><mrow><mo>+</mo><mfenced><mi>d</mi></mfenced></mrow></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><mrow><mtext>cot</mtext><mi>&#160;&#952;</mi><mo>&#916;</mo><mi>&#952;</mi></mrow></mfenced></math><br />Absolute error,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#916;</mo><mi>d</mi><mo>=</mo><mfenced><mrow><mi>d</mi><mtext>&#160;cot</mtext><mi>&#160;&#952;</mi></mrow></mfenced><mo>&#916;</mo><mi>&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>d</mi><mrow><mn>2</mn><mtext>sin</mtext><mi>&#160;&#952;</mi></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mtext>cos</mtext><mi>&#160;&#952;</mi></mrow><mrow><mtext>sin</mtext><mi>&#160;&#952;</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#916;</mo><mi>d</mi><mo>=</mo><mfrac><mrow><mtext>cos</mtext><mi>&#160;&#952;</mi></mrow><mrow><msup><mtext>sin</mtext><mn>2</mn></msup><mi>&#160;&#952;</mi></mrow></mfrac></math>",
