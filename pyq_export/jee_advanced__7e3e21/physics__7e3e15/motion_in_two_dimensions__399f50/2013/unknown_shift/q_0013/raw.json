      "image": null
    },
    {
      "id": "A5W6K",
      "text": "<math><mrow>  <mfrac>    <mrow>      <mi>&pi;</mi>    </mrow>    <mrow>      <mn>2</mn>    </mrow>  </mfrac>  <mo>+</mo>  <mi>&alpha;</mi></mrow></math>",
      "isCorrect": false,
