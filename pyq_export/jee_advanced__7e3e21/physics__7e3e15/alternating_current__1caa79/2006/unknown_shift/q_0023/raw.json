  "question": {
    "text": "$$\n\\text { Find the time constant for the given } R C \\text { circuits in correct order. }\n$$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/7aU5aAIeBz3ebRc4ZXsLteRMyxFnx6QQ53YxU94qFDo.original.fullsize.png\"><br>\n$R_1=1 \\Omega, R_2=2 \\Omega, C_1=4 \\mu \\mathrm{F}, C_2=2 \\mu \\mathrm{F}$",
    "image": null
  },
  "options": [
    {
      "id": "CSvEP",
      "text": "\n$18,4,8 / 9$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7AUrU",
      "text": "\n$18,8 / 9,4$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jyVqS",
      "text": "\n$4,18,8 / 9$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HP1b0",
      "text": "\n$4,8 / 9,18$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n\\tau & =C R \\\\\n\\tau_1 & =\\left(C_1+C_2\\right)\\left(R_1+R_2\\right)=18 \\mu \\mathrm{s} \\\\\n\\tau_2 & =\\left(\\frac{C_1 C_2}{C_1+C_2}\\right)\\left(\\frac{R_1 R_2}{R_1+R_2}\\right)=\\frac{8}{6} \\times \\frac{2}{3}=\\frac{8}{9} \\mu \\mathrm{s} \\\\\n\\tau_2 & =\\left(C_1+C_2\\right)\\left(\\frac{R_1 R_2}{R_1+R_2}\\right)=(6)\\left(\\frac{2}{3}\\right)=4 \\mu \\mathrm{s}\n\\end{aligned}\n$$",
    "image": null
  },
