  "question": {
    "text": "$$\n\\text { Find the time constant for the given } R C \\text { circuits in correct order. }\n$$\n<img src=\"assets\\qt0023_e965c1b4798d.png\"><br>\n$R_1=1 \\Omega, R_2=2 \\Omega, C_1=4 \\mu \\mathrm{F}, C_2=2 \\mu \\mathrm{F}$"
  },
  "options": [
    {
      "text": "\n$18,4,8 / 9$\n",
      "is_correct": false
    },
    {
      "text": "\n$18,8 / 9,4$\n",
      "is_correct": true
    },
    {
      "text": "\n$4,18,8 / 9$\n",
      "is_correct": false
    },
    {
      "text": "\n$4,8 / 9,18$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n\\tau & =C R \\\\\n\\tau_1 & =\\left(C_1+C_2\\right)\\left(R_1+R_2\\right)=18 \\mu \\mathrm{s} \\\\\n\\tau_2 & =\\left(\\frac{C_1 C_2}{C_1+C_2}\\right)\\left(\\frac{R_1 R_2}{R_1+R_2}\\right)=\\frac{8}{6} \\times \\frac{2}{3}=\\frac{8}{9} \\mu \\mathrm{s} \\\\\n\\tau_2 & =\\left(C_1+C_2\\right)\\left(\\frac{R_1 R_2}{R_1+R_2}\\right)=(6)\\left(\\frac{2}{3}\\right)=4 \\mu \\mathrm{s}\n\\end{aligned}\n$$"
  }
