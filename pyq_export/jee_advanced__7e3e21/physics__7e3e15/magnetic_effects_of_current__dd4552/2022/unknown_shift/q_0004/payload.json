  "question": {
    "text": "<p>Which one of the following options represents the magnetic field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>B</mi><mo>&#8594;</mo></mover></math>&nbsp;at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi></math> due to the current flowing in the given wire segments lying on the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mi>y</mi></math>&nbsp;plane?</p><p><img src=\"assets\\qt0004_36fb90e87081.jpg\" style=\"width: 400px; height: 220px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>B</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mo>-</mo><msub><mi>&#956;</mi><mn>0</mn></msub><mi>I</mi></mrow><mi>L</mi></mfrac><mfenced><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mn>4</mn><msqrt><mn>2</mn></msqrt><mi>&#960;</mi></mrow></mfrac></mrow></mfenced><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>B</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mo>-</mo><msub><mi>&#956;</mi><mn>0</mn></msub><mi>I</mi></mrow><mi>L</mi></mfrac><mfenced><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mn>2</mn></msqrt><mi>&#960;</mi></mrow></mfrac></mrow></mfenced><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>B</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mo>-</mo><msub><mi>&#956;</mi><mn>0</mn></msub><mi>I</mi></mrow><mi>L</mi></mfrac><mfenced><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>4</mn><msqrt><mn>2</mn></msqrt><mi>&#960;</mi></mrow></mfrac></mrow></mfenced><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math>",
      "is_correct": true
    },
