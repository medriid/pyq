  "question": {
    "text": "<p>Which one of the following options represents the magnetic field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>B</mi><mo>&#8594;</mo></mover></math>&nbsp;at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi></math> due to the current flowing in the given wire segments lying on the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mi>y</mi></math>&nbsp;plane?</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/315eac39-9614-4744-940b-a5694b59d1b9-1.jpg\" style=\"width: 400px; height: 220px;\" /></p>",
    "image": null
  },
