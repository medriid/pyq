  "solution": {
    "text": "<p>Given&nbsp;<math><msub><mrow><mi>v</mi></mrow><mrow><mi>e</mi></mrow></msub><mo>=</mo><mn>11.2</mn><mrow><mrow><mi>k</mi><mi>m</mi></mrow><mo>/</mo><mrow><mi>s</mi><mi>e</mi><mi>c</mi></mrow></mrow><mo>=</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac></msqrt></math></p><p><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msubsup><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow><mrow><mn>2</mn></mrow></msubsup><mo>-</mo><mfrac><mrow><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub><mi>m</mi></mrow><mrow><mi>r</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>m</mi></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac><mo>=</mo><mn>0</mn><mo>-</mo><mn>0</mn></math>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;where r = distance of rocket from Sun</p><p><math><mo>&rArr;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub><mo>=</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow><mrow><mi>r</mi></mrow></mfrac></msqrt></math></p><p>Given&nbsp; <math><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub><mo>=</mo><mn>3</mn><mo>&times;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>5</mn></mrow></msup><mi>&nbsp;</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></math>&nbsp; and&nbsp; <math><mi>r</mi><mo>=</mo><mn>2.5</mn><mo>&times;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></math></p><p><math><mo>&rArr;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub><mo>=</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mi>G</mi><mn>3</mn><mo>&times;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>5</mn></mrow></msup><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><mn>2.5</mn><mo>&times;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac></msqrt></math></p><p><math><mo>=</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mn>3</mn><mo>&times;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>5</mn></mrow></msup></mrow><mrow><mn>2.5</mn><mo>&times;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup></mrow></mfrac></mrow></mfenced></msqrt></math></p><p><math><mo>=</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfrac><mo>&times;</mo><mn>13</mn></msqrt></math></p><p><math><mo>&rArr;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub><mo>=</mo><mn>42</mn><mrow><mrow><mi>k</mi><mi>m</mi></mrow><mo>/</mo><mrow><mi>s</mi></mrow></mrow></math></p>",
