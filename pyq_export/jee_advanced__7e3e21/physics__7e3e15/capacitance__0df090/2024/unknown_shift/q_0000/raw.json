      "isCorrect": false
    },
    {
      "id": "zuo2l",
      "text": "$\\mathrm{P} \\rightarrow 3 ; \\mathrm{Q} \\rightarrow 2 ; \\mathrm{R} \\rightarrow 4 ; \\mathrm{S} \\rightarrow 1$",
