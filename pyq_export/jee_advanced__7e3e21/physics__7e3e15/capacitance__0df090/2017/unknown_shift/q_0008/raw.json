      "id": "mK0y8",
      "text": "\\(E_D=3\\left(\\frac{1}{2} C V_0^2\\right)\\)",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "aBEIj",
      "text": "\\(E_D=\\frac{1}{3}\\left(\\frac{1}{2} C V_0^2\\right)\\)",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Ry3lS",
      "text": "\\(E_D=3 C V_0^2\\)",
