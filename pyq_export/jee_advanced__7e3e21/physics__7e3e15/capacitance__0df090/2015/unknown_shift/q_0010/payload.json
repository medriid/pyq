    "D"
  ],
  "solution": {
    "text": "<math><mfrac><mrow><mn>5</mn><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">d</mi></mrow></mfrac><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br >In new setup we have 3 different setups<br >i.  <math><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi mathvariant=\"normal\"> </mi><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br > <math><msup><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mi mathvariant=\"normal\">′</mi></mrow></msup><mo>=</mo><mfrac><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mfrac><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mo>=</mo><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br >ii.  <math><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi mathvariant=\"normal\"> </mi><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>2</mn></mrow></msub></math> <br > <math><msup><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mi mathvariant=\"normal\">′</mi><mi mathvariant=\"normal\">′</mi></mrow></msup><mo>=</mo><mfrac><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mfrac><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mo>=</mo><mn>4</mn><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br >iii.  <math><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">d</mi><mo>,</mo><mi mathvariant=\"normal\"> </mi><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br > <math><msup><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mi mathvariant=\"normal\">′</mi><mi mathvariant=\"normal\">′</mi><mi mathvariant=\"normal\">′</mi></mrow></msup><mo>=</mo><mfrac><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">d</mi></mrow></mfrac><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br > <br/><img src=\"assets\\st0010_7ed2df600286.jpg\"/> <br > <math><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></mrow></mfenced></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>14</mn></mrow><mrow><mn>6</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>3</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br >