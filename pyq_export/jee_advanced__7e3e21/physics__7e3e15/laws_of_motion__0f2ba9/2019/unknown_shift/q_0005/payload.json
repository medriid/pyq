    "text": "<p>2.00<br > <img src=\"assets\\st0005_b937aa967165.png\"/> <br >Resolving in components<br > <math><mo>⇒</mo><mo>∑</mo><msub><mrow><mi>F</mi></mrow><mrow><mi>x</mi></mrow></msub><mo>=</mo><mn>0</mn></math> <br > <math><mo>⇒</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>S</mi></mrow></msub><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mn>60</mn><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>⋅</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mn>30</mn></math> <br > <math><mo>⇒</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>S</mi></mrow></msub><mo>⋅</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>⋅</mo><mfrac><mrow><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac></math> <br > <math><mo>⇒</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>S</mi></mrow></msub><mo>=</mo><msqrt><mn>3</mn></msqrt><mo>⋅</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>C</mi></mrow></msub></math> <br > <math><mfrac><mrow><mi>Δ</mi><msub><mrow><mi>l</mi></mrow><mrow><mi>C</mi></mrow></msub></mrow><mrow><mi>Δ</mi><msub><mrow><mi>l</mi></mrow><mrow><mi>S</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>⋅</mo><msub><mrow><mi>l</mi></mrow><mrow><mi>C</mi></mrow></msub></mrow><mrow><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mi>S</mi></mrow></msub><mo>⋅</mo><msub><mrow><mi>l</mi></mrow><mrow><mi>S</mi></mrow></msub></mrow><mrow><msub><mrow><mi>Y</mi></mrow><mrow><mi>S</mi></mrow></msub></mrow></mfrac></mrow></mfrac></mrow></mfenced></math> <br > <math><mo>⇒</mo><mfrac><mrow><mi>Δ</mi><msub><mrow><mi>l</mi></mrow><mrow><mi>C</mi></mrow></msub></mrow><mrow><mi>Δ</mi><msub><mrow><mi>l</mi></mrow><mrow><mi>S</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfenced separator