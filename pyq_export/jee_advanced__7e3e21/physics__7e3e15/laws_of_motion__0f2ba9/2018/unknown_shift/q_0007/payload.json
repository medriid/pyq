row><mi>e</mi></mrow><mrow><mo>-</mo><mfrac><mrow><mi>t</mi></mrow><mrow><mi>τ</mi></mrow></mfrac></mrow></msup></mrow><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>τ</mi></mrow></mfrac></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>0</mn></mrow><mrow><mi>τ</mi></mrow></msubsup></math><br ><math><mi>x</mi><mo>=</mo><mn>2.5</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>4</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>-</mo><msup><mrow><mi>e</mi></mrow><mrow><mn>0</mn></mrow></msup></mrow></mfenced></math><br ><math><mi>x</mi><mo>=</mo><mn>25</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>4</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>0.37</mn><mo>-</mo><mn>1</mn></mrow></mfenced></math><br ><math><mi>x</mi><mo>=</mo><mn>6.30</mn><mi> </mi></math>"
