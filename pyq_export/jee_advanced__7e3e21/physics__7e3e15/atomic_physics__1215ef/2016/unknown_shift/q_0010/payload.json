row><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>.</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>.</mo><mi> </mi><msup><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math>  <br > <math><mo>⇒</mo><mi> </mi><mi> </mi><mfrac><mrow><mo>∆</mo><mi>E</mi></mrow><mrow><mi>E</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>≃</mo><mfrac><mrow><mn>2</mn><mi>n</mi></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>∝</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac></math>  <br >As angular momentum  <math><mi>L</mi><mo>=</mo><mfrac><mrow><mi>n</mi><mi>h</mi></mrow><mrow><mn>2</mn><mi>π</mi></mrow></mfrac></math> <br > <math><mo>⇒</mo><mi> </mi><mi> </mi><mfrac><mrow><mo>∆</mo><mi>L</mi></mrow><mrow><mi>L</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>h</mi></mrow><mrow><mn>2</mn><mi>π</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mi>n</mi><mi>h</mi></mrow><mrow><mn>2</mn><mi>π</mi></mrow></mfrac></mrow><mrow><mfrac><mrow><mi>n</mi><mi>h</mi></mrow><mrow><mn>2</mn><mi>π</mi></mrow></mfrac></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mi> </mi><mo>∝</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi