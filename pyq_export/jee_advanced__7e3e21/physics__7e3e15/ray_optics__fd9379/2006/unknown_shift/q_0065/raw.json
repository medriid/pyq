  "question": {
    "text": "A biconvex lens of focal length $f$ forms a circular image of radius $r$ of sun in focal plane. Then, which option is correct?",
    "image": null
  },
  "options": [
    {
      "id": "ziswb",
      "text": "\n$\\pi r^2 \\propto f$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BbSRM",
      "text": "\n$\\pi r^2 \\propto f^2$\t\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "bTbB1",
      "text": "\nIf lower half part is covered by black sheet, then area of the image is equal to $\\pi r^2 / 2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Scvss",
      "text": "\nIf $f$ is doubled, intensity will increase",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
