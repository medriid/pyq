      "text": "$\\sqrt{\\frac{2}{5}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0000_52b15e350c51.png\"><br>$\\begin{aligned} & \\frac{\\mathrm{ML}^2}{3} \\ddot{\\theta}+\\mathrm{K} \\cdot \\frac{\\ell}{2} \\theta \\cdot \\frac{\\ell}{2}+\\mathrm{K} \\cdot \\ell \\cdot \\theta \\cdot \\ell=0 \\\\ & \\ddot{\\theta}+\\frac{15}{4} \\frac{\\mathrm{k}}{\\mathrm{M}} \\theta=0 \\\\ & \\ddot{\\theta}=-\\left(\\frac{15}{4} \\frac{\\mathrm{k}}{\\mathrm{M}}\\right) \\theta \\\\ & \\omega_1=\\sqrt{\\frac{15 \\mathrm{~K}}{4 \\mathrm{M}}}\\end{aligned}$<img src=\"assets\\st0000_0916e96040a7.png\"><br>$\\frac{1}{3} \\mathrm{ML}^2 \\ddot{\\theta}+2 \\mathrm{~K} \\frac{\\mathrm{~L}}{2} \\theta \\cdot \\frac{\\mathrm{~L}}{2}=0$\n$\\begin{aligned} & \\ddot{\\theta}+\\frac{3}{2} \\frac{K}{M} \\theta=0 \\\\ & \\ddot{\\theta}=-\\frac{3}{2} \\frac{K}{M} \\theta \\\\ & \\omega_2=\\sqrt{\\frac{3}{2} \\frac{K}{M}} \\\\ & \\frac{\\omega_1}{\\omega_2}=\\sqrt{\\frac{15}{4} \\times \\frac{2}{3}}=\\sqrt{\\frac{5}{2}}\\end{aligned}$"
