  "question": {
    "text": "The mass $M$ shown in the figure oscillates in simple harmonic motion with amplitude $A$. The amplitude of the point $P$ is\n<img src=\"assets\\qt0020_906bd4d38a32.png\"><br>"
  },
  "options": [
    {
      "text": "\n$\\frac{k_a A}{k_2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{k_2 A}{k_1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{k_1 A}{k_1+k_2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{k_2 A}{k_1+k_2}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$x_1+x_2=A$ and $k_1 x_1=k_2 x_2$ or $\\frac{x_1}{x_2}=\\frac{k_2}{k_1}$\nSolving these equations, we get\n$$\nx_1=\\left(\\frac{k_2}{k_1+k_2}\\right) A\n$$"
  }
