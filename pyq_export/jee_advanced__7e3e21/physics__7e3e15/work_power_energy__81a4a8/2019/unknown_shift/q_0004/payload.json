  "solution": {
    "text": "<math><mi>d</mi><mi>w</mi><mo>=</mo><mover accent=\"true\"><mrow><mi>F</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mi>d</mi><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover></math><br /><math><mi>d</mi><mi>w</mi><mo>=</mo><mi>a</mi><mi>y</mi><mi>d</mi><mi>x</mi><mo>+</mo><mn>2</mn><mi>a</mi><mi>x</mi><mi>d</mi><mi>y</mi></math><br />Now, total work done in whole path is given by,<br /><math><mi>W</mi><mo>=</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>A</mi><mi>B</mi></mrow></msub><mo>+</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>B</mi><mi>C</mi></mrow></msub><mo>+</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>C</mi><mi>D</mi></mrow></msub><mo>+</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>D</mi><mi>E</mi></mrow></msub><mo>+</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>E</mi><mi>F</mi></mrow></msub><mo>+</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>F</mi><mi>A</mi></mrow></msub></math><br /><math><mi>A</mi><mo>→</mo><mi>B</mi><mo>,</mo><mtext> </mtext><mi>y</mi><mo>=</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>d</mi><mi>y</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><msub><mrow><mi>W</mi></mrow><mrow><mi>A</mi><mo>→</mo><mi>B</mi></mrow></msub><mo>=</mo><mo>∫</mo><mi>α</mi><mi>y</mi><mi>d</mi><mi>x</mi><mo>=</mo><mi>α</mi><mo>⋅</mo><mn>1</mn><mrow><munderover><mo stretchy=\"true\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><mi>d</mi><mi>x</mi><mo>=</mo><mi>α</mi></mrow></mrow></math><br /><math><mi>B</mi><mo>→</mo><mi>C</mi><mo>,</mo><mtext> </mtext><mi>x</mi><mo>=</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><msub><mrow><mi>W</mi></mrow><mrow><mi>B</mi><mo>→</mo><mi>C</mi></mrow></msub><mo>=</mo><mn>2</mn><mi>α</mi><mo>⋅</mo><mn>1</mn><mrow><munderover><mo stretchy=\"true\">∫</mo><mrow><mn>1</mn></mrow><mrow><mn>0.5</mn></mrow></munderover><mrow><mi>d</mi><mi>y</mi><mo>=</mo><mo>-</mo><mn>2</mn><mi>α</mi><mfenced separators=\"|\"><mrow><mn>0.5</mn></mrow></mfenced><mo>=</mo><mo>-</mo><mi>α</mi></mrow></mrow></math><br /><math><mi>C</mi><mo>→</mo><mi>D</mi><mo>,</mo><mtext> </mtext><mi>y</mi><mo>=</mo><mn>0.5</mn><mo>,</mo><mtext> </mtext><mi>d</mi><mi>y</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><msub><mrow><mi>W</mi></mrow><mrow><mi>C</mi><mo>→</mo><mi>D</mi></mrow></msub><mo>=</mo><mrow><munderover><mo stretchy=\"true\">∫</mo><mrow><mn>1</mn></mrow><mrow><mn>0.5</mn></mrow></munderover><mrow><mi>α</mi><mi>y</mi><mi>d</mi><mi>x</mi><mo>=</mo></mrow></mrow><mi>α</mi><mo>⋅</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mrow><munderover><mo stretchy=\"true\">∫</mo><mrow><mn>1</mn></mrow><mrow><mn>0.5</mn></mrow></munderover><mrow><mi>d</mi><mi>x</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mi>α</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mrow></math><br /><math><mi>D</mi><mo>→</mo><mi>E</mi><mo>,</mo><mtext> </mtext><mi>x</mi><mo>=</mo><mn>0.5</mn><mo>,</mo><mtext> </mtext><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><msub><mrow><mi>W</mi></mrow><mrow><mi>D</mi><mo>→</mo><mi>E</mi></mrow></msub><mo>=</mo><mn>2</mn><mi>α</mi><mo>∫</mo><mi>x</mi><mi>d</mi><mi>y</mi><mo>=</mo><mn>2</mn><mi>α</mi><mo>⋅</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mrow><munderover><mo stretchy=\"true\">∫</mo><mrow><mn>1</mn></mrow><mrow><mn>0.5</mn></mrow></munderover><mrow><mi>d</mi><mi>y</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow></math><br /><math><mi>E</mi><mo>→</mo><mi>F</mi><mo>,</mo><mtext> </mtext><mi>y</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><mi>d</mi><mi>y</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><msub><mrow><mi>W</mi></mrow><mrow><mi>E</mi><mi>F</mi></mrow></msub><mo>=</mo><mn>0</mn></math><br /><math><mi>F</mi><mo>→</mo><mi>A</mi><mo>,</mo><mtext> </mtext><mi>x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mtext> </mtext><msub><mrow><mi>W</