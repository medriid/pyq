n>2</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>.</mo><mfrac><mrow><msubsup><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>4</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>4</mn></mrow></msubsup></mrow></mfrac></math><br /><math><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup><mo>=</mo><msup><mrow><mn>400</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>.</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>4</mn></mrow></msup></math><br /><math><mfrac><mrow><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup></mrow><mrow><mn>16</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup></mrow></mfrac><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>4</mn></mrow></msup></math><br /><math><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></mrow></mfrac><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>16</mn></mrow><mrow><mn>1</mn></mrow></