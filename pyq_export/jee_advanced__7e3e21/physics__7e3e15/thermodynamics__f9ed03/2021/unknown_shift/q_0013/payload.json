  "question": {
    "text": "An ideal gas undergoes a four step cycle as shown in the&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>-</mo><mi>V</mi></math>&nbsp;diagram below. During this cycle, heat is absorbed by the gas in:\r\n\r\n<img src=\"assets\\qt0013_9aad7ec0a622.png\" style=\"width: 280px; height: 190px;\" />"
  },
  "options": [
    {
      "text": "steps&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "is_correct": false
    },
