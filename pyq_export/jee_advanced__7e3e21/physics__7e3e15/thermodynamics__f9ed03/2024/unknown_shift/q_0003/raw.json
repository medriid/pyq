    },
    {
      "id": "MWfVr",
      "text": "$\\mathrm{P} \\rightarrow 4$; $\\mathrm{Q} \\rightarrow 1 ; \\mathrm{R} \\rightarrow 2 ; \\mathrm{S} \\rightarrow 2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pXXIT",
      "text": "$\\mathrm{P} \\rightarrow 2 ; \\mathrm{Q} \\rightarrow 5 ; \\mathrm{R} \\rightarrow 3 ; \\mathrm{S} \\rightarrow 4$",
      "image": null,
