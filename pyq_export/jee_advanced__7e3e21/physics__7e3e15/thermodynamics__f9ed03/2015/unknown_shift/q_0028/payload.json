  "solution": {
    "text": "<br/><img src=\"assets\\st0028_d8503ea63545.jpg\"/> <br > <br/><img src=\"assets\\st0028_2630536eda67.jpg\"/> <br >(i)   <math><mi mathvariant=\"normal\">P</mi><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mfrac><mrow><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfrac></math> <br > <math><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>⇒</mo><mi mathvariant=\"normal\">x</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfrac></math> <br > <math><mfrac><mrow><mn>3</mn><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mfrac><mrow><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfrac></math> <br > <math><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">x</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math> <br >Energy of spring<br > <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\">K</mi><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"normal\">x</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>4</mn></mrow></mfrac></math> <br >(ii)   <math><mo>∆</mo><mi>U</mi><mo>=</mo><mfrac><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math> <br > <math><mo>=</mo><mn>3</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <br >(iii)   <math><msub><mrow><mi>P</mi></mrow><mrow><mi>f</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>4</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac></math> <br > <math><mi>K</mi><mi>X</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac><mi>A</mi></math> <br > <math><mi>X</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi>A</mi></mrow></mfrac></math> <br > <math><msub><mrow><mi>W</mi></mrow><mrow><mi>g</mi><mi>a</mi><mi>s</mi></mrow></msub><mo>=</mo><mo>-</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>W</mi></mrow><mrow><msub><mrow><mi>P</mi></mrow><mrow><mi>a</mi><mi>t</mi><mi>m</mi></mrow></msub></mrow></msub><mo>+</mo><msub><mrow><mi>W</mi></mrow><mrow><mi>s</mi><mi>p</mi><mi>r</mi><mi>i</mi><mi>n</mi><mi>g</mi></mrow></msub></mrow></mfenced></math> <br > <math><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>A</mi><mi>x</mi><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>K</mi><mi>x</mi><mo>.</mo><mi>x</mi></mrow></mfenced></m