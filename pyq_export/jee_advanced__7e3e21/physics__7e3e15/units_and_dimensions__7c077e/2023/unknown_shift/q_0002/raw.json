      "image": null,
      "isCorrect": true
    },
    {
      "id": "Jk5tJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><mo>&#8211;</mo><mn>7</mn><mo>,</mo><mo>&#160;</mo><mi>&#946;</mi><mo>=</mo><mo>&#8211;</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi>&#947;</mi><mo>=</mo><mo>&#8211;</mo><mn>2</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
