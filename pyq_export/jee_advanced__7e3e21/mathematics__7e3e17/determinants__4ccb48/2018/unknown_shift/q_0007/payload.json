    {
      "text": "<math><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mn>3</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi>&#160;</mi><mn>5</mn><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>+</mo><mn>6</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msub></math> and <math><mo>-</mo><mn>2</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>-</mo><mn>3</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>3</mn></mrow></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math><mo>–</mo><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>-</mo><mn>5</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi>&nbsp;</mi><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>10</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msub></math> and <math><mi>x</mi><mo>-</mo><mn>2</mn><mi>y</mi><mo>+</mo><mn>5</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>3</mn></mrow></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>+</mo><mn>5</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi> </mi><mn>2</mn><mi>x</mi><mo>+</mo><mn>3</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msub></math>  and  <math><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>-</mo><mn>5</mn><mi>z</mi><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>3</mn></mrow></msub></math>",
