</mi></mrow></mfrac></mrow></mrow><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><mi mathvariant=\"script\">l</mi><mi>n</mi></mrow></mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>x</mi><mfrac><mrow><mi>r</mi></mrow><mrow><mi>n</mi></mrow></mfrac><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mfrac><mrow><mi>r</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfenced></math><br />Express summation in definite integration using <math> <mrow> <mfrac> <mi>r</mi> <mi>n</mi> </mfrac> <mo>=</mo><mi>t&nbsp;</mi><mo>&amp;</mo><mfrac> <mn>1</mn> <mi>n</mi> </mfrac> <mo>=</mo><mi>d</mi><mi>t</mi> </mrow> </math><br /><math><mo>=</mo><mi>x</mi><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><mi mathvariant=\"script\">l</mi><mi>n</mi></mrow></mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>t</mi></math><br />Put <math><mi>t</mi><mi>x</mi><mo>=</mo><mi>z</mi></math><br /><math><mi mathvariant=\"script\">l</mi><mi>n</mi><mi>&nbsp;</mi><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi mathvariant=\"script\">l</mi><mi>n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>z</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>z</mi></mrow></mrow></math><br /><math><mo>⇒</m