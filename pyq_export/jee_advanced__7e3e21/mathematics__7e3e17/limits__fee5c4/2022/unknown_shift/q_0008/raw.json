  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mfrac><mrow><mn>2</mn><msub><mi>log</mi><mi>e</mi></msub><mfenced><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><msqrt><mi>&#945;</mi></msqrt></mrow></mfenced></mrow><mrow><msub><mi>log</mi><mi>e</mi></msub><mfenced><mrow><msup><mi>e</mi><msqrt><mi>x</mi></msqrt></msup><mo>-</mo><msup><mi>e</mi><msqrt><mi>&#945;</mi></msqrt></msup></mrow></mfenced></mrow></mfrac><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mfrac><mrow><mfrac><mn>2</mn><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><msqrt><mi>&#945;</mi></msqrt></mrow></mfrac><mfenced><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mi>x</mi></msqrt></mrow></mfrac></mfenced></mrow><mrow><mfrac><mn>1</mn><mrow><msup><mi>e</mi><msqrt><mi>x</mi></msqrt></msup><mo>-</mo><msup><mi>e</mi><msqrt><mi>&#945;</mi></msqrt></msup></mrow></mfrac><mfenced><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mi>x</mi></msqrt></mrow></mfrac><msup><mi>e</mi><msqrt><mi>x</mi></msqrt></msup></mrow></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mfrac><mrow><msup><mi>e</mi><msqrt><mi>x</mi></msqrt></msup><mo>-</mo><msup><mi>e</mi><msqrt><mi>&#945;</mi></msqrt></msup></mrow><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><msqrt><mi>&#945;</mi></msqrt></mrow></mfrac><mfrac><mn>1</mn><msup><mi>e</mi><msqrt><mi>x</mi></msqrt></msup></mfrac><mo>&#183;</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>2</mn><msup><mi>e</mi><msqrt><mi>&#945;</mi></msqrt></msup></mfrac><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mfrac><mrow><msup><mi>e</mi><msqrt><mi>x</mi></msqrt></msup><mo>&#183;</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mi>x</mi></msqrt></mrow></mfrac></mrow><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mi>x</mi></msqrt></mrow></mfrac></mfrac><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mi>f</mi><mfenced><mrow><mi>g</mi><mfenced><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mi>f</mi><mfenced><mrow><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mi>&#945;</mi><mo>+</mo></msup></mrow></munder><mi>g</mi><mfenced><mi>x</mi></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>f</mi><mfenced><mn>2</mn></mfenced><mo>=</mo><mi>sin</mi><mfrac><mi>&#960;</mi><mn>6</mn></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>=</mo><mn>0</mn><mo>.</mo><mn>50</mn></math></p></blockquote>",
