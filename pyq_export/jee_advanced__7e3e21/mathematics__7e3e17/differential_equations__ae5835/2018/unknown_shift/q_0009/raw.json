  "type": "numerical",
  "level": 1,
  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>:</mo><mi mathvariant=\"normal\">&#8477;</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">&#8477;</mi></math> be a differentiable function with <math><mi>f</mi><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math>. If <math><mi>y</mi><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> satisfies the differential equation <math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mn>5</mn><mi>y</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>5</mn><mi>y</mi><mo>-</mo><mn>2</mn></mrow></mfenced></math>, then the value of&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mo>-</mo><mi>&#8734;</mi></mrow></munder><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></math>&nbsp;is&nbsp;",
    "image": null
  },
  "options": [],
  "correctValue": "0.4",
  "solution": {
    "text": "<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mn>25</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn></math><br />So&nbsp;&nbsp;<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mn>25</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn></mrow></mfrac><mo>=</mo><mi>d</mi><mi>x</mi></math><br />Integrating&nbsp;&nbsp;<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>25</mn></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mo>×</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mi>y</mi><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow><mrow><mi>y</mi><mo>+</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mi>x</mi><mo>+</mo><mi>c</mi></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mn>5</mn><mi>y</mi><mo>-</mo><mn>2</mn></mrow><mrow><mn>5</mn><mi>y</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mn>20</mn><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>c</mi></mrow></mfenced></math><br />Now,&nbsp;&nbsp;<math><mi>c</mi><mo>=</mo><mn>0</mn></math>&nbsp;as&nbsp;<math><mi>f</mi><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math><br />Hence,&nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mn>5</mn><mi>y</mi><mo>-</mo><mn>2</mn></mrow><mrow><mn>5</mn><mi>y</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mfenced separators=\"|\"><mrow><mn>20</mn><mi>x</mi></mrow></mfenced></mrow></msup></math><br /><math><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>→</mo><mo>-</mo><mi>∞</mi></mrow></munder></mrow><mo>⁡</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mn>5</mn><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>-</mo><mn>2</mn><mi>&nbsp;</mi></mrow><mrow><mn>5</mn><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>+</mo><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mi>&nbsp;</mi><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>→</mo><mo>-</mo><mi>∞</mi></mrow></munder></mrow><mo>⁡</mo><mrow><msup><mrow><mi>e</mi></mrow><mrow><mfenced separators=\"|\"><mrow><mn>20</mn><mi>x</mi></mrow></mfenced></mrow></msup></mrow></mrow></math><br />Now,&nbsp;&nbsp;<br /><math > <mrow>  <mi>R</mi><mi>H</mi><mi>S</mi><mo>=</mo><mn>0</mn><mo>&#x21D2;</mo><munder>   <mrow>    <mi>lim</mi></mrow>   <mrow>    <mi>x</mi><mo>&#x2192;</mo><mo>&#x2212;</mo><mi>&#x221E;</mi></mrow>  </munder>  <mrow><mo>(</mo>   <mrow>    <mn>5</mn><mi>f</mi><mrow><mo>(</mo>     <mi>x</mi>    <mo>)</mo></mrow><mo>&#x2212;</mo><mn>2</mn></mrow>  <mo>)</mo></mrow><mo>=</mo><mn>0</mn></mrow></math><br /><math><mo>⇒</mo><math> <mrow>  <munder>   <mrow>    <mi>lim</mi></mrow>   <mrow>    <mi>x</mi><mo>&#x2192;</mo><mo>&#x2212;</mo><mi>&#x221E;</mi></mrow>  </munder>  <mi>f</mi><mrow><mo>(</mo>   <mi>x</mi>  <mo>)</mo></mrow><mo>=</mo><mfrac>   <mn>2</mn>   <mn>5</mn>  </mfrac>  </mrow></math>",
