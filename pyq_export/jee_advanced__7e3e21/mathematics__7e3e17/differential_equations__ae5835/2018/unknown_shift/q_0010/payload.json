  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>t</mi><mo>→</mo><mi>x</mi></mrow></munder><mfrac><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>sin</mi><mi>t</mi><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mi>t</mi></mfenced><mi>sin</mi><mi>x</mi></mrow><mrow><mi>t</mi><mo>-</mo><mi>x</mi></mrow></mfrac><mo>=</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></math><br >By using L'Hopital rule<br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>t</mi><mo>→</mo><mi>x</mi></mrow></munder><mfrac><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>cos</mi><mi>t</mi><mo>-</mo><msup><mi>f</mi><mi>′</mi></msup><mfenced separators=\"|\"><mi>t</mi></mfenced><mi>sin</mi><mi>x</mi></mrow><mn>1</mn></mfrac><mo>=</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>cos</mi><mi>x</mi><mo>-</mo><msup><mi>f</mi><mi>′</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>sin</mi><mi>x</mi><mo>=</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mo>-</mo><mfenced separators=\"|\"><mfrac><mrow><msup><mi>f</mi><mi>′</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>sin</mi><mi>x</mi><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>cos</mi><mi>x</mi></mrow><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow></mfrac></mfenced><mo>=</mo><mn>1</mn></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mo>-</mo><mfrac><mrow><mo>d</mo><mfrac><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow><mrow><mi>sin</mi><mi>x</mi></mrow></mfrac></mrow><mrow><mo>d</mo><mi>x</mi></mrow></mfrac><mo>=</mo><mn>1</mn></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow><mrow><mi>sin</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mi>x</mi><mo>+</mo><mi>c</mi></math><br >Put <math><mi>x</mi><mo>=</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>6</mn></mrow></mfrac></math> and <math><mi>f</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>6</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mo>-</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>12</mn></mrow></mfrac></math><br ><math><mo>∴</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>=</mo><mn>0</mn><mo>⇒</mo><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mi>x</mi><mi>sin</mi><mi>x</mi></math><br ><math><mfenced separators=\"|\"><mrow><mi>A</mi></mrow></mfenced></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mfrac><mi>π</mi><mn>4</mn></mfrac></mfenced><mo>=</mo><mo>-</mo><mfrac><mi>π</mi><mn>4</mn></mfrac><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac></math><br ><math><mfenced separators=\"|\"><mrow><mi>B</mi></mrow></mfenced></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mi>x</mi><mi>sin</mi><mi>x</mi></math><br >As <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mi>x</mi><mo>></mo><mi>x</mi><mo>-</mo><mfrac><msup><mi>x</mi><mn>3</mn></msup><mn>6</mn></mfrac></math> , <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mi>x</mi><mi>sin</mi><mi>x</mi><mo><</mo><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><msup><mi>x</mi><mn>4</mn></msup><mn>6</mn></mfrac></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∴</mo><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo><</mo><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><msup><mi>x</mi><mn>4</mn></msup><mn>6</mn></mfrac><mo> </mo><mo>∀</mo><mo> </mo><mi>x</mi><mo>∈</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>π</mi></mrow></mfenced></math><br ><math><mfenced separators=\"|\"><mrow><mi>C</mi></mrow></mfenced></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mi>′</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mi>sin</mi><mi>x</mi><mo>-</mo><mi>x</mi><mi>cos</mi><mi>x</mi></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mi>′</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>0</mn><mo>⇒</mo><mi>tan</mi><mi>x</mi><mo>=</mo><mo>-</mo><mi>x</mi><mo>⇒</mo></math> there exist <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi><mo>∈</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>π</mi></mrow></mfenced></math> for which <math><msup><mrow><mi>f</mi></mrow><mrow><mi>′</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>=</mo><mn>0</mn></math><br ><img src=\"assets\\st0010_9c2a4c820a98.png\"/><br ><math><mfenced separators=\"|\"><mrow><mi>D</mi></mrow></mfenced></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mo>\"</mo></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mn>2</mn><mi>cos</mi><mi>x</mi><mo>+</mo><mi>x</mi><mi>sin</mi><mi>x</mi></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mo>\"</mo></msup><mfenced separators=\"|\"><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac></mfenced><mo>=</mo><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac><mo>,</mo><mi> </mi><mi>f</mi><mfenced separators=\"|\"><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac></mfenced><mo>=</mo><mo>-</mo><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mo>\"</mo></msup><mfenced separators=\"|\"><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac></mfenced><mo>+</mo><mi>f</mi><mfenced separators=\"|\"><mfrac><mi mathvariant=\"normal\">π</mi><mn>2</mn></mfrac></mfenced><mo>=</mo><mn>0</mn></math>"
