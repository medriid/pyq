    {
      "id": "d6MD6",
      "text": "If&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>&#60;</mo><mn>0</mn><mo>,</mo></math>&nbsp;then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi></math> is a decreasing function",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ZhSyg",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>&#160;</mo><mi>f</mi><mfenced><mrow><mo>-</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mn>1</mn></math> for all <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mi mathvariant=\"normal\">&#8477;</mi></math>",
      "isCorrect": true,
