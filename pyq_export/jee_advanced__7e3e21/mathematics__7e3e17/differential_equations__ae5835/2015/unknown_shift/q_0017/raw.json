  "solution": {
    "text": "<math><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup></mrow></mfenced><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">y</mi><mo>+</mo><mi mathvariant=\"normal\">y</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi><mo>=</mo><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi></math> <br > <math><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">y</mi><mo>+</mo><mi mathvariant=\"normal\">d</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>.</mo><mi mathvariant=\"normal\">y</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi></math> <br > <math><mi mathvariant=\"normal\">y</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>=</mo><mi mathvariant=\"normal\">x</mi><mo>-</mo><mi mathvariant=\"normal\">y</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi></math> <br >Now,  <math><mi mathvariant=\"normal\">x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">y</mi><mo>=</mo><mn>2</mn></math> <br > <math><mn>2</mn><mo>.</mo><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mn>0</mn></mrow></msup><mo>=</mo><mn>0</mn><mo>-</mo><mn>2</mn><mo>+</mo><mi mathvariant=\"normal\">c</mi></math> <br > <math><mo>⇒</mo><mi mathvariant=\"normal\">c</mi><mo>=</mo><mn>4</mn></math> <br >Now,  <math><mi mathvariant=\"normal\">y</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>=</mo><mi mathvariant=\"normal\">x</mi><mo>-</mo><mi mathvariant=\"normal\">y</mi><mo>+</mo><mn>4</mn></math> <br > <math><mi mathvariant=\"normal\">y</mi><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>4</mn></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfrac></math> <br >Now,  <math><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">y</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>4</mn></mrow></mfenced><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfrac></math> <br > <math><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>+</mo><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">x</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>-</mo><mn>4</mn><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">x</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup><mo>-</mo><mn>3</mn><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi></mrow></msup></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mi mathvaria