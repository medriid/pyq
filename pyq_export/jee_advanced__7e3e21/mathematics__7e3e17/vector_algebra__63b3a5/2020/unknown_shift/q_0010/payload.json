  "solution": {
    "text": "<p><img src=\"assets\\st0010_5868420d4dd2.png\"/></p><p>Projection of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>a</mi><mo>→</mo></mover><mo> </mo><mi>a</mi><mi>l</mi><mi>o</mi><mi>n</mi><mi>g</mi><mo> </mo><mover><mi>b</mi><mo>→</mo></mover><mo>=</mo><mfrac><mrow><mover><mi>a</mi><mo>→</mo></mover><mo>.</mo><mover><mi>b</mi><mo>→</mo></mover></mrow><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>→</mo></mover></mfenced></mfrac><mo>·</mo><mover><mi>b</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>u</mi><mo>→</mo></mover><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover></mrow></mfenced><mo>·</mo><mfrac><mrow><mi>a</mi><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mi>b</mi><mover><mi>j</mi><mo>^</mo></mover></mrow><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></mfrac></mrow></mfenced><mfrac><mrow><mi>a</mi><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mi>b</mi><mover><mi>j</mi><mo>^</mo></mover></mrow><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></mfrac><mo>=</mo><mfrac><mfenced><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfenced><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></mfrac><mo>·</mo><mfrac><mrow><mi>a</mi><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mi>b</mi><mover><mi>j</mi><mo>^</mo></mover></mrow><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi mathvariant=\"normal\">v</mi><mo>→</mo></mover><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover></mrow></mfenced><mo>·</mo><mfrac><mrow><mi>a</mi><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mi>b</mi><mover><mi>j</mi><mo>^</mo></mover></mrow><msqrt><msup><mi mathvariant=\"normal\">a</mi><mn>2</mn></msup><mo>+</mo><msup><mi mathvariant=\"normal\">b</mi><mn>2</mn></msup></msqrt></mfrac></mrow></mfenced><mfrac><mrow><mi>a</mi><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mi>b</mi><mover><mi>j</mi><mo>^</mo></mover></mrow><msqrt><msup><mi mathvariant=\"normal\">a</mi><mn>2</mn></msup><mo>+</mo><msup><mi mathvariant=\"normal\">b</mi><mn>2</mn></msup></msqrt></mfrac><mo>=</mo><mfrac><mfenced><mrow><mi mathvariant=\"normal\">a</mi><mo>-</mo><mi mathvariant=\"normal\">b</mi></mrow></mfenced><msqrt><msup><mi mathvariant=\"normal\">a</mi><mn>2</mn></msup><mo>+</mo><msup><mi mathvariant=\"normal\">b</mi><mn>2</mn></msup></msqrt></mfrac><mo>·</mo><mfrac><mrow><mi>a</mi><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mi>b</mi><mover><mi>j</mi><mo>^</mo></mover></mrow><msqrt><msup><mi mathvariant=\"normal\">a</mi><mn>2</mn></msup><mo>+</mo><msup><mi mathvariant=\"normal\">b</mi><mn>2</mn></msup></msqrt></mfrac></math></p><p>given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mi mathvariant=\"normal\">i</mi></mtd><mtd><mi mathvariant=\"normal\">j</mi></mtd><mtd><mi mathvariant=\"normal\">k</mi></mtd></mtr><mtr><mtd><mi mathvariant=\"normal\">a</mi></mtd><mtd><mi mathvariant=\"normal\">b</mi></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mi mathvariant=\"normal\">a</mi></mtd><mtd><mo>-</mo><mi mathvariant=\"normal\">b</mi></mtd><mtd><mn>0</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mn>8</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>k</mi><mo>^</mo></mover><mfenced><mrow><mo>-</mo><mi>a</mi><mi>b</mi><mo>-</mo><mi>a</mi><mi>b</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>8</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>b</mi><mo>=</mo><mn>4</mn></math></p><p>Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mover><mi>u</mi><mo>→</mo></mover></mfenced><mo>+</mo><mo>|</mo><mover><mi>v</mi><mo>→</mo></mover><mo>|</mo><mo>=</mo><mover><mi>w</mi><mo>→</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></mfrac><mfrac><mfenced close=\"|\" open=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></mfrac><mo>=</mo><msqrt><mn>2</mn></msqrt></math></p><p>For <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>></mo><mi>b</mi></math>,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">a</mi><mn>2</mn></msup><mo>=</mo><msup><mi mathvariant=\"normal\">b</mi><mn>2</mn></msup><mo>⇒</mo><mo>  </mo><mi mathvariant=\"normal\">a</mi><mo>=</mo><mi mathvariant=\"normal\">b</mi><mo>=</mo><mn>2</mn></math></p><p>Similarly, for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>></mo><mi>a</mi><mo>,</mo><mo> </mo><mo> </mo><mo> </mo><mo> </mo><mi>a</mi><mo>=</mo><mi>b</mi><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>4</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>-</mo><mi>b</mi><mo>=</mo><mn>0</mn></math></p><p>Length of diagonal <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mfenced close=\"|\" open=\"|\"><mrow><mi>P</mi><mi>R</mi></mrow></mfenced><mo>→</mo></mover><mo>=</mo><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>PS</mi><mo>→</mo></mover><mo>+</mo><mover><mi>PQ</mi><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\"><mrow><mn>2</mn><mi mathvariant=\"normal\">a</mi><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover></mrow></mfenced><mo>=</mo><mn>2</mn><mi>a</mi><mo>=</mo><mn>4</mn></math>.</p>"
