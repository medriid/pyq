  "question": {
    "text": "The number of distinct real values of $\\lambda$, for which the vectors $-\\lambda^2 \\hat{\\mathbf{i}}+\\hat{\\mathbf{j}}+\\hat{\\mathbf{k}}$, $\\hat{\\mathbf{i}}-\\lambda^2 \\hat{\\mathbf{j}}+\\hat{\\mathbf{k}}$ and $\\hat{\\mathbf{i}}+\\hat{\\mathbf{j}}-\\lambda^2 \\hat{\\mathbf{k}}$ are coplanar, is",
    "image": null
  },
  "options": [
    {
      "id": "SmHun",
      "text": "\nzero\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7j85M",
      "text": "\none\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aUKIB",
      "text": "\ntwo\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "QfcYz",
      "text": "\nthree",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\left|\\begin{array}{ccc}\n-\\lambda^2 & 1 & 1 \\\\\n1 & -\\lambda^2 & 1 \\\\\n1 & 1 & -\\lambda^2\n\\end{array}\\right|=0 \\Rightarrow \\lambda^6-3 \\lambda^2-2=0 \\\\\n& \\Rightarrow \\quad\\left(1+\\lambda^2\\right)^2\\left(\\lambda^2-2\\right)=0 \\Rightarrow \\lambda=\\pm \\sqrt{2} \\\\\n&\n\\end{aligned}\n$$",
    "image": null
