  "question": {
    "text": "Let $\\mathbf{a}, \\mathbf{b}, \\mathbf{c}$ be unit vectors such that $\\mathbf{a}+\\mathbf{b}+\\mathbf{c}=\\mathbf{0}$. Which one of the following is correct?"
  },
  "options": [
    {
      "text": "\n$\\mathbf{a} \\times \\mathbf{b}=\\mathbf{b} \\times \\mathbf{c}=\\mathbf{c} \\times \\mathbf{a}=\\mathbf{0}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathbf{a} \\times \\mathbf{b}=\\mathbf{b} \\times \\mathbf{c}=\\mathbf{c} \\times \\mathbf{a} \\neq \\mathbf{0}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathbf{a} \\times \\mathbf{b}=\\mathbf{b} \\times \\mathbf{c}=\\mathbf{a} \\times \\mathbf{c}=\\mathbf{0}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathbf{a} \\times \\mathbf{b}, \\mathbf{b} \\times \\mathbf{c}, \\mathbf{c} \\times \\mathbf{a}$ are mutually perpendicular",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Since $\\mathbf{a}, \\mathbf{b}, \\mathbf{c}$ are unit vectors and $\\mathbf{a}+\\mathbf{b}+\\mathbf{c}=\\mathbf{0}$ $\\mathbf{a}, \\mathbf{b}$ and $\\mathbf{c}$ represent an equilateral triangle.\n$$\n\\therefore \\quad \\mathbf{a} \\times \\mathbf{b}=\\mathbf{b} \\times \\mathbf{c}=\\mathbf{c} \\times \\mathbf{a} \\neq \\mathbf{0} .\n$$"
  }
}