  "correctValue": "18",
  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable><mtr><mtd><mo>&#8757;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>3</mn><mi>i</mi><mo>+</mo><mn>3</mn><mi>j</mi></mtd><mtd><mo>&#8757;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>2</mn><mi>i</mi><mo>+</mo><mi>j</mi><mo>-</mo><mi>k</mi><mo>,</mo></mtd><mtd><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><msqrt><mn>6</mn></msqrt></mtd></mtr></mtable></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable><mtr><mtd><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>3</mn><msqrt><mn>2</mn></msqrt><mo>,</mo></mtd><mtd><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>i</mi><mo>+</mo><mn>2</mn><mi>j</mi><mo>+</mo><mi>k</mi><mo>,</mo></mtd><mtd><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><msqrt><mn>6</mn></msqrt></mtd></mtr></mtable></math><br /><math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>-</mo><mn>1</mn><mo>=</mo><mn>3</mn></math><br />Now,<br />as given projection of <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math> on <math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>3</mn><msqrt><mn>2</mn></msqrt></math><br /><math><mfrac><mrow><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfrac><mo>.</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>3</mn><msqrt><mn>2</mn></msqrt></math><br /><math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>.</mo><mfenced separators=\"|\"><mrow><mi>&#945;</mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mi>&#946;</mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>18</mn></math><br /><math><mi>&#945;</mi><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mi>&#946;</mi><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>&#946;</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>18</mn></math><br />as given <math><mn>6</mn><mi>&#945;</mi><mo>+</mo><mn>3</mn><mi>&#945;</mi><mo>+</mo><mn>6</mn><mi>&#946;</mi><mo>+</mo><mn>3</mn><mi>&#946;</mi><mo>=</mo><mn>18</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable><mtr><mtd><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>&#945;</mi><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>&#946;</mi><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>,</mo></mtd><mtd><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi><mo>=</mo><mn>2</mn></mtd></mtr></mtable></math> &hellip;(i)<br />Since <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>,</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math> and <math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></math> are co-planar hence <math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>.</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn></math><br />Minimum value of <math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>-</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfenced><mo>.</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo></math> Minimum of <math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></math><br /><math><mo>=</mo></math> Minimum of <math><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mfenced separators=\"|\"><mrow><mo>&#8757;</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>.</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn></mrow></mfenced></math><br />now <math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>&#945;</mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mi>&#946;</mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math> and <math><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi><mo>=</mo><mn>2</mn></math><br /><math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>i</mi><mo>+</mo><mi>j</mi><mo>-</mo><mi>k</mi></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>-</mo><mi>&#945;</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>i</mi><mo>+</mo><mn>2</mn><mi>j</mi><mo>+</mo><mi>k</mi></mrow></mfenced><mo>=</mo></math><br /><math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mi>&#945;</mi></mrow></mfenced><mi>i</mi><mo>+</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mo>-</mo><mi>&#945;</mi></mrow></mfenced><mi>j</mi><mo>+</mo><mi>k</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mo>-</mo><mn>2</mn><mi>&#945;</mi></mrow></mfenced></math><br /><math><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>6</mn><mfenced separators=\"|\"><mrow><msup><mrow><mi>&#945;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>2</mn><mi>&#945;</mi><mo>+</mo><mn>4</mn></mrow></mfenced></math><br /><math><mtable><mtr><mtd><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">&#160;</mi><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>18</mn></mtd><mtd><mfenced separators=\"|\"><mrow><mo>&#8756;</mo><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">&#160;</mi><mi>a</mi><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>b</mi><mi>n</mi><mo>+</mo><mi>c</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mi>D</mi></mrow><mrow><mn>4</mn><mi>a</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfrac><mrow><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><mi>a</mi><mi>c</mi></mrow><mrow><mn>4</mn><mi>a</mi></mrow></mfrac></mrow></mfenced></mtd></mtr></mtable></math>",
