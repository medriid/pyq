><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">s</mi><mo>=</mo></mtd></mtr></mtable><mmultiscripts><mi>C</mi><mn>4</mn><none/><mprescripts/><mi>&#160;</mi><mn>6</mn></mmultiscripts><mo>&#215;</mo><mmultiscripts><mi>C</mi><mn>2</mn><none/><mprescripts/><mi>&#160;</mi><mn>4</mn></mmultiscripts><mo>&#215;</mo><mmultiscripts><mi>C</mi><mn>1</mn><none/><mprescripts/><mi>&#160;</mi><mn>2</mn></mmultiscripts><mo>=</mo><mn>180</mn></math><br />Case <math><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">I</mi><mo>:</mo></math><br /><math><mi>n</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mn>3</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>n</mi><mfenced separators=\"|\"><mi>A</mi></mfenced><mi>n</mi><mfenced separators=\"|\"><mi>B</mi></mfenced><mo>=</mo><mn>18</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mi>a</mi></mfenced><mi>&#160;</mi><mtable><mtr><mtd><mi>n</mi><mfenced separators=\"|\"><mi>A</mi></mfenced><mo>=</mo><mn>6</mn><mo>,</mo></mtd><mtd><mi>n</mi><mfenced separators=\"|\"><mi>B</mi></mfenced><mo>=</mo><mn>3</mn><mo>&#160;</mo><mi>Number</mi><mi mathvariant=\"normal\">&#160;</mi><mi>of</mi><mi mathvariant=\"normal\">&#160;</mi><mi>ways</mi><mo>&#8658;</mo></mtd><mtd><mmultiscripts><mi>C</mi><mn>6</mn><none/><mprescripts/><mi>&#160;</mi><mn>6</mn></mmultiscripts><mo>&#215;</mo><mmultiscripts><mi>C</mi><mn>3</mn><none/><mprescripts/><mi>&#160;</mi><mn>6</mn></mmultiscripts><mo>=</mo><mn>20</mn></mtd></mtr></mtable></math><br />Case <math><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">V</mi><mo>:</mo></math><br /><math><mi>n</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mi>B</mi></mrow></mfenced><mo>