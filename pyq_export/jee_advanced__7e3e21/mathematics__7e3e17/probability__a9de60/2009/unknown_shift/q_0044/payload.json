    },
    {
      "text": "\n$\\frac{5}{36}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{25}{216}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$P(X \\geq 3)=\\frac{5}{6} \\cdot \\frac{5}{6} \\cdot 1=\\frac{25}{36}$"
