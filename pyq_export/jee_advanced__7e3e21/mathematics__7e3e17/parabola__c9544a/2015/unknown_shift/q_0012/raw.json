    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/image67-b74702d3-04a8-4d9f-9aed-aa27173f32df.png\"/></p><p><math><mo>∆</mo><mo>=</mo><mn>3</mn><msqrt><mn>2</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mfrac><msubsup><mi>t</mi><mn>1</mn><mn>2</mn></msubsup><mn>2</mn></mfrac></mtd><mtd><msub><mi>t</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><mfrac><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><mn>2</mn></mfrac></mtd><mtd><msub><mi>t</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><msubsup><mi>t</mi><mn>1</mn><mn>2</mn></msubsup><msub><mi>t</mi><mn>2</mn></msub></mrow><mn>2</mn></mfrac><mo>-</mo><mfrac><mrow><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>t</mi><mn>1</mn></msub></mrow><mn>2</mn></mfrac></mrow></mfenced><mo>=</mo><mo>±</mo><mn>3</mn><msqrt><mn>2</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub><mfenced separators=\"|\"><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mo>±</mo><mn>3</mn><msqrt><mn>2</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub><mfenced separators=\"|\"><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mo>±</mo><mn>12</mn><msqrt><mn>2</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>t</mi><mn>1</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub