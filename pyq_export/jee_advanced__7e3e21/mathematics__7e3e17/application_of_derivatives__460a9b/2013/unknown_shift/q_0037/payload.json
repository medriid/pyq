o>+</mo><mn>2</mn><mo>)</mo><mo>,</mo><mo>&#160;</mo><mn>2</mn><mo>&#60;</mo><mi>x</mi><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"}\" open=\"{\"><mtable><mtr><mtd><mn>4</mn><mi>x</mi><mo>,</mo><mo>&#160;</mo><mn>0</mn><mo>&#60;</mo><mi>x</mi><mo>&#8804;</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi><mo>+</mo><mn>4</mn><mo>,</mo><mo>&#160;</mo><mn>2</mn><mo>&#60;</mo><mi>x</mi></mtd></mtr></mtable></mfenced><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mn>3</mn><mo>)</mo></math></p><p>From <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>)</mo><mo>,</mo><mo>&#160;</mo><mo>(</mo><mn>2</mn><mo>)</mo><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mo>(</mo><mn>3</mn><mo>)</mo><mo>,</mo></math>&nbsp;we get<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext mathvariant=\"italic\">f</mtext><mtext>(</mtext><mtext mathvariant=\"italic\">x</mtext><mtext>)=</mtext><mfenced close=\"}\" open=\"{\"><mtable><mtr><mtd><mo>-</mo><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#8804;</mo><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi><mo>+</mo><mn>4</mn><mo>,</mo></mtd><mtd><mo>-</mo><mn>2</mn><mo>&#60;</mo><mi>x</mi><mo>&#8804;</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>3</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mn>4</mn><mi>x</mi><mo>,</mo></mtd><mtd><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mn>3</mn></mfrac><mo>&#60;</mo><mi>x</mi><mo>&#8804;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>4</mn><mi>x</mi><mo>,</mo></mtd><mtd><mn>0</mn><mo>&#60;</mo><mi>x</mi><mo>&#8804;</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>2</mn><mi>x</mi><mo>+</mo><mn>4</mn><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#62;</mo><mn>2</mn></mtd></mtr></mtable></mfenced></math></p><p><img alt=\"\" src=\"assets\\st0037_d7159949df8b.jpg\" style=