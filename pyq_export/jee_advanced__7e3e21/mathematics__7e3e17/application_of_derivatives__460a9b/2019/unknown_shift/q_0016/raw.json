    },
    {
      "id": "EWDwa",
      "text": "<math><mi mathvariant=\"normal\">f</mi></math> is increasing on <math><mfenced separators=\"|\"><mrow><mo>-</mo><mi mathvariant=\"normal\">∞</mi><mo>,</mo><mtext> </mtext><mn>0</mn></mrow></mfenced></math>",
      "isCorrect": false,
