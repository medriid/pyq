    {
      "id": "j9Jr7",
      "text": "<math><msup><mrow><mi>x</mi></mrow><mrow><mn>9</mn></mrow></msup><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math>",
      "isCorrect": true,
