  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>:</mo><mi mathvariant=\"normal\">R</mi><mo>&#8594;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></mfenced></math>&nbsp;, be a continuous function then, which of the following function(s), has(have) the values zero at some point in the interval, (0,1)?"
  },
  "options": [
    {
      "text": "<math><mi>x</mi><mo>-</mo><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mi>x</mi></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow><mi>d</mi><mi>t</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math><msup><mrow><mi>x</mi></mrow><mrow><mn>9</mn></mrow></msup><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math>",
      "is_correct": true
    },
    {
      "text": "<math><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>-</mo><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow><mi>d</mi><mi>t</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>+</mo><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow><mi>d</mi><mi>t</mi></math>",
