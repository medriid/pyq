ors=\"|\"><mrow><mi>D</mi></mrow></mfenced></math>   <math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><msup><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math> <br > <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></mrow></mfenced><mo>≤</mo><mn>1</mn></math>      (by LMVT)<br > <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></mrow></mfenced><mo>≤</mo><mn>2</mn></math>      (given)<br > <math><mo>⇒</mo><mi> </mi><mi> </mi><mi>g</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>≤</mo><mn>5</mn><mi> </mi><mi> </mi><mo>∃</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>∈</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>4,0</mn></mrow></mfenced></math> <br >Similarly  <math><mi>g</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>≤</mo><mn>5</mn><mi> </mi><mi> </mi><mo>∃</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>∈</mo><mfenced separators=\"|\"><mrow><mn>0,4</mn></mrow></mfenced></math> <br > <math><mi>g</mi><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced><mo>=</mo><mn>85</mn><mi> </mi><mo>⇒</mo><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math>  has maxima in  <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mi> </mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">y</mi><mi> </mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi> </mi><mi>α</mi></math> <br > <math><msup><mrow><mi>g</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>=</mo><mn>0</mn><mi> </mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi> </mi><mi>g</mi><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>≥</mo><mn>85</mn></math> <br > <math><mn>2</mn><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>+</mo><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>0</mn></math> <br >If  <math><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>=</mo><mn>0</mn><mo>⇒</mo><mi>g</mi><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>=</mo><msup><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>≥</mo><mn>85</mn></math>  not possible<br > <math><mo>⇒</mo><mi> </mi><mi> </mi><mi>f</mi><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>+</mo><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>α</mi></mrow></mfenced><mo>=</mo><mn>0</mn><mi> </mi><mo>∃</mo><mi>α</mi><mo>∈</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><msub><mrow><mi>x</mi