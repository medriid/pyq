nt=\"normal\">d</mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">r</mi></mrow></mfrac><mo>=</mo><mn>4</mn><mi mathvariant=\"normal\">V</mi><mi mathvariant=\"normal\"> </mi><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></mrow></mfenced><mo>+</mo><mn>4</mn><mi mathvariant=\"normal\">π</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">r</mi><mo>+</mo><mn>2</mn></mrow></mfenced></math> <br >Where  <math><mi mathvariant=\"normal\">r</mi><mo>=</mo><mn>10</mn><mo>,</mo><mfrac><mrow><mi mathvariant=\"normal\">d</mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">r</mi></mrow></mfrac><mo>=</mo><mn>0</mn></math> <br > <math><mo>⇒</mo><mn>4</mn><mi mathvariant=\"normal\">V</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>100</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mrow><mn>1000</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mn>48</mn><mi mathvariant=\"normal\">π</mi><mo>=</mo><mn>0</mn></math> <br > <math><mo>⇒</mo><mn>4</mn><mi mathvariant=\"normal\">V</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>12</mn></mrow><mrow><mn>1000</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mn>48</mn><mi mathvariant=\"normal\">π</mi></math> <br > <math><mo>∴</mo><mfrac><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>250</mn><mi mathvariant=\"normal\">π</mi></mrow></mfrac><mo>=</mo><mn>4</mn></math>",
