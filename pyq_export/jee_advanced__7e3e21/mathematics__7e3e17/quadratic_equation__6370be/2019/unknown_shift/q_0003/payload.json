    "text": "<p>Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi></math>&nbsp;are roots of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>1</mn><mo>=</mo><mi>&#160;</mi><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>-</mo><msub><mi>a</mi><mi>k</mi></msub><mo>=</mo><mfrac><mrow><mfenced><mrow><msup><mi>&#945;</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msup><mo>-</mo><msup><mi>&#946;</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msup></mrow></mfenced><mo>-</mo><mfenced><mrow><msup><mi>&#945;</mi><mi>k</mi></msup><mo>-</mo><msup><mi>&#946;</mi><mi>k</mi></msup></mrow></mfenced></mrow><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mfenced><mrow><msup><mi>&#945;</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msup><mo>-</mo><msup><mi>&#945;</mi><mi>k</mi></msup></mrow></mfenced><mo>-</mo><mfenced><mrow><msup><mi>&#946;</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msup><mo>-</mo><msup><mi>&#946;</mi><mi>k</mi></msup></mrow></mfenced></mrow><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><msup><mi>&#945;</mi><mi>k</mi></msup><mfenced><mrow><msup><mi>&#945;</mi><mn>2</mn></msup><mo>-</mo><mn>1</mn></mrow></mfenced><mo>-</mo><msup><mi>&#946;</mi><mi>k</mi></msup><mfenced><mrow><msup><mi>&#946;</mi><mn>2</mn></msup><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow></mfrac><mo>=</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>a</mi><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>-</m