  "question": {
    "text": "The quadratic equation <math><mi mathvariant=\"normal\">p</mi><mo>(</mo><mi mathvariant=\"normal\">x</mi><mo>)</mo><mi mathvariant=\"normal\">&#160;</mi><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><mn>0</mn></math> with real coefficients has purely imaginary roots. Then the equation&nbsp;<math><mi mathvariant=\"normal\">p</mi><mo>(</mo><mi mathvariant=\"normal\">p</mi><mo>(</mo><mi mathvariant=\"normal\">x</mi><mo>)</mo><mo>)</mo><mi mathvariant=\"normal\">&#160;</mi><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><mn>0</mn></math> has",
    "image": null
  },
  "options": [
    {
      "id": "6ejZr",
      "text": "Only purely imaginary roots",
      "isCorrect": false,
      "image": null
    },
