  "solution": {
    "text": "<math><mi>α</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mi>x</mi><mo>+</mo><mi>α</mi><mo>=</mo><mn>0</mn></math> <br > <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>&lt;</mo><mn>0</mn></math> <br > <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><msqrt><mn>1</mn><mo>-</mo><mn>4</mn><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow><mrow><mi>α</mi></mrow></mfrac></mrow></mfenced><mo>&lt;</mo><mn>1</mn></math> <br > <math><msqrt><mn>1</mn><mo>-</mo><mn>4</mn><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mo>&lt;</mo><mo>|</mo><mi>α</mi><mo>|</mo></math> <br > <math><mn>1</mn><mo>-</mo><mn>4</mn><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&lt;</mo><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup></math> <br > <math><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>&gt;</mo><mn>0</mn></math> <br > <math><mi>α</mi><mo>∈</mo><mi> </mi><mfenced separators=\"|\"><mrow><mo>-</mo><mi>∞</mi><mo>,</mo><mi> </mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>5</mn></msqrt></mrow></mfrac></mrow></mfenced><mi> </mi><mo>∪</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>5</mn></msqrt></mrow></mfrac><mo>,</mo><mi> </mi><mi>∞</mi></mrow></mfenced></math> <br >Also,   <math><mn>1</mn><mo>-</mo><mn>4</mn><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&gt;</mo><mn>0</mn></math> <br > <math><msup><mrow><mi>α</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>&lt;</mo><mn>0</mn></math> <br > <math><mfenced separators=\"|\"><mrow><mi>α</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mi> </mi><mi> </mi><mfenced separators=\"|\"><mrow><mi>α</mi><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>&lt;</mo><mn>0</mn></math> <br > <math><mi>α</mi><mi> </mi><mo>∈</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math> <br >Taking intersection<br > <math><mi>α</mi><mi> </mi><mo>∈</mo><mi> </mi><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi> </mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>5</mn></msqrt></mrow></mfrac></mrow></mfenced><mi> </mi><mo>∪</mo><mi> </mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>5</mn></msqrt></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math>",
