    "text": "Let <math><msub><mrow><mi>z</mi></mrow><mrow><mi>k</mi></mrow></msub><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>k</mi><mi>&#960;</mi></mrow><mrow><mn>10</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mi>i</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>k</mi><mi>&#960;</mi></mrow><mrow><mn>10</mn></mrow></mfrac></mrow></mfenced><mo>;</mo><mi>k</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi>&#160;</mi><mn>2</mn><mo>,</mo><mo>&#8230;</mo><mo>,</mo><mn>9</mn></mrow></mrow></mrow></mrow></math><br />&nbsp;<table border=\"1\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>List &ndash; I</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>List &ndash; II</td>\t\t</tr>\t\t<tr>\t\t\t<td>(A)</td>\t\t\t<td>For each <math><msub><mrow><mi>z</mi></mrow><mrow><mi>k</mi></mrow></msub></math> there exists a <math><msub><mrow><mi>z</mi></mrow><mrow><mi>j</mi></mrow></msub><mi>&#160;</mi><mi>s</mi><mi>u</mi><mi>c</mi><mi>h</mi><mi>&#160;</mi><msub><mrow><mi>z</mi></mrow><mrow><mi>k</mi></mrow></msub><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><msub><mrow><mi>z</mi></mrow><mrow><mi>j</mi></mrow></msub><mo>=</mo><mn>1</mn></math></td>\t\t\t<td>(P)</td>\t\t\t<td>True</td>\t\t</tr>\t\t<tr>\t\t\t<td>(B)</td>\t\t\t<td>There exists <math><mi>a</mi><mi>&#160;</mi><mi>k</mi><mi>&#160;</mi><mi>&#1013;</mi><mi>&#160;</mi><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi>&#160;</mi><mn>2</mn><mo>,</mo><mi>&#160;</mi><mo>&#8230;</mo><mo>,</mo><mn>9</mn></mrow></mfenced></math> such that <math><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><mi>z</mi><mo>=</mo><msub><mrow><mi>z</mi></mrow><mrow><mi>k</mi></mrow></msub></math> has no solution z in the set of complex numbers</td>\t\t\t<td>(Q)</td>\t\t\t<td>False</td>\t\t</tr>\t\t<tr>\t\t\t<td>(C)</td>\t\t\t<td><math><mfrac><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mi>&#160;</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>&#8230;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>9</mn></mrow></msub></mrow></mfenced><mi>&#160;</mi></mrow><mrow><mn>10</mn></mrow></mfrac><mi>&#160;</mi></math> equals</td>\t\t\t<td>(R)</td>\t\t\t<td>1</td>\t\t</tr>\t\t<tr>\t\t\t<td>(D)</td>\t\t\t<td><math><mn>1</mn><mo>-</mo><mrow><msubsup><mo stretchy=\"false\">&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>9</mn></mrow></msubsup><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>k</mi><mi>&#960;</mi></mrow><mrow><mn>10</mn></mrow></mfrac></mrow></mfenced></mrow></mrow></mrow></mrow><mi>&#160;</mi></math> equals</td>\t\t\t<td>(S)</td>\t\t\t<td>2</td>\t\t</tr>\t</tbody></table>",
