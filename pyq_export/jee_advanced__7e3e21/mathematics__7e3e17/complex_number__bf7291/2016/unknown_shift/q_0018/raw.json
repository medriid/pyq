    "text": "<math><mi>x</mi><mo>+</mo><mi>i</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi><mo>+</mo><mi>i</mi><mi>b</mi><mi>t</mi></mrow></mfrac></math> (Multiply &amp; divide by conjugate <math><mi>a</mi><mo>+</mo><mi>i</mi><mi>b</mi><mi>t</mi></math>)<br /><math><mi>x</mi><mo>+</mo><mi>i</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mi>a</mi><mo>-</mo><mi>i</mi><mi>b</mi><mi>t</mi></mrow><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&nbsp;</mi><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br />Let <math><mi>a</mi><mi>&nbsp;</mi><mo>≠</mo><mn>0</mn></math> and <math><mi>b</mi><mi>&nbsp;</mi><mo>≠</mo><mn>0</mn></math><br /><math><mi>x</mi><mo>=</mo><mfrac><mrow><mi>a</mi></mrow><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&nbsp;</mi><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math> ......(i)<br /><math><mi>y</mi><mo>=</mo><mfrac><mrow><mo>-</mo><mi>b</mi><mi>t</mi></mrow><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&nbsp;</mi><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math> ......(ii)<br /><math><mfrac><mrow><mi>y</mi></mrow><mrow><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mi>b</mi><mi>t</mi></mrow><mrow><mi>a</mi></mrow></mfrac><mi>&nbsp;</mi><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>t</mi><mo>=</mo><mi>&nbsp;</mi><mo>-</mo><mfrac><mrow><mi>a</mi><mi>y</mi></mrow><mrow><mi>b</mi><mi>x</mi></mrow></mfrac></math><br />Put in (i)<br /><math><mi>x</mi><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>.</mo><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced><mo>=</mo><mi>a</mi></math><br /><math> <mo>⇒</mo> </math> <math><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>=</mo><mi>a</mi><mi>x</mi></math><br /><math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi></mrow></mfrac><mi>x</mi><mo>=</mo><mn>0</mn></math><br /><math><msup><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>a</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mi>&nbsp;</mi></math><br />Circle with centre <math> <mrow><mo>(</mo> <mrow> <mfrac> <mn>1</mn> <mrow> <mn>2</mn><mi>a</mi> </mrow> </mfrac> <mo>,</mo><mn>0</mn> </mrow> <mo>)</mo></mrow> </math> , radius <math> <mo>=</mo><mfrac> <mn>1</mn> <mrow> <mn>2</mn><mrow><mo>|</mo> <mi>a</mi> <mo>|</mo></mrow> </mrow> </mfrac> </math> <math> <mrow> <mrow><mo>{</mo> <mrow> <mtable> <mtr> <mtd> <mrow> <mi>a</mi><mo>&gt;</mo><mn>0</mn><mtext>&nbsp;;&nbsp;</mtext><mfrac> <mn>1</mn> <mrow> <mn>2</mn><mi>a</mi> </mrow> </mfrac> </mrow> </mtd> </mtr> <mtr> <mtd> <mrow> <mi>a</mi><mo>&lt;</mo><mn>0</mn><mtext>&nbsp;</mtext><mo>;</mo><mtext>&nbsp;</mtext><mfrac> <mrow> <mo>−</mo><mn>1</mn> </mrow> <mrow> <mn>2</mn><mi>a</mi> </mrow> </mfrac> </mrow> </mtd> </mtr> </mtable> </mrow> </mrow> </mrow> </math><br />For <math><mi>a</mi><mo>≠</mo><mn>0</mn><mo>,</mo><mi>&nbsp;</mi><mi>b</mi><mo>=</mo><mn>0</mn></math><br /><math><mi>x</mi><mo>+</mo><mi>i</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi></mrow></mfrac></math><br /><math><mi>x</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mi>y</mi><mo>=</mo><mn>0</mn><mi>&nbsp;</mi><mo>⇒</mo><mi>z</mi></math> lies on x - axis &nbsp;<br />For <math><mi>a</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>b</mi><mo>≠</mo><mn>0</mn></math><br /><math><mi>x</mi><mo>+</mo><mi>i</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>i</mi><mi>b</mi><mi>t</mi></mrow></mfrac></math><br /><math><mi>y</mi><mo>=</mo><mi>&nbsp;</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>b</mi><mi>t</mi></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mi>x</mi><mo>=</mo><mn>0</mn></math><br /><math><mo>⇒</mo></math> z lies on y - axis.",
