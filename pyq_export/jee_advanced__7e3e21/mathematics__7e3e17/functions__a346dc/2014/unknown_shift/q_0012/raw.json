    "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"italic\">sec</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"italic\">tan</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow></mrow></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msup><mi>&nbsp;</mi><mo>&forall;</mo><mi>&nbsp;</mi><mi>x</mi><mi>&nbsp;</mi><mo>&isin;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mi>f</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mi>&nbsp;</mi><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>,</mo></math> hence <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> is odd function<br />Let <math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mi>&nbsp;</mi><mo>&forall;</mo><mi>&nbsp;</mi><mi>x</mi><mi>&nbsp;</mi><mo>&isin;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mo>&rArr;</mo></math> <math><msup><mrow><mi>g</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>&gt;</mo><mn>0</mn><mi>&nbsp;</mi><mo>&forall;</mo><mi>&nbsp;</mi><mi>x</mi><mi>&nbsp;</mi><mo>&isin;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mo>&rArr;</mo></math> <math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> is one - one function<br />Hence <math><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow></mfenced></mrow></mrow></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msup></math> is one - one function.<br />And <math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mi>&nbsp;</mi><mo>&isin;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&nbsp;</mi><mi>&infin;</mi></mrow></mfenced><mi>&nbsp;</mi><mo>&forall;</mo><mi>&nbsp;</mi><mi>x</mi><mo>&isin;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>&pi;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mo>&rArr;</mo></math> <math><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow></mfenced></mrow></mrow><mi>&nbsp;</mi><mo>&isin;</mo><mi>R</mi></math> Hence <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> is an onto function.<br />",
