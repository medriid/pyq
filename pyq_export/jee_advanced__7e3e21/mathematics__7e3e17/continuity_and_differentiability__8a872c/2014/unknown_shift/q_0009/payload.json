  "solution": {
    "text": "<math><mi>h</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi> </mi><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><mrow><maligngroup/><mtable><mtr><mtd><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn><mo>,</mo></mtd><mtd><mi>x</mi><mi> </mi><mo>∈</mo><mfenced close=\"]\" separators=\"|\"><mrow><mo>-</mo><mi>∞</mi><mo>,</mo><mi> </mi><mo>-</mo><mn>1</mn></mrow></mfenced></mtd></mtr><mtr><mtd><mo>-</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo>,</mo></mtd><mtd><mi>x</mi><mi> </mi><mo>∈</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mi> </mi><mn>0</mn></mrow></mfenced></mtd></mtr><mtr><mtd><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn><mo>,</mo></mtd><mtd><mi>x</mi><mi> </mi><mo>∈</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi> </mi><mn>1</mn></mrow></mfenced></mtd></mtr></mtable></mrow></mtd></mtr><mtr><mtd><mrow><maligngroup/><mtable><mtr><mtd><mi>x</mi><mo>+</mo><mn>1</mn><mo>,</mo><mi> </mi></mtd><mtd><mi>x</mi><mi> </mi><mo>∈</mo><mfenced open=\"[\" separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi> </mi><mi>∞</mi></mrow></mfenced></mtd></mtr></mtable></mrow></mtd></mtr></mtable></mrow></mfenced></math> <br >Hence, not differentiable at  <math><mi>x</mi><mo>=</mo><mo>-</mo><mn>1</mn><mo>,</mo><mi> </mi><mn>0</mn><mo>,</mo><mi> </mi><mn>1</mn></math>"
