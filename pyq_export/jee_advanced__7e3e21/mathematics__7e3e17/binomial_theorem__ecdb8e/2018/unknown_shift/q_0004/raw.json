    "text": "<math><mi>X</mi><mo>=</mo><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><mi>r</mi><mo>.</mo></mrow></mrow><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow/><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>;</mo><mi>n</mi><mo>=</mo><mn>10</mn></math>  <br > <math><mi>X</mi><mo>=</mo><mi>n</mi><mo>.</mo><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><msup><mrow/><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub></mrow></mrow><mo>.</mo><mi> </mi><mi> </mi><msup><mrow/><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi><mo>-</mo><mn>1</mn></mrow></msub></math>  <br > <math><mi>X</mi><mo>=</mo><mi>n</mi><mo>.</mo><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><msup><mrow/><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi><mo>-</mo><mi>r</mi></mrow></msub></mrow></mrow><mo>.</mo><mi> </mi><mi> </mi><msup><mrow/><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi><mo>-</mo><mn>1</mn></mrow></msub></math>  <br >  <math><mi>X</mi><mo>=</mo><mi>n</mi><mo>.</mo><mi> </mi><msup><mrow/><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msub><mo>;</mo><mi>n</mi><mo>=</mo><mn>10</mn></math> <br > <math><mi>X</mi><mo>=</mo><mn>10</mn><mo>.</mo><mi> </mi><msup><mrow/><mrow><mn>19</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>9</mn></mrow></msub></math>  <br > <math><mfrac><mrow><mi>X</mi></mrow><mrow><mn>1430</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>143</mn></mrow></mfrac><mo>.</mo><msup><mrow/><mrow><mn>19</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>9</mn></mrow></msub></math>  <br > <math><mo>=</mo><mn>646</mn></math>",
