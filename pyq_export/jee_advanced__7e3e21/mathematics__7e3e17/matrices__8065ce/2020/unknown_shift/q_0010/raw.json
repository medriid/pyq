    },
    {
      "id": "HSoDU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>det</mi><mi>M</mi><mo>=</mo><mn>1</mn></math>",
      "isCorrect": true,
