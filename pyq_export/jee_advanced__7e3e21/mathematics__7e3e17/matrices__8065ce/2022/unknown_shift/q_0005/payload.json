  "solution": {
    "text": "<blockquote><p>Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mn>5</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>M</mi><mn>2</mn></msup><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mn>5</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced><mfenced><mtable><mtr><mtd><mfrac><mn>5</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced><mo>=</mo><mfenced><mtable><mtr><mtd><mn>4</mn></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>M</mi><mn>3</mn></msup><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mn>5</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced><mfenced><mtable><mtr><mtd><mn>4</mn></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mn>11</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>9</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>9</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>7</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>M</mi><mn>4</mn></msup><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mn>11</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>9</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>9</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>7</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced><mfenced><mtable><mtr><mtd><mfrac><mn>11</mn><mn>2</mn></mfrac></mtd><mtd><mfrac><mn>9</mn><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mn>9</mn><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mn>7</mn><mn>2</mn></mfrac></mtd></mtr></mtable></mfenced><mo>=</mo><mfenced><mtable><mtr><mtd><mn>7</mn></mtd><mtd><mn>6</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>6</mn></mtd><mtd><mo>-</mo><mn>5</mn></mtd></mtr></mtable></mfenced></math></p><p>and so on</p><p>i.e.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>M</mi><mi>n</mi></msup><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mrow><mn>3</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mo>+</mo><mn>1</mn></mtd><mtd><mfrac><mrow><mn>3</mn><mi>n</mi></mrow><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mrow><mn>3</mn><mi>n</mi></mrow><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mrow><mn>3</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mo>+</mo><mn>1</mn></mtd></mtr></mtable></mfenced></math></p><p>Hence,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>M</mi><mn>2022</mn></msup><mo>=</mo><mfenced><mtable><mtr><mtd><mfrac><mrow><mn>3</mn><mo>&#215;</mo><mn>2022</mn></mrow><mn>2</mn></mfrac><mo>+</mo><mn>1</mn></mtd><mtd><mfrac><mrow><mn>3</mn><mo>&#215;</mo><mn>2022</mn></mrow><mn>2</mn></mfrac></mtd></mtr><mtr><mtd><mo>-</mo><mfrac><mrow><mn>3</mn><mo>&#215;</mo><mn>2022</mn></mrow><mn>2</mn></mfrac></mtd><mtd><mo>-</mo><mfrac><mrow><mn>3</mn><mo>&#215;</mo><mn>2022</mn></mrow><mn>2</mn></mfrac><mo>+</mo><mn>1</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced><mtable><mt