    "text": "<math><mi>P</mi><mi>Q</mi><mo>=</mo><mi>k</mi><mi>I</mi></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>P</mi></mrow></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>Q</mi></mrow></mfenced><mo>=</mo><msup><mrow><mi>k</mi></mrow><mrow><mn>3&#160; &#160; &#160;</mn></mrow></msup></math>( as order is 3 )<br /><math><mo>&#8658;</mo></math> <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>P</mi></mrow></mfenced><mo>=</mo><mn>2</mn><mi>k</mi><mi>&#160;</mi><mo>&#8800;</mo><mn>0</mn><mi>&#160;</mi><mi>&#160;</mi><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>P</mi></math> is an invertible matrix<br /><math><mo>&#8757;</mo></math> <math><mi>P</mi><mi>Q</mi><mo>=</mo><mi>k</mi><mi>I</mi></math><br /><math><mo>&#8756;</mo></math> <math><mi>Q</mi><mo>=</mo><mi>k</mi><msup><mrow><mi>P</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>&#160;</mi><mi>I</mi></math> <math><mo>=</mo><mi mathvariant=\"normal\">K</mi><mfrac><mrow><mn>1</mn></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">P</mi></mrow></mfenced></mrow></mfrac><mi mathvariant=\"normal\"> adj P</mi></math><br /><math><mo>&#8756;</mo></math> <math><mi>Q</mi><mo>=</mo><mfrac><mrow><mi>a</mi><mi>d</mi><mi>j</mi><mo>.</mo><mi>P</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>&#8757;</mo></math> <math><msub><mrow><mi>q</mi></mrow><mrow><mn>23</mn></mrow></msub><mo>=</mo><mi>&#160;</mi><mo>-</mo><mfrac><mrow><mi>k</mi></mrow><mrow><mn>8</mn></mrow></mfrac></math><math><mo>(</mo><mrow><mo>&#8756;</mo></mrow></math> cofactor <math><mi mathvariant=\"normal\"></mi><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>32</mn></mrow></msub><mo>=</mo><mi mathvariant=\"normal\"> </mi><mo>-</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">&#945;</mi><mo>+</mo><mn>4</mn></mrow></mfenced><mo>)</mo></math><br /><math><mo>&#8658;</mo><mn>12</mn><mi mathvariant=\"normal\">&#945;</mi><mo>+</mo><mn>16</mn><mo>=</mo><mi mathvariant=\"normal\">K &#38;</mi><mfrac><mrow><mi mathvariant=\"normal\">adjP</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><msup><mrow><mfrac><mrow><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>32</mn></mrow></msub></mrow></mfenced></mrow><mrow><mi> </mi></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></mrow><mrow><mi>T</mi></mrow></msup><mo>-</mo><msub><mrow><mi>q</mi></mrow><mrow><mn>23</mn></mrow></msub><mi> </mi></math><br /><math><mo>&#8756;</mo></math> undefined ...... (i)<br /><math><mi mathvariant=\"normal\">Also </mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">P</mi></mrow></mfenced><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">k </mi><mo>&#8658;</mo><mi mathvariant=\"normal\">k</mi><mo>=</mo><mn>10</mn><mo>+</mo><mn>6</mn><mi mathvariant=\"normal\"> &#945;</mi></math> &nbsp; &nbsp; &nbsp; ......(ii)<br /><math><mi mathvariant=\"normal\">Solving these two </mi><mo>&#8658;</mo><mn>12</mn><mi mathvariant=\"normal\">&#945;</mi><mo>+</mo><mn>16</mn><mo>=</mo><mn>10</mn><mo>+</mo><mn>6</mn><mi mathvariant=\"normal\">&#945;</mi><mo>&#8658;</mo><mi mathvariant=\"normal\">&#945;</mi><mo>=</mo><mo>-</mo><mn>1</mn></math> &amp; <math><mi mathvariant=\"normal\">K</mi><mo>=</mo><mn>4</mn></math><br /><math><mo>&#8756;</mo></math> <math><mn>4</mn><mi>&#945;</mi><mo>-</mo><mi>k</mi><mo>+</mo><mn>8</mn><mo>=</mo><mn>0</mn></math> &nbsp; <math> <mrow> <mrow><mo>(</mo> <mrow> <mo>&#8658;</mo><mn>4</mn><mo stretchy=\"false\">(</mo><mo>&#8722;</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mo>&#8722;</mo><mo stretchy=\"false\">(</mo><mn>4</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mn>8</mn><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mo>&#8722;</mo><mn>4</mn><mo>&#8722;</mo><mn>4</mn><mo>+</mo><mn>8</mn><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mo>&#8722;</mo><mn>8</mn><mo>+</mo><mn>8</mn><mo>=</mo><mn>0</mn> </mrow> <mo>)</mo></mrow> </mrow> </math><br />And <math><mrow><mrow><mi mathvariant=\"normal\">det</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mi>P</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mi>d</mi><mi>j</mi> <mi>(Q</mi></mrow></mfenced></mrow></mfenced></mrow></mrow><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>P</mi></mrow></mfenced><mi>&#160;</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>a</mi><mi>d</mi><mi>j</mi> <mi>(Q)</mi></mrow></mfenced><mo>=</mo><mn>2</mn><mi>k</mi><mo>.</mo><mi>&#160;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>k</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><msup><mrow><mi>k</mi></mrow><mrow><mn>5</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>9</mn></mrow></msup></math><br />Also <math> <mrow> <mtext>det</mtext> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>Q</mtext> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>adj</mtext> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>P</mtext> </mrow> </mfenced> </mrow> </mfenced> </mrow> </mfenced> <mo>=</mo> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <mtext>Q</mtext> </mrow> </mfenced> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <mtext>adj</mtext> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>P</mtext> </mrow> </mfenced> </mrow> </mfenced> </mrow> </math> <math> <mrow> <mo>=</mo> <mfrac> <mrow> <msup> <mtext>k</mtext> <mn>2</mn> </msup> </mrow> <mrow> <mtext>2</mtext> </mrow> </mfrac> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>2k</mtext> </mrow> </mfenced> </mrow> <mn>2</mn> </msup> <mo>=</mo> <msup> <mtext>2k</mtext> <mtext>4</mtext> </msup> <mo>=</mo> <msup> <mtext>2</mtext> <mn>9</mn> </msup></mrow></math>"
