athvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mn>4</mn></mrow></msup><mi>&#952;</mi><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&#952;</mi><msup><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&#952;</mi><mo>+</mo><mn>2</mn></mrow></mfenced></math><br />Now proceed as Method 1"
