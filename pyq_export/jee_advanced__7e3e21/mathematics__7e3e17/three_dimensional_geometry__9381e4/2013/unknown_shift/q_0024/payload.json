      "text": "<math><mrow>  <mfrac>    <mrow>      <mi>x</mi>    </mrow>    <mrow>      <mn>2</mn>    </mrow>  </mfrac>  <mo>=</mo>  <mfrac>    <mrow>      <mi>y</mi>      <mo>-</mo>      <mn>1</mn>    </mrow>    <mrow>      <mn>3</mn>    </mrow>  </mfrac>  <mo>=</mo>  <mfrac>    <mrow>      <mi>z</mi>      <mo>-</mo>      <mn>2</mn>    </mrow>    <mrow>      <mo>-</mo>      <mn>5</mn>    </mrow>  </mfrac></mrow></math>",
