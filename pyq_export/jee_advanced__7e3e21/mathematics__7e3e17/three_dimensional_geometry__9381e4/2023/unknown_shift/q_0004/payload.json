      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">P</mi></mfenced><mo>&#8594;</mo><mfenced><mn>5</mn></mfenced><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">Q</mi></mfenced><mo>&#8594;</mo><mfenced><mn>4</mn></mfenced><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">R</mi></mfenced><mo>&#8594;</mo><mfenced><mn>3</mn></mfenced><mo>&#160;</mo><mfenced><mi mathvariant=\"normal\">S</mi></mfenced><mo>&#8594;</mo><mfenced><mn>1</mn></mfenced></math>",
      "is_correct": true
    },
