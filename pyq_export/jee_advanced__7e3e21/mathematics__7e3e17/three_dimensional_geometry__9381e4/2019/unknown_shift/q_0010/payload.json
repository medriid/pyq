  "solution": {
    "text": "As given<br /><math><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>&#8658;</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>&#955;</mi><mi>i</mi><mo>,</mo><mi>&#160;</mi><mi>&#955;</mi><mo>&#8712;</mo><mi>R</mi></math><br /><math><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>&#8658;</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>k</mi><mo>+</mo><mi>&#956;</mi><mi>j</mi><mo>,</mo><mi>&#160;</mi><mi>&#956;</mi><mo>&#8712;</mo><mi>R</mi></math><br />and <math><msub><mrow><mi>L</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>&#8658;</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>i</mi><mo>+</mo><mi>j</mi><mo>+</mo><mi>&#957;</mi><mi>k</mi><mo>,</mo><mi>&#160;</mi><mi>&#957;</mi><mo>&#8712;</mo><mi>R</mi></math><br />Let point <math><mi>P</mi><mfenced separators=\"|\"><mrow><mi>&#955;</mi><mo>,</mo><mi>&#160;</mi><mn>0</mn><mo>,</mo><mi>&#160;</mi><mn>0</mn></mrow></mfenced><mo>,</mo><mi>&#160;</mi><mi>Q</mi><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&#160;</mi><mi>&#956;</mi><mo>,</mo><mi>&#160;</mi><mn>1</mn></mrow></mfenced></math> and <math><mi>R</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi>&#160;</mi><mn>1</mn><mo>,</mo><mi>&#160;</mi><mi>&#957;</mi></mrow></mfenced></math><br />and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>P</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mi>&#955;</mi><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mi>&#956;</mi><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mover><mi>k</mi><mo>^</mo></mover><mo>,</mo><mo>&#160;</mo><mover><mrow><mi>P</mi><mi>R</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>&#955;</mi></mrow></mfenced><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mi>&#957;</mi><mover><mi>k</mi><mo>^</mo></mover></math><br />as <math><mi>P</mi><mo>,</mo><mi>&#160;</mi><mi>Q</mi></math> and <math><mi>R</mi></math> are co-linear<br /><math><mo>&#8658;</mo><mover accent=\"true\"><mrow><mi>P</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover></math> is parallel to <math><mover accent=\"true\"><mrow><mi>P</mi><mi>R</mi></mrow><mo>&#8594;</mo></mover></math><br /><math><mo>&#8658;</mo><mo>-</mo><mfrac><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>&#955;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>&#956;</mi></mrow><mrow><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>&#957;</mi></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mfrac><mrow><mi>&#956;</mi></mrow><mrow><mi>&#956;</mi><mo>-</mo><mn>1</mn></mrow></mfrac></math> and <math><mi>&#957;</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>&#956;</mi></mrow></mfrac></math><br />hence <math><mtable><mtr><mtd><mi>&#956;</mi><mo>&#8800;</mo><mn>0</mn></mtd><mtd><mi>&#956;</mi><mo>&#8800;</mo><mn>1</mn></mtd></mtr></mtable></math><br /><math><mi>Q</mi><mo>&#8800;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&#160;</mi><mn>0</mn><mo>,</mo><mi>&#160;</mi><mn>1</mn></mrow></mfenced></math> and <math><mi>Q</mi><mo>&#8800;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&#160;</mi><mn>1</mn><mo>,</mo><mi>&#160;</mi><mn>1</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mo>&#8800;</mo><mover><mi>k</mi><mo>^</mo></mover><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi>Q</mi><mo>&#8800;</mo><mfenced separators=\"|\"><mrow><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced></math>"
