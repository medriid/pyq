  "correctValue": null,
  "solution": {
    "text": "There are two possible cases arise:\nCase I Five 1's, one 2's, one 3's\n$\\therefore$ Number of numbers $=\\frac{7 !}{5 !}=42$\nCase II Four 1's, three 2's\n$\\therefore$ Number of numbers $=\\frac{7 !}{4 ! 3 !}=35$\n$\\therefore$ Total number of numbers $=42+35=77$",
    "image": null
  },
