  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\Rightarrow \\tan \\left(\\tan ^{-1}\\left(\\frac{3}{4}\\right)-2 \\tan ^{-1}\\left(\\frac{1}{2}\\right)\\right) \\\\ & \\Rightarrow \\tan \\left(\\tan ^{-1}\\left(\\frac{3}{4}\\right)-\\tan ^{-1}\\left(\\frac{2 \\times \\frac{1}{2}}{1-\\frac{1}{4}}\\right)\\right) \\\\ & \\Rightarrow \\tan \\left(\\tan ^{-1}\\left(\\frac{3}{4}\\right)-\\tan ^{-1}\\left(\\frac{4}{3}\\right)\\right) \\\\ & \\Rightarrow \\tan \\left(\\tan ^{-1}\\left(\\frac{\\frac{3}{4}-\\frac{4}{3}}{1+1}\\right)\\right) \\\\ & \\Rightarrow \\frac{9-16}{24}=\\frac{-7}{24}\\end{aligned}$",
    "image": null
  },
