  "question": {
    "text": "Considering only the principal values of the inverse trigonometric functions, the value of $\\tan \\left(\\sin ^{-1}\\left(\\frac{3}{5}\\right)-2 \\cos ^{-1}\\left(\\frac{2}{\\sqrt{5}}\\right)\\right)$ is",
    "image": null
  },
  "options": [
    {
      "id": "xMt6z",
      "text": "$\\frac{7}{24}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7QFKO",
      "text": "$\\frac{-7}{24}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "lW643",
      "text": "$\\frac{-5}{24}$",
      "image": null,
      "isCorrect": false
    },
    {
