    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>j</mi></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>j</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>1</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>j</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>j</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow></mfrac></mfenced></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>j</mi></mrow></mfenced><mo>-</mo><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>j</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mfenced><mo>-</mo><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></math><br /><math><mo>&#8756;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mi>tan</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mfenced><mo>-</mo><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow></mfenced></math><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mi>tan</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mfenced><mo>-</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>x</mi><mfenced><mrow><mi>x</mi><mo>+</mo><mi>n</mi></mrow></mfenced></mrow></mfrac></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mfrac><mi>n</mi><mrow><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>n</mi><mi>x</mi></mrow></mfrac></math>,</p><p>so that&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mi>tan</mi><mfenced><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8756;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sec</mi><mn>2</mn></msup><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mn>1</mn><mo>+</mo><msup><mi>tan</mi><mn>2</mn></msup><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sec</mi><mn>2</mn></msup><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mn>1</mn><mo>+</mo><msup><mfenced separators=\"|\"><mfrac><mi>n</mi><mrow><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>n</mi><mi>x</mi></mrow></mfrac></mfenced><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mi>&#8734;</mi></mrow></munder><msup><mi>sec</mi><mn>2</mn></msup><mfenced separators=\"|\"><mrow><msub><mi>f</mi><mi>n</mi></msub><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mi>&#8734;</mi></mrow></munder><mn>1</mn><mo>+</mo><msup><mfenced separators=\"|\"><mfrac><mi>n</mi><mrow><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>n</mi><mi>x</mi></mrow></mfrac></mfenced><mn>2</mn></msup><mo>=</mo><mn>1</mn></math></p><p>Note that&nbsp;since <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn></math>&nbsp;is not in domain so first two options&nbsp;are wrong</p>",
