    },
    {
      "id": "VDCBS",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi><mo>=</mo><mi>X</mi><mo>+</mo><mi>Z</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "mIUWn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mfrac><mi>X</mi><mn>2</mn></mfrac><mo>=</mo><mfrac><mi>x</mi><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "E16gg",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>&#8722;</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mi>x</mi><mi>z</mi></math>",
      "isCorrect": false,
