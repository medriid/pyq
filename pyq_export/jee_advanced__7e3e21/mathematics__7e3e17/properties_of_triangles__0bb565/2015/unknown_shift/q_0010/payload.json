    "text": "<p><math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced></math> <math><mi mathvariant=\"normal\">λ</mi><mo>=</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">X</mi><mo>-</mo><mi mathvariant=\"normal\">Y</mi></mrow></mfenced></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">Z</mi></mrow></mrow></mrow></mfrac></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>sinX</mi><mi>cosY</mi><mo>-</mo><mi>cosX</mi><mi>sin</mi><mi>Y</mi></mrow><mi>sinZ</mi></mfrac></math><br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">a</mi><mi>cosY</mi><mo>-</mo><mi mathvariant=\"normal\">b</mi><mi>cosX</mi></mrow><mi>c</mi></mfrac></math><br ><math><mfrac><mrow><mi mathvariant=\"normal\">a</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">c</mi></mrow></mfrac></mrow></mfenced><mo>-</mo><mi mathvariant=\"normal\">b</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">c</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">c</mi></mrow></mfrac><mo>=</mo><mi mathvariant=\"normal\">λ</mi></math><br ><math><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mi mathvariant=\"normal\">λ</mi></math><br >As <math><mn>2</mn><mfenced separators=\"|\"><mrow><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>=</mo><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br ><math><mo>∴</mo><mi mathvariant=\"normal\">λ</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br ><math><mo>∴</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mn>0</mn></math><br ><math><mo>∴</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\"> </mi><mn>3</mn><mo>,</mo><mi mathvariant=\"normal\"> </mi><mn>5</mn></math><br ><math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">B</mi></mrow></mfenced></math> <math><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow><mi mathvariant=\"normal\">X</mi><mo>-</mo><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow><mi mathvariant=\"normal\">Y</mi><mo>=</mo><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">X</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">Y</mi></mrow></mrow></math><br >Solving<br ><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi>sin</mi><mn>2</mn></msup><mi mathvariant=\"normal\">Y</mi><mo>-</mo><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mi mathvariant=\"normal\">X</mi><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">X</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">Y</mi></math><br ><math><mn>4</mn><msup><mrow><mi mathvariant=\"normal\">b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>2</mn><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">b</mi></math><br ><math><mn>4</mn><mo>-</mo><mn>2</mn><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfrac></math></p><p><img src=\"assets\\st0010_2b2ac88e314e.png\"/><br/><math><mfrac><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfrac><mo>=</mo><mi mathvariant=\"normal\">X</mi></math></p><p><math><msup><mrow><mi mathvariant=\"normal\">X</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">X</mi><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math></p><p><math><mi mathvariant=\"normal\">X</mi><mo>=</mo><mn>1</mn></math></p><p><math><mfrac><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfrac><mo>=</mo><mn>1</mn></math></p><p><math><mi mathvariant=\"normal\">x</mi><mo>=</mo><mo>-</mo><mn>2</mn></math></p><p><math><mfrac><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mn>2</mn></math> (rejected)</p><p><math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">C</mi></mrow></mfenced></math> <math><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">Y</mi><mo>≡</mo><mi mathvariant=\"normal\">y</mi><mo>=</mo><msqrt><mn>3</mn></msqrt><mi mathvariant=\"normal\">x</mi></math></p><p><math><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">X</mi><mo>≡</mo><mi mathvariant=\"normal\">y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac><mi mathvariant=\"normal\">x</mi></math></p><p><math><mo>∴</mo></math> Equation of bisector of <math><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">X</mi><mo>,</mo><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">Y</mi></math></p><p><math><mi mathvariant=\"normal\">y</mi><mo>=</mo><mi mathvariant=\"normal\">x</mi></math></p><p><math><mo>∴</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">x</mi><mo>-</mo><mi mathvariant=\"normal\">y</mi></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac></math></p><p><math><mfrac><mrow><mi mathvariant=\"normal\">β</mi><mo>-</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">β</mi></mrow></mfenced></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>=</mo><mo>±</mo><mfrac><mrow><mn>3</mn></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac></math></p><p><math><mn>2</mn><mi mathvariant=\"normal\">β</mi><mo>-</mo><mn>1</mn><mo>=</mo><mo>±</mo><mn>3</mn></math></p><p><math><mi mathvariant=\"normal\">β</mi><mo>=</mo><mn>2</mn></math></p><p><math><mi mathvariant=\"normal\">β</mi><mo>=</mo><mo>-</mo><mn>1</mn></math></p><p><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">β</mi></mrow></mfenced><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\"> </mi><mn>2</mn></math></p><p><math><mo>(</mo><mi mathvariant=\"normal\">D</mi><mo>)</mo></math><br/><img src=\"assets\\st0010_abacbfc12d8d.png\"/></p><p><math><mo>∴</mo></math> Area <math><mo>=</mo><mn>6</mn><mo>-</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mrow><mn>2</mn><msqrt><mi>x</mi></msqrt></mrow></mrow><mi mathvariant=\"normal\"> </mi><mi>d</mi><mi>x</mi></math></p><p><math><mo>=</mo><mn>6</mn><mo>-</mo><mfrac><mrow><mn>8</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac></math></p><p><math><mo>∴</mo></math> Required value <math><mo>=</mo><mn>6</mn><mo>-</mo><mfrac><mrow><mn>8</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>8</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mn>6</mn></math></p><p><img src=\"assets\\st0010_68935b3be080.png\"/><br >Area<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo></math> Shaded region <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo></math> area under parabola.</p><p><math><mo>=</mo><mn>5</mn><mo>-</mo><mfrac><mrow><mn>8</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac></math></p><p><math><mo>∴</mo></math> Required value <math><mo>=</mo><mn>5</mn></math></p>"
