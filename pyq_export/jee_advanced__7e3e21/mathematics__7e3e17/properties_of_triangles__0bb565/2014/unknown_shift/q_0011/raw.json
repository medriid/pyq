  "solution": {
    "text": "Let <math><mi>x</mi><mo>=</mo><mi>a</mi><mo>+</mo><mi>b</mi></math><br /><math><mi>y</mi><mo>=</mo><mi>a</mi><mi>b</mi></math><br /><math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>y</mi></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi>a</mi><mi>b</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mn>120</mn></mrow><mrow><mi>o</mi></mrow></msup></mrow></mfenced></mrow></mrow><mi>&nbsp;</mi></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>∠</mi><mi>C</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>R</mi><mo>=</mo><mfrac><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow><mrow><mn>4</mn><mo>∆</mo></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mi>r</mi><mo>=</mo><mfrac><mrow><mo>∆</mo></mrow><mrow><mi>s</mi></mrow></mfrac></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mfrac><mrow><mi>r</mi></mrow><mrow><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mrow><mo>∆</mo></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>s</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&nbsp;</mi><mi>a</mi><mi>b</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><m