      "text": "<math><mn>2</mn><mi>a</mi><mo>,</mo><mi>&nbsp;</mi><mn>8</mn><mo>,</mo><mi>&nbsp;</mi><mn>1</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>2</mn><mi>a</mi><mo>,</mo><mi> </mi><mn>4</mn><mo>,</mo><mi> </mi><mn>1</mn></math>",
