  "question": {
    "text": "The number of solutions of the pair of equations $2 \\sin ^2 \\theta-\\cos 2 \\theta=0$ and $2 \\cos ^2 \\theta-3 \\sin \\theta=0$ in the interval $[0,2 \\pi]$ is",
    "image": null
