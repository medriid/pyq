  "question": {
    "text": "The number of solutions of the pair of equations $2 \\sin ^2 \\theta-\\cos 2 \\theta=0$ and $2 \\cos ^2 \\theta-3 \\sin \\theta=0$ in the interval $[0,2 \\pi]$ is"
  },
  "options": [
    {
      "text": "\nzero\n",
      "is_correct": false
    },
    {
      "text": "\none\n",
      "is_correct": false
    },
    {
      "text": "\ntwo\n",
      "is_correct": true
    },
    {
      "text": "\nfour",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$2 \\sin ^2 \\theta-\\cos 2 \\theta=0 \\Rightarrow \\sin ^2 \\theta=\\frac{1}{4}$\nAlso, $2 \\cos ^2 \\theta=3 \\sin \\theta \\Rightarrow \\sin \\theta=\\frac{1}{2}$\n$\\Rightarrow$ Two solutions in $[0,2 \\pi]$."
  }
