  "question": {
    "text": "Let $P=\\{\\theta: \\sin \\theta-\\cos \\theta=\\sqrt{2} \\cos \\theta\\}$ and $Q=\\{\\theta: \\sin \\theta+\\cos \\theta=\\sqrt{2} \\sin \\theta\\}$ be two sets. Then,"
  },
  "options": [
    {
      "text": "\n$P \\subset Q$ and $Q-P \\neq \\Phi$\n",
      "is_correct": false
    },
    {
      "text": "\n$Q \\not \\subset P$\n",
      "is_correct": false
    },
    {
      "text": "\n$P \\not \\subset Q$\n",
      "is_correct": false
    },
    {
      "text": "\n$P=Q$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& P=\\{\\theta: \\sin \\theta-\\cos \\theta=\\sqrt{2} \\cos \\theta\\} \\\\\n& \\Rightarrow \\quad \\cos \\theta(\\sqrt{2}+1)=\\sin \\theta \\\\\n& \\Rightarrow \\quad \\tan \\theta=\\sqrt{2}+1 \\\\\n& Q=\\{\\theta: \\sin \\theta+\\cos \\theta=\\sqrt{2} \\sin \\theta\\} \\\\\n& \\Rightarrow \\quad \\sin \\theta(\\sqrt{2}-1)=\\cos \\theta \\\\\n& \\Rightarrow \\quad \\tan \\theta=\\frac{1}{\\sqrt{2}-1} \\times \\frac{\\sqrt{2}+1}{\\sqrt{2}+1} \\\\\n& =(\\sqrt{2}+1) \\\\\n& \\therefore \\quad P=Q \\\\\n&\n\\end{aligned}\n$$"
  }
}