  "question": {
    "text": "<strong>Paragraph:</strong>\nLet $A_1, G_1, H_1$ denote the arithmetic, geometric and harmonic means respectively, of two distinct positive numbers. For $n \\geq 2$, let $A_{n-1}$ and $H_{n-1}$ has arithmetic, geometric and harmonic means as $A_n, G_n, H_n$, respectively.<strong>Question:</strong>\nWhich of the following statements is correct?",
    "image": null
  },
  "options": [
    {
      "id": "cFAM3",
      "text": "\n$\\mathrm{H}_1>\\mathrm{H}_2>\\mathrm{H}_3>\\ldots$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Wm9k5",
      "text": "\n$H_1 < H_2 < H_3 < \\ldots$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Vo4Vu",
      "text": "\n$H_1>H_3>H_5>\\ldots$ and $H_2 < H_4 < H_6 < \\ldots$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "do7Yf",
      "text": "\n$\\mathrm{H}_1 < \\mathrm{H}_3 < \\mathrm{H}_5 < \\ldots$ and $\\mathrm{H}_2>\\mathrm{H}_4>\\mathrm{H}_6>\\ldots$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "As above $A_1>H_2>H_1, A_2>H_3>H_2$ $\\therefore \\quad H_1 < H_2 < H_3 < \\ldots$",
    "image": null
  },
