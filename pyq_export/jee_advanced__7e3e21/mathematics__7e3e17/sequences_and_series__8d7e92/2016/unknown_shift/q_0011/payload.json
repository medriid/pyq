ub><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub></math> and <math><msub><mrow><mi>a</mi></mrow><mrow><mn>51</mn></mrow></msub><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>51</mn></mrow></msub></math><br /><math><mo>⇒</mo></math> <math><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>50</mn><mi>D</mi><mo>=</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>50</mn></mrow></msup><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br /><math> <mo>∴</mo><msub> <mi>a</mi> <mn>1</mn> </msub> <mo>+</mo><mn>50</mn><mi>D</mi><mo>=</mo><msup> <mn>2</mn> <mrow> <mn>50</mn> </mrow> </msup> <msub> <mi>a</mi> <mn>1</mn> </msub> <mrow><mo>(</mo> <mrow> <mi>A</mi><mi>s</mi><mtext> </mtext><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>=</mo><msub> <mi>a</mi> <mn>1</mn> </msub> </mrow> <mo>)</mo></mrow><mo>⇒</mo><mi>D</mi><mo>=</mo><mfrac> <mrow> <msup> <mn>2</mn> <mrow> <mn>50</mn> </mrow> </msup> <msub> <mi>a</mi> <mn>1</mn> </msub> <mo>−</mo><msub> <mi>a</mi> <mn>1</mn> </msub> </mrow> <mrow> <mn>50</mn> </mrow> </mfrac> </math><br /><math> <mi>t</mi><mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><msub> <mi>b</mi> <mn>2</mn> </msub> <mo>+</mo><mn>.......</mn><msub> <mi>b</mi> <mrow> <mn>51</mn> </mrow> </msub> <mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><mn>2</mn><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><msup> <mn>2</mn> <mn>2</mn> </msup> <msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><msup> <mn>.......2</mn> <mrow> <mn>50</mn> </mrow> </msup> <msub> <mi>b</mi> <mn>1</mn> </msub> <mo>⇒</mo><mi>t</mi><mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mrow><mo>(</mo> <mrow> <msup> <mn>2</mn> <mrow> <mn>51</mn> </mrow> </msup> <mo>−</mo><mn>1</mn> </mrow> <mo>)</mo></mrow><mo>;</mo></math><br /><math><mi>s</mi><mo>=</mo><msub> <mi>a</mi> <mn>1</mn> </msub> <mo>+</mo><msub> <mi>a</mi> <mn>2</mn> </msub> <mo>+</mo><mn>.......</mn><msub> <mi>a</mi> <mrow> <mn>51</mn> </mrow> </msub> <mo>⇒</mo><mi>s</mi><mo>=