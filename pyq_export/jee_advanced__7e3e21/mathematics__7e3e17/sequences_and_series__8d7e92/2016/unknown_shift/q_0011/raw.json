    "text": "If <math><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><msub><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>…</mo><mo>.</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><msub><mrow><mi>b</mi></mrow><mrow><mn>101</mn></mrow></msub></mrow></mrow></mrow></mrow></mrow></mrow><mo>→</mo><mi>A</mi><mi>P</mi><mo>;&nbsp; &nbsp; &nbsp;</mo><mi>difference(d)</mi><mo>=</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></math><br /><math> <mo>⇒</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>,</mo><msub> <mi>b</mi> <mn>2</mn> </msub> <mo>,</mo><msub> <mi>b</mi> <mn>3</mn> </msub> <mn>.......</mn><msub> <mi>b</mi> <mrow> <mn>101</mn> </mrow> </msub> <mo>→</mo><mi>G</mi><mi>P</mi><mo>;</mo><mi>r</mi><mo>=</mo><mn>2</mn> </math><br /><math> <mo>∴</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>,</mo><mn>2</mn><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>,</mo><msup> <mn>2</mn> <mn>2</mn> </msup> <msub> <mi>b</mi> <mn>1</mn> </msub> <mn>.........</mn><mo>,</mo><msup> <mn>2</mn> <mrow> <mn>100</mn> </mrow> </msup> <msub> <mi>b</mi> <mn>1</mn> </msub> <mo>→</mo><mi>G</mi><mi>P</mi> </math><br /><math> <msub> <mi>a</mi> <mn>1</mn> </msub> <mo>,</mo><msub> <mi>a</mi> <mn>2</mn> </msub> <mo>,</mo><msub> <mi>a</mi> <mn>3</mn> </msub> <mn>..........</mn><msub> <mi>a</mi> <mrow> <mn>101</mn> </mrow> </msub> <mo>→</mo><mi>A</mi><mi>P</mi><mtext> </mtext><mtext> </mtext><mtext> </mtext><mtext> </mtext><mtext> </mtext><mtext> </mtext><mtext> </mtext> </math> Let Common Difference = D<br />Given, <math><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub></math> and <math><msub><mrow><mi>a</mi></mrow><mrow><mn>51</mn></mrow></msub><mo>=</mo><msub><mrow><mi>b</mi></mrow><mrow><mn>51</mn></mrow></msub></math><br /><math><mo>⇒</mo></math> <math><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>50</mn><mi>D</mi><mo>=</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>50</mn></mrow></msup><msub><mrow><mi>b</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br /><math> <mo>∴</mo><msub> <mi>a</mi> <mn>1</mn> </msub> <mo>+</mo><mn>50</mn><mi>D</mi><mo>=</mo><msup> <mn>2</mn> <mrow> <mn>50</mn> </mrow> </msup> <msub> <mi>a</mi> <mn>1</mn> </msub> <mrow><mo>(</mo> <mrow> <mi>A</mi><mi>s</mi><mtext> </mtext><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>=</mo><msub> <mi>a</mi> <mn>1</mn> </msub> </mrow> <mo>)</mo></mrow><mo>⇒</mo><mi>D</mi><mo>=</mo><mfrac> <mrow> <msup> <mn>2</mn> <mrow> <mn>50</mn> </mrow> </msup> <msub> <mi>a</mi> <mn>1</mn> </msub> <mo>−</mo><msub> <mi>a</mi> <mn>1</mn> </msub> </mrow> <mrow> <mn>50</mn> </mrow> </mfrac> </math><br /><math> <mi>t</mi><mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><msub> <mi>b</mi> <mn>2</mn> </msub> <mo>+</mo><mn>.......</mn><msub> <mi>b</mi> <mrow> <mn>51</mn> </mrow> </msub> <mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><mn>2</mn><msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><msup> <mn>2</mn> <mn>2</mn> </msup> <msub> <mi>b</mi> <mn>1</mn> </msub> <mo>+</mo><msup> <mn>.......2</mn> <mrow> <mn>50</mn> </mrow> </msup> <msub> <mi>b</mi> <mn>1</mn> </msub> <mo>⇒</mo><mi>t</mi><mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mrow><mo>(</mo> <mrow> <msup> <mn>2</mn> <mrow> <mn>51</mn> </mrow> </msup> <mo>−</mo><mn>1</mn> </mrow> <mo>)</mo></mrow><mo>;</mo></math><br /><math><mi>s</mi><mo>=</mo><msub> <mi>a</mi> <mn>1</mn> </msub> <mo>+</mo><msub> <mi>a</mi> <mn>2</mn> </msub> <mo>+</mo><mn>.......</mn><msub> <mi>a</mi> <mrow> <mn>51</mn> </mrow> </msub> <mo>⇒</mo><mi>s</mi><mo>=</mo><mfrac> <mrow> <mn>51</mn> </mrow> <mn>2</mn> </mfrac> <mrow><mo>(</mo> <mrow> <mn>2</mn><msub> <mi>a</mi> <mn>1</mn> </msub> <mo>+</mo><mn>50</mn><mi>D</mi> </mrow> <mo>)</mo></mrow><mtext> </mtext></math><br /><math><mi>t</mi><mo>=</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>.</mo><mi>&nbsp;</mi><msup><mrow><mn>2</mn></mrow><mrow><mn>51</mn></mrow></msup><mo>-</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>⇒</mo><mi>t</mi><mo>&lt;</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>.</mo><mi>&nbsp;</mi><msup><mrow><mn>2</mn></mrow><mrow><mn>51</mn></mrow></msup></math> .......(i)&nbsp; <math> <mrow><mo>(</mo> <mrow> <mi>a</mi><mi>s</mi><mtext> </mtext><msub><mi>b</mi><mi>i</mi></msub><mo>&gt;</mo><mn>1</mn><mo>&nbsp;&amp;&nbsp;</mo><msub> <mi>a</mi> <mn>1</mn> </msub> <mo>=</mo><msub> <mi>b</mi> <mn>1</mn> </msub> <mtext> </mtext><mtext> </mtext><mi>s</mi><mi>o</mi><mtext> </mtext><mtext> </mtext><msub><mi>a</mi><mo>1</mo></msub><mo>&gt;</mo><mn>1</mn> </mrow> <mo>)</mo></mrow> </math><br /><math><mi>s</mi><mo>=</mo><mfrac><mrow><mn>51</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>50</mn><mi>D</mi></mrow></mfenced></math><br /><math><mi>s</mi><mo>=</mo><mfrac><mrow><mn>51</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>50</mn></mrow></msup><mi>&nbsp;</mi><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math><br /><math><mi>s</mi><mo>=</mo><mfrac><mrow><mn>51</mn><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>51</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>.</mo><msup><m