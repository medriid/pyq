    "text": "<math><mfenced separators=\"|\"><mrow><mi>P</mi></mrow></mfenced><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>a</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>b</mi><mi>x</mi><mo>,</mo><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mi>&nbsp;</mi><mi>d</mi><mi>x</mi><mo>=</mo><mn>1</mn></mrow></mrow></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mn>2</mn><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi><mo>=</mo><mn>6</mn></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mo>,</mo><mi>&nbsp;</mi><mi>b</mi></mrow></mfenced><mo>≡</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&nbsp;</mi><mn>2</mn></mrow></mfenced><mi>&nbsp;</mi><mi>a</mi><mi>n</mi><mi>d</mi><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,</mo><mi>&nbsp;</mi><mn>0</mn></mrow></mfenced></math><br /><math><mfenced separators=\"|\"><mrow><mi>Q</mi></mrow></mfenced><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><msqrt><mn>2</mn></msqrt><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></mrow></mrow><mi>&nbsp;</mi></math><br />For maximum value, <math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>=</mo><mn>2</mn><mi>n</mi><mi>π</mi></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn><mi>n</mi><mi>π</mi><mo>+</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>x</mi><mo>=</mo><mo>±</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></msqrt><mo>,</mo><mi>&nbsp;</mi><mo>±</mo><mi>&nbsp;</mi><msqrt><mfrac><mrow><mn>9</mn><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></msqrt></math> as <math><mi>x</mi><mi>&nbsp;</mi><mi>ϵ</mi><mi>&nbsp;</mi><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><msqrt><mn>3</mn></msqrt><mo>,</mo><mi>&nbsp;</mi><msqrt><mn>13</mn></msqrt></mrow></mfenced></math><br /><math><mfenced separators=\"|\"><mrow><mi>R</mi></mrow></mfenced><mi>&nbsp;</mi><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></munderover><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mi>x</mi></mrow></msup></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo></mrow></mrow><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></munderover><mrow><mn>3</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mn>8</mn></mrow></mrow></math><br /><math><mfenced separators=\"|\"><mrow><mi>S</mi></mrow></mfenced><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></munderover><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>2</mn><mi>x</mi><mi>&nbsp;</mi><mi>I</mi><mi>n</mi><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn></mrow></mrow></mrow></mrow></math> as it is an odd function.",
