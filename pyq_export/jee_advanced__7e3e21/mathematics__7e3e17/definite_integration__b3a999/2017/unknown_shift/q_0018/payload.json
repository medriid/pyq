</mo><mn>1</mn></mrow></mfenced><mo>-</mo><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mi>k</mi></mrow></mfenced></mrow></mrow></math>&nbsp;&nbsp;&nbsp;&nbsp;(Difference series)</p><p><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>I</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>99</mn><mi>&nbsp;</mi><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mn>99</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>99</mn><mi>&nbsp;</mi><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mn>100</mn><mo>+</mo><mi>&nbsp;</mi><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mn>2</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mn>99</mn></mrow></mfenced><mo>=</mo><mi mathvariant=\"script\">&nbsp;</mi><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mo>×</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>99</mn></mrow></mfenced></mrow><mrow><mn>100</mn></mrow></msup></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>100</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup></mrow></mfrac></mrow></mfenced></math>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;......(i)</p>&nbsp;<p>For option (ii):</p><p>&nbsp;</p><p>Now, consider&nbsp;&nbsp;<math><msup><mrow><mfenced separators=\"|\"><mrow><mn>100</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>99</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup></math></p><p><math><mo>=</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><msup><mrow><mi>&nbsp;</mi></mrow><mrow><mn>99</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><msup><mrow><mi>&nbsp;</mi></mrow><mrow><mn>99</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mfenced separators=\"|\"><mrow><mn>99</mn></mrow></mfenced><mo>+</mo><msup><mrow><mi>&nbsp;</mi></mrow><mrow><mn>99</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2