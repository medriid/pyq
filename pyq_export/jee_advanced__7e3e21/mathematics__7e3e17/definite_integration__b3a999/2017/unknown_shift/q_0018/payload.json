</mo><mn>2</mn><mo>.</mo><mi>&nbsp;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>99</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mo>⇒</mo><mi>&nbsp;</mi><mfrac><mrow><mn>2</mn><mo>×</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>99</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>100</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup></mrow></mfrac><mo>&lt;</mo><mn>1</mn></math></p><p><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><mn>2</mn><mo>×</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>99</mn></mrow></mfenced></mrow><mrow><mn>100</mn></mrow></msup></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>100</mn></mrow></mfenced></mrow><mrow><mn>99</mn></mrow></msup></mrow></mfrac><mo>&lt;</mo><mn>99</mn></math>&nbsp;&nbsp;&nbsp;&nbsp;(on multiplying by 99)</p><p><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>I</mi><mo>&lt;</mo><mi mathvariant=\"script\">&nbsp;</mi><mi>ℓ</mi><mi>n</mi><mi>&nbsp;</mi><mn>9</mn><mn>9</mn></math>, Hence option (ii) is correct.</p>&nbsp;<p>For option (iii):</p><p>&nbsp;</p><p>Since,&nbsp;&nbsp;&nbsp;&nbsp;<math><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>98</mn></mrow></munderover><mrow><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mi>k</mi></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><mfrac><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mrow></mrow></mrow><mi>&nbsp;</mi><mi>d</mi><mi>x</mi><mo>&lt;</mo><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>98</mn></mrow></munderover><mrow><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mi>k</mi></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></munderover><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>&nbsp;</mi><mi>d</mi><mi>x</mi></mrow><mrow><mi>x</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mfrac></mrow></mrow></mrow></mrow></math></p><p>For integration L.H.S., we get</p><p><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>98</mn></mrow></munderover><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>&lt;</mo><mi>I</mi></math></p><p><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><munder><mrow><munder accentunder=\"false\"><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>+</mo><mo>…</mo><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>100</mn></mrow></mfrac></mrow></mfenced></mrow><mo>⏟</mo></munder></mrow><mrow><mn>98</mn><mi>&nbsp;</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></munder><mo>&lt;</mo><mi>I</mi></math></p><p><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><mn>98</mn></mrow><mrow><mn>100</mn></mrow></mfrac><mo>&lt;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>+</mo><mo>…</mo><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>100</mn></mrow></mfrac><mo>&lt;</mo><mi>I</mi></math></p><p><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>I</mi><mo>&gt;</mo><mfrac><mrow><mn>49</mn></mrow><mrow><mn>50</mn></mrow></mfrac></math></p><p>Hence option (iii) is correct.</p>"
