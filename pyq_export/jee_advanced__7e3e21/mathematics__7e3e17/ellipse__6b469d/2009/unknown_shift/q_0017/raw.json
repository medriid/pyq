  "question": {
    "text": "The line passing through the extremity $A$ of the major axis and extremity $B$ of the minor axis of the ellipse $x^2+9 y^2=9$ meets its auxiliary circle at the point $M$. Then, the area of the triangle with vertices at $A, M$ and the origin $O$ is",
    "image": null
  },
  "options": [
    {
      "id": "jqbbd",
      "text": "\n$\\frac{31}{10}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2uOMD",
      "text": "\n$\\frac{29}{10}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zk1EC",
