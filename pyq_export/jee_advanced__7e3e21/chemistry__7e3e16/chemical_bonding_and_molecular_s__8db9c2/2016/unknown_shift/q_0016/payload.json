  },
  "options": [
    {
      "text": "<math><msubsup><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math> is expected to be diamagnetic",
      "is_correct": true
