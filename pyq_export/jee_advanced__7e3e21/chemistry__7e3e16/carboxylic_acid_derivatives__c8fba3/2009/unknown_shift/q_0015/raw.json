  "question": {
    "text": "The correct acidity order of the following is\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/7b6qdMHsSZY6-VDA-Ft2vqn1SuYfdt-U_Nh6myMTsgA.original.fullsize.png\"><br>",
