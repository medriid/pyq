  "question": {
    "text": "Reduction of the metal centre in aqueous permanganate ion involves",
    "image": null
  },
  "options": [
    {
      "id": "Re6CV",
      "text": "\nthree electrons in neutral medium\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "EdORY",
      "text": "\nfive electrons in neutral medium\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0QKnx",
      "text": "\nthree electrons in alkaline medium\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Lln95",
      "text": "\nfive electrons in acidic medium",
      "image": null,
      "isCorrect": true
