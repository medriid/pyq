    {
      "text": "\n$\\mathrm{Zn}\\left(\\mathrm{NO}_3\\right)_2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{Al}\\left(\\mathrm{NO}_3\\right)_3$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{Pb}\\left(\\mathrm{NO}_3\\right)_2$",
      "is_correct": false
