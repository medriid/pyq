  "question": {
    "text": "A solution of colourless salt $\\mathrm{H}$ on boiling with excess $\\mathrm{NaOH}$ produces a non-flammable gas. The gas evolution ceases after sometime. Upon addition of $\\mathrm{Zn}$ dust to the same solution, the gas evolution restarts. The colourless salt (s) $\\mathrm{H}$ is (are)"
  },
  "options": [
    {
      "text": "\n$\\mathrm{NH}_4 \\mathrm{NO}_3$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{NH}_4 \\mathrm{NO}_2$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{NH}_4 \\mathrm{Cl}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(\\mathrm{NH}_4\\right)_2 \\mathrm{SO}_4$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A",
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\mathrm{NH}_4 \\mathrm{NO}_3+\\mathrm{NaOH} \\longrightarrow \\mathrm{NaNO}_3+\\mathrm{NH}_3+\\mathrm{H}_2 \\mathrm{O} \\\\\n& \\mathrm{NaNO}_3+8[\\mathrm{H}] \\mathrm{NaOH}+\\mathrm{NH}_3+2 \\mathrm{H}_2 \\mathrm{O} \\\\\n& \\mathrm{NH}_4 \\mathrm{NO}_2+\\mathrm{NaOH} \\longrightarrow \\mathrm{NaHO}_2+\\mathrm{NH}_3+\\mathrm{H}_2 \\mathrm{O} \\\\\n& \\mathrm{NaNO}_2+6[\\mathrm{H}] \\longrightarrow \\mathrm{NaOH}+\\mathrm{NH}_3+\\mathrm{H}_2 \\mathrm{O}\n\\end{aligned}\n$$"
  }
}