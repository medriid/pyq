  "type": "multipleCorrect",
  "level": 2,
  "question": {
    "text": "Which of the following halides react(s) with $\\mathrm{AgNO}_{3}(\\mathrm{aq})$ to give a precipitate that dissolves in $\\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{3}(\\mathrm{aq})$ ?",
    "image": null
  },
  "options": [
    {
      "id": "b6aKH",
      "text": "$\\mathrm{HCl}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "PRqzF",
      "text": "$\\mathrm{HF}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "yIWXA",
      "text": "$\\mathrm{HBr}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "oed6l",
      "text": "$\\mathrm{HI}$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{l}\r\n\r\n\\mathrm{HX}+\\mathrm{AgNO}_{3} \\longrightarrow \\mathrm{AgX} \\downarrow+\\mathrm{HNO}_{3}(\\mathrm{X}=\\mathrm{Cl}, \\mathrm{Br}, \\mathrm{I}) \\\\\r\n\r\n\\mathrm{AgX}+2 \\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{3} \\longrightarrow \\mathrm{Na}_{3}\\left[\\mathrm{Ag}\\left(\\mathrm{S}_{2} \\mathrm{O}_{3}\\right)_{2}\\right]+\\mathrm{NaX}\r\n\r\n\\end{array}$",
