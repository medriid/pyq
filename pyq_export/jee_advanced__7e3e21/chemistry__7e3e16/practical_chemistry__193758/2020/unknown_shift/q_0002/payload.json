  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>=</mo><msub><mi>AgNO</mi><mn>3</mn></msub></math>,&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Y</mi><mo>=</mo><mi>Pb</mi><msub><mfenced><msub><mi>NO</mi><mn>3</mn></msub></mfenced><mn>2</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><msub><mtext>AgNO</mtext><mn>3</mn></msub><mfenced><mi mathvariant=\"normal\">X</mi></mfenced></munder><mo>+</mo><mtext>NaCl</mtext><mo>&#8594;</mo><munder><mtext>AgCl</mtext><mrow><mo>(</mo><mtext>P</mtext><mo>)</mo></mrow></munder><mo>&#160;</mo><mo>&#8595;</mo><mo>+</mo><msub><mtext>NaNO</mtext><mn>3</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mrow><mi>AgCl</mi><mtext>&#8201;</mtext><mo>(</mo><mtext>s</mtext><mo>)</mo><mo>&#8595;</mo></mrow><mrow><mo>(</mo><mtext>P</mtext><mo>)</mo></mrow></munder><mo>+</mo><mn>2</mn><msub><mtext>NH</mtext><mn>3</mn></msub><mo>&#8594;</mo><munder><msup><mfenced open=\"[\" close=\"]\"><mrow><mtext>Ag</mtext><msub><mfenced><msub><mtext>NH</mtext><mn>3</mn></msub></mfenced><mn>2</mn></msub></mrow></mfenced><mo>+</mo></msup><mi>Soluble</mi></munder><msup><mtext>Cl</mtext><mo>&#8722;</mo></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>AgCl</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">P</mi><mo>)</mo></mrow></munder><mo>+</mo><mn>2</mn><msub><mi>Na</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">S</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub><mo>&#8594;</mo><msub><mi>Na</mi><mn>3</mn></msub><munder><mfenced open=\"[\" close=\"]\"><mrow><mi>Ag</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">S</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub></mrow></mfenced><mn>2</mn></msub></mrow></mfenced><mi>Solubel</mi></munder><mo>+</mo><mi>NaCl</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Pb</mi><munder><msub><mfenced><msub><mi>NO</mi><mn>3</mn></msub></mfenced><mn>2</mn></msub><mfenced><mi mathvariant=\"normal\">Y</mi></mfenced></munder><mo>+</mo><mn>2</mn><mi>NaCl</mi><mo>&#8594;</mo><munder><msub><mi>PbCl</mi><mn>2</mn></msub><mtable columnalign=\"left\"><mtr><mtd><mi>White</mi><mtext>&#8201;</mtext><mi>ppt</mi><mtext>&#8201;</mtext><mfenced><mi mathvariant=\"normal\">Q</mi></mfenced></mtd></mtr><mtr><mtd><mo>(</mo><mi>Soluble</mi><mtext>&#8201;</mtext><mi>in</mi><mtext>&#8201;</mtext><mi>hot</mi></mtd></mtr><mtr><mtd><mi>water</mi><mo>)</mo></mtd></mtr></mtable></munder><mtext>&#8201;&#160;&#8595;</mtext><mo>+</mo><mn>2</mn><msub><mi>NaNO</mi><mn>3</mn></msub></math>&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><msub><mtext>PbCl</mtext><mn>2</mn></msub><mtable columnalign=\"left\"><mtr><mtd><mfenced><mrow><mi>aq</mi><mo>.</mo></mrow></mfenced></mtd></mtr><mtr><mtd><mfenced><mi mathvariant=\"normal\">Q</mi></mfenced></mtd></mtr></mtable></munder><mo>+</mo><mn>2</mn><mtext>KI</mtext><mo>&#8594;</mo><munder><msub><mtext>PbI</mtext><mn>2</mn></msub><mrow><mi>Yellow</mi><mtext>&#8201;</mtext><mi>ppt</mi></mrow></munder><mo>+</mo><mn>2</mn><mtext>KCl</mtext></math></p>"
