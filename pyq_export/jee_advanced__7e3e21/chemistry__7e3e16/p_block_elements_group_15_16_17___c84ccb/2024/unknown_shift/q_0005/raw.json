  "question": {
    "text": "The species formed on fluorination of phosphorus pentachloride in a polar organic solvent are :",
    "image": null
  },
  "options": [
    {
      "id": "v5teK",
      "text": "$\\left[\\mathrm{PF}_4\\right]^{+}\\left[\\mathrm{PF}_6\\right]^{-}$and $\\left[\\mathrm{PCl}_4\\right]^{+}\\left[\\mathrm{PF}_6\\right]^{-}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RW4wP",
      "text": "$\\left[\\mathrm{PCl}_4\\right]^{+}\\left[\\mathrm{PCl}_4 \\mathrm{~F}_2\\right]^{-}$and $\\left[\\mathrm{PCl}_4\\right]^{+}\\left[\\mathrm{PF}_6\\right]^{-}$",
