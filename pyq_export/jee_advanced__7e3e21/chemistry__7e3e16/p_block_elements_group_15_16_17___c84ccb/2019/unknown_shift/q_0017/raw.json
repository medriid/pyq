  "type": "multipleCorrect",
  "level": 3,
  "question": {
    "text": "With reference to <em>aqua regia</em>, choose the correct option(s).",
    "image": null
  },
  "options": [
    {
      "id": "c1lq3",
      "text": "Reaction of gold with aqua regia produces <math><msub><mrow><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></math> in the absence of air",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "qFa3i",
      "text": "<em>Aqua regia</em> is prepared by mixing conc. <math><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">l</mi></math> and conc. <math><msub><mrow><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>3</mn></mrow></msub></math> in <math><mn>3</mn><mi> </mi><mo>:</mo><mn>1</mn><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">v</mi></mrow><mo>/</mo><mrow><mi mathvariant=\"normal\">v</mi></mrow></mrow></mrow></mfenced></math> ratio",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "UtU86",
      "text": "Reaction of gold with <em>aqua regia</em> produces an anion having <math><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">u</mi></math> in <math><mo>+</mo><mn>3</mn></math> oxidation state",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "HoofW",
      "text": "The yellow colour of <math><mi>a</mi><mi>q</mi><mi>u</mi><mi>a</mi><mi> </mi><mi>r</mi><mi>e</mi><mi>g</mi><mi>i</mi><mi>a</mi></math> is due to the presence of <math><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">l</mi></math> and <math><msub><mrow><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">l</mi></mrow><mrow><mn>2</mn></mrow></msub></math>",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Aqua regia is 3 past HCl and 1 part <math><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>3</mn></mrow></msub></math><br /><math><mn>3</mn><mtext>HCl</mtext><mo>+</mo><msub><mrow><mtext>HNO</mtext></mrow><mrow><mtext>2</mtext></mrow></msub><mo>&#8594;</mo><munder><mrow><mtext>NOCl</mtext><mo>+</mo><msub><mrow><mtext>Cl</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>2</mn><msub><mrow><mtext>H</mtext></mrow><mrow><mtext>2</mtext></mrow></msub><mtext>O</mtext></mrow><mrow><mfenced separators=\"|\"><mrow><mtext>Yellow&#8201;colour&#8201;is&#8201;due&#8201;to&#8201;NOCl&#8201;and&#8201;</mtext><msub><mrow><mtext>Cl</mtext></mrow><mrow><mtext>2</mtext></mrow></msub></mrow></mfenced></mrow></munder></math><br /><math><mtext>Au</mtext><mo>+</mo><mtext>Aqua&#8201;Regia</mtext><mo>&#8594;</mo><munder><mrow><msub><mrow><mtext>HAuCl</mtext></mrow><mrow><mtext>4</mtext></mrow></msub></mrow><mrow><mfenced separators=\"|\"><mrow><mtext>+3&#8201;O.S&#8201;of&#8201;Au</mtext></mrow></mfenced></mrow></munder></math>",
    "image": null
  },
