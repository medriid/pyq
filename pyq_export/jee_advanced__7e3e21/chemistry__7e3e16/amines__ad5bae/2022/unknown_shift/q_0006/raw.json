      "id": "67mMH",
      "text": "<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">P</mi><mo>=</mo><mfrac><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi>Pd</mi></mfrac></math>, ethanol</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi><mo>=</mo><mfrac><msub><mi>NaNO</mi><mn>2</mn></msub><mi>HCl</mi></mfrac></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">U</mi><mo>=</mo><mn>1</mn><mo>.</mo><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub><msub><mi>PO</mi><mn>2</mn></msub></math><br />\t\t\t<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><msub><mi>KMnO</mi><mn>4</mn></msub><mo>-</mo><mi>KOH</mi></math>, heat</td>\t\t</tr>\t</tbody></table>",
      "isCorrect": true,
      "image": null
    },
