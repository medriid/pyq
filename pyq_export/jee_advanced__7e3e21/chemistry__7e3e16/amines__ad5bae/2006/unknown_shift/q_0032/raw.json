  "question": {
    "text": "The smallest ketone and its next homologoue are reacted with $\\mathrm{NH}_2 \\mathrm{OH}$ to form oxime",
    "image": null
  },
  "options": [
    {
      "id": "Okx7d",
      "text": "\ntwo different oximes are formed\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TzMc4",
      "text": "\nthree different oximes are formed\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "eAMNP",
      "text": "\ntwo oximes are optically active\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fztg2",
      "text": "\nall oximes are optically active",
      "image": null,
      "isCorrect": false
