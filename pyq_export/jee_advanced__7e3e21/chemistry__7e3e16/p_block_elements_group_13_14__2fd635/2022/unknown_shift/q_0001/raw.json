  "question": {
    "text": "The treatment of galena with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>HNO</mi><mn>3</mn></msub></math> produces a gas that is",
    "image": null
  },
  "options": [
    {
      "id": "SIosV",
      "text": "paramagnetic",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "C1ho6",
      "text": "bent in geometry",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1V3dB",
