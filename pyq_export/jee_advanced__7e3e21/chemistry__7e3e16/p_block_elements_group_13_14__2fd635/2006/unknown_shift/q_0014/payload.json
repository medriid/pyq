  "question": {
    "text": "The species present in solution when $\\mathrm{CO}_2$ is dissolved in water are"
  },
  "options": [
    {
      "text": "\n$\\mathrm{CO}_2, \\mathrm{H}_2 \\mathrm{CO}_3, \\mathrm{HCO}_3^{-}, \\mathrm{CO}_3^{2-}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{H}_2 \\mathrm{CO}_3, \\mathrm{CO}_3^{2-}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{CO}_3^{2-}, \\mathrm{HCO}_3^{-}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{CO}_2, \\mathrm{H}_2 \\mathrm{CO}_3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "When $\\mathrm{CO}_2$ is dissolved in water, therefore it forms dibasic carbonic acid, which gives $\\mathrm{HCO}_3^{-}$ and $\\mathrm{CO}_3^{2-}$ ions on ionisation. Hence in solution $\\mathrm{CO}_2, \\mathrm{H}_2 \\mathrm{CO}_3, \\mathrm{HCO}_3^{-}$and $\\mathrm{CO}_3^{2-}$ are present.\n<img src=\"assets\\st0014_5c4e84da623c.png\"><br>"
  }
}