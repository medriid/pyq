  "question": {
    "text": "One of the products formed from the reaction of permanganate ion with iodide ion in neutral aqueous medium is"
  },
  "options": [
    {
      "text": "$\\mathrm{I}_2$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{IO}_3^{-}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{IO}_4^{-}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{IO}_2^{-}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{I}^{-}+2 \\mathrm{MnO}_4^{-}+\\mathrm{H}_2 \\mathrm{O} \\xrightarrow{\\text { Neutral solution }} 2 \\mathrm{MnO}_2+\\mathrm{IO}_3^{-}+2 \\mathrm{OH}^{-}$"
  }
