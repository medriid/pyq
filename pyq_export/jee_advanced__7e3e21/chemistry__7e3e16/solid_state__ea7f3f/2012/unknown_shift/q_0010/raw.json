      "text": "$\\mathrm{MX}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "jHYxo",
      "text": "$\\mathrm{MX}_{2}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "4743k",
      "text": "$\\mathrm{M}_{2} \\mathrm{X}$",
      "isCorrect": false,
      "image": null
    },
    {
