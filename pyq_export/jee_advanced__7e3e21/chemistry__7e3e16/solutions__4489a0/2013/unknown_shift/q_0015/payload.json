  "question": {
    "text": "Benzene and naphthalene form an ideal solution at room temperature. For this process, the true statement(s) is (are)"
  },
  "options": [
    {
      "text": "<math> <mrow> <mo>&Delta;</mo> <mtext>G</mtext> </mrow> </math> is positive",
