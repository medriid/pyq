</mi><mn>3</mn></msub><mrow><mo>&#160;</mo><msub><mi mathvariant=\"normal\">V</mi><mn>2</mn></msub></mrow></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ln</mi><mn>10</mn><mo>=</mo><mi>ln</mi><mfenced><mfrac><msub><mi mathvariant=\"normal\">V</mi><mn>3</mn></msub><msub><mi mathvariant=\"normal\">V</mi><mn>2</mn></msub></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ln</mi><mn>10</mn><mo>=</mo><mi>ln</mi><mfenced><mfrac><msub><mi mathvariant=\"normal\">V</mi><mn>3</mn></msub><msup><mn>10</mn><mfrac><mn>5</mn><mn>2</mn></mfrac></msup></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>=</mo><mfrac><msub><mi mathvariant=\"normal\">V</mi><mn>3</mn></msub><msup><mn>10</mn><mfrac><mn>5</mn><mn>2</mn></mfrac></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">V</mi><mn>3</mn></msub><mo>=</mo><msup><mn>10</mn><mrow><mn>1</mn><mo>+</mo><mfrac><mn>5</mn><mn>2</mn></mfrac></mrow></msup><mo>=</mo><msup><mn>10</mn><mfrac><mn>7</mn><mn>2</mn></mfrac></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msub><mi>logV</mi><mn>3</mn></msub><mo>=</mo><mn>2</mn><mi>log</mi><msup><mn>10</mn><mrow><mn>7</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><mn>7</mn></math></p></blockquote>"
