  "correct_answer": "7",
  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">A</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">C</mi></mrow></msub><mo>=</mo><msub><mi>RT</mi><mn>2</mn></msub><mi>ln</mi><mn>10</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">A</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">B</mi></mrow></msub><mo>=</mo><mn>0</mn></math>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>&#160;(</mtext><mo>&#8757;</mo><mtext>&#160;adiabatic)&#160;</mtext></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">A</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">C</mi></mrow></msub><mo>=</mo><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">A</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">B</mi></mrow></msub><mo>+</mo><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">B</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">C</mi></mrow></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">A</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">C</mi></mrow></msub><mo>=</mo><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">B</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">C</mi></mrow></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">q</mi><mrow><mi mathvariant=\"normal\">A</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">c</mi></mrow></msub><mo>=</mo><msub><mi>nRT</mi><mn>2</mn></msub><mi>ln</mi><mfenced><mfrac><msub><mi mathvariant=\"normal\">V</mi><mn>3</mn></msub><mrow><mo>&#160;</mo><msub><mi mathvariant=\"n