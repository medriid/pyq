  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">S</mi><mo>=</mo><msub><mi mathvariant=\"normal\">S</mi><mn>0</mn></msub><mo>+</mo><msub><mo>&#8747;</mo><mrow/></msub><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub><mfrac><mrow><mo>d</mo><mi mathvariant=\"normal\">T</mi></mrow><mi mathvariant=\"normal\">T</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub><mo>=</mo><msub><mi mathvariant=\"normal\">S</mi><mn>0</mn></msub><mo>+</mo><msub><mo>&#8747;</mo><mrow></mrow></msub><msub><mfenced close=\"]\" open=\"[\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub></mfenced><mi mathvariant=\"normal\">&#945;</mi></msub><mfrac><mrow><mo>d</mo><mi mathvariant=\"normal\">T</mi></mrow><mi mathvariant=\"normal\">T</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>=</mo><msub><mi mathvariant=\"normal\">S</mi><mn>0</mn></msub><mo>+</mo><msub><mo>&#8747;</mo><mrow></mrow></msub><msub><mfenced close=\"]\" open=\"[\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub></mfenced><mi mathvariant=\"normal\">&#946;</mi></msub><mfrac><mrow><mo>d</mo><mi mathvariant=\"normal\">T</mi></mrow><mi mathvariant=\"normal\">T</mi></mfrac></math></p><p>Now,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub><mo>=</mo><msub><mi mathvariant=\"normal\">S</mi><mn>0</mn></msub><mo>+</mo><mo>&#8747;</mo><mfenced close=\"]\" open=\"[\"><mrow><msub><mfenced close=\"]\" open=\"[\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub></mfenced><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mfenced close=\"]\" open=\"[\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub></mfenced><mi mathvariant=\"normal\">&#945;</mi></msub></mrow></mfenced><mfrac><mrow><mo>d</mo><mi mathvariant=\"normal\">T</mi></mrow><mi mathvariant=\"normal\">T</mi></mfrac></math></p><p>Given&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced close=\"]\" open=\"[\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub></mfenced><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mfenced close=\"]\" open=\"[\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">p</mi></msub></mfenced><mi mathvariant=\"normal\">&#945;</mi></msub><mo>=</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub><mo>=</mo><mi>lnT</mi><mo>+</mo><mi mathvariant=\"normal\">C</mi></math>&nbsp;at any temperature of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">T</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced close=\"]\" open=\"[\"><mrow><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub></mrow></mfenced><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub></msub><mo>-</mo><msub><mfenced close=\"]\" open=\"[\"><mrow><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub></mrow></mfenced><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub></msub><mo>=</mo><msub><mi>lnT</mi><mn>2</mn></msub><mo>-</mo><msub><mi>lnT</mi><mn>1</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>=</mo><mn>600</mn><mi mathvariant=\"normal\">K</mi><mo>&#160;</mo><mo>,</mo><mo>&#160;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub><mo>=</mo><mn>300</mn><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi><mo>&#160;</mo><mi>and</mi><mo>&#160;</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>at</mi><mo>&#160;</mo><mn>600</mn><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>-</mo><msub><mfenced close=\"]\" open=\"[\"><mrow><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub></mrow></mfenced><mn>300</mn></msub><mo>=</mo><mi>ln</mi><mn>600</mn><mo>&#160;</mo><mo>-</mo><mi>ln</mi><mn>300</mn><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#946;</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">&#945;</mi></msub><mo>=</mo><mn>1</mn><mo>-</mo><mn>0</mn><mo>.</mo><mn>69</mn><mo>=</mo><mn>0</mn><mo>.</mo><mn>31</mn><mspace linebreak=\"newline\"></mspace></math>&nbsp;</p></blockquote>",
