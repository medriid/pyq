  "question": {
    "text": "For the process $\\mathrm{H}_2 \\mathrm{O}(\\mathrm{l})$ (1 bar, $\\left.273 \\mathrm{~K}\\right) \\longrightarrow \\mathrm{H}_2 \\mathrm{O}(\\mathrm{g})$ (1 bar, $\\left.373 \\mathrm{~K}\\right)$, the correct set of thermodynamic parameters is",
    "image": null
  },
  "options": [
    {
      "id": "IdoiW",
      "text": "\n$\\Delta G=0, \\Delta S=+$ ve\n",
      "image": null,
      "isCorrect": true
    },
    {
