    "text": "<p><math><mi>A</mi><mo>&#8652;</mo><mi>P</mi></math><br />Given <math><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>&#62;</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br /><math><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mrow></mrow></mfrac><mo>&#62;</mo><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><msub><mrow><mi>k</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mrow><mo>&#62;</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><msub><mrow><mi>k</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mrow></math><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mo>-</mo><mo>&#8710;</mo><msubsup><mrow><mi>G</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>0</mn></mrow></msubsup><mo>&#62;</mo><mo>-</mo><mo>&#8710;</mo><msubsup><mrow><mi>G</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>0</mn></mrow></msubsup></math><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mo>&#8710;</mo><msup><mrow><mi>H</mi></mrow><mrow><mn>0</mn></mrow></msup><mo>+</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>&#8710;</mo><msup><mrow><mi>S</mi></mrow><mrow><mn>0</mn></mrow></msup></mrow></mfenced><mo>&#62;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mo>&#8710;</mo><msup><mrow><mi>H</mi></mrow><mrow><mn>0</mn></mrow></ms