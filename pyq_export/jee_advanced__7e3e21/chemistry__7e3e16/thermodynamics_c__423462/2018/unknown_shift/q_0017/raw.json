    "text": "AC → Isochoric<br >AB → Isothermal<br >BC → Isobaric<br > <math><mo>#</mo><msub><mrow><mi>q</mi></mrow><mrow><mi>A</mi><mi>C</mi></mrow></msub><mo>=</mo><mo>∆</mo><msub><mrow><mi>U</mi></mrow><mrow><mi>B</mi><mi>C</mi></mrow></msub><mo>=</mo><mi>n</mi><msub><mrow><mi>C</mi></mrow><mrow><mi>V</mi></mrow></msub><mfenced separators=\"|\"><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math> <br > <math><msub><mrow><mi>W</mi></mrow><mrow><mi>A</mi><mi>B</mi></mrow></msub><mo>=</mo><mi>n</mi><mi>R</mi><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></mrow></mfenced></mrow></mrow></math>      A (wrong)<br > <math><mo>#</mo><msub><mrow><mi>q</mi></mrow><mrow><mi>B</mi><mi>C</mi></mrow></msub><mo>=</mo><mo>∆</mo><msub><mrow><mi>H</mi></mrow><mrow><mi>A</mi><mi>C</mi></mrow></msub><mo>=</mo><mi>n</mi><msub><mrow><mi>C</mi></mrow><mrow><mi>P</mi></mrow></msub><mfenced separators=\"|\"><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math> <br > <math><msub><mrow><mi>W</mi></mrow><mrow><mi>B</mi><mi>C</mi></mrow></msub><mo>=</mo><mo>-</mo><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math>      B (correct)<br > <math><mo>#</mo><mi>n</mi><msub><mrow><mi>C</mi></mrow><mrow><mi>P</mi></mrow></msub><mfenced separators=\"|\"><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow