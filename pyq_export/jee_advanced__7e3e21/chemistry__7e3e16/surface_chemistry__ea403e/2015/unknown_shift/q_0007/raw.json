  "type": "multipleCorrect",
  "level": 3,
  "question": {
    "text": "When <math><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></math> is adsorbed on a metallic surface, electron transfer occurs from the metal to <math><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></math> . The TRUE statement(s) regarding this adsorption is(are)",
    "image": null
  },
  "options": [
    {
      "id": "O7ogB",
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></math>  is physisorbed",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SPQEH",
      "text": "Heat is released",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "xjqKA",
      "text": "Occupancy of  <math><msubsup><mrow><mi mathvariant=\"normal\">π</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">p</mi></mrow><mrow><mi mathvariant=\"normal\">*</mi></mrow></msubsup></math>  of  <math><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></math>  is increased",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "jewb7",
      "text": "Bond length of  <math><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></math>  is increased",
      "isCorrect": true,
      "image": null
    }
