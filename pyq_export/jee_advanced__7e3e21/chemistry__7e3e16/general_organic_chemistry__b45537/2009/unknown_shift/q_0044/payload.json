  "question": {
    "text": "The IUPAC name of the following compound, is\n<img src=\"assets\\qt0044_dae928569c3a.png\"><br>"
  },
  "options": [
    {
      "text": "\n4-bromo-3-cyanophenol\n",
      "is_correct": false
    },
    {
      "text": "\n2-bromo-5-hydroxybenzonitrile\n",
      "is_correct": true
    },
    {
      "text": "\n2-cyano-4-hydroxybromobenzene\n",
      "is_correct": false
    },
    {
      "text": "\n6-bromo-3-hydroxybenzonitrile",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Cyano group has the highest priority therefore, parent name must be benzonitrile. $\\mathrm{Br}$ occurs at 2-position, and hydroxyl at 3-position, hence clockwise numbering will be the correct one."
  }
