  "question": {
    "text": "The IUPAC name of the following compound, is\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_advanced/w6azp8ZVwNJRA1UqThrHxICtM2Jrt8nnrnaVDxHR0ak.original.fullsize.png\"><br>",
