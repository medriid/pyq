      "text": "\n4-bromo-3-cyanophenol\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lTSY3",
      "text": "\n2-bromo-5-hydroxybenzonitrile\n",
      "image": null,
      "isCorrect": true
