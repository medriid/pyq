  "solution": {
    "text": "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math><mi>A</mi><mo>&#8594;</mo><mn>2</mn><mi>B</mi><mo>+</mo><mi>C</mi></math><br /><math><mtable><mtr><mtd><mi>t</mi><mo>=</mo><mn>0</mn></mtd><mtd><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub></mtd><mtd><mo>-</mo><mi>&#160;</mi><mo>-</mo></mtd></mtr><mtr><mtd><mi>t</mi><mo>=</mo><mi>t</mi></mtd><mtd><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>-</mo><mi>P</mi></mtd><mtd><mn>2</mn><mi>P</mi><mi>&#160;</mi><mi>&#160;</mi><mi>P</mi></mtd></mtr></mtable></math><br /><math><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mn>2</mn><mi>P</mi><mo>=</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>t</mi></mrow></msub></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>K</mi><mo>=</mo><mfrac><mn>1</mn><mi>t</mi></mfrac><mi>ln</mi><mo>&#8289;</mo><mfrac><msub><mi>P</mi><mn>0</mn></msub><mrow><msub><mi>P</mi><mn>0</mn></msub><mo>-</mo><mi>P</mi></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mi>t</mi></mfrac><mi>ln</mi><mo>&#8289;</mo><mfrac><msub><mi>P</mi><mn>0</mn></msub><mrow><msub><mi>P</mi><mn>0</mn></msub><mo>-</mo><mfrac><mfenced separators=\"|\"><mrow><msub><mi>P</mi><mi>t</mi></msub><mo>-</mo><msub><mi>P</mi><mn>0</mn></msub></mrow></mfenced><mn>2</mn></mfrac></mrow></mfrac></math><br /><math><mi>K</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>t</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mn>2</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>3</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>-</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>t</mi></mrow></msub></mrow></mfrac></mrow></mrow><mo>&#8658;</mo><mo>-</mo><mi>K</mi><mi>t</mi><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mn>2</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>3</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>-</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>t</mi></mrow></msub></mrow></mfenced></mrow></mrow></mrow></mrow></math><br />And <math><msub><mrow><mi>t</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>K</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>&#160;</mi></mrow><mrow><mfrac><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfrac></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>K</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mo>=</mo></mrow></mrow></math> contant<br />Rate constant does not depends on concentration",
