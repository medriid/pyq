  "question": {
    "text": "Given, that the abundances of isotopes, ${ }_{54} \\mathrm{Fe},{ }_{56} \\mathrm{~F}$ and ${ }_{57} \\mathrm{Fe}$ are $5 \\%$, $90 \\%$ and $5 \\%$, respectively, the atomic mass of $\\mathrm{Fe}$ is",
    "image": null
  },
  "options": [
    {
      "id": "OT4i7",
      "text": "\n$55.85$\n",
      "image": null,
      "isCorrect": false
    },
    {
