  "question": {
    "text": "Assuming that Hund's rule is violated, the bond order and magnetic nature of the diatomic molecule $\\mathrm{B}_2$ is",
    "image": null
  },
  "options": [
    {
      "id": "6WKJU",
      "text": "\n1 and diamagnetic\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hSuYx",
      "text": "\n0 and diamagnetic\n",
      "image": null,
      "isCorrect": false
    },
    {
