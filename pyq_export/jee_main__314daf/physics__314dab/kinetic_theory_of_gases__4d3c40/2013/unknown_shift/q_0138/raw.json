  "question": {
    "text": "In the isothermal expansion of $10 \\mathrm{~g}$ of gas from volume $\\mathrm{V}$ to $2 \\mathrm{~V}$ the work done by the gas is $575 \\mathrm{~J}$. \nWhat is the root mean square speed of the molecules of the gas at that temperature?",
    "image": null
  },
  "options": [
    {
      "id": "lpGQn",
      "text": "\n$398 \\mathrm{~m} / \\mathrm{s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "X4P46",
      "text": "\n$520 \\mathrm{~m} / \\mathrm{s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RKvCx",
      "text": "\n$499 \\mathrm{~m} / \\mathrm{s}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "IgN7i",
      "text": "\n$532 \\mathrm{~m} / \\mathrm{s}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{v}_{\\mathrm{rms}}=\\sqrt{\\frac{3 \\rho \\mathrm{v}}{\\text { mass of the gas }}}$",
    "image": null
  },
