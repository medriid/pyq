  "question": {
    "text": "At room temperature a diatomic gas is found to have an r.m.s. speed of $1930 \\mathrm{~ms}^{-1}$. The gas is:",
    "image": null
  },
  "options": [
    {
      "id": "57B7b",
      "text": "\n$\\mathrm{H}_2$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "2Ja82",
      "text": "\n$\\mathrm{Cl}_2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ezsBi",
      "text": "\n$\\mathrm{O}_2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rBxX9",
      "text": "\n$\\mathrm{F}_2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n&\\because \\quad \\mathrm{C}=\\sqrt{\\frac{3 \\mathrm{RT}}{\\mathrm{M}}} \\\\\n&\\left(1930^2\\right)=\\frac{3 \\times 8.314 \\times 300}{\\mathrm{M}} \\\\\n&\\mathrm{M}=\\frac{3 \\times 8.314 \\times 300}{1930 \\times 1930} \\approx 2 \\times 10^{-3} \\mathrm{~kg}\n\\end{aligned}\n$$\nThe gas is $\\mathrm{H}_2$.",
    "image": null
  },
