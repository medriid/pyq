  "question": {
    "text": "The value closest to the thermal velocity of a Helium atom at room temperature $(300 \\mathrm{~K})$ in $\\mathrm{ms}^{-1}$ is:\n$\\left[\\mathrm{k}_{\\mathrm{B}}=1.4 \\times 10^{-23} \\mathrm{~J} / \\mathrm{K} ; \\mathrm{m}_{\\mathrm{He}}=7 \\times 10^{-27} \\mathrm{~kg}\\right]$",
    "image": null
  },
  "options": [
    {
      "id": "hgdDS",
      "text": "\n$1.3 \\times 10^4$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mOXxz",
      "text": "\n$1.3 \\times 10^5$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DBKfV",
      "text": "\n$1.3 \\times 10^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oF73d",
      "text": "\n$1.3 \\times 10^3$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\nv &=\\sqrt{3 k_{\\mathrm{B}} T / m_{\\mathrm{He}}}=\\sqrt{\\frac{3 \\times 1.4 \\times 10^{-23} \\times 300}{7 \\times 10^{-27}}} \\\\\n&=1.34 \\times 10^3 \\mathrm{~m} / \\mathrm{s}\n\\end{aligned}\n$$",
    "image": null
  },
