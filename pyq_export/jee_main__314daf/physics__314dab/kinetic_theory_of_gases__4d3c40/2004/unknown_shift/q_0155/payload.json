      "text": "\n$3 / 2$\n",
      "is_correct": true
    },
    {
      "text": "\n$23 / 15$\n",
      "is_correct": false
    },
    {
      "text": "\n$35 / 23$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 / 3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{Q}=\\mathrm{Q}_1+\\mathrm{Q}_2$\n$\\frac{\\mathrm{n}_1+\\mathrm{n}_2}{\\gamma_{\\mathrm{m}}-1}=\\frac{\\mathrm{n}_1}{\\gamma_1-1}+\\frac{\\mathrm{n}_2}{\\gamma_2-1}$\n$\\gamma_{\\mathrm{m}}=\\frac{3}{2}$"
  }
