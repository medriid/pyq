  "solution": {
    "text": "<math><mi>τ</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>2</mn></msqrt><mi>n</mi><mi>π</mi><msup><mrow><mi>d</mi></mrow><mrow><mn>2</mn></mrow></msup><mtext> </mtext><msub><mrow><mi>v</mi></mrow><mrow><mi>a</mi><mi>v</mi><mi>g</mi></mrow></msub></mrow></mfrac></math><br /><br />Where <math><mi>n</mi><mo>=</mo></math> number of molecules per unit volume.<br /><br /><math><mi>τ</mi><mo>∝</mo><mfrac><mrow><mi>V</mi></mrow><mrow><msqrt><mi>T</mi></msqrt></mrow></mfrac><mo>⇒</mo><mi>τ</mi><mo>∝</mo><mfrac><mrow><msqrt><mi>T</mi></msqrt></mrow><mrow><mi>P</mi></mrow></mfrac></math><br /><br /><math><mfrac><mrow><msub><mrow><mi>τ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>τ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><msqrt><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></msqrt><mo>.</mo><mfrac><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>⇒</mo><msub><mrow><mi>τ</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>6</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>8</mn></mrow></msup><mo>×</mo><msqrt><mfrac><mrow><mn>5000</mn></mrow><mrow><mn>300</mn></mrow></mfrac></msqrt><mo>×</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><br /><math><mo>≈</mo><mn>4</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>8</mn></mrow></msup><mi>s</mi></math>",
