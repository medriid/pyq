  "question": {
    "text": "A vessel contains <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>14</mn><mo>&#160;</mo><mi mathvariant=\"normal\">g</mi></math> of nitrogen gas at a temperature of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>27</mn><mo>&#176;</mo><mi mathvariant=\"normal\">C</mi></math>. The amount of heat to be transferred to the gas to double the r.m.s. speed of its molecules will be : (Take <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mn>8</mn><mo>.</mo><mn>32</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi><mo>&#160;</mo><msup><mi>mol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mi mathvariant=\"normal\">k</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>)",
    "image": null
  },
  "options": [
    {
      "id": "El0L4",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2229</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "h9hgw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5616</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
