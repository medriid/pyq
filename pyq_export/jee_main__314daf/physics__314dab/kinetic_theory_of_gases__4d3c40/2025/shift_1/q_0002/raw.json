  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Frequency }=\\frac{1}{T}=\\frac{V_{\\text {avg }}}{\\lambda} \\\\ & =\\frac{600}{3 \\times 157}=2 \\times 10^9 \\mathrm{sec}^{-1}\\end{aligned}$",
