  "question": {
    "text": "The helium and argon are put in the flask at the same room temperature ( 300 K). The ratio of average kinetic energies (per molecule) of helium and argon is :<br/>(Give : Molar mass of helium $=4 \\mathrm{~g} / \\mathrm{mol}$, Molar mass of argon $=40 \\mathrm{~g} / \\mathrm{mol}$)",
    "image": null
  },
  "options": [
    {
      "id": "yi1pE",
      "text": "$1: 10$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uKgcF",
      "text": "$10: 1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jGisd",
      "text": "$1: \\sqrt{10}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HTOSQ",
      "text": "$1: 1$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$K. E=\\frac{f}{2} K T$<br/>For He and $\\mathrm{Ar} \\mathrm{f}=3$<br/>$\\frac{\\mathrm{K} \\cdot \\mathrm{E}_{\\mathrm{He}}}{\\mathrm{~K} \\cdot \\mathrm{E}_{\\mathrm{Ar}}}=\\frac{1}{1}$",
    "image": null
