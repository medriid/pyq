    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>11</mn></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>f</mi><mn>1</mn></msub><msub><mi>n</mi><mn>1</mn></msub><mi>R</mi><msub><mi>T</mi><mn>1</mn></msub></mrow><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><msub><mi>f</mi><mn>2</mn></msub><msub><mi>n</mi><mn>2</mn></msub><mi>R</mi><msub><mi>T</mi><mn>2</mn></msub></mrow><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>3</mn><mo>&#215;</mo><mfrac><mn>5</mn><mn>2</mn></mfrac><mi>R</mi><mi>T</mi><mo>+</mo><mfrac><mn>5</mn><mn>2</mn></mfrac><mo>&#215;</mo><mn>3</mn><mi>R</mi><mi>T</mi><mo>=</mo><mn>15</mn></math></p>"
