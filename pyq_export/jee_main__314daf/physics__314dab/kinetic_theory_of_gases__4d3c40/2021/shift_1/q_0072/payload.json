    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>P</mi><mn>0</mn></msub><mrow><mi>a</mi><mi>e</mi><mi>R</mi></mrow></mfrac></math>",
