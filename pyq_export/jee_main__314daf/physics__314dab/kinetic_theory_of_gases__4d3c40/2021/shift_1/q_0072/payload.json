    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><msub><mi>P</mi><mn>0</mn></msub></mrow><mrow><mi>e</mi><mi>R</mi></mrow></mfrac></math>",
