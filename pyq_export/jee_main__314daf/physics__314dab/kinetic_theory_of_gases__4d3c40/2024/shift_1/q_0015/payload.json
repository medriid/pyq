  "question": {
    "text": "If the collision frequency of hydrogen molecules in a closed chamber at $27^{\\circ} \\mathrm{C}$ is $\\mathrm{Z}$, then the collision frequency of the same system at $127^{\\circ} \\mathrm{C}$ is :"
  },
  "options": [
    {
      "text": "$\\frac{\\sqrt{3}}{2} \\mathrm{z}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2}{\\sqrt{3}} \\mathrm{Z}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{3}{4} \\mathrm{Z}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{4}{3} \\mathrm{Z}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Assuming mean free path constant.\n$\\begin{aligned} & \\mathrm{f} \\propto \\mathrm{V} \\propto \\sqrt{\\mathrm{T}} \\\\ & \\frac{\\mathrm{f}_1}{\\mathrm{f}_2}=\\sqrt{\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}}=\\sqrt{\\frac{300}{400}} \\\\ & \\mathrm{f}_2=\\sqrt{\\frac{4}{3}}=\\mathrm{f}_1=\\frac{2}{\\sqrt{3}} \\mathrm{Z}\\end{aligned}$"
  }
}