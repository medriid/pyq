  "question": {
    "text": "A mixture of one mole of monoatomic gas and one mole of a diatomic gas (rigid) are kept at room temperature $\\left(27^{\\circ} \\mathrm{C}\\right)$. The ratio of specific heat of gases at constant volume respectively is:"
  },
  "options": [
    {
      "text": "$\\frac{7}{5}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3}{5}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{5}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\frac{\\left(\\mathrm{C}_{\\mathrm{v}}\\right)_{\\text {mono }}}{\\left(\\mathrm{C}_{\\mathrm{v}}\\right)_{\\mathrm{dia}}}=\\frac{\\frac{3}{2} \\mathrm{R}}{\\frac{5}{2} \\mathrm{R}}=\\frac{3}{5}$"
  }
}