      "image": null,
      "isCorrect": false
    },
    {
      "id": "NhS83",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mi>A</mi></msub><mo>&gt;</mo><msub><mi>C</mi><mi>P</mi></msub><mo>&gt;</mo><msub><mi>C</mi><mi>V</mi></msub></math>",
