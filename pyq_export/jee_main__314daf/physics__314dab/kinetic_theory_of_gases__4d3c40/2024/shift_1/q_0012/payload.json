  "question": {
    "text": "A sample contains mixture of helium and oxygen gas. The ratio of root mean square speed of helium and oxygen in the sample, is:"
  },
  "options": [
    {
      "text": "$\\frac{1}{32}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2 \\sqrt{2}}{1}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{2 \\sqrt{2}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{4}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{V}_{\\mathrm{ms}}=\\sqrt{\\frac{3 \\mathrm{RT}}{\\mathrm{M}_{\\mathrm{w}}}} \\\\ & \\Rightarrow \\frac{\\mathrm{V}_{\\mathrm{O}_2}}{\\mathrm{~V}_{\\mathrm{He}}}=\\sqrt{\\frac{\\mathrm{M}_{\\mathrm{w}, \\mathrm{He}}}{\\mathrm{M}_{\\mathrm{w}, \\mathrm{O}_2}}} \\\\ & =\\sqrt{\\frac{4}{32}}=\\frac{1}{2 \\sqrt{2}} \\\\ & \\frac{\\mathrm{V}_{\\mathrm{He}}}{\\mathrm{V}_{\\mathrm{O}_2}}=\\frac{2 \\sqrt{2}}{1} \\\\ & \\end{aligned}$"
  }
}