  "question": {
    "text": "The specific heat at constant pressure of a real gas obeying $P V^2=R T$ equation is:",
    "image": null
  },
  "options": [
    {
      "id": "pRZoj",
      "text": "$\\frac{R}{3}+C_V$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zB4LB",
      "text": "$C_V+R$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "x95od",
      "text": "$C_V+\\frac{R}{2 V}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "YAia8",
      "text": "$R$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{dQ}=\\mathrm{du}+\\mathrm{dW} \\\\\n& \\mathrm{CdT}=\\mathrm{C}_{\\mathrm{V}} \\mathrm{dT}+\\mathrm{PdV} \\\\\n& \\therefore \\mathrm{PV}^2=\\mathrm{RT} \\\\\n& \\mathrm{P}=\\text { constant } \\\\\n& \\mathrm{P}(2 \\mathrm{VdV})=\\mathrm{RdT} \\\\\n& \\mathrm{PdV}=\\frac{\\mathrm{RdT}}{2 \\mathrm{~V}} \\\\\n&\n\\end{aligned}$<br />Put in equation (1)\n$\\mathrm{C}=\\mathrm{C}_{\\mathrm{V}}+\\frac{\\mathrm{R}}{2 \\mathrm{~V}}$",
    "image": null
  },
