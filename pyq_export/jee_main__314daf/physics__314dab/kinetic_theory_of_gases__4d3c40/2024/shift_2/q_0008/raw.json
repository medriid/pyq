  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\lambda=\\frac{\\mathrm{RT}}{\\sqrt{2} \\pi \\mathrm{d}^2 \\mathrm{~N}_{\\mathrm{A}} \\mathrm{P}} \\\\ & \\mathrm{KE}=\\frac{\\mathrm{f}}{2} \\mathrm{nRT}\\end{aligned}$",
