  "question": {
    "text": "Energy of 10 non rigid diatomic molecules at temperature $T$ is :",
    "image": null
  },
  "options": [
    {
      "id": "OfodJ",
      "text": "$70 \\mathrm{~K}_{\\mathrm{B}} \\mathrm{T}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xWQ2f",
      "text": "$35 \\mathrm{~K}_{\\mathrm{B}} \\mathrm{T}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "IVLwq",
      "text": "$\\frac{7}{2} \\mathrm{RT}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BHjXw",
      "text": "$35 \\mathrm{RT}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\text { Degree of freedom }(f)=5+2(3 \\mathrm{~N}-5) \\\\\n& \\qquad f=5+2(3 \\times 2-1)=7 \\\\\n& \\text { energy of one molecule }=\\frac{f}{2} K_B T\n\\end{aligned}$\nenergy of 10 molecules\n$=10\\left(\\frac{\\mathrm{f}}{2} \\mathrm{~K}_{\\mathrm{B}} \\mathrm{T}\\right)=10\\left(\\frac{7}{2} \\mathrm{~K}_{\\mathrm{B}} \\mathrm{T}\\right)=35 \\mathrm{~K}_{\\mathrm{B}} \\mathrm{T}$",
    "image": null
  },
