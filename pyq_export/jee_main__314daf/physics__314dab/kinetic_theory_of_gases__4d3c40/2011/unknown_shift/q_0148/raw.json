  "question": {
    "text": "A thermally insulated vessel contains an ideal gas of molecular mass $M$ and ratio of specific heats $\\gamma$. It is moving with speed $v$ and is suddenly brought to rest. Assuming no heat is lost to the surroundings, its temperature increases by :",
    "image": null
  },
  "options": [
    {
      "id": "h6Hdo",
      "text": "\n$\\frac{(\\gamma-1)}{2 \\gamma \\mathrm{R}} \\mathrm{Mv}^2 \\mathrm{~K}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0Bogc",
      "text": "\n $\\frac{\\gamma M v^2}{2 \\mathrm{R}} \\mathrm{K}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Dj9CG",
      "text": "\n$\\frac{(\\gamma-1)}{2 \\mathrm{R}} \\mathrm{Mv}^2 \\mathrm{~K}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BSQBC",
      "text": "\n$\\frac{(\\gamma-1)}{2(\\gamma+1) R} \\mathrm{Mv}^2 \\mathrm{~K}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{W}=\\Delta \\mathrm{U}$\n$\\frac{1}{2} \\mathrm{mv}^2=\\mathrm{nC}_{\\mathrm{v}} \\mathrm{dT}$\n$=\\frac{\\mathrm{m}}{\\mathrm{M}} \\frac{\\mathrm{R}}{\\gamma-1} \\mathrm{dT}$\n$\\mathrm{dT}=\\frac{\\mathrm{M}(\\gamma-1) \\mathrm{v}^2}{2 \\mathrm{R}} \\mathrm{K}$",
    "image": null
  },
