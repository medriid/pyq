  "question": {
    "text": "Three perfect gases at absolute temperatures $T_1, T_2$ and $T_3$ are mixed. The masses of molecules are $m_1$, $m_2$ and $m_3$ and the number of molecules are $n_1, n_2$ and $n_3$ respectively. Assuming no loss of energy, the final temperature of the mixture is :",
    "image": null
  },
  "options": [
    {
      "id": "up0Tq",
      "text": "\n$\\frac{n_1 T_1+n_2 T_2+n_3 T_3}{n_1+n_2+n_3}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "FBbEO",
      "text": "\n$\\frac{n_1 T_1+n_2 T_2^2+n_3 T_3^2}{n_1 T_1+n_2 T_2+n_3 T_3}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "B2cor",
      "text": "\n$\\frac{n_1^2 T_1^2+n_2^2 T_2^2+n_3^2 T_3^2}{n_1 T_1+n_2 T_2+n_3 T_3}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zclh3",
      "text": "\n$\\frac{\\left(T_1+T_2+T_3\\right)}{3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Data $\\Rightarrow n, k, t_1+n_2 k T_2+n_3 k T_3=\\left(n_1+n_2+n_3\\right) k T$\n$\\therefore T=\\frac{n_1 T_1+n_2 T_2+n_3 T_3}{n_1+n_2+n_3}$",
    "image": null
  },
