  "correctValue": null,
  "solution": {
    "text": "Pressure at common interface of two liquid columns is same.<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1342760f-0043-431f-9ddb-611810218dbd-image.png\" style=\"width: 380px; height: 195px;\" /><br /><br /><br /><math> <mrow> <msub> <mtext>d</mtext> <mn>1</mn></msub><msub> </msub> <mtext>gR</mtext> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> </mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow><mn>1</mn> <mo>-</mo> <mo>sin</mo> <mi>&alpha;</mi></mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow> </mrow> </mfenced> <mo>=</mo> <msub> </msub><msub><mtext>d</mtext> <mn>1</mn></msub><msub> </msub> <mtext>gR</mtext> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> </mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow><mn>1</mn> <mo>-</mo> <mo>cos</mo> <mi>&alpha;</mi></mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow> </mrow> </mfenced> <mo>+</mo> <msub> </msub><msub><mtext>d</mtext> <mn>2</mn></msub><msub> </msub> <mtext>gR</mtext> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> </mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow><mo>sin</mo> <mi>&alpha;</mi> <mo>+</mo> <mo>cos</mo> <mi>&alpha;</mi> </mrow> </mfenced> </mrow> </math><br /><br /><math> <mrow> <msub> <mtext>d</mtext> <mn>1</mn></msub><msub> </msub> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> </mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow><mo>cos</mo> <mi>&alpha;</mi> <mo>-</mo> <mo>sin</mo> <mi>&alpha;</mi></mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow> </mrow> </mfenced> <mo>=</mo> <msub> </msub><msub><mtext>d</mtext> <mn>2</mn></msub><msub> </msub> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> </mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\",\"><mrow><mo>sin</mo> <mi>&alpha;</mi> <mo>+</mo> <mo>cos</mo> <mi>&alpha;</mi> </mrow> </mfenced> </mrow> </math><b