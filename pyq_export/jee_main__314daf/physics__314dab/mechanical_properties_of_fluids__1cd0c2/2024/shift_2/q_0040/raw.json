      "isCorrect": false
    },
    {
      "id": "oqE8w",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>v</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QGKlW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>v</mi></math>",
      "image": null,
      "isCorrect": false
