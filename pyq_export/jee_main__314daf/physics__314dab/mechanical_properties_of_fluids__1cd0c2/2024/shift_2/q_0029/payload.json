  "question": {
    "text": "Pressure inside a soap bubble is greater than the pressure outside by an amount :\n(given : $\\mathrm{R}=$ Radius of bubble $\\mathrm{S}=$ Surface tension of bubble)"
  },
  "options": [
    {
      "text": "$\\frac{2 S}{R}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{4 R}{S}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{S}{R}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{4 \\mathrm{~S}}{\\mathrm{R}}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "There are two liquid-air surfaces in bubble so\n$\\Delta \\mathrm{P}=2\\left(\\frac{2 \\mathrm{~S}}{\\mathrm{R}}\\right)=\\frac{4 \\mathrm{~S}}{\\mathrm{R}}$"
  }
}