  "question": {
    "text": "A small ball of mass $m$ and density $\\rho$ is dropped in a viscous liquid of density $\\rho_0$. After sometime, the ball falls with constant velocity. The viscous force on the ball is :",
    "image": null
  },
  "options": [
    {
      "id": "noWyx",
      "text": "$m g\\left(1-\\rho \\rho_0\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PJ6PI",
      "text": "$m g\\left(1+\\frac{\\rho}{\\rho_0}\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SYQ8y",
      "text": "$m g\\left(\\frac{\\rho_0}{\\rho}-1\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xyAOu",
      "text": "$m g\\left(1-\\frac{\\rho_0}{\\rho}\\right)_{\\nabla}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{mg}-\\mathrm{F}_{\\mathrm{B}}-\\mathrm{F}_{\\mathrm{v}}=\\mathrm{ma}$\n$\\mathrm{a}=0$ for constant velocity\n$\\begin{aligned}\n& m g-F_B=F_v \\\\\n& F_v=m g-v \\rho_0 g=m g-\\frac{m}{\\rho} \\rho_0 g=m g\\left(1-\\frac{\\rho_0}{\\rho}\\right)\n\\end{aligned}$",
    "image": null
  },
