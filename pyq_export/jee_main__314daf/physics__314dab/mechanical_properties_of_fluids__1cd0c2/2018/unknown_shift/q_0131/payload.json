    "text": "<img src=\"assets\\st0131_832da83a0637.png\" style=\"width: 220px; height: 157px;\" /><br />Pressure at the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> is&nbsp;the same on both sides of the tube,&nbsp;<br /><math> <mrow> <msub> <mi>&#961;</mi> <mn>1</mn> </msub> <mi>g</mi><mi>r</mi><mo stretchy=\"false\">(</mo><mi>cos</mi><mi>&#952;</mi><mo>&#8722;</mo><mi>sin</mi><mi>&#952;</mi><mo stretchy=\"false\">)</mo><mo>=</mo><msub> <mi>&#961;</mi> <mn>2</mn> </msub> <mi>g</mi><mi>r</mi><mo stretchy=\"false\">(</mo><mi>sin</mi><mi>&#952;</mi><mo>+</mo><mi>cos</mi><mi>&#952;</mi><mo stretchy=\"false\">)</mo></mrow></math><br /><be><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><msub><mi>&#961;</mi><mn>1</mn></msub><msub><mi>&#961;</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><mrow><mi>sin</mi><mi>&#952;</mi><mo>+</mo><mi>cos</mi><mi>&#952;</mi></mrow><mrow><mi>cos</mi><mi>&#952;</mi><mo>-</mo><mi>sin</mi><mi>&#952;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>tan</mi><mi>&#952;</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mi>&#952;</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>&#961;</mi><mn>1</mn></msub><mo>-</mo><msub><mi>&#961;</mi><mn>1</mn></msub><mi>tan</mi><mi>&#952;</mi><mo>=</mo><msub><mi>&#961;</mi><mn>2</mn></msub><mo>+</mo><msub><mi>&#961;</mi><mn>2</mn></msub><mi>tan</mi><mi>&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><msub><mi>&#961;</mi><mn>1</mn></msub><mo>+</mo><msub><mi>&#961;</mi><mn>2</mn></msub></mrow></mfenced><mi>tan</mi><mi>&#952;</mi><mo>=</mo><msub><mi>&#961;</mi><mn>1</mn></msub><mo>-</mo><msub><mi>&#961;</mi><mn>2</mn></msub></math><br /><br /><math><mi>&#952;</mi><mo>=</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mfenc