  "question": {
    "text": "If the terminal speed of a sphere of gold (density $=19.5 \\mathrm{~kg} / \\mathrm{m}^3$ ) is $0.2 \\mathrm{~m} / \\mathrm{s}$ in a viscous liquid (density $=1.5 \\mathrm{~kg} / \\mathrm{m}^3$ ) of the same size in the same liquid."
  },
  "options": [
    {
      "text": "\n$0.2 \\mathrm{~m} / \\mathrm{s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.4 \\mathrm{~m} / \\mathrm{s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.133 \\mathrm{~m} / \\mathrm{s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.1 \\mathrm{~m} / \\mathrm{s}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{v}_{\\mathrm{s}}}{\\mathrm{v}_{\\mathrm{g}}}=\\frac{\\left(\\rho_{\\mathrm{s}}-\\rho_{\\ell}\\right)}{\\left(\\rho_{\\mathrm{g}}-\\rho_{\\ell}\\right)}$\n$\\mathrm{v}_{\\mathrm{s}}=0.1 \\mathrm{~m} / \\mathrm{s}$"
  }
