  "question": {
    "text": "A small rigid spherical ball of mass M is dropped in a long vertical tube containing glycerine. The velocity of the ball becomes constant after some time. If the density of glycerine is half of the density of the ball, then the viscous force acting on the ball will be (consider g as acceleration due to gravity)",
    "image": null
  },
  "options": [
    {
      "id": "YFcMK",
      "text": "2 Mg",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "u0gQg",
      "text": "Mg",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Asr4b",
      "text": "$\\frac{3}{2} \\mathrm{Mg}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "R3XQu",
      "text": "$\\frac{\\mathrm{Mg}}{2}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/uzHJhOPqwFDic_gwS5X18LOVq4jWgP2Ex39ee7joqYk.original.fullsize.png\"><br>\n\n$\\begin{aligned} & \\mathrm{mg}-\\mathrm{F}_{\\mathrm{B}}-\\mathrm{f}=0 \\\\ & \\Rightarrow \\mathrm{mg}-\\frac{\\mathrm{mg}}{2}-\\mathrm{f}=0 \\\\ & \\therefore \\mathrm{f}=\\frac{\\mathrm{mg}}{2}\\end{aligned}$",
    "image": null
  },
