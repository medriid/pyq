  "question": {
    "text": "A capillary tube of radius 0.1 mm is partly dipped in water (surface tension $70 \\mathrm{dyn} / \\mathrm{cm}$ and glass water contact angle $\\simeq 0^{\\circ}$) with $30^{\\circ}$ inclined with vertical. The length of water risen in the capillary is ________ cm.<br/>$\\left(\\right.$ Take $\\left.\\mathrm{g}=9.8 \\mathrm{~m} / \\mathrm{s}^2\\right)$",
    "image": null
  },
  "options": [
    {
      "id": "Yc10s",
      "text": "$\\frac{82}{5}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GVzGk",
      "text": "$\\frac{57}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jS8hl",
      "text": "$\\frac{71}{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OSLH5",
      "text": "$\\frac{68}{5}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/GCimEH_kEhiHPvKs45VLTfId1mQcSQLU-kAJHRM20kk.original.fullsize.png\"/><br/>$\\begin{aligned} & \\mathrm{h}=\\frac{2 \\mathrm{~T} \\cos \\theta}{\\rho \\mathrm{gr}}=\\frac{2 \\times 70 \\times 1}{1 \\times 980 \\times 10^{-2}} \\\\ & \\mathrm{~h}=\\frac{100}{7} \\mathrm{~cm} \\\\ & \\sin 60^{\\circ}=\\frac{\\mathrm{h}}{\\ell} \\\\ & \\ell=\\frac{\\mathrm{h} \\times 2}{\\sqrt{3}} \\\\ & \\ell=\\frac{100}{7} \\times \\frac{2}{\\sqrt{3}} \\\\ & =\\frac{200}{7 \\times \\sqrt{3}} \\\\ & =16.49 \\mathrm{~cm}\\end{aligned}$",
    "image": null
  },
