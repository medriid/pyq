  "question": {
    "text": "Two liquids A and B have $\\theta_{\\mathrm{A}}$ and $\\theta_{\\mathrm{B}}$ as contact angles in a capillary tube. If $K=\\cos \\theta_A / \\cos \\theta_B$. then identify the correct statement:",
    "image": null
  },
  "options": [
    {
      "id": "3QC4O",
      "text": "$K$ is negative, then liquid $A$ and liquid $B$ have convex meniscus.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oG8Ja",
      "text": "$K$ is negative, then liquid $A$ and liquid $B$ have concave meniscus.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a4x1R",
      "text": "K is negative, then liquid A has concave meniscus and liquid $B$ has convex meniscus",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "yH98U",
      "text": "K is zero, then liquid A has convex meniscus and liquid B has concave meniscus.",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{k}=\\frac{\\cos \\theta_{\\mathrm{A}}}{\\cos \\theta_{\\mathrm{B}}}$<br/>It is negative when $\\cos \\theta_A \\& \\cos \\theta_B$ are of opposite sign. so option (3)",
    "image": null
  },
