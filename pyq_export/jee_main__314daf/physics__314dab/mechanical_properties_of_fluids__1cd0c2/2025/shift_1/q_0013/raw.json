  "question": {
    "text": "An air bubble of radius 0.1 cm lies at a depth of 20 cm below the free surface of a liquid of density $1000 \\mathrm{~kg} / \\mathrm{m}^3$. If the pressure inside the bubble is $2100 \\mathrm{~N} / \\mathrm{m}^2$ greater than the atmospheric pressure, then the surface tension of the liquid in SI unit is (use $\\mathrm{g}=10 \\mathrm{~m} / \\mathrm{s}^2$ )",
    "image": null
  },
  "options": [
    {
      "id": "7o7no",
      "text": "$0.1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1VoWY",
      "text": "$0.05$",
      "image": null,
      "isCorrect": true
