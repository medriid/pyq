  "question": {
    "text": "Spherical balls of radius $R$ are falling in a viscous fluid of viscosity $\\eta$ with a velocity $v$. The retarding viscous force acting on the spherical ball is",
    "image": null
  },
  "options": [
    {
      "id": "S2jdD",
      "text": "\ndirectly proportional to $\\mathrm{R}$ but inversely proportional to $\\mathrm{v}$.\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vXQx1",
      "text": "\ndirectly proportional to both radius $R$ and velocity $v$.\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "TbwXS",
      "text": "\ninversely proportional to both radius $\\mathrm{R}$ and velocity $\\mathrm{v}$.\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8VpAP",
      "text": "\ninversely proportional to $\\mathrm{R}$ but directly proportional to velocity $\\mathrm{v}$.",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Retarding viscous force $=6 \\pi \\eta \\mathrm{R} v$",
    "image": null
  },
