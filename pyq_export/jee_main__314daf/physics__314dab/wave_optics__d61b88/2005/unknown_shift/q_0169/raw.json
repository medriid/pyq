      "text": "\n$3 \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{1.22 \\lambda}{(3 \\mathrm{~mm})}=$ Re solution limit $=\\frac{(1 \\mathrm{~mm})}{\\mathrm{R}}$\n$\\therefore \\mathrm{R}=5 \\mathrm{~m}$",
    "image": null
  },
