  "question": {
    "text": "$n$ identical waves each of intensity $I_0$ interfere with each other. The ratio of maximum intensities if the interference is (i) coherent and (ii) incoherent is :",
    "image": null
  },
  "options": [
    {
      "id": "fqNoE",
      "text": "\n$n^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DAskQ",
      "text": "\n$\\frac{1}{n}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "i9sXN",
      "text": "\n$\\frac{1}{n^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A7Vxd",
      "text": "\n$n$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\text { (Maximum intensity) coherent interference }}{\\text { (Maximum intensity) coherent interference }}$ $=\\frac{\\mathrm{n}^2 \\mathrm{I}_0}{\\mathrm{nI}_0}=\\mathrm{n}$",
    "image": null
  },
