  "question": {
    "text": "In a Young's double slit experiment with light of wavelength $\\lambda$, fringe pattern on the screen has fringe width $\\beta$. When two thin transparent glass (refractive index $\\mu$ ) plates of thickness $t_1$ and $t_2$ $\\left(t_1>t_2\\right)$ are placed in the path of the two beams respectively, the fringe pattern will shift by a distance"
  },
  "options": [
    {
      "text": "\n$\\frac{\\beta(\\mu-1}{\\lambda}\\left(\\frac{t_1}{t_2}\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mu \\beta}{\\lambda} \\frac{t_1}{t_2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\beta(\\mu-1}{\\lambda}\\left(t_1-t_2\\right.$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\left(\\mu-1 \\frac{\\lambda}{\\beta}\\right)\\left(t_1+t_2 \\quad\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\text { } \\begin{aligned}\n\\text { Shift } & =\\frac{\\beta(\\mu-1)}{\\lambda} t_1-\\frac{\\beta(\\mu-1)}{\\lambda} t_2 \\\\\n& =\\frac{\\beta(\\mu-1)}{\\lambda}\\left(t_1-t_2\\right)\n\\end{aligned}\n$$"
  }
}