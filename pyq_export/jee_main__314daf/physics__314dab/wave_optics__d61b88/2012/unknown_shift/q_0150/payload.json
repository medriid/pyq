  "question": {
    "text": "The first diffraction minimum due to the single slit diffraction is seen at $\\theta=30^{\\circ}$ for a light of wavelength $5000 Å$ falling perpendicularly on the slit. The width of the slit is"
  },
  "options": [
    {
      "text": "\n$2.5 \\times 10^{-5} \\mathrm{~cm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.25 \\times 10^{-5} \\mathrm{~cm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$10 \\times 10^{-5} \\mathrm{~cm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$5 \\times 10^{-5} \\mathrm{~cm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "For first minimum, $d \\sin \\theta=\\lambda$\n$$\n\\begin{aligned}\n\\Rightarrow \\quad d & =\\frac{\\lambda}{\\sin \\theta}=\\frac{5000 \\times 10^{-8} \\mathrm{~cm}}{\\sin 30^{\\circ}} \\\\\n& =\\frac{5000 \\times 10^{-8} \\mathrm{~cm}}{1 / 2}=10 \\times 10^{-5} \\mathrm{~cm}\n\\end{aligned}\n$$"
  }
}