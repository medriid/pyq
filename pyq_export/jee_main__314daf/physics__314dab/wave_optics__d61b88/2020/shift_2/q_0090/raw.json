  "correctValue": "9",
  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>=</mo><msub><mi mathvariant=\"normal\">I</mi><mn>0</mn></msub><msup><mi>cos</mi><mn>2</mn></msup><mfrac><mi mathvariant=\"normal\">&#981;</mi><mn>2</mn></mfrac></math></p></blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>kcos</mi><mn>2</mn></msup><mfenced><mrow><mfrac><mi mathvariant=\"normal\">&#960;</mi><mi mathvariant=\"normal\">&#955;</mi></mfrac><mo>&#215;</mo><mfrac><mi mathvariant=\"normal\">&#955;</mi><mn>6</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi mathvariant=\"normal\">k</mi><mo>&#160;</mo><msup><mi>cos</mi><mn>2</mn></msup><mfenced><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>6</mn></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">k</mi></mrow><mn>4</mn></mfrac><mo>=</mo><mfrac><mrow><mn>9</mn><mi mathvariant=\"normal\">k</mi></mrow><mn>12</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>9</mn></math></p>",
