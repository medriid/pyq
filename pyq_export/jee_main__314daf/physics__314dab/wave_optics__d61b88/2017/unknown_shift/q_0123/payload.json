  "solution": {
    "text": "For secondary minima&nbsp;<math><mi>d</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>=</mo><mi>n</mi><mi>&#955;</mi></math><br /><math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>=</mo><mfrac><mrow><mi>n</mi><mi>&#955;</mi></mrow><mrow><mn>d</mn></mrow></mfrac></math><br /><br />For second minima<br /><math><mi>n</mi><mo>=</mo><mn>2</mn></math><br /><math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#955;</mi></mrow><mrow><mn>d</mn></mrow></mfrac><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><msub><mrow><mi>&#952;</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi>D</mi></mrow></mfrac></math><br />For fourth minima <math><mi>n</mi><mo>=</mo><mn>4</mn></math><br /><math><msub><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>&#955;</mi></mrow><mrow><mn>d</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi>D</mi></mrow></mfrac></math><br /><br />Distance between both minima is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>x</mi><mn>2</mn></msub><mo>-</mo><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>&#955;</mi></mrow><mn>d</mn></mfrac><mo>-</mo><mfrac><mrow><mn>2</mn><mi>&#955;</mi></mrow><mn>d</mn></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#955;</mi></mrow><mn>d</mn></mfrac><mo>= 6 -</mo><mn>3 =3</mn><mo>&#160;</mo><mi>cm</mi></math><br /><br />Width of central maxima,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#955;</mi></mrow><mn>d</mn></mfrac><mo>=</mo><mn>3</mn><mi>&#160;</mi><mtext>c</mtext><mtext>m</mtext></math>"
  }
