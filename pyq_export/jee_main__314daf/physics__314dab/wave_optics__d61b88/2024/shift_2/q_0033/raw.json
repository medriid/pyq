  "question": {
    "text": "Two coherent monochromatic light beams of intensities I and $4 \\mathrm{I}$ are superimposed. The difference between maximum and minimum possible intensities in the resulting beam is $x \\mathrm{I}$. The value of $x$ is $_________.",
    "image": null
  },
  "options": [],
  "correctValue": "8",
  "solution": {
    "text": "$\\begin{aligned} & I_{\\max }=(\\sqrt{\\mathrm{I}}+\\sqrt{4 \\mathrm{I}})^2=9 \\mathrm{I} \\\\ & \\mathrm{I}_{\\min }=(\\sqrt{4 \\mathrm{I}}-\\sqrt{\\mathrm{I}})^2=\\mathrm{I} \\\\ & \\therefore \\mathrm{I}_{\\max }-\\mathrm{I}_{\\min }=8 \\mathrm{I}\\end{aligned}$",
    "image": null
  },
