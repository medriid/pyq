  "question": {
    "text": "In a Young's double slit experiment the intensity at a point where the path difference is $\\frac{\\lambda}{6}$ ($\\lambda$ being the wavelength of the light used) is $\\mathrm{I}$. If $\\mathrm{I}_0$ denotes the maximum intensity, $\\frac{\\mathrm{I}}{\\mathrm{I}_0}$ is equal to"
  },
  "options": [
    {
      "text": "\n$\\frac{1}{\\sqrt{2}}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\sqrt{3}}{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1 / 2$\n",
      "is_correct": false
    },
    {
      "text": "\n$3 / 4$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{I}}{\\mathrm{I}_{\\max }}=\\cos ^2\\left(\\frac{\\phi}{2}\\right)$"
  }
