  "question": {
    "text": "A mixture of light, consisting of wavelength $590 \\mathrm{~nm}$ and an unknown wavelength, illuminates Young's double slit and gives rise to two overlapping interference patterns on the screen. The central maximum of both lights coincide. Further, it is observed that the third bright fringe of known light coincides with the $4^{\\text {th }}$ bright fringe of the unknown light. From this data, the wavelength of the unknown light is",
    "image": null
  },
  "options": [
    {
      "id": "uza2d",
      "text": "\n$393.4 \\mathrm{~nm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iwasq",
      "text": "\n$885.0 \\mathrm{~nm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kWlqu",
      "text": "\n$442.5 \\mathrm{~nm}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "dxnbw",
      "text": "\n$776.8 \\mathrm{~nm}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& 3 \\lambda_1=4 \\lambda_2 \\\\\n& \\Rightarrow \\lambda_2=\\frac{3}{4} \\lambda_1=\\frac{3}{4} \\times 590=\\frac{1770}{4}=442.5 \\mathrm{~nm}\n\\end{aligned}\n$$",
    "image": null
  },
