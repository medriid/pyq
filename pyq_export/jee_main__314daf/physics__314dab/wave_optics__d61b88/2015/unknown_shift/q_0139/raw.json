      "image": null,
      "isCorrect": false
    },
    {
      "id": "rZyjI",
      "text": "<math><mfrac><mrow><mi>β</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "As <math><msub><mrow><mi>I</mi></mrow><mrow><mi>m</mi><mi>a</mi><mi>x</mi></mrow></msub><mo>=</mo><mn>4</mn><mi>I</mi></math><br /><br />Then <math><msub><mrow><mi>I</mi></mrow><mrow><mi>n</mi><mi>e</mi><mi>t</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><msub><mrow><mi>I</mi></mrow><mrow><mi>m</mi><mi>a</mi><mi>x</mi></mrow></msub><mo>=</mo><mn>2</mn><mi>I</mi></math><br /><br /><math><mo>&#8658;</mo><mn>2</mn><mi>I</mi><mo>=</mo><mn>2</mn><mi>I</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>c</mi><mi>o</mi><mi>s</mi><mi>&#981;</mi></mrow></mfenced></math><br /><br /><math><mo>&#8658;</mo><mn>1</mn><mo>+</mo><mi>c</mi><mi>o</mi><mi>s</mi><mi>&#981;</mi><mo>=</mo><mn>1</mn></math><br /><br /><math><mo>&#8658;</mo><mi>c</mi><mi>o</mi><mi>s</mi><mi>&#981;</mi><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8658;</mo><mi>&#981;</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi>&#160;</mi><mo>&#8230;</mo></math><br /><br /><math><mi>&#160;</mi><mi>&#981;</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><mrow><mi>&#955;</mi></mrow></mfrac><mi mathvariant=\"normal\">&#916;</mi><mi>x</mi></math><br /><br /><math><mo>&#8658;</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><mrow><mi>&#955;</mi></mrow></mfrac><mi mathvariant=\"normal\">&#916;</mi><mi>x</mi></math><br /><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">&#916;</mi><mi>x</mi><mo>=</mo><mfrac><mrow><mi>&#955;</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>3</mn><mi>&#955;</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>5</mn><mi>&#955;</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>,</mo><mi>&#160;</mi><mo>&#8230;</mo></math><br /><br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/90fea76d-bdc5-41bf-a3ec-03ee7371ecb3-image.png\" style=\"width: 200px; height: 240px;\" /><br /><br />Also path difference <math><mi mathvariant=\"normal\">&#916;</mi><mi>x</mi><mo>=</mo><mi>d</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952; </mi><mo>=</mo><mfrac><mrow><mi>&#955;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mrow></math><br /><br />At desired location<br /><br /><math><mo>&#8658;</mo><mfrac><mrow><mi>d</mi><mi>&#160;</mi><msub><mrow><mi>y</mi></mrow><mrow><mi>n</mi></mrow></msub></mrow><mrow><mi>D</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>&#955;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><msub><mrow><mi>y</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>&#955;</mi><mi>D</mi></mrow><mrow><mn>4</mn><mi>d</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>&#946;</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mi>&#160;</mi><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mo>&#8757;</mo><mi>&#946;</mi><mo>=</mo><mfrac><mrow><mi>&#955;</mi><mi>D</mi></mrow><mrow><mi>d</mi></mrow></mfrac></mrow></mfenced></math><br /><br /><math><mo>&#8658;</mo></math> Separation between central maxima and desired <math><mi>y</mi><mo>=</mo><mfrac><mrow><mi>&#946;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math>",
