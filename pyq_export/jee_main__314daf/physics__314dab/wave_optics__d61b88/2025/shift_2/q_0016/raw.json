  "question": {
    "text": "The width of one of the two slits in Young's double slit experiment is d while that of the other slit is $x \\mathrm{~d}$. If the ratio of the maximum to the minimum intensity in the interference pattern on the screen is $9: 4$ then what is the value of $x$ ?\n(Assume that the field strength varies according to the slit width.)",
    "image": null
  },
  "options": [
    {
      "id": "ZhMVt",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3IKvn",
      "text": "5",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "l0ltT",
      "text": "3",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rv8Mt",
      "text": "2",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{I} \\propto(\\text { width })^2 \\\\ & \\left(\\frac{\\sqrt{\\mathrm{I}_1}+\\sqrt{\\mathrm{I}_2}}{\\sqrt{\\mathrm{I}_1}-\\sqrt{\\mathrm{I}_2}}\\right)^2=\\frac{9}{4} \\\\ & \\frac{\\sqrt{\\mathrm{I}_1}+\\sqrt{\\mathrm{I}_2}}{\\sqrt{\\mathrm{I}_1}-\\sqrt{\\mathrm{I}_2}}=\\frac{3}{2} \\\\ & \\frac{(\\mathrm{x}+1) \\mathrm{d}}{(\\mathrm{x}-1) \\mathrm{d}}=\\frac{3}{2} \\\\ & \\Rightarrow 3 \\mathrm{x}-3=2 \\mathrm{x}+2 \\\\ & \\mathrm{x}=5\\end{aligned}$",
    "image": null
  },
