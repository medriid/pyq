  "question": {
    "text": "A monochromatic light of frequency $5 \\times 10^{14} \\mathrm{~Hz}$ travelling through air, is incident on a medium of refractive index ' 2 '. Wavelength of the refracted light will be :",
    "image": null
  },
  "options": [
    {
      "id": "0qDG7",
      "text": "$300\\mathrm{~nm}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fYjog",
      "text": "$600\\mathrm{~nm}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Q7Ojw",
      "text": "$400\\mathrm{~nm}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zc0a9",
      "text": "$500\\mathrm{~nm}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{f} \\lambda=\\mathrm{v} \\quad \\lambda_{\\text {medium }}=\\frac{\\lambda_{\\text {vacuum }}}{\\mu}$<br/>$\\lambda_{\\text {medium }} \\Rightarrow \\frac{3 \\times 10^8}{2 \\times 5 \\times 10^{14}} \\Rightarrow 0.3 \\times 10^{-6} \\Rightarrow 300 \\mathrm{~nm}$",
    "image": null
  },
