  "question": {
    "text": "In a Young's double slit experiment, the source is white light. One of the slits is covered by red filter and another by a green filter. In this case",
    "image": null
  },
  "options": [
    {
      "id": "HstUE",
      "text": "There shall be an interference pattern for red distinct from that for green.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Uk2Yq",
      "text": "There shall be no interference fringes.",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ANTQ5",
      "text": "There shall be alternate interference fringes of red and green.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tUVOv",
      "text": "There shall be an interference pattern, where each fringe's pattern center is green and outer edges is red.",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Different colours will have different fringe width. Within a few fringes of red, there will be several fringes of violet.<br/>Also, there will be overlapping of colours.",
    "image": null
  },
