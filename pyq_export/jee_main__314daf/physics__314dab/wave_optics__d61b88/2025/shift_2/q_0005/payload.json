  "question": {
    "text": "Two monochromatic light beams have intensities in the ratio 1:9. An interference pattern is obtained by these beams. The ratio of the intensities of maximum to minimum is"
  },
  "options": [
    {
      "text": "$8: 1$",
      "is_correct": false
    },
    {
      "text": "$9: 1$",
      "is_correct": false
    },
    {
      "text": "$3: 1$",
      "is_correct": false
    },
    {
      "text": "$4: 1$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{I_{\\max }}{I_{\\min }}=\\frac{\\left(\\sqrt{I_1}+\\sqrt{I_2}\\right)^2}{\\left(\\sqrt{I_1}-\\sqrt{I_2}\\right)^2} \\Rightarrow \\frac{(4)^2}{(2)^2} \\Rightarrow \\frac{16}{4}=4$"
  }
}