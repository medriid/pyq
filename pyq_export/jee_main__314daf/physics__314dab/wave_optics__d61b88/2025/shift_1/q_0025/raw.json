  "question": {
    "text": "The Young's double slit interference experiment is performed using light consisting of 480 nm and 600 nm wavelengths to form interference patterns. The least number of the bright fringes of 480 nm light that are required for the first coincidence with the bright fringes formed by 600 nm light is",
    "image": null
  },
  "options": [
    {
      "id": "mLoR1",
      "text": "$5$",
      "image": null,
      "isCorrect": true
    },
