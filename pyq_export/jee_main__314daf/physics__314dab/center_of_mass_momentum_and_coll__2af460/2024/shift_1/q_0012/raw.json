  "question": {
    "text": "Four particles $A, B, C, D$ of mass $\\frac{m}{2}, m, 2 m, 4 m$, have same momentum, respectively. The particle with maximum kinetic energy is :",
    "image": null
  },
  "options": [
    {
      "id": "B7YX1",
      "text": "$B$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "j9GKH",
      "text": "$A$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "WjDfW",
      "text": "$D$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5M21L",
      "text": "$C$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{KE}=\\frac{\\mathrm{p}^2}{2 \\mathrm{~m}}$<br />Same momentum, so less mass means more KE.\nSo $\\frac{\\mathrm{m}}{2}$ will have max. $\\mathrm{KE}$.",
    "image": null
  },
