  "question": {
    "text": "A player caught a cricket ball of mass $150 \\mathrm{~g}$ moving at a speed of $20 \\mathrm{~m} / \\mathrm{s}$. If the catching process is completed in $0.1 \\mathrm{~s}$, the magnitude of force exerted by the ball on the hand of the player is:",
    "image": null
  },
  "options": [
    {
      "id": "4NZjf",
      "text": "$3 \\mathrm{~N}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ShRkk",
      "text": "$300 \\mathrm{~N}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iA8ej",
      "text": "$150 \\mathrm{~N}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aX8bJ",
      "text": "$30 \\mathrm{~N}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{F}=\\frac{\\Delta \\mathrm{P}}{\\Delta \\mathrm{t}}=\\frac{\\mathrm{mv}-0}{0.1} \\\\ & =\\frac{150 \\times 10^{-3} \\times 20}{0.1}=30 \\mathrm{~N}\\end{aligned}$",
    "image": null
  },
