  "question": {
    "text": "Three bodies A, B and C have equal kinetic energies and their masses are $400 \\mathrm{~g}$. $1.2 \\mathrm{~kg}$ and $1.6 \\mathrm{~kg}$ respectively. The ratio of their linear momenta is :"
  },
  "options": [
    {
      "text": "$\\sqrt{2} ; \\sqrt{3} ; 1$",
      "is_correct": false
    },
    {
      "text": "$1: \\sqrt{3}: 2$",
      "is_correct": true
    },
    {
      "text": "$1: \\sqrt{3}: \\sqrt{2}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{3}: \\sqrt{2}: 1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{KE}=\\frac{\\mathrm{P}^2}{2 \\mathrm{~m}} \\\\ & \\mathrm{P} \\propto \\sqrt{\\mathrm{m}}\\end{aligned}$\nHence, $\\mathrm{P}_{\\mathrm{A}}: \\mathrm{P}_{\\mathrm{B}}: \\mathrm{P}_{\\mathrm{C}}$\n$=\\sqrt{400}: \\sqrt{1200}: \\sqrt{1600}=1: \\sqrt{3}: 2$"
  }
}