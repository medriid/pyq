  "question": {
    "text": "A body of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1000</mn><mo> </mo><mi>kg</mi></math> is moving horizontally with a velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo> </mo><mi mathvariant=\"normal\">m</mi><mo> </mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn><mo> </mo><mi>kg</mi></math> extra mass is added, the final velocity (in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">m</mi><mo> </mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>) is:",
    "image": null
  },
  "options": [
    {
      "id": "RGzfV",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "b3CJG",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WpUDn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math>",
      "image": null,
