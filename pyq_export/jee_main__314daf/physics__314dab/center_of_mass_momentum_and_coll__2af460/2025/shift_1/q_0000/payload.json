  "question": {
    "text": "A rod of length 5 L is bent right angle keeping one side length as 2 L.<br/><img src=\"assets\\qt0000_e579dddc6559.png\"/><br/>The position of the centre of mass of the system: (Consider $\\mathrm{L}=10 \\mathrm{~cm}$)"
  },
  "options": [
    {
      "text": "$2 \\hat{i}+3 \\hat{j}$",
      "is_correct": false
    },
    {
      "text": "$3 \\hat{i}+7 \\hat{\\mathrm{j}}$",
      "is_correct": false
    },
    {
      "text": "$5 \\hat{\\mathrm{i}}+8 \\hat{\\mathrm{j}}$",
      "is_correct": false
    },
    {
      "text": "$4 \\hat{i}+9 \\hat{j}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0000_1fc1a9cc9fee.png\"/><br/>$\\mathrm{x}_{\\mathrm{com}}=\\frac{2 \\mathrm{~m}(10)+3 \\mathrm{~m}(0)}{5 \\mathrm{~m}}=4 \\mathrm{~cm}$<br/>$\\mathrm{y}_{\\mathrm{com}}=\\frac{2 \\mathrm{~m}(0)+3 \\mathrm{~m}(15)}{5 \\mathrm{~m}}=9 \\mathrm{~cm}$<br/>$\\overrightarrow{\\mathrm{r}}_{\\mathrm{com}}=4 \\hat{\\mathrm{i}}+9 \\hat{\\mathrm{j}}$"
  }
}