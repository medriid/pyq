  "question": {
    "text": "A balloon and its content having mass $M$ is moving up with an acceleration ' $a$ '. The mass that must be released from the content so that the balloon starts moving up with an acceleration ' $3 a^{\\prime}$ will be\n(Take ' g ' as acceleration due to gravity)",
    "image": null
  },
  "options": [
    {
      "id": "IXM7Z",
      "text": "$\\frac{2 \\mathrm{Ma}}{3 \\mathrm{a}+\\mathrm{g}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ctYIa",
      "text": "$\\frac{3 \\mathrm{Ma}}{2 \\mathrm{a}-\\mathrm{g}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "i0MfC",
      "text": "$\\frac{3 \\mathrm{Ma}}{2 \\mathrm{a}+\\mathrm{g}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wmimA",
      "text": "$\\frac{2 \\mathrm{Ma}}{3 \\mathrm{a}-\\mathrm{g}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/pzfaRVzhOXPJGRDRlOOdi-JRXuf8-leiVkag2Uo_R60.original.fullsize.png\"><br>\n\n$\\begin{aligned}\n& F-m g=m a \\\\\n& F=m a+m g \\\\\n& F-(m-x) g=(m-x) 3 a\n\\end{aligned}$\n\nPut F\n$\\begin{aligned}\n& \\mathrm{Ma}+\\mathrm{mg}-\\mathrm{mg}+\\mathrm{xg}=3 \\mathrm{ma}-3 \\mathrm{xa} \\\\\n& \\mathrm{x}=\\frac{2 \\mathrm{ma}}{\\mathrm{~g}+3 \\mathrm{a}}\n\\end{aligned}$",
    "image": null
  },
