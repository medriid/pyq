  "question": {
    "text": "A bomb of mass $16 \\mathrm{~kg}$ at rest explodes into two pieces of masses of $4 \\mathrm{~kg}$ and $12 \\mathrm{~kg}$. The velocity of the $12 \\mathrm{~kg}$ mass is $4 \\mathrm{~ms}^{-1}$. The kinetic energy of the other mass is"
  },
  "options": [
    {
      "text": "\n$96 \\mathrm{~J}$\n",
      "is_correct": false
    },
    {
      "text": "\n$144 \\mathrm{~J}$\n",
      "is_correct": false
    },
    {
      "text": "\n$288 \\mathrm{~J}$\n",
      "is_correct": true
    },
    {
      "text": "\n$192 \\mathrm{~J}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$m_1 v_1=m_2 v_2$\n$\\mathrm{KE}=\\frac{1}{2} \\mathrm{~m}_2 \\mathrm{v}_2^2=\\frac{1}{2} \\times 4 \\times 144=288 \\mathrm{~J}$"
  }
}