  "question": {
    "text": "Consider a two particle system with particles having masses $m_1$ and $m_2$. If the first particle is pushed towards the centre of mass through a distance $d$, by what distance should the second particle be moved, so as to keep the centre of mass at the same position?",
    "image": null
  },
  "options": [
    {
      "id": "vHMdm",
      "text": "\n$\\mathrm{d}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "32HDl",
      "text": "\n$\\frac{m_2}{m_1} \\mathrm{~d}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AG1WG",
      "text": "\n$\\frac{m_1}{m_1+m_2} d$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NBpYR",
      "text": "\n$\\frac{\\mathrm{m}_1}{\\mathrm{~m}_2} \\mathrm{~d}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$m_1 d+m_2 x=0$\n$x=\\frac{m_1 d}{m_2}$",
    "image": null
  },
