  "solution": {
    "text": "<img src=\"assets\\st0092_88565a02ca90.png\" /> <br/><br/>Using relative velocity<br/><br/> <img src=\"assets\\st0092_b42dd52923cd.png\" /> <br/><br/> <math><msub><mrow><mi>a</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">l</mi></mrow></msub><mo>=</mo><mn>0</mn></math>  <br/><br/> <math><msub><mrow><mi>v</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">l</mi></mrow></msub><mo>=</mo><mn>100</mn></math> <br/><br/>Time  <math><mi>t</mi></math>  for collision,<br/><br/> <math><mn>100</mn><mo>=</mo><msub><mrow><mi>v</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">l</mi></mrow></msub><mo>×</mo><mi>t</mi></math> <br/><br/> <math><mi>t</mi><mo>=</mo><mfrac><mrow><mn>100</mn></mrow><mrow><mn>100</mn></mrow></mfrac><mo>=</mo><mn>1</mn><mtext> </mtext><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">c</mi></math> <br/><br/> <math><msub><mrow><mi>v</mi></mrow><mrow><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">t</mi></mrow></msub><mo>=</mo><mn>100</mn><mo>-</mo><mn>1</mn><mo>×</mo><mn>10</mn><mo>=</mo><mn>90</mn><mrow><mrow><mi>m</mi></mrow><mo>/</mo><mrow><mi>s</mi></mrow></mrow></math> <br/><br/> <math><msub><mrow><mi>v</mi></mrow><mrow><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi></mrow></msub><mo>=</mo><mn>10</mn><mo>×</mo><mn>1</mn><mo>=</mo><mn>10</mn><mrow><mrow><mi>m</mi></mrow><mo>/</mo><mrow><mi>s</mi></mrow></mrow></math> <br/><br/> <math><mi>S</mi><mo>=</mo><mn>100</mn><mo>×</mo><mn>1</mn><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>×</mo><mn>10</mn><mo>×</mo><mn>1</mn><mo>=</mo><mn>95</mn><mtext> </mtext><mi>m</mi></math> <br/><br/> <img src=\"assets\\st0092_77b661622848.png\" /> <br/><br/> <math><msub><mrow><mi>P</mi></mrow><mrow><mi>i</mi></mrow></msub><mo>=</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>f</mi></mrow></msub></math>  <br/><br/> <math><mo>⇒</mo><mn>90</mn><mo>×</mo><mn>0.02</mn><mo>-</mo><mn>10</mn><mo>×</mo><mn>0.03</mn><mo>=</mo><mn>0.05</mn><mi>V</mi></math> <br/><br/> <math><mi>V</mi><mo>=</mo><mn>30</mn><mrow><mrow><mi>m</mi></mrow><mo>/</mo><mrow><mi>s</mi></mrow></mrow><mo>⇒</mo><mi>h</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi>g</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>900</mn></mrow><mrow><mn>20</mn></mrow></mfrac><mo>=</mo><mn>45</mn><mtext> </mtext><mi>m</mi></math> <br/><br/>So from top of building <br/><br/> <math><mn>45</mn><mo>-</mo><mn>5</mn><mo>=</mo><mn>40</mn><mtext> </mtext><mi>m</mi></math>"
