    "text": "<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/hbvkbwvhe.PNG\" style=\"width: 250px; height: 55px;\" /><br /><br /><math><mi>m</mi><mi>v</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mi>m</mi><mo>+</mo><mi>m</mi></mrow></mfenced><msup><mrow><mi>v</mi></mrow><mrow><mi>′</mi></mrow></msup></math><br /><br /><math><mfenced separators=\"|\"><mrow><mi>m</mi><mo>+</mo><mi>m</mi></mrow></mfenced><msup><mrow><mi>v</mi></mrow><mrow><mi>′</mi></mrow></msup><mo>=</mo><mfenced separators=\"|\"><mrow><mi>m</mi><mo>+</mo><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfenced><msub><mrow><mi>v</mi></mrow><mrow><mi>f</mi></mrow></msub></math><br /><br /><math><mo>∴</mo></math> final velocity <math><msub><mrow><mi>v</mi></mrow><mrow><mi>f</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>m</mi></mrow><mrow><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfrac><mi>v</mi></math><br /><br />Initial energy <math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br />Final energy <math><mi>&nbsp;</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfenced><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>m</mi><mi>v</mi></mrow><mrow><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br />Given that <math><mfrac><mrow><mn>5</mn></mrow><mrow><mn>6</mn></mrow></mfrac><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfenced><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>m</mi><mi>v</mi></mrow><mrow><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>12</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfrac><mrow><msup><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></mrow></mfenced></mrow></mfrac></math><br /><br /><math><mn>6</mn><mi>m</mi><mo>=</mo><mn>2</mn><mi>m</mi><mo>+</mo><mi>M</mi></math><br /><br /><math><mfrac><mrow><mi>M</mi></mrow><mrow><mi>m</mi></mrow></mfrac><mo>=</mo><mn>4</mn></math>",
