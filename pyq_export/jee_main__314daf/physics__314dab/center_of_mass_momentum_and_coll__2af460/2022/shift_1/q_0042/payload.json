  "question": {
    "text": "What percentage of kinetic energy of a moving particle is transferred to a stationary particle when it strikes the stationary particle of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math> times its mass?<br />(Assume the collision to be head-on elastic collision)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>.</mo><mn>0</mn><mo>%</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>66</mn><mo>.</mo><mn>6</mn><mo>%</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>55</mn><mo>.</mo><mn>6</mn><mo>%</mo></math>",
