  "question": {
    "text": "A mass ' $m$ ' moves with a velocity $v$ and collides inelastically with another identical mass. After collision the $1^{\\text {st }}$ mass moves with velocity $v / \\sqrt{3}$ in a direction perpendicular to the initial direction of motion. Find the speed of the $2^{\\text {nd }}$ mass after collision\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/8SFgHPc0iyWjcnrmDF0Yq3JV3tYAUDCKjrpw2uhz-30.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "OEI5t",
      "text": "\nv\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "y4HGs",
      "text": "\n$\\sqrt{3} v$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VS4uO",
      "text": "\n$2 v / \\sqrt{3}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "u7FLO",
      "text": "\n$v / \\sqrt{3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/7EuTKO_lyh8nsqXubDCcZQTJCdnepsrQU-vXu49PLf0.original.fullsize.png\"><br>\n$m v=m v_1 \\cos \\theta$\n$0=\\frac{m v}{\\sqrt{3}}-m v_1 \\sin \\theta$\n$\\therefore v_1=\\frac{2}{\\sqrt{3}} v$",
    "image": null
  },
