  "question": {
    "text": "A block of mass $0.50 \\mathrm{~kg}$ is moving with a speed of $2.00 \\mathrm{~m} / \\mathrm{s}$ on a smooth surface. It strikes another mass of $1.00 \\mathrm{~kg}$ and then they move together as a single body. The energy loss during the collision is",
    "image": null
  },
  "options": [
    {
      "id": "pektR",
      "text": "\n$0.16 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "57z3Y",
      "text": "\n$1.00 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6CPiT",
      "text": "\n$0.67 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Nz3ju",
      "text": "\n$0.34 \\mathrm{~J}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& m_1 u_1+m_2 u_2=\\left(m_1+m_2\\right) v \\\\\n& v=2 / 3 \\mathrm{~m} / \\mathrm{s} \\\\\n& \\text { Energy loss }=\\frac{1}{2}(0.5) \\times(2)^2-\\frac{1}{2}(1.5) \\times\\left(\\frac{2}{3}\\right)^2=0.67 \\mathrm{~J}\n\\end{aligned}\n$$",
    "image": null
  },
