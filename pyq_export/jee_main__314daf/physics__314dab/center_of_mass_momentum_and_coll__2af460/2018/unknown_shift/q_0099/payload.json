    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>89</mn><mo>,</mo><mo>&#160;</mo><mn>0</mn><mo>.</mo><mn>28</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>28</mn><mo>,</mo><mo>&#160;</mo><mn>0</mn><mo>.</mo><mn>89</mn></math>",
      "is_correct": false
