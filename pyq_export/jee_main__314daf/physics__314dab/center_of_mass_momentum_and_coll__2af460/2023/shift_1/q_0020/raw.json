  "question": {
    "text": "<p>Two bodies are having kinetic energies in the ratio <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><mo>:</mo><mn>9</mn><mo>.</mo></math> If they have same linear momentum, the ratio of their masses respectively is:</p>",
    "image": null
  },
  "options": [
    {
      "id": "67SKf",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>:</mo><mn>4</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CixHg",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>:</mo><mn>16</mn></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XVrnw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><mo>:</mo><mn>9</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "T9YVL",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>:</mo><mn>3</mn></math>",
      "image": null,
      "isCorrect": false
