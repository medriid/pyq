    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></math>",
      "is_correct": true
