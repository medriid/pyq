    "text": "<math><mi>U</mi><mo>=</mo><mo>-</mo><mover accent=\"true\"><mrow><mi>P</mi></mrow><mo>→</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>B</mi></mrow><mo>-</mo></mover></math> <br/><br/>         <math><mi>F</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mo>∂</mo><mi>U</mi></mrow><mrow><mo>∂</mo><mi>r</mi></mrow></mfrac><mo>=</mo><mi>P</mi><mfrac><mrow><mi>d</mi><mi>B</mi></mrow><mrow><mi>d</mi><mi>r</mi></mrow></mfrac></math> <br/><br/>         <math><mi>F</mi><mo>=</mo><msub><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>π</mi><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>×</mo><mfrac><mrow><mi>d</mi></mrow><mrow><mi>d</mi><mi>r</mi></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><msub><mrow><mi>i</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>2</mn><mi>π</mi><mi>r</mi></mrow></mfrac></mrow></mfenced></math> <br/><br/>         <math><mi>F</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>i</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>π</mi></mrow><mrow><mn>0</mn></mrow></msub><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math> <br/><br/>         <math><mi>F</mi><mo>∝</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>a</mi></mrow><mrow><mi>r</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math> <br/><br/>        As  <math><mi>r</mi><mo>=</mo><mi>d</mi></math> <br/><br/>         <math><mi>F</mi><mo>∝</mo><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>d</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>",
