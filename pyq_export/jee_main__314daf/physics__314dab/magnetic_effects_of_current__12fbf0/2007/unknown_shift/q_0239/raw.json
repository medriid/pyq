  "question": {
    "text": "A charged particle with charge $\\mathrm{q}$ enters a region of constant, uniform and mutually orthogonal fields $\\mathrm{\\vec{E}}$ and $\\mathrm{\\vec{B}}$ with a velocity $\\mathrm{\\vec{v}}$ perpendicular to both $\\mathrm{\\vec{E}}$ and $\\mathrm{\\vec{B}}$, and comes out without any change in magnitude or direction of $\\mathrm{\\vec{v}}$. Then",
    "image": null
  },
  "options": [
    {
      "id": "kHkWg",
      "text": "\n$\\mathrm{\\vec{v}=\\vec{E} \\times \\vec{B} / B^2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mnmBR",
      "text": "\n$\\mathrm{\\vec{v}=\\vec{B} \\times \\vec{E} / B^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RfWfp",
      "text": "\n$\\mathrm{\\vec{v}=\\vec{E} \\times \\vec{B} / E^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "r9c7o",
      "text": "\n$\\overrightarrow{\\mathrm{v}}=\\overrightarrow{\\mathrm{B}} \\times \\overrightarrow{\\mathrm{E}} / \\mathrm{E}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\overrightarrow{\\mathrm{v}} \\times \\overrightarrow{\\mathrm{B}}=-\\overrightarrow{\\mathrm{E}}$",
    "image": null
  },
