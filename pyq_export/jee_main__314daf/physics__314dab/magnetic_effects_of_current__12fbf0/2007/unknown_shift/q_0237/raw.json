  "question": {
    "text": "Two identical conducting wires $\\mathrm{A O B}$ and $\\mathrm{C O D}$ are placed at right angles to each other. The wire $\\mathrm{AOB}$ carries an electric current $\\mathrm{I_1}$ and $\\mathrm{COD}$ carries a current $\\mathrm{I_2}$. The magnetic field on a point lying at a distance ' $\\mathrm{d}$ ' from $\\mathrm{O}$, in a direction perpendicular to the plane of the wires $\\mathrm{A O B}$ and $\\mathrm{C O D}$, will be given by",
    "image": null
  },
  "options": [
    {
      "id": "dlvLF",
      "text": "\n$\\frac{\\mu_0}{2 \\pi}\\left(\\frac{\\mathrm{I}_1+\\mathrm{I}_2}{d}\\right)^{1 / 2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8SSAM",
      "text": "\n$\\frac{\\mu_0}{2 \\pi \\mathrm{d}}\\left(\\mathrm{I}_1^2+\\mathrm{I}_2^2\\right)^{1 / 2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OlQLI",
      "text": "\n$\\frac{\\mu_0}{2 \\pi d}\\left(\\mathrm{I}_1+\\mathrm{I}_2\\right)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Hxn9N",
      "text": "\n$\\frac{\\mu_0}{2 \\pi d}\\left(\\mathrm{I}_1^2+\\mathrm{I}_2^2\\right)$",
      "image": null,
