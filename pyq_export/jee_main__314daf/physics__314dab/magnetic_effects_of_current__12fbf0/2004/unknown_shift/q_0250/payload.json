  "question": {
    "text": "A long wire carries a steady current. It is bent into a circle of one turn and the magnetic field at the centre of the coil is $B$. It is then bent into a circular loop of $n$ turns. The magnetic field at the centre of the coil will be"
  },
  "options": [
    {
      "text": "\n$\\mathrm{nB}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{n}^2 \\mathrm{~B}$\n",
      "is_correct": true
    },
    {
      "text": "\n$2 \\mathrm{nB}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 n^2 B$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$B^{\\prime}=\\frac{\\pi \\mu_0 I}{2 r^{\\prime}}=n^2 \\frac{\\mu_0 \\pi \\pi}{\\ell}=n^2 B$."
  }
