  "question": {
    "text": "A long solenoid has 200 turns per $\\mathrm{cm}$ and carries a current $\\mathrm{i}$. The magnetic field at its centre is $6.28 \\times 10^{-2}$ Weber $/ \\mathrm{m}^2$. Another long solenoid has 100 turns per $\\mathrm{cm}$ and it carries a current $\\mathrm{i} / 3$. The value of the magnetic field at its centre is",
    "image": null
  },
  "options": [
    {
      "id": "ad9jb",
      "text": "\n$1.05 \\times 10^{-4}$ Weber/m\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yaKDw",
      "text": "\n$1.05 \\times 10^{-2}$ Weber $/ \\mathrm{m}^2$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "VF9j6",
      "text": "\n$1.05 \\times 10^{-5} \\mathrm{Weber} / \\mathrm{m}^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bW1Hc",
      "text": "\n$1.05 \\times 10^{-3} \\mathrm{Weber} / \\mathrm{m}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$B_2=\\frac{B_1 n_2 i_2}{n_1 i_1}=\\frac{\\left(6.28 \\times 10^{-2}\\right)(100 \\times i / 3)}{200(i)}=1.05 \\times 10^{-2} \\mathrm{~W} / \\mathrm{m}^2$",
    "image": null
  },
