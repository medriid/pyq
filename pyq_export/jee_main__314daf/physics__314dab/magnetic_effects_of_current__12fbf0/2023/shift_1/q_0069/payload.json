  "question": {
    "text": "<p>Find the magnetic field at the point P in figure. The curved portion is a semicircle connected to two long straight wires.</p><p style=\"text-align: justify;\"><img alt=\"\" src=\"assets\\qt0069_95cad51de53d.png\" style=\"width: 184px; height: 220px;\" /></p>"
  },
  "options": [
