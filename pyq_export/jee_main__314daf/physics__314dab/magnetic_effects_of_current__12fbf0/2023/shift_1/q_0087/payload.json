  "question": {
    "text": "<p>The magnitude of magnetic induction at mid-point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi></math> due to current arrangement as shown in figure&nbsp;will be</p><p><img src=\"assets\\qt0087_d133dcf5fd24.png\" style=\"width: 300px; height: 171px;\" />.</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#956;</mi><mn>0</mn></msub><mi>I</mi></mrow><mrow><mn>2</mn><mi>&#960;a</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn></math>",
      "is_correct": false
