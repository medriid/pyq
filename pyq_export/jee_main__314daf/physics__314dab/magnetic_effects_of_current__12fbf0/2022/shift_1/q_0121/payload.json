      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mn>2</mn><msqrt><mn>5</mn></msqrt></mfrac></mfenced><mn>3</mn></msup><mo>&#160;</mo><mi mathvariant=\"normal\">B</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mn>2</mn><msqrt><mn>3</mn></msqrt></mfrac></mfenced><mn>3</mn></msup><mo>&#160;</mo><mi mathvariant=\"normal\">B</mi></math>",
