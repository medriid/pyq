  "question": {
    "text": "<p>An infinitely long hollow conducting cylinder with radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>&nbsp;carries a uniform current along its surface.</p><p>Choose the correct representation of magnetic field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>B</mi></mfenced></math>as a function of radial distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>r</mi></mfenced></math>&nbsp;from the axis of cylinder.</p>",
    "image": null
  },
