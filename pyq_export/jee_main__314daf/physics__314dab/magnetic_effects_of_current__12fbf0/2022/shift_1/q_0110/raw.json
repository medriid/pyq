      "isCorrect": false,
      "image": null
    },
    {
      "id": "GQuTE",
      "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/32a889d5-12d2-4b67-aaa6-463a46113822-image.png\" style=\"width: 200px; height: 137px;\" />",
