  "question": {
    "text": "<p>A wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>X</mi></math> of length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>&nbsp;</mo><mi>cm</mi></math> carrying a current of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">A</mi></math> is placed parallel to a long wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math> of length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi></math>. The wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math> carries a current of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">A</mi></math>. The distance between two wires is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&nbsp;</mo><mi>cm</mi></math> and currents flow in the same direction. The force acting on the wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math> is :</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/7a56d363-8e4e-4d66-abe5-8b334a16f25d-image.png\" style=\"width: 193px; height: 200px;\" />​​​​​​​</p>",
    "image": null
  },
  "options": [
    {
      "id": "ybuGy",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math> directed towards wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>X</mi></math>.",
      "isCorrect": true,
