  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "A proton, a deuteron and an <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>-particle with same kinetic energy enter into a uniform magnetic field at right angle to magnetic field. The ratio of the radii of their respective circular paths is :",
    "image": null
  },
  "options": [
    {
      "id": "ra3fK",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><msqrt><mn>2</mn></msqrt><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><msqrt><mn>2</mn></msqrt></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "uGjES",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><msqrt><mn>2</mn></msqrt><mo>:</mo><mn>1</mn></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "iTMPz",
      "text": "<math><msqrt><mn>2</mn></msqrt><mi>&#160;</mi><mo>:</mo><mn>1</mn><mi>&#160;</mi><mo>:</mo><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
