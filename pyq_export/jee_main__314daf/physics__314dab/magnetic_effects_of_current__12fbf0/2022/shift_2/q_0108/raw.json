    },
    {
      "id": "9HEYD",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>4</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "PSoCX",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>4</mn></math>",
