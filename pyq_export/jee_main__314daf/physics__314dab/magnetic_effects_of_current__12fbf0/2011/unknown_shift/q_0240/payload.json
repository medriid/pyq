  "question": {
    "text": "A current I flows in an infinitely long wire with cross section in the form of a semicircular ring of radius $\\mathrm{R}$. The magnitude of the magnetic induction along its axis is"
  },
  "options": [
    {
      "text": "\n$\\frac{\\mu_0 I}{2 \\pi^2 R}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mu_0 I}{2 \\pi R}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mu_0 I}{4 \\pi^2 R}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mu_0 l}{\\pi^2 R}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{d} \\overrightarrow{\\mathrm{B}}=\\frac{\\mu_0 \\mathrm{di}}{2 \\pi \\mathrm{R}}[-\\cos \\theta \\hat{\\mathbf{i}}-\\sin \\theta \\hat{\\mathbf{j}}]$\n$\\mathrm{di}=\\frac{\\mathrm{T}}{\\pi \\mathrm{R}} \\mathrm{Rd} \\theta$\n$=\\frac{\\mathrm{I}}{\\pi} \\mathrm{d} \\theta$\n$\\mathrm{d} \\overrightarrow{\\mathrm{B}}=\\frac{\\mu_0 \\mathrm{I}}{2 \\pi^2 \\mathrm{R}}(-\\cos \\theta \\hat{\\mathrm{i}}-\\sin \\theta \\hat{\\mathrm{j}})$\n<img src=\"assets\\st0240_2e73c2eb3036.png\"><br>\n$\\vec{B}=-\\frac{\\mu_0 I}{\\pi^2 R} \\hat{j}$"
  }
