  "question": {
    "text": "A current $i$ is flowing in a straight conductor of length $L$. The magnetic induction at a point on its axis at a distance $\\frac{L}{4}$ from its centre will be :",
    "image": null
  },
  "options": [
    {
      "id": "M2V2M",
      "text": "\nZero\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zkVIK",
      "text": "\n$\\frac{\\mu_0 i}{2 \\pi L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7dys6",
      "text": "\n$\\frac{\\mu_0 i}{\\sqrt{2} L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "utRbf",
      "text": "\n$\\frac{4 \\mu_0 i}{\\sqrt{5} \\pi L}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Magnetic field at any point lies on axial position of current carrying conductor $\\mathrm{B}=0$",
    "image": null
  },
