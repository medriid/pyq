  "question": {
    "text": "An electric current is flowing through a circular coil of radius $\\mathrm{R}$. The ratio of the magnetic field at the centre of the coil and that at a distance $2 \\sqrt{2} R$ from the centre of the coil and on its axis is :",
    "image": null
  },
  "options": [
    {
      "id": "tROv4",
      "text": "\n$2 \\sqrt{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CaQFM",
      "text": "\n27\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GIyqb",
      "text": "\n36\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "IL72X",
      "text": "\n8",
      "image": null,
      "isCorrect": false
    }
