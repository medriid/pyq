  "question": {
    "text": "A horizontal overhead power line is at a height of $4 \\mathrm{~m}$ from the ground and carries a current of $100 \\mathrm{~A}$ from east to west. The magnetic field directly below it on the ground is $\\left(\\mu_0=4 \\pi \\times 10^{-7} \\mathrm{~T} \\mathrm{~m} \\mathrm{~A}^{-1}\\right)$"
  },
  "options": [
    {
      "text": "\n$2.5 \\times 10^{-7} \\mathrm{~T}$ southward\n",
      "is_correct": false
    },
    {
      "text": "\n$5 \\times 10^{-6} \\mathrm{~T}$ northward\n",
      "is_correct": false
    },
    {
      "text": "\n$5 \\times 10^{-6}$ T southward\n",
      "is_correct": true
    },
    {
      "text": "\n$2.5 \\times 10^{-7}$ northward",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\nB=\\frac{\\mu_0}{2 \\pi} \\frac{i}{R}=\\frac{4 \\pi \\times 10^{-7}}{2 \\pi} \\times \\frac{100}{4}=5 \\times 10^{-6} \\mathrm{~T} \\text { southward }\n$$"
  }
}