  "question": {
    "text": "If in a circular coil $A$ of radius $R$, current I is flowing and in another coil $B$ of radius $2 R$ a current $2 \\mathrm{l}$ is flowing, then the ratio of the magnetic fields $\\mathrm{B}_{\\mathrm{A}}$ and $\\mathrm{B}_{\\mathrm{B}}$, produced by them will be",
    "image": null
  },
  "options": [
    {
      "id": "cRZ1J",
      "text": "\n1\n",
      "image": null,
      "isCorrect": true
