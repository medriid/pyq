    {
      "id": "FSBLG",
      "text": "<math><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">π</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>8</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rsqxi",
      "text": "<math><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">π</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>16</mn><msqrt><mn>2</mn></msqrt></mrow></mfrac></math>",
      "image": null,
