      "image": null,
      "isCorrect": false
    },
    {
      "id": "DmHkC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><msub><mi>R</mi><mn>1</mn></msub><msub><mi>R</mi><mn>2</mn></msub></mfrac></mfenced><mn>2</mn></msup></math>",
      "image": null,
      "isCorrect": true
    },
