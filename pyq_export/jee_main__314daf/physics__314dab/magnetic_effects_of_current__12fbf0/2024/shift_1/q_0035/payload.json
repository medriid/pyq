  "question": {
    "text": "In a co-axial straight cable, the central conductor and the outer conductor carry equal currents in opposite directions. The magnetic field is zero :"
  },
  "options": [
    {
      "text": "outside the cable",
      "is_correct": true
    },
    {
      "text": "inside the outer conductor",
      "is_correct": false
    },
    {
      "text": "inside the inner conductor",
      "is_correct": false
    },
    {
      "text": "in between the two conductors",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0035_983db4211978.png\"><br />$\\oint \\overrightarrow{\\mathrm{B}} \\cdot \\mathrm{d} \\vec{\\ell}=\\mu_0 \\mathrm{i}_{\\mathrm{enc}}=0$\n$\\therefore \\mathrm{B}=0$ outside the cable"
  }
