  "question": {
    "text": "The magnitude of the magnetic field $(B)$ due to loop $A B C D$ at the origin $(O)$ is"
  },
  "options": [
    {
      "text": "\nzero\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mu_0(b-a)}{24 a b}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{\\mu_0 \\mathrm{I}}{4 \\pi}\\left[\\frac{b-a}{a b}\\right]$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mu_o \\mid}{4 \\pi}\\left[2(b-a)+\\frac{\\pi}{3}(a+b)\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Net magnetic field due to loop $A B C D$ at $O$ is\n$$\n\\begin{aligned}\n& B=B_{A B}+B_{B C}+B_{C D}+B_{D A} \\\\\n& =0+\\frac{\\mu_o I}{4 \\pi a} \\times \\frac{\\pi}{6}+0-\\frac{\\mu_o I}{4 \\pi b} \\times \\frac{\\pi}{6}=\\frac{\\mu_o I}{24 a}-\\frac{\\mu_o I}{24 b}=\\frac{\\mu_o I}{24 a b}(b-a)\n\\end{aligned}\n$$\n<img src=\"assets\\st0243_4e12ef88a015.png\"><br>"
  }
}