    {
      "text": "<math><mfrac><mrow><mi>I</mi><mi>B</mi><mi>R</mi></mrow><mrow><mn>2</mn><mi>s</mi><mi>i</mi><mi>n</mi><msub><mrow><mi>θ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>I</mi><mi>B</mi><mi>R</mi><msub><mrow><mi>θ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi>s</mi><mi>i</mi><mi>n</mi><msub><mrow><mi>θ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
