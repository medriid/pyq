  "question": {
    "text": "A coil having <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi></math> turns is wound tightly in the form of a spiral with inner and outer radii <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math>&nbsp;respectively. Find the magnetic field at centre, when a current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi></math> passes through coil :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#956;</mi><mn>0</mn></msub><mi>I</mi></mrow><mn>8</mn></mfrac><mfenced open=\"[\" close=\"]\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfrac></mfenced></math>",
      "is_correct": false
