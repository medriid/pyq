    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#956;</mi><mn>0</mn></msub><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>4</mn><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>-</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo></mrow></mfrac><mfenced open=\"[\" close=\"]\"><mrow><mfrac><mn>1</mn><mi mathvariant=\"normal\">a</mi></mfrac><mo>-</mo><mfrac><mn>1</mn><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">b</mi></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": false
