  "question": {
    "text": "Let $B_1$ be the magnitude of magnetic field at center of a circular coil of radius $R$ carrying current $I$. Let $B_2$ be the magnitude of magnetic field at an axial distance ' $x$ ' from the center. For $x: R=3: 4, \\frac{B_2}{B_1}$ is :"
  },
  "options": [
    {
      "text": "$4: 5$",
      "is_correct": false
    },
    {
      "text": "$16: 25$",
      "is_correct": false
    },
    {
      "text": "$64: 125$",
      "is_correct": true
    },
    {
      "text": "$25: 16$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0017_e43deb65269a.png\"/><br/>$\\begin{aligned} & \\mathrm{B}_1=\\frac{\\mu_0 \\mathrm{i}}{2 \\mathrm{R}} \\qquad \\mathrm{B}_2=\\mathrm{B}_1 \\sin ^3 \\theta \\\\ & \\therefore \\frac{\\mathrm{~B}_2}{\\mathrm{~B}_1}=\\sin ^3 \\theta=\\left(\\frac{4}{5}\\right)^3=\\frac{64}{125}\\end{aligned}$"
  }
}