  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/RRz7Q_4AJZM3z8mNQUJMtSembhHWyK9nSvaWONjGWW4.original.fullsize.png\"/><br/>$\\begin{aligned} & \\mathrm{B}_1=\\frac{\\mu_0 \\mathrm{i}}{2 \\mathrm{R}} \\qquad \\mathrm{B}_2=\\mathrm{B}_1 \\sin ^3 \\theta \\\\ & \\therefore \\frac{\\mathrm{~B}_2}{\\mathrm{~B}_1}=\\sin ^3 \\theta=\\left(\\frac{4}{5}\\right)^3=\\frac{64}{125}\\end{aligned}$",
    "image": null
