  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0010_f35014776017.png\"/><br/>$\\frac{\\mathrm{mv}^2}{\\mathrm{r}}=\\mathrm{qvB}$<br/>$\\mathrm{mv}=\\mathrm{qBr}$<br/>$\\mathrm{E}=\\frac{1}{2} \\mathrm{mv}^2$<br/>$\\mathrm{E}=\\frac{1}{2} \\mathrm{~m}\\left(\\frac{\\mathrm{q}^2 \\mathrm{~B}^2 r^2}{\\mathrm{~m}^2}\\right)=\\frac{\\mathrm{q}^2 \\mathrm{~B}^2 \\mathrm{r}^2}{2 \\mathrm{~m}}$<br/>$\\mathrm{E}=\\left(\\frac{\\mathrm{q}^2 \\mathrm{~B}^2}{2 \\mathrm{~m}}\\right) \\mathrm{r}^2$<br/>$r^2 \\propto E$<img src=\"assets\\st0010_f75b71838ee1.png\"/>"
  }
}