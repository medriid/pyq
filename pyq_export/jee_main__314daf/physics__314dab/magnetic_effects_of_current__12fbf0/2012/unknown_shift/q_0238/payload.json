  "question": {
    "text": "Proton, Deuteron and alpha particle of the same kinetic energy are moving in circular trajectories in a constant magnetic field. The radii of proton, deuteron and alpha particle are respectively $r_p, r_d$ and $r_\\alpha$. Which one of the following relations is correct?"
  },
  "options": [
    {
      "text": "\n$r_\\alpha=r_p=r_d$\n",
      "is_correct": false
    },
    {
      "text": "\n$r_\\alpha=r_p < r_d$",
      "is_correct": true
    },
    {
      "text": "\n$r_\\alpha>r_d>r_p$\n",
      "is_correct": false
    },
    {
      "text": "\n$r_\\alpha=r_d>r_p$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$r=\\frac{\\sqrt{2 m K}}{B q}$\n$r \\propto \\frac{\\sqrt{m}}{q}$\n$r_\\alpha=r_p < r_d$"
  }
