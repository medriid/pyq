  "question": {
    "text": "The magnetic force acting on charged particle of charge $2 \\mu \\mathrm{C}$ in magnetic field of $2 T$ acting in $y-$ direction, when the particle velocity is $(2 \\hat{i}+3 \\hat{j}) \\times 10^6 \\mathrm{~ms}^{-1}$ is"
  },
  "options": [
    {
      "text": "\n$8 \\mathrm{~N}$ in z-direction\n",
      "is_correct": true
    },
    {
      "text": "\n$8 \\mathrm{~N}$ in y-direction\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\mathrm{~N}$ in y-direction\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\mathrm{~N}$ in z-direction",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { } \\vec{F}=q(\\vec{V} \\times \\vec{B}) \\\\\n& =2 \\times 10^{-6}\\left[(2 \\hat{i}+3 \\hat{j}) \\times 10^6 \\times 2 \\hat{j}\\right] \\\\\n&\n\\end{aligned}\n$$\n\n$=2 \\times 4 \\hat{k}=8 N$ in Z-direction."
  }
}