  "question": {
    "text": "A charged particle of mass $\\mathrm{m}$ and charge $q$ travels on a circular path of radius $r$ that is perpendicular to a magnetic field $\\mathrm{B}$. The time taken by the particle to complete one revolution is",
    "image": null
  },
  "options": [
    {
      "id": "Pxses",
      "text": "\n$\\frac{2 \\pi \\mathrm{mq}}{\\mathrm{B}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W99vI",
      "text": "\n$\\frac{2 \\pi q^2 B}{m}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1slyn",
      "text": "\n$\\frac{2 \\pi q B}{m}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xYm0v",
      "text": "\n$\\frac{2 \\pi m}{q B}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{m} \\omega^2 \\mathrm{r}=\\mathrm{Bq} \\omega \\mathrm{r}$\n$\\omega=\\mathrm{Bq} / \\mathrm{m}$\n$\\mathrm{T}=\\frac{2 \\pi \\mathrm{m}}{\\mathrm{qB}}$",
    "image": null
  },
