      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mfenced><mrow><mi>G</mi><mo>+</mo><mi>S</mi></mrow></mfenced><mrow><mi>n</mi><mi>K</mi><mi>S</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>n</mi><mi>K</mi><mi>S</mi></mrow><mfenced><mrow><mi>G</mi><mo>+</mo><mi>S</mi></mrow></mfenced></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>n</mi><mi>K</mi><mfenced><mrow><mi>G</mi><mo>+</mo><mi>S</mi></mrow></mfenced></mrow><mi>S</mi></mfrac></math>",
