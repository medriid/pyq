    },
    {
      "id": "s6PGz",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>6</mn><mn>11</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi></math>",
