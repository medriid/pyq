  "question": {
    "text": "<p>A battery of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">V</mi></math> is connected to the circuit as shown below. The current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi></math> drawn from the battery is</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/aa933cbc-e136-48db-8fda-7e846893bff2-image.png\" style=\"width: 180px; height: 199px;\" /></p><p>&nbsp;</p>",
    "image": null
