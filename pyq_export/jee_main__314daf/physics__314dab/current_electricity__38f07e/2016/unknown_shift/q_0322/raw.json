  "question": {
    "text": "To know the resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>G</mi></math> of a galvanometer by half deflection method, a battery of emf <math><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">E</mi></mrow></msub></math> and resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is used to deflect the galvanometer by angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#952;</mi></math> . If a shunt of resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math> is needed to get half deflection the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>G</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math> are related by the equation:",
    "image": null
  },
  "options": [
    {
      "id": "EQ9ej",
      "text": "<math><mi mathvariant=\"normal\">S</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">R</mi><mo>+</mo><mi mathvariant=\"normal\">G</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">G</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "QyrXi",
      "text": "<math><mn>2</mn><mi mathvariant=\"normal\">S</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">R</mi><mo>+</mo><mi mathvariant=\"normal\">G</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">G</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VXhH7",
      "text": "<math><mn>2</mn><mi mathvariant=\"normal\">G</mi><mo>=</mo><mi mathvariant=\"normal\">S</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8WO4M",
      "text": "<math><mn>2</mn><mi mathvariant=\"normal\">S</mi><mo>=</mo><mi mathvariant=\"normal\">G</mi></math>",
