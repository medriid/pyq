  "question": {
    "text": "<p>The given potentiometer has its wire of resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>. When the sliding contact is in the middle of the potentiometer wire, the potential drop across <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math> resistor is:</p><p><img src=\"assets\\qt0202_6df2f4505c9f.png\" style=\"width: 279px; height: 165px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>40</mn><mn>9</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>40</mn><mn>11</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>",
      "is_correct": false
    }
  ],
