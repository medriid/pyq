      "isCorrect": false
    },
    {
      "id": "v7x53",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>.</mo><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "3JAyf",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>zero</mi><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math>",
