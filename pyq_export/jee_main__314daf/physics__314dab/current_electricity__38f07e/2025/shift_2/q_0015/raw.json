  "question": {
    "text": "A galvanometer having a coil of resistance $30 \\Omega$ need 20 mA of current for full-scale deflection. If a maximum current of 3 A is to be measured using this galvanometer, the resistance of the shunt to be added to the galvanometer should be $\\frac{30}{X} \\Omega$, where $X$ is\nOptions",
    "image": null
  },
  "options": [
    {
      "id": "vmgvc",
      "text": "596",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "itFU3",
      "text": "149",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "0ayqZ",
      "text": "298",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZvABA",
      "text": "447",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\left(I-I_g\\right) R=I_g G \\\\ & (3-0.02) \\times R=0.02 \\times G \\Rightarrow R=\\frac{30}{149} \\\\ & \\Rightarrow 149=\\text { Required } X\\end{aligned}$",
    "image": null
  },
