  "question": {
    "text": "There are ' $n$ ' number of identical electric bulbs, each is designed to draw a power $p$ independently from the mains supply. They are now joined in series across the main supply. The total power drawn by the combination is :",
    "image": null
  },
  "options": [
    {
      "id": "skPwa",
      "text": "np",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NA56B",
      "text": "$\\frac{\\mathrm{p}}{\\mathrm{n}^2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oK0zD",
      "text": "$\\frac{\\mathrm{p}}{\\mathrm{n}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XKOJX",
      "text": "p",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & R_s=R_1+R_2+R_3+\\ldots \\ldots..+R_n \\\\ & \\frac{V^2}{P_s}=\\frac{V^2}{P}+\\frac{V^2}{P}+\\ldots \\ldots.+\\frac{V^2}{P_n} \\\\ & P_s=\\frac{P}{n}\\end{aligned}$",
    "image": null
  },
