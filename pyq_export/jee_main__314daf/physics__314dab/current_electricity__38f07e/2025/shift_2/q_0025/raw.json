  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & P_{\\text {input }}=V i=100 \\mathrm{~W} \\\\ & \\eta=\\frac{P_{\\text {out }}}{P_{\\text {input }}}=0.916\\end{aligned}$<br/>$\\begin{aligned} & P_{\\text {out }}=91.6 \\mathrm{~W} \\\\ & \\text { Loss }=100-91.6=8.4 \\mathrm{~J} / \\mathrm{s}=2 \\mathrm{cal} / \\mathrm{s}\\end{aligned}$",
