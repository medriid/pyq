  "question": {
    "text": "A motor operating on 100 V draws a current of 1 A. If the efficiency of the motor is $91.6 \\%$, then the loss of power in units of $\\mathrm{cal} / \\mathrm{s}$ is"
  },
  "options": [
    {
      "text": "$4$",
      "is_correct": false
    },
    {
      "text": "$8.4$",
      "is_correct": false
    },
    {
      "text": "$2$",
      "is_correct": true
    },
    {
      "text": "$6.2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & P_{\\text {input }}=V i=100 \\mathrm{~W} \\\\ & \\eta=\\frac{P_{\\text {out }}}{P_{\\text {input }}}=0.916\\end{aligned}$<br/>$\\begin{aligned} & P_{\\text {out }}=91.6 \\mathrm{~W} \\\\ & \\text { Loss }=100-91.6=8.4 \\mathrm{~J} / \\mathrm{s}=2 \\mathrm{cal} / \\mathrm{s}\\end{aligned}$"
  }
