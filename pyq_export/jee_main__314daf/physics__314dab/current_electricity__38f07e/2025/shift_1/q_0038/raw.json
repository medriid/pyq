      "image": null,
      "isCorrect": false
    },
    {
      "id": "K5p20",
      "text": "1.0 A",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The circuit can be considered as\n\n\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/hjgFVORRP_mXX_GmiXYYWS9lkzdI16W0ZfmMp-Hh270.original.fullsize.png\"><br>\n\n$\\begin{aligned} & \\therefore \\mathrm{R}_{\\text {eq }}=0.5+\\frac{0.5 \\times 2}{2+0.5}=\\left(\\frac{5}{10}+\\frac{10}{25}\\right) \\Omega \\\\ & =\\frac{45}{50}=\\frac{9}{10}=0.9 \\\\ & \\therefore \\mathrm{i}=\\frac{0.9}{0.9}=1 \\mathrm{~A}\\end{aligned}$",
    "image": null
  },
