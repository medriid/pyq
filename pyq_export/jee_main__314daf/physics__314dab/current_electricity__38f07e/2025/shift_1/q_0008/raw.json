  "question": {
    "text": "The battery of a mobile phone is rated as 4.2 V , 5800 mAh. How much energy is stored in it when fully charged ?",
    "image": null
  },
  "options": [
    {
      "id": "usOXr",
      "text": "43.8 kJ",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hftbD",
      "text": "48.7 kJ",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GsXkk",
      "text": "87.7 kJ",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8Uf8y",
      "text": "24.4 kJ",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Given $\\mathrm{V}=4.2$ volt<br/>$\\therefore$ Energy supplied by battery<br/>$=\\mathrm{vq}=4.2 \\times 5800 \\times 3600 \\times 10^{-3} \\mathrm{~J}=87.696 \\mathrm{~kJ}$<br/>$\\therefore$ Energy stored in the battery when fully charged<br/>$=87.696 \\mathrm{~kJ} \\approx 87.7 \\mathrm{~kJ}$",
    "image": null
  },
