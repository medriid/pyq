  "question": {
    "text": "A wire of resistance $9 \\Omega$ is bent to form an equilateral triangle. Then the equivalent resistance across any two vertices will be _____ ohm.",
    "image": null
  },
  "options": [],
  "correctValue": "2",
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/zYlz9hCj2DFbynrK5ZIaIuf5lpnqvvEjroL0gCCPU2E.original.fullsize.png\"><br>\n\n\n\n$9 \\Omega$ is the resistance of whole wire\n$\\therefore$ resistance of each wire $=3 \\Omega$.\n$\\therefore$ Equivalent resistance $=2 \\Omega$",
    "image": null
  },
