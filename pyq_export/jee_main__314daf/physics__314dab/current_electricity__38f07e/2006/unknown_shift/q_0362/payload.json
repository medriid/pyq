  "question": {
    "text": "The resistance of a bulb filament is $100 \\Omega$ at a temperature of $100^{\\circ} \\mathrm{C}$. If its temperature coefficient of resistance be $0.005$ per ${ }^{\\circ} \\mathrm{C}$, its resistance will become $200 \\Omega$ at a temperature of"
  },
  "options": [
    {
      "text": "\n$200^{\\circ} \\mathrm{C}$\n",
      "is_correct": false
    },
    {
      "text": "\n$300^{\\circ} \\mathrm{C}$\n",
      "is_correct": true
    },
    {
      "text": "\n$400^{\\circ} \\mathrm{C}$\n",
      "is_correct": false
    },
    {
      "text": "\n$500^{\\circ} \\mathrm{C}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$200=100[1+(0.005 \\times \\Delta t)]$\n$T-100=200$\n$\\mathrm{T}=300^{\\circ} \\mathrm{C}$"
  }
}