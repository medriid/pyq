  "question": {
    "text": "In a Wheatstone's bridge, there resistances $\\mathrm{P}, \\mathrm{Q}$ and $\\mathrm{R}$ connected in the three arms and the fourth arm is formed by two resistances $\\mathrm{S}_1$ and $\\mathrm{S}_2$ connected in parallel. The condition for bridge to be balanced will be",
    "image": null
  },
  "options": [
    {
      "id": "carNO",
      "text": "\n$\\frac{\\mathrm{P}}{\\mathrm{Q}}=\\frac{\\mathrm{R}}{\\mathrm{S}_1+\\mathrm{S}_2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qC15d",
      "text": "\n$\\frac{\\mathrm{P}}{\\mathrm{Q}}=\\frac{2 \\mathrm{R}}{\\mathrm{S}_1+\\mathrm{S}_2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XoNVU",
      "text": "\n$\\frac{\\mathrm{P}}{\\mathrm{Q}}=\\frac{\\mathrm{R}\\left(\\mathrm{S}_1+\\mathrm{S}_2\\right)}{\\mathrm{S}_1 \\mathrm{~S}_2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mha1g",
      "text": "\n$\\frac{\\mathrm{P}}{\\mathrm{Q}}=\\frac{\\mathrm{R}\\left(\\mathrm{S}_1+\\mathrm{S}_2\\right)}{2 \\mathrm{~S}_1 \\mathrm{~S}_2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
