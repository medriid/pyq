  "question": {
    "text": "A $5 \\mathrm{~V}$ battery with internal resistance $2 \\Omega$ and a $2 \\mathrm{~V}$ battery with internal resistance $1 \\Omega$ are connected to a $10 \\Omega$ resistor as shown in the figure. The current in the $10 \\Omega$ resistor is\n<img src=\"assets\\qt0336_6d672622ec1f.png\"><br>"
  },
  "options": [
    {
      "text": "\n$0.27 A P_2$ to $P_1$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.03 A P_1$ to $P_2$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.03 A P_2$ to $P_1$\n",
      "is_correct": true
    },
    {
      "text": "\n$0.27 \\mathrm{~A} \\mathrm{P} P_1$ to $P_2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& V_{P_2}-V_{P_1}=\\frac{\\frac{5}{2}+\\frac{0}{10}-\\frac{2}{1}}{\\frac{1}{2}+\\frac{1}{10}+\\frac{1}{1}} \\\\\n& I=\\frac{V_{P_2}-V_{P_1}}{10}=0.03 \\text { from } P_2 \\rightarrow P_1\n\\end{aligned}\n$$\n<img src=\"assets\\st0336_154384028bdd.png\"><br>"
  }
}