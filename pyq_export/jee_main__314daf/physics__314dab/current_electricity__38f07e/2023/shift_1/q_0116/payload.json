    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>4</mn></msub><mo>=</mo><mfrac><mn>8</mn><mn>5</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">I</mi><mn>5</mn></msub><mo>=</mo><mfrac><mn>2</mn><mn>5</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi></math>",
