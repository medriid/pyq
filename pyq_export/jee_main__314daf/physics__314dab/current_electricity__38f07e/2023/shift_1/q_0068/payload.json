  "question": {
    "text": "<p>In the given circuit, the current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi></math>&nbsp;through the battery will be</p><p><img src=\"assets\\qt0068_a98e6ca43ea5.png\" style=\"width: 300px; height: 205px;\" /></p>"
