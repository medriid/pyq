  "question": {
    "text": "<p>Different combination of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> resistors of equal resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> are shown in the figures. The increasing order for power dissipation is:</p><p>(A)&nbsp;<img src=\"assets\\qt0093_1c12f6ab0bff.png\" style=\"width: 250px; height: 103px;\" /></p><p>(B)&nbsp;<img src=\"assets\\qt0093_eaf25c3cf5d0.png\" style=\"width: 250px; height: 95px;\" /></p><p>(C)&nbsp;<img src=\"assets\\qt0093_aee76f418edc.png\" style=\"width: 250px; height: 137px;\" /></p><p>(D)&nbsp;<img src=\"assets\\qt0093_552872da7e1e.png\" style=\"width: 250px; height: 59px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mi>B</mi></msub><mo>&#60;</mo><msub><mi>P</mi><mi>C</mi></msub><mo>&#60;</mo><msub><mi>P</mi><mi>D</mi></msub><mo>&#60;</mo><msub><mi>P</mi><mi>A</mi></msub></math>",
      "is_correct": false
