  "question": {
    "text": "Ratio of thermal energy released in two resistor <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>R</mi></math> connected in parallel in an electric circuit is :",
    "image": null
  },
  "options": [
