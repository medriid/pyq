  "level": 1,
  "question": {
    "text": "The drift velocity of electrons for a conductor connected in an electrical circuit is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mi>d</mi></msub></math>. The conductor is now replaced by another conductor with same material and same length but double the area of cross-section. The applied voltage remains same. The new drift velocity of electrons will be",
    "image": null
  },
  "options": [
    {
      "id": "Rc1yc",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mi>d</mi></msub></math>",
