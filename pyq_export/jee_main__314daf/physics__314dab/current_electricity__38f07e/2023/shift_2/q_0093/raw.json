  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "Equivalent resistance between the adjacent corners of a regular <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>-sided polygon of uniform wire of resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> would be :",
    "image": null
  },
  "options": [
    {
      "id": "EUa1b",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mfenced><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>R</mi></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "kCixa",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mfenced><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mstyle displaystyle=\"true\"><mi>R</mi></mstyle></mrow><mfenced><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "geR1L",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi>n</mi><mn>2</mn></msup><mi>R</mi></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "30XM1",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mfenced><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mstyle displaystyle=\"true\"><mi>R</mi></mstyle></mrow><mi>n</mi></mfrac></math>",
      "isCorrect": false,
      "image": null
    }
