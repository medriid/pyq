  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "<p>The equivalent resistance between <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>&#160;</mo><mtext>and</mtext><mo>&#160;</mo><mi>B</mi></math> is _______.</p><p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/a7eb5601-62c0-4b97-b2d2-7b026607e965-9895383.PNG\" style=\"width: 300px; height: 204px;\" />.</p>",
    "image": null
  },
  "options": [
    {
      "id": "czE99",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac><mi>&#937;</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "7BX64",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>&#937;</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "GYfl3",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac><mi>&#937;</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Sf4sM",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>3</mn></mfrac><mi>&#937;</mi></math>",
      "isCorrect": false,
