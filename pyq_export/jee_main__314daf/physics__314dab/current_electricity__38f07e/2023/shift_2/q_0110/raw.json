  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "The resistance of a wire is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>. Its new resistance in ohm, if stretched to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math> times of its original length will be :",
    "image": null
  },
  "options": [
    {
      "id": "bTqBx",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>625</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "o86sn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>125</mn></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "HGJUd",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "mXScj",
