  "question": {
    "text": "A heater coil is cut into two equal parts and only one part is now used in the heater. The heat generated will now be"
  },
  "options": [
    {
      "text": "\ndoubled\n",
      "is_correct": true
    },
    {
      "text": "\nfour times\n",
      "is_correct": false
    },
    {
      "text": "\none fourth\n",
      "is_correct": false
    },
    {
      "text": "\nhalved",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{H}=\\frac{\\mathrm{V}^2 \\Delta \\mathrm{t}}{\\mathrm{R}}$\n$\\mathrm{H}^{\\prime}=\\frac{\\mathrm{V}^2}{\\mathrm{R}^{\\prime}} \\Delta \\mathrm{t} \\quad$ Given $\\mathrm{R}^{\\prime}=\\mathrm{R} / 2$"
  }
}