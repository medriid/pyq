  "question": {
    "text": "The resistance of hot tungsten filament is about 10 times the cold resistance. What will be the resistance of $100 \\mathrm{~W}$ and $200 \\mathrm{~V}$ lamp when not in use?"
  },
  "options": [
    {
      "text": "\n$40 \\Omega$\n",
      "is_correct": true
    },
    {
      "text": "\n$20 \\Omega$\n",
      "is_correct": false
    },
    {
      "text": "\n$400 \\Omega$\n",
      "is_correct": false
    },
    {
      "text": "\n$200 \\Omega$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$R_{\\text {hot }}=\\frac{V^2}{P}=\\frac{200 \\times 200}{100}=400 \\Omega$\ncold resistance $=R_{\\text {hot }} / 10=400 / 10=40 \\Omega$"
