  "question": {
    "text": "The resistance of hot tungsten filament is about 10 times the cold resistance. What will be the resistance of $100 \\mathrm{~W}$ and $200 \\mathrm{~V}$ lamp when not in use?",
    "image": null
  },
  "options": [
    {
