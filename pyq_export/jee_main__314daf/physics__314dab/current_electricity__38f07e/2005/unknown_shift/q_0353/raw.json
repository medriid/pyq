  "question": {
    "text": "Two voltameters one of copper and another of silver, are joined in parallel. When a total charge $q$ flows through the voltameters, equal amount of metals are deposited. If the electrochemical equivalents of copper and silver are $z_1$ and $z_2$ respectively the charge which flows through the silver voltameter is",
    "image": null
  },
  "options": [
    {
      "id": "nxYt0",
      "text": "\n$\\frac{q}{1+\\frac{z_1}{z_2}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "smCvw",
      "text": "\n$\\frac{q}{1+\\frac{z_2}{z_1}}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "MOQZY",
      "text": "\n$\\mathrm{q} \\frac{z_1}{z_2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1nKBk",
      "text": "\n$\\mathrm{q} \\frac{z_2}{z_1}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$q_1 Z_1=q_2 Z_2$\n$q=q_1+q_2$\n$\\therefore q_2=\\frac{q}{1+\\frac{Z_2}{Z_1}}$",
    "image": null
  },
