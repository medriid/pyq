  "question": {
    "text": "Two sources of equal emf are connected to an external resistance R. The internal resistance of the two sources are $R_1$ and $R_2\\left(R_2>R_1\\right)$. If the potential difference across the source having internal resistance $\\mathrm{R}_2$ is zero, then"
  },
  "options": [
    {
      "text": "\n$\\left.\\mathrm{R}=\\mathrm{R}_2 \\times\\left(\\mathrm{R}_1+\\mathrm{R}_2\\right) / \\mathrm{R}_2-\\mathrm{R}_1\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{R}=\\mathrm{R}_2-\\mathrm{R}_1$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{R}=\\mathrm{R}_1 \\mathrm{R}_2 /\\left(\\mathrm{R}_1+\\mathrm{R}_2\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{R}=\\mathrm{R}_1 \\mathrm{R}_2 /\\left(\\mathrm{R}_2-\\mathrm{R}_1\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{I}=\\frac{2 \\mathrm{E}}{\\mathrm{R}_1+\\mathrm{R}_2+\\mathrm{R}}$\n$\\mathrm{E}-\\mathrm{R}_2 \\mathrm{I}=0$\n$\\Rightarrow \\mathrm{R}=\\mathrm{R}_2-\\mathrm{R}_1$"
  }
}