  "question": {
    "text": "In a potentiometer experiment the balancing with a cell is at length $240 \\mathrm{~cm}$. On shunting the cell with a resistance of $2 \\Omega$ the balancing length becomes $120 \\mathrm{~cm}$. The internal resistance of the cell is"
  },
  "options": [
    {
      "text": "\n$1 \\Omega$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.5 \\Omega$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\Omega$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\Omega$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{r}=\\mathrm{R}\\left[\\frac{\\ell_1}{\\ell_2}-1\\right]=2\\left[\\frac{240}{120}-1\\right]=2 \\Omega$"
  }
}