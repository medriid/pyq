    "text": "Mobility <math><mi>&#956;</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi>d</mi></mrow></msub></mrow><mrow><mi>E</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#956;</mi><mo>=</mo><mfrac><msub><mi>V</mi><mi>d</mi></msub><mi>E</mi></mfrac><mo>=</mo><mfrac><mrow><msub><mi>V</mi><mi>d</mi></msub><mi mathvariant=\"script\">l</mi></mrow><mi>V</mi></mfrac><mo>=</mo><mfrac><mrow><msub><mi>V</mi><mi>d</mi></msub><mi mathvariant=\"script\">l</mi></mrow><mrow><mi>i</mi><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>V</mi><mi>d</mi></msub><mi>A</mi><mi mathvariant=\"script\">l</mi></mrow><mrow><mi>i</mi><mi>&#961;</mi><mi mathvariant=\"script\">l</mi></mrow></mfrac></math><br /><math><mi>&#956;</mi><mo>=</mo><mfrac><mrow><mn>1.1</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#215;</mo><mi>&#960;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>5</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>5</mn><mo>&#215;</mo><mn>1.7</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>8</mn></mrow></msup></mrow></mfrac></math><br /><math><mo>=</mo><mn>1.0</mn><mi>&#160;</mi><msup><mrow><mi mathvariant=\"normal\">m</mi></mrow><mrow><mn>2</mn></mrow></msup><mi mathvariant=\"normal\">&#160;</mi><msup><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
