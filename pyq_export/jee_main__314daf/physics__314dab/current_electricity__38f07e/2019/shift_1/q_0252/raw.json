  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "A wire of resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is bent to form a square <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mi>C</mi><mi>D</mi></math> as shown in the figure. The effective resistance between <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> is:<br />( <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math> is mid-point of arm <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mi>D</mi></math> )<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9b37b65d-6136-4891-84f6-b5089aee9d6f-image7.png\" />",
    "image": null
  },
  "options": [
    {
      "id": "yzido",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "JINyU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>7</mn><mn>64</mn></mfrac><mi>R</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "eQi2p",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>16</mn></mfrac><mi>R</mi></math>",
      "isCorrect": false,
