  "question": {
    "text": "A <math><mn>200</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#937;</mi></math> resistor has certain colour code. If one replaced the red colour by green in the code, the new resistance will be:",
    "image": null
  },
  "options": [
    {
      "id": "9hzrZ",
      "text": "<math><mn>300</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">Ω</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ve7j5",
      "text": "<math><mi> </mi><mn>100</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">Ω</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "IiDrS",
      "text": "<math><mi> </mi><mn>400</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">Ω</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "GKNBy",
      "text": "<math><mi> </mi><mn>500</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">Ω</mi></math>",
      "isCorrect": true,
      "image": null
