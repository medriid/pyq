  "question": {
    "text": "The charge on a capacitor plate in a circuit, as a function of time, is shown in the figure:<br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/kgbttbtspryvrrdtoxqkmkaomrlfmvuihhicxryaxvjfqtvyrr.png\" /><br /><br />What is the value of current at <math><mi>t</mi><mo>=</mo><mn>4</mn><mi>&#160;</mi><mi>s</mi><mo>?</mo></math>",
    "image": null
  },
  "options": [
    {
      "id": "a4d59",
      "text": "<math><mn>1.5</mn><mi>&nbsp;</mi><mi>μ</mi><mi>A</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
