  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Given, $E_{1}=1 \\mathrm{~V}, \\mathrm{E}_{2}=2 \\mathrm{~V}, \\mathrm{E}_{3}=3 \\mathrm{~V}, \\mathrm{r}_{1}=1 \\Omega$\r\n\r\n$\\mathrm{r}_{2}=1 \\Omega$ and $\\mathrm{r}_{3}=1 \\Omega$\r\n\r\n$\\mathrm{V}_{\\mathrm{AB}}=\\mathrm{V}_{\\mathrm{CD}}=\\frac{\\frac{\\mathrm{E}_{1}}{\\mathrm{r}_{1}}+\\frac{\\mathrm{E}_{2}}{\\mathrm{r}_{2}}+\\frac{\\mathrm{E}_{3}}{\\mathrm{r}_{3}}}{\\frac{1}{\\mathrm{r}_{1}}+\\frac{1}{\\mathrm{r}_{2}}+\\frac{1}{\\mathrm{r}_{3}}}=\\frac{1}{\\frac{1}{1}+\\frac{1}{1}+\\frac{1}{1}+\\frac{3}{1}}=\\frac{6}{3}=2 \\mathrm{~V}$"
  }
