  "question": {
    "text": "In the circuit shown, the potential difference between $\\mathrm{A}$ and $B$ is\r\n\r\n<img src=\"assets\\qt0265_4ff71c867ad2.png\">"
  },
  "options": [
    {
      "text": "$1 \\mathrm{~V}$",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{~V}$",
      "is_correct": true
    },
    {
      "text": "$3 V$",
      "is_correct": false
