  "question": {
    "text": "An electric bulb rated $50 \\mathrm{~W}-200 \\mathrm{~V}$ is connected across a $100 \\mathrm{~V}$ supply. The power dissipation of the bulb is:",
    "image": null
  },
  "options": [
    {
      "id": "wKuPV",
      "text": "$25 \\mathrm{~W}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0nBVy",
      "text": "$12.5 \\mathrm{~W}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ChKf3",
      "text": "$50 \\mathrm{~W}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sx3ez",
      "text": "$100 \\mathrm{~W}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Rated power \\& voltage gives resistance\n$\\begin{aligned}\n& \\mathrm{R}=\\frac{\\mathrm{V}^2}{\\mathrm{P}}=\\frac{(200)^2}{50}=\\frac{40000}{50} \\\\\n& \\mathrm{R}=800 \\\\\n& \\mathrm{P}=\\frac{\\left(\\mathrm{V}_{\\text {applied }}\\right)^2}{\\mathrm{R}}=\\frac{(100)^2}{800} \\\\\n& \\mathrm{P}=12.5 \\text { watt }\n\\end{aligned}$",
    "image": null
  },
