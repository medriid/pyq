  "question": {
    "text": "The number of electrons flowing per second in the filament of a $110 \\mathrm{~W}$ bulb operating at $220 \\mathrm{~V}$ is : $\\left(\\right.$ Given $\\left.\\mathrm{e}=1.6 \\times 10^{-19} \\mathrm{C}\\right)$",
    "image": null
  },
  "options": [
    {
      "id": "PUMbn",
      "text": "$6.25 \\times 10^{17}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ERUht",
