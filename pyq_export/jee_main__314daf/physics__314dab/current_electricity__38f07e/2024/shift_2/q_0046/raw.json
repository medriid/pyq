  "question": {
    "text": "Water boils in an electric kettle in 20 minutes after being switched on. Using the same main supply, the length of the heating element should be _____ to _____ times of its initial length if the water is to be boiled in 15 minutes.",
    "image": null
  },
  "options": [
    {
      "id": "4Jnqb",
      "text": "decreased, $3 / 4$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ERvPG",
      "text": "increased, $4 / 3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9uRjB",
      "text": "decreased, 4/3",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PRqYJ",
      "text": "increased, $3 / 4$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{P}=\\frac{\\mathrm{v}^2}{\\mathrm{R}}, \\mathrm{R}=\\frac{\\rho \\ell}{\\mathrm{A}} \\\\ & \\mathrm{P} \\propto \\frac{1}{\\ell} \\\\ & \\frac{\\mathrm{P}_1}{\\mathrm{P}_2}=\\frac{\\mathrm{t}_2}{\\mathrm{t}_1}=\\frac{15}{20}=\\frac{\\ell_2}{\\ell_1} \\\\ & \\ell_2=\\frac{3}{4} \\ell_1\\end{aligned}$",
    "image": null
