  "question": {
    "text": "The circuit shown here has two batteries of $8.0 \\mathrm{~V}$ and $16.0 \\mathrm{~V}$ and three resistors $3 \\Omega, 9 \\Omega$ and $9 \\Omega$ and a capacitor of $5.0 \\mu \\mathrm{F}$.\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/ruMIBwDLv3t420IDSJu4USmJOX48Et7OwhI_TjiHHCU.original.fullsize.png\"><br>\nHow much is the current $\\mathrm{I}$ in the circuit in steady state?",
    "image": null
  },
  "options": [
    {
      "id": "czlZN",
      "text": "\n$1.6 \\mathrm{~A}$\n",
      "image": null,
      "isCorrect": false
    },
    {
