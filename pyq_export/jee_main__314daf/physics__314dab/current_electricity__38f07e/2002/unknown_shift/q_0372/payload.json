  "question": {
    "text": "A wire when connected to $220 \\mathrm{~V}$ mains supply has power dissipation $\\mathrm{P}_1$. Now the wire is cut into two equal pieces which are connected in parallel to the same supply. Power dissipation in this case is $P_2$ Then $P_2: P_1$ is"
  },
  "options": [
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n4\n",
      "is_correct": true
    },
    {
      "text": "\n2\n",
      "is_correct": false
    },
    {
      "text": "\n3",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$P_1=V^2 / R ; P_2=\\frac{V^2}{(R / 2)}+\\frac{V^2}{(R / 2)}=4 \\frac{V^2}{R}=4 P_1$"
  }
}