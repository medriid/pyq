    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mfrac><mi>&#961;</mi><mrow><mi>&#960;</mi><mi>&#8467;</mi></mrow></mfrac><mi>I</mi><mi>n</mi><mfenced><mfrac><mi>b</mi><mi>a</mi></mfrac></mfenced></math>",
