  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mi>g</mi></msub><mfenced><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mi>G</mi></mrow></mfenced><mo>=</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mi>g</mi></msub><mfenced><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mi>G</mi><mo>+</mo><msub><mi>R</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mi>G</mi></mrow></mfrac><mfenced><mrow><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mi>G</mi><mo>+</mo><msub><mi>R</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mi>G</mi><mo>+</mo><msub><mi>R</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mn>2</mn><mi>G</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub><mo>=</mo><msub><mi>R</mi><mn>1</mn></msub><mo>+</mo><mi>G</mi></math></p>"
