  "question": {
    "text": "The length of a wire of a potentiometer is $100 \\mathrm{~cm}$, and the e.m.f. of its standard cell is $\\mathrm{E}$ volt. It is employed to measure the e.m.f of a battery whose internal resistance is $0.5 \\Omega$. If the balance point is obtained at $\\mathrm{l}=30$ $\\mathrm{cm}$ from the positive end, the e.m.f. of the battery is",
    "image": null
  },
  "options": [
    {
      "id": "0tHri",
      "text": "\n$\\frac{30 \\mathrm{E}}{100.5}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "c54pl",
      "text": "\n$\\frac{30 \\mathrm{E}}{(100-0.5)}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "o4CGP",
      "text": "\n$\\frac{30(\\mathrm{E}-0.5 \\mathrm{i})}{100}$, where $\\mathrm{i}$ is the current in the potentiometer wire\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tYJbl",
      "text": "\n$\\frac{30 \\mathrm{E}}{100}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Potential $\\propto \\mathrm{R}$\n$\\mathrm{R} \\propto$ length $\\Rightarrow$ Potential difference $\\propto l$",
    "image": null
  },
