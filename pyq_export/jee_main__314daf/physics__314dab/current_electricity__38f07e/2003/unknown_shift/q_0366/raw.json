  "question": {
    "text": "The thermo e.m.f. of a thermo-couple is $25 \\mu \\mathrm{V} /{ }^{\\circ} \\mathrm{C}$ at room temperature. A galvanometer of 40 ohm resistance, capable of detecting current as low as $10^{-5} \\mathrm{~A}$, is connected with the thermo couple. The smallest temperature difference that can be detected by this sytem is",
    "image": null
  },
  "options": [
    {
      "id": "KlOoz",
      "text": "\n$16^{\\circ} \\mathrm{C}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "oavHP",
      "text": "\n$12^{\\circ} \\mathrm{C}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v7ug9",
      "text": "\n$8^0 \\mathrm{C}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a7Pye",
      "text": "\n$20^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\mathrm{T}=\\frac{40}{25 \\times 10^{-6} \\times 10^{-5}} \\Rightarrow \\Delta \\mathrm{T}=16^0 \\mathrm{C}$",
    "image": null
  },
