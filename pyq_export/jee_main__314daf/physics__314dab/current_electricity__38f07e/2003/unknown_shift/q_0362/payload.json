  "question": {
    "text": "A 220 volt, 1000 watt bulb is connected across a 110 volt mains supply. The power consumed will be"
  },
  "options": [
    {
      "text": "\n$750 \\mathrm{watt}$\n",
      "is_correct": false
    },
    {
      "text": "\n$500 \\mathrm{watt}$\n",
      "is_correct": false
    },
    {
      "text": "\n$250 \\mathrm{watt}$\n",
      "is_correct": true
    },
    {
      "text": "\n$1000 \\mathrm{watt}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{p}=\\frac{\\mathrm{V}^2}{\\mathrm{R}}$ or $\\mathrm{R}=\\frac{(220)^2}{1000}$\nPower consumed $=\\frac{\\mathrm{V}^2}{\\mathrm{R}}=\\frac{110 \\times 110}{220 \\times 220} \\times 1000=250$ watt"
  }
}