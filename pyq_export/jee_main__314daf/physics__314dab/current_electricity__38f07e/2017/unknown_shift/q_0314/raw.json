      "text": "<math><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "E5ZoB",
      "text": "<math><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fF5uV",
      "text": "<math><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></math>",
      "image": null,
