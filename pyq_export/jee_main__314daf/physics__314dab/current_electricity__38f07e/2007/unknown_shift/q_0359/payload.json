  "question": {
    "text": "The resistance of a wire is $5 \\mathrm{~ohm}$ at $50^{\\circ} \\mathrm{C}$ and $6 \\mathrm{~ohm}$ at $100^{\\circ} \\mathrm{C}$. The resistance of the wire at $0^{\\circ} \\mathrm{C}$ will be"
  },
  "options": [
    {
      "text": "\n$2 \\mathrm{~ohm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1 \\mathrm{~ohm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\mathrm{~ohm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$3 \\mathrm{~ohm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{5}{6}=\\frac{1+50 \\alpha}{1+100 \\alpha}$\n$5=R_0(1+\\alpha \\times 50)$\n$R_0=4$"
  }
