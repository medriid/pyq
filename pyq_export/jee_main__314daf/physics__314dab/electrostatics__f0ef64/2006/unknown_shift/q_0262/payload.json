  "question": {
    "text": "Two spherical conductors $A$ and $B$ of radii $1 \\mathrm{~mm}$ and $2 \\mathrm{~mm}$ are separated by a distance of $5 \\mathrm{~cm}$ and are uniformly charged. If the spheres are connected by a conducting wire then in equilibrium condition, the ratio of the magnitude of the electric fields at the surface of spheres $A$ and $B$ is"
  },
  "options": [
    {
      "text": "\n$1: 4$\n",
      "is_correct": false
    },
    {
      "text": "\n$4: 1$\n",
      "is_correct": false
    },
    {
      "text": "\n$1: 2$\n",
      "is_correct": false
    },
    {
      "text": "\n$2: 1$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{E}_{\\mathrm{A}}}{\\mathrm{E}_{\\mathrm{B}}}=\\frac{\\mathrm{r}_{\\mathrm{B}}}{\\mathrm{r}_{\\mathrm{A}}}=\\frac{2}{1}$"
  }
}