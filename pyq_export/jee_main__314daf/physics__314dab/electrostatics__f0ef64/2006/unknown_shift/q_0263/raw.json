  "question": {
    "text": "Two insulating plates are both uniformly charged in such a way that the potential difference between them is $V_2-V_1=20 \\mathrm{~V}$. (i.e. plate 2 is at a higher potential). The plates are separated by $d=0.1 \\mathrm{~m}$ and can be treated as infinitely large. An electron is released from rest on the inner surface of plate 1 . What is its speed when it hits plate $2 ?$\n$\\left(\\mathrm{e}=1.6 \\times 10^{-19} \\mathrm{C}, \\mathrm{m}_{\\mathrm{e}}=9.11 \\times 10^{-31} \\mathrm{~kg}\\right)$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/7RgZydYdIgxs3GSXGB7peZbJrJKolT9aih-buvofSvc.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "cYVkw",
      "text": "\n$32 \\times 10^{-19} \\mathrm{~m} / \\mathrm{s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "L4Jc4",
      "text": "\n$2.65 \\times 10^6 \\mathrm{~m} / \\mathrm{s}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "TtbGU",
      "text": "\n$7.02 \\times 10^{12} \\mathrm{~m} / \\mathrm{s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jBS4d",
      "text": "\n$1.87 \\times 10^6 \\mathrm{~m} / \\mathrm{s}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{1}{2} \\mathrm{mv}^2=\\mathrm{eV}$\n$\\mathrm{v}=\\sqrt{\\frac{2 \\mathrm{eV}}{\\mathrm{m}}}=2.65 \\times 10^6 \\mathrm{~m} / \\mathrm{s}$",
    "image": null
  },
