      "text": "<math><mfrac><mrow><mn>3</mn><mi>m</mi><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi>q</mi><msub><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "4NxSG",
      "text": "<math><mfrac><mrow><msqrt><mn>3</mn></msqrt><mtext>m</mtext><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><msub><mrow><mtext>qE</mtext></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
