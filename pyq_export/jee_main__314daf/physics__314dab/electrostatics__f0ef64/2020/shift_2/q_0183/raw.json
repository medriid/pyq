  "question": {
    "text": "Concentric metallic hollow spheres of radii R and 4R hold charges <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">Q</mi><mn>1</mn></msub></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">Q</mi><mn>2</mn></msub></math>&nbsp;respectively. Given that&nbsp;surface charge densities of the concentric spheres are equal, the potential difference&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">V</mi><mfenced><mi mathvariant=\"normal\">R</mi></mfenced><mo>-</mo><mi mathvariant=\"normal\">V</mi><mo>(</mo><mn>4</mn><mi mathvariant=\"normal\">R</mi><mo>)</mo></math> is:",
    "image": null
  },
  "options": [
    {
      "id": "WQI0n",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>Q</mi><mn>2</mn></msub><mrow><mn>4</mn><mi>&#960;</mi><msub><mi>&#949;</mi><mn>0</mn></msub><mi>R</mi></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "TOk45",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msub><mi mathvariant=\"normal\">Q</mi><mn>2</mn></msub></mrow><mrow><mn>4</mn><mi>&#960;</mi><msub><mi>&#949;</mi><mn>0</mn></msub><mi>R</mi></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "IOq9T",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msub><mi mathvariant=\"normal\">Q</mi><mn>1</mn></msub></mrow><mrow><mn>16</mn><mi>&#960;</mi><msub><mi>&#949;</mi><mn>0</mn></msub><mi mathvariant=\"normal\">R</mi></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "X3jn7",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msub><mi>Q</mi><mn>1</mn></msub></mrow><mrow><mn>4</mn><mi>&#960;</mi><msub><mi>&#949;</mi><mn>0</mn></msub><mi>R</mi></mrow></mfrac></math>",
      "isCorrect": false,
