  "question": {
    "text": "Two point charges $-4 \\mu c$ and $4 \\mu c$, constituting an electric dipole, are placed at $(-9,0,0) \\mathrm{cm}$ and $(9,0,0) \\mathrm{cm}$ in a uniform electric field of strength $10^4 \\mathrm{NC}^{-1}$. The work done on the dipole in rotating it from the equilibrium through $180^{\\circ}$ is :"
  },
  "options": [
    {
      "text": "18.4 mJ",
      "is_correct": false
    },
    {
      "text": "14.4 mJ",
      "is_correct": true
    },
    {
      "text": "12.4 mJ",
      "is_correct": false
    },
    {
      "text": "16.4 mJ",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{U}=-\\mathrm{PE} \\cos \\theta \\\\ & \\mathrm{w}_{\\mathrm{ext}}=\\Delta \\mathrm{U}=\\mathrm{U}_{\\mathrm{f}}-\\mathrm{U}_{\\mathrm{i}}=-\\mathrm{PE} \\cos 180^{\\circ}+\\mathrm{PE} \\cos 0^{\\circ} \\\\ & \\mathrm{w}_{\\mathrm{ext}}=2 \\mathrm{PE} \\\\ & =2 \\times\\left(4 \\times 10^{-6}\\right)(18) \\times 10^4 \\\\ & =144 \\times 10^{-2} \\\\ & =14.4 \\mathrm{~mJ}\\end{aligned}$"
  }
}