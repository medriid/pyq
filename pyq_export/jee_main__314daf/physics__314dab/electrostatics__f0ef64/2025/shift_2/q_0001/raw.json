  "question": {
    "text": "Electric charge is transferred to an irregular metallic disk as shown in figure. If $\\sigma_1, \\sigma_2, \\sigma_3$ and $\\sigma_4$ are charge densities at given points then, choose the correct answer from the options given below:<br/><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/SUTgd9uFYrZn45gCVkOW56xbyi4qaZUhBRioGjQ_Ibs.original.fullsize.png\"/><br/><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/NkGNbtlJlTF4q2huDGpQger1hoOuk6h10jcEaQsHwXg.original.fullsize.png\"/>",
    "image": null
  },
  "options": [
    {
      "id": "9bb4o",
      "text": "A, B and C Only",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5v1Fj",
      "text": "A and C Only",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pF0hz",
      "text": "D and E Only",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "EN32t",
      "text": "B and C Only",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\sigma \\propto \\frac{1}{\\mathrm{ROC}} \\\\ & (\\mathrm{ROC})_1 \\lt (\\mathrm{ROC})_3 \\lt (\\mathrm{ROC})_2=(\\mathrm{ROC})_4 \\\\ & \\sigma_1 \\gt \\sigma_3 \\gt \\sigma_2=\\sigma_4\\end{aligned}$",
    "image": null
  },
