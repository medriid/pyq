      "text": "$2.16 \\pi$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1GmlDYae9jQIhfCuqSkJHCIyYdk72jXtvfi4JNZN4cw.original.fullsize.png\"/><br/>$\\begin{aligned} & \\phi=\\frac{\\mathrm{q}_{\\mathrm{enc}}}{\\varepsilon_0}=\\frac{\\lambda \\cdot \\sqrt{3} \\mathrm{a}}{\\varepsilon_0} \\\\ & =2 \\times 10^{-9} \\times \\sqrt{3} \\times \\sqrt{3} \\times 10^{-2} \\times 36 \\pi \\times 10^9 \\mathrm{Nm}^2 \\mathrm{C}^{-1} \\\\ & =2.16 \\pi \\mathrm{Nm}^2 \\mathrm{C}^{-1}\\end{aligned}$",
    "image": null
  },
