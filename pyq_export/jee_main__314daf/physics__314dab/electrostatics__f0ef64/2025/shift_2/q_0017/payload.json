  "question": {
    "text": "Electric charge is transferred to an irregular metallic disk as shown in figure. If $\\sigma_1, \\sigma_2, \\sigma_3$ and $\\sigma_4$ are charge densities at given points then, choose the correct answer from the options given below:<br/><img src=\"assets\\qt0017_e27e81a43e75.png\"/><br/><img src=\"assets\\qt0017_9d7f7071e2c2.png\"/>"
  },
  "options": [
    {
      "text": "A, B and C Only",
      "is_correct": true
    },
    {
      "text": "A and C Only",
      "is_correct": false
    },
    {
      "text": "D and E Only",
      "is_correct": false
    },
    {
      "text": "B and C Only",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\sigma \\propto \\frac{1}{\\mathrm{ROC}} \\\\ & (\\mathrm{ROC})_1 \\lt (\\mathrm{ROC})_3 \\lt (\\mathrm{ROC})_2=(\\mathrm{ROC})_4 \\\\ & \\sigma_1 \\gt \\sigma_3 \\gt \\sigma_2=\\sigma_4\\end{aligned}$"
  }
}