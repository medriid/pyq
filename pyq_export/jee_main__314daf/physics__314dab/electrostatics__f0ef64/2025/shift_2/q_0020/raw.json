  "question": {
    "text": "Two metal spheres of radius $R$ and $3 R$ have same surface charge density $\\sigma$. If they are brought in contact and then separated, the surface charge density on smaller and bigger sphere becomes $\\sigma_1$ and $\\sigma_2$, respectively. The ratio $\\frac{\\sigma_1}{\\sigma_2}$ is.",
    "image": null
  },
  "options": [
    {
      "id": "NggwR",
      "text": "$\\frac{1}{9}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ibomI",
      "text": "9",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MhFEk",
      "text": "$\\frac{1}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "M4gUQ",
      "text": "3",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For conducting sphere, $\\mathrm{V}=\\frac{\\sigma \\mathrm{r}}{\\varepsilon_0}$<br/>After contact, $\\mathrm{V}_1=\\mathrm{V}_2$<br/>$\\begin{aligned}<br/>& \\sigma_1 r_1=\\sigma_2 r_2 \\\\\n& \\frac{\\sigma_1}{\\sigma_2}=\\frac{r_2}{\\mathrm{r}_1} \\\\\n& \\frac{\\sigma_1}{\\sigma_2}=3<br/>\\end{aligned}$",
    "image": null
  },
