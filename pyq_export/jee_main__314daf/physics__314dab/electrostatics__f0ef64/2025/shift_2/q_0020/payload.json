  "question": {
    "text": "A point charge causes an electric flux of $-2 \\times 10^4 \\mathrm{Nm}^2 \\mathrm{C}^{-1}$ to pass through a spherical Gaussian surface of 8.0 cm radius, centred on the charge. The value of the point charge is :\n(Given $\\epsilon_0=8.85 \\times 10^{-12} \\mathrm{C}^2 \\mathrm{~N}^{-1} \\mathrm{~m}^{-2}$ )"
  },
  "options": [
    {
      "text": "$15.7 \\times 10^{-8} \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$17.7 \\times 10^{-8} \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$-15.7 \\times 10^{-8} \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$-17.7 \\times 10^{-8} \\mathrm{C}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Flux }(\\phi)=\\frac{\\theta_{\\text {inc }}}{\\epsilon_0} \\\\ & \\begin{aligned} \\theta_{\\text {inc }} & =\\epsilon_0 \\phi \\\\ \\quad= & -17.7 \\times 10^{-8} \\mathrm{C}\\end{aligned}\\end{aligned}$"
  }
}