  "question": {
    "text": "Two infinite identical charged sheets and a charged spherical body of charge density ' $\\rho$ ' are arranged as shown in figure. Then the correct relation between the electrical fields at $\\mathrm{A}, \\mathrm{B}, \\mathrm{C}$ and D points is :<br/><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/th3tMibD7SygKJEeyKd0o0zdVVqoi6_-MlaPcgYVE2I.original.fullsize.png\"/>",
    "image": null
  },
  "options": [
    {
      "id": "d1Iel",
      "text": "$\\overrightarrow{\\mathrm{E}}_{\\mathrm{A}}=\\overrightarrow{\\mathrm{E}}_{\\mathrm{B}} ; \\overrightarrow{\\mathrm{E}}_{\\mathrm{C}}=\\overrightarrow{\\mathrm{E}}_{\\mathrm{D}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7FVms",
      "text": "$\\overrightarrow{\\mathrm{E}}_{\\mathrm{A}} \\gt \\overrightarrow{\\mathrm{E}}_{\\mathrm{B}} ; \\overrightarrow{\\mathrm{E}}_{\\mathrm{C}}=\\overrightarrow{\\mathrm{E}}_{\\mathrm{D}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OKn37",
      "text": "$\\overrightarrow{\\mathrm{E}}_{\\mathrm{C}} \\neq \\overrightarrow{\\mathrm{E}}_{\\mathrm{D}} ; \\overrightarrow{\\mathrm{E}}_{\\mathrm{A}} \\gt \\overrightarrow{\\mathrm{E}}_{\\mathrm{B}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "eYs9z",
      "text": "$\\left|\\overrightarrow{\\mathrm{E}}_{\\mathrm{A}}\\right|=\\left|\\overrightarrow{\\mathrm{E}}_{\\mathrm{B}}\\right| ; \\overrightarrow{\\mathrm{E}}_{\\mathrm{C}} \\gt \\overrightarrow{\\mathrm{E}}_{\\mathrm{D}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Conceptual<br/>$\\begin{aligned}<br/>& \\mathrm{E}_{\\mathrm{C}} \\neq \\mathrm{E}_{\\mathrm{D}} \\\\\n& \\mathrm{E}_{\\mathrm{A}} \\gt \\mathrm{E}_{\\mathrm{B}}<br/>\\end{aligned}$",
