  "question": {
    "text": "Consider two infinitely large plane parallel conducting plates as shown below. The plates are uniformly charged with a surface charge density $+\\sigma$ and $-2 \\sigma$. The force experienced by a point charge +q placed at the mid point between two plates will be :<br/><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/r4HXuiQoEYbEiIoXflUtL4nAelUcF41I1zkt5DRk9vg.original.fullsize.png\"/>",
    "image": null
  },
  "options": [
    {
      "id": "MT9FE",
      "text": "$\\frac{\\sigma q}{4 \\epsilon_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8X2t5",
      "text": "$\\frac{3 \\sigma q}{2 \\epsilon_0}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mCYte",
      "text": "$\\frac{3 \\sigma q}{4 \\in_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3sU7X",
      "text": "$\\frac{\\sigma q}{2 \\epsilon_0}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/Xe5lGE2sfm4KMRzOyWqRX82f_4YhryTlUICGkhlX8lE.original.fullsize.png\"/><br/>Final charge distribution will be<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/uxNoLr1bjEgGA5MdAI_94fZsQ09EoJy7DbUw2i3R1M8.original.fullsize.png\"/><br/>$\\therefore \\mathrm{F}_{\\mathrm{net}}=\\frac{3 \\sigma}{2 \\epsilon_0} \\mathrm{q}$",
    "image": null
  },
