  "question": {
    "text": "The electrostatic potential on the surface of uniformly charged spherical shell of radius $\\mathrm{R}=10 \\mathrm{~cm}$ is 120 V. The potential at the centre of shell, at a distance $\\mathrm{r}=5 \\mathrm{~cm}$ from centre, and at a distance $\\mathrm{r}=15 \\mathrm{~cm}$ from the centre of the shell respectively, are :",
    "image": null
  },
  "options": [
    {
      "id": "N0TNM",
      "text": "$120 \\mathrm{~V}, 120 \\mathrm{~V}, 80 \\mathrm{~V}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "V8sbL",
      "text": "$40 \\mathrm{~V}, 40 \\mathrm{~V}, 80 \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "L76Xo",
      "text": "$0 \\mathrm{~V}, 0 \\mathrm{~V}, 80 \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9tRU6",
      "text": "$0 \\mathrm{~V}, 120 \\mathrm{~V}, 40 \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Potential inside shell is equal to potential on surface<br/>$\\mathrm{V}_{\\mathrm{in}}=\\mathrm{V}_{\\text {surface }}=\\frac{\\mathrm{kQ}}{\\mathrm{R}}=120 \\mathrm{~V}$<br/>at $\\mathrm{r}=15 \\mathrm{~cm}$<br/>$\\mathrm{V}=\\frac{\\mathrm{kQ}}{\\mathrm{r}}=\\frac{120 \\times 10}{15}=80 \\mathrm{~V}$",
    "image": null
  },
