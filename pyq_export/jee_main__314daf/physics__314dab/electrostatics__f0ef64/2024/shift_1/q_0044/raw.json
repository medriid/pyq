  "question": {
    "text": "Ques:\n$\\sigma$ is the uniform surface charge density of a thin spherical shell of radius $R$. The electric field at any point on the surface of the spherical shell is :",
    "image": null
  },
  "options": [
    {
      "id": "rsNyJ",
      "text": "$\\sigma / \\epsilon_o R$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TnVoQ",
      "text": "$\\sigma / \\epsilon_o$",
      "image": null,
      "isCorrect": true
    },
