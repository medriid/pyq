  "question": {
    "text": "Five charges $+q,+5 q,-2 q,+3 q$ and $-4 q$ are situated as shown in the figure. The electric flux due to this configuration through the surface $S$ is :\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/0KqHtIlqkWQIAffbjUpqRbKfMR_IjMSZAN2Bwt4Qaxo.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "rmRP4",
      "text": "$\\frac{4 q}{\\epsilon_0}$",
      "image": null,
      "isCorrect": true
    },
    {
