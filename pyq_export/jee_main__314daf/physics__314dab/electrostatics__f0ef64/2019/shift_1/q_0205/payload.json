      "text": "<math><mi mathvariant=\"normal\">V</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>4</mn><mi> </mi><mi mathvariant=\"normal\">V</mi></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "First condition:<br /><img src=\"assets\\st0205_fd80260c0e73.png\" /><br />Both conducting spheres are shown.<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mrow><mi>i</mi><mi>n</mi></mrow></msub><mo>-</mo><msub><mi>V</mi><mrow><mi>o</mi><mi>u</mi><mi>t</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mfrac><mrow><mi>K</mi><mi>Q</mi></mrow><msub><mi>r</mi><mn>1</mn></msub></mfrac></mfenced><mo>-</mo><mfenced separators=\"|\"><mfrac><mrow><mi>K</mi><mi>Q</mi></mrow><msub><mi>r</mi><mn>2</mn></msub></mfrac></mfenced></math><br /><math><mo>&#8658;</mo><mi>V</mi><mo>=</mo><mi>K</mi><mi>Q</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced></math><br />Second condition:<br /><img src=\"assets\\st0205_df54132799c1.png\" /><br />Shell is now given charge <math><mo>-</mo><mn>4</mn><mi>Q</mi></math> .<br /><math><msub><mrow><mi>V</mi></mrow><mrow><mi>i</mi><mi>n</mi></mrow></msub><mo>-</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>o</mi><mi>u</mi><mi>t</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>K</mi><mi>Q</mi></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>4</mn><mi>K</mi><mi>Q</mi></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>K</mi><mi>Q</mi></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>4</mn><mi>K</mi><mi>Q</mi></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced></math><br /><math><mo>=</mo><mfrac><mrow><mi>K</mi><mi>Q</mi></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mi>K</mi><mi>Q</mi></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math><br /><math><mo>=</mo><mi>K</mi><mi>Q</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced><mo>=</mo><mi>V</mi></math>"
