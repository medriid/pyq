      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>Q</mi><mi> </mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>4</mn><mi>π</mi><msub><mrow><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>Q</mi></mrow><mrow><mn>12</mn><mi>π</mi><msub><mrow><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac><mfrac><mrow><mi>a</mi><mi>b</mi><mo>+</mo><mi>b</mi><mi>c</mi><mo>+</mo><mi>c</mi><mi>a</mi></mrow><mrow><mi>a</mi><mi>b</mi><mi>c</mi></mrow></mfrac></math>",
      "is_correct": false
