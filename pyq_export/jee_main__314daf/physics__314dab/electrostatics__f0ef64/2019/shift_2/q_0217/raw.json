    "text": "<blockquote><p>Electric field due to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>10</mn></msqrt><mi>&#160;</mi><mi>&#956;C</mi></math><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/69ebea31-2c59-4a3d-9f72-d5aab22cc0f1-image.png\" style=\"width: 320px; height: 239px;\" /><br /><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>E</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><mi>&#960;</mi><msub><mrow><mo>&#8712;</mo></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac><mfrac><mrow><msqrt><mn>10</mn></msqrt><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac><mi>&#160;</mi><msub><mrow><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>1</mn></mrow></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mi>&#960;</mi><msub><mo>&#8712;</mo><mn>0</mn></msub></mrow></mfrac><mfrac><mrow><msqrt><mn>10</mn></msqrt><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow><msup><mfenced separators=\"|\"><msqrt><mn>10</mn></msqrt></mfenced><mn>3</mn></msup></mfrac><mfenced separators=\"|\"><mrow><mo>-</mo><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover accent=\"true\"><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></mrow></mfenced></math><br /><br />Similarly, electric field due to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>25</mn><mi>&#160;</mi><mi>&#956;C</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover accent=\"true\"><mi>E</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mi>&#960;</mi><msub><mo>&#8712;</mo><mn>0</mn></msub></mrow></mfrac><mfrac><mrow><mn>25</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow><msup><mfenced separators=\"|\"><mn>5</mn></mfenced><mn>3</mn></msup></mfrac><mfenced separators=\"|\"><mrow><mn>4</mn><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mn>3</mn><mover accent=\"true\"><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></mrow></mfenced></math><br /><br />Net electric field,&nbsp;<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi mathvariant=\"normal\">E</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>9</mn><mo>&#215;</mo><msup><mn>10</mn><mn>9</mn></msup><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mo>-</mo><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover></mrow><mn>10</mn></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn><mover accent=\"true\"><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></mrow><mn>10</mn></mfrac><mo>+</mo><mfrac><mn>4</mn><mn>5</mn></mfrac><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mfrac><mn>3</mn><mn>5</mn></mfrac><mover accent=\"true\"><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>9</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>7</mn><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover></mrow><mn>10</mn></mfrac><mo>-</mo><mfrac><mrow><mn>3</mn><mover accent=\"true\"><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></mrow><mn>10</mn></mfrac></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced separators=\"|\"><mrow><mn>63</mn><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mn>27</mn><mover accent=\"true\"><mi mathvariant=\"no