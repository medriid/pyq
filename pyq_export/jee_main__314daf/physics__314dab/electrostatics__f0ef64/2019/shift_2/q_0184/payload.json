      "text": "<math><mi mathvariant=\"normal\">E</mi><mo>∝</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">D</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">E</mi><mo>∝</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">D</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></math>",
