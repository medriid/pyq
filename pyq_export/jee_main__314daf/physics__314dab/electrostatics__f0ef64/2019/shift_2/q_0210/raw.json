  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "An electric field of $1000 \\mathrm{~V} / \\mathrm{m}$ is applied to an electric dipole at angle of $45^{\\circ}$. The value of electric dipole moment is $10^{-29} \\mathrm{C} \\cdot \\mathrm{m} .$ What is the potential energy of the electric dipole?",
    "image": null
  },
  "options": [
    {
      "id": "dRkMF",
      "text": "$-20 \\times 10^{-18} \\mathrm{~J}$",
      "isCorrect": false,
      "image": null
    },
    {
