    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/3bda223a-e611-4d14-906a-e95e77965795-image.png\" style=\"width: 270px; height: 215px;\" /><br /><br /><math><mi>L</mi><mo>=</mo><mi>&#960;</mi><mi>R</mi></math><br /><br /><math> <mrow> <mo>&#8658;</mo><mi>R</mi><mo>=</mo><mfrac> <mi>L</mi> <mi>&#960;</mi> </mfrac> <mo>=</mo><mfrac> <mrow> <mn>20</mn></mrow> <mrow> <mn>100</mn><mi>&#960;</mi></mrow> </mfrac> <mtext>&#8201;</mtext><mtext>&#8201;</mtext><mtext>m</mtext><mo>=</mo><mfrac> <mn>1</mn> <mrow> <mn>5</mn><mi>&#960;</mi></mrow> </mfrac> <mo>&#160;</mo><mtext>&#8201;</mtext><mtext>m</mtext></mrow> </math><br /><br /><math><mo>&#8658;</mo></math> due to a charge arc, electric field at centre is given by<br /><br /><math><mrow><mi>E</mi><mo>=</mo><mfrac> <mrow> <mn>2</mn><mi>K</mi><mi>&#955;</mi></mrow> <mi>R</mi> </mfrac> <mi>sin</mi><mfrac> <mi>&#952;</mi> <mn>2</mn> </mfrac> </mrow> </math><br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/06b1c364-efda-4e78-beea-ae1ba7c7531a-image.png\" style=\"width: 140px; height: 207px;\" /><br /><br /><math><msub><mrow><mi>E</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mi>k</mi><mo>&#8907;</mo></mrow><mrow><mi>R</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mn>90</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mo>{</mo><mo>&#8907;</mo><mo>=</mo><mfrac><mrow><mi>Q</mi></mrow><mrow><mi>&#960;</mi><mi>R</mi><mo>/</mo><mn>2</mn></mrow></mfrac><mo>}</mo></mrow></mrow></math><br /><br /><br />undefined<br /><br />Component along <math><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mi>&#160;</mi></math> gets cancelled and&nbsp;<br /><br /><math> <mrow> <msub> <mi>E</mi> <mrow> <mi>n</mi><mi>e</mi><mi>t</mi></mrow> </msub> <mo>=</mo><msqrt> <mn>2</mn> </msqrt> <msub> <mi>E</mi> <mn>1</mn> </msub> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo><mfrac> <mrow> <mn>4</mn><mi>K</mi><mi>Q</mi></mrow> <mrow> <mi>&#960;</mi><msup> <mi>R</mi> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>4</mn><mo>&#215;</mo><mn>1</mn><mfenced separators=\"|\"><mrow><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><msub><mrow><mi>&#1013;</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfenced></mrow><mrow><mn>4</mn><mi>&#960;</mi><msub><mrow><mi>&#1013;</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>&#160;</mi><mi>&#960;</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><msub><mrow><mi>&#1013;</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>4</mn><msup><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>&#1013;</mi></mrow><mrow><mn>0</mn></mrow></msub><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mn>10</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>100</mn></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn><mi>&#960;</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mn>25</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover accent=\"true\"><mi>E</mi><mo>&#8594;</mo></mover><mrow><mi>n</mi><mi>e</mi><mi>t</mi></mrow></msub><mo>=</mo><mn>25</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">C</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi mathvariant=\"normal\">&#160;</mi><mover accent=\"true\"><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover></math>",
