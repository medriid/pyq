  "question": {
    "text": "The electric field due to a short electric dipole at a large distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>r</mi></mfenced></math>&nbsp;from center of dipole on the equatorial plane varies with distance as :",
    "image": null
  },
  "options": [
    {
      "id": "Plsbs",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Kg9BZ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msup><mi>r</mi><mn>2</mn></msup></mfrac></math>",
