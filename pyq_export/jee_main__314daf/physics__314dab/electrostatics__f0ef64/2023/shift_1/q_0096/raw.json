  "question": {
    "text": "<p>Graphical variation of electric field due to a uniformly charged insulating solid sphere of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi><mo>,</mo><mo>&#160;</mo></math>with distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">r</mi></math> from the centre <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">O</mi></math> is represented by:</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/4467d891-8c42-4a4b-988a-94dcd3e77eaf.png\" style=\"width: 200px; height: 191px;\" /></p>",
    "image": null
  },
