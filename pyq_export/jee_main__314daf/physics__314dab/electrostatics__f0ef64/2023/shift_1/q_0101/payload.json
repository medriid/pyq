    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn><mi>d</mi><msqrt><mi>k</mi></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>d</mi><msqrt><mi>k</mi></msqrt></math>",
      "is_correct": false
