  "question": {
    "text": "<p>For a uniformly charged thin spherical shell, the electric potential <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>V</mi></mfenced></math>&nbsp;radially away from the centre <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>O</mi></mfenced></math> of shell can be graphically represented as</p><p><img src=\"assets\\qt0099_560364e89353.png\" style=\"width: 250px; height: 219px;\" /></p>"
  },
  "options": [
    {
      "text": "<img src=\"assets\\ot1_0099_198f32144652.png\" style=\"width: 250px; height: 169px;\" />",
      "is_correct": false
    },
    {
      "text": "<img src=\"assets\\ot2_0099_191e4e1d7233.png\" style=\"width: 250px; height: 159px;\" />",
