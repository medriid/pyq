  "question": {
    "text": "A <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi><mo>&#160;</mo></math>&nbsp;charge is divided into two parts and placed at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi>cm</mi></math> distance so that the repulsive force between them is maximum. The charges of the two parts are:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi><mo>,</mo><mn>3</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi><mo>,</mo><mn>2</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi><mo>,</mo><mn>5</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi><mo>,</mo><mn>1</mn><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    }
