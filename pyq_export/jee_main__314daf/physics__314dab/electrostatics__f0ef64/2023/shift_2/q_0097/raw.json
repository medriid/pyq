    },
    {
      "id": "TRMDE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>8</mn><mo>&#160;</mo><mi>cm</mi></math>",
