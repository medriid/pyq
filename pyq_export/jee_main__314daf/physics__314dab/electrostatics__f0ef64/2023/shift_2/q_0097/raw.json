      "image": null
    },
    {
      "id": "JDHlv",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mo>&#8211;</mo><mn>4</mn><mo>&#160;</mo><mi>cm</mi></math>",
