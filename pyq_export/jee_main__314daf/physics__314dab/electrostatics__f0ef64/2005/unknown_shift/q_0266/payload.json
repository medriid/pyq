  "question": {
    "text": "Two point charges $+8 q$ and $-2 q$ are located at $x=0$ and $x=L$ respectively. The location of a point on the $x$ axis at which the net electric field due to these two point charges is zero is"
  },
  "options": [
    {
      "text": "\n$2 \\mathrm{~L}$\n",
      "is_correct": true
    },
    {
      "text": "\n$L / 4$\n",
      "is_correct": false
    },
    {
      "text": "\n$8 \\mathrm{~L}$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\mathrm{~L}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$-\\frac{\\mathrm{k} 2 q}{(\\mathrm{x}-\\mathrm{L})^2}+\\frac{\\mathrm{k} 8 \\mathrm{q}}{\\mathrm{x}^2}=0$\n$\\Rightarrow \\mathrm{x}=2 \\mathrm{~L}$"
  }
}