    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>q</mi><mi>&#961;</mi></mrow><mrow><mn>4</mn><msub><mi>&#949;</mi><mn>0</mn></msub><msup><mi>R</mi><mn>2</mn></msup></mrow></mfrac></math>",
