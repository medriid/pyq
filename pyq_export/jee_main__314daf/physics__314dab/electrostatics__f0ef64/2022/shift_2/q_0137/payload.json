  "question": {
    "text": "<p>If a charge <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi></math> is placed at the centre of a closed hemispherical non-conducting surface, the total flux passing through the flat surface would be</p><p><img src=\"assets\\qt0137_e19cabc8faaa.png\" style=\"width: 210px; height: 132px;\" /></p>"
  },
