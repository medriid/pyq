    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#160;</mo><msup><mi>Vm</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>, directed along negative <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>-axis.",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><msup><mi>Vm</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>, directed along negative <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>-axis.",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><msup><mi>Vm</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>, directed along positive <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>-axis.",
