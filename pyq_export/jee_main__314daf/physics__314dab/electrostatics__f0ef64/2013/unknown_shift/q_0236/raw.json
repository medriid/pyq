  "question": {
    "text": "Consider a finite insulated, uncharged conductor placed near a finite positively charged conductor. The uncharged body must have a potential :",
    "image": null
  },
  "options": [
    {
      "id": "PkBZu",
      "text": "\nless than the charged conductor and more than at infinity.\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "gCjo6",
      "text": "\nmore than the charged conductor and less than at infinity.\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QHK03",
      "text": "\nmore than the charged conductor and more than at infinity.\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NfPH7",
      "text": "\nless than the charged conductor and less than at infinity.",
      "image": null,
      "isCorrect": false
