  "question": {
    "text": "Two point dipoles of dipole moment $\\vec{p}_1$ and $\\vec{p}_2$ are at a distance $x$ from each other and $\\vec{p}_1 || \\vec{p}_2$. \n The force between the dipoles is :"
  },
  "options": [
    {
      "text": "\n$\\frac{1}{4 \\pi \\varepsilon_0} \\frac{4 p_1 p_2}{x^4}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{4 \\pi \\varepsilon_0} \\frac{3 p_1 p_2}{x^3}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{1}{4 \\pi \\varepsilon_0} \\frac{6 p_1 p_2}{x^4}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{4 \\pi \\varepsilon_0} \\frac{8 p_1 p_2}{x^4}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Force of interaction\n$\\mathrm{F}=\\frac{1}{4 \\pi \\epsilon_0} \\cdot \\frac{3 \\mathrm{p}_1 \\mathrm{p}_2}{\\mathrm{r}^4}$\n<img src=\"assets\\st0240_aca9cf043ec3.png\"><br>"
  }
