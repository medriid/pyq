  "question": {
    "text": "A charge <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi></math> is placed at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac bevelled=\"true\"><mi>a</mi><mn>2</mn></mfrac></math> above the centre of a square surface of side length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>. The electric flux through the square surface due to the charge would be?<br /><img src=\"assets\\qt0208_48aee3c5e3b3.png\" style=\"width: 180px; height: 201px;\" />"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mi>Q</mi></mrow><mrow><msub><mrow><mn>6</mn><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
