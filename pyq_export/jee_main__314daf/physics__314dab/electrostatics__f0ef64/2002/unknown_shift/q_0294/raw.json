  "question": {
    "text": "On moving a charge of 20 coulombs by $2 \\mathrm{~cm}, 2 \\mathrm{~J}$ of work is done, then the potential difference between the points is",
    "image": null
  },
  "options": [
    {
      "id": "15zTz",
      "text": "\n0.1 V\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "SMCRP",
      "text": "\n8 V\n",
      "image": null,
      "isCorrect": false
    },
    {
