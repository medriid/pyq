  "question": {
    "text": "A negative test charge is moving near a long straight wire carrying a current. The force acting on the test charge is parallel to the direction of the current. The motion of the charge is:"
  },
  "options": [
    {
      "text": "Away from the wire",
      "is_correct": false
    },
    {
      "text": "Towards the wire",
      "is_correct": true
    },
    {
      "text": "Parallel to the wire along the current",
      "is_correct": false
    },
    {
      "text": "Parallel to the wire opposite to the current",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<p>Force on a moving charge,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi>F</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>q</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mi mathvariant=\"normal\">v</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mi>B</mi><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><br />Here,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8757;</mo><mi>q</mi><mo>=</mo><mo>-</mo><mi>v</mi><mi>e</mi><mi>&#160;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover accent=\"true\"><mi>F</mi><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mi>q</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mi>B</mi><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mtext>motion&#160;of</mtext><mo>-</mo><mi mathvariant=\"normal\">q</mi><mtext>&#160;is&#160;towards&#160;the&#160;wire.</mtext></math><br /><img src=\"assets\\st0228_23bb4e4dd209.png\" style=\"width: 141px; height: 160px;\" /></p>"
  }
