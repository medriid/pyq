    {
      "id": "pyqsL",
      "text": "<math><msub><mrow><mi>ϕ</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mi>&nbsp;</mi><msub><mrow><mi>ϕ</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mi>&nbsp;</mi><msub><mrow><mi>ϕ</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>=</mo><mi>&nbsp;</mi><msub><mrow><mi>ϕ</mi></mrow><mrow><mn>4</mn></mrow></msub></math>",
