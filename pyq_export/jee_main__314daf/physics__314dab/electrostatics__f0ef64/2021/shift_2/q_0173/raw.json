  "question": {
    "text": "<p>A point charge of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>+</mo><mn>12</mn><mo>&#160;</mo><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math> is at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><mi>cm</mi></math> vertically above the centre of a square of side <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>&#160;</mo><mi>cm</mi></math> as shown in figure. The magnitude of the electric flux through the square will be _______&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mn>2</mn></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">C</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>.</mo></math></p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9913bae1-f549-4860-846f-b350587deedf-image.png\" style=\"width: 122px; height: 160px;\" /></p>",
    "image": null
  },
