    "text": "<p><img src=\"assets\\st0168_bfd887a4f344.png\" style=\"width: 157px; height: 122px;\" />.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mi>m</mi><mi>g</mi><mo>=</mo><mn>10</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup><mo>&#215;</mo><mn>10</mn><mo>=</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mi>sin</mi><mi>&#952;</mi><mo>=</mo><mfrac><mrow><mn>9</mn><mo>&#215;</mo><msup><mn>10</mn><mn>9</mn></msup><mo>&#215;</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><mrow><mn>0</mn><mo>.</mo><mn>04</mn></mrow></mfrac><mo>=</mo><mi>F</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#952;</mi><mo>=</mo><mo>=</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>1</mn></mrow><msqrt><mn>0</mn><mo>.</mo><mn>24</mn></msqrt></mfrac><mo>=</mo><mfrac><mi>F</mi><mrow><mi>m</mi><mi>g</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msqrt><mn>10</mn></msqrt></mrow><mrow><mn>3</mn><msqrt><msqrt><mn>24</mn></msqrt></msqrt></mrow></mfrac><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>8</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>95</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>8</mn></mrow></msup><mo>=</mo><mfrac><mi>a</mi><mn>21</mn></mfrac><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>8</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>20</mn></math></p>"
