  "question": {
    "text": "Let $P(r)=\\frac{Q}{\\pi R^4} r$ be the charge density distribution for a solid sphere of radius $R$ and total charge $Q$. for a point ' $p$ ' inside the sphere at distance $r_1$ from the centre of the sphere, the magnitude of electric field is",
    "image": null
  },
  "options": [
    {
      "id": "qHUFf",
      "text": "\n0\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YeY97",
      "text": "\n$\\frac{Q}{4 \\pi \\varepsilon_0 r_1^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sDFjq",
      "text": "\n$\\frac{Q r_1^2}{4 \\pi \\varepsilon_0 R^4}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hoKjY",
      "text": "\n$\\frac{Q_1^2}{3 \\pi \\varepsilon_0 R^4}$",
