  "question": {
    "text": "Two points $P$ and $Q$ are maintained at the potentials of $10 \\mathrm{~V}$ and $-4 \\mathrm{~V}$ respectively. The work done in moving 100 electrons from $P$ to $Q$ is",
    "image": null
  },
  "options": [
    {
      "id": "1wEfW",
      "text": "\n$-19 \\times 10^{-17} \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RhBNE",
      "text": "\n$9.60 \\times 10^{-17} \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SpKoN",
      "text": "\n$-2.24 \\times 10^{-16} \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iJuS8",
      "text": "\n$2.24 \\times 10^{-16} \\mathrm{~J}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& W=Q d V=Q\\left(V_q-V_P\\right)=-100 \\times\\left(1.6 \\times 10^{-19}\\right) \\times(-4-10) \\\\\n& =+100 \\times 1.6 \\times 10^{-19} \\times 14=+2.2410^{-16} \\mathrm{~J}\n\\end{aligned}\n$$",
    "image": null
  },
