  "question": {
    "text": "A particle is executing simple harmonic motion (SHM). The ratio of potential energy and kinetic energy of the particle when its displacement is half of its amplitude will be",
    "image": null
  },
  "options": [
    {
      "id": "TVdwj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>1</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W0CJ0",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>3</mn></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "YszBO",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>1</mn></math>",
      "image": null,
