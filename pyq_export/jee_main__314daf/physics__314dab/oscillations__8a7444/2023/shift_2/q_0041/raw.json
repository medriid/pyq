  "question": {
    "text": "<p>For particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math>&nbsp;revolving round the centre <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi></math> with radius of circular path <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi></math> and regular velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi></math>, as shown in below figure, the projection of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi><mi>P</mi></math> on the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>-axis at time <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi></math> is</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/40424b7c-3f2d-42c6-80d3-c2a6dadfa149.png\" style=\"width: 300px; height: 201px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "bbM5N",
