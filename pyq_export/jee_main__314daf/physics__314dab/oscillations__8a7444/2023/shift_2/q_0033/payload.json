    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><mi>r</mi><mo>&#160;</mo><mi>cos</mi><mo>(</mo><mi>&#969;</mi><mi>t</mi><mo>)</mo></math>",
