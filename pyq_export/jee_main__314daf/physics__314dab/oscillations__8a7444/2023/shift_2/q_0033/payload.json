  "question": {
    "text": "<p>For particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math>&nbsp;revolving round the centre <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi></math> with radius of circular path <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi></math> and regular velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi></math>, as shown in below figure, the projection of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi><mi>P</mi></math> on the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>-axis at time <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi></math> is</p><p><img src=\"assets\\qt0033_3400ff2dce45.png\" style=\"width: 300px; height: 201px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><mi>r</mi><mo>&#160;</mo><mi>cos</mi><mfenced><mrow><mi>&#969;</mi><mi>t</mi><mo>-</mo><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><mi>r</mi><mo>&#160;</mo><mi>cos</mi><mfenced><mrow><mi>&#969;</mi><mi>t</mi><mo>+</mo><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></mrow></mfenced></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>(</mo><mi>t</mi><mo>)</mo><mo>=</mo><mi>r</mi><mo>&#160;</mo><mi>sin</mi><mfenced><mrow><mi>&#969;</mi><mi>t</mi><mo>+</mo><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></mrow></mfenced></math>",
      "is_correct": false
