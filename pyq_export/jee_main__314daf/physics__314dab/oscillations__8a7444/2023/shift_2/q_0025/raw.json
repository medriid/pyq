  "question": {
    "text": "A particle executes SHM of amplitude<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi>A</mi></math>. The distance from the mean position when its kinetic energy becomes equal to its potential energy is:",
    "image": null
  },
  "options": [
    {
      "id": "i6Mf8",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mi>A</mi></math>",
      "image": null,
      "isCorrect": true
    },
