  "solution": {
    "text": "<math><mo>&#8757;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>x</mi><mo>=</mo><mi>A</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#969;</mi><mi>t</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>s</mi><mi>i</mi><mi>n</mi><mi>&#160;</mi><mi>&#969;</mi><mi>t</mi><mo>=</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mi>A</mi></mrow></mfrac></mrow></mrow></math><br /><br />Also, <math><mi>c</mi><mi>o</mi><mi>s</mi><mi>&#160;</mi><mi>&#969;</mi><mi>t</mi><mo>=</mo><mi>&#160;</mi><msqrt><mn>1</mn><mo>-</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#969;</mi><mi>t</mi></mrow></mrow></msqrt><mo>=</mo><mi>&#160;</mi><msqrt><mn>1</mn><mo>-</mo><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></msqrt><mi>&#160;</mi></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#160;</mi></mrow></mrow><mi>&#969;</mi><mi>t</mi><mo>=</mo><mi>&#160;</mi><mfrac><mrow><msqrt><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow><mrow><mi>A</mi></mrow></mfrac></math><br /><br />As, <math><mi>y</mi><mo>=</mo><mn>2</mn><mi>A</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#969;</mi><mi>t</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#969;</mi><mi>t</mi></mrow></mrow></mrow></mrow></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>y</mi><mo>=</mo><mn>2</mn><mi>&#160;</mi><mi>A</mi><mfrac><mrow><mi>x</mi></mrow><mrow><mi>A</mi></mrow></mfrac><mi>&#160;</mi><mfrac><mrow><msqrt><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow><mrow><mi>A</mi></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mi>A</mi></mrow></mfrac><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>x</mi><mi>&#160;</mi><msqrt><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mi>&#160;</mi></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>y</mi><mo>=</mo><mn>0</mn><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>a</mi><mi>t</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>x</mi><mo>=</mo><mn>0</mn><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>a</mi><mi>n</mi><mi>d</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>x</mi><mo>=</mo><mi>&#160;</mi><mo>&#177;</mo><mi>&#160;</mi><mi>A</mi></math><br /><br />Which is possible only in option (C)"
