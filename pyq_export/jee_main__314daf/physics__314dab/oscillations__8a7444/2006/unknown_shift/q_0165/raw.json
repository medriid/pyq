  "question": {
    "text": "A coin is placed on a horizontal platform which undergoes vertical simple harmonic motion of angular frequency $\\omega$. The amplitude of oscillation is gradually increased. The coin will leave contact with the platform for the first time",
    "image": null
  },
  "options": [
    {
      "id": "YBqMT",
      "text": "\nat the highest position of the platform\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XpL5g",
      "text": "\nat the mean position of the platform\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gZCLC",
      "text": "\nfor an amplitude of $\\frac{\\mathrm{g}}{\\omega^2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "LorUG",
      "text": "\nfor an amplitude of $\\frac{\\mathrm{g}^2}{\\omega^2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$A \\omega^2=g$\n$\\Rightarrow A=g / \\omega^2$",
    "image": null
  },
