  "question": {
    "text": "Starting from the origin, a body oscillates simple harmonically with a period of $2 \\mathrm{~s}$. After what time will its kinetic energy be $75 \\%$ of the total energy?",
    "image": null
  },
  "options": [
    {
      "id": "aOFEr",
      "text": "\n$\\frac{1}{12} \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "znqen",
      "text": "\n$\\frac{1}{6} \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Sei6o",
      "text": "\n$\\frac{1}{4} \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BxKQt",
      "text": "\n$\\frac{1}{3} s$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{1}{2} m v^2=\\frac{3}{4}\\left(\\frac{1}{2} m v_{\\max }^2\\right)$\n$\\mathrm{A}^2 \\omega^2 \\cos ^2 \\omega \\mathrm{t} \\Rightarrow \\frac{3}{4} \\mathrm{~A}^2 \\omega^2$\n$\\cos \\omega \\mathrm{t}=\\frac{\\sqrt{3}}{2}$\n$\\omega t=\\frac{\\pi}{6} \\Rightarrow t=\\frac{1}{6}$ sec",
    "image": null
  },
