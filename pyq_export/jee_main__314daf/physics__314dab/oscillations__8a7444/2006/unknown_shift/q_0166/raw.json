  "question": {
    "text": "The maximum velocity of a particle, executing simple harmonic motion with an amplitude $7 \\mathrm{~mm}$, is $4.4 \\mathrm{~m} / \\mathrm{s}$. The period of oscillation is",
    "image": null
  },
  "options": [
    {
      "id": "uswxO",
      "text": "\n$100 \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eCYUi",
      "text": "\n$0.01 \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "c7K78",
      "text": "\n$10 \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YLzjh",
      "text": "\n$0.1 \\mathrm{~s}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$A \\omega=V_{\\max }$\n$\\mathrm{T}=\\frac{2 \\pi}{\\omega}=\\frac{2 \\pi \\mathrm{A}}{\\mathrm{v}_{\\max }}=0.01 \\mathrm{sec}$",
    "image": null
  },
