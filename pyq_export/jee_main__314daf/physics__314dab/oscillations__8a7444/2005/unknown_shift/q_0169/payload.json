  "question": {
    "text": "If a simple harmonic motion is represented by $\\frac{\\mathrm{d}^2 \\mathrm{x}}{\\mathrm{dt}^2}+\\alpha \\mathrm{x}=0$, its time period is"
  },
  "options": [
    {
      "text": "\n$\\frac{2 \\pi}{\\alpha}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{2 \\pi}{\\sqrt{\\alpha}}$\n",
      "is_correct": true
    },
    {
      "text": "\n$2 \\pi \\alpha$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\pi \\sqrt{\\alpha}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\omega^2=\\alpha$\n$\\omega=\\sqrt{\\alpha}$\n$T=\\frac{2 \\pi}{\\sqrt{\\alpha}}$"
  }
