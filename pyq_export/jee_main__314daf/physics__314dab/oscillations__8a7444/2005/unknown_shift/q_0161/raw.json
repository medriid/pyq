  "question": {
    "text": "If a simple harmonic motion is represented by $\\frac{\\mathrm{d}^2 \\mathrm{x}}{\\mathrm{dt}^2}+\\alpha \\mathrm{x}=0$, its time period is",
    "image": null
  },
  "options": [
