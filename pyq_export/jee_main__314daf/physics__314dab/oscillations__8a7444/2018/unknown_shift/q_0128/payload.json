    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2.2</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
