  "question": {
    "text": "The displacement of an object attached to a spring and executing simple harmonic motion is given by $x=2 \\times 10^{-2} \\cos \\pi t$ metres. The time at which the maximum speed first occurs is"
  },
  "options": [
    {
      "text": "\n$0.5 \\mathrm{~s}$\n",
      "is_correct": true
    },
    {
      "text": "\n$0.75 \\mathrm{~s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.125 \\mathrm{~s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.25 \\mathrm{~s}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{x}=2 \\times 10^{-2} \\cos \\pi t \\\\\n& \\mathrm{v}=-0.02 \\pi \\sin \\pi t\n\\end{aligned}$\n$\\mathrm{v}$ is maximum at $\\mathrm{t}=\\frac{1}{2}=0.5 \\mathrm{~sec}$"
  }
}