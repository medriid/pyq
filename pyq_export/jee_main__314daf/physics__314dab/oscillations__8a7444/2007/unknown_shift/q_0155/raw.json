  "question": {
    "text": "A point mass oscillates along the $x$-axis according to the law $\\mathrm{x=x_0 \\cos (\\omega t-\\pi / 4)}$. If the acceleration of the particle is written as\n$\\mathrm{a=A \\cos (\\omega t+\\delta)}$",
    "image": null
  },
  "options": [
    {
      "id": "mIQmq",
      "text": "\n$\\mathrm{A}=\\mathrm{x}_0, \\delta=-\\pi / 4$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "E0Djh",
      "text": "\n$\\mathrm{A}=\\mathrm{x}_0 \\omega^2, \\delta=-\\pi / 4$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6YE88",
      "text": "\n$\\mathrm{A}=\\mathrm{x}_0 \\omega^2, \\delta=-\\pi / 4$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rbdLy",
      "text": "\n$\\mathrm{A=x_0 \\omega^2, \\delta=3 \\pi / 4}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{v=-x_0 \\omega \\sin (\\omega t-\\pi / 4)}$\n$\\mathrm{a=-x_0 \\omega^2 \\cos \\left(\\omega t+\\pi-\\frac{\\pi}{4}\\right)}$\n$\\mathrm{a=A \\cos (\\omega t+\\delta)}$\n$\\mathrm{A=x_0 \\omega^2 ; \\quad \\delta=\\frac{3 \\pi}{4}}$",
    "image": null
  },
