  "question": {
    "text": "Two bodies A and B of equal mass are suspended from two massless springs of spring constant $k_1$ and $k_2$, respectively. If the bodies oscillate vertically such that their amplitudes are equal, the ratio of the maximum velocity of $A$ to the maximum velocity of $B$ is"
  },
  "options": [
    {
      "text": "$\\frac{\\mathrm{k}_1}{\\mathrm{k}_2}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{\\frac{\\mathrm{k}_1}{\\mathrm{k}_2}}$",
      "is_correct": true
    },
    {
      "text": "$\\sqrt{\\frac{\\mathrm{k}_2}{\\mathrm{k}_1}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{k}_2}{\\mathrm{k}_1}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{V}_1=\\mathrm{A}_1 \\omega_1 \\\\ & \\mathrm{~V}_2=\\mathrm{A}_2 \\omega_2 \\\\ & \\mathrm{~A}_1=\\mathrm{A}_2 \\\\ & \\frac{\\mathrm{~V}_1}{\\mathrm{~V}_2}=\\frac{\\omega_1}{\\omega_2}=\\frac{\\sqrt{\\frac{\\mathrm{K}_1}{\\mathrm{~m}}}}{\\sqrt{\\frac{\\mathrm{~K}_2}{\\mathrm{~m}}}} \\\\ & \\frac{\\mathrm{~V}_1}{\\mathrm{~V}_2}=\\sqrt{\\frac{\\mathrm{K}_1}{\\mathrm{~K}_2}}\\end{aligned}$"
  }
}