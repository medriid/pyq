  "question": {
    "text": "A particle is executing simple harmonic motion with time period 2 s and amplitude 1 cm . If D and d are the total distance and displacement covered by the particle in 12.5 s , then $\\frac{\\mathrm{D}}{\\mathrm{d}}$ is",
    "image": null
  },
  "options": [
    {
      "id": "d4IlE",
      "text": "$\\frac{16}{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v3iwg",
      "text": "$10$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qzxKH",
      "text": "$\\frac{15}{4}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "plAEQ",
      "text": "$25$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "A = 1 cm\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/uf2aSRAqlvDN2cj22DMM0nwdFMx9_7V_ItqgVYGCJIg.original.fullsize.png\"><br>\n\n$\\begin{aligned} & \\mathrm{n}=\\frac{12.5}{2}=6.25 \\text { cycles } \\\\ & \\therefore \\mathrm{D}=4 \\times 6+1=25 \\\\ & \\mathrm{~d}=1 \\\\ & \\frac{D}{d}=25\\end{aligned}$",
    "image": null
  },
