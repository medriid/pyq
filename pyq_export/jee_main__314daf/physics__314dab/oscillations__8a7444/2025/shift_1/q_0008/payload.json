  "question": {
    "text": "A particle is executing simple harmonic motion with time period 2 s and amplitude 1 cm . If D and d are the total distance and displacement covered by the particle in 12.5 s , then $\\frac{\\mathrm{D}}{\\mathrm{d}}$ is"
  },
  "options": [
    {
      "text": "$\\frac{16}{5}$",
      "is_correct": false
    },
    {
      "text": "$10$",
      "is_correct": false
    },
    {
      "text": "$\\frac{15}{4}$",
      "is_correct": false
    },
    {
      "text": "$25$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "A = 1 cm\n<img src=\"assets\\st0008_d913c7581779.png\"><br>\n\n$\\begin{aligned} & \\mathrm{n}=\\frac{12.5}{2}=6.25 \\text { cycles } \\\\ & \\therefore \\mathrm{D}=4 \\times 6+1=25 \\\\ & \\mathrm{~d}=1 \\\\ & \\frac{D}{d}=25\\end{aligned}$"
  }
}