  "question": {
    "text": "Two simple pendulums having lengths $l_1$ and $l_2$ with negligible string mass undergo angular displacements $\\theta_1$ and $\\theta_2$, from their mean positions, respectively. If the angular accelerations of both pendulums are same, then which expression is correct?",
    "image": null
  },
  "options": [
    {
      "id": "ycbuE",
      "text": "$\\theta_1 l_2^2=\\theta_2 l_1^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "K9cDW",
      "text": "$\\theta_1 l_1=\\theta_2 l_2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Vz3d2",
      "text": "$\\theta_1 l_1^2=\\theta_2 l_2^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "twTI9",
      "text": "$\\theta_1 l_2=\\theta_2 l_1$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\omega=\\sqrt{\\frac{\\mathrm{g}}{\\ell}} \\\\ & \\alpha=-\\omega^2 \\theta \\\\ & \\therefore \\frac{\\mathrm{~g}}{\\ell_1} \\theta_1=\\frac{\\mathrm{g}}{\\ell_2} \\theta_2 \\\\ & \\Rightarrow \\theta_1 \\ell_2=\\theta_2 \\ell_2\\end{aligned}$",
    "image": null
  },
