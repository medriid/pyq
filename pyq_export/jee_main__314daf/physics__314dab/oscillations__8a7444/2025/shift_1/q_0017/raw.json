  "question": {
    "text": "A light hollow cube of side length 10 cm and mass 10 g , is floating in water. It is pushed down and released to execute simple harmonic oscillations. The time period of oscillations is $y \\pi \\times 10^{-2} \\mathrm{~s}$, where the value of $y$ is\n(Acceleration due to gravity, $g=10 \\mathrm{~m} / \\mathrm{s}^2$, density of water $=10^3 \\mathrm{~kg} / \\mathrm{m}^3$ )",
    "image": null
  },
  "options": [
    {
      "id": "qrIdt",
      "text": "$6$",
      "image": null,
      "isCorrect": false
    },
