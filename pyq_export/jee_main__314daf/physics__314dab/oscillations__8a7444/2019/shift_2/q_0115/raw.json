  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable><mtr><mtd><mi>P</mi><mi>E</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>k</mi><msup><mi>x</mi><mn>2</mn></msup></mtd><mtd><mo>&#38;</mo><mo>&#160;</mo><mi>K</mi><mi>E</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>K</mi><mfenced separators=\"|\"><mrow><msup><mi>A</mi><mn>2</mn></msup><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced></mtd></mtr></mtable></math><br /><br />As given in question<br /><br /><math><mi>K</mi><mi>E</mi><mo>=</mo><mi>P</mi><mi>E</mi></math><br /><br /><math><mo>&#8658;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>K</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>K</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mo>&#8658;</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mo>&#177;</mo><mfrac><mi>A</mi><msqrt><mn>2</mn></msqrt></mfrac></math></p></blockquote>",
