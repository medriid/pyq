  "question": {
    "text": "The function of time representing a simple&nbsp;harmonic motion with a period of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#960;</mi><mi>&#969;</mi></mfrac></math>&nbsp;is :",
    "image": null
  },
  "options": [
    {
      "id": "FtApK",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mo>(</mo><mi>&#969;</mi><mi>t</mi><mo>)</mo><mo>+</mo><mi>cos</mi><mo>(</mo><mi>&#969;</mi><mi>t</mi><mo>)</mo></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "VjfBB",
