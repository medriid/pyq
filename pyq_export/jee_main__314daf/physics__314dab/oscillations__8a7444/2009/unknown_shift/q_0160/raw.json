  "question": {
    "text": "If $x, v$ and a denote the displacement, the velocity and the acceleration of a particle executing simple harmonic motion of time period $\\mathrm{T}$, then, which of the following does not change with time?",
    "image": null
  },
  "options": [
    {
      "id": "SgX6G",
      "text": "\n$a^2 T^2+4 \\pi^2 v^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cT5kg",
      "text": "\n$\\frac{a T}{x}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "OhQGJ",
      "text": "\n$a T+2 \\pi v$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "P69dA",
      "text": "\n$\\frac{a T}{v}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\frac{\\text { aT }}{\\mathrm{X}}=\\frac{\\omega^2 \\mathrm{XT}}{\\mathrm{X}}=\\frac{4 \\pi^2}{\\mathrm{~T}^2} \\times \\mathrm{T}=\\frac{4 \\pi^2}{\\mathrm{~T}}=\\text { constant. }\n$$",
    "image": null
  },
