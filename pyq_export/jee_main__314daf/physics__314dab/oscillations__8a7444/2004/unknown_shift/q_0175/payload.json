  "question": {
    "text": "A particle at the end of a spring executes simple harmonic motion with a period $t_1$, while the corresponding period for another spring is $t_2$. If the period of oscillation with the two springs in series is $\\mathrm{t}$, then"
  },
  "options": [
    {
      "text": "\n$\\mathrm{T}=\\mathrm{t}_1+\\mathrm{t}_2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\propto \\mathrm{x}^2$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{T}^{-1}=\\mathrm{t}_1^{-1}+\\mathrm{t}_2^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{T}^{-2}=\\mathrm{t}_1^2+\\mathrm{t}_2^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$t_1^2+t_2^2=T^2$"
  }
}