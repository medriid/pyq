  "question": {
    "text": "A particle performs simple harmonic motion with amplitude A. Its speed is tripled at the instant that it is at a distance <math><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math> from equilibrium position. The new amplitude of the motion is:",
    "image": null
  },
  "options": [
    {
      "id": "NxXpi",
      "text": "<math><mi mathvariant=\"normal\">A</mi><msqrt><mn>3</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hHA4H",
      "text": "<math><mfrac><mrow><mn>7</mn><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "gCS77",
      "text": "<math><mfrac><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>3</mn></mrow></mfrac><msqrt><mn>41</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
