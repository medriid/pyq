      "isCorrect": false
    },
    {
      "id": "dXR4u",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hhQOW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "firEJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": true
