  "question": {
    "text": "<p>A galvanometer <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>G</mi></mfenced></math> of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>Ω</mi></math> resistance is connected in the given circuit. The ratio of charge stored in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub></math> is:</p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f605a23c-dd90-4ffa-9f76-8de7f3cce9f3.png\" style=\"width: 200px; height: 242px;\"/>",
    "image": null
  },
  "options": [
    {
      "id": "LboGd",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math>",
