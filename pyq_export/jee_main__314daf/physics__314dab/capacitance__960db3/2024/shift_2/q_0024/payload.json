  "question": {
    "text": "<p>A galvanometer <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>G</mi></mfenced></math> of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>Ω</mi></math> resistance is connected in the given circuit. The ratio of charge stored in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub></math> is:</p><img src=\"assets\\qt0024_f0db939f0193.png\" style=\"width: 200px; height: 242px;\"/>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math>",
      "is_correct": true
    }
