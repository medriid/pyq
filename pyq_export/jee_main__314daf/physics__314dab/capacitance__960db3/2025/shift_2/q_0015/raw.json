  "question": {
    "text": "A parallel plate capacitor of capacitance $1 \\mu \\mathrm{~F}$ is charged to a potential difference of 20 V . The distance between plates is $1 \\mu \\mathrm{~m}$. The energy density between plates of capacitor is.",
    "image": null
  },
  "options": [
    {
      "id": "rWkoo",
      "text": "$2 \\times 10^{-4} \\mathrm{~J} / \\mathrm{m}^3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FjSmk",
      "text": "$1.8 \\times 10^5 \\mathrm{~J} / \\mathrm{m}^3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iDyl1",
      "text": "$1.8 \\times 10^3 \\mathrm{~J} / \\mathrm{m}^3$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UbemP",
      "text": "$2 \\times 10^2 \\mathrm{~J} / \\mathrm{m}^3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} \\text { Energy density } & =\\frac{1}{2} \\varepsilon_0 E^2 \\\\ & =\\frac{1}{2} \\varepsilon_0\\left(\\frac{V}{d}\\right)^2 \\\\ & =\\frac{1}{2}\\left(8.85 \\times 10^{-12}\\right)\\left(\\frac{20}{10^{-6}}\\right)^2 \\mathrm{~J} / \\mathrm{m}^3 \\\\ & \\simeq 1.8 \\times 10^3 \\mathrm{~J} / \\mathrm{m}^3\\end{aligned}$",
    "image": null
  },
