    {
      "text": "$100$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0011_bc2f9a7f3d10.png\"/><br/>New potential $=\\frac{\\mathrm{C}_0 \\mathrm{~V}_0}{\\mathrm{C}_0+\\mathrm{C}}=\\frac{\\mathrm{V}_0}{3}$<br/>$\\begin{aligned} & 3 \\mathrm{C}_0 \\mathrm{~V}_0=\\mathrm{C}_0 \\mathrm{~V}_0+\\mathrm{CV}_0 \\\\ & 2 \\mathrm{C}_0 \\mathrm{~V}_0=\\mathrm{CV}_0 \\\\ & \\mathrm{C} \\Rightarrow 2 \\mathrm{C}_0\\end{aligned}$"
  }
