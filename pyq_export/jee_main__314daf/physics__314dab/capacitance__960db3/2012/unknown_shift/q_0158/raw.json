  "question": {
    "text": "The figure shows an experimental plot for discharging of a capacitor in an $R-C$ circuit. The time constant $\\tau$ of this circuit lies between:\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/r8gwK10wU044A7WkhfnFw8kgA3LJ58N9MiSK_GC-Mx0.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "RkIky",
      "text": "\n$150 \\mathrm{~sec}$ and $200 \\mathrm{~sec}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a4YGg",
      "text": "\n$0$ and $50 \\mathrm{~sec}$\n",
      "image": null,
      "isCorrect": false
    },
