      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>10</mn><mn>3</mn></mfrac><msub><mi>&#949;</mi><mn>0</mn></msub><mo>&#160;</mo><mi mathvariant=\"normal\">F</mi></math>",
