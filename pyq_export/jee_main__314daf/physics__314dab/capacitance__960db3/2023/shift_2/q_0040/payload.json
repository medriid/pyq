  "question": {
    "text": "<p>In the network shown below, the charge accumulated in the capacitor in steady state will be:</p><p><img src=\"assets\\qt0040_64891aaaa05e.png\" style=\"width: 300px; height: 261px;\" /></p><p>&nbsp;</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>.</mo><mn>3</mn><mo>&#160;</mo><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>.</mo><mn>8</mn><mo>&#160;</mo><mi>&#956;</mi><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
