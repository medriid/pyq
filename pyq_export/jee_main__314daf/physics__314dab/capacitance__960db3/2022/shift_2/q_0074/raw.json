      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><mi>&#956;F</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "H7Hfw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>&#160;</mo><mi>&#956;F</mi></math>",
