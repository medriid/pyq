  "level": 1,
  "question": {
    "text": "<p>A parallel plate capacitor with plate area <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and plate separation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>=</mo><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> has a capacitance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mi>&#956;F</mi></math>. The new capacitance of the system if half of the space between them is filled with a dielectric material of dielectric constant <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>K</mi><mo>=</mo><mn>3</mn></math>&nbsp;(as shown in figure) will be</p><p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/fb3a8d2e-b733-41a6-896e-96f585e49e13-image.png\" style=\"width: 150px; height: 181px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "qbwNb",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mi>&#956;F</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "enzaA",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>32</mn><mo>&#160;</mo><mi>&#956;F</mi></math>",
