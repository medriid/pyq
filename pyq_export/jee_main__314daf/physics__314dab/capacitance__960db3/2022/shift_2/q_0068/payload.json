  "question": {
    "text": "<p>The charge on capacitor of capacitance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mi>&#956;</mi><mi mathvariant=\"normal\">F</mi></math> in the figure given below is</p><p><img src=\"assets\\qt0068_b722bde481f3.png\" style=\"width: 200px; height: 147px;\" /></p>"
  },
