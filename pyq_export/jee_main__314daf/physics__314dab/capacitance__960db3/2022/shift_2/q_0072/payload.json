  "question": {
    "text": "If the charge on a capacitor is increased by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>C</mi></math>, the energy stored in it increases by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>44</mn><mo>%</mo></math>. The original charge on the capacitor is (in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math>)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn></math>",
      "is_correct": true
    },
    {
