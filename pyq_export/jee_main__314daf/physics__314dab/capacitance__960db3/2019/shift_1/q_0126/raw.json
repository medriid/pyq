    "text": "<math><mi>C</mi><mo>=</mo><mfrac><mrow><msub><mrow><mo>∈</mo></mrow><mrow><mn>0</mn></mrow></msub><mi>A</mi></mrow><mrow><mi>d</mi></mrow></mfrac></math><br /><br /><math><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mo>∈</mo></mrow><mrow><mn>0</mn></mrow></msub><mi>A</mi></mrow><mrow><mn>3</mn><mi>d</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>C</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><br /><math><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>C</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><br /><math><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>3</mn></mrow></msub><mi>C</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><br /><math> <mrow>  <msub>   <mi>C</mi>   <mrow>    <mi>e</mi><mi>q</mi></mrow>  </msub>  <mo>=</mo><msub>   <mi>K</mi>   <mrow>    <mi>e</mi><mi>q</mi></mrow>  </msub>  <mi>C</mi><mo>=</mo><mfrac>   <mi>C</mi>   <mn>3</mn>  </mfrac>  <mrow><mo>(</mo>   <mrow>    <msub>     <mi>K</mi>     <mn>1</mn>    </msub>    <mo>+</mo><msub>     <mi>K</mi>     <mn>2</mn>    </msub>    <mo>+</mo><msub>     <mi>K</mi>     <mn>3</mn>    </msub>    </mrow>  <mo>)</mo></mrow></mrow></math><br><br /><math><msub><mrow><mi>K</mi></mrow><mrow><mi>e</mi><mi>q</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>K</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>K</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>K</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>36</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mn>12</mn></math>",
