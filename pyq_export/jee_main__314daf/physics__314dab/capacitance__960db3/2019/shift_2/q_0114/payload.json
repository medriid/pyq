  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<p>Let us take the equivalent circuit one by one.<br /><br /><img src=\"assets\\st0114_9706bf6b86e6.png\" style=\"width: 403px; height: 200px;\" /><br /><br /><br /><img src=\"assets\\st0114_455f4b1a414e.png\" /></p><p><img src=\"assets\\st0114_2d8aac9e8108.png\" /><br /><br /><math><mo>&#8756;</mo><msub><mrow><mi>C</mi></mrow><mrow><mi>e</mi><mi>q</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>C</mi><mi>&#160;</mi><mo>&#215;</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow><mrow><mi>C</mi><mo>+</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfrac></math> = 0.5 <math><mo>&#8658;</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mi>C</mi><mo>=</mo><mfrac><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>6</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mn>11</mn><mn>6</mn></mfrac><mi>C</mi><mo>=</mo><mfrac><mn>7</mn><mn>6</mn></mfrac><mi>&#160;</mi><mo>&#8658;</mo><mi>C</mi><mo>=</mo><mfrac><mn>7</mn><mn>11</mn></mfrac><mo>&#160;</mo><mi>&#956;</mi><mi>F</mi></math></p>"
  }
