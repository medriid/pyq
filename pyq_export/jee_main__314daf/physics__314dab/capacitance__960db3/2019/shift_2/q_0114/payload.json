  "question": {
    "text": "<p>In the circuit shown, find <math><mi>C</mi></math> if the effective capacitance of the whole circuit is to be <math><mn>0.5</mn><mi>&#160;</mi><mi>&#956;</mi><mi>F</mi><mo>.</mo></math> All values in the circuit are in <math><mi>&#956;</mi><mi>F</mi><mo>.</mo></math><br /><br /><img height=\"236\" src=\"assets\\qt0114_7ca145725f54.png\" width=\"300\" /></p>"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>7</mn></mrow><mrow><mn>10</mn></mrow></mfrac><mi>μ</mi><mi>F</mi></math>",
