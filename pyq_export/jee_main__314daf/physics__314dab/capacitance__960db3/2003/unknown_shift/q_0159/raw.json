  "question": {
    "text": "The work done in placing a charge of $8 \\times 10^{-18}$ coulomb on a condenser of capacity 100 micro-farad is",
    "image": null
  },
  "options": [
    {
      "id": "3i79L",
      "text": "\n$16 \\times 10^{-32}$ joule\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dIDh5",
      "text": "\n$3.1 \\times 10^{-26}$ joule\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YOCCc",
      "text": "\n$4 \\times 10^{-10}$ joule\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ElKzB",
      "text": "\n$32 \\times 10^{-32}$ joule",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Work done $=\\frac{1}{2} \\frac{\\mathrm{q}^2}{\\mathrm{c}}=\\frac{\\left(8 \\times 10^{-18}\\right)^2}{2 \\times 100 \\times 10^{-8}}=32 \\times 10^{-32} \\mathrm{~J}$",
    "image": null
  },
