      "id": "F40Vv",
      "text": "<math><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>E</mi><mi>&nbsp;</mi><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">exp</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mi>t</mi></mrow><mrow><mi>R</mi><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced></mrow></mrow></mrow></mfenced></math>",
