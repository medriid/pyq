      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<math><msub><mrow><mi>C</mi></mrow><mrow><mi>e</mi><mi>q</mi></mrow></msub></math> of circuit <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>32</mn><mn>9</mn></mfrac><mo>&#160;</mo><mtext>&#956;F</mtext></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>e</mi><mi>x</mi><mi>c</mi><mi>l</mi><mi>u</mi><mi>d</mi><mi>i</mi><mi>n</mi><mi>g</mi><mo>&#160;</mo><mi>C</mi></mrow></mfenced></math><br /><br />Now <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>32</mn><mn>9</mn></mfrac><mtext>&#160;&#956;F</mtext></math>is in series with&nbsp; <math><mi>&#160;</mi><mi>C</mi></math>&nbsp;so,<br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>C</mi></mrow><mrow><mi>e</mi><mi>q</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>C</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>32</mn></mrow></mfrac><mo>=</mo><mn>1</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>C</mi><mo>=</mo><mfrac><mn>32</mn><mn>23</mn></mfrac><mo>&#160;</mo><mtext>&#956;F</mtext></math>"
  }
