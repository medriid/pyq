  "question": {
    "text": "Three capacitors each of <math><mn>4</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#956;</mi><mi mathvariant=\"normal\">F</mi></math> are to be connected in such a way that the effective capacitance is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#956;</mi><mi mathvariant=\"normal\">F</mi></math>. This can be done by connecting them"
  },
  "options": [
    {
      "text": "all in series",
      "is_correct": false
    },
    {
      "text": "all in parallel",
      "is_correct": false
    },
    {
      "text": "two in parallel and one in series",
      "is_correct": false
    },
