  "solution": {
    "text": "<img alt=\"\" src=\"assets\\st0139_2161a0f08675.png\" /><br /><br />For top branch,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msub><mi mathvariant=\"normal\">C</mi><mi>eq</mi></msub></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi mathvariant=\"normal\">C</mi><mi>eq</mi></msub><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">&#160;</mi><mi>&#956;F</mi></math><br /><br />For parallel combination,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mi>net</mi></msub><mo>=</mo><mn>2</mn><mo>+</mo><mn>4</mn><mo>=</mo><mn>6</mn><mi mathvariant=\"normal\">&#160;</mi><mi>&#956;F</mi></math>"
  }
