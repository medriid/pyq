  "correctValue": null,
  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/2f688468-ad5a-4b81-9c64-e845ae49baee-image.png\" style=\"width: 250px; height: 226px;\" /><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mrow><mi>e</mi><mi>q</mi></mrow><mo>=</mo><mn>5</mn><mi>&mu;</mi><mi>F</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Potential</mi><mo>&nbsp;</mo><mi>of</mi><mo>&nbsp;</mo><mn>4</mn><mo>&nbsp;</mo><mi>&mu;F</mi><mo>=</mo><mo>&nbsp;</mo><mn>6</mn><mo>&nbsp;</mo><mi>volt</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&there4;</mo><mi>charge</mi><mo>&nbsp;</mo><mtext>on</mtext><mi>&nbsp;</mi><mn>4</mn><mo>&nbsp;</mo><mi>&mu;F</mi><mo>&nbsp;</mo><mfenced><msub><mtext>q</mtext><mtext>4</mtext></msub></mfenced><mo>=</mo><mn>24</mn><mo>&nbsp;</mo><mi>&mu;C</mi></math><br /><br />Potential of<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&nbsp;</mi><mn>9</mn><mo>&nbsp;</mo><mi>&mu;F</mi><mo>=</mo><mn>2</mn><mi>&nbsp;</mi><mi>volt</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&there4;</mo><mi>charge</mi><mo>&nbsp;</mo><mtext>on</mtext><mi>&nbsp;</mi><mn>9</mn><mo>&nbsp;</mo><mi>&mu;F</mi><mo>&nbsp;</mo><mfenced><msub><mtext>q</mtext><mn>9</mn></msub></mfenced><mo>=</mo><mn>18</mn><mo>&nbsp;</mo><mi>&mu;C</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Total</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi>charge</mi><mo>&nbsp;</mo><mo>(</mo><mi>q</mi><mo>)</mo><mo>=</mo><mn>42</mn><mo>&nbsp;</mo><mi>&mu;C</mi><mi>&nbsp;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mo>=</mo><mfrac><mrow><mi>k</mi><mi>q</mi></mrow><msup><mi>r</mi><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mrow><mn>9</mn><mo>&times;</mo><msup><mn>10</mn><mn>9</mn></msup><mo>&times;</mo><mn>42</mn><mo>&times;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow><mn>900</mn></mfrac><mo>=</mo><mn>420</mn><mi>&n