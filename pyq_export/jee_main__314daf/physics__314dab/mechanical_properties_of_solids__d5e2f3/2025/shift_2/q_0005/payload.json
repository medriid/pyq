  "question": {
    "text": "A cylindrical rod of length 1 m and radius 4 cm is mounted vertically. It is subjected to a shear force of $10^5 \\mathrm{~N}$ at the top. Considering infinitesimally small displacement in the upper edge, the angular displacement $\\theta$ of the rod axis from its original position would be : (shear moduli, $\\left.\\mathrm{G}=10^{10} \\mathrm{~N} / \\mathrm{m}^2\\right)$"
  },
  "options": [
    {
      "text": "$1 / 160 \\pi$",
      "is_correct": true
    },
    {
      "text": "$1 / 4 \\pi$",
      "is_correct": false
    },
    {
      "text": "$1 / 40 \\pi$",
      "is_correct": false
    },
    {
      "text": "$1 / 2 \\pi$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0005_fcefc79648f0.png\"/><br/>$\\begin{aligned} & \\text { Shear moduli }=\\frac{\\sigma_{\\text {shear }}}{\\theta} \\\\ & 10^{10}=\\frac{10^5}{\\pi \\times 16 \\times 10^{-4}} \\times \\frac{1}{\\theta} \\\\ & \\theta=\\frac{1}{160 \\pi} \\text { Radian }\\end{aligned}$"
  }
}