  "question": {
    "text": "The fractional compression \\(\\left(\\frac{\\Delta \\mathrm{V}}{\\mathrm{V}}\\right)\\) of water at the depth of 2.5 km below the sea level is\n______ \\(\\%\\). Given, the Bulk modulus of water \\(=2 \\times 10^9 \\mathrm{~N} \\mathrm{~m}^{-2}\\), density of water \\(=10^3\\) \\(\\mathrm{kg} \\mathrm{m}^{-3}\\), acceleration due to gravity \\(=\\mathrm{g}=10 \\mathrm{~m} \\mathrm{~s}^{-2}\\)."
  },
  "options": [
    {
      "text": "1.25",
      "is_correct": true
    },
    {
      "text": "1.0",
      "is_correct": false
    },
    {
      "text": "1.75",
      "is_correct": false
    },
    {
      "text": "1.5",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{B}=\\frac{\\rho \\mathrm{gh}}{\\left(\\frac{\\Delta \\mathrm{v}}{\\mathrm{v}}\\right)} \\\\ & \\frac{\\Delta \\mathrm{v}}{\\mathrm{v}} \\times 100=\\frac{\\rho \\mathrm{gh}}{\\mathrm{B}} \\times 100 \\\\ & \\frac{1000 \\times 10 \\times 2.5 \\times 10^3}{2 \\times 10^9} \\times 100 \\% \\\\ & =1.25 \\%\\end{aligned}$"
  }
