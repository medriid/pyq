  "level": 1,
  "question": {
    "text": "If the length of a wire is made double and radius is halved of its respective values. Then, the Young&#39;s modulus of the material of the wire will :",
    "image": null
  },
  "options": [
    {
      "id": "wXcD9",
      "text": "Remain same",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "uiLYB",
      "text": "Become <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn></math> times its initial value",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "qO0wi",
      "text": "Become <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mn>1</mn><mrow><mi>th</mi><mo>&#160;</mo></mrow></msup><mn>4</mn></mfrac></math> of its initial value",
      "isCorrect": false,
      "image": null
