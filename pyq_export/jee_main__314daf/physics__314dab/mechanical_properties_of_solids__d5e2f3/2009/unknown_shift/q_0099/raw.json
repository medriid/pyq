  "question": {
    "text": "Two wires are made of the same material and have the same volume. However wire 1 has crosssectional area $A$ and wire-2 has cross-sectional area $3 A$. If the length of wire 1 increases by $\\Delta x$ on applying force $F$, how much force is needed to stretch wire 2 by the same amount?",
    "image": null
  },
  "options": [
    {
      "id": "UhvYa",
      "text": "\n$\\mathrm{F}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1TDsG",
      "text": "\n$4 \\mathrm{~F}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VojTh",
      "text": "\n$6 \\mathrm{~F}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l4CGE",
      "text": "\n$9 \\mathrm{~F}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\mathrm{A}_1 \\ell_1=\\mathrm{A}_2 \\ell_2 \\Rightarrow \\ell_2=\\frac{\\mathrm{A}_1 \\ell_1}{\\mathrm{~A}_2}=\\frac{\\mathrm{A} \\times \\ell_1}{3 \\mathrm{~A}}=\\frac{\\ell_1}{3} \\Rightarrow \\frac{\\ell_1}{\\ell_2}=3 \\\\\n& \\Delta \\mathrm{x}_1=\\frac{\\mathrm{F}_1}{\\mathrm{~A} \\gamma} \\times \\ell_1 \\\\\n& \\Delta \\mathrm{x}_2=\\frac{\\mathrm{F}_2}{3 \\mathrm{~A} \\gamma} \\ell_2 \\\\\n& \\text { Here } \\Delta \\mathrm{x}_1=\\Delta \\mathrm{x}_2 \\\\\n& \\frac{\\mathrm{F}_2}{3 \\mathrm{~A} \\gamma} \\ell_2=\\frac{\\mathrm{F}_1}{\\mathrm{~A} \\gamma} \\ell_1 \\\\\n& \\left.\\mathrm{~F}_2=3 \\mathrm{~F}_1 \\times \\frac{\\ell_1}{\\ell_2}=3 \\mathrm{~F}_1 \\times 3=\\mathrm{i}\\right)\n\\end{aligned}\n$$",
    "image": null
  },
