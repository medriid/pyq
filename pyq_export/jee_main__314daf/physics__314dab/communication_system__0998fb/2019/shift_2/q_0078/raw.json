  "question": {
    "text": "An amplitude modulated signal is plotted below:\r\n\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/EIshpPzbES-q6rjIm6ueDabb6ymymsVkzuKhyE_nVGQ.original.fullsize.png\"><br>\r\n\r\nWhich one of the following best describes the above\r\n\r\nsignal?",
    "image": null
  },
  "options": [
    {
      "id": "FlJx8",
      "text": "$\\left(9+\\sin \\left(2.5 \\pi \\times 10^{5} \\mathrm{t}\\right)\\right) \\sin \\left(2 \\pi \\times 10^{4} \\mathrm{t}\\right) \\mathrm{V}$",
      "isCorrect": false,
      "image": null
    },
    {
