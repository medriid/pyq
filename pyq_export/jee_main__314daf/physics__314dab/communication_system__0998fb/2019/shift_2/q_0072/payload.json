  "options": [
    {
      "text": "proportional to carrier frequency",
      "is_correct": false
    },
    {
      "text": "independent of both carrier and modulation frequency",
      "is_correct": false
    },
    {
      "text": "inversely proportional to modulation frequency",
      "is_correct": false
