  "question": {
    "text": "If the sum of the heights of transmitting and receiving antennas in the line of sight of communication is fixed at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>160</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>,</mo></math>&nbsp;then the maximum range of LOS communication is _______&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>km</mi></math>&nbsp;(Take radius of Earth <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>6400</mn><mo>&#160;</mo><mi>km</mi></math>)"
  },
  "options": [],
  "correct_answer": "64",
