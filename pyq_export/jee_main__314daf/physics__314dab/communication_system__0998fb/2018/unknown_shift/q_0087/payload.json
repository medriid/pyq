      "is_correct": false
    },
    {
      "text": "<math><mn>2</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>5</mn></mrow></msup></math>",
      "is_correct": true
    }
  ],
  "correct_answer": [
