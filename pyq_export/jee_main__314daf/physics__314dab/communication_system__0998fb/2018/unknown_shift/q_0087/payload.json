  ],
  "solution": {
    "text": "Number of telephonic channels that can be transmitted simultaneously,&nbsp;<br /><br /><math><mo>=</mo><mfrac><mrow><mn>0.1</mn><mo>&#215;</mo><mn>10</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>9</mn></mrow></msup></mrow><mrow><mn>5</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mo>=</mo><mn>2</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>5</mn></mrow></msup></math>"
  }
