  "question": {
    "text": "The height of transmitting antenna is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>180</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> and the height of the receiving antenna is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>245</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>. The maximum distance between them for satisfactory communication in line of sight will be:&nbsp;(given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mn>6400</mn><mo>&#160;</mo><mi>km</mi></math>)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>96</mn><mo>&#160;</mo><mi>km</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>56</mn><mo>&#160;</mo><mi>km</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>48</mn><mo>&#160;</mo><mi>km</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>104</mn><mo>&#160;</mo><mi>km</mi></math>",
