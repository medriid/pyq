  "question": {
    "text": "<p>By what percentage will the transmission range of a TV tower be affected when the height of the tower is increased by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn><mo>%</mo></math>?</p>",
    "image": null
  },
  "options": [
    {
      "id": "WJq6D",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>%</mo></math>",
