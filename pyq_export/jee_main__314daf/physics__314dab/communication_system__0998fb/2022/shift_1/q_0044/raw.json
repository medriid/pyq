  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "A baseband signal of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>5</mn><mi>MHz</mi></math> frequency is modulated with a carrier signal of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>5</mn><mi>GHz</mi></math> frequency using amplitude modulation method. What should be the minimum size of antenna required to transmit the modulated signal ?",
    "image": null
  },
  "options": [
    {
      "id": "x3Mk1",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>42</mn><mo>.</mo><mn>8</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>",
      "isCorrect": false,
