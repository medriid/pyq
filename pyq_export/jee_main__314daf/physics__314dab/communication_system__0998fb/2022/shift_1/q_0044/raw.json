    },
    {
      "id": "aCx5O",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>42</mn><mo>.</mo><mn>8</mn><mo>&#160;</mo><mi>mm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "HtiHT",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn><mo>.</mo><mn>4</mn><mo>&#160;</mo><mi>mm</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "fxLDi",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn><mo>.</mo><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>",
      "isCorrect": false,
