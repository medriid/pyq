  "question": {
    "text": "A radio can tune to any station in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>MHz</mi></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mi>MHz</mi></math> band. The value of corresponding wavelength bandwidth will be"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>",
