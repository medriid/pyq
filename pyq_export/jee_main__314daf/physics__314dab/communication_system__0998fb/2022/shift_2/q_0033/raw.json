    },
    {
      "id": "BFZT7",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>250</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>",
      "isCorrect": false,
