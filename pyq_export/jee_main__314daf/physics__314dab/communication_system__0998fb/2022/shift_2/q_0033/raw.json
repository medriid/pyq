  "question": {
    "text": "The TV transmission tower at a particular station has a height of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>125</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>. For doubling the coverage of its range, the height of the tower should be increased by",
    "image": null
  },
  "options": [
    {
      "id": "UMxnk",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>500</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>",
