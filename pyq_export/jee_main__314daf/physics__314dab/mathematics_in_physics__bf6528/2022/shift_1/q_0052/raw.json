  "solution": {
    "text": "<p>We know,</p><p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>-</mo><mpadded lspace=\"-2px\"><mo>&#160;</mo><mi>cos</mi><mo>&#160;</mo><mi>&#952;</mi></mpadded><mo>=</mo><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mfenced><mspace linebreak=\"newline\"/><mn>1</mn><mo>+</mo><mpadded lspace=\"-2px\"><mo>&#160;</mo><mi>cos</mi><mo>&#160;</mo><mi>&#952;</mi></mpadded><mo>=</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mfenced><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mfenced></math></p><p>Now,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>+</mo><mn>2</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>+</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><msup><mfenced><mn>1</mn></mfenced><mn>2</mn></msup><mo>+</mo><mn>2</mn><mo>&#215;</mo><mn>1</mn><mo>&#215;</mo><mn>1</mn><mo>&#215;</mo><mi>cos</mi><mi>&#952;</mi><mo>+</mo><msup><mfenced><mn>1</mn></mfenced><mn>2</mn></msup><mo>&#160;</mo><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>2</mn><mfenced><mrow><mn>1</mn><mo>+</mo><mi>cos</mi><mi>&#952;</mi></mrow></mfenced><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mn>4</mn><msup><mi>cos</mi><mn>2</mn></msup><mfenced><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mfenced><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>2</mn><mi>cos</mi><mfenced><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mfenced><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mn>1</mn><mo>)</mo></math></p><p>Similarly,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>+</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><msup><mfenced><mn>1</mn></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><mo>&#215;</mo><mn>1</mn><mo>&#215;</mo><mn>1</mn><mo>&#215;</mo><mi>cos</mi><mi>&#952;</mi><mo>+</mo><msup><mfenced><mn>1</mn></mfenced><mn>2</mn></msup><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>2</mn><mfenced><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi></mrow></mfenced><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mn>4</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mfenced><mspace linebreak=\"newline\"></mspace><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>2</mn><mi>sin</mi><mo>&#160;</mo><mfenced><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mfenced><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mn>2</mn><mo>)</mo></math></p><p>Therefore,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>A</mi><mo>^</mo></mover><mo>-</mo><mover><mi>B</mi><mo>^</mo></mover></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>A</mi><mo>^</mo></mover><mo>+</mo><mover><mi>B</mi><mo>^</mo></mover></mrow></mfenced><mfrac><mstyle displaystyle=\"true\"><mi>tan</mi><mi>&#952;</mi></mstyle><mn>2</mn></mfrac></math></p>",
