      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi>A</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mi>A</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn></math>",
