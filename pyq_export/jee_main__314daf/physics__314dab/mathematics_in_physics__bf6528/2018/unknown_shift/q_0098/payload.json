  "solution": {
    "text": "If <math><mover accent=\"true\"><mrow><mi>C</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>a</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mi>&#160;</mi><mo>+</mo><mi>&#160;</mi><mi>b</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> then,&nbsp;<br /><math><mover accent=\"true\"><mrow><mi>A</mi></mrow><mo>&#8594;</mo></mover><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>C</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>A</mi></mrow><mo>&#8594;</mo></mover><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>B</mi></mrow><mo>&#8594;</mo></mover></math> <math><mi>&#160;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mi mathvariant=\"normal\">i</mi><mo>)</mo></math><br /><math><mover accent=\"true\"><mrow><mi>B</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>C</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>A</mi></mrow><mo>&#8594;</mo></mover><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>B</mi></mrow><mo>&#8594;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>-</mo><mi>b</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mi>ii</mi><mo>)</mo></math><br />solving equations <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">i</mi><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>ii</mi><mo>)</mo></math> we get,&nbsp;<br /><math><mi>a</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mi>&#160;</mi><mi>b</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>C</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mi>&#160;</mi><msqrt><mfrac><mrow><mn>1</mn></mrow><mrow><mn>9</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn></mrow><mrow><mn>9</mn></mrow></mfrac></msqrt><mo>=</mo><mi>&#160;</mi><msqrt><mfrac><mrow><mn>5</mn></mrow><mrow><mn>9</mn></mrow></mfrac></msqrt></math>"
