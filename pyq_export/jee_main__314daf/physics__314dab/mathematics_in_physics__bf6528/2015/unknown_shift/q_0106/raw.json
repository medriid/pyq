  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/4aa80495-9919-48d9-9174-2a199791e1de-image.png\" style=\"width: 279px; height: 150px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>B</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover><mi>B</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>A</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><msqrt><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>+</mo><mn>2</mn><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mi>cos</mi><mfenced separators=\"|\"><mrow><mn>180</mn><mo>&#176;</mo><mo>-</mo><mo>&#8710;</mo><mi>&#952;</mi></mrow></mfenced></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mi>cos</mi><mo>&#8710;</mo><mi>&#952;</mi></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mn>2</mn><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>A</mi><mo>&#85