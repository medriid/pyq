  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>P</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mn>2</mn><mi>F</mi><mo>,</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>Q</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mn>3</mn><mi>F</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>R</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><msqrt><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>P</mi><mi>Q</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#952;</mi></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mn>4</mn><msup><mi>F</mi><mn>2</mn></msup><mo>+</mo><mn>9</mn><msup><mi>F</mi><mn>2</mn></msup><mo>+</mo><mn>12</mn><msup><mi>F</mi><mn>2</mn></msup><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#952;</mi></msqrt><mo>=</mo><mi>F</mi><msqrt><mn>13</mn><mo>+</mo><mn>12</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#952;</mi></msqrt></math><br /><br />If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi></math> is doubled<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover><mi>R</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><msqrt><mn>4</mn><msup><mi>F</mi><mn>2</mn></msup><mo>+</mo><mn>36</mn><msup><mi>F</mi><mn>2</mn></msup><mo>+</mo><mn>24</mn><msup><mi>F</mi><mn>2</mn></msup><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#952;</mi></msqrt><mo>=</mo><mi>F</mi><msqrt><mn>40</mn><mo>+</mo><mn>24</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</