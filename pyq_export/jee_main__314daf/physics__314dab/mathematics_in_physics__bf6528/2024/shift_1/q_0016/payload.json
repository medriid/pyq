  "question": {
    "text": "The angle between vector $\\vec{Q}$ and the resultant of $(2 \\vec{Q}+2 \\vec{P})$ and $(2 \\vec{Q}-2 \\vec{P})$ is :"
  },
  "options": [
    {
      "text": "$\\tan ^{-1} \\frac{(2 \\vec{Q}-2 \\vec{P})}{2 \\vec{Q}+2 \\vec{P}}$",
      "is_correct": false
    },
    {
      "text": "$0^{\\circ}$",
      "is_correct": true
    },
    {
      "text": "$\\tan ^{-1}(\\mathrm{P} / \\mathrm{Q})$",
      "is_correct": false
    },
    {
      "text": "$\\tan ^{-1}(2 \\mathrm{Q} / \\mathrm{P})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& \\overrightarrow{\\mathrm{R}}=(2 \\overrightarrow{\\mathrm{Q}}+2 \\overrightarrow{\\mathrm{P}})+(2 \\overrightarrow{\\mathrm{Q}}-2 \\overrightarrow{\\mathrm{P}}) \\\\\n& \\overrightarrow{\\mathrm{R}}=4 \\overrightarrow{\\mathrm{Q}}\n\\end{aligned}$\nAngle between $\\vec{Q}$ and $\\vec{R}$ is zero."
