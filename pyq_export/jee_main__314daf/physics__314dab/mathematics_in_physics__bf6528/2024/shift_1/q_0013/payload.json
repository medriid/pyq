  "question": {
    "text": "In an expression $a \\times 10^{\\mathrm{b}}$;"
  },
  "options": [
    {
      "text": "$b$ is order of magnitude for $a \\geq 5$",
      "is_correct": false
    },
    {
      "text": "$b$ is order of magnitude for $a \\leq 5$",
      "is_correct": true
    },
    {
      "text": "$a$ is order of magnitude for $b \\leq 5$",
      "is_correct": false
    },
    {
      "text": "$b$ is order of magnitude for $5 < a \\leq 10$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & a \\times 10^b \\\\ & \\text { if } a \\leq 5 \\text { order is } b \\\\ & a>5 \\text { order is } b+1\\end{aligned}$"
