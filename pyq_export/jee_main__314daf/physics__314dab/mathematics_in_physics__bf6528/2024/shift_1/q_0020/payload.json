  "question": {
    "text": "In an experiment to measure focal length $(f)$ of convex lens, the least counts of the measuring scales for the position of object $(\\mathrm{u})$ and for the position of image $(\\mathrm{v})$ are $\\Delta \\mathrm{u}$ and $\\Delta \\mathrm{v}$, respectively. The error in the measurement of the focal length of the convex lens will be:"
  },
  "options": [
    {
      "text": "$2 f\\left[\\frac{\\Delta \\mathrm{u}}{\\mathrm{u}}+\\frac{\\Delta \\mathrm{v}}{\\mathrm{v}}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\Delta \\mathrm{u}}{\\mathrm{u}}+\\frac{\\Delta \\mathrm{v}}{\\mathrm{v}}$",
      "is_correct": false
    },
    {
      "text": "$f^2\\left[\\frac{\\Delta \\mathrm{u}}{\\mathrm{u}^2}+\\frac{\\Delta \\mathrm{v}}{\\mathrm{v}^2}\\right]$",
      "is_correct": true
    },
    {
      "text": "$f\\left[\\frac{\\Delta \\mathrm{u}}{\\mathrm{u}}+\\frac{\\Delta \\mathrm{v}}{\\mathrm{v}}\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{f}^{-1}=\\mathrm{v}^{-1}-\\mathrm{u}^{-1} \\\\ & -\\mathrm{f}^{-2} \\mathrm{df}=-\\mathrm{v}^{-2} \\mathrm{dv}-\\mathrm{u}^{-2} \\mathrm{du} \\\\ & \\frac{\\mathrm{df}}{\\mathrm{f}^2}=\\frac{\\mathrm{dv}}{\\mathrm{v}^2}+\\frac{\\mathrm{du}}{\\mathrm{u}^2} \\\\ & \\mathrm{df}=\\mathrm{f}^2\\left[\\frac{\\mathrm{dv}}{\\mathrm{v}^2}+\\frac{\\mathrm{du}}{\\mathrm{u}^2}\\right]\\end{aligned}$"
  }
}