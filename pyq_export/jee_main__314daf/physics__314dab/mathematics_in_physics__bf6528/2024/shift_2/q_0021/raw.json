  "question": {
    "text": "If two vectors <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>A</mi><mo>→</mo></mover></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>B</mi><mo>→</mo></mover></math> having equal magnitude <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> are inclined at an angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>θ</mi></math>, then",
    "image": null
  },
  "options": [
    {
      "id": "iL5OU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>A</mi><mo>→</mo></mover><mo>−</mo><mover><mi>B</mi><mo>→</mo></mover></mrow></mfenced><mo>=</mo><msqrt><mn>2</mn></msqrt><mi>R</mi><mi>sin</mi><mfenced><mfrac><mi>θ</mi><mn>2</mn></mfrac></mfenced></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6CZxL",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>A</mi><mo>→</mo></mover><mo>+</mo><mover><mi>B</mi><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>2</mn><mi>R</mi><mi>sin</mi><mfenced><mfrac><mi>θ</mi><mn>2</mn></mfrac></mfenced></math>",
      "image": null,
