  "question": {
    "text": "A particle is moving eastwards with a velocity of $5 \\mathrm{~m} / \\mathrm{s}$ in 10 seconds the velocity changes to $5 \\mathrm{~m} / \\mathrm{s}$ northwards. The average acceleration in this time is"
  },
  "options": [
    {
      "text": "\n$\\frac{1}{\\sqrt{2}} \\mathrm{~m} / \\mathrm{s}^2$ towards north-east\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{2} \\mathrm{~m} / \\mathrm{s}^2$ towards north.\n",
      "is_correct": false
    },
    {
      "text": "\nzero\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{\\sqrt{2}} \\mathrm{~m} / \\mathrm{s}^2$ towards north-west",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0116_a2df9a4bacbf.png\"><br>\n$\\overrightarrow{\\mathrm{a}}=\\frac{\\overrightarrow{\\mathrm{V}}_{\\mathrm{f}}-\\overrightarrow{\\mathrm{V}}_{\\mathrm{i}}}{\\mathrm{t}}$\n$=\\frac{5 \\hat{\\mathrm{j}}-5 \\hat{\\mathrm{i}}}{10}=\\frac{1}{2}(\\hat{\\mathrm{j}}-\\hat{\\mathrm{i}})$\n$\\therefore \\mathrm{a}=\\frac{1}{\\sqrt{2}} \\mathrm{~ms}^{-2}$ towards north west"
  }
