  "question": {
    "text": "A particle is moving eastwards with a velocity of $5 \\mathrm{~m} / \\mathrm{s}$ in 10 seconds the velocity changes to $5 \\mathrm{~m} / \\mathrm{s}$ northwards. The average acceleration in this time is",
    "image": null
  },
  "options": [
    {
      "id": "HP7nE",
      "text": "\n$\\frac{1}{\\sqrt{2}} \\mathrm{~m} / \\mathrm{s}^2$ towards north-east\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "99Qjz",
      "text": "\n$\\frac{1}{2} \\mathrm{~m} / \\mathrm{s}^2$ towards north.\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gT2mK",
      "text": "\nzero\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZO6wK",
      "text": "\n$\\frac{1}{\\sqrt{2}} \\mathrm{~m} / \\mathrm{s}^2$ towards north-west",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/DnkLlTuuFf3PWK4Rrf2oJAlTLbKmfb5xE6-eRvhLZR4.original.fullsize.png\"><br>\n$\\overrightarrow{\\mathrm{a}}=\\frac{\\overrightarrow{\\mathrm{V}}_{\\mathrm{f}}-\\overrightarrow{\\mathrm{V}}_{\\mathrm{i}}}{\\mathrm{t}}$\n$=\\frac{5 \\hat{\\mathrm{j}}-5 \\hat{\\mathrm{i}}}{10}=\\frac{1}{2}(\\hat{\\mathrm{j}}-\\hat{\\mathrm{i}})$\n$\\therefore \\mathrm{a}=\\frac{1}{\\sqrt{2}} \\mathrm{~ms}^{-2}$ towards north west",
    "image": null
  },
