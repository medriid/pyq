    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>F</mi><mo>&#8594;</mo></mover><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>F</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></math> at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#952;</mi><mn>1</mn></msub></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>1</mn></mrow></msub><mo>=</mo><msqrt><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>1</mn></msub></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>2</mn></mrow></msub><mo>=</mo><msqrt><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>2</mn></msub></msqrt></math><br />If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>1</mn></mrow></msub><mo>=</mo><msqrt><mn>3</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced></msqrt><mo>=</mo><msqrt><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>1</m