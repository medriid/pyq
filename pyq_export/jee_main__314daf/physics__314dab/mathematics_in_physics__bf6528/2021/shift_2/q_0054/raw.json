  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>F</mi><mo>&#8594;</mo></mover><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>F</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></math> at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#952;</mi><mn>1</mn></msub></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>1</mn></mrow></msub><mo>=</mo><msqrt><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>1</mn></msub></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>2</mn></mrow></msub><mo>=</mo><msqrt><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>2</mn></msub></msqrt></math><br />If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>1</mn></mrow></msub><mo>=</mo><msqrt><mn>3</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced></msqrt><mo>=</mo><msqrt><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>1</mn></msub></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;</mo><mi>cos</mi><msub><mi>&#952;</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;</mo><msub><mi>&#952;</mi><mn>1</mn></msub><mo>=</mo><mn>60</mn><mo>&#176;</mo></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>n</mi><mi>e</mi><mi>t</mi><mo>&#160;</mo><mn>2</mn></mrow></msub><mo>=</mo><msqrt><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced></msqrt><mo>=</mo><msqrt><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><mn>2</mn><mfenced><mrow><msup><mi>P</mi><mn>2</mn></msup><mo>+</mo><msup><mi>Q</mi><mn>2</mn></msup></mrow></mfenced><mi>cos</mi><msub><mi>&#952;</mi><mn>2</mn></msub></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;</mo><mi>cos</mi><msub><mi>&#952;</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn><mo>&#160;&#160;</mo><mo>&#8658;</mo><mo>&#160;&#160;</mo><msub><mi>&#952;</mi><mn>2</mn></msub><mo>=</mo><mn>90</mn><mo>&#176;</mo></math><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/23b2655f-a6eb-4e5e-9efd-f5a4073c8f6c-image.png\" style=\"width: 340px; height: 241px;\" />",
