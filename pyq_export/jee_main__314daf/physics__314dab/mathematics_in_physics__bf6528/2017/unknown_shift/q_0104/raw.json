    "text": "<math><mi>P</mi><mo>=</mo><msup><mrow><mi>a</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><mi>&#160;</mi><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>c</mi></mrow><mrow><mn>3</mn></mrow></msup><msup><mrow><mi>d</mi></mrow><mrow><mo>-</mo><mn>4</mn></mrow></msup></math><br /><br /><math><msub><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mo>&#8710;</mo><mi>p</mi></mrow><mrow><mi>p</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mi>m</mi><mi>a</mi><mi>x</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mfrac><mrow><mo>&#8710;</mo><mi>a</mi></mrow><mrow><mi>a</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mfrac><mrow><mo>&#8710;</mo><mi>b</mi></mrow><mrow><mi>b</mi></mrow></mfrac><mo>+</mo><mn>3</mn><mfrac><mrow><mo>&#8710;</mo><mi>c</mi></mrow><mrow><mi>c</mi></mrow></mfrac><mo>+</mo><mn>4</mn><mfrac><mrow><mo>&#8710;</mo><mi>d</mi></mrow><mrow><mi>d</mi></mrow></mfrac></math><br /><br /><math><mn>100</mn><mo>&#215;</mo><mfrac><mrow><mo>&#8710;</mo><mi>P</mi></mrow><mrow><mi>P</mi></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mfrac><mrow><mo>&#8710;</mo><mi>a</mi></mrow><mrow><mi>a</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mfrac><mrow><mo>&#8710;</mo><mi>b</mi></mrow><mrow><mi>b</mi></mrow></mfrac><mo>+</mo><mn>3</mn><mfrac><mrow><mo>&#8710;</mo><mi>c</mi></mrow><mrow><mi>c</mi></mrow></mfrac><mo>+</mo><mn>4</mn><mfrac><mrow><mo>&#8710;</mo><mi>d</mi></mrow><mrow><mi>d</mi></mrow></mfrac></mrow></mfenced><mo>&#215;</mo><mn>100</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>%</mi><mtext>&#160;error&#160;in</mtext><mi>&#160;</mi><mi>P</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#215;</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>&#215;</mo><mn>1</mn><mo>+</mo><mn>3</mn><mi>&#160;