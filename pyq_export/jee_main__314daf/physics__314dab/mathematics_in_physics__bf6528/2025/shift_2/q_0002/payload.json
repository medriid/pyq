  "question": {
    "text": "A quantity Q is formulated as $\\mathrm{X}^{-2} \\mathrm{Y}^{+\\frac{3}{2}} \\mathrm{Z}^{-\\frac{2}{5}} \\cdot \\mathrm{X}, \\mathrm{Y}$ and Z are independent parameters which have fractional errors of $0.1,0.2$ and 0.5 , respectively in measurement. The maximum fractional error of Q is"
  },
  "options": [
    {
      "text": "0.1",
      "is_correct": false
    },
    {
      "text": "0.8",
      "is_correct": false
    },
    {
      "text": "0.7",
      "is_correct": true
    },
    {
      "text": "0.6",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Fractional error }=2 \\frac{\\Delta X}{X}+\\frac{3}{2} \\frac{\\Delta Y}{Y}+\\frac{2}{5} \\frac{\\Delta Z}{Z} \\\\ & =2(0.1)+\\frac{3}{2}(0.2)+\\frac{2}{5}(0.5) \\\\ & =0.2+0.3+0.2=0.7\\end{aligned}$"
  }
}