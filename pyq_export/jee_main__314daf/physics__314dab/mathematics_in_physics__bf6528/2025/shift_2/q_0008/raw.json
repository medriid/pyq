  "question": {
    "text": "The maximum percentage error in the measurment of density of a wire is [Given, mass of wire $=(0.60 \\pm 0.003) \\mathrm{g}$\nradius of wire $=(0.50 \\pm 0.01) \\mathrm{cm}$\nlength of wire $=(10.00 \\pm 0.05) \\mathrm{cm}]$",
    "image": null
  },
  "options": [
