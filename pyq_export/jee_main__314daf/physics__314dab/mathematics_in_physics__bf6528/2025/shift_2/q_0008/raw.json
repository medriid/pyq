  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{d}=\\frac{\\mathrm{m}}{\\text { vol. }}=\\frac{\\mathrm{m}}{\\pi \\mathrm{R}^2 \\ell} \\Rightarrow \\frac{\\mathrm{~d} \\rho}{\\rho}=\\frac{\\mathrm{dm}}{\\mathrm{m}}+\\frac{2 \\mathrm{dR}}{\\mathrm{R}}+\\frac{\\mathrm{d} \\ell}{\\ell} \\\\ & \\Rightarrow \\frac{\\mathrm{d} \\rho}{\\rho}=\\left(\\frac{0.003}{0.6}+\\frac{2 \\times 0.01}{0.5}+\\frac{0.05}{10}\\right) 100=5 \\%\\end{aligned}$",
    "image": null
  },
