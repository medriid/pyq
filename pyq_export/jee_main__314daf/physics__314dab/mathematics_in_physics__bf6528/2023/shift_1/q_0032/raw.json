  "question": {
    "text": "Two forces having magnitude <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi mathvariant=\"normal\">A</mi><mn>2</mn></mfrac></math>&nbsp;are perpendicular to each other. The magnitude of their resultant is:",
    "image": null
  },
  "options": [
    {
      "id": "28Cof",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>5</mn></msqrt><mi mathvariant=\"normal\">A</mi></mrow><mn>4</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZjFR5",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>5</mn></msqrt><mi mathvariant=\"normal\">A</mi></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "N06W9",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>5</mn><mi mathvariant=\"normal\">A</mi></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xfOAy",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>5</mn></msqrt><msup><mi mathvariant=\"normal\">A</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
