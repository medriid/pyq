    "text": "<blockquote><p>For Block A:<br /><img src=\"assets\\st0121_44dd0be0dae8.png\" style=\"width: 300px; height: 188px;\" /><br /><math><mi mathvariant=\"normal\">N</mi><mo>=</mo><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">g</mi><mo>+</mo><mi mathvariant=\"normal\">F</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>30</mn><mo>&#176;</mo></mrow></mrow></math><br /><math><mo>=</mo><mn>5</mn><mo>&#215;</mo><mn>10</mn><mo>+</mo><mn>20</mn><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>=</mo><mn>60</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">N</mi></math><br /><math><msub><mrow><mi mathvariant=\"normal\">f</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>0.2</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>60</mn></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><mn>12</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">N</mi></math><br /><math><mi mathvariant=\"normal\">F</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mn>30</mn><mo>&#176;</mo><mi mathvariant=\"normal\">&#160;</mi><mo>&#8211;</mo><msub><mrow><mi mathvariant=\"normal\">f</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi></mrow></msub><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">a</mi></mrow></mrow></math><br /><math><mn>20</mn><mfrac><mrow><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac></math> <math><mo>-</mo><mn>12</mn><mo>=</mo><mn>5</mn><mo>&#215;</mo><mi mathvariant=\"normal\">a</mi></math><br /><math><mo>&#8658;</mo><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>10</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>12</mn></mrow><mrow><mn>5</mn></mrow></mfrac></math> &hellip;&helli