      "text": "<math><mfrac><mrow><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>4</mn></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "WS8hk",
      "text": "<math><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XLeCF",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "isCorrect": false,
