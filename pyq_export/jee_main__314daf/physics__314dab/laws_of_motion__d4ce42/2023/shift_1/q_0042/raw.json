      "isCorrect": false
    },
    {
      "id": "o8FwY",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>In</mi><mo>&#160;</mo><mi>x</mi><mo>-</mo><mi>y</mi></math> plane",
      "image": null,
