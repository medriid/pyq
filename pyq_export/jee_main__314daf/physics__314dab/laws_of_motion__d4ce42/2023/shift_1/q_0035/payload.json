  "question": {
    "text": "A coin placed on a rotating table just slips when it is placed at a distance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi>cm</mi></math> from the centre. If the angular velocity of the table is halved, it will just slip when placed at a distance of _____ from the centre:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mo>&#160;</mo><mi>cm</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "is_correct": false
