  "question": {
    "text": "A block of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> slides down the plane inclined at angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#176;</mo></math> with an acceleration <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>g</mi><mn>4</mn></mfrac></math> . The value of coefficient of kinetic friction will be :",
    "image": null
  },
