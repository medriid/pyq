    },
    {
      "id": "agDLM",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "VUPCB",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>",
      "isCorrect": false,
      "image": null
    }
