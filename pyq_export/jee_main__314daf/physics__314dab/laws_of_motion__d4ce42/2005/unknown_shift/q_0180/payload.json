  "question": {
    "text": "A block is kept on a frictionless inclined surface with angle of inclination $\\alpha$. The incline is given an acceleration a to keep the block stationary. Then a is equal to\n<img src=\"assets\\qt0180_a4b502f81055.png\"><br>"
  },
  "options": [
    {
      "text": "\n$\\mathrm{g} / \\tan \\alpha$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{g} \\operatorname{cosec} \\alpha$\n",
      "is_correct": false
    },
    {
      "text": "\ng\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{g} \\operatorname{tan} \\alpha$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0180_225d7d72bc60.png\"><br>\n$m g \\sin \\alpha=m a \\cos \\alpha$\n$\\therefore \\mathrm{a}=\\mathrm{g} \\tan \\alpha$"
  }
}