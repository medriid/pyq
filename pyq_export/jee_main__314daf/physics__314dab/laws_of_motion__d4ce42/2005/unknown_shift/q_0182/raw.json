  "question": {
    "text": "A smooth block is released at rest on a $45^{\\circ}$ incline and then slides a distance d. The time taken to slide is $\\mathrm{n}$ times as much to slide on rough incline than on a smooth incline. The coefficient of friction is",
    "image": null
  },
  "options": [
    {
      "id": "sooTq",
      "text": "\n$\\mu_{\\mathrm{k}}=1-\\frac{1}{\\mathrm{n}^2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "2npvv",
      "text": "\n$\\mu_{\\mathrm{k}}=\\sqrt{1-\\frac{1}{\\mathrm{n}^2}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aWLQq",
      "text": "\n$\\mu_s=1-\\frac{1}{n^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7PS4Y",
      "text": "\n$\\mu_s=\\sqrt{1-\\frac{1}{n^2}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{d}=\\frac{1}{2} \\frac{\\mathrm{g}}{\\sqrt{2}} \\mathrm{t}_1^2$\n$\\mathrm{~d}=\\frac{1}{2} \\frac{\\mathrm{g}}{\\sqrt{2}}\\left(1-\\mu_{\\mathrm{k}}\\right) \\mathrm{t}_2^2$\n$\\frac{\\mathrm{t}_2^2}{\\mathrm{t}_1^2}=\\mathrm{n}^2=\\frac{1}{1-\\mu_{\\mathrm{k}}}$",
    "image": null
  },
