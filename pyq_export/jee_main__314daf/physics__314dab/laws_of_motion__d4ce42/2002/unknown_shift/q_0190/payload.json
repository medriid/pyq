  "question": {
    "text": "The minimum velocity (in $\\mathrm{ms}^{-1}$ ) with which a car driver must traverse a flat curve of radius $150 \\mathrm{~m}$ and coefficient of friction $0.6$ to avoid skidding is"
  },
  "options": [
    {
      "text": "\n60\n",
      "is_correct": false
    },
    {
      "text": "\n30\n",
      "is_correct": true
    },
    {
      "text": "\n15\n",
      "is_correct": false
    },
    {
      "text": "\n25",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "The condition to avoid skidding, $\\mathrm{v}=\\sqrt{\\mu \\mathrm{rg}}=\\sqrt{0.6 \\times 150 \\times 10}=30 \\mathrm{~m} / \\mathrm{s}$"
  }
