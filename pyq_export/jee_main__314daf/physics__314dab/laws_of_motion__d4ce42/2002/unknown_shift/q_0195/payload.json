  "question": {
    "text": "Three identical blocks of masses $\\mathrm{m}=2 \\mathrm{~kg}$ are drawn by a force $\\mathrm{F}=10.2 \\mathrm{~N}$ with an acceleration of $0.6 \\mathrm{~ms}^{-2}$ on a frictions surface, then what is the tension (in $\\mathrm{N}$ ) in the string between the blocks $B$ and $C$?\n<img src=\"assets\\qt0195_33a86b88dc0a.png\"><br>"
  },
  "options": [
    {
      "text": "\n9.2\n",
      "is_correct": false
    },
    {
      "text": "\n7.8\n",
      "is_correct": true
    },
    {
      "text": "\n4\n",
      "is_correct": false
    },
    {
      "text": "\n9.8",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Apply Newton's second law\n$$\n\\mathrm{F}-\\mathrm{T}_{\\mathrm{ab}}=m a ; \\mathrm{T}_{\\mathrm{ab}}-\\mathrm{T}_{\\mathrm{bc}}=\\mathrm{ma} \\quad \\therefore \\mathrm{T}_{\\mathrm{bc}}=7.8 \\mathrm{~N}\n$$"
  }
}