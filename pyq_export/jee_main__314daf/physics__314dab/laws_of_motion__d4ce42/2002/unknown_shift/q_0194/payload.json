  "question": {
    "text": "One end of a massless rope, which passes over a massless and frictionless pulley $P$ is tied to a hook $C$ while the other end is free. Maximum tension that the rope can bear is $360 \\mathrm{~N}$. With what value of maximum safe acceleration (in $\\mathrm{ms}^{-2}$ ) can a man of $60 \\mathrm{~kg}$ climb on the rope?\n<img src=\"assets\\qt0194_7339a3f0f18c.png\"><br>"
  },
  "options": [
    {
      "text": "\n16\n",
      "is_correct": false
    },
    {
      "text": "\n6\n",
      "is_correct": false
    },
    {
      "text": "\n4\n",
      "is_correct": true
    },
    {
      "text": "\n8",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{T}-60 \\mathrm{~g}=60 \\mathrm{a} ; \\mathrm{T}=3000 \\mathrm{~N} ; \\quad \\therefore \\mathrm{a}=4 \\mathrm{~ms}^{-2}$"
  }
