  "question": {
    "text": "A light string passing over a smooth light pulley connects two blocks of masses $m_1$ and $m_2$ (vertically). If the acceleration of the system is $\\mathrm{g} / 8$, then the ratio of the masses is",
    "image": null
  },
  "options": [
    {
      "id": "vqer5",
      "text": "\n8 : 1\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v3zmt",
      "text": "\n9 : 7\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "2HEjT",
      "text": "\n4 : 3\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v5aHs",
      "text": "\n5 : 3",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$a=\\frac{m_1-m_2}{m_1+m_2} g ; \\frac{1}{8}=\\frac{m_1-m_2}{m_1+m_2} \\Rightarrow m_1: m_2=9: 7$",
    "image": null
  },
