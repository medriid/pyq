      "image": null,
      "isCorrect": true
    },
    {
      "id": "pEkNW",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mo>-</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>",
