    {
      "id": "eCUhP",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mn>350</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math> while going downward",
      "isCorrect": false,
