  "question": {
    "text": "<p>A uniform metal chain of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math>&nbsp;and length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi></math>&nbsp;passes over a massless and frictionless pulley. It is released from rest with a part of its length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math>&nbsp;is hanging on one side and rest of its length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>-</mo><mi>l</mi></math>&nbsp;&nbsp;is hanging on the other side of the pulley. At a certain point of time, when <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi><mo>=</mo><mfrac><mi>L</mi><mi>x</mi></mfrac></math>, the acceleration of the chain is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>g</mi><mn>2</mn></mfrac></math>. The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> is _____.</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/ba4193af-42f3-4740-b7f7-6821ced58e03-image.png\" style=\"width: 130px; height: 152px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "1btqm",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "iV3Zb",
