      "image": null
    },
    {
      "id": "OqJEu",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ahWAx",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>",
      "isCorrect": true,
      "image": null
