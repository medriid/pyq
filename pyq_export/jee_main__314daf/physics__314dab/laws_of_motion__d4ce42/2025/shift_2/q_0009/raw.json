  "question": {
    "text": "An object with mass 500 g moves along x -axis with speed $v=4 \\sqrt{x} \\mathrm{~m} / \\mathrm{s}$. The force acting on the object is :",
    "image": null
  },
  "options": [
    {
      "id": "xlMg9",
      "text": "8 N",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "O2FA7",
      "text": "5 N",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AaQOS",
      "text": "6 N",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Xywem",
      "text": "4 N",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & F=M \\times a \\\\ & v=4 \\sqrt{x} \\\\ & v^2=16 x \\\\ & 2 v \\frac{d v}{d x}=16 \\\\ & \\frac{v d v}{d x}=\\frac{16}{2}=8 \\\\ & F=0.5 \\times 8=4 N\\end{aligned}$",
    "image": null
  },
