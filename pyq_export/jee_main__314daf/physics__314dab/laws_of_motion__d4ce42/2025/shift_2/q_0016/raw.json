      "text": "20 N",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{kx}_1=5 \\mathrm{~N} \\\\ & \\mathrm{kx}_2=7 \\mathrm{~N} \\\\ & \\mathrm{k}\\left(5 \\mathrm{x}_1-2 \\mathrm{x}_2\\right)=5 \\mathrm{kx}_1-2 \\mathrm{kx}_2 \\\\ & =5 \\times 5-2 \\times 7=11 \\mathrm{~N}\\end{aligned}$",
