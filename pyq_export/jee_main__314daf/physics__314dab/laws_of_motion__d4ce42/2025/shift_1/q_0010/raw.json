  "question": {
    "text": "A cubic block of mass $m$ is sliding down on an inclined plane at $60^{\\circ}$ with an acceleration of $\\frac{\\mathrm{g}}{2}$, the value of coefficient of kinetic friction is",
    "image": null
  },
  "options": [
    {
      "id": "DcQzX",
      "text": "$\\sqrt{3}-1$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zuVkI",
      "text": "$\\frac{\\sqrt{3}}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3VjUF",
      "text": "$\\frac{\\sqrt{2}}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "M6Bdf",
      "text": "$1-\\frac{\\sqrt{3}}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/l53W1eog6w-5kOzlSloS3wmQCV3Q0zkPc54grCeKVlY.original.fullsize.png\"/><br/>$\\mathrm{mg} \\sin 60^{\\circ}-\\mu \\mathrm{mg} \\cos 60^{\\circ}=\\mathrm{ma}$<br/>$g \\sin 60-\\mu g \\cos 60=\\frac{g}{2}$<br/>$\\frac{\\sqrt{3}}{2}-\\frac{\\mu}{2}=\\frac{1}{2}$<br/>$\\mu=\\sqrt{3}-1$",
    "image": null
