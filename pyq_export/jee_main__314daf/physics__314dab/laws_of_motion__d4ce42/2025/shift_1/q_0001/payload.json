  "question": {
    "text": "A cubic block of mass $m$ is sliding down on an inclined plane at $60^{\\circ}$ with an acceleration of $\\frac{\\mathrm{g}}{2}$, the value of coefficient of kinetic friction is"
  },
  "options": [
    {
      "text": "$\\sqrt{3}-1$",
      "is_correct": true
    },
    {
      "text": "$\\frac{\\sqrt{3}}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\sqrt{2}}{3}$",
      "is_correct": false
    },
    {
      "text": "$1-\\frac{\\sqrt{3}}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0001_becfb8f7f75e.png\"/><br/>$\\mathrm{mg} \\sin 60^{\\circ}-\\mu \\mathrm{mg} \\cos 60^{\\circ}=\\mathrm{ma}$<br/>$g \\sin 60-\\mu g \\cos 60=\\frac{g}{2}$<br/>$\\frac{\\sqrt{3}}{2}-\\frac{\\mu}{2}=\\frac{1}{2}$<br/>$\\mu=\\sqrt{3}-1$"
  }
}