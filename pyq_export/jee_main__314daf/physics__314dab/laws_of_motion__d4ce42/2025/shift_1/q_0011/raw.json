  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/14T6AOBABfv2pKeUT4al-nAO3VW9qEnUfry9IlXUBfE.original.fullsize.png\"/><br/>$\\begin{aligned} & \\mathrm{T}_1 \\sin \\theta_1+\\mathrm{T}_2 \\sin \\theta_2=\\mathrm{mg} \\& \\mathrm{~T}_1=\\sqrt{3} \\mathrm{~T}_2 \\\\ & \\Rightarrow \\mathrm{~T}_2\\left[\\sqrt{3} \\sin \\theta_1+\\sin \\theta_2\\right]=\\mathrm{mg} \\\\ & \\text { for } \\theta_1=60^{\\circ} \\& \\theta_2=30^{\\circ} \\\\ & \\mathrm{T}_2=\\frac{\\mathrm{mg}}{2}\\end{aligned}$",
    "image": null
