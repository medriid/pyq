  },
  "question": {
    "text": "A $1 \\mathrm{~kg}$ mass is suspended from the ceiling by a rope of length $4 \\mathrm{~m}$. A horizontal force ' $F$ ' is applied at the mid point of the rope so that the rope makes an angle of $45^{\\circ}$ with respect to the vertical axis as shown in figure. The magnitude of $F$ is :\n(Assume that the system is in equilibrium and $g=10 \\mathrm{~m} / \\mathrm{s}^2$ )\n<img src=\"assets\\qt0008_9090860325d0.png\"><br>"
  },
  "options": [
    {
      "text": "$10 \\mathrm{~N}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{10}{\\sqrt{2}} \\mathrm{~N}$",
      "is_correct": false
    },
    {
      "text": "$1 \\mathrm{~N}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{10 \\times \\sqrt{2}} N$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{T}_1 \\sin 45^{\\circ}=\\mathrm{F} \\\\ & \\mathrm{T}_1 \\cos 45^{\\circ}=\\mathrm{T}_2=1 \\times \\mathrm{g} \\\\ & \\therefore \\tan 45^{\\circ}=\\frac{\\mathrm{F}}{\\mathrm{g}} \\\\ & \\therefore \\mathrm{F}=10 \\mathrm{~N}\\end{aligned}$"
  }
}