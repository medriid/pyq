      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo> </mo><mn>40</mn><mi mathvariant=\"normal\">N</mi><mo>,</mo><mo> </mo><mn>64</mn><mi mathvariant=\"normal\">N</mi><mo> </mo></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "SWwqh",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo> </mo><mn>60</mn><mi mathvariant=\"normal\">N</mi><mo>,</mo><mo> </mo><mn>80</mn><mi mathvariant=\"normal\">N</mi><mo> </mo></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Wt7ij",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo> </mo><mn>88</mn><mi mathvariant=\"normal\">N</mi><mo>,</mo><mo> </mo><mn>96</mn><mi mathvariant=\"normal\">N</mi></math>",
