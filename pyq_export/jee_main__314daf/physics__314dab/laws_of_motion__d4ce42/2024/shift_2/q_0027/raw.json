    },
    {
      "id": "djo25",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>80</mn><mi mathvariant=\"normal\">N</mi><mo>,</mo><mo> </mo><mn>100</mn><mi mathvariant=\"normal\">N</mi></math>",
