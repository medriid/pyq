  "question": {
    "text": "A light unstretchable string passing over a smooth light pulley connects two blocks of masses $m_1$ and $m_2$. If the acceleration of the system is $\\frac{g}{8}$, then the ratio of the masses $\\frac{m_2}{m_1}$ is :"
  },
  "options": [
    {
      "text": "$8: 1$",
      "is_correct": false
    },
    {
      "text": "$5: 3$",
      "is_correct": false
    },
    {
      "text": "$4: 3$",
      "is_correct": false
    },
    {
      "text": "$9: 7$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & a_{\\text {sys }}=\\left(\\frac{m_2-m_1}{m_1+m_2}\\right) g=\\frac{g}{8} \\\\ & \\Rightarrow \\frac{m_2}{m_1}=\\frac{9}{7}\\end{aligned}$"
  }
}