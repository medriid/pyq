  "question": {
    "text": "A satellite moving with velocity $v$ in a force free space collects stationary interplanetary dust at a rate of $\\frac{d M}{d t}=\\alpha v$ where $M$ is the mass (of satellite + dust) at that instant. The instantaneous acceleration of the satellite is"
  },
  "options": [
    {
      "text": "\n$-\\frac{\\alpha v^2}{2 M}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-\\frac{\\alpha v^2}{M}$\n",
      "is_correct": true
    },
    {
      "text": "\n$-\\alpha v^2$\n",
      "is_correct": false
    },
    {
      "text": "\n$-\\frac{2 \\alpha v^2}{M}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$a_{\\text {inst }}=\\frac{\\alpha \\mathrm{V}^2}{\\mathrm{M}}$"
  }
