  "question": {
    "text": "A mass of $\\mathrm{M} \\mathrm{kg}$ is suspended by a weightless string. The horizontal force that is required to displace it until the string makes an angle of $45^{\\circ}$ with the initial vertical direction is"
  },
  "options": [
    {
      "text": "\n$M g(\\sqrt{2}-1)$\n",
      "is_correct": true
    },
    {
      "text": "\n$M g(\\sqrt{2}+1)$\n",
      "is_correct": false
    },
    {
      "text": "\n$M g \\sqrt{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mathrm{Mg}}{\\sqrt{2}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{F} \\ell \\sin 45=M g(\\ell-\\ell \\cos 45)$\n$F=M g(\\sqrt{2}-1)$"
  }
}