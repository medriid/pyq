  "question": {
    "text": "A player caught a cricket ball of mass $150 \\mathrm{~g}$ moving at a rate of $20 \\mathrm{~m} / \\mathrm{s}$. If the catching process is completed in $0.1 \\mathrm{~s}$, the force of the blow exerted by the ball on the hand of the player is equal to"
  },
  "options": [
    {
      "text": "\n$300 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$150 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$3 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$30 \\mathrm{~N}$",
      "is_correct": true
    }
  ],
