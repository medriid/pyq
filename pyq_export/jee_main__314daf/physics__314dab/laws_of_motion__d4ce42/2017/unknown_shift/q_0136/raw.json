  "question": {
    "text": "<p>The machine as shown has <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math> rods of length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> connected by a pivot at the top. The end of one rod is connected to the floor by a stationary pivot and the end of the other rod has roller that rolls along the floor in a slot. As the roller goes back and forth, a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mi>kg</mi></math> weight moves up and down. If the roller is moving towards right at a constant speed, the weight moves up with a :<br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9589118e-17b5-43f9-b288-8a8f8fb7e939-d39.png\" style=\"width: 250px; height: 167px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "pFdlw",
      "text": "Speed which is <math><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">h</mi></math> of that of the roller when the weight is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> above the ground",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "viwSQ",
      "text": "Constant speed",
      "image": null,
      "isCorrect": false
    },
    {
