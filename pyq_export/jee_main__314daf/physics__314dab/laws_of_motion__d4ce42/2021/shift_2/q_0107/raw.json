  "correctValue": "30",
  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1d9e0a5e-5430-4268-a33d-31bbd11ec4fa-image.png\" style=\"width: 203px; height: 197px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi><mo>+</mo><mi>T</mi><mo>=</mo><mn>90</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mi>&#956;</mi><mi>N</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>5</mn><mo>(</mo><mn>90</mn><mo>-</mo><mi>T</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn><mi>T</mi><mo>=</mo><mn>45</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mn>30</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math></p>",
