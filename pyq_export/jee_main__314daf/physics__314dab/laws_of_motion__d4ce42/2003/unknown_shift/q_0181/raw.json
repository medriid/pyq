  "question": {
    "text": "A horizontal force of $10 \\mathrm{~N}$ is necessary to just hold a block stationary against a wall. The co-efficient of friction between the block and the wall is $0.2$. The weight of the block is\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/nK3sh0w1PfTL5rUsJizSow2G3ugf2QQA9Fm7J18i0Qo.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "5wvaR",
      "text": "\n$20 \\mathrm{~N}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Ydr5m",
      "text": "\n$50 \\mathrm{~N}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TcyaJ",
      "text": "\n$100 \\mathrm{~N}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xQIZS",
      "text": "\n$2 \\mathrm{~N}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5hqMpH_ZOmjt-L8zzCbVKE6j8U5hXdlqMflGA9IB58g.original.fullsize.png\"><br>\n\n\n$\\mathrm{f}=\\mathrm{mg} \\Rightarrow \\mu \\mathrm{N}=\\mathrm{W} \\Rightarrow \\mu .10=\\mathrm{W}$\n$\\Rightarrow 0.2 \\times 10=\\mathrm{W}$\n$\\therefore \\mathrm{W}=2 \\mathrm{~N}$",
    "image": null
  },
