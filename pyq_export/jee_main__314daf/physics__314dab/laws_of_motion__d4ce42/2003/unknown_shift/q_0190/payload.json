  "question": {
    "text": "A horizontal force of $10 \\mathrm{~N}$ is necessary to just hold a block stationary against a wall. The co-efficient of friction between the block and the wall is $0.2$. The weight of the block is\n<img src=\"assets\\qt0190_0946c6185c39.png\"><br>"
  },
  "options": [
    {
      "text": "\n$20 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$50 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$100 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\mathrm{~N}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0190_5de4c42ae2a9.png\"><br>\n\n\n$\\mathrm{f}=\\mathrm{mg} \\Rightarrow \\mu \\mathrm{N}=\\mathrm{W} \\Rightarrow \\mu .10=\\mathrm{W}$\n$\\Rightarrow 0.2 \\times 10=\\mathrm{W}$\n$\\therefore \\mathrm{W}=2 \\mathrm{~N}$"
  }
}