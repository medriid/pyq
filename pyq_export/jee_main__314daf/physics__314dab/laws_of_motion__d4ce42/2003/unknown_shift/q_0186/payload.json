  "question": {
    "text": "A rocket with a lift-off mass $3.5 \\times 10^4 \\mathrm{~kg}$ is blasted upwards with an initial acceleration of $10 \\mathrm{~m} / \\mathrm{s}^2$. Then the initial thrust of the blast is"
  },
  "options": [
    {
      "text": "\n$3.5 \\times 10^5 \\mathrm{~N}$\n",
      "is_correct": true
    },
    {
      "text": "\n$7.0 \\times 10^5 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$14.0 \\times 10^5 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.75 \\times 10^5 \\mathrm{~N}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Thrust $=$ Mass $\\times$ Acceleration $=3.5 \\times 10^4 \\times 10=3.5 \\times 10^5 \\mathrm{~N}$"
  }
}