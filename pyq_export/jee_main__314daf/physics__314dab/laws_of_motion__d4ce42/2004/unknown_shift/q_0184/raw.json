  "question": {
    "text": "Two masses $m_1=5 \\mathrm{~kg}$ and $m_2=4.8 \\mathrm{~kg}$ tied to a string are hanging over a light frictionless pulley. What is the acceleration of the masses when lift free to move $\\left(\\mathrm{g}=9.8 \\mathrm{~m} / \\mathrm{s}^2\\right)$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/yR1leYO1r4ZVbeoHnypsP8ufegapNyuCza59QgQ_s-s.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "HL5sC",
      "text": "\n$0.2 \\mathrm{~m} / \\mathrm{s}^2$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "EDA3u",
      "text": "\n$9.8 \\mathrm{~m} / \\mathrm{s}^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CctUt",
      "text": "\n$5 \\mathrm{~m} / \\mathrm{s}^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "urDM7",
      "text": "\n$4.8 \\mathrm{~m} / \\mathrm{s}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{a}=\\left(\\frac{\\mathrm{m}_1-\\mathrm{m}_2}{\\mathrm{~m}_1+\\mathrm{m}_2}\\right) \\mathrm{g}=0.2 \\mathrm{~m} / \\mathrm{s}^2$",
