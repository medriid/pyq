  "question": {
    "text": "Two masses $m_1=5 \\mathrm{~kg}$ and $m_2=4.8 \\mathrm{~kg}$ tied to a string are hanging over a light frictionless pulley. What is the acceleration of the masses when lift free to move $\\left(\\mathrm{g}=9.8 \\mathrm{~m} / \\mathrm{s}^2\\right)$\n<img src=\"assets\\qt0184_006cfb13c533.png\"><br>"
  },
  "options": [
    {
      "text": "\n$0.2 \\mathrm{~m} / \\mathrm{s}^2$\n",
      "is_correct": true
    },
    {
      "text": "\n$9.8 \\mathrm{~m} / \\mathrm{s}^2$\n",
      "is_correct": false
    },
    {
      "text": "\n$5 \\mathrm{~m} / \\mathrm{s}^2$\n",
      "is_correct": false
    },
    {
      "text": "\n$4.8 \\mathrm{~m} / \\mathrm{s}^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{a}=\\left(\\frac{\\mathrm{m}_1-\\mathrm{m}_2}{\\mathrm{~m}_1+\\mathrm{m}_2}\\right) \\mathrm{g}=0.2 \\mathrm{~m} / \\mathrm{s}^2$"
  }
}