  "question": {
    "text": "A particle of mass <math><mi>m</mi></math> is fixed to one end of a light spring having force constant <math><mi>k</mi></math> and unstretched length <math><mi>l</mi><mo>.</mo></math> The other end is fixed. The system is given an angular speed <math><mi>&#969;</mi></math> about the fixed end of the spring such that it rotates in a circle in gravity free space. Then the stretch in the spring is:",
    "image": null
  },
  "options": [
    {
      "id": "ObXXv",
      "text": "<math><mfrac><mrow><mi>m</mi><mi>l</mi><msup><mrow><mi>&#969;</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>k</mi><mo>-</mo><mi>&#969;</mi><mi>m</mi></mrow></mfrac></math>",
      "isCorrect": false,
