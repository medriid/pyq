  "question": {
    "text": "A block of mass ' $\\mathrm{m}$ ' is connected to another block of mass ' $\\mathrm{M}$ ' by a spring (massless) of spring constant ' $\\mathrm{k}$ '. The blocks are kept on a smooth horizontal plane. Initially the blocks are at rest and the spring is unstretched. Then a constant force '$\\mathrm{F}$' starts acting on the block of mass '$\\mathrm{M}$' to pull it. Find the force on the block of mass '$\\mathrm{m}$'",
    "image": null
  },
  "options": [
    {
      "id": "XU8Tw",
      "text": "\n$\\frac{\\mathrm{mF}}{\\mathrm{M}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "EiShR",
      "text": "\n$\\frac{\\mathrm{(M+m) F}}{\\mathrm{m}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Lcplr",
      "text": "\n$\\frac{\\mathrm{m F}}{\\mathrm{(m+M)}}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BNWpw",
      "text": "\n$\\frac{\\mathrm{MF}}{(\\mathrm{m}+\\mathrm{M})}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Kx}=\\mathrm{ma}=\\frac{\\mathrm{mF}}{\\mathrm{m}+\\mathrm{M}}$",
    "image": null
  },
