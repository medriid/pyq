  "question": {
    "text": "Photon of frequency $\\mathrm{v}$ has a momentum associated with it. If $\\mathrm{c}$ is the velocity of light, the momentum is"
  },
  "options": [
    {
      "text": "\n$\\mathrm{v / c}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{hvc}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{h v / c^2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{hv/c}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{P}=\\frac{\\mathrm{h}}{\\lambda}=\\frac{\\mathrm{h} v}{\\mathrm{c}}$"
