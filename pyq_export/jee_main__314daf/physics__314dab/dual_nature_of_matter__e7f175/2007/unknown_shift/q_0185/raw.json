  "question": {
    "text": "Photon of frequency $\\mathrm{v}$ has a momentum associated with it. If $\\mathrm{c}$ is the velocity of light, the momentum is",
    "image": null
  },
  "options": [
    {
      "id": "b0Vhb",
      "text": "\n$\\mathrm{v / c}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FZmWL",
      "text": "\n$\\mathrm{hvc}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OBpdo",
      "text": "\n$\\mathrm{h v / c^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4DXjm",
      "text": "\n$\\mathrm{hv/c}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{P}=\\frac{\\mathrm{h}}{\\lambda}=\\frac{\\mathrm{h} v}{\\mathrm{c}}$",
