  "question": {
    "text": "The surface of a metal is illuminated with the light of $400 \\mathrm{~nm}$. The kinetic energy of the ejected photoelectrons was found to be $1.68 \\mathrm{eV}$. The work function of the metal is $(\\mathrm{hc}=1240 \\mathrm{eV} \\mathrm{nm})$",
    "image": null
  },
  "options": [
    {
      "id": "HfNk2",
      "text": "\n$3.09 \\mathrm{eV}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vKOIr",
      "text": "\n$1.41 \\mathrm{eV}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5PRzA",
      "text": "\n$151 \\mathrm{eV}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FJHVr",
      "text": "\n$1.68 \\mathrm{eV}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\frac{1}{2} \\mathrm{mv}^2=\\mathrm{eV}_{\\mathrm{o}}=1.68 \\mathrm{eV} \\Rightarrow \\mathrm{hv}=\\frac{\\mathrm{hc}}{\\lambda}=\\frac{1240 \\mathrm{evnm}}{400 \\mathrm{~nm}}=3.1 \\mathrm{eV} \\Rightarrow 3.1 \\mathrm{eV}=\\mathrm{W}_0+1.6 \\mathrm{eV} \\\\\n& \\therefore \\quad \\mathrm{W}_0=1.42 \\mathrm{eV}\n\\end{aligned}\n$$",
    "image": null
  },
