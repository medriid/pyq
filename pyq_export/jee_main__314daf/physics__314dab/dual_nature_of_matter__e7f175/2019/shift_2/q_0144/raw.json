  "solution": {
    "text": "Einstein&#39;s photoelectric equation<br />Maximum <math><mi>K</mi><mi>E</mi><mo>=</mo><mfrac><mrow><mi>h</mi><mi>C</mi></mrow><mrow><mi>&#955;</mi></mrow></mfrac><mo>-</mo><mi>&#981;</mi></math><br /><br /><math><mo>=</mo><mn>10</mn><mo>-</mo><mn>5</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>5</mn><mo>&#160;</mo><mi>e</mi><mi>V</mi></math><br /><br />Intensity <math><mi>I</mi><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow></mfenced><mfrac><mrow><mi>h</mi><mi>C</mi></mrow><mrow><mi>&#955;</mi></mrow></mfrac></mrow><mrow><mi>t</mi><mi>A</mi></mrow></mfrac><mo>&#8658;</mo><mfrac><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow><mrow><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>I</mi><mi>A</mi></mrow><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>h</mi><mi>C</mi></mrow><mrow><mi>&#955;</mi></mrow></mfrac></mrow></mfenced></mrow></mfrac></math><br /><br />and number of electrons per second. <math><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow><mrow><mi>t</mi></mrow></mfrac></mrow></mfenced><mo>&#215;</mo><mn>10</mn><mi>%</mi></math><br /><br /><math><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>I</mi><mi>A</mi></mrow><mrow><mfrac><mrow><mi>h</mi><mi>C</mi></mrow><mrow><mi>&#955;</mi></mrow></mfrac></mrow></mfrac></mrow></mfenced><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>10</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>16</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>4</mn></mrow></msup></mrow><mrow><mn>10</mn><mo>&#215;</mo><mn>1.6</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>19</mn></mrow></msup><mo>&#215;</mo><mn>10</mn></mrow></mfrac></math><br /><br /><math><mo>=</mo><msup