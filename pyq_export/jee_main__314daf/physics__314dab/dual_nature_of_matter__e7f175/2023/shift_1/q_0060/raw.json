  "question": {
    "text": "<p>The threshold wavelength for photoelectric emission from a material is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5500</mn><mo>&#160;</mo><mover><mi mathvariant=\"normal\">A</mi><mo>&#8728;</mo></mover></math>. Photoelectrons will be emitted, when this material is illuminated with monochromatic radiation from a</p><p>A.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>75</mn><mo>&#160;</mo><mi mathvariant=\"normal\">W</mi></math> infra-red lamp</p><p>B.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">W</mi></math> infra-red lamp</p><p>C.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>75</mn><mo>&#160;</mo><mi mathvariant=\"normal\">W</mi></math> ultra-violet lamp</p><p>D.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">W</mi></math> ultra-violet lamp</p><p>Choose the correct answer from the options given below :</p>",
    "image": null
  },
  "options": [
    {
      "id": "IoeQJ",
      "text": "B and C only",
      "isCorrect": false,
      "image": null
    },
    {
