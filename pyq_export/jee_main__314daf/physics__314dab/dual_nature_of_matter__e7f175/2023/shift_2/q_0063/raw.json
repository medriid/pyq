  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "An <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>&nbsp;particle, a proton and an electron have the same kinetic energy. Which one of the following is correct in case of their de-Broglie wavelength:",
    "image": null
  },
  "options": [
    {
      "id": "cZxwC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#955;</mi><mi>&#945;</mi></msub><mo>&#62;</mo><msub><mi>&#955;</mi><mi>p</mi></msub><mo>&#62;</mo><msub><mi>&#955;</mi><mi>e</mi></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "OvYCQ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#955;</mi><mi>&#945;</mi></msub><mo>&#60;</mo><msub><mi>&#955;</mi><mi>p</mi></msub><mo>&#60;</mo><msub><mi>&#955;</mi><mi>e</mi></msub></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "XDQO0",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#955;</mi><mi>&#945;</mi></msub><mo>=</mo><msub><mi>&#955;</mi><mi>p</mi></msub><mo>=</mo><msub><mi>&#955;</mi><mi>e</mi></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ByeNj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#955;</mi><mi>&#945;</mi></msub><mo>&#62;</mo><msub><mi>&#955;</mi><mi>p</mi></msub><mo>&#60;</mo><msub><mi>&#955;</mi><mi>e</mi></msub></math>",
      "isCorrect": false,
