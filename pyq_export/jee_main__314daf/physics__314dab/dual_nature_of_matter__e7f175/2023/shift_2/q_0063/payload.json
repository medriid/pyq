  "question": {
    "text": "A point source of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>&#160;</mo><mi mathvariant=\"normal\">W</mi></math> emits light with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>%</mo></math> efficiency. At a distance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math> from the source, the intensity produced by the electric field component is:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow></mfrac><mfrac><mi mathvariant=\"normal\">W</mi><msup><mi mathvariant=\"normal\">m</mi><mn>2</mn></msup></mfrac></math>",
