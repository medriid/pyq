      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>40</mn><mi mathvariant=\"normal\">&#960;</mi></mrow></mfrac><mfrac><mi mathvariant=\"normal\">W</mi><msup><mi mathvariant=\"normal\">m</mi><mn>2</mn></msup></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>10</mn><mi mathvariant=\"normal\">&#960;</mi></mrow></mfrac><mfrac><mi mathvariant=\"normal\">W</mi><msup><mi mathvariant=\"normal\">m</mi><mn>2</mn></msup></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>20</mn></mfrac><mfrac><mi mathvariant=\"normal\">W</mi><msup><mi mathvariant=\"normal\">m</mi><mn>2</mn></msup></mfrac></math>",
