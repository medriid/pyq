  "question": {
    "text": "The ratio of the de-Broglie wavelengths of proton and electron having same kinetic energy:<br />(Assume <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>m</mi><mi>p</mi></msub><mo>=</mo><msub><mi>m</mi><mi>e</mi></msub><mo>&#215;</mo><mn>1849</mn></math>)"
  },
  "options": [
