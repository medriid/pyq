  "question": {
    "text": "The radiation pressure exerted by a 450 W light source on a perfectly reflecting surface placed at 2 m away from it, is :",
    "image": null
  },
  "options": [
    {
      "id": "3tYKC",
      "text": "$1.5 \\times 10^{-8}$ Pascals",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NXuYA",
      "text": "0",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JMpEU",
      "text": "$6 \\times 10^{-8}$ Pascals",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Pxgso",
      "text": "$3 \\times 10^{-8}$ Pascals",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$P_{\\mathrm{rad}}=\\frac{2 I}{\\mathrm{C}}$<br/>Where $\\mathrm{I}=$ intensity at surface<br/>$\\mathrm{C}=$ Speed of light<br/>$\\begin{aligned}<br/>& I=\\frac{\\text { Power }}{\\text { Area }}=\\frac{450}{4 \\pi \\mathrm{r}^2} \\\\\n& =\\frac{450}{4 \\pi \\times 4}=\\frac{450}{16 \\pi} \\\\\n& P_{\\mathrm{rad}}=\\frac{2 \\times 450}{16 \\pi \\times 3 \\times 10^8}=\\frac{150}{8 \\pi \\times 10^8}<br/>\\end{aligned}$<br/>$=5.97 \\times 10^{-8} \\approx 6 \\times 10^{-8}$ Pascals",
    "image": null
  },
