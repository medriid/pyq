  "question": {
    "text": "The work function of a metal is 3 eV. The color of the visible light that is required to cause emission of photoelectrons is",
    "image": null
  },
  "options": [
    {
      "id": "NZBQG",
      "text": "Green",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nTnK8",
      "text": "Blue",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "L5Fqv",
      "text": "Red",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jZUr1",
      "text": "Yellow",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}<br/>& (\\mathrm{KE})_{\\max }=\\frac{\\mathrm{hc}}{\\lambda}-\\phi \\\\\n& \\frac{\\mathrm{hc}}{\\lambda} \\gt \\phi[\\text { for emission }] \\\\\n& \\lambda \\lt \\frac{\\mathrm{hc}}{\\phi} \\Rightarrow \\lambda \\lt \\frac{1242}{3} \\mathrm{~nm}<br/>\\end{aligned}$<br/>So blue light option (B)",
    "image": null
  },
