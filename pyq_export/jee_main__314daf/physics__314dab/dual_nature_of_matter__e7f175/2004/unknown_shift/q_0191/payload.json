  "question": {
    "text": "The work function of a substance is $4.0 \\mathrm{eV}$. Then longest wavelength of light that can cause photoelectron emission from this substance approximately"
  },
  "options": [
    {
      "text": "\n$540 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$400 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$310 \\mathrm{~nm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$220 \\mathrm{~nm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{hc}}{\\lambda}=\\mathrm{W}$\n$\\lambda_{\\text {longest }}=\\frac{\\mathrm{hc}}{\\mathrm{W}}=\\frac{6.6 \\times 10^{-34} \\times 3 \\times 10^8}{4.0 \\times 1.6 \\times 10^{-19}}$\n$\\Rightarrow \\lambda_{\\text {longest }} \\approx 310 \\mathrm{~nm}$."
  }
}