      "isCorrect": true
    },
    {
      "id": "jZtup",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>8</mn><mn>1</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "p4Nfx",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac></math>",
