  "question": {
    "text": "Average force exerted on a non-reflecting surface at normal incidence is $2.4 \\times 10^{-4} \\mathrm{~N}$. If $360 \\mathrm{~W} / \\mathrm{cm}^2$ is the light energy flux during span of 1 hour 30 minutes, Then the area of the surface is:"
  },
  "options": [
    {
      "text": "$0.2 \\mathrm{~m}^2$",
      "is_correct": false
    },
    {
      "text": "$20 \\mathrm{~m}^2$",
      "is_correct": false
    },
    {
      "text": "$0.1 \\mathrm{~m}^2$",
      "is_correct": false
    },
    {
      "text": "$0.02 \\mathrm{~m}^2$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Pressure }=\\frac{I}{C}=\\frac{F}{A} \\\\ & \\Rightarrow \\frac{360}{10^{-4} \\times 3 \\times 10^8}=\\frac{2.4 \\times 10^{-4}}{A} \\\\ & \\Rightarrow \\mathrm{A}=2 \\times 10^{-2} \\mathrm{~m}^2=0.02 \\mathrm{~m}^2\\end{aligned}$"
  }
}