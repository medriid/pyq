  "question": {
    "text": "A proton, an electron and an alpha particle have the same energies. Their de-Broglie wavelengths will be compared as :"
  },
  "options": [
    {
      "text": "$\\lambda_\\alpha < \\lambda_{\\mathrm{p}} < \\lambda_{\\mathrm{e}}$",
      "is_correct": true
    },
    {
      "text": "$\\lambda_{\\mathrm{e}}>\\lambda_\\alpha>\\lambda_{\\mathrm{p}}$",
      "is_correct": false
    },
    {
      "text": "$\\lambda_{\\mathrm{p}}>\\lambda_{\\mathrm{e}}>\\lambda_\\alpha$",
      "is_correct": false
    },
    {
      "text": "$\\lambda_{\\mathrm{p}} < \\lambda_{\\mathrm{e}} < \\lambda_\\alpha$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\lambda_{\\mathrm{DB}}=\\frac{\\mathrm{h}}{\\mathrm{p}}=\\frac{\\mathrm{h}}{\\sqrt{2 \\mathrm{mk}}} \\\\ & \\Rightarrow \\lambda_{\\mathrm{DB}} \\alpha \\frac{1}{\\sqrt{\\mathrm{m}}} \\\\ & \\Rightarrow \\lambda_{\\mathrm{a}} < \\lambda_{\\mathrm{p}} < \\lambda_{\\mathrm{e}}\\end{aligned}$"
  }
}