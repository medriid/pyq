  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{E}_{\\text {photon }}=(\\text { work function })+\\mathrm{K} \\cdot \\mathrm{E}_{\\max } \\\\ & \\therefore 4.13=3.13+\\mathrm{K} \\cdot \\mathrm{E}_{\\max } \\\\ & \\therefore \\mathrm{K}_{\\mathrm{max}}=1 \\mathrm{eV}\\end{aligned}$",
