  "question": {
    "text": "UV light of $4.13 \\mathrm{eV}$ is incident on a photosensitive metal surface having work function $3.13 \\mathrm{eV}$. The maximum kinetic energy of ejected photoelectrons will be:",
    "image": null
  },
  "options": [
    {
      "id": "uURfw",
      "text": "$4.13 \\mathrm{eV}$",
      "image": null,
      "isCorrect": false
    },
    {
