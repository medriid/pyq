  "question": {
    "text": "UV light of $4.13 \\mathrm{eV}$ is incident on a photosensitive metal surface having work function $3.13 \\mathrm{eV}$. The maximum kinetic energy of ejected photoelectrons will be:"
  },
  "options": [
    {
      "text": "$4.13 \\mathrm{eV}$",
      "is_correct": false
    },
    {
      "text": "$3.13 \\mathrm{eV}$",
      "is_correct": false
    },
    {
      "text": "$1 \\mathrm{eV}$",
      "is_correct": true
    },
    {
      "text": "$7.26 \\mathrm{eV}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{E}_{\\text {photon }}=(\\text { work function })+\\mathrm{K} \\cdot \\mathrm{E}_{\\max } \\\\ & \\therefore 4.13=3.13+\\mathrm{K} \\cdot \\mathrm{E}_{\\max } \\\\ & \\therefore \\mathrm{K}_{\\mathrm{max}}=1 \\mathrm{eV}\\end{aligned}$"
  }
}