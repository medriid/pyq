      "image": null,
      "isCorrect": false
    },
    {
      "id": "uIdmF",
      "text": "Planck’s constant",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<blockquote><div>Comparing Einstein's equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>K</mi><mi>max</mi></msub><mo>=</mo><mi>h</mi><mi>v</mi><mo>-</mo><mi>h</mi><msub><mi>v</mi><mn>0</mn></msub><mo>,</mo></math> with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>c</mi><mo>,</mo></math> we get slope, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mi>h</mi></math>, which is Planck’s constant.</div></blockquote>",
    "image": null
  },
