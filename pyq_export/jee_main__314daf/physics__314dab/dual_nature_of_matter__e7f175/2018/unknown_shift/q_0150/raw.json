  "solution": {
    "text": "Momentum of each electron   <math><mfrac><mrow><mi>h</mi></mrow><mrow><msub><mrow><mi>λ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi> </mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi> </mi><mfrac><mrow><mi>h</mi></mrow><mrow><msub><mrow><mi>λ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br/><br/>Velocity of centre of mass<br/><br/> <math><msub><mrow><mi>V</mi></mrow><mrow><mi>c</mi><mi>m</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>h</mi></mrow><mrow><mn>2</mn><mi>m</mi><msub><mrow><mi>λ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi> </mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mi>h</mi></mrow><mrow><mn>2</mn><mi>m</mi><msub><mrow><mi>λ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br/><br/>Velocity of  <math><msup><mrow><mn>1</mn></mrow><mrow><mi>s</mi><mi>t</mi></mrow></msup></math>  particle about centre of mass<br/><br/> <math><msub><mrow><mi>V</mi></mrow><mrow><mi>c</mi><mi>m</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>h</mi></mrow><mrow><mn>2</mn><mi>m</mi><msub><mrow><mi>λ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi> </mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>-</mo><mfrac><mrow><mi>h</mi></mrow><mrow><mn>2</mn><mi>m</mi><msub><mrow><mi>λ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math> <br/><br/> <math><msub><mrow><mi>λ</mi></mrow><mrow><mi>c</mi><mi>m</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>h</mi></mrow><mrow><msqrt><mfrac><mrow><msup><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>4</mn><msubsup><mrow>