  "level": 1,
  "question": {
    "text": "An <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math> particle and a proton are accelerated from rest through the same potential difference. The ratio of linear momenta acquired by above two particals will be :",
    "image": null
  },
  "options": [
    {
      "id": "Qea2K",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>2</mn></msqrt><mo>:</mo><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Wiz2B",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>:</mo><mn>1</mn></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "G4MDG",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msqrt><mn>2</mn></msqrt><mo>:</mo><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "J40Gf",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>:</mo><mn>1</mn></math>",
      "isCorrect": false,
