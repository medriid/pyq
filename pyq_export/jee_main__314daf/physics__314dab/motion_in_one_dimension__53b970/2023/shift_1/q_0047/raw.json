      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mfenced><mrow><msub><mi>v</mi><mn>1</mn></msub><msub><mi>v</mi><mn>2</mn></msub><msub><mi>v</mi><mn>3</mn></msub></mrow></mfenced><mrow><mn>3</mn><mfenced><mrow><msub><mi>v</mi><mn>1</mn></msub><msub><mi>v</mi><mn>2</mn></msub><mo>+</mo><msub><mi>v</mi><mn>2</mn></msub><msub><mi>v</mi><mn>3</mn></msub><mo>+</mo><msub><mi>v</mi><mn>3</mn></msub><msub><mi>v</mi><mn>1</mn></msub></mrow></mfenced></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
