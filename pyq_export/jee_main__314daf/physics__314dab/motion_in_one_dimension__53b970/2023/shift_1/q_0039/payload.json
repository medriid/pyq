  "question": {
    "text": "<p>Form the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>&#160;</mo><mo>-</mo><mo>&#160;</mo><mi>t</mi></math>&nbsp;graph shown, the ratio of distance to displacement in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></math> of motion is:</p><p><img src=\"assets\\qt0039_00852bbd9fb0.png\" style=\"width: 300px; height: 231px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac></math>",
