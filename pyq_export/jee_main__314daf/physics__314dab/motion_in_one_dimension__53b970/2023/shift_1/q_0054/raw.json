    },
    {
      "id": "JOJz1",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>+</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mpadded lspace=\"-2px\"><mn>2</mn></mpadded></mfrac></math>",
