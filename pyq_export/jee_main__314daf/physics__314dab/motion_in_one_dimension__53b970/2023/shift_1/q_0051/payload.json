  "question": {
    "text": "<p>Match Column-I with Column-II :</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td><strong>Column-I (x-t graphs)</strong></td>\t\t\t<td>&nbsp;</td>\t\t\t<td><strong>Column-II (v-t graphs)</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_2c9d5f356ba2.png\" style=\"width: 120px; height: 142px;\" /></td>\t\t\t<td>I</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_e2a90b5f379d.png\" style=\"width: 112px; height: 143px;\" /></td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_9f5b17dc74e9.png\" style=\"width: 125px; height: 137px;\" /></td>\t\t\t<td>II</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_648f19bc0ef5.png\" style=\"width: 127px; height: 149px;\" /></td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_ce2397efab29.png\" style=\"width: 130px; height: 165px;\" /></td>\t\t\t<td>III</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_5ecf466da267.png\" style=\"width: 146px; height: 200px;\" /></td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_c1c11e1b7162.png\" style=\"width: 125px; height: 154px;\" /></td>\t\t\t<td>IV</td>\t\t\t<td><img alt=\"\" src=\"assets\\qt0051_b652d6d39e40.png\" style=\"width: 143px; height: 134px;\" /></td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below:</p>"
  },
  "options": [
    {
      "text": "A- II B-IV, C-III, D-I",
      "is_correct": true
    },
    {
      "text": "A- I. B-II, C-III, D-IV",
