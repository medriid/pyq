      "id": "8uHXC",
      "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/a8711f98-dc79-4838-9d83-5b0d23c97fd7.png\" style=\"width: 220px; height: 185px;\"/>",
