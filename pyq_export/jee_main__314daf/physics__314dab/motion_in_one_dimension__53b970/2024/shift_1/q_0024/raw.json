  "question": {
    "text": "A body travels $102.5 \\mathrm{~m}$ in $\\mathrm{n}^{\\text {th }}$ second and $115.0 \\mathrm{~m}$ in $(\\mathrm{n}+2)^{\\text {th }}$ second. The acceleration is :",
    "image": null
  },
  "options": [
    {
      "id": "AlOcv",
      "text": "$6.25 \\mathrm{~m} / \\mathrm{s}^2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iZ9iy",
      "text": "$12.5 \\mathrm{~m} / \\mathrm{s}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RbUKS",
      "text": "$9 \\mathrm{~m} / \\mathrm{s}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hoqOC",
      "text": "$5 \\mathrm{~m} / \\mathrm{s}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\text { Given, } 102.5=\\mathrm{u}+\\frac{\\mathrm{a}}{2}(2 \\mathrm{n}-1) \\& \\\\\n& 115=\\mathrm{u}+\\frac{\\mathrm{a}}{2}(2 \\mathrm{n}+3) \\\\\n& \\Rightarrow 102.5=\\mathrm{u}+\\mathrm{an}-\\frac{\\mathrm{a}}{2} \\& \\\\\n& 115=\\mathrm{u}+\\mathrm{an}+\\frac{3 \\mathrm{a}}{2} \\\\\n& 12.5=2 \\mathrm{a} \\Rightarrow \\mathrm{a}=6.25 \\mathrm{~m} / \\mathrm{s}^2\n\\end{aligned}$",
    "image": null
  },
