      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mo>-</mo><mn>3</mn><mi>α</mi><msup><mi>v</mi><mn>2</mn></msup></math>",
      "is_correct": false
