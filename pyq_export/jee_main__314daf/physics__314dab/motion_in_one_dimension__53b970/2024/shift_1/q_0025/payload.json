    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mo>-</mo><mn>4</mn><mi>α</mi><msup><mi>v</mi><mn>4</mn></msup></math>",
