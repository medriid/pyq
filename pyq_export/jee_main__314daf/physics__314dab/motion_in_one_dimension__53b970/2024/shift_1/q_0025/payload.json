      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mo>-</mo><mn>2</mn><mi>α</mi><msup><mi>v</mi><mn>3</mn></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mo>-</mo><mn>5</mn><mi>α</mi><msup><mi>v</mi><mn>5</mn></msup></math>",
      "is_correct": false
