  "question": {
    "text": "A body starts moving from rest with constant acceleration covers displacement <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mn>1</mn></msub></math> in first <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>p</mi><mo>-</mo><mn>1</mn><mo>)</mo></math> seconds and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mn>2</mn></msub></math> in first <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi></math> seconds. The displacement <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mn>1</mn></msub><mo>+</mo><msub><mi>S</mi><mn>2</mn></msub></math> will be made in time :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mi>p</mi><mo>+</mo><mn>1</mn><mo>)</mo><mo> </mo><mi mathvariant=\"normal\">s</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfenced><mrow><mn>2</mn><msup><mi>p</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mfenced></msqrt><mo> </mo><mi mathvariant=\"normal\">s</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mi>p</mi><mo>-</mo><mn>1</mn><mo>)</mo><mo> </mo><mi mathvariant=\"normal\">s</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>2</mn><msup><mi>p</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo> </mo><mi mathvariant=\"normal\">s</mi></math>",
