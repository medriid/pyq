  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} \\mathrm{x}_{\\min }= & \\pi \\times \\mathrm{r}_{\\min } \\\\ = & \\pi \\times \\frac{60}{100} \\mathrm{~m} . \\\\ \\mathrm{x}_{\\text {second }} & =30 \\times 2 \\pi \\times \\mathrm{r}_{\\text {second }} \\\\ & =30 \\times 2 \\pi \\times \\frac{75}{100} \\\\ \\mathrm{x}= & \\mathrm{x}_{\\text {second }}-\\mathrm{x}_{\\min } \\\\ = & 139.4 \\mathrm{~m}\\end{aligned}$",
