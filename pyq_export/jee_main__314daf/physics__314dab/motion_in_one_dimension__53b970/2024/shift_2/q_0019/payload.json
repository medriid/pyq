  "question": {
    "text": "A cyclist starts from the point $P$ of a circular ground of radius $2 \\mathrm{~km}$ and travels along its circumference to the point $\\mathrm{S}$. The displacement of a cyclist is:\n<img src=\"assets\\qt0019_c2d4d31a8583.png\"><br>"
  },
  "options": [
    {
      "text": "$\\sqrt{8} \\mathrm{~km}$",
      "is_correct": true
    },
    {
      "text": "$8 \\mathrm{~km}$",
      "is_correct": false
    },
    {
      "text": "$6 \\mathrm{~km}$",
      "is_correct": false
    },
    {
      "text": "$4 \\mathrm{~km}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0019_9947124f22db.png\"><br />$\\therefore$ Displacement $=\\mathrm{R} \\sqrt{2}=2 \\sqrt{2}=\\sqrt{8} \\mathrm{~km}$"
  }
