    },
    {
      "id": "JH0fJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>g</mi><mi>n</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1QaTC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>g</mi><mrow><mn>2</mn><msup><mi>n</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "isCorrect": true,
