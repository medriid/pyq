  "correctValue": null,
  "solution": {
    "text": "Distance travelled = displacement when direction of velocity remains constant\n$\\begin{aligned} \\Rightarrow \\text { Distance } & =\\text { Area } \\\\ & =\\frac{1}{2}(2 \\mathrm{~s}+4 \\mathrm{~s})(10 \\mathrm{~m} / \\mathrm{s}) \\\\ & =30 \\mathrm{~m}\\end{aligned}$",
    "image": null
  },
