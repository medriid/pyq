  "question": {
    "text": "A particle moves along the $x$-axis and has its displacement $x$ varying with time $t$ according to the equation $\\mathrm{x}=\\mathrm{c}_0\\left(\\mathrm{t}^2-2\\right)+\\mathrm{c}(\\mathrm{t}-2)^2$ where $c_0$ and $c$ are constants of appropriate dimensions. Then, which of the following statements is correct?",
    "image": null
  },
  "options": [
    {
      "id": "KLtag",
      "text": "the acceleration of the particle is $2 \\mathrm{c}_0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "w80vJ",
      "text": "the acceleration of the particle is $2\\mathrm{~c}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bCGKQ",
      "text": "the initial velocity of the particle is $4\\mathrm{~c}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zCI7e",
      "text": "the acceleration of the particle is $2\\left(c+c_0\\right)$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{v}=\\frac{\\mathrm{dx}}{\\mathrm{dt}}=2 \\mathrm{tC}_0+2 \\mathrm{C}(\\mathrm{t}-2) \\\\ & \\mathrm{a}=\\frac{\\mathrm{dv}}{\\mathrm{dt}}=2 \\mathrm{C}_0+2 \\mathrm{C}\\end{aligned}$",
    "image": null
  },
