  "question": {
    "text": "A particle has an initial velocity $3 \\hat{i}+4 \\hat{j}$ and an acceleration of $0.4 \\hat{i}+0.3 \\hat{j}$. Its speed after 10 s is"
  },
  "options": [
    {
      "text": "\n10 units\n",
      "is_correct": false
    },
    {
      "text": "\n$7 \\sqrt{2}$ units\n",
      "is_correct": true
    },
    {
      "text": "\n7 units\n",
      "is_correct": false
    },
    {
      "text": "\n$8.5$ units",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n\\overrightarrow{\\mathrm{u}} & =3 \\hat{\\mathrm{i}}+4 \\hat{\\mathrm{j}} ; \\overrightarrow{\\mathrm{a}}=0.4 \\hat{\\mathrm{i}}+0.3 \\hat{\\mathrm{j}} \\\\\n\\overrightarrow{\\mathrm{u}} & =\\overrightarrow{\\mathrm{u}}+\\overrightarrow{\\mathrm{a}} \\mathrm{t} \\\\\n& =3 \\hat{\\mathrm{i}}+4 \\hat{\\mathrm{j}}+(0.4 \\hat{\\mathrm{i}}+0.3 \\hat{\\mathrm{j}}) 10=3 \\hat{i}+\\hat{\\mathrm{j}}+4 \\hat{\\mathrm{i}}+3 \\hat{\\mathrm{j}}=7 \\hat{\\mathrm{i}}+7 \\hat{\\mathrm{j}}\n\\end{aligned}\n$$\nSpeed is $\\sqrt{7^2+7^2}=7 \\sqrt{2}$ units"
  }
