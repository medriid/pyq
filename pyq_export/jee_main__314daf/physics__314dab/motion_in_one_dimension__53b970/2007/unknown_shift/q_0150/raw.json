  "question": {
    "text": "The velocity of a particle is $\\mathrm{v}=\\mathrm{v}_0+\\mathrm{gt}+\\mathrm{ft}^2$. If its position is $\\mathrm{x}=0$ at $\\mathrm{t}=0$, then its displacement after unit time $(t=1)$ is",
    "image": null
  },
  "options": [
    {
      "id": "CIHgO",
      "text": "\n$\\mathrm{v_0+2 g+3 f}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "49q7s",
      "text": "\n$\\mathrm{v_0+g / 2+f / 3}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "n8Kge",
      "text": "\n$\\mathrm{v_0+g+f}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FSA5j",
      "text": "\n$\\mathrm{v_0+g / 2+f}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{\\int_0^x d x=\\int_0^1\\left(V_0+g t+\\mathrm{ft}^2\\right) d t}$\n$\\mathrm{x=v_0+g\\left(\\frac{1}{2}\\right)+f\\left(\\frac{1}{3}\\right)}$",
    "image": null
  },
