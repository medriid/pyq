      "text": "2 g H = n<sup>2</sup>u<sup>2</sup>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QML8c",
      "text": "g H = (n - 2)<sup>2</sup>u<sup>2</sup>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l82Z2",
      "text": "2g H = nu<sup>2</sup>(n - 2)",
