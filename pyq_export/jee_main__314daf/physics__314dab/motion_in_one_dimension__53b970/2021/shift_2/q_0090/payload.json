      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac><mi>&#945;</mi><mo>+</mo><mfrac><mn>7</mn><mn>2</mn></mfrac><mi>&#946;</mi></math>",
