  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p>Draw&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mi>t</mi></math> curve&nbsp;</p><p><img src=\"assets\\st0102_3cb9c16a2579.png\" style=\"width: 279px; height: 208px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><msub><mi>&#952;</mi><mn>1</mn></msub><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mfrac><msub><mi>v</mi><mi>max</mi></msub><msub><mi>t</mi><mn>1</mn></msub></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#38;</mo><mo>&#160;</mo><mi>tan</mi><msub><mi>&#952;</mi><mn>2</mn></msub><mo>=</mo><msub><mi>a</mi><mn>2</mn></msub><mo>=</mo><mfrac><msub><mi>v</mi><mi>max</mi></msub><msub><mi>t</mi><mn>2</mn></msub></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#247;</mo></math> above</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>t</mi><mn>1</mn></msub><msub><mi>t</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><msub><mi>a</mi><mn>2</mn></msub><msub><mi>a</mi><mn>1</mn></msub></mfrac></math></p>"
