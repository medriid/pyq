  "question": {
    "text": "An engine of a train, moving with uniform acceleration, passes the signal-post with velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi></math> and the last compartment with velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math>. The velocity with which middle point of the train passes the signal post is :",
    "image": null
  },
  "options": [
    {
      "id": "9EKQe",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>u</mi><mo>+</mo><mi>v</mi></mrow><mn>2</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "OEx0y",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><msup><mi>v</mi><mn>2</mn></msup><mo>+</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></msqrt></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "BNZLe",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>v</mi><mo>-</mo><mi>u</mi></mrow><mn>2</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "brA85",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><msup><mi>v</mi><mn>2</mn></msup><mo>-</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></msqrt></math>",
      "isCorrect": false,
