  "question": {
    "text": "$A$ and $B$ are two like parallel forces. A couple of moment $\\mathrm{H}$ lies in the plane of $A$ and $B$ and is contained with them. The resultant of $A$ and $B$ after combining is displaced through a distance",
    "image": null
  },
  "options": [
    {
      "id": "yZWd8",
      "text": "\n$\\frac{2 \\mathrm{H}}{\\mathrm{A}-\\mathrm{B}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "T2UwD",
      "text": "\n$\\frac{H}{A+B}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "pW33c",
      "text": "\n$\\frac{H}{2(A+B)}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JxS59",
      "text": "\n$\\frac{H}{A-B}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& (A+B)=d=H \\\\\n& d=\\left(\\begin{array}{c}\nH \\\\\nA+B\n\\end{array}\\right) .\n\\end{aligned}\n$$",
    "image": null
  },
