  "question": {
    "text": "A parachutist after bailing out falls $50 \\mathrm{~m}$ without friction. When parachute opens, it decelerates at $2 \\mathrm{~m} / \\mathrm{s}^2$. He reaches the ground with a speed of $3 \\mathrm{~m} / \\mathrm{s}$. At what height, did he bail out?"
  },
  "options": [
    {
      "text": "\n$91 \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$182 \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$293 \\mathrm{~m}$\n",
      "is_correct": true
    },
    {
      "text": "\n$111 \\mathrm{~m}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$s=50+\\left(\\frac{3^2-(2 \\times 10 \\times 50)}{2(-2)}\\right)$\n$=293 \\mathrm{~m}$."
  }
