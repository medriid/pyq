  "question": {
    "text": "A particle located at $x=0$ at time $t=0$, starts moving along the positive $x$-direction with a velocity ' $v$ ' that varies as $v=\\alpha \\sqrt{x}$. The displacement of the particle varies with time as"
  },
  "options": [
    {
      "text": "\n$t^3$\n",
      "is_correct": false
    },
    {
      "text": "\n$t^2$\n",
      "is_correct": true
    },
    {
      "text": "\n$t$\n",
      "is_correct": false
    },
    {
      "text": "\n$t^{1 / 2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{d} x}{\\mathrm{dt}}=\\alpha \\int \\frac{\\mathrm{dx}}{\\sqrt{\\mathrm{x}}}=\\int \\alpha \\mathrm{dt} \\Rightarrow \\mathrm{x} \\alpha \\mathrm{t}^2$"
  }
}