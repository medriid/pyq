    "text": "<math><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">B</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>0</mn></mrow></msub><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">i</mi></mrow><mo>^</mo></mover><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">z</mi><mo>-</mo><mi mathvariant=\"normal\">&#969;</mi><mi mathvariant=\"normal\">t</mi></mrow></mfenced></mrow></mfenced><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>1</mn></mrow></msub><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">j</mi></mrow><mo>^</mo></mover><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">z</mi><mo>+</mo><mi mathvariant=\"normal\">&#969;</mi><mi mathvariant=\"normal\">t</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>0</mn></msub><mo>=</mo><mn>3</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">&#160;</mi><mo>&#38;</mo><mo>&#160;</mo><mo>&#160;</mo><msub><mi mathvariant=\"normal\">B</mi><mn>1</mn></msub><mo>=</mo><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></math><br />Electric filed associated with it is,<br /><math><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">E</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>0</mn></mrow></msub><mi mathvariant=\"normal\">c</mi><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">j</mi></mrow><mo>^</mo></mover><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">z</mi><mo>-</mo><mi mathvariant=\"normal\">&#969;</mi><mi mathvariant=\"normal\">t</mi></mrow></mfenced><mo>-</mo><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">c</mi><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">i</mi></mrow><mo>^</mo></mover><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">z</mi><mo>+</mo><mi mathvariant=\"normal\">&#969;</mi><mi mathvariant=\"normal\">t</mi></mrow></mfenced></math><br />Here, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> is&nbsp;the speed of light in vacuum.<br />At <math><mi mathvariant=\"normal\">z</mi><mo>=</mo><mn>0</mn><mo>,</mo></math><br /><math><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mtext>rms</mtext></mrow></msub><mo>=</mo><msqrt><mfrac><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">Q</mi><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>0</mn></mrow></msub><mi mathvariant=\"normal\">c</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">Q</mi><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">c</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt></math><br />Here <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math> is speed of light in vacuum.<br /><math><mo>=</mo><msqrt><mfrac><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>4</mn></mrow></msup><mo>&#215;</mo><mn>3</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>5</mn></mrow></msup><mo>&#215;</mo><mn>3</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>8</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>4</mn></mrow></msup><mo>&#215;</mo><mn>2</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>6</mn></mrow></msup><mo>&#215;</mo><mn>3</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>8</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt></math><br /><math><mo>=</mo><msqrt><mfrac><mrow><mn>0.81</mn><mo>+</mo><mn>0.0036</mn></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt><mo>=</mo><mn>0.6</mn><mtext>&#8201;</mtext><mi mathvariant=\"normal\">N</mi></math>",
