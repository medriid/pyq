    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup><msup><mi>Vm</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><mo>&#215;</mo><msup><mn>10</mn><mn>12</mn></msup><msup><mi>Vm</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
