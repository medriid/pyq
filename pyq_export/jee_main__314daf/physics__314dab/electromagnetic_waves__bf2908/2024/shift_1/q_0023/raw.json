  "question": {
    "text": "Electromagnetic waves travel in a medium with speed of $1.5 \\times 10^8 \\mathrm{~m} \\mathrm{~s}^{-1}$. The relative permeability of the medium is 2.0 . The relative permittivity will be:",
    "image": null
  },
  "options": [
    {
      "id": "HF4XJ",
      "text": "2",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "xwo7S",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BbnbB",
      "text": "5",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GDyXI",
      "text": "1",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\frac{\\varepsilon_{\\mathrm{m}} \\times \\mu_{\\mathrm{m}}}{\\varepsilon_0 \\times \\mu_0}=\\frac{\\frac{1}{\\mathrm{v}^2}}{\\frac{1}{\\mathrm{c}^2}} \\\\ & \\varepsilon_{\\mathrm{r}} \\times \\mu_{\\mathrm{r}}=\\frac{\\mathrm{c}^2}{\\mathrm{v}^2} \\\\ & \\varepsilon_{\\mathrm{r}} \\times 2=\\frac{\\left(3 \\times 10^8\\right)^2}{\\left(1.5 \\times 10^8\\right)^2} \\\\ & \\varepsilon_{\\mathrm{r}} \\times 2=4 \\\\ & \\varepsilon_{\\mathrm{r}}=2\\end{aligned}$",
    "image": null
  },
