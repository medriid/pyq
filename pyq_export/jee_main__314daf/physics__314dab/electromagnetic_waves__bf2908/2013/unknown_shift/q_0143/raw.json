  "question": {
    "text": "Photons of an electromagnetic radiation has an energy $11 \\mathrm{keV}$ each. To which region of electromagnetic spectrum does it belong ?",
    "image": null
  },
  "options": [
    {
      "id": "knd6l",
      "text": "\nX-ray region\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mSfPg",
      "text": "\nUltra violet region\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "q9gS2",
      "text": "\nInfrared region\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qAqPU",
      "text": "\nVisible region",
      "image": null,
      "isCorrect": false
    }
