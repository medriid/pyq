  "question": {
    "text": "A plane electromagnetic wave propagates along the $+x$ direction in free space. The components of the electric field, $\\vec{E}$ and magnetic field, $\\vec{B}$ vectors associated with the wave in Cartesian frame are"
  },
  "options": [
    {
      "text": "$\\mathrm{E}_x, \\mathrm{~B}_y$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{E}_y, \\mathrm{~B}_z$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{E}_z, \\mathrm{~B}_y$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{E}_y, \\mathrm{~B}_x$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0003_ff8e202af5f4.png\"><br>Direction of propagation\n$=\\overrightarrow{\\mathrm{E}} \\times \\overrightarrow{\\mathrm{B}}$"
