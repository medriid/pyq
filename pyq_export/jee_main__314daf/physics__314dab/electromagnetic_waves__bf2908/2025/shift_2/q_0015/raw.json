  "question": {
    "text": "The magnetic field of an E.M. wave is given by $\\overrightarrow{\\mathrm{B}}=\\left(\\frac{\\sqrt{3}}{2} \\hat{i}+\\frac{1}{2} \\hat{j}\\right) 30 \\sin \\left[\\omega\\left(\\mathrm{t}-\\frac{z}{\\mathrm{c}}\\right)\\right]$ (S.I. Units).\nThe corresponding electric field in S.I. units is :",
    "image": null
  },
  "options": [
    {
      "id": "4vP4T",
      "text": "$\\overrightarrow{\\mathrm{E}}=\\left(\\frac{1}{2} \\hat{i}-\\frac{\\sqrt{3}}{2} \\hat{j}\\right) 30 \\mathrm{c} \\sin \\left[\\omega\\left(\\mathrm{t}-\\frac{z}{\\mathrm{c}}\\right)\\right]$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "4p7gl",
      "text": "$\\overrightarrow{\\mathrm{E}}=\\left(\\frac{3}{4} \\hat{i}+\\frac{1}{4} \\hat{j}\\right) 30 \\mathrm{c} \\cos \\left[\\omega\\left(\\mathrm{t}-\\frac{z}{\\mathrm{c}}\\right)\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "S5rq9",
      "text": "$\\overrightarrow{\\mathrm{E}}=\\left(\\frac{1}{2} \\hat{i}+\\frac{\\sqrt{3}}{2} \\hat{j}\\right) 30 \\mathrm{c} \\sin \\left[\\omega\\left(\\mathrm{t}+\\frac{z}{\\mathrm{c}}\\right)\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SluGO",
      "text": "$\\overrightarrow{\\mathrm{E}}=\\left(\\frac{\\sqrt{3}}{2} \\hat{i}-\\frac{1}{2} \\hat{j}\\right) 30 \\mathrm{c} \\sin \\left[\\omega\\left(\\mathrm{t}+\\frac{z}{\\mathrm{c}}\\right)\\right]$",
      "image": null,
      "isCorrect": false
    }
