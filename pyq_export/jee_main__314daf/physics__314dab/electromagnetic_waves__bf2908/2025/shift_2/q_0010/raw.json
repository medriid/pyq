  "question": {
    "text": "The unit of $\\sqrt{\\frac{2 \\mathrm{I}}{\\epsilon_0 c}}$ is :<br/>(I = intensity of an electromagnetic wave, $\\mathrm{c}:$ speed of light)",
    "image": null
  },
  "options": [
    {
      "id": "j2m9Q",
      "text": "Vm",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FGJHw",
      "text": "NC",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "B68Li",
      "text": "Nm",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "j2gEF",
      "text": "$\\mathrm{NC}^{-1}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\mathrm{I}=\\frac{1}{2} \\epsilon_0 \\mathrm{E}_0^2 \\times \\mathrm{C} \\\\\n& \\mathrm{E}_0=\\sqrt{\\frac{2 \\mathrm{I}}{\\epsilon_0 \\mathrm{C}}}<br/>\\end{aligned}$<br/>$E_0$ : electric field N/C",
    "image": null
  },
