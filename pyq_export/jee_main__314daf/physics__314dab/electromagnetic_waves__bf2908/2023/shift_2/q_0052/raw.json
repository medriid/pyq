    {
      "id": "rwElR",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi><msub><mi>E</mi><mn>0</mn></msub><mo>=</mo><mi>k</mi><msub><mi>B</mi><mn>0</mn></msub></math>",
