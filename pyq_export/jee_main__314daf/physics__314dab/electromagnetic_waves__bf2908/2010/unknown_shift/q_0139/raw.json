  "question": {
    "text": "If a source of power $4 \\mathrm{~kW}$ produces $10^{20}$ photons/second, the radiation belong to a part of the spectrum called",
    "image": null
  },
  "options": [
    {
      "id": "aYDm5",
      "text": "\nX-rays\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "bG5qo",
      "text": "\nultraviolet rays\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3b84u",
      "text": "\nmicrowaves\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9icDG",
      "text": "\n$\\gamma$-rays",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& 4 \\times 10^3=10^{20} \\mathrm{xhf} \\\\\n& f=\\frac{4 \\times 10^3}{10^{20} \\times 6.023 \\times 10^{-34}} \\\\\n& f=6.03 \\times 10^{16} \\mathrm{~Hz}\n\\end{aligned}\n$$\nThe obtained frequency lies in the band of X-rays.",
    "image": null
  },
