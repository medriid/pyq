  "question": {
    "text": "A paramagnetic substance in the form of a cube with sides $1 \\mathrm{~cm}$ has a magnetic dipole moment of $20 \\times 10^{-6} \\mathrm{~J} / \\mathrm{T}$ when a magnetic intensity of $60 \\times 10^{3} \\mathrm{~A} / \\mathrm{m}$ is applied. Its magnetic susceptibility is:",
    "image": null
  },
  "options": [
    {
      "id": "MbyYJ",
      "text": "$3.3 \\times 10^{-2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "EKDr2",
      "text": "$4.3 \\times 10^{-2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "e0X2M",
      "text": "$2.3 \\times 10^{-2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SgewS",
      "text": "$3.3 \\times 10^{-4}$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Magnetic susceptibility,\r\n\r\n$\\chi=\\frac{\\mathrm{I}}{\\mathrm{H}}$\r\n\r\nwhere, $\\mathrm{I}=\\frac{\\text { Magnetic moment }}{\\text { Volume }}=\\frac{20 \\times 10^{-6}}{10^{-6}}=20 \\mathrm{~N} / \\mathrm{m}^{2}$\r\n\r\nNow , $\\chi=\\frac{20}{60 \\times 10^{3}}=\\frac{1}{3} \\times 10^{-3}=3.3 \\times 10^{-4}$",
    "image": null
  },
