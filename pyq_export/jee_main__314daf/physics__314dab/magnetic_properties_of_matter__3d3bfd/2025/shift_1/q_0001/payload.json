  "question": {
    "text": "The percentage increase in magnetic field (B) when space within a current carrying solenoid is filled with magnesium (magnetic susceptibility $\\left.\\chi_{\\mathrm{mg}}=1.2 \\times 10^{-5}\\right)$ is :"
  },
  "options": [
    {
      "text": "$\\frac{6}{5} \\times 10^{-3} \\%$",
      "is_correct": true
    },
    {
      "text": "$\\frac{5}{6} \\times 10^{-5} \\%$",
      "is_correct": false
    },
    {
      "text": "$\\frac{5}{6} \\times 10^{-4} \\%$",
      "is_correct": false
    },
    {
      "text": "$\\frac{5}{3} \\times 10^{-5} \\%$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\% \\text { change in } B=\\frac{B_{\\text {new }}-B_{\\text {old }}}{B_{\\text {old }}} \\times 100 \\% \\\\ & =\\frac{\\mu \\mathrm{ni}-\\mu_0 \\mathrm{ni}}{\\mu_0 \\mathrm{ni}} \\times 100 \\%=\\frac{\\left(\\mu-\\mu_0\\right)}{\\mu_0} \\times 100 \\% \\\\ & =\\frac{\\left(\\mu_0 \\mu_{\\mathrm{r}}-\\mu_0\\right)}{\\mu_0} \\times 100 \\% \\\\ & =\\left(\\mu_{\\mathrm{r}}-1\\right) \\times 100 \\% \\\\ & =\\chi_{\\mathrm{n}} \\times 100 \\% \\\\ & =1.2 \\times 10^{-3} \\%\\end{aligned}$"
  }
}