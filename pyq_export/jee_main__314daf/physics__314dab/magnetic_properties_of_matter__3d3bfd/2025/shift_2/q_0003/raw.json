  "question": {
    "text": "A solenoid having area $A$ and length ' $l$ ' is filled with a material having relative permeability 2. The magnetic energy stored in the solenoid is :",
    "image": null
  },
  "options": [
    {
      "id": "IZPUz",
      "text": "$\\frac{\\mathrm{B}^2 \\mathrm{~A} l}{\\mu_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GlKsJ",
      "text": "$\\frac{\\mathrm{B}^2 \\mathrm{~A} l}{2 \\mu_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sRF6D",
      "text": "$\\mathrm{B}^2 \\mathrm{Al}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HPT25",
      "text": "$\\frac{\\mathrm{B}^2 \\mathrm{~A} l}{4 \\mu_0}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\mathrm{U}}{\\mathrm{V}}=\\frac{\\mathrm{B}^2}{2 \\mu_{\\mathrm{r}} \\mathrm{u}_0} \\Rightarrow \\mathrm{U}=\\frac{\\mathrm{B}^2}{4 \\mu_0} \\mathrm{~V}=\\frac{\\mathrm{B}^2}{4 \\mu_0} \\mathrm{~A} \\ell$",
    "image": null
  },
