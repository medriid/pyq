  "question": {
    "text": "The free space inside a current carrying toroid is filled with a material of susceptibility <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>2</mn></mrow></msup></math>. The percentage increase in the value of magnetic field inside the toroid will be<br />&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "uvc3u",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>2</mn><mo>%</mo></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dHAWV",
