      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><msqrt><mn>6</mn></msqrt></mfenced></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "gYdrS",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><msqrt><mfrac><mn>2</mn><mn>3</mn></mfrac></msqrt></mfenced></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "p26n9",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><msqrt><mfrac><mn>1</mn><mn>2</mn></mfrac></msqrt></mfenced></math>",
      "isCorrect": false,
