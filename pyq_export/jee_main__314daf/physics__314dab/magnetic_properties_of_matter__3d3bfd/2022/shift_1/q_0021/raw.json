  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "A magnet hung at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>45</mn><mo>&#176;</mo></math> with magnetic meridian makes an angle of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>60</mn><mo>&#176;</mo></math> with the horizontal. The actual value of the angle of dip is",
    "image": null
  },
  "options": [
    {
      "id": "knnRV",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><msqrt><mfrac><mn>3</mn><mn>2</mn></mfrac></msqrt></mfenced></math>",
      "isCorrect": true,
      "image": null
    },
