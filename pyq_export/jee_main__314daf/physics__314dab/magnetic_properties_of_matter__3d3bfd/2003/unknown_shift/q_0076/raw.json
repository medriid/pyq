      "text": "\n$2 \\mathrm{~W}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\tau=(\\mathrm{H}) \\tan 60^{\\circ} \\quad=\\mathrm{W} \\cdot \\sqrt{3}$",
    "image": null
