  "question": {
    "text": "Assuming the gas to be ideal the work done on the gas in taking it from $A$ to $B$ is",
    "image": null
  },
  "options": [
    {
      "id": "x3xVy",
      "text": "\n$200 \\mathrm{R}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W9eB4",
      "text": "\n$300 \\mathrm{R}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sEjkH",
      "text": "\n$400 \\mathrm{R}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Y8V7M",
      "text": "\n$500 \\mathrm{R}$",
