  "question": {
    "text": "The net work done on the gas in the cycle ABCDA is"
  },
  "options": [
    {
      "text": "\nZero\n",
      "is_correct": false
    },
    {
      "text": "\n$276 \\mathrm{R}$\n",
      "is_correct": true
    },
    {
      "text": "\n$1076 \\mathrm{R}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1904 \\mathrm{R}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n\\text { Net work done in a cycle } & =W_{A B}+W_{B C}+W_{C B}+W_{B A} \\\\\n& =400 R+2 \\times 2.303 \\times 500 R \\ln 2-400 R-414 R \\\\\n& =1000 R \\times \\ln 2-600 R \\times \\ln 2=400 R \\times \\ln 2=276 R\n\\end{aligned}\n$$"
  }
