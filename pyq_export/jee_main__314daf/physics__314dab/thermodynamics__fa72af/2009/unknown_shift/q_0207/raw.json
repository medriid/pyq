  "question": {
    "text": "The work done on the gas in taking it from $D$ to $A$ is",
    "image": null
  },
  "options": [
    {
      "id": "0MIdZ",
      "text": "\n$-414 \\mathrm{R}$\n",
      "image": null,
      "isCorrect": true
    },
    {
