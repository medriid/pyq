  "question": {
    "text": "<p>Which one is the correct option for the two different thermodynamic processes ?</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/ce3f05ca-128c-41ae-8624-06aaa4766c4e-image.png\" style=\"width: 250px; height: 486px;\" /></p>",
    "image": null
  },
  "options": [
