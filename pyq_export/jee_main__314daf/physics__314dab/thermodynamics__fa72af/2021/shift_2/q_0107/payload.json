      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>S</mi><mn>1</mn></msub><msub><mrow><mo>&#160;</mo><mi>S</mi></mrow><mn>2</mn></msub></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mn>1</mn></msub><mo>+</mo><msub><mi>S</mi><mn>2</mn></msub></math>",
      "is_correct": true
    }
  ],
