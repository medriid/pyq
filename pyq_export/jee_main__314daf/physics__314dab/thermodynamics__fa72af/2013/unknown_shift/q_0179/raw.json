  "question": {
    "text": "A sample of gas expands from $V_1$ to $V_2$. In which of the following, the work done will be greatest?\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/lqXD0vKUfjFklRy0miNMuJZwFFKkuYzMGjnjf3FISY8.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "hgbhJ",
      "text": "\nSame in all processes\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8bZaj",
      "text": "\nIsobaric process\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "CIUNb",
      "text": "\nIsothermal process\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LFJLj",
      "text": "\nAdiabatic process",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Work done $=$ Area bounded by PV graph and volume axis\nAmong the three process, bounded area by PV graph and volume axis is greatest for isobaric process, hence work done is greatest for isobaric process.",
    "image": null
  },
