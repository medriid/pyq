    },
    {
      "id": "qtexE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>30</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XarRr",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>60</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "isCorrect": false,
