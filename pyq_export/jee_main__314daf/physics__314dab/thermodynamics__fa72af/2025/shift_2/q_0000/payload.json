  "question": {
    "text": "A monoatomic gas having $\\gamma=\\frac{5}{3}$ is stored in a thermally insulated container and the gas is suddenly compressed to $\\left(\\frac{1}{8}\\right)^{\\text {th }}$ of its initial volume. The ratio of final pressure and initial pressure is: ( $\\gamma$ is the ratio of specific heats of the gas at constant pressure and at constant volume)"
  },
  "options": [
    {
      "text": "16",
      "is_correct": false
    },
    {
      "text": "40",
      "is_correct": false
    },
    {
      "text": "32",
      "is_correct": true
    },
    {
      "text": "28",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & P_i V_i^\\gamma=P_f V_f^\\gamma \\\\ & \\frac{P_f}{P_i}=\\left(\\frac{V_i}{V_f}\\right)^\\gamma=(8)^{5 / 3} \\\\ & \\frac{P_f}{P_i}=32\\end{aligned}$"
  }
}