  "question": {
    "text": "Pressure of an ideal gas, contained in a closed vessel, is increased by $0.4 \\%$ when heated by $1^{\\circ} \\mathrm{C}$. Its initial temperature must be :"
  },
  "options": [
    {
      "text": "$25^{\\circ} \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$2500\\mathrm{~K}$",
      "is_correct": false
    },
    {
      "text": "$250\\mathrm{~K}$",
      "is_correct": true
    },
    {
      "text": "$250^{\\circ} \\mathrm{C}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Isochoric process<br/>$\\begin{aligned} & \\mathrm{P} \\propto \\mathrm{T} \\\\ & \\frac{\\Delta \\mathrm{P}}{\\mathrm{P}}=\\frac{\\Delta \\mathrm{T}}{\\mathrm{T}}\\end{aligned}$<br/>$\\begin{aligned} & \\frac{0.4}{100}=\\frac{1}{T} \\\\ & T=250 \\mathrm{~K}\\end{aligned}$"
  }
}