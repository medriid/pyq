  "question": {
    "text": "Water of mass $m$ gram is slowly heated to increase the temperature from $T_1$ to $T_z$ The change in entropy of the water, given specific heat of water is $1 \\mathrm{Jkg}^{-1} \\mathrm{~K}^{-1}$, is :"
  },
  "options": [
    {
      "text": "$\\mathrm{m} \\ln \\left(\\frac{\\mathrm{T}_2}{\\mathrm{~T}_1}\\right)$",
      "is_correct": true
    },
    {
      "text": "zero",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{m} \\ln \\left(\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}\\right)$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{m}\\left(\\mathrm{T}_2-\\mathrm{T}_1\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & d \\mathrm{Q}=\\mathrm{msdT} \\\\ & \\mathrm{dS}=\\frac{\\mathrm{dQ}}{\\mathrm{T}}=\\frac{\\mathrm{msdT}}{\\mathrm{T}} \\\\ & \\Delta \\mathrm{S}=\\int \\frac{\\mathrm{msdT}}{\\mathrm{T}}=\\mathrm{ms} \\ln \\frac{\\mathrm{T}_{\\mathrm{f}}}{\\mathrm{T}_{\\mathrm{i}}} \\\\ & \\Delta \\mathrm{S}=\\mathrm{m} \\ln \\frac{\\mathrm{T}_2}{\\mathrm{~T}_1}\\end{aligned}$"
  }
