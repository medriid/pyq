  "question": {
    "text": "In an adiabatic process, which of the following statements is true?",
    "image": null
  },
  "options": [
    {
      "id": "K6XAm",
      "text": "The molar heat capacity is infinite",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vblgN",
      "text": "Work done by the gas equals the increase in internal energy",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tSpmM",
      "text": "The molar heat capacity is zero",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Dhjle",
      "text": "The internal energy of the gas decreases as the temperature increases",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For adiabatic process, $\\mathrm{dQ}=0$<br/>$\\therefore$ Molar heat capacity $=0$<br/>$\\because \\mathrm{dQ}=0 \\Rightarrow \\mathrm{dU}=-\\mathrm{dW}$<br/>Also $\\mathrm{dU}=\\frac{\\mathrm{f}}{2} \\mathrm{nRdT}$<br/>$\\therefore$ Only option (3) is correct.",
    "image": null
  },
