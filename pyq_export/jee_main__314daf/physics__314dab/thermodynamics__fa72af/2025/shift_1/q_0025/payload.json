  "question": {
    "text": "The workdone in an adiabatic change in an ideal gas depends upon only :"
  },
  "options": [
    {
      "text": "change in its temperature",
      "is_correct": true
    },
    {
      "text": "change in its volume",
      "is_correct": false
    },
    {
      "text": "change in its pressure",
      "is_correct": false
    },
    {
      "text": "change in its specific heat",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Work done in adiabatic process $=\\frac{n R \\Delta T}{1-\\gamma}$\nSo, depends upon change in temperature."
  }
