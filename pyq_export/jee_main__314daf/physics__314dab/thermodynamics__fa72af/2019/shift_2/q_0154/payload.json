    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>0</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">R</mi></mrow></mfrac></math>",
