  "question": {
    "text": "In an Isothermal change, the change in pressure and volume of a gas can be represented for three different temperature;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>T</mi><mn>2</mn></msub><mo>&#62;</mo><msub><mi>T</mi><mn>1</mn></msub></math>&nbsp;as:"
  },
  "options": [
    {
      "text": "<img alt=\"\" src=\"assets\\ot1_0066_4045243014c7.png\" style=\"width: 174px; height: 180px;\" />",
      "is_correct": false
    },
    {
      "text": "<img alt=\"\" src=\"assets\\ot2_0066_8cf64fe7092b.png\" style=\"width: 175px; height: 180px;\" />",
      "is_correct": false
