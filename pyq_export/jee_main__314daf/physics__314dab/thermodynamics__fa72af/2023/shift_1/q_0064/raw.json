  "question": {
    "text": "A sample of gas at temperature <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is adiabatically expanded to double its volume. The work done by the gas in the process is given, (given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#947;</mi><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math>)&nbsp;:",
    "image": null
  },
  "options": [
    {
