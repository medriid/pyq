  "question": {
    "text": "The correct relation between&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#947;</mi><mo>=</mo><mfrac><msub><mi>C</mi><mi>P</mi></msub><msub><mi>C</mi><mi>V</mi></msub></mfrac></math>&nbsp;and&nbsp;temperature <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#947;</mi><mo>&#8733;</mo><mfrac><mn>1</mn><msqrt><mi>T</mi></msqrt></mfrac></math>",
