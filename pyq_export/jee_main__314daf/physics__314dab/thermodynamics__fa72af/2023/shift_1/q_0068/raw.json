  "question": {
    "text": "<p>The pressure of a gas changes linearly with volume from <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>&nbsp;as shown in figure. If no heat is supplied to or extracted from the gas then change in the internal energy of the gas will be</p><p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/fa24b284-3656-46d6-b32d-f5188b3835dc-9895800_1.PNG\" style=\"width: 309px; height: 260px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "2phgj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mn>6</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "isCorrect": false,
      "image": null
    },
