  "question": {
    "text": "<p>The pressure of a gas changes linearly with volume from <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>&nbsp;as shown in figure. If no heat is supplied to or extracted from the gas then change in the internal energy of the gas will be</p><p><img alt=\"\" src=\"assets\\qt0068_7bd58d00bdcd.png\" style=\"width: 309px; height: 260px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mn>6</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "is_correct": false
    },
    {
