  "solution": {
    "text": "Equation of the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mi>C</mi></math>,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>=</mo><msub><mi>P</mi><mn>0</mn></msub><mo>-</mo><mfrac><mrow><mn>2</mn><msub><mi>P</mi><mn>0</mn></msub></mrow><msub><mi>V</mi><mn>0</mn></msub></mfrac><mo>(</mo><mi>V</mi><mo>-</mo><mn>2</mn><msub><mi>V</mi><mn>0</mn></msub><mo>)</mo></math>,&nbsp;the temperature <math><mo>=</mo><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>V</mi><mo>-</mo><mi>&#160;</mi><mfrac><mrow><mn>2</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><msup><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac><mo>+</mo><mn>4</mn><msub><mrow><mi>P</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>V</mi></mrow><mrow><mn>1</mn><mi>&#160;</mi><mo>&#215;</mo><mi>R</mi></mrow></mfrac></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>T</mi><mo>=</mo><mfrac><msub><mi>P</mi><mn>0</mn></msub><mi>R</mi></mfrac><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mn>5</mn><mi>V</mi><mo>-</mo><mfrac><mrow><mn>2</mn><msup><mi>V</mi><mn>2</mn></msup></mrow><msub><mi>V</mi><mn>0</mn></msub></mfrac></mrow></mfenced></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>d</mi><mi>T</mi></mrow><mrow><mi>d</mi><mi>V</mi></mrow></mfrac><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>5</mn><mo>-</mo><mfrac><mrow><mn>4</mn><mi>V</mi></mrow><msub><mi>V</mi><mn>0</mn></msub></mfrac><mo>=</mo><mn>0</mn></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>V</mi><mo>=</mo><mfrac><mn>5</mn><mn>4</mn></mfrac><msub><mi>V</mi><mn>0</mn></msub></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>T</mi><mo>=</mo><mfrac><msub><mi>P</m