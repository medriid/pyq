  "question": {
    "text": "A Carnot engine, having an efficiency of $\\eta=1 / 10$ as heat engine, is used as a refrigerator. If the work done on the system is $10 \\mathrm{~J}$, the amount of energy absorbed from the reservoir at lower temperature is"
  },
  "options": [
    {
      "text": "\n$99 \\mathrm{~J}$\n",
      "is_correct": false
    },
    {
      "text": "\n$90 \\mathrm{~J}$\n",
      "is_correct": true
    },
    {
      "text": "\n$1 \\mathrm{~J}$\n",
      "is_correct": false
    },
    {
      "text": "\n$100 \\mathrm{~J}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\mathrm{W} & =\\mathrm{Q}_2\\left(\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}-1\\right) \\quad \\eta=1-\\frac{\\mathrm{T}_2}{\\mathrm{~T}_1} \\\\ 10 & =\\mathrm{Q}_2\\left(\\frac{10}{9}-1\\right) \\quad \\frac{1}{10}=1-\\frac{\\mathrm{T}_2}{\\mathrm{~T}_1} \\Rightarrow \\frac{\\mathrm{T}_2}{\\mathrm{~T}_1}=1-\\frac{1}{10}=\\frac{9}{10} \\\\ 10 & =\\mathrm{Q}_2\\left(\\frac{1}{9}\\right) \\Rightarrow \\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}=\\frac{10}{9} \\\\ \\mathrm{Q}_2 & =90 \\mathrm{~J}\\end{aligned}$"
  }
}