  "solution": {
    "text": "Relaxation time <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mi mathvariant=\"normal\">&#964;</mi></mfenced><mo>&#8733;</mo><mfrac><mi mathvariant=\"normal\">V</mi><msqrt><mi mathvariant=\"normal\">T</mi></msqrt></mfrac></math><br />And <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">T</mi><mo>&#8733;</mo><mfrac><mn>1</mn><msup><mi mathvariant=\"normal\">V</mi><mrow><mi mathvariant=\"normal\">&#947;</mi><mo>-</mo><mn>1</mn></mrow></msup></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#964;</mi><mo>&#8733;</mo><msup><mi mathvariant=\"normal\">V</mi><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mi mathvariant=\"normal\">&#947;</mi><mo>-</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#964;</mi><mo>&#8733;</mo><msup><mi mathvariant=\"normal\">V</mi><mfrac><mrow><mn>1</mn><mo>+</mo><mi mathvariant=\"normal\">&#947;</mi></mrow><mn>2</mn></mfrac></msup></math><br /><math><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&#964;</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#964;</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub></mrow></mfrac><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">V</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mfrac><mrow><mi mathvariant=\"normal\">&#947;</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></math><br /><math><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&#964;</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#964;</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub></mrow></mfrac><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></mrow><mrow><mfrac><mrow><mi mathvariant=\"normal\">&#947;</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></math>"
