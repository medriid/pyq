  "solution": {
    "text": "For Carnot engine using as refrigerator<br /><math><mi>W</mi><mo>=</mo><msub><mrow><mi>Q</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>-</mo><mn>1</mn></mrow></mfenced></math><br />It is given <math><mi mathvariant=\"normal\"></mi><mi>&#951;</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>10</mn></mrow></mfrac><mi></mi><mo>&#8658;</mo><mi></mi><mi>&#951;</mi><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi></mi><mo>&#8658;</mo><mi></mi><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>10</mn></mrow></mfrac></math><br />So <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>,</mo><msub><mi>Q</mi><mn>2</mn></msub><mo>=</mo><mn>90</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi><mo>&#160;</mo><mfenced separators=\"|\"><mrow><mi>a</mi><mi>s</mi><mo>&#160;</mo><mi>W</mi><mo>=</mo><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></mrow></mfenced></math>"
  }
