sub><mrow><mi>T</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac><mo>=</mo><mn>2</mn><mo>×</mo><mn>300</mn><mo>×</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>8</mn><mo>/</mo><mn>5</mn></mrow></msup></math><br /><math><msub><mrow><mi>T</mi></mrow><mrow><mi>c</mi></mrow></msub><mo>=</mo><mn>1818.859</mn></math><br /><math><msub><mrow><mi>T</mi></mrow><mrow><mi>c</mi></mrow></msub><mo>=</mo><mn>1819</mn><mi></mi><mi>K</mi></math><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/fefec39d-c84f-42af-b368-089e652d4f11.jpeg\" />",
