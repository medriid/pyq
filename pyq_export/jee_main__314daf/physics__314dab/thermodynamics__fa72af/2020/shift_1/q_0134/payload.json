rmal\">n</mi><mn>0</mn></msub><mi mathvariant=\"normal\">R</mi><mo>&#215;</mo><mn>250</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mn>2</mn></msub><mfenced><mrow><mn>2</mn><msub><mi>V</mi><mn>1</mn></msub></mrow></mfenced><mo>=</mo><mfenced><mrow><mo>.</mo><mn>25</mn><msub><mi mathvariant=\"normal\">n</mi><mn>0</mn></msub><mi mathvariant=\"normal\">R</mi><mo>(</mo><mn>2000</mn><mo>)</mo></mrow></mfenced></math><br />equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>)</mo><mo>&#160;</mo><mo>/</mo><mo>(</mo><mn>2</mn><mo>)</mo></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>P</mi><mn>1</mn></msub><mrow><mn>2</mn><msub><mi>P</mi><mn>2</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mn>250</mn><mrow><mn>1</mn><mo>.</mo><mn>25</mn><mo>&#215;</mo><mn>2000</mn></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>P</mi><mn>1</mn></msub><msub><mi>P</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>5</mn></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>P</mi><mn>2</mn></msub><msub><mi>P</mi><mn>1</mn></msub></mfrac><mo>=</mo><mn>5</mn></math></p></blockquote>"
