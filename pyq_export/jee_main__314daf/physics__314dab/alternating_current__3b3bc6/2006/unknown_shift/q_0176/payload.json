  "question": {
    "text": "An inductor $(L=100 \\mathrm{mH})$, a resistor $(R=100 \\Omega)$ and a battery $(E=100 \\mathrm{~V})$ are initially connected in series as shown in the figure. After a long time the battery is disconnected after short circuiting the points $A$ and $B$. The current in the circuit $1 \\mathrm{~mm}$ after the circuit is\n<img src=\"assets\\qt0176_b6f9e5a2e81b.png\"><br>"
  },
  "options": [
    {
      "text": "\n$1 \\mathrm{~A}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1 / \\mathrm{e} \\mathrm{A}$\n",
      "is_correct": true
    },
    {
      "text": "\n$e \\mathrm{~A}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.1 \\mathrm{~A}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{I}=\\mathrm{I}_0 \\mathrm{e}^{-\\mathrm{Rt} / \\mathrm{L}}=\\frac{1}{\\mathrm{e}} \\mathrm{A}$"
  }
