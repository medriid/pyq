      "text": "\n$2.5 \\times 10^{-2} \\mathrm{~V}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6ckVG",
      "text": "\n$40 \\mathrm{~V}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "q7UkT",
      "text": "\n$250 \\mathrm{~V}$",
      "image": null,
      "isCorrect": true
