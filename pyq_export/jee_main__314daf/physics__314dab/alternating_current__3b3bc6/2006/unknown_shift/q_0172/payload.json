    {
      "text": "\n$2.5 \\times 10^{-2} \\mathrm{~V}$\n",
      "is_correct": false
    },
    {
      "text": "\n$40 \\mathrm{~V}$\n",
      "is_correct": false
    },
    {
      "text": "\n$250 \\mathrm{~V}$",
      "is_correct": true
