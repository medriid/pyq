      "text": "\n$e \\mathrm{~A}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "h60Fr",
      "text": "\n$0.1 \\mathrm{~A}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
