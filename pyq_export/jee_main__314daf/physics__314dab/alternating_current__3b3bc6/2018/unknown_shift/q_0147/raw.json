    {
      "id": "b7YUJ",
      "text": "<math><mfrac><mrow><mn>1000</mn></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mn>10</mn></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ndfns",
      "text": "<math><mfrac><mrow><mn>50</mn></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mn>0</mn></math>",
      "image": null,
