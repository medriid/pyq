  "solution": {
    "text": "Efficiency <math><mi>n</mi><mo>=</mo><mn>90</mn><mi>%</mi></math><br /><br /><math><mo>&#8658;</mo><mn>0.9</mn><mo>&#215;</mo><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mo>=</mo><mi mathvariant=\"normal\">P</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">t</mi></math><br /><br /><math><mn>0.9</mn><mo>&#215;</mo><mn>2300</mn><mo>&#215;</mo><mn>5</mn><mo>=</mo><mn>230</mn><mo>&#215;</mo><msub><mrow><mi>I</mi></mrow><mrow><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">t</mi></mrow></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mrow><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">t</mi></mrow></msub><mo>=</mo><mn>45</mn><mi>&#160;</mi><mi mathvariant=\"normal\">A</mi></math>"
