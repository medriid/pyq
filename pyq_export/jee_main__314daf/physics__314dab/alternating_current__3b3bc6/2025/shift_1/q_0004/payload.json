  "question": {
    "text": "An alternating current is represented by the equation, $i=100 \\sqrt{2} \\sin (100 \\pi t)$ ampere. The RMS value of current and the frequency of the given alternating current are"
  },
  "options": [
    {
      "text": "$100 \\sqrt{2} \\mathrm{~A}, 100 \\mathrm{~Hz}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{100}{\\sqrt{2}} \\mathrm{~A}, 100 \\mathrm{~Hz}$",
      "is_correct": false
    },
    {
      "text": "$100 \\mathrm{~A}, 50 \\mathrm{~Hz}$",
      "is_correct": true
    },
    {
      "text": "$50 \\sqrt{2} \\mathrm{~A}, 50 \\mathrm{~Hz}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{i}_{\\mathrm{r}}=\\frac{\\mathrm{i}_0}{\\sqrt{2}}=100 \\mathrm{~A} \\\\ & \\mathrm{f}=\\frac{\\mathrm{w}}{2 \\pi}=\\frac{100 \\pi}{2 \\pi}=50 \\mathrm{~Hz}\\end{aligned}$"
  }
}