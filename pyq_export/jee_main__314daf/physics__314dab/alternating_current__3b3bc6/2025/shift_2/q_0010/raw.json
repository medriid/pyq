  "question": {
    "text": "An electric bulb rated as $100 \\mathrm{~W}-220 \\mathrm{~V}$ is connected to an ac source of rms voltage 220 V. The peak value of current through the bulb is :",
    "image": null
  },
  "options": [
    {
      "id": "ZxM13",
      "text": "$0.64\\mathrm{~A}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "SyJOQ",
      "text": "$0.45\\mathrm{~A}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MsRZL",
      "text": "$2.2\\mathrm{~A}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mok0O",
      "text": "$0.32\\mathrm{~A}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{P}=\\mathrm{v}_{\\mathrm{rms}} \\mathrm{i}_{\\mathrm{rms}} \\\\ & \\mathrm{i}_{\\mathrm{rms}}=\\frac{100}{220} \\\\ & \\mathrm{i}_0=\\sqrt{2} \\mathrm{i}_{\\mathrm{rms}}=0.64 \\mathrm{~A}\\end{aligned}$",
    "image": null
  },
