  "question": {
    "text": "A coil of negligible resistance is connected in series with $90 \\Omega$ resistor across $120 \\mathrm{~V}, 60 \\mathrm{~Hz}$ supply. A voltmeter reads $36 \\mathrm{~V}$ across resistance. Inductance of the coil is :",
    "image": null
  },
  "options": [
    {
      "id": "TqsYv",
      "text": "$0.286 \\mathrm{H}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eGFbs",
      "text": "$0.76 \\mathrm{H}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "2vEfq",
      "text": "$2.86 \\mathrm{H}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nS1o9",
      "text": "$0.91 \\mathrm{H}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/C-J8ry5u34D2mW9u6Jty73ZyAYC4n7G5vPOKyuQtaMg.original.fullsize.png\"><br />$\\begin{aligned} & 36=I_{\\mathrm{rms}} \\mathrm{R} \\\\ & 36=\\frac{120}{\\sqrt{\\mathrm{X}_{\\mathrm{L}}^2+\\mathrm{R}^2}} \\times \\mathrm{R} \\\\ & \\mathrm{R}=90 \\Omega \\Rightarrow 36=\\frac{120 \\times 90}{\\sqrt{\\mathrm{X}_{\\mathrm{L}}^2+90^2}} \\\\ & \\sqrt{\\mathrm{X}_{\\mathrm{L}}^2+90^2}=300 \\\\ & \\mathrm{X}_{\\mathrm{L}}^2=81900 \\\\ & \\mathrm{X}_{\\mathrm{L}}=286.18 \\\\ & \\omega \\mathrm{L}=286.18 \\\\ & \\mathrm{~L}=\\frac{286.18}{376.8} \\\\ & \\mathrm{~L}=0.76 \\mathrm{H}\\end{aligned}$",
    "image": null
  },
