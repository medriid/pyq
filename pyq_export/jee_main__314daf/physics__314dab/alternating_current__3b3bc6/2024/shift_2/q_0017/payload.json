  "question": {
    "text": "A series LCR circuit is subjected to an ac signal of $200 \\mathrm{~V}, 50 \\mathrm{~Hz}$. If the voltage across the inductor $(\\mathrm{L}=10 \\mathrm{mH})$ is $31.4 \\mathrm{~V}$, then the current in this circuit is _____ ."
  },
  "options": [
    {
      "text": "$68 \\mathrm{~A}$",
      "is_correct": false
    },
    {
      "text": "$63 \\mathrm{~A}$",
      "is_correct": false
    },
    {
      "text": "$10 \\mathrm{~A}$",
      "is_correct": true
    },
    {
      "text": "$10 \\mathrm{~mA}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Voltage across inductor } \\mathrm{V}_{\\mathrm{L}}=\\mathrm{IX}_{\\mathrm{L}} \\\\ & 31.4=\\mathrm{I}[\\mathrm{L} \\omega] \\\\ & 31.4=\\mathrm{I}[\\mathrm{L}(2 \\pi \\mathrm{f})] \\\\ & 31.4=\\mathrm{I}\\left[10 \\times 10^{-3}(2 \\times 3.14) \\times 50\\right. \\\\ & \\Rightarrow \\mathrm{I}=10 \\mathrm{~A}\\end{aligned}$"
  }
}