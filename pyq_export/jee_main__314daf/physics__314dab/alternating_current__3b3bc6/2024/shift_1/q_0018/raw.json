  "question": {
    "text": "A LCR circuit is at resonance for a capacitor $C$, inductance $L$ and resistance $R$. Now the value of resistance is halved keeping all other parameters same. The current amplitude at resonance will be now:",
    "image": null
  },
  "options": [
    {
      "id": "xArWy",
      "text": "Zero",
      "image": null,
      "isCorrect": false
    },
