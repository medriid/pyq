  "question": {
    "text": "<p>In the given circuit, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mi>m</mi><mi>s</mi></math>&nbsp;value of current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><msub><mi>I</mi><mrow><mi>r</mi><mi>m</mi><mi>s</mi></mrow></msub></mfenced></math> through the resistor <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is :</p><p><img alt=\"\" src=\"assets\\qt0052_e16083596e88.png\" style=\"width: 311px; height: 160px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi></math>",
