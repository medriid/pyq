    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><msub><mi>X</mi><mi>C</mi></msub><mo>,</mo><mi>B</mi><mo>=</mo><msub><mi>X</mi><mi>L</mi></msub></math>",
