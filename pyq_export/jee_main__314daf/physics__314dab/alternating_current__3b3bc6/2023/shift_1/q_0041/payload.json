  "question": {
    "text": "<p><img src=\"assets\\qt0041_a79aafff6dd1.png\" style=\"width: 350px; height: 189px;\" /></p><p>As per the given graph, choose the correct representation for curve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and curve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math><br />{Where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>X</mi><mi>C</mi></msub><mo>=</mo></math> Reactance of pure capacitive circuit connected with A.C. source<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>X</mi><mi>L</mi></msub><mo>=</mo></math> Reactance of pure inductive circuit connected with A.C. source<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo></math> Impedance of pure resistive circuit connected with A.C. source<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Z</mi><mo>=</mo></math> Impedance of the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mi>C</mi><mi>R</mi></math> series circuit }</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><msub><mi>X</mi><mi>C</mi></msub><mo>,</mo><mi>B</mi><mo>=</mo><mi>R</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><msub><mi>X</mi><mi>L</mi></msub><mo>,</mo><mi>B</mi><mo>=</mo><mi>R</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><msub><mi>X</mi><mi>L</mi></msub><mo>,</mo><mi>B</mi><mo>=</mo><mi>Z</mi></math>",
      "is_correct": false
