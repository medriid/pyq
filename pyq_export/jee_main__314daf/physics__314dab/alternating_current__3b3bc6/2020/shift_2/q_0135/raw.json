    },
    {
      "id": "bxGzU",
      "text": "<math><msub><mrow><mi>Q</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>C</mi><mi>V</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><msub><mrow><mi>Q</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>V</mi><mi>C</mi></mrow><mrow><mi>e</mi></mrow></mfrac></math>",
