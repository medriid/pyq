    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>L</mi><mi>R</mi></mfrac><mi>ln</mi><mfenced><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo>+</mo><mn>1</mn></mrow><mrow><msqrt><mi>n</mi></msqrt><mo>-</mo><mn>1</mn></mrow></mfrac></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>L</mi><mi>R</mi></mfrac><mi>ln</mi><mfenced><mfrac><msqrt><mi>n</mi></msqrt><mrow><msqrt><mi>n</mi></msqrt><mo>+</mo><mn>1</mn></mrow></mfrac></mfenced></math>&nbsp;",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>L</mi><mi>R</mi></mfrac><mi>ln</mi><mfenced><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo>-</mo><mn>1</mn></mrow><msqrt><mi>n</mi></msqrt></mfrac></mfenced></math>",
