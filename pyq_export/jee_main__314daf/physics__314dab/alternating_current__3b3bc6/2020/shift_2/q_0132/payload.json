  "question": {
    "text": "A series <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>-</mo><mi>R</mi></math>&nbsp;circuit is connected to a battery of emf <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi></math>. If the circuit is switched on at&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>0</mn></math>, then the time at which the energy stored in the inductor reaches&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mfrac><mn>1</mn><mi>n</mi></mfrac></mfenced></math> times of its maximum value, is :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>L</mi><mi>R</mi></mfrac><mi>ln</mi><mfenced><mfrac><msqrt><mi>n</mi></msqrt><mrow><msqrt><mi>n</mi></msqrt><mo>-</mo><mn>1</mn></mrow></mfrac></mfenced></math>",
