  "question": {
    "text": "In a transformer, number of turns in the primary coil are 140 and that in the secondary coil are 280. If current in primary coil is $4 \\mathrm{~A}$, then that in the secondary coil is"
  },
  "options": [
    {
      "text": "\n4 A\n",
      "is_correct": false
    },
    {
      "text": "\n2 A\n",
      "is_correct": true
    },
    {
      "text": "\n6 A\n",
      "is_correct": false
    },
    {
      "text": "\n10 A",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$I_1 N_1=I_2 N_2 \\Rightarrow I_2=\\frac{4 \\times 140}{280}=2 \\mathrm{~A}$"
  }
}