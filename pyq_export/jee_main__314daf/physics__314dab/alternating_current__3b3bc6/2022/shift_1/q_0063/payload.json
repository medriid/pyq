      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>10</mn><mo>&#160;</mo><mi>ms</mi><mo>;</mo><mi>U</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>mJ</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>7</mn><mo>&#160;</mo><mi>ms</mi><mo>;</mo><mi>U</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>mJ</mi></math>",
      "is_correct": true
