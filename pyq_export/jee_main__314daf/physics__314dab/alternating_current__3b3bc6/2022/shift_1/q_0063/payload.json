    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>7</mn><mo>&#160;</mo><mi>ms</mi><mo>;</mo><mi>U</mi><mo>=</mo><mn>2</mn><mo>&#160;</mo><mi>mJ</mi></math>",
