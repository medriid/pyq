  "level": 1,
  "question": {
    "text": "A resistance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>40</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math>&nbsp;is connected to a source of alternating current rated <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>220</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi><mo>,</mo><mn>50</mn><mo>&#160;</mo><mi>Hz</mi></math>. Find the time taken by the current to change from its maximum value to the rms value :",
    "image": null
  },
  "options": [
    {
      "id": "I9Kk3",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>5</mn><mo>&#160;</mo><mi>ms</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "xLsEp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>25</mn><mo>&#160;</mo><mi>ms</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "cBDXp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "jAEnq",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>25</mn><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></math>",
      "isCorrect": false,
      "image": null
