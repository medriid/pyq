    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mrow><mn>9</mn><mo>.</mo><mn>46</mn></mrow></mfenced></math>",
      "is_correct": false
