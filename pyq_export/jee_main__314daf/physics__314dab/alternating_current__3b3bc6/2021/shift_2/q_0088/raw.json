    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Z</mi><mi>C</mi></msub><mo>=</mo><msqrt><msup><mfenced><mfrac><mn>1</mn><mrow><mi>&#969;</mi><mi>C</mi></mrow></mfrac></mfenced><mn>2</mn></msup><mo>+</mo><msup><mi>R</mi><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><msup><mfenced><mfrac><mn>1</mn><mrow><mn>100</mn><mo>&#215;</mo><mn>100</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow></mfrac></mfenced><mn>2</mn></msup><mo>+</mo><msup><mn>100</mn><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><msup><mn>100</mn><mn>2</mn></msup><mo>+</mo><msup><mn>100</mn><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>100</mn><msqrt><mn>2</mn></msqrt><mo>&#160;</mo><mi>&#937;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Z</mi><mi>L</mi></msub><mo>=</mo><msqrt><mo>(</mo><mi>&#969;</mi><mi>L</mi><msup><mo>)</mo><mn>2</mn></msup><mo>+</mo><msup><mi>R</mi><mn>2</mn></msup></msqrt><mo>=</mo><msqrt><mo>(</mo><mn>100</mn><mo>&#215;</mo><mn>0</mn><mo>.</mo><mn>5</mn><msup><mo>)</mo><mn>2</mn></msup><mo>+</mo><msup><mn>50</mn><mn>2</mn></msup></msqrt><mo>=</mo><mn>50</mn><msqrt><mn>2</mn></msqrt><mo>&#160;</mo><mi>&#937;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mi>L</mi></msub><mo>=</mo><mfrac><mn>200</mn><msub><mi mathvariant=\"normal\">Z</mi><mi mathvariant=\"normal\">L</mi></msub></mfrac><mo>=</mo><mfrac><mn>200</mn><mrow><mn>50</mn><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mn>4</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>=</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>&#160;</mo><mtext>A</mtext></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">C</mi></msub><mo>=</mo><mfrac><mn>200</mn><