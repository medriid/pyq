  "question": {
    "text": "An LCR circuit as shown in the figure is connected to a voltage source $\\mathrm{V}_{\\mathrm{ac}}$ whose frequency can be varied.\n<img src=\"assets\\qt0163_e8807cc3f0d2.png\"><br>\nThe frequency, at which the voltage across the resistor is maximum, is :"
  },
  "options": [
    {
      "text": "\n$902 \\mathrm{~Hz}$\n",
      "is_correct": false
    },
    {
      "text": "\n$143 \\mathrm{~Hz}$\n",
      "is_correct": false
    },
    {
      "text": "\n$23 \\mathrm{~Hz}$\n",
      "is_correct": true
    },
    {
      "text": "\n$345 \\mathrm{~Hz}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Frequency $\\mathrm{f}=\\frac{1}{2 \\pi \\sqrt{\\mathrm{LC}}}$\n$$\n\\begin{aligned}\n& =\\frac{1}{2 \\times 3.4 \\sqrt{24 \\times 2 \\times 10^{-6}}} \\\\\n& \\simeq 23 \\mathrm{~Hz}\n\\end{aligned}\n$$"
  }
}