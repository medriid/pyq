  "question": {
    "text": "In the circuit shown here, the voltage across $\\mathrm{E}$ and $\\mathrm{C}$ are respectively $300 \\mathrm{~V}$ and $400 \\mathrm{~V}$. The voltage $\\mathrm{E}$ of the ac source is :\n<img src=\"assets\\qt0169_52c35886e93e.png\"><br>"
  },
  "options": [
    {
      "text": "\n$400$ Volt\n",
      "is_correct": false
    },
    {
      "text": "\n$500$ Volt\n",
      "is_correct": false
    },
    {
      "text": "\n$100$ Volt\n",
      "is_correct": true
    },
    {
      "text": "\n$700$ Volt",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Voltage $E$ of the ac source\n$\\begin{aligned}\n& E=V_C-V_L \\\\\n& =400 \\mathrm{~V}-300 \\mathrm{~V}=100 \\mathrm{~V}\n\\end{aligned}$"
  }
}