  "solution": {
    "text": "Acceleration due to gravity at a height <math><mi>h</mi></math> from the surface of the Earth,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mi>g</mi><mfrac><mn>1</mn><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mi>h</mi><mi>R</mi></mfrac></mrow></mfenced><mn>2</mn></msup></mfrac></math><br />Given:&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>=</mo><mn>2</mn><mi>R</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mi>g</mi><mfrac><mn>1</mn><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn></mrow></mfenced><mn>2</mn></msup></mfrac></math><br />or&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>'</mo></msup><mo>=</mo><mfrac><mi>g</mi><mn>9</mn></mfrac></math>"
  }
