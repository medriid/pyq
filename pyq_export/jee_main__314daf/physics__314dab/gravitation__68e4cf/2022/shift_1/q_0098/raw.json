  "level": 1,
  "question": {
    "text": "<p>The variation of acceleration due to gravity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>g</mi></mfenced></math>&nbsp;with distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>r</mi></mfenced></math> from the center of the earth is correctly represented by</p><p>(Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo></math> radius of earth)</p>",
    "image": null
  },
