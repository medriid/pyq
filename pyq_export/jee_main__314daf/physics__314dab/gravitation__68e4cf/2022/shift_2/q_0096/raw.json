  "question": {
    "text": "The distance between Sun and Earth is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>. The duration of year if the distance between Sun and Earth becomes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>R</mi></math> will be :",
    "image": null
  },
  "options": [
