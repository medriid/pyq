      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mo>&#160;</mo><mi>yr</mi></math>&nbsp;",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "CkulC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><msqrt><mn>3</mn></msqrt><mo>&#160;</mo><mi>yr</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "nGdft",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#160;</mo><mi>yr</mi></math>&nbsp;",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "7CNuR",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>&#160;</mo><mi>yr</mi></math>",
      "isCorrect": false,
