  "question": {
    "text": "An object of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi>kg</mi></math>&nbsp;is taken to a height from the surface of earth which is equal to three times the radius of earth. The gain in potential energy of the object will be<br />[If, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi><mo>=</mo><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math> and radius of earth <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>6400</mn><mo>&#160;</mo><mi>km</mi></math>]"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>48</mn><mi>MJ</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mi>MJ</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn><mi>MJ</mi></math>",
