  "question": {
    "text": "Two objects of equal masses placed at certain distance from each other attracts each other with a force of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math>. If one-third mass of one object is transferred to the other object, then the new force will be"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>9</mn></mfrac><mi>F</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>16</mn><mn>9</mn></mfrac><mi>F</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>8</mn><mn>9</mn></mfrac><mi>F</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math>",
      "is_correct": false
    }
  ],
