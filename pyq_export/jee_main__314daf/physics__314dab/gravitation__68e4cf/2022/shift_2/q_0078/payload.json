  "question": {
    "text": "A body of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> is projected with velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><msub><mi>v</mi><mi>e</mi></msub></math> in vertically upward direction from the surface of the earth into space. It is given that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mi>e</mi></msub></math> is escape velocity and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><mo>&#60;</mo><mn>1</mn></math>. If air resistance is considered to the negligible, then the maximum height from the centre of earth, to which the body can go, will be (<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> : radius of earth)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>R</mi><mrow><mn>1</mn><mo>+</mo><msup><mi>&#955;</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>R</mi><mrow><mn>1</mn><mo>-</mo><msup><mi>&#955;</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>R</mi><mrow><mn>1</mn><mo>-</mo><mi>&#955;</mi></mrow></mfrac></math>",
