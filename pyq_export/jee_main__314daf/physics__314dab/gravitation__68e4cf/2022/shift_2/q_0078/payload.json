    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi>&#955;</mi><mn>2</mn></msup><mi>R</mi></mrow><mrow><mn>1</mn><mo>-</mo><msup><mi>&#955;</mi><mn>2</mn></msup></mrow></mfrac></math>",
