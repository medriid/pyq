  "question": {
    "text": "<p>At what distance above and below the surface of the earth a body will have same weight? (Take radius of earth as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi></math>)</p>",
    "image": null
  },
  "options": [
    {
      "id": "tBI3H",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>5</mn></msqrt><mi mathvariant=\"normal\">R</mi><mo>-</mo><mi mathvariant=\"normal\">R</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KrDeZ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>3</mn></msqrt><mi>R</mi><mo>-</mo><mi>R</mi></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RKbiU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>R</mi><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "D52Jv",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>5</mn></msqrt><mi>R</mi><mo>-</mo><mi>R</mi></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": true
