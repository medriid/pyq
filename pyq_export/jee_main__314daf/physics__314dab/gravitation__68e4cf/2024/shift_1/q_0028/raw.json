      "isCorrect": false
    },
    {
      "id": "ji78y",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>L</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "j2wJw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>L</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zn0El",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>L</mi></math>",
      "image": null,
