  "question": {
    "text": "In hydrogen like system the ratio of coul0mbian force and gravitational force between an electron and a proton is in the order of :"
  },
  "options": [
    {
      "text": "$10^{39}$",
      "is_correct": true
    },
    {
      "text": "$10^{29}$",
      "is_correct": false
    },
    {
      "text": "$10^{19}$",
      "is_correct": false
    },
    {
      "text": "$10^{36}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text {  } \\mathrm{F}_{\\mathrm{e}}=\\frac{\\mathrm{kQ}_1 \\mathrm{Q}_2}{\\mathrm{r}^2}=\\frac{9 \\times 10^9 \\times 1.6 \\times 10^{-19} \\times 1.6 \\times 10^{-19}}{\\mathrm{r}^2} \\\\ & \\mathrm{~F}_{\\mathrm{g}}=\\frac{\\mathrm{Gm}_1 \\mathrm{~m}_2}{\\mathrm{r}^2}=\\frac{6.67 \\times 10^{-11} \\times 9.1 \\times 10^{-31} \\times 1.6 \\times 10^{-27}}{\\mathrm{r}^2} \\\\ & \\frac{\\mathrm{F}_{\\mathrm{e}}}{\\mathrm{F}_{\\mathrm{g}}} \\cong 0.23 \\times 10^{40} \\cong 2.3 \\times 10^{39} \\\\ & \\text { Option (1) }\\end{aligned}$"
