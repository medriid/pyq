  "question": {
    "text": "A simple pendulum doing small oscillations at a place $\\mathrm{R}$ height above earth surface has time period of $T_1=4 \\mathrm{~s}$. $T_2$ would be it's time period if it is brought to a point which is at a height $2 \\mathrm{R}$ from earth surface. Choose the correct relation $[R=$ radius of earth $]$ :"
  },
  "options": [
    {
      "text": "$2 \\mathrm{~T}_1=\\mathrm{T}_2$",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{~T}_1=3 \\mathrm{~T}_2$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{T}_1=\\mathrm{T}_2$",
      "is_correct": false
    },
    {
      "text": "$3 \\mathrm{~T}_1=2 \\mathrm{~T}_2$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{T}_1=2 \\pi \\sqrt{\\frac{\\ell}{\\mathrm{GM}}(2 \\mathrm{R})^2} \\\\ & \\mathrm{~T}_2=2 \\pi \\sqrt{\\frac{\\ell}{\\mathrm{GM}}(3 \\mathrm{R})^2} \\\\ & \\therefore \\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}=\\frac{2}{3}\\end{aligned}$"
  }
}