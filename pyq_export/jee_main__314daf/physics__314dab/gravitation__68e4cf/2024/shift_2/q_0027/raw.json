      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>v</mi><mn>12</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nnfml",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>v</mi><mn>6</mn></mfrac></math>",
      "image": null,
