  "question": {
    "text": "The mass of the moon is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>144</mn></mfrac></math> times the mass of a planet and its diameter <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>16</mn></mfrac></math> times the diameter of a planet. If the escape velocity on the planet is v, the escape velocity on the moon will be:",
    "image": null
  },
  "options": [
    {
      "id": "GA70p",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>v</mi><mn>3</mn></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BF19U",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>v</mi><mn>4</mn></mfrac></math>",
