  "question": {
    "text": "Two satellite $A$ and $B$ go round a planet in circular orbits having radii $4 R$ and $R$ respectively. If the speed of $\\mathrm{A}$ is $3 v$, the speed of $\\mathrm{B}$ will be :"
  },
  "options": [
    {
      "text": "$3 v$",
      "is_correct": false
    },
    {
      "text": "$6 v$",
      "is_correct": true
    },
    {
      "text": "$\\frac{4}{3} v$",
      "is_correct": false
    },
    {
      "text": "$12 v$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathbf{v}=\\sqrt{\\frac{G M}{R}} \\\\ & \\frac{v_A}{v_B}=\\sqrt{\\frac{R_B}{R_A}}=\\sqrt{\\frac{R}{4 R}}=\\frac{1}{2} \\\\ & v_B=2 v_A=6 v\\end{aligned}$"
  }
}