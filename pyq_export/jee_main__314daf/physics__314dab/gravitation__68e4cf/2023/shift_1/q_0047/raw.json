  "question": {
    "text": "The radii of two planets <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>&nbsp;are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>R</mi></math>&nbsp;and their densities are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#961;</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#961;</mi><mn>3</mn></mfrac></math>&nbsp;respectively. The ratio of acceleration due to gravity at their surfaces <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msub><mi>g</mi><mi>A</mi></msub><mo>:</mo><msub><mi>g</mi><mi>B</mi></msub></mrow></mfenced></math> will be<br />&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "C5lwD",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>:</mo><mn>3</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BmUnU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><mn>16</mn></math>",
