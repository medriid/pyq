      "isCorrect": false
    },
    {
      "id": "QsBsg",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>:</mo><mn>16</mn></math>",
      "image": null,
      "isCorrect": false
