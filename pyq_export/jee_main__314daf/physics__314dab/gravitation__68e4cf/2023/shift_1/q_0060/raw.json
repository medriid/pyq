  "question": {
    "text": "<p>A planet has double the mass of the earth. Its average density is equal to that of the earth. An object weighing <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi></math> on earth will weigh on that planet:</p>",
    "image": null
  },
  "options": [
    {
      "id": "D1g1S",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mfrac><mn>1</mn><mn>4</mn></mfrac></msup><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4eGYB",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mfrac><mn>1</mn><mn>3</mn></mfrac></msup><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jlilU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A3NnP",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mfrac><mn>2</mn><mn>3</mn></mfrac></msup><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": false
