    {
      "id": "qA5AS",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>T</mi><mi mathvariant=\"normal\">A</mi></msub><msub><mi>T</mi><mi mathvariant=\"normal\">B</mi></msub></mfrac><mo>=</mo><msup><mfenced><mfrac><msub><mi>r</mi><mi mathvariant=\"normal\">A</mi></msub><msub><mi>r</mi><mi mathvariant=\"normal\">B</mi></msub></mfrac></mfenced><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></math>",
