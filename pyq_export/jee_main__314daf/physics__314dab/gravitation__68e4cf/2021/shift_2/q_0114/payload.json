  "question": {
    "text": "The angular momentum of a planet of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> moving around the sun in an elliptical orbit is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>L</mi><mo>&#8594;</mo></mover></math>. The magnitude of the areal velocity of the planet is :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mi>L</mi></mrow><mi>M</mi></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>L</mi><mi>M</mi></mfrac></math>",
      "is_correct": false
