  "question": {
    "text": "Two bodies of masses $\\mathrm{m}$ and $4 \\mathrm{~m}$ are placed at a distance $\\mathrm{r}$. The gravitational potential at a point on the line joining them where the gravitational field is zero is:",
    "image": null
  },
  "options": [
    {
      "id": "ynRGB",
      "text": "\n$-\\frac{4 \\mathrm{Gm}}{\\mathrm{r}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HdY9t",
      "text": "\n$-\\frac{6 \\mathrm{Gm}}{\\mathrm{r}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QmuNh",
      "text": "\n$-\\frac{9 \\mathrm{Gm}}{r}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "k0JVJ",
      "text": "\nzero",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Position of the null point from mass $\\mathrm{m}, \\mathrm{x}=\\frac{\\mathrm{r}}{1+\\sqrt{\\frac{4 \\mathrm{~m}}{\\mathrm{~m}}}}=\\frac{r}{3}$\n$$\nV=-G m\\left(\\frac{3}{r}+\\frac{12}{2 r}\\right)=-9 \\frac{G m}{r}\n$$",
    "image": null
  },
