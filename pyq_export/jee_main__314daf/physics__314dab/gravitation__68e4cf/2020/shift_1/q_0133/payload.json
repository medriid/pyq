  "solution": {
    "text": "<p>Given that</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>g</mi><mi>n</mi></msub><mo>=</mo><msub><mi>g</mi><mi>d</mi></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mrow><mo>(</mo><mi>R</mi><mo mathvariant=\"italic\">+</mo><mi>h</mi><msup><mo>)</mo><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><msup><mi>R</mi><mn>3</mn></msup></mfrac><mo>(</mo><mi>R</mi><mo mathvariant=\"italic\">-</mo><mi>d</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mrow><mo>(</mo><mi>R</mi><mo>+</mo><mi>R</mi><mo>/</mo><mn>2</mn><msup><mo>)</mo><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><msup><mi>R</mi><mn>3</mn></msup></mfrac><mo>(</mo><mi>R</mi><mo>-</mo><mi>d</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mi>G</mi><mi>M</mi></mrow><mrow><mn>9</mn><msup><mi>R</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><msup><mi>R</mi><mn>2</mn></msup></mfrac><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mi>d</mi><mi>R</mi></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mn>9</mn></mfrac><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mi>d</mi><mi>R</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>d</mi><mi>R</mi></mfrac><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mn>4</mn><mn>9</mn></mfrac><mo>=</mo><mfrac><mn>5</mn><mn>9</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>=</mo><mfrac><mn>5</mn><mn>9</mn></mfrac><mi>R</mi></math></p>"
