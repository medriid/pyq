  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p>&nbsp;&nbsp;<img src=\"assets\\st0136_a44ae36fa380.png\" style=\"width: 264px; height: 157px;\" /></p><p>From angular momentum conservation</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>mV</mi><mn>1</mn></msub><msub><mi mathvariant=\"normal\">r</mi><mn>1</mn></msub><mo>=</mo><msub><mi>mV</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">r</mi><mn>2</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>r</mi><mn>1</mn></msub><msub><mi>r</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><msub><mi>v</mi><mn>2</mn></msub><msub><mi>v</mi><mn>1</mn></msub></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>6</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><mn>6</mn></math></p>"
