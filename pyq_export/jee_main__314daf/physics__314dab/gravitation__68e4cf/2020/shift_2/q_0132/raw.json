      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi>R</mi><mn>2</mn></msup><msup><mi>&#969;</mi><mn>2</mn></msup></mrow><mi>g</mi></mfrac></math>",
      "isCorrect": false,
