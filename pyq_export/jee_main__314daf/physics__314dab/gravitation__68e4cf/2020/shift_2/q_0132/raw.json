  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "The acceleration due to gravity on the earth&#39;s surface at the poles is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi></math> and angular velocity of the earth about the axis passing through the pole is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi></math>. An object is weighed at the equator and at a height <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math> above the poles by using a spring balance. If the weights are found to be same, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math> is: (<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>&#8810;</mo><mi>R</mi></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is the radius of the earth)",
    "image": null
  },
  "options": [
    {
      "id": "5ezuV",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi>R</mi><mn>2</mn></msup><msup><mi>&#969;</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mi>g</mi></mrow></mfrac></math>",
      "isCorrect": true,
