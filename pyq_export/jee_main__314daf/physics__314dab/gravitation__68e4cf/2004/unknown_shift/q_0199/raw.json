  "question": {
    "text": "Suppose the gravitational force varies inversely as the nth power of distance. Then the time period planet in circular orbit of radius $\\mathrm{R}$ around the sun will be proportional to",
    "image": null
  },
  "options": [
    {
      "id": "KekAI",
      "text": "\n$R^{\\left(\\frac{n+1}{2}\\right)}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zMaBO",
      "text": "\n$R^{\\left(\\frac{n-1}{2}\\right)}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DfAJX",
      "text": "\n$\\mathrm{R}^{\\mathrm{n}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Hp4Wv",
      "text": "\n$\\mathrm{R}^{\\left(\\frac{\\mathrm{n}-2}{2}\\right)}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{T} \\propto \\mathrm{R}^{(\\mathrm{n}+1) / 2}$",
    "image": null
  },
