  "question": {
    "text": "Given below are two statements: one is labelled as Assertion $\\mathrm{A}$ and the other is labelled as Reason $\\mathrm{R}$ Assertion A : The kinetic energy needed to project a body of mass m from earth surface to infinity is $\\frac{1}{2} \\mathrm{mgR}$, where R is the radius of earth.<br/>Reason $\\mathrm{R}$ : The maximum potential energy of a body is zero when it is projected to infinity from earth surface.<br/>In the light of the above statements, choose the correct answer from the option given below",
    "image": null
  },
  "options": [
    {
      "id": "ZQbvb",
      "text": "$\\mathrm{A}$ False but $\\mathrm{R}$ is true",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "cJm62",
      "text": "Both $\\mathrm{A}$ and $\\mathrm{R}$ are true and $\\mathrm{R}$ is the correct explanation of $\\mathrm{A}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FeiDQ",
      "text": "$\\mathrm{A}$ is true but $\\mathrm{R}$ is false",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CNsat",
      "text": "(4) Both $\\mathrm{A}$ and $\\mathrm{R}$ are true but $\\mathrm{R}$ is NOT the correct explanation of $\\mathrm{A}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{KE}=\\frac{1}{2} \\mathrm{~m}\\left(\\frac{2 \\mathrm{Gm}}{\\mathrm{R}}\\right)=\\mathrm{mgR}$<br/>Assertion wrong<br/>at $\\infty$<br/>$\\mathrm{U}=0$<br/>$\\therefore$ Reason correct.",
    "image": null
