    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{F}_1=\\frac{\\mathrm{GMm}}{(2 \\mathrm{R})^2} .....(1)\\\\\n& \\mathrm{~F}_2=\\frac{\\mathrm{GMm}}{(2 \\mathrm{R})^2}-\\left(\\frac{\\mathrm{G}\\left(\\frac{\\mathrm{M}}{27}\\right) \\mathrm{m}}{\\left(\\frac{4 \\mathrm{R}}{3}\\right)^2}\\right) \\\\\n& \\mathrm{F}_2=\\frac{11}{48} \\frac{\\mathrm{GMm}}{\\mathrm{R}^2} ....(2)\\\\\n& \\mathrm{~F}_1: \\mathrm{F}_2=12: 11\n\\end{aligned}$",
    "image": null
  },
