  "question": {
    "text": "An object is kept at rest at a distance of 3 R above the earth's surface where R is earth's radius. The minimum speed with which it must be projected so that it does not return to earth is :<br/>(Assume $\\mathrm{M}=$ mass of earth, $\\mathrm{G}=$ Universal gravitational constant)",
    "image": null
  },
  "options": [
    {
      "id": "rVbcZ",
      "text": "$\\sqrt{\\frac{\\mathrm{GM}}{2 \\mathrm{R}}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "6CwQg",
      "text": "$\\sqrt{\\frac{\\mathrm{GM}}{\\mathrm{R}}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zrPfR",
      "text": "$\\sqrt{\\frac{3 \\mathrm{GM}}{\\mathrm{R}}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AHGgK",
      "text": "$\\sqrt{\\frac{2 \\mathrm{GM}}{\\mathrm{R}}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/nUjrsuWMXG2yaDXGkzi4IddWMr0QPiNIOBlnRDwFXiU.original.fullsize.png\"/><br/>$\\begin{aligned}<br/>& \\mathrm{P}_{\\mathrm{P}}+\\mathrm{k}_{\\mathrm{P}}=\\mathrm{P}_{\\mathrm{o}}+\\mathrm{k}_0 \\\\\n& -\\frac{\\mathrm{GMm}}{4 \\mathrm{R}}+\\frac{1}{2} \\mathrm{mV}_{\\mathrm{P}}^2=0 \\\\\n& \\mathrm{~V}_{\\mathrm{P}}=\\sqrt{\\frac{\\mathrm{GM}}{2 \\mathrm{R}}}<br/>\\end{aligned}$<br/>Choice 1",
    "image": null
  },
