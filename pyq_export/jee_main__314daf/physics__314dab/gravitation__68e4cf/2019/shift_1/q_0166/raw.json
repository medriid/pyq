  "correctValue": null,
  "solution": {
    "text": "For standing car,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><msqrt><mfrac><mi>T</mi><mi>&#956;</mi></mfrac></msqrt><mo>=</mo><msqrt><mfrac><mrow><mi>M</mi><mi>g</mi></mrow><mi>&#956;</mi></mfrac></msqrt></math><br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/woofsuhxlycudpptqypnqvqadevjwwlrtbcahvsllrmcshidax.png\" /><br /><br />For accelerating car,<br /><br /><math><mi>&#965;</mi><mi>&#8242;</mi><mo>=</mo><msqrt><mfrac><mrow><msqrt><msup><mrow><mo>(</mo><mi>M</mi><mi>g</mi><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mo>(</mo><mi>M</mi><mi>a</mi><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow><mrow><mi>&#956;</mi></mrow></mfrac></msqrt></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><mn>60.5</mn></mrow><mrow><mn>60</mn></mrow></mfrac><mo>=</mo><msqrt><mfrac><mrow><msqrt><msup><mrow><mo>(</mo><mi>M</mi><mi>g</mi><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mo>(</mo><mi>M</mi><mi>a</mi><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow><mrow><mi>M</mi><mi>g</mi></mrow></mfrac></msqrt></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>120</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><msqrt><msup><mrow><mo>(</mo><mi>M</mi><mi>g</mi><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mo>(</mo><mi>M</mi><mi>a</mi><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow><mrow><mi>M</mi><mi>g</mi></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mn>1</mn><mo>+</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>120</mn></mrow></mfrac><mo>=</mo><msqrt><mn>1</mn><mo>+</mo><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>g</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></msqrt></math><br /><br /><math><mo>&#8776;</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>120</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>g</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>a</mi><mo>=</mo><mi>g</mi><msqrt><mfrac><mrow><mn>4</mn></mrow><mrow><mn>120</mn></mrow></mfrac></msqrt><mo>=</mo><mfrac><mrow><mi>g</mi></mrow><mrow><msqrt><mn>30</mn></msqrt></mrow></mfrac><mo>&#8776;</mo><mfrac><mrow><mi>g</mi></mrow><mrow><mn>5</mn></mrow></mfrac></math>",
