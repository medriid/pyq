  "question": {
    "text": "The change in the value of $g$ at a height ' $h$ ' above the surface of the earth is the same as at a depth 'd' below the surface of earth. When both ' $d$ ' and ' $h$ ' are much smaller than the radius of earth, then which one of the following is correct?",
    "image": null
  },
  "options": [
    {
      "id": "tLjna",
      "text": "\n$d=\\frac{h}{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Wu37H",
      "text": "\n$\\mathrm{d}=\\frac{3 \\mathrm{~h}}{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HgYxX",
      "text": "\n$\\mathrm{d}=2 \\mathrm{~h}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zchwE",
      "text": "\n$\\mathrm{d}= \\mathrm{~h}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{G M}{(R+h)^2}=\\frac{G M}{R^3}(R-d)$\n$\\Rightarrow d=2 h$",
    "image": null
  },
