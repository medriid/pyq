  "solution": {
    "text": "<math><msub><mrow><mi>F</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>m</mi></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac><mi>,</mi><msub><mrow><mi>F</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mi>&#160;</mi></math><br /><br /><math><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>F</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>= (-)</mo><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>m</mi></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac><mi>&#160;</mi><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">&#160;,</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=(-)</mo><mfrac><mrow><mn>2</mn><mi>G</mi><msub><mrow><mi>M</mi></mrow><mrow><mi>e</mi></mrow></msub><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mi>&#160;</mi><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mfrac><mrow><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>F</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mi>&#160;</mi><mfrac><mrow><mi>m</mi><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac><mi>&#160;</mi><mfrac><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow><mrow><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>m</mi></mrow><mrow><msub><mrow><mi>M</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow></mfrac></mrow></mfenced><mfenced separators=\"|\"><mrow><mfrac><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac></mrow></mfenced><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced></math><br /><br />Using <math><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant=\"normal\">&#916;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>R</mi></mrow><mrow><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">h</mi></mrow></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mn>8</mn><mo>&#215;</mo><msup><mn>10</mn><mn>22</mn></msup><mi>&#160;</mi><mi>kg</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mi>s</mi><mo>=</mo><mi>&#160;</mi><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mn>30</mn></msup><mi>&#160;</mi><mi>kg</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>r</mi><mn>1</mn></msub><mo>=</mo><mn>0.4</mn><mo>&#215;</mo><msup><mn>10</mn><mn>6</mn></msup><mo>&#160;</mo><mi>km</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>r</mi><mn>2</mn></msub><mo>=</mo><mn>150</mn><mo>&#215;</mo><msup><mn>10</mn><mn>6</mn></msup><mo>&#160;</mo><mi>km</mi></math><br /><br />We get <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">&#916;</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi mathvariant=\"normal\">&#916;</mi><msub><mi>F</mi><mn>2</mn></msub></mrow></mfrac><mo>=</mo><mn>2</mn></math>."
  }
