  "question": {
    "text": "A planet in a distant solar system is 10 times more massive than the earth and its radius is 10 times smaller. Given that the escape velocity from the earth is $11 \\mathrm{kms}^{-1}$, the escape velocity from the surface of the planet would be",
    "image": null
  },
  "options": [
    {
      "id": "v0ezD",
      "text": "\n$1.1 \\mathrm{kms}^{-1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hVXDh",
      "text": "\n$11 \\mathrm{kms}^{-1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rRDWH",
      "text": "\n$110 \\mathrm{kms}^{-1}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "tLb7q",
      "text": "\n$0.11 \\mathrm{kms}^{-1}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\nv_{\\mathrm{esc}}=\\sqrt{\\frac{2 \\mathrm{GM}}{R}}=\\sqrt{\\frac{2 \\mathrm{G} \\times 10 \\mathrm{M}}{\\mathrm{R} / 10}}=10 \\times 11=110 \\mathrm{~km} / \\mathrm{s}\n$$",
    "image": null
  },
