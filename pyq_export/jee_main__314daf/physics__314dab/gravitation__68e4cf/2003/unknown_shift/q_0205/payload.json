  "question": {
    "text": "The time period of a satellite of earth is 5 hours. If the separation between the earth and the satellite is increased to 4 times the previous value, the new time period will become"
  },
  "options": [
    {
      "text": "\n10 hours\n",
      "is_correct": false
    },
    {
      "text": "\n80 hours\n",
      "is_correct": false
    },
    {
      "text": "\n40 hours\n",
      "is_correct": true
    },
    {
      "text": "\n20 hours",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{T}^2 \\propto \\mathrm{R}^3 \\Rightarrow\\left(\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}\\right)^2=\\left(\\frac{\\mathrm{R}_1}{\\mathrm{R}_2}\\right)^3$\n$\\Rightarrow\\left(\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}\\right)=\\left(\\frac{\\mathrm{R}_1}{\\mathrm{R}_2}\\right)^{3 / 2}=\\left(\\frac{1}{4}\\right)^{3 / 2} \\quad \\Rightarrow \\frac{\\mathrm{T}_2}{\\mathrm{~T}_1}=(4)^{3 / 2}=8$\n$\\Rightarrow \\mathrm{T}_2=8 \\times \\mathrm{T}_1=8 \\times 5=40=40$ hours"
  }
}