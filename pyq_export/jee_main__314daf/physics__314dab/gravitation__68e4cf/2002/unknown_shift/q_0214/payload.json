  "question": {
    "text": "The kinetic energy needed to project a body of mass $m$ from the earth surface (radius $R$ ) to infinity is"
  },
  "options": [
    {
      "text": "\n$\\mathrm{mgR} / 2$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\mathrm{mgR}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{mgR}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{mgR} / 4$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{KE}=\\frac{1}{2} \\mathrm{mv}_{\\mathrm{esc}}^2=\\frac{1}{2} \\mathrm{~m}(\\sqrt{2 \\mathrm{gR}})^2=\\mathrm{mgR}$"
  }
}