  "question": {
    "text": "Energy required to move a body of mass m from an orbit of radius 2R to 3R is",
    "image": null
  },
  "options": [
    {
      "id": "PPli7",
      "text": "\n$\\mathrm{GMm} / 12 \\mathrm{R}^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VkQ6f",
      "text": "\n$\\mathrm{GMm} / 3 \\mathrm{R}^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NRFHo",
      "text": "\n$\\mathrm{GMm} / 8 \\mathrm{R}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DqWbo",
      "text": "\n$\\mathrm{GMm} / 6 \\mathrm{R}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{E}=(\\mathrm{PE})_{\\text {final }}-(\\mathrm{PE})_{\\text {initial }}=\\frac{-\\mathrm{GMm}}{3 \\mathrm{R}}+\\frac{\\mathrm{GMm}}{\\mathrm{R}}=\\frac{\\mathrm{GMm}}{6 \\mathrm{R}}$",
    "image": null
  },
