      "text": "\n$1 \\mathrm{mV}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{E}=\\mathrm{B}_{\\mathrm{H}} \\mathrm{VV}=0.15 \\mathrm{mV}$",
    "image": null
  },
