  "question": {
    "text": "A boat is moving due east in a region where the earth's magnetic field is $5.0 \\times 10^{-5} \\mathrm{NA}^{-1} \\mathrm{~m}^{-1}$ due north and horizontal. The boat carries a vertical aerial $2 \\mathrm{~m}$ long. If the speed of the boat is $1.50 \\mathrm{~ms}^{-1}$, the magnitude of the induced emf in the wire of aerial is :",
    "image": null
  },
  "options": [
    {
      "id": "C2tJV",
      "text": "\n$0.75 \\mathrm{mV}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qHWYC",
      "text": "\n$0.50 \\mathrm{mV}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gRdnI",
      "text": "\n$0.15 \\mathrm{mV}$\n",
      "image": null,
      "isCorrect": true
    },
    {
