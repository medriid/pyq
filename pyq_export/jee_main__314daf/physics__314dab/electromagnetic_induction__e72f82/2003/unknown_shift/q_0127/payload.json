  "question": {
    "text": "When the current changes from $+2 \\mathrm{~A}$ to $-2 \\mathrm{~A}$ in $0.05$ second, an e.m.f. of $8 \\mathrm{~V}$ is induced in a coil. The coefficient of self-induction of the coil is"
  },
  "options": [
    {
      "text": "\n$0.2 \\mathrm{H}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.4 \\mathrm{H}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.8 \\mathrm{H}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.1 \\mathrm{H}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$e=-\\mathrm{L} \\frac{\\mathrm{dl}}{\\mathrm{dt}} \\Rightarrow 8=(\\mathrm{L}) \\frac{2-(-2)}{0.05} \\Rightarrow \\mathrm{L}=0.1 \\mathrm{H}$"
  }
}