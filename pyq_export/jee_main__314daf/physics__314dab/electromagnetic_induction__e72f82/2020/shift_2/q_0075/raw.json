      "id": "yprwx",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msub><mi>&#956;</mi><mn>0</mn></msub></mrow><mi>&#960;</mi></mfrac><mfrac><mrow><mi>Iv</mi><mi>&#8467;</mi></mrow><mi>Rr</mi></mfrac></math>",
      "isCorrect": false,
