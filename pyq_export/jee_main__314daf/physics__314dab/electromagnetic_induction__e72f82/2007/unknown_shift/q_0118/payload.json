  "question": {
    "text": "An ideal coil of $10 \\mathrm{H}$ is connected in series with a resistance of $5 \\Omega$ and a battery of $5 \\mathrm{~V}$. \n$2$ second after the connection is made the current flowing in amperes in the circuit is"
  },
  "options": [
    {
      "text": "\n$(1-\\mathrm{e})$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{e}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{e}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(1-\\mathrm{e}^{-1}\\right)$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{i}=\\mathrm{i}_0\\left(1-\\mathrm{e}^{\\frac{\\mathrm{Rt}}{\\mathrm{L}}}\\right)$\n$=\\left(1-\\mathrm{e}^{-1}\\right)$"
  }
