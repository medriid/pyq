    }
  ],
  "correctValue": null,
  "solution": {
    "text": "At $\\mathrm{t}=10 \\mathrm{sec}$ complete loop is in magnetic field therefore no change in flux\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/W7PT0et-nMmZr9R1x73xmW76aqhhIDZJP5LmJ1aZ43g.original.fullsize.png\"/>\n$\\mathrm{e}=\\frac{\\mathrm{d} \\phi}{\\mathrm{dt}}=0$\n$\\mathrm{e}=0$ for complete loop",
    "image": null
