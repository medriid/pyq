  "question": {
    "text": "Two conducting circular loops A and B are placed in the same plane with their centers coinciding as shown in figure. The mutual inductance between them is :\n<img src=\"assets\\qt0024_5f8d78d4183d.png\"><br>"
  },
  "options": [
    {
      "text": "$\\frac{\\mu_0 \\pi b^2}{2 a}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mu_o}{2 \\pi} \\cdot \\frac{b^2}{a}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mu_0}{2 \\pi} \\cdot \\frac{a^2}{b}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mu_0 \\pi a^2}{2 b}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\phi=\\mathrm{Mi}=\\mathrm{BA} \\\\ & \\Rightarrow \\mathrm{Mi}=\\frac{\\mu_0 \\mathrm{i}}{2 \\mathrm{~b}} \\pi \\mathrm{a}^2 \\\\ & \\therefore \\mathrm{M}=\\frac{\\mu_0 \\pi \\mathrm{a}^2}{2 \\mathrm{~b}}\\end{aligned}$"
  }
}