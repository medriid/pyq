  "question": {
    "text": "Two conducting circular loops A and B are placed in the same plane with their centers coinciding as shown in figure. The mutual inductance between them is :\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/U36tbNPWw38Nzax4Rfn2XC_gLMAfxmx0q-nyFveJwNc.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "MWg3x",
      "text": "$\\frac{\\mu_0 \\pi b^2}{2 a}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7N0gJ",
      "text": "$\\frac{\\mu_o}{2 \\pi} \\cdot \\frac{b^2}{a}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qYaRX",
      "text": "$\\frac{\\mu_0}{2 \\pi} \\cdot \\frac{a^2}{b}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Bz1Om",
      "text": "$\\frac{\\mu_0 \\pi a^2}{2 b}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\phi=\\mathrm{Mi}=\\mathrm{BA} \\\\ & \\Rightarrow \\mathrm{Mi}=\\frac{\\mu_0 \\mathrm{i}}{2 \\mathrm{~b}} \\pi \\mathrm{a}^2 \\\\ & \\therefore \\mathrm{M}=\\frac{\\mu_0 \\pi \\mathrm{a}^2}{2 \\mathrm{~b}}\\end{aligned}$",
    "image": null
  },
