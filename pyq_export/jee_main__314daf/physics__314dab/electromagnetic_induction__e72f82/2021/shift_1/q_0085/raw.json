  "correctValue": "144",
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#949;</mi><mo>=</mo><mfrac><mrow><mi>L</mi><mi>d</mi><mi>I</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><msubsup><mo>&#8747;</mo><mn>0</mn><mn>4</mn></msubsup><mi>t</mi><mi>d</mi><mi>t</mi><mo>=</mo><mn>2</mn><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mi>d</mi><mi>I</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>&#215;</mo><mn>16</mn><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">I</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mn>12</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>L</mi><msup><mi>I</mi><mn>2</mn></msup><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#215;</mo><mn>2</mn><msup><mfenced><mn>12</mn></mfenced><mn>2</mn></msup><mo>=</mo><mn>144</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math></p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9e9c7fdb-a169-41cf-a71e-74c40eb9c382-image.png\" style=\"width: 173px; height: 174px;\" /></p>",
