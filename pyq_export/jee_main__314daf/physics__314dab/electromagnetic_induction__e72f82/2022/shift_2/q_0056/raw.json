      "id": "ZWuY3",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msub><mi>L</mi><mn>1</mn></msub></mfrac><mo>+</mo><mfrac><mn>1</mn><msub><mi>L</mi><mn>2</mn></msub></mfrac><mo>+</mo><mfrac><mn>1</mn><mi>M</mi></mfrac></math>",
      "isCorrect": false,
