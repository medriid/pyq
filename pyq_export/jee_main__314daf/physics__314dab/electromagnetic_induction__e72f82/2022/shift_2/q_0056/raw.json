      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>L</mi><mn>1</mn></msub><mo>+</mo><msub><mi>L</mi><mn>2</mn></msub><mo>-</mo><mn>2</mn><mi>M</mi></math>",
      "isCorrect": true,
