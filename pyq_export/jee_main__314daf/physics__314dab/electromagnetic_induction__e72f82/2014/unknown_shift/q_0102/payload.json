  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mo>=</mo><mfrac><mrow><mi>d</mi><mi>&#981;</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mi>A</mi><mfrac><mrow><mi>d</mi><mi>B</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></math></p><p>for&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>&#60;</mo><mi>R</mi></math>,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi><mi>r</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">&#960;</mi><msup><mi>r</mi><mn>2</mn></msup><mfrac><mrow><mi>d</mi><mi>B</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>&#8658;</mo><mi>E</mi><mi>&#945;</mi><mi>r</mi></math></p><p>for&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>&#62;</mo><mi>R</mi></math>,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi><mi>r</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">&#960;</mi><msup><mi>R</mi><mn>2</mn></msup><mfrac><mrow><mi>d</mi><mi>B</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>&#8658;</mo><mi>E</mi><mi>&#945;</mi><mfrac><mn>1</mn><mi>r</mi></mfrac></math><br /><br /><img src=\"assets\\st0102_67132df969dd.png\" style=\"width: 250px; height: 227px;\" /></p>"
