  "question": {
    "text": "<p>A metallic rod of length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi></math>&nbsp;is rotated with an angular speed of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi></math>&nbsp;normal to a uniform magnetic field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>&nbsp;about an axis passing through one end of rod as shown in figure. The induced emf will be :</p><p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f95adc92-8a37-4e1a-949b-9f146a236eb1-9893978.PNG\" style=\"width: 300px; height: 242px;\" />.</p>",
    "image": null
  },
  "options": [
    {
      "id": "J8G3q",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>B</mi><mn>2</mn></msup><msup><mi>L</mi><mn>2</mn></msup><mi>&#969;</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "UeXAq",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac><mi>B</mi><msup><mi>L</mi><mn>2</mn></msup><mi>&#969;</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "iCOeg",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>B</mi><msup><mi>L</mi><mn>2</mn></msup><mi>&#969;</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "MYMSP",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac><msup><mi>B</mi><mn>2</mn></msup><mi>L</mi><mi>&#969;</mi></math>",
      "isCorrect": false,
