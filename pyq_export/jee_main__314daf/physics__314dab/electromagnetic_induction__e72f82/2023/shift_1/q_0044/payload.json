  "question": {
    "text": "<p>Find the mutual inductance in the arrangement, when a small circular loop of wire of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>&nbsp;is placed inside a large square loop of wire of side <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>(</mo><mi>L</mi><mo>&#8811;</mo><mi>R</mi><mo>)</mo></math>. The loops are coplanar and their centres coincide :</p><p><img src=\"assets\\qt0044_cd2da110bbc5.png\" style=\"width: 300px; height: 327px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>=</mo><mfrac><mrow><msqrt><mn>2</mn></msqrt><msub><mi>&#956;</mi><mn>0</mn></msub><msup><mi>R</mi><mn>2</mn></msup></mrow><mi>L</mi></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msqrt><mn>2</mn></msqrt><msub><mi>&#956;</mi><mn>0</mn></msub><mi>R</mi></mrow><msup><mi>L</mi><mn>2</mn></msup></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msqrt><mn>2</mn></msqrt><msub><mi>&#956;</mi><mn>0</mn></msub><msup><mi>R</mi><mn>2</mn></msup></mrow><mi>L</mi></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>=</mo><mfrac><mrow><msqrt><mn>2</mn></msqrt><msub><mi>&#956;</mi><mn>0</mn></msub><mi>R</mi></mrow><msup><mi>L</mi><mn>2</mn></msup></mfrac></math>",
