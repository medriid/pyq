  "question": {
    "text": "A coil of inductance $300 \\mathrm{mH}$ and resistance $2 \\Omega$ is connected to a source of voltage 2V. The current reaches half of its steady state value in"
  },
  "options": [
    {
      "text": "\n$0.05 \\mathrm{~s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.1 \\mathrm{~s}$\n",
      "is_correct": true
    },
    {
      "text": "\n$0.15 \\mathrm{~s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.3 \\mathrm{~s}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{I}=\\mathrm{I}_{\\circ}\\left(1-\\mathrm{e}^{-\\frac{\\mathrm{R}}{\\mathrm{L}}\\mathrm{t}}\\right)$\n$0.693=\\frac{\\mathrm{R}}{\\mathrm{L}} \\mathrm{t}$\n$\\mathrm{t}=\\frac{.3 \\times 0.693}{2}=0.1 \\mathrm{sec}$"
  }
}