  "question": {
    "text": "The truth table given in fig. represents:\r<table border=\"1\" style=\"width: 100px; height: 150px;\">\r\t<tbody>\r\t\t<tr>\r\t\t\t<td>A</td>\r\t\t\t<td>B</td>\r\t\t\t<td>Y</td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>0</td>\r\t\t\t<td>0</td>\r\t\t\t<td>0</td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>0</td>\r\t\t\t<td>1</td>\r\t\t\t<td>1</td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>1</td>\r\t\t\t<td>0</td>\r\t\t\t<td>1</td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>1</td>\r\t\t\t<td>1</td>\r\t\t\t<td>1</td>\r\t\t</tr>\r\t</tbody>\r</table>\r",
    "image": null
  },
