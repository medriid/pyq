  "question": {
    "text": "<p>A logic gate circuit has two inputs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> and output <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math>. The voltage waveforms of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>,</mo><mi>B</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math> are shown below</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/e9c504d7-1da4-4703-aa00-baf2dbe5341b-image.png\" style=\"width: 250px; height: 150px;\" /></p><p>The logic gate circuit is</p>",
    "image": null
  },
