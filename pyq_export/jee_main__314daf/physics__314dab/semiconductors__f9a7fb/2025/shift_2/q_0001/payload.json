  "question": {
    "text": "Consider the following logic circuit.<br/><img src=\"assets\\qt0001_f47485512ca9.png\"/><br/>The output is $\\mathrm{Y}=0$ when :"
  },
  "options": [
    {
      "text": "$\\mathrm{A}=1$ and $\\mathrm{B}=1$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{A}=0$ and $\\mathrm{B}=1$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{A}=1$ and $\\mathrm{B}=0$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{A}=0$ and $\\mathrm{B}=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0001_c48afb1a7162.png\"/><br/>$\\begin{aligned}<br/>& \\mathrm{Y}_1=\\mathrm{A} \\cdot \\mathrm{~B}, \\mathrm{Y}_2=\\overline{\\mathrm{A}}+\\mathrm{B} \\\\\n& \\mathrm{Y}=\\overline{\\mathrm{Y}_1 \\cdot \\mathrm{Y}_2}=\\overline{\\mathrm{Y}}_1+\\overline{\\mathrm{Y}}_2 \\\\\n& \\mathrm{Y}=\\overline{\\mathrm{A} \\cdot \\mathrm{~B}}+\\overline{\\mathrm{A}+\\mathrm{B}} \\\\\n& \\mathrm{Y}=\\overline{\\mathrm{A}}+\\overline{\\mathrm{B}}+\\mathrm{A} \\cdot \\overline{\\mathrm{~B}}<br/>\\end{aligned}$<br/>$\\begin{array}{|c|c|c|} \\hline A & B & Y \\\\ \\hline 0 & 0 & 1 \\\\ \\hline 1 & 0 & 1 \\\\ \\hline 0 & 1 & 1 \\\\ \\hline 1 & 1 & 0 \\\\ \\hline \\end{array}$"
  }
}