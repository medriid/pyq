  "question": {
    "text": "Consider the following logic circuit.<br/><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/zS7ywEGbj81vSAHFPfa0RFUt6oFeSVnZIJH-YVSY7KQ.original.fullsize.png\"/><br/>The output is $\\mathrm{Y}=0$ when :",
    "image": null
  },
  "options": [
    {
      "id": "A2SMz",
      "text": "$\\mathrm{A}=1$ and $\\mathrm{B}=1$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "OwlUC",
      "text": "$\\mathrm{A}=0$ and $\\mathrm{B}=1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kjoxe",
      "text": "$\\mathrm{A}=1$ and $\\mathrm{B}=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mecTS",
      "text": "$\\mathrm{A}=0$ and $\\mathrm{B}=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/uzHl0kYsCGoXD3inWyVtRr6GBZD_STGedw3XNkyoqkI.original.fullsize.png\"/><br/>$\\begin{aligned}<br/>& \\mathrm{Y}_1=\\mathrm{A} \\cdot \\mathrm{~B}, \\mathrm{Y}_2=\\overline{\\mathrm{A}}+\\mathrm{B} \\\\\n& \\mathrm{Y}=\\overline{\\mathrm{Y}_1 \\cdot \\mathrm{Y}_2}=\\overline{\\mathrm{Y}}_1+\\overline{\\mathrm{Y}}_2 \\\\\n& \\mathrm{Y}=\\overline{\\mathrm{A} \\cdot \\mathrm{~B}}+\\overline{\\mathrm{A}+\\mathrm{B}} \\\\\n& \\mathrm{Y}=\\overline{\\mathrm{A}}+\\overline{\\mathrm{B}}+\\mathrm{A} \\cdot \\overline{\\mathrm{~B}}<br/>\\end{aligned}$<br/>$\\begin{array}{|c|c|c|} \\hline A & B & Y \\\\ \\hline 0 & 0 & 1 \\\\ \\hline 1 & 0 & 1 \\\\ \\hline 0 & 1 & 1 \\\\ \\hline 1 & 1 & 0 \\\\ \\hline \\end{array}$",
    "image": null
  },
