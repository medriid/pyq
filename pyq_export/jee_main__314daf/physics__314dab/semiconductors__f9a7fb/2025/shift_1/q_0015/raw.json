      "text": "B, C and E Only",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/qn3ddbVvHjeXY2VeOJLj5XLrgfAmSZrCnWqMYpIgFIU.original.fullsize.png\"><br>\n\n\n\nCurrent through ammeter $=1 \\mathrm{~A}$\n$\\mathrm{R}_{\\mathrm{net}}=6 \\Omega$<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/Q2S2VlVEdxNTLTKQt0VZGFgiF9jzT_bbdr9ZKCjIx6w.original.fullsize.png\"><br>\n\n$\\begin{aligned}\n& \\mathrm{V}_{\\mathrm{AB}}=0.5 \\times 4=2 \\mathrm{volt} \\\\\n& \\mathrm{~V}_{\\mathrm{CD}}=1 \\times 4=4 \\mathrm{volt}\n\\end{aligned}$\n\nA, B & D are correct",
    "image": null
  },
