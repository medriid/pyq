    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>b</mi></msub><mo>=</mo><mn>10</mn><mo>&#160;</mo><mi>&#956;A</mi></math>",
