  "question": {
    "text": "<p>For a given transistor amplifier circuit in CE configuration <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mrow><mi>C</mi><mi>C</mi></mrow></msub><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi><mo>,</mo><msub><mi>R</mi><mi>C</mi></msub><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>k&#937;</mi><mo>,</mo><msub><mi>R</mi><mi>b</mi></msub><mo>=</mo><mn>100</mn><mo>&#160;</mo><mi>k&#937;</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mn>100</mn></math>. Value of base current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>b</mi></msub></math>is</p><p><img src=\"assets\\qt0057_4a82dbc91c9a.png\" style=\"width: 413px; height: 312px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">I</mi><mi>b</mi></msub><mo>=</mo><mn>1</mn><mo>.</mo><mn>0</mn><mo>&#160;</mo><mi>&#956;A</mi></math>",
