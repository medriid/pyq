    {
      "id": "wwEGK",
      "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/6b89b585-6a82-41d0-92a3-f7554994405f.png\" style=\"width: 250px; height: 100px;\" /></p>",
