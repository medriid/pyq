  "question": {
    "text": "The logic operations performed by the given digital circuit is equivalent to:<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/8007954b-8034-4c8f-95ad-3443bb68d53e.png\" style=\"width: 400px; height: 147px;\" />",
