  "question": {
    "text": "<p>The output waveform of the given logical circuit for the following inputs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> as shown below, is</p><p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1b53ce63-4a17-4b3d-860d-0fcb29b81d89-9895337.PNG\" style=\"width: 257px; height: 300px;\" /></p>",
