  "question": {
    "text": "<p>The logic performed by the circuit shown in figure is equivalent to</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/895d8e5b-1950-462b-9fda-00091e45daac-image.png\" style=\"width: 400px; height: 126px;\" /></p>",
