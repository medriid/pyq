  "question": {
    "text": "<p>Name the logic gate equivalent to the diagram attached</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/06cb392d-6968-474c-9877-9fbf1ce81c02-image.png\" style=\"width: 300px; height: 249px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "9ePut",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NAND</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "piuCj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AND</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xcHv6",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NOR</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hn9E9",
