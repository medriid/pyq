  "question": {
    "text": "<p>The output waveform of the given logical circuit for the following inputs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> as shown below, is</p><p><img alt=\"\" src=\"assets\\qt0058_013517ccd6b7.png\" style=\"width: 257px; height: 300px;\" /></p>"
  },
  "options": [
    {
      "text": "<img alt=\"\" src=\"assets\\ot1_0058_35934df5012a.png\" style=\"width: 329px; height: 130px;\" />",
