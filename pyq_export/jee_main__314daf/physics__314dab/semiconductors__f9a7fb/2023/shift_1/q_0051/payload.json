  "question": {
    "text": "<p>For the following circuit and given inputs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>,</mo></math>&nbsp;choose the correct option for output&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8216;</mo><mi>Y</mi><mo>&#8217;</mo></math></p><p><img src=\"assets\\qt0051_7d21aa1eb3e6.png\" style=\"width: 300px; height: 103px;\" /></p><p><img src=\"assets\\qt0051_92c99d615f56.png\" style=\"width: 450px; height: 298px;\" /></p>"
