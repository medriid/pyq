  "question": {
    "text": "<p>For the following circuit and given inputs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>,</mo></math>&nbsp;choose the correct option for output&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8216;</mo><mi>Y</mi><mo>&#8217;</mo></math></p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5c0792f4-1342-4a09-99da-5f13dd036b9a.png\" style=\"width: 300px; height: 103px;\" /></p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5d69a46a-50e6-413b-8496-1130392a3803.png\" style=\"width: 450px; height: 298px;\" /></p>",
