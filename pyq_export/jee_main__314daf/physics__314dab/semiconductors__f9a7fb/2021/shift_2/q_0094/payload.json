  "question": {
    "text": "<p>In the given figure, each diode has a forward bias resistance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math> and infinite resistance in reverse bias. The current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub></math> will be :</p><p><img src=\"assets\\qt0094_4c7641d49bef.png\" style=\"width: 275px; height: 373px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>0</mn><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi></math>",
