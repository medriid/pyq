  "solution": {
    "text": "<p><img alt=\"\" src=\"assets\\qt0158_f32fbfc45525.jpg\" style=\"width: 250px; height: 193px;\" /><br /><br />Given, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mn>250</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mi>C</mi></msub><mo>=</mo><mn>1000</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#937;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mrow><mi>C</mi><mi>C</mi></mrow></msub><mo>=</mo><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math></p><p><br />At saturation, <math><msub><mrow><mi>V</mi></mrow><mrow><mi>C</mi><mi>E</mi></mrow></msub><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8658;</mo><msub><mrow><mi>i</mi></mrow><mrow><mi>e</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>10</mn><mtext>&#8201;</mtext><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1000</mn><mtext>&#8201;</mtext><mi mathvariant=\"normal\">&#937;</mi></mrow></mfrac><mo>=</mo><mn>10</mn><mtext>&#8201;</mtext><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi></math><br /><br />Current gain factor, <math><mi>&#946;</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>i</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><msub><mrow><mi>i</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><msub><mrow><mi>i</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>i</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mrow><mi>&#946;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>10</mn><mtext>&#8201;</mtext><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>250</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>40</mn><mo>&#160;</mo><mi mathvariant=\"normal\">&#956;</mi><mi mathvariant=\"normal\">A</mi></math></p>"
