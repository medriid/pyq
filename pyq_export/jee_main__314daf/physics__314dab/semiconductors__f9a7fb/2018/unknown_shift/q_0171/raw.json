  "question": {
    "text": "The reading of the ammeter for a silicon diode in the given circuit is:<br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/0f0f3a05-5f32-4fb6-9d78-977ab8fd4053-image.png\" style=\"width: 250px; height: 163px;\" />",
    "image": null
  },
  "options": [
    {
      "id": "90Z04",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>13</mn><mo>.5</mo><mi mathvariant=\"normal\">&#160;</mi><mi>mA</mi></math>",
      "image": null,
      "isCorrect": false
    },
