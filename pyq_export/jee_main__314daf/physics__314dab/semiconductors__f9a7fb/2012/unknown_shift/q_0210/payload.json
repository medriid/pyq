  "question": {
    "text": "Which one of the following is the Boolean expression for NOR gate?"
  },
  "options": [
    {
      "text": "\n$Y=\\overline{A+B}$\n",
      "is_correct": true
    },
    {
      "text": "\n$Y=\\overline{A \\cdot B}$\n",
      "is_correct": false
    },
    {
      "text": "\n$Y=A \\cdot B$\n",
      "is_correct": false
    },
    {
      "text": "\n$Y=\\bar{A}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "NOR gate is the combination of NOT and OR gate. Boolean expression for NOR gate is $Y=\\overline{A+B}$"
  }
}