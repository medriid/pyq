  "question": {
    "text": "A Zener diode is connected to a battery and a load as show below:\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/NIuELh--7Oh-1UgOL0_2Kuet91As4yfoBB99Szg5bM4.original.fullsize.png\"><br>\nThe currents, $\\mathrm{I}, \\mathrm{I}_{\\mathrm{Z}}$ and $\\mathrm{I}_{\\mathrm{L}}$ are respectively.",
    "image": null
  },
  "options": [
    {
      "id": "Kg9UW",
      "text": "\n$15 \\mathrm{~mA}, 5 \\mathrm{~mA}, 10 \\mathrm{~mA}$\n",
      "image": null,
      "isCorrect": false
    },
    {
