  "question": {
    "text": "The acceptor level of a p-type semiconductor is $6 \\mathrm{eV}$. The maximum wavelength of light which can create a hole would be : Given $\\mathrm{hc}=1242 \\mathrm{eV} \\mathrm{nm}$."
  },
  "options": [
    {
      "text": "$414 \\mathrm{~nm}$",
      "is_correct": false
    },
    {
      "text": "$103.5 \\mathrm{~nm}$",
      "is_correct": false
    },
    {
      "text": "$207 \\mathrm{~nm}$",
      "is_correct": true
    },
    {
      "text": "$407 \\mathrm{~nm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Energy }=\\frac{\\mathrm{hc}}{\\lambda} \\\\ & \\mathrm{E}=\\frac{1240}{\\lambda(\\mathrm{nm})} \\mathrm{eV} \\\\ & 6=\\frac{1240}{\\lambda(\\mathrm{nm})} \\\\ & \\lambda=\\frac{1240}{6}=207 \\mathrm{~nm}\\end{aligned}$"
  }
}