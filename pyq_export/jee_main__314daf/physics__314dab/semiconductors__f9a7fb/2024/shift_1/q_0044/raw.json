  "question": {
    "text": "<p>A Zener diode of breakdown voltage <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo> </mo><mi mathvariant=\"normal\">V</mi></math> is used as a voltage regulator as shown in the figure. The current through the Zener diode is</p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/35e1f014-096a-4084-ad44-f50e45a4999c.png\" style=\"width: 300px; height: 185px;\"/>",
    "image": null
  },
