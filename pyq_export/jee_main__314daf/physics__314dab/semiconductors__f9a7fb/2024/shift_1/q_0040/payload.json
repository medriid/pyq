  "question": {
    "text": "<p>In the given circuit if the power rating of Zener diode is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo> </mo><mi>mW</mi></math>, the value of series resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mi>s</mi></msub></math> to regulate the input unregulated supply is:</p><img src=\"assets\\qt0040_568ed4dd5fbe.png\" style=\"width: 400px; height: 173px;\"/>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>7</mn></mfrac><mo> </mo><mi>k</mi><mi>Ω</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo> </mo><mi>Ω</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo> </mo><mi>k</mi><mi>Ω</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo> </mo><mi>k</mi><mi>Ω</mi></math>",
      "is_correct": false
