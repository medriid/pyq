  "question": {
    "text": "A thin glass (refractive index 1.5) lens has optical power of $-5 D$ in air. Its optical power in a liquid medium with refractive index $1.6$ will be"
  },
  "options": [
    {
      "text": "\n$1 \\mathrm{D}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-1 \\mathrm{D}$\n",
      "is_correct": false
    },
    {
      "text": "\n$25 \\mathrm{D}$\n",
      "is_correct": false
    },
    {
      "text": "\nNone of these",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{P}_{\\mathrm{m}}}{\\mathrm{P}_{\\mathrm{air}}}=\\frac{\\left(\\frac{\\mu_{\\ell}}{\\mu_{\\mathrm{a}}}-1\\right)}{\\left(\\frac{\\mu_{\\ell}}{\\mu_{\\mathrm{m}}}-1\\right)}$\n$\\mathrm{P}_{\\mathrm{m}}=5 / 8 \\mathrm{D}$"
  }
}