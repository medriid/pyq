  "question": {
    "text": "Your friend is having eye sight problem. She is not able to see clearly a distant uniform window mesh and it appears to her as nonuniform and distorted. The doctor diagnosed the problem as :"
  },
  "options": [
    {
      "text": "Astigmatism",
      "is_correct": false
    },
    {
      "text": "Myopia with Astigmatism",
      "is_correct": true
    },
    {
      "text": "Presbyopia with Astigmatism",
      "is_correct": false
    },
    {
      "text": "Myopia and hypermetropia",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "If distant objects are blurry then the problem is Myopia. If objects are distorted then the problem is Astigmatism"
  }
}