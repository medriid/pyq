  "solution": {
    "text": "<math><mi>n</mi><mo>=</mo></math>&nbsp;refractive index &nbsp; <math><mo>=</mo><msqrt><msub><mrow><mi>&#949;</mi></mrow><mrow><mi>r</mi></mrow></msub><msub><mrow><mi>&#956;</mi></mrow><mrow><mi>r</mi></mrow></msub></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi>&#949;</mi><mn>0</mn></msub><msubsup><mi>E</mi><mn>0</mn><mn>2</mn></msubsup><mi>C</mi></math><br /><br /><math><msup><mrow><mi>I</mi></mrow><mrow><mi>&#8242;</mi></mrow></msup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#949;</mi><mtext> </mtext><msup><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>V</mi></math><br /><br /><math><msup><mrow><mi>I</mi></mrow><mrow><mi>&#8242;</mi></mrow></msup><mo>=</mo><mn>0.96</mn><mi>I</mi></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#949;</mi><msup><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>v</mi><mo>=</mo><mn>0.96</mn><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi>&#949;</mi></mrow><mrow><mn>0</mn></mrow></msub><msubsup><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mi>C</mi></math><br /><br /><math><mi>E</mi><mo>=</mo><msqrt><mn>0.96</mn></msqrt><msqrt><mfrac><mrow><msub><mrow><mi>&#949;</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><msub><mrow><mi>&#949;</mi></mrow><mrow><mn>0</mn></mrow></msub><msub><mrow><mi>&#949;</mi></mrow><mrow><mi>r</mi></mrow></msub></mrow></mfrac></msqrt><msqrt><mfrac><mrow><mi>c</mi></mrow><mrow><mi>v</mi></mrow></mfrac></msqrt><msub><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow></msub></math><br /><br />(For most of the transparent medium <math><msub><mrow><mi>&#956;</mi></mrow><mrow><mi>r</mi></mrow></msub><mo>&#8776;</mo><mn>1</mn></math> )<br />&nbsp; <math><mo>&#8658;</mo><mi>E</mi><mo>=</mo><msqrt><mn>0.96</mn></msqrt><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><msqrt><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>&#949;</mi></mrow><mrow><mi>r</mi></mrow></msub><msub><mrow><mi>&#956;</mi></mrow><mrow><mi>r</mi></mrow></msub></mrow></mfrac></msqrt><mo>.</mo><mi>&#160;</mi><msqrt><mfrac><mrow><mi>c</mi></mrow><mrow><mi>v</mi></mrow></mfrac></msqrt><msub><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow></msub></math><br /><br /><math><mo>=</mo><msqrt><mn>0.96</mn></msqrt><mo>.</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mo>.</mo><mi>&#160;</mi><msqrt><mi>n</mi></msqrt><mi>&#160;</mi><msub><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mo>=</mo><msqrt><mfrac><mn>0.96</mn><mi>n</mi></mfrac></msqrt><mi>&#160;</mi><msub><mi>E</mi><mn>0</mn></msub><mspace linebreak=\"newline\"/><mi>E</mi><mo>=</mo><msqrt><mfrac><mrow><mn>0</mn><mo>.</mo><mn>96</mn></mrow><mrow><mn>1</mn><mo>.</mo><mn>5</mn></mrow></mfrac></msqrt><mo>&#215;</mo><mn>30</mn><mo>=</mo><mn>24</mn><mo>&#160;</mo><mfrac><mi>V</mi><mi>m</mi></mfrac></math>",
