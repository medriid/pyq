  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f6e1dfc5-7fe1-451c-8ca5-d7902bdec18f-image.png\" style=\"width: 140px; height: 138px;\" /><br />Equivalent power of combination is<br /><br /><math><msub><mrow><mi>P</mi></mrow><mrow><mi>e</mi><mi>f</mi><mi>f</mi></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>P</mi></mrow><mrow><mi>l</mi><mi>e</mi><mi>n</mi><mi>s</mi></mrow></msub><mo>+</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi></mrow></msub></math> ...(i)<br /><br /><math><mo>&#8757;</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi><mi>&#160;</mi></mrow></msub><mo>=</mo><mn>0</mn></math> for plane mirror and <math><msub><mrow><mi>P</mi></mrow><mrow><mi>l</mi><mi>e</mi><mi>n</mi><mi>s</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>f</mi></mrow></mfrac></math><br /><br />Also combination behaves as a mirror. So. <math><msub><mrow><mi>P</mi></mrow><mrow><mi>e</mi><mi>f</mi><mi>f</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>f</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi></mrow></msub></mrow></mfrac></math><br /><br />In equation (i)<br /><br /><math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>f</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi><mi>&#160;</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mi>f</mi></mrow></mfrac><mo>&#8658;</mo><msub><mrow><mi>f</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi></mrow></msub><mo>=</mo><mo>-</mo><mfrac><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br />By mirror formula<br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>f</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi><mi>&#160;</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>u</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>v</mi></mrow></mfrac></math><br /><br />Here <math><mi>u</mi><mo>=</mo><mi>&#160;</mi><mo>-</mo><mi>a</mi><mo>,</mo><mi>&#160;</mi><mi>v</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mi>&#160;</mi><msub><mrow><mi>f</mi></mrow><mrow><mi>m</mi><mi>i</mi><mi>r</mi><mi>r</mi><mi>o</mi><mi>r</mi></mrow></msub><mo>=</mo><mi>&#160;</mi><mo>-</mo><mfrac><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mi>f</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mo>-</mo><mi>a</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mo>-</mo><mi>a</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>4</mn></mrow><mrow><mi>a</mi></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mrow><mi>f</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>4</mn></mrow><mrow><mi>a</mi></mrow></mfrac><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mn>2</mn><mi>f</mi></math>",
    "image": null
