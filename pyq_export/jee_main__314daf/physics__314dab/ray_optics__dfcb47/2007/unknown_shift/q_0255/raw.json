  "question": {
    "text": "Two lenses of power $-15 \\mathrm{~D}$ and $+5 \\mathrm{~D}$ are in contact with each other. The focal length of the combination is",
    "image": null
  },
  "options": [
    {
      "id": "EN5yo",
      "text": "\n$-20 \\mathrm{~cm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XZhBR",
      "text": "\n$-10 \\mathrm{~cm}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1ALS1",
      "text": "\n$+20 \\mathrm{~cm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0CjfQ",
      "text": "\n$+10 \\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    }
