  "question": {
    "text": "Two lenses of power $-15 \\mathrm{~D}$ and $+5 \\mathrm{~D}$ are in contact with each other. The focal length of the combination is"
  },
  "options": [
    {
      "text": "\n$-20 \\mathrm{~cm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-10 \\mathrm{~cm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$+20 \\mathrm{~cm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$+10 \\mathrm{~cm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& P=P_1+P_2=-10 \\\\\n& f=\\frac{1}{P} \\Rightarrow-0.1 \\mathrm{~m} \\Rightarrow-10 \\mathrm{~cm}\n\\end{aligned}$"
  }
