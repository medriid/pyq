  "level": 3,
  "question": {
    "text": "A person has been using spectacles of power&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>1</mn><mo>.</mo><mn>0</mn></math>&nbsp;diopter for distant vision and a separate reading glass of power <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.</mo><mn>0</mn></math> diopters. What is the least distance of distinct vision for this person:",
    "image": null
  },
  "options": [
    {
      "id": "Y1WUi",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mn>10</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QbH9z",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>40</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QEiju",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lOu7M",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": true,
      "image": null
