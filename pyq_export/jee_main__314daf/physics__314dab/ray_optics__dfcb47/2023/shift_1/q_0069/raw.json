  "question": {
    "text": "An ice cube has a bubble inside. When viewed from one side the apparent distance of the bubble is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>&#160;</mo><mi>cm</mi></math>. When viewed from the opposite side, the apparent distance of the bubble is observed as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mi>cm</mi></math>. If the side of the ice cube is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn><mo>&#160;</mo><mi>cm</mi></math>, the refractive index of the ice cube is&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "Jea0F",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac></math>",
