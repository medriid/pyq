      "isCorrect": true
    },
    {
      "id": "a58sH",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BZama",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>6</mn><mn>5</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9pW6b",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mn>3</mn></mfrac></math>",
