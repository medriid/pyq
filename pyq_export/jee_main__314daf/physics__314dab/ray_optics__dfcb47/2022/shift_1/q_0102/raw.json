  "level": 2,
  "question": {
    "text": "In normal adjustment, for a refracting telescope, the distance between objective and eye piece is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#160;</mo><mi>cm</mi></math>. The focal length of the objective, when the angular magnification of the telescope is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>, will be:",
    "image": null
  },
  "options": [
    {
      "id": "3o15b",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "lgVBQ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Eh3oo",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "yzmDV",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "isCorrect": false,
      "image": null
