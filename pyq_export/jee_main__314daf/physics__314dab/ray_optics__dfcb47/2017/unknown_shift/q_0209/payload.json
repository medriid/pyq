    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>sin</mi><mo>&#8289;</mo><msub><mi>&#952;</mi><mi>C</mi></msub></mrow></mfenced></math>",
