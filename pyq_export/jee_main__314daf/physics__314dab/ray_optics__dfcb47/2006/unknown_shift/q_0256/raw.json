  "question": {
    "text": "The refractive index of glass is $1.520$ for red light and $1.525$ for blue light. Let $D_1$ and $D_2$ be an of minimum deviation for red and blue light respectively in a prism of this glass. Then",
    "image": null
  },
  "options": [
    {
      "id": "lfibQ",
      "text": "\n$D_1>D_2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "I1gjY",
      "text": "\n$\\mathrm{D}_1 < \\mathrm{D}_2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "EWKNG",
      "text": "\n$D_1=D_2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "J7Vx5",
      "text": "\n$D_1$ can be less than or greater than depending upon the angle of prism",
      "image": null,
      "isCorrect": false
    }
