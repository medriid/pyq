  "question": {
    "text": "The position of the image formed by the combination of lenses is :\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/wJ-cPn8WsfeX9ljhXOv8E9_XoTA3QA_i05nVAtrERGA.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
