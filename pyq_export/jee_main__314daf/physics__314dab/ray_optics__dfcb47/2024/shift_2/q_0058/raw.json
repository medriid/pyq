  "question": {
    "text": "If the distance between object and its two times magnified virtual image produced by a curved mirror is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo> </mo><mi>cm</mi></math>, the focal length of the mirror must be :",
    "image": null
  },
  "options": [
    {
      "id": "5ZUoG",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo> </mo><mi>cm</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eDCi0",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>12</mn><mo> </mo><mi>cm</mi></math>",
