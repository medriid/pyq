    },
    {
      "id": "D55Hi",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>10</mn><mo> </mo><mi>cm</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "4Ykxs",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>10</mn><mn>3</mn></mfrac><mo> </mo><mi>cm</mi></math>",
      "image": null,
      "isCorrect": false
