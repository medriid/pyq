  "question": {
    "text": "Critical angle of incidence for a pair of optical media is $45^{\\circ}$. The refractive indices of first and second media are in the ratio:",
    "image": null
  },
  "options": [
    {
      "id": "ws4w2",
      "text": "$1: \\sqrt{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qOC4m",
      "text": "$\\sqrt{2}: 1$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9X6qc",
      "text": "$2: 1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CwVqV",
      "text": "$1: 2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\sin \\theta_{\\mathrm{c}}=\\frac{\\mu_{\\mathrm{R}}}{\\mu_{\\mathrm{d}}}=\\frac{\\mu_2}{\\mu_1} \\\\ & \\sin 45^{\\circ}=\\frac{\\mu_2}{\\mu_1} \\\\ & \\Rightarrow \\frac{1}{\\sqrt{2}}=\\frac{\\mu_2}{\\mu_1} \\\\ & \\Rightarrow \\frac{\\mu_1}{\\mu_2}=\\frac{\\sqrt{2}}{1}\\end{aligned}$",
    "image": null
  },
