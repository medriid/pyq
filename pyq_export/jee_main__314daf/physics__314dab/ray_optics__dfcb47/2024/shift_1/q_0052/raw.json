  "question": {
    "text": "An effective power of a combination of 5 identical convex lenses which are kept in contact along the principal axis is $25 \\mathrm{D}$. Focal length of each of the convex lens is :",
    "image": null
  },
  "options": [
    {
      "id": "LIvA5",
      "text": "$20 \\mathrm{~cm}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9ylSi",
      "text": "$50 \\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "K5C5D",
      "text": "$500 \\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oJhNO",
      "text": "$25 \\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "We know that $P_{\\mathrm{eq}}=\\Sigma \\mathrm{P}_{\\mathrm{i}}$\n$\\therefore$ given all lenses are identical\n$\\begin{aligned}\n& \\therefore 5 P=25 D \\\\\n& \\therefore P=5 D \\\\\n& \\therefore \\frac{1}{f}=5 \\Rightarrow f=\\frac{1}{5} \\mathrm{~m}=20 \\mathrm{~cm}\n\\end{aligned}$<br />Hence option (1)",
    "image": null
  },
