  "question": {
    "text": "A concave mirror produces an image of an object such that the distance between the object and image is 20 cm . If the magnification of the image is ' -3 ', then the magnitude of the radius of curvature of the mirror is :",
    "image": null
  },
  "options": [
    {
      "id": "uo4Gf",
      "text": "$30\\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WIUYT",
      "text": "$3.75\\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pR81O",
      "text": "$15\\mathrm{~cm}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "O7Jl8",
      "text": "$7.5\\mathrm{~cm}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/lJLzAkOSLXhWLSuhT_oByBjGuZsp1gGmA8gO_I9-Dz4.original.fullsize.png\"><br>\n$\\begin{aligned} & m=-3=-\\frac{u}{v} \\\\ & u=-x \\\\ & v=-3 x \\\\ & \\Rightarrow 2 x=20 \\mathrm{~cm}\\end{aligned}$\n$\\begin{aligned} & x=10 \\mathrm{~cm} \\\\ & f=\\frac{u V}{u+V}=\\frac{(-10)(-30)}{(-10)+(-30)}=-7.5 \\mathrm{~cm} \\\\ & f=-\\frac{R}{2} \\\\ & R=-2 f=15 \\mathrm{~cm}\\end{aligned}$",
    "image": null
  },
