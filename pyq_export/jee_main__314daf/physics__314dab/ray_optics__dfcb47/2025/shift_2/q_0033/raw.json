  "question": {
    "text": "The refractive index of the material of a glass prism is $\\sqrt{3}$. The angle of minimum deviation is equal to the angle of the prism. What is the angle of the prism?",
    "image": null
  },
  "options": [
    {
      "id": "AxA77",
      "text": "$60^{\\circ}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Nay3j",
      "text": "$58^{\\circ}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JBcii",
      "text": "$48^{\\circ}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XVlMd",
      "text": "$50^{\\circ}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mu=\\frac{\\sin \\left(\\frac{A+\\delta_{\\min }}{2}\\right)}{\\sin \\frac{A}{2}}$\n\nGiven $\\delta_{\\min }=\\mathrm{A}$\n$\\begin{aligned}\n& \\sqrt{3}=\\frac{\\sin A}{\\sin \\frac{A}{2}}=\\frac{2 \\sin \\frac{A}{2} \\cos \\frac{A}{2}}{\\sin \\frac{A}{2}} \\\\\n& \\cos \\frac{A}{2}=\\frac{\\sqrt{3}}{2} \\\\\n& A=60^{\\circ}\n\\end{aligned}$",
    "image": null
  },
