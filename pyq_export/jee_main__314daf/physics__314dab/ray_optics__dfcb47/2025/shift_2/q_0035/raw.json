  "question": {
    "text": "Two identical objects are placed in front of convex mirror and concave mirror having same radii of curvature of 12 cm , at same distance of 18 cm from the respective mirrors. The ratio of sizes of the images formed by convex mirror and by concave mirror is :",
    "image": null
  },
  "options": [
    {
      "id": "I8k0e",
      "text": "$1 / 2$",
      "image": null,
      "isCorrect": true
