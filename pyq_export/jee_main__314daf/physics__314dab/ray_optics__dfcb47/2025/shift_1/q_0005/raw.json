  "question": {
    "text": "Two thin convex lenses of focal length 30 cm and 10 cm are placed coaxially, 10 cm apart. The power of this combination is :",
    "image": null
  },
  "options": [
    {
      "id": "F1MPW",
      "text": "5 D",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "21Fp9",
      "text": "1 D",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Dd9HQ",
      "text": "20 D",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "j3HYk",
      "text": "10 D",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{f}_1=30 \\mathrm{~cm}, \\mathrm{f}_2=10 \\mathrm{~cm}$<br/>$\\frac{1}{\\mathrm{f}_{\\mathrm{eq}}}=\\frac{1}{\\mathrm{f}_1}+\\frac{1}{\\mathrm{f}_2}-\\frac{\\mathrm{d}}{\\mathrm{f}_1 \\mathrm{f}_2}, \\mathrm{~d}=$ distance between lens<br/>$\\frac{1}{\\mathrm{f}_{\\mathrm{eq}}}=\\frac{1}{0.3}+\\frac{1}{0.1}-\\frac{0.1}{(0.3)(0.1)}$<br/>$\\frac{1}{\\mathrm{f}_{\\mathrm{eq}}}=\\frac{1}{0.1}$<br/>Power $=\\frac{1}{\\mathrm{f}_{\\mathrm{eq}}}=10 \\mathrm{D}$",
    "image": null
  },
