  "question": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/723V2KGE3rXSeAUIs8B13GgyXZK8d33v6JHQKBPWmH8.original.fullsize.png\"/><br/>A spherical surface separates two media of refractive indices 1 and 1.5 as shown in figure. Distance of the image of an object ' O ', is :<br/>( C is the center of curvature of the spherical surface and $R$ is the radius of curvature)",
    "image": null
  },
  "options": [
    {
