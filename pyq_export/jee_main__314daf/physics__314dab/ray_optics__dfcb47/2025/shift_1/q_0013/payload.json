  "question": {
    "text": "The radii of curvature for a thin convex lens are 10 cm and 15 cm respectively. The focal length of the lens is 12 cm. The refractive index of the lens material is"
  },
  "options": [
    {
      "text": "1.2",
      "is_correct": false
    },
    {
      "text": "1.4",
      "is_correct": false
    },
    {
      "text": "1.5",
      "is_correct": true
    },
    {
      "text": "1.8",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\frac{1}{\\mathrm{f}}=(\\mu-1)\\left(\\frac{1}{\\mathrm{R}_1}-\\frac{1}{\\mathrm{R}_2}\\right) \\\\ & \\frac{1}{12}=(\\mu-1)\\left(\\frac{1}{10}-\\frac{1}{-15}\\right) \\\\ & \\frac{1}{12}=(\\mu-1)\\left(\\frac{3+2}{30}\\right) \\\\ & \\mu=\\frac{3}{2}\\end{aligned}$"
  }
