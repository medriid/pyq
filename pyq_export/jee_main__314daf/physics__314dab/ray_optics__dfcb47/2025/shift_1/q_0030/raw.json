  "question": {
    "text": "When an object is placed 40 cm away from a spherical mirror an image of magnification $\\frac{1}{2}$ is produced. To obtain an image with magnification of $\\frac{1}{3}$, the object is to be moved :",
    "image": null
  },
  "options": [
    {
      "id": "OaUwK",
      "text": "40 cm away from the mirror.",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "KH0Bb",
      "text": "80 cm away from the mirror.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lvpKt",
      "text": "20 cm towards the mirror.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UFXi8",
      "text": "20 cm away from the mirror.",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{m}=\\frac{1}{2}=\\frac{\\mathrm{f}}{\\mathrm{f}-\\mathrm{u}} \\\\ & \\frac{1}{2}=\\frac{\\mathrm{f}}{\\mathrm{f}-(-40)} \\\\ & \\mathrm{f}+40=2 \\mathrm{f} \\Rightarrow \\mathrm{f}=40 \\mathrm{~cm} \\\\ & \\text { now } \\mathrm{m}=\\frac{1}{3}=\\frac{40}{40-\\mathrm{u}} \\\\ & 40-\\mathrm{u}=120 \\Rightarrow \\mathrm{u}=-80\\end{aligned}$",
    "image": null
  },
