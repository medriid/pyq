  "question": {
    "text": "What is the relative decrease in focal length of a lens for an increase in optical power by 0.1 D from 2.5D ? ['D' stands for dioptre]",
    "image": null
  },
  "options": [
    {
      "id": "sruFv",
      "text": "$0.01$",
      "image": null,
      "isCorrect": false
    },
