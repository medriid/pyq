  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & P=\\frac{1}{f} \\\\ & \\text { So } P_1=\\frac{1}{F_1} \\Rightarrow F_1=\\frac{1}{2.5} \\\\ & \\text { Next } F_2=\\frac{1}{2.6} \\\\ & \\left|\\frac{\\Delta F}{F_1}\\right|=\\frac{\\left|F_2-F_1\\right|}{F_1}=\\left|\\frac{F_2}{F_1}-1\\right| \\\\ & \\Rightarrow\\left|\\frac{\\Delta F}{F_1}\\right|=\\left|\\frac{2.5}{2.6}-1\\right|=\\frac{0.1}{2.6} \\approx 0.04\\end{aligned}$",
    "image": null
  },
