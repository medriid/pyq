  "question": {
    "text": "<p>A hemispherical glass body of radius 10 cm and refractive index 1.5 is silvered on its curved surface. A small air bubble is 6 cm below the flat surface inside it along the axis. The position of the image of the air bubble made by the mirror is seen :<br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/404dfce7-57a3-4a44-ac2b-e8b43b795452-image.png\" style=\"width: 298px; height: 150px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "gmjgk",
      "text": "14cm below flat surface",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0dH0K",
      "text": "20cm below flat surface",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UuMtC",
