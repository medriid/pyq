      "image": null,
      "isCorrect": false
    },
    {
      "id": "KF0z2",
      "text": "30cm below flat surface",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<p>Mirror image<br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>v</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>u</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>f</mi></mrow></mfrac><mo>&#8658;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>v</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mo>-</mo><mn>4</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mo>-</mo><mn>5</mn></mrow></mfrac></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>v</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>20</mn></mrow></mfrac></math><br /><math><mi>v</mi><mo>=</mo><mn>20</mn></math><br /><br />So, it is 30 cm below flat surface.<br /><br />Now, After refraction<br /><br /><math><msup><mrow><mi>v</mi></mrow><mrow><mi>&#39;</mi></mrow></msup><mo>=</mo><mfrac><mrow><mn>30</mn></mrow><mrow><mi>&#956;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>30</mn></mrow><mrow><mn>1.5</mn></mrow></mfrac><mo>=</mo><mn>20</mn><mi>&#160;</mi><mi>c</mi><mi>m</mi></math><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/44843e11-4659-42d6-9181-aa1b90668ec7-image.png\" style=\"width: 322px; height: 250px;\" /></p>",
