    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 450px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">List I</td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">List II</td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>.</mo></math></td>\t\t\t<td>Planck&#39;s constant <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>h</mi></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>.</mo></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>1</mn></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">L</mi><mn>2</mn></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow></mfenced></math></td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>.</mo></math></td>\t\t\t<td>Stopping potential <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><msub><mi>V</mi><mi>s</mi></msub></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi><mo>.</mo></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>1</mn></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">L</mi><mn>1</mn></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced></math></td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi><mo>.</mo></math></td>\t\t\t<td>Work function <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>&#981;</mi></mfenced></math></td>\t\