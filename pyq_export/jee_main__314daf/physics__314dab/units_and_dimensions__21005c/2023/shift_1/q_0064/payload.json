  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List - I</strong></td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List - II</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td>Surface tension</td>\t\t\t<td>I.</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td>Pressure</td>\t\t\t<td>II.</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td>Viscosity</td>\t\t\t<td>III.</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td>Impulse</td>\t\t\t<td>IV.</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below:</p>"
  },
