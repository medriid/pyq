  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td><strong>List I</strong></td>\t\t\t<td>&nbsp;</td>\t\t\t<td><strong>List II</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td>Torque</td>\t\t\t<td>I</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>&#8211;</mo><mn>1</mn></mrow></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>&#8211;</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td>Energy density</td>\t\t\t<td>II</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>&#8211;</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td>Pressure gradient</td>\t\t\t<td>III</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>&#8211;</mo><mn>2</mn></mrow></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>&#8211;</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td>Impulse</td>\t\t\t<td>IV</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kg</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mn>2</mn></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>&#8211;</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below :</p>"
