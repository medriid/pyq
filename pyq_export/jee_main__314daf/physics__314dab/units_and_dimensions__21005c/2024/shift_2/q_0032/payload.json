  "question": {
    "text": "The de-Broglie wavelength associated with a particle of mass $m$ and energy $E$ is $h / \\sqrt{2 m E}$. The dimensional formula for Planck's constant is :"
  },
  "options": [
    {
      "text": "$\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-1}\\right]$",
      "is_correct": true
    },
    {
      "text": "$\\left[\\mathrm{ML}^{-1} \\mathrm{~T}^{-2}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\mathrm{MLT}^{-2}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\mathrm{M}^2 \\mathrm{~L}^2 \\mathrm{~T}^{-2}\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\lambda=\\frac{\\mathrm{h}}{\\sqrt{2 \\mathrm{mE}}} \\text { or } \\mathrm{E}=\\mathrm{h} \\nu \\\\ & {\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2}\\right]=\\mathrm{h}\\left[\\mathrm{T}^{-1}\\right]} \\\\ & \\mathrm{h}=\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-1}\\right]\\end{aligned}$"
  }
