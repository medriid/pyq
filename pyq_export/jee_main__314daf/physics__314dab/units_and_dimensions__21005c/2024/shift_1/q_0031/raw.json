  "question": {
    "text": "If $\\mathrm{G}$ be the gravitational constant and $\\mathrm{u}$ be the energy density then which of the following quantity have the dimensions as that of the $\\sqrt{\\mathrm{uG}}$ :",
    "image": null
  },
  "options": [
    {
      "id": "XwFfJ",
      "text": "pressure gradient per unit mass",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Mxdgb",
      "text": "Gravitational potential",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BXqiJ",
      "text": "Energy per unit mass",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "J0Qbp",
      "text": "Force per unit mass",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& {[\\mathrm{uG}]=\\left[\\left(\\mathrm{M}^1 \\mathrm{~L}^{-1} \\mathrm{~T}^{-2}\\right)\\left(\\mathrm{M}^{-1} \\mathrm{~L}^3 \\mathrm{~T}^{-2}\\right)\\right]} \\\\\n& {[\\mathrm{uG}]=\\left[\\mathrm{M}^0 \\mathrm{~L}^2 \\mathrm{~T}^{-4}\\right]} \\\\\n& {[\\sqrt{\\mathrm{uG}}]=\\left[\\mathrm{L}^1 \\mathrm{~T}^{-2}\\right]}\n\\end{aligned}$",
    "image": null
  },
