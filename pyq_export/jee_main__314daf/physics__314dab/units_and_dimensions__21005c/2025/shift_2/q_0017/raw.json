  "question": {
    "text": "Match List-I with List-II.<br/>$\\begin{array}{ll} \\text{List-I} & \\text{List-II} \\\\ \\text{(A) Heat capacity of body} & \\text{(I) } \\mathrm{J} \\mathrm{kg}^{-1} \\\\ \\text{(B) Specific heat capacity of body} & \\text{(II) } \\mathrm{JK}^{-1} \\\\ \\text{(C) Latent heat} & \\text{(III) } \\mathrm{J} \\mathrm{kg}^{-1} \\mathrm{~K}^{-1} \\\\ \\text{(D) Thermal conductivity} & \\text{(IV) } \\mathrm{Jm}^{-1} \\mathrm{~K}^{-1} \\mathrm{~s}^{-1} \\end{array}$<br/>Choose the correct answer from the options given below :",
    "image": null
  },
  "options": [
    {
      "id": "lYVtn",
      "text": "(A)-(III), (B)-(I), (C)-(II), (D)-(IV)",
      "image": null,
