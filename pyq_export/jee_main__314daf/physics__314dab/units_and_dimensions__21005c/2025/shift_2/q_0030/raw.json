  "question": {
    "text": "Which one of the following is the correct dimensional formula for the capacitance in F ? $\\mathrm{M}, \\mathrm{L}, \\mathrm{T}$ and C stand for unit of mass, length, time and charge,",
    "image": null
  },
  "options": [
    {
      "id": "Zrp5h",
      "text": "$[\\mathrm{F}]=\\left[\\mathrm{C}^2 \\mathrm{M}^{-1} \\mathrm{~L}^{-2} \\mathrm{~T}^2\\right]$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8poiA",
      "text": "$[\\mathrm{F}]=\\left[\\mathrm{C}^2 \\mathrm{M}^{-2} \\mathrm{~L}^2 \\mathrm{~T}^2\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KNCKS",
      "text": "$[\\mathrm{F}]=\\left[\\mathrm{CM}^{-2} \\mathrm{~L}^{-2} \\mathrm{~T}^{-2}\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1fO4M",
      "text": "$[\\mathrm{F}]=\\left[\\mathrm{CM}^{-1} \\mathrm{~L}^{-2} \\mathrm{~T}^2\\right]$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Energy }=\\frac{Q^2}{2 C} \\\\ & \\begin{aligned} \\therefore \\quad[\\mathrm{F}] & =\\frac{\\left[\\mathrm{C}^2\\right]}{\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2}\\right]} \\\\ & =\\left[\\mathrm{C}^2 \\mathrm{M}^{-1} \\mathrm{~L}^{-2} \\mathrm{~T}^{+2}\\right]\\end{aligned}\\end{aligned}$",
    "image": null
  },
