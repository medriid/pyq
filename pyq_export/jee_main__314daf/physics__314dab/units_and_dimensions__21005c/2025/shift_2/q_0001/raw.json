  "question": {
    "text": "The dimension of $\\sqrt{\\frac{\\mu_0}{\\epsilon_0}}$ is equal to that of :<br/>( $\\mu_0=$ Vacuum permeability and $\\epsilon_0=$ Vacuum permittivity)",
    "image": null
  },
  "options": [
    {
      "id": "2q04o",
      "text": "Voltage",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CpwQe",
      "text": "Capacitance",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a14hF",
      "text": "Inductance",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Smn6X",
      "text": "Resistance",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & L=\\frac{\\mu_0 N A}{\\ell} \\\\ & C=\\frac{A \\epsilon_0}{d} \\\\ & \\frac{L}{C} \\propto \\frac{\\mu_0}{\\epsilon_0} \\\\ & \\sqrt{\\frac{\\mu_0}{\\epsilon_0}} \\propto \\sqrt{\\frac{L}{C}} \\\\ & \\frac{L}{C}=\\frac{\\tau R}{(\\tau / R)}=R^2 \\\\ & \\sqrt{\\frac{\\mu_0}{\\epsilon_0}}=R\\end{aligned}$",
    "image": null
  },
