  "question": {
    "text": "If $\\mu_0$ and $\\varepsilon_0$ are the permeability and permittivity of free space, respectively, then the dimension of $\\left(\\frac{1}{\\mu_0 \\varepsilon_0}\\right)$ is :",
    "image": null
  },
  "options": [
    {
      "id": "kJWTF",
      "text": "$\\mathrm{L} / \\mathrm{T}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Nf9es",
      "text": "$L^2 / T^2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ExUZD",
      "text": "$T^2 / L$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7d134",
      "text": "$\\mathrm{T}^2 / \\mathrm{L}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{C}=\\frac{1}{\\sqrt{\\mu_0 \\varepsilon_0}} \\Rightarrow \\frac{1}{\\mu_0 \\varepsilon_0}=\\mathrm{C}^2=\\mathrm{L}^2 \\mathrm{~T}^{-2}$",
    "image": null
  },
