  "question": {
    "text": "The electric flux is $\\phi=\\alpha \\sigma+\\beta \\lambda$ where $\\lambda$ and $\\sigma$ are linear and surface charge density, respectively. $\\left(\\frac{\\alpha}{\\beta}\\right)$ represents",
    "image": null
  },
  "options": [
    {
      "id": "ON65x",
      "text": "electric field",
      "image": null,
      "isCorrect": false
    },
    {
