  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\alpha \\equiv \\frac{\\phi}{\\sigma} \\\\ & \\beta=\\frac{\\phi}{\\lambda} \\\\ & \\frac{\\alpha}{\\beta} \\equiv \\frac{\\lambda}{\\sigma} \\equiv \\text { displacement }\\end{aligned}$",
    "image": null
