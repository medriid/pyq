  "question": {
    "text": "If $B$ is magnetic field and $\\mu_0$ is permeability of free space, then the dimensions of $\\left(B / \\mu_0\\right)$ is",
    "image": null
  },
  "options": [
    {
      "id": "dg1RB",
      "text": "$\\mathrm{ML}^2 \\mathrm{~T}^{-2} \\mathrm{~A}^{-1}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6VwhE",
      "text": "$\\mathrm{MT}^{-2} \\mathrm{~A}^{-1}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "B1aGt",
      "text": "$\\mathrm{L}^{-1} \\mathrm{~A}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "wt7BP",
      "text": "$\\mathrm{LT}^{-2} \\mathrm{~A}^{-1}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For a current carrying loop at centre\n$\\begin{aligned}\n& B=\\frac{\\mu_0 i}{2 R} \\\\\n& \\therefore \\quad \\frac{B}{\\mu_0} \\equiv \\frac{i}{R} \\equiv\\left[\\mathrm{AL}^{-1}\\right]\n\\end{aligned}$",
    "image": null
  },
