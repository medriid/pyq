  "question": {
    "text": "The electric flux is $\\phi=\\alpha \\sigma+\\beta \\lambda$ where $\\lambda$ and $\\sigma$ are linear and surface charge density, respectively. $\\left(\\frac{\\alpha}{\\beta}\\right)$ represents"
  },
  "options": [
    {
      "text": "electric field",
      "is_correct": false
    },
    {
      "text": "area",
      "is_correct": false
    },
    {
      "text": "charge",
      "is_correct": false
    },
    {
      "text": "displacement",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\alpha \\equiv \\frac{\\phi}{\\sigma} \\\\ & \\beta=\\frac{\\phi}{\\lambda} \\\\ & \\frac{\\alpha}{\\beta} \\equiv \\frac{\\lambda}{\\sigma} \\equiv \\text { displacement }\\end{aligned}$"
  }
}