  "question": {
    "text": "The position of a particle moving on $x$-axis is given by $x(t)=A \\sin t+B \\cos ^2 t+C t^2+D$, where $t$ is time. The dimension of $\\frac{A B C}{D}$ is"
  },
  "options": [
    {
      "text": "$L^2 T^{-2}$",
      "is_correct": true
    },
    {
      "text": "$L^2$",
      "is_correct": false
    },
    {
      "text": "$L$",
      "is_correct": false
    },
    {
      "text": "$L^3 \\mathrm{~T}^{-2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Dimension }[\\mathrm{x}(\\mathrm{t})]=[\\mathrm{L}] \\\\ & {[\\mathrm{A}]=[\\mathrm{L}]} \\\\ & {[\\mathbf{B}]=[\\mathrm{L}]} \\\\ & {[\\mathbf{C}]=\\left[\\mathrm{LT}^{-2}\\right]} \\\\ & {[\\mathrm{D}]=[\\mathrm{L}]} \\\\ & {\\left[\\frac{\\mathrm{ABC}}{\\mathrm{D}}\\right]=\\left[\\frac{\\mathrm{L} \\times \\mathrm{L} \\times \\mathrm{LT}^{-2}}{\\mathrm{~L}}\\right]=\\left[\\mathrm{L}^2 \\mathrm{~T}^{-2}\\right]}\\end{aligned}$"
  }
}