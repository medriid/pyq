    "text": "<blockquote><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td>Torque <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mtext>Force</mtext><mo>&#215;</mo><mtext>perpendicular&#160;distance</mtext><mo>&#160;</mo><mfenced><msub><mi>r</mi><mo>&#8869;</mo></msub></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Stress</mi><mo>=</mo><mfrac><mrow><mo>&#160;</mo><mi>Force</mi><mo>&#160;</mo></mrow><mrow><mo>&#160;</mo><mi>Area</mi><mo>&#160;</mo></mrow></mfrac></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>Latent heat <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mo>&#160;</mo><mi>Energy</mi><mo>&#160;</mo></mrow><mrow><mo>&#160;</mo><mi>Mass</mi><mo>&#160;</mo></mrow></mfrac></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">J</mi><mo>&#160;</mo><msup><mi>kg</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>Power <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">=</mi><mfrac><mrow><mo>&#160;</mo><mi>Work</mi><mo>&#160;</mo></mrow><mrow><mo>&#160;</mo><mi>Time</mi><mo>&#160;</mo></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>Force</mi><mo>&#215;</mo><mi>displacement</mi></mrow><mi>Time</mi></mfrac></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t</tbod