    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>0</mn></msup><msup><mi mathvariant=\"normal\">L</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mi mathvariant=\"normal\">T</mi><mn>0</mn></msup></mrow></mfenced></math>",
