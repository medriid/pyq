  "question": {
    "text": "Which one of the following represents the correct dimensions of the coefficient of viscosity?",
    "image": null
  },
  "options": [
    {
      "id": "6bimo",
      "text": "\n$\\mathrm{ML}^{-1} \\mathrm{~T}^{-2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
