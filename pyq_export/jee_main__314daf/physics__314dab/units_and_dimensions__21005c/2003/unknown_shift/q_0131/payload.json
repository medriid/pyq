  "question": {
    "text": "Dimension of $\\frac{1}{\\mu_0 \\varepsilon_0}$, where symbols have their usual meaning, are"
  },
  "options": [
    {
      "text": "\n$\\left[\\mathrm{L}^{-1} \\mathrm{~T}\\right]$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left[\\mathrm{L}^{-2} \\mathrm{~T}^2\\right]$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left[\\mathrm{L}^2 \\mathrm{~T}^{-2}\\right]$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\left[\\mathrm{LT}^{-1}\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{1}{\\sqrt{\\mu_0 \\varepsilon_0}}=\\mathrm{C} \\Rightarrow \\frac{1}{\\mu_0 \\varepsilon_0}=\\mathrm{C}^2 \\Rightarrow\\left[\\frac{1}{\\mu_0 \\varepsilon_0}\\right]=[\\mathrm{C}]^2$\n$[\\mathrm{C}]=\\mathrm{LT}^{-1} \\quad$ or $\\quad[\\mathrm{C}]^2=\\mathrm{L}^2 \\mathrm{~T}^{-2}$"
  }
