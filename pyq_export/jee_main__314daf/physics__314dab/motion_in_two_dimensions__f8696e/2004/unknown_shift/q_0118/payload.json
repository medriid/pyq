  "question": {
    "text": "If $t_1$ and $t_2$ are the times of flight of two particles having the same initial velocity $u$ and range $\\mathrm{R}$ on the horizontal, then $\\mathrm{t}_1^2+\\mathrm{t}_2^2$ is equal to"
  },
  "options": [
    {
      "text": "\n$\\frac{u^2}{g}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{4 u^2}{g^2}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{u^2}{2 g}$\n",
      "is_correct": false
    },
    {
      "text": "\n1",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{t}_1=\\frac{2 \\mathrm{u} \\sin \\alpha}{\\mathrm{g}}, \\mathrm{t}_2=\\frac{2 \\mathrm{u} \\sin \\beta}{\\mathrm{g}}$ where $\\alpha+\\beta=90^{\\circ}$\n$\\therefore \\mathrm{t}_1^2+\\mathrm{t}_2^2=\\frac{4 \\mathrm{u}^2}{\\mathrm{~g}^2}$"
  }
}