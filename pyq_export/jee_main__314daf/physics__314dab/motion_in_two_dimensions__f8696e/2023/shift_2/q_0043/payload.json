    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><mo>-</mo><mn>4</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>,</mo><mo>&#160;</mo><mi>a</mi><mo>=</mo><mn>8</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math>",
