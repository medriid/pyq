    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mo>:</mo><mo>&#160;</mo><mn>2</mn></math>",
      "is_correct": false
    },
