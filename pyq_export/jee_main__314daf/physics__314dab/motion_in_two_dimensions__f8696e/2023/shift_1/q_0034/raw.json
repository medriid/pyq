  "question": {
    "text": "<p>A particle is moving with constant speed in a circular path. When the particle turns by an angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>90</mn><mo>&#176;</mo><mo>,</mo></math> the ratio of instantaneous velocity to its&nbsp;average velocity is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#960;</mi><mo>:</mo><mi>x</mi><msqrt><mn>2</mn></msqrt><mo>.</mo></math>&nbsp;The&nbsp;value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math> will be</p>",
    "image": null
  },
  "options": [
    {
      "id": "KVWvD",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
