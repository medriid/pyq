  "question": {
    "text": "A boy can throw a stone up to a maximum height of $10 \\mathrm{~m}$. The maximum horizontal distance that the boy can throw the same stone up to will be",
    "image": null
  },
  "options": [
    {
      "id": "qshO9",
      "text": "\n$20 \\sqrt{2} \\mathrm{~m}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6q49b",
      "text": "\n$10 \\mathrm{~m}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YtPdM",
      "text": "\n$10 \\sqrt{2} \\mathrm{~m}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xvGA7",
      "text": "\n$20 \\mathrm{~m}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "maximum vertical height $=\\frac{u^2}{2 g}=10 \\mathrm{~m}$\nHorizontal range of a projectile $=\\frac{u^2 \\sin 2 \\theta}{\\mathrm{g}}$\nRange is maximum when $\\theta=45^{\\circ}$\nMaximum horizontal range $=\\frac{\\mathrm{u}^2}{\\mathrm{~g}}$\nHence maximum horizontal distance $=20 \\mathrm{~m}$.",
    "image": null
  },
