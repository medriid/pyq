      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mfrac><mrow><mn>4</mn><mi>R</mi></mrow><mrow><mn>5</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mfrac><mrow><mn>4</mn><msup><mi>t</mi><mn>2</mn></msup></mrow><mrow><mn>5</mn><mi>R</mi></mrow></mfrac></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>cot</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mfrac><mi>R</mi><mrow><mn>20</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></mfenced></math>",
