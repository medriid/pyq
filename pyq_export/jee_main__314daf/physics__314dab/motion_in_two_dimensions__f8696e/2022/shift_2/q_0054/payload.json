    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msup><mi>t</mi><mn>4</mn></msup></mrow><mn>3</mn></mfrac><mo>-</mo><mfrac><msup><mi>t</mi><mn>3</mn></msup><mn>6</mn></mfrac><mo>+</mo><mn>10</mn><mi>t</mi><mo>+</mo><mn>12</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mi>t</mi><mn>4</mn></msup><mo>-</mo><mfrac><msup><mi>t</mi><mn>3</mn></msup><mn>2</mn></mfrac><mo>+</mo><mn>5</mn><mi>t</mi><mo>+</mo><mn>4</mn></math>",
