  "question": {
    "text": "A ball of mass 100 g is projected with velocity $20 \\mathrm{~m} / \\mathrm{s}$ at $60^{\\circ}$ with horizontal. The decrease in kinetic energy of the ball during the motion from point of projection to highest point is",
    "image": null
  },
  "options": [
    {
      "id": "Z5w2J",
      "text": "5 J",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Komm6",
      "text": "15 J",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mwTyI",
      "text": "20 J",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qhrfw",
      "text": "zero",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/EAcJ1hTbFWbRNJJHGMSJKbOGwDw8WmN1CefZVpzdtQE.original.fullsize.png\"><br>\n\n\n\n$\\begin{aligned} & \\mathrm{k}_{\\mathrm{i}}=\\frac{1}{2} \\mathrm{mv}^2 \\\\ & \\mathrm{k}_{\\mathrm{f}}=\\frac{1}{2} \\mathrm{~m}\\left(\\mathrm{v} \\cos 60^{\\circ}\\right)^2=\\frac{1}{8} m v^2 \\\\ & \\Delta \\mathrm{k}=\\mathrm{k}_{\\mathrm{i}}-\\mathrm{k}_{\\mathrm{f}}=\\frac{3}{8} \\mathrm{mv}^2=\\frac{3}{8} \\times 0.1 \\times 400=15 \\mathrm{~J}\\end{aligned}$",
    "image": null
  },
