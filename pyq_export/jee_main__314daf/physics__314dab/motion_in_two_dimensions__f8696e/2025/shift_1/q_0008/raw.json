  "question": {
    "text": "A river is flowing from west to east direction with speed of $9 \\mathrm{~km} \\mathrm{~h}^{-1}$. If a boat capable of moving at a maximum speed of $27 \\mathrm{~km} \\mathrm{~h}^{-1}$ in still water, crosses the river in half a minute, while moving with maximum speed at an angle of $150^{\\circ}$ to direction of river flow, then the width of the river is :",
    "image": null
  },
  "options": [
    {
      "id": "loVGf",
      "text": "300 m",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gSw0p",
      "text": "112.5 m",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iAmPJ",
      "text": "75 m",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ApP1j",
      "text": "$112.5 \\times \\sqrt{3} \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/FUDbHaQaKoq_P3cfs3GzsWy4OpBGmg4k-WiQyBGwjZE.original.fullsize.png\"/><br/>$\\therefore \\mathrm{V}_{\\perp}=$ river flow $=27 \\times \\cos 60^{\\circ}=\\frac{27}{2} \\mathrm{~km} / \\mathrm{hr}$.<br/>Time taken $=30 \\mathrm{sec}$.<br/>$\\therefore \\mathrm{S}=\\mathrm{Vt}=\\frac{27}{2} \\times \\frac{5}{18} \\times 30 \\mathrm{~m}=112.5 \\mathrm{~m}$",
    "image": null
  },
