  "question": {
    "text": "A projectile can have the same range $\\mathrm{R}$ for two angles of projection. If $\\mathrm{t}_1$ and $\\mathrm{t}_2$ be the times of flights in the two cases, then the product of the two time of flights is proportional to",
    "image": null
  },
  "options": [
    {
      "id": "CabMC",
      "text": "\n$\\mathrm{R}^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zKzbG",
      "text": "\n$1 / R^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YBuRc",
      "text": "\n$1 / \\mathrm{R}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7lXBP",
      "text": "\n$\\mathrm{R}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{t}_1 \\mathrm{t}_2=\\frac{2 \\mathrm{u}^2 \\sin 2 \\theta}{\\mathrm{g}^2}=\\frac{2 \\mathrm{R}}{\\mathrm{g}}$",
    "image": null
  },
