      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>2</mn><mi>m</mi><msup><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>k</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>m</mi><msup><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>k</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mi>m</mi><msup><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>3</mn><mi>k</mi></mrow></mfrac></math>",
