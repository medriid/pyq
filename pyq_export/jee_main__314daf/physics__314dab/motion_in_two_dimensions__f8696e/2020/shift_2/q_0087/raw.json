    "text": "<math><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>ω</mi></mrow></mrow><mi>t</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>ω</mi><mi>t</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mrow></math>  <br/><math><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover><mo>=</mo><mfrac><mrow><mi>d</mi><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mi>ω</mi><mi></mi><mfenced separators=\"|\"><mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>ω</mi><mi>t</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>ω</mi><mi>t</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mrow></mrow></mrow></mrow></mfenced></math>  <br/><math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>=</mo><mfrac><mrow><mi>d</mi><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>→</mo></mover></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mo>-</mo><msup><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>ω</mi><mi>t</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>ω</mi><mi>t</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mrow></mrow></mrow></mrow></mfenced></math>  <br/><math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>=</mo><mo>-</mo><msup><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msup><mover accent=\"true\"><mrow><mi