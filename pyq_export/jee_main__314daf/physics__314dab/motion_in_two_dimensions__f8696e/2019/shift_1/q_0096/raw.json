    "text": "<math><mi>x</mi><mo>=</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">t</mi></mrow></mfenced></math>  <br/><math><mi>y</mi><mo>=</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mi mathvariant=\"normal\">b</mi><mtext> </mtext><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mtext> </mtext><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">t</mi></mrow></mfenced></math>  <br/><math><msub><mrow><mi>a</mi></mrow><mrow><mi>x</mi></mrow></msub><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\"> </mi><msubsup><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mtext> </mtext><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">t</mi></mrow></mfenced></math>  <br/><math><msub><mrow><mi>a</mi></mrow><mrow><mi>y</mi></mrow></msub><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\"> </mi><msubsup><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mtext> </mtext><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">t</mi></mrow></mfenced></math>  <br/>At <math><mi>t</mi><mo>=</mo><mn>0</mn></math> , <br/><math><mover accent=\"true\"><mrow><mi>F</mi></mrow><mo>→</mo></mover><mo>=</mo><mi>m</mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mi mathvariant=\"normal\">a</mi><mtext> </mtext><msubsup><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mtext> </mtext><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">i</mi></mrow><mo>^</mo></mover></mrow></mfenced></math>  <br/>And <br/><math><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>0</mn></mrow></msub><mtext>+</mtext><mtext> </mtext><mi mathvariant=\"normal\">a</mi></mrow></mfenced><mtext> </mtext><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">i</mi></mrow><mo>^</mo></mover><mo>+</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>0</mn></mrow></msub><mtext> </mtext><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">j</mi></mrow><mo>^</mo></mover></math>  <br/>Torque, <math><mi>τ</mi><mo>=</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>×</mo><mover accent=\"true\"><mrow><mi>F</mi></mrow><mo>→</mo></mover></math>  <br/><math><mi>τ</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>0</mn></mrow></msub><mtext>+</mtext><mtext> </mtext><mi mathvariant=\"normal\">a</mi></mrow></mfenced><mtext> </mtext><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">i</mi></mrow><mo>^</mo></mover><mo>+</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>0</mn></mrow></msub><mtext> </mtext><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">j</mi></mrow><mo>^</mo></mover></mrow></mfenced><mo>×</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mi mathvariant=\"normal\">a</mi><mtext> </mtext><msubsup><mrow><mi mathvariant=\"normal\">ω</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn