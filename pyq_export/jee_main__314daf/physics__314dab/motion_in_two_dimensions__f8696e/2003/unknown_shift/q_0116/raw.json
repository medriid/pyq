  "question": {
    "text": "Two stones are projected from the top of a cliff $\\mathrm{h}$ metres high, with the same speed $\\mathrm{u}$, so as to hit the ground at the same spot. If one of the stones is projected at an angle $\\theta$ to the horizontal then the $\\theta$ equals",
    "image": null
  },
  "options": [
    {
      "id": "7U9uM",
      "text": "\n$\\mathrm{u} \\sqrt{\\frac{2}{\\mathrm{gh}}}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "S1IWV",
      "text": "\n$\\sqrt{\\frac{2 \\mathrm{u}}{\\mathrm{gh}}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "K1q1e",
      "text": "\n$2 \\mathrm{~g} \\sqrt{\\frac{\\mathrm{u}}{\\mathrm{h}}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "q0Zyy",
      "text": "\n$2 \\mathrm{~h} \\sqrt{\\frac{\\mathrm{u}}{\\mathrm{g}}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{R}=\\mathrm{u} \\sqrt{\\frac{2 \\mathrm{~h}}{\\mathrm{~g}}}=(\\mathrm{u} \\cos \\theta) \\times \\mathrm{t}$\n$t=\\frac{1}{\\cos \\theta} \\sqrt{\\frac{2 h}{g}}$",
    "image": null
  },
