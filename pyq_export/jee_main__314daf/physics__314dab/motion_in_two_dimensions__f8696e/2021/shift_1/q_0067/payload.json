  "question": {
    "text": "A helicopter is flying horizontally with a speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> at an altitude <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math>&nbsp;has to drop a food packet for a man on the ground. What is the distance of helicopter from the man when the food packet is dropped ?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><mn>2</mn><mi>g</mi><mi>h</mi><msup><mi>v</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><msup><mrow><mo>&#160;</mo><mi>h</mi></mrow><mn>2</mn></msup></mfrac></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>2</mn><mi>g</mi><mi>h</mi><msup><mi>v</mi><mn>2</mn></msup><mo>+</mo><msup><mi>h</mi><mn>2</mn></msup></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><mn>2</mn><mi>g</mi><mi>h</mi></mrow><msup><mi>v</mi><mn>2</mn></msup></mfrac></msqrt><mo>+</mo><msup><mi>h</mi><mn>2</mn></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><mn>2</mn><msup><mi>v</mi><mn>2</mn></msup><mo>&#160;</mo><mi>h</mi></mrow><mrow><mo>&#160;</mo><mi>g</mi></mrow></mfrac><mo>+</mo><msup><mi>h</mi><mn>2</mn></msup></msqrt></math>",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
