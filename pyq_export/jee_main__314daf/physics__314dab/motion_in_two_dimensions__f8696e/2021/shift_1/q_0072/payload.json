  "solution": {
    "text": "<p><img src=\"assets\\st0072_1b958adcc71d.png\" style=\"width: 350px; height: 226px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>V</mi><mo>&#8594;</mo></mover><mi>BW</mi></msub><mo>=</mo><mn>4</mn><msqrt><mn>2</mn></msqrt><mi>cos</mi><mn>4</mn><mpadded lspace=\"+2px\"><mn>5</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>4</mn><msqrt><mn>2</mn></msqrt><mi>sin</mi><mn>4</mn></mpadded><mn>5</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>4</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>4</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>V</mi><mo>&#8594;</mo></mover><mi mathvariant=\"normal\">w</mi></msub><mo>=</mo><mo>-</mo><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>V</mi><mo>&#8594;</mo></mover><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><msub><mover><mi>V</mi><mo>&#8594;</mo></mover><mi>BW</mi></msub><mo>+</mo><msub><mover><mi>V</mi><mo>&#8594;</mo></mover><mi mathvariant=\"normal\">w</mi></msub><mo>=</mo><mn>4</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>S</mi><mo>&#8594;</mo></mover><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><msub><mover><mi>V</mi><mo>&#8594;</mo></mover><mi mathvariant=\"normal\">B</mi></msub><mo>&#215;</mo><mi>t</mi><mo>=</mo><mo>(</mo><mn>4</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>)</mo><mo>&#215;</mo><mn>3</mn><mo>=</mo><mn>12</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</