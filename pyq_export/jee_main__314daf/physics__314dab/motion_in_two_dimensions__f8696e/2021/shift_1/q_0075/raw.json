  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1ecf8d3a-8c26-4f44-904c-852c9ad4f66d-image.png\" style=\"width: 325px; height: 254px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>k</mi><msup><mi>x</mi><mn>2</mn></msup><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>K</mi><msup><mi>x</mi><mn>2</mn></msup><mo>=</mo><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><mi>x</mi><msqrt><mfrac><mi>k</mi><mi>m</mi></mfrac></msqrt><mo>=</mo><mn>0</mn><mo>.</mo><mn>05</mn><msqrt><mfrac><mn>100</mn><mrow><mn>0</mn><mo>.</mo><mn>1</mn></mrow></mfrac></msqrt><mo>=</mo><mn>0</mn><mo>.</mo><mn>05</mn><mo>&#215;</mo><mn>10</mn><msqrt><mn>10</mn></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>5</mn><msqrt><mn>10</mn></msqrt></math><br />From <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>g</mi><msup><mi>t</mi><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><msqrt><mfrac><mrow><mn>2</mn><mo>&#160;</mo><mi>h</mi></mrow><mrow><mo>&#160;</mo><mi>g</mi></mrow></mfrac></msqrt><mo>=</mo><msqrt><mfrac><mrow><mn>2</mn><mo>&#215;</mo><mn>2</mn></mrow><mn>10</mn></mfrac></msqrt><mo>=</mo><mfrac><mn>2</mn><msqrt><mn>10</mn></msqrt></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mi>d</mi><mo>=</mo><mi>v</mi><mi>t</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>5</mn><msqrt><mn>10</mn></msqrt><mo>&#215;</mo><mfrac><mn>2</mn><msqrt><mn>10</mn></msqrt></mfrac><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math></p>",
