  "question": {
    "text": "A body of mass $M$ thrown horizontally with velocity $v$ from the top of the tower of height $H$ touches the ground at a distance of $100 \\mathrm{~m}$ from the foot of the tower. A body of mass $2 \\mathrm{M}$ thrown at a velocity $\\frac{v}{2}$ from the top of the tower of height $4 \\mathrm{H}$ will touch the ground at a distance of _____$\\mathrm{m}$.",
    "image": null
  },
  "options": [],
  "correctValue": "100",
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/CnWm0-dk3fdZTxApbN8gTL6Yy8uvvVz27z9vs1wM8oo.original.fullsize.png\"><br />$\\begin{aligned} & 100=v \\sqrt{\\frac{2 \\mathrm{H}}{\\mathrm{g}}} ; \\quad \\mathrm{x}=\\frac{v}{2} \\sqrt{\\frac{2(4 \\mathrm{H})}{\\mathrm{g}}}=v \\sqrt{\\frac{2 \\mathrm{H}}{\\mathrm{g}}} \\\\ & \\Rightarrow \\mathrm{x}=100\\end{aligned}$",
    "image": null
  },
