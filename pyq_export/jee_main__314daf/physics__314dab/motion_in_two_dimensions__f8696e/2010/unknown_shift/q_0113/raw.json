  "question": {
    "text": "A particle is moving with velocity $\\overrightarrow{\\mathrm{v}}=\\mathrm{K}(\\mathrm{y} \\hat{\\mathrm{i}}+\\mathrm{x} \\hat{\\mathrm{j}})$, where $\\mathrm{K}$ is a constant. The general equation for its path is",
    "image": null
  },
  "options": [
    {
      "id": "wwW9R",
      "text": "\n$y=x^2+$ constant\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8FaCB",
      "text": "\n$y^2=x+$ constant\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lLKwv",
      "text": "\n$x y=$ constant\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1JaSp",
      "text": "\n$y^2=x^2+$ constant",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\vec{v}=K y \\hat{i}+K x \\hat{j}$\n$\\frac{d x}{d t}=K y, \\quad \\frac{d y}{d t}=K x$\n$\\frac{d y}{d x}=\\frac{d y}{d t} \\times \\frac{d t}{d x}=\\frac{K x}{K y}$\n$y d y=x d x$\n$y^2=x^2+c$",
    "image": null
  },
