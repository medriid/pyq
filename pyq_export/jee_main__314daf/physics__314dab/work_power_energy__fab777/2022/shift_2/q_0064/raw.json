  "question": {
    "text": "If momentum of a body is increased by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>%</mo></math>, then its kinetic energy increases by :",
    "image": null
  },
  "options": [
    {
      "id": "NpOTb",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn><mo>%</mo></math>",
