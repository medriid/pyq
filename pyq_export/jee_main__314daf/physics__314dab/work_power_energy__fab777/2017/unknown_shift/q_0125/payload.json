  "solution": {
    "text": "After <math> <mrow> <mn>10</mn><mtext>&#8196;</mtext><mtext>sec,</mtext></mrow> </math> <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>8</mn></mrow></mfrac><mi>m</mi><msubsup><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>v</mi><mo>=</mo><mfrac><msub><mi>v</mi><mn>0</mn></msub><mn>2</mn></mfrac><mo>=</mo><mn>5</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br />Acceleration,&nbsp;<math> <mrow> <mi>a</mi><mo>=</mo><mo>&#8722;</mo><mfrac> <mrow> <mi>k</mi><msup> <mi>v</mi> <mn>2</mn> </msup> </mrow> <mi>m</mi> </mfrac> </mrow> </math><br /><math> <mrow> <mo>&#8658;</mo><mo>&#160;</mo><mfrac> <mrow> <mi>d</mi><mi>v</mi></mrow> <mrow> <mi>d</mi><mi>t</mi></mrow> </mfrac> <mo>=</mo><mo>&#8722;</mo><mfrac> <mrow> <mi>k</mi><msup> <mi>v</mi> <mn>2</mn> </msup> </mrow> <mi>m</mi> </mfrac> </mrow> </math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;</mo><munderover><mo>&#8747;</mo><mn>10</mn><mn>5</mn></munderover><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><msup><mi>v</mi><mn>2</mn></msup></mfrac><mo>=</mo><mo>&#8722;</mo><mfrac><mi>k</mi><mi>m</mi></mfrac><mo>&#160;</mo><munderover><mo>&#8747;</mo><mn>0</mn><mn>10</mn></munderover><mi>d</mi><mi>t</mi></math><br /><math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>10</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mi>k</mi></mrow><mrow><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow></mfrac><mo>&#215;</mo><mn>10</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><msup><mn>10</mn