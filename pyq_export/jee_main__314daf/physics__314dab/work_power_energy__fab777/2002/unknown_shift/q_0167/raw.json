  "question": {
    "text": "A spring of force constant $800 \\mathrm{~N} / \\mathrm{m}$ has an extension of $5 \\mathrm{~cm}$. The work done is extending it from $5 \\mathrm{~cm}$ to $15 \\mathrm{~cm}$ is",
    "image": null
  },
  "options": [
    {
      "id": "x9eGY",
      "text": "\n$16 \\mathrm{~J}$\noption 1 goes here\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "EgCZu",
      "text": "\n$8 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "we5aR",
      "text": "\n$32 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1OBA8",
      "text": "\n$24 \\mathrm{~J}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{W}=\\int_{x_1}^{x_2} F d x=\\int_{x_1}^{x_2} K x d x=K\\left[\\frac{x^2}{2}\\right]_{x_1}^{x_2}=\\frac{K}{2}\\left[x_2^2-x_1^2\\right]=\\frac{800}{2}\\left[(0.15)^2-(0.05)^2\\right]=8 \\mathrm{~J}$",
    "image": null
  },
