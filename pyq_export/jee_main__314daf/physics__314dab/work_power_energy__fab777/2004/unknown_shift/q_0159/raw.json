  "question": {
    "text": "A force $\\vec{F}=(5 \\hat{i}+3 \\hat{j}+2 \\hat{k}) N$ is applied over a particle which displaces it from its origin to the point $\\vec{r}=(2 \\hat{i}-\\hat{j}) m$. The work done on the particle in joules is",
    "image": null
  },
  "options": [
    {
      "id": "MRcUG",
      "text": "\n$-7$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UFf5r",
      "text": "\n$+7$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fXBdE",
      "text": "\n$+10$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eexjq",
      "text": "\n$+13$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Work done, W $=\\overrightarrow{\\mathrm{F}} \\cdot \\overrightarrow{\\mathrm{s}}$\nHere $\\vec{s}=\\vec{r}_f-\\vec{r}_i=(2 \\hat{i}-\\hat{j})$\n$$\nW=(5 \\hat{i}+3 \\hat{j}+2 \\hat{k})(2 \\hat{i}-\\hat{j})=10-3=7 \\mathrm{~J}\n$$",
    "image": null
  },
