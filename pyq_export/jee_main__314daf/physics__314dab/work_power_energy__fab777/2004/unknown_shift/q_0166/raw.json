  "question": {
    "text": "A uniform chain of length $2 \\mathrm{~m}$ is kept on a table such that a length of $60 \\mathrm{~cm}$ hangs freely from the edge of the table. The total mass of the chain is $4 \\mathrm{~kg}$. What is the work done in pulling the entire chain on the table?",
    "image": null
  },
  "options": [
