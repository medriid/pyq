  "question": {
    "text": "A body of mass $m$, accelerates uniformly from rest to $v_1$ in time $t_1$. The instantaneous power delivered to the body as a function of time $t$ is",
    "image": null
  },
  "options": [
    {
      "id": "QL8mt",
      "text": "\n$\\frac{\\mathrm{mv}_1 \\mathrm{t}}{\\mathrm{t}_1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W48Yd",
      "text": "\n$\\frac{\\mathrm{mv}_1^2 \\mathrm{t}}{\\mathrm{t}_1^2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jrWsP",
      "text": "\n$\\frac{m v_1 t^2}{t_1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zGcSK",
      "text": "\n$\\frac{m v_1^2 t}{t_1}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Power $P=\\vec{F} \\cdot \\vec{v}=\\operatorname{mav}=m\\left(\\frac{v_1}{t_1}\\right)\\left(\\frac{v_1}{t_1} t\\right)=\\frac{m_1^2 t}{t_1^2}$",
    "image": null
  },
