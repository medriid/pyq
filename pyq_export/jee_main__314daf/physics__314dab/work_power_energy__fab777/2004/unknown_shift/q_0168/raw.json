  "question": {
    "text": "A particle moves in a straight line with retardation proportional to its displacement. Its loss of kinetic energy for any displacement $\\mathrm{x}$ is proportional to",
    "image": null
  },
  "options": [
    {
      "id": "ewDff",
      "text": "\n$x^3$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9CfDn",
      "text": "\n$e^x$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RE3WU",
      "text": "\n$x$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pgboF",
      "text": "\n$\\log _e x$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{K}_{\\mathrm{f}}-\\mathrm{K}_{\\mathrm{i}}=\\frac{\\mathrm{mk}}{2} \\mathrm{x}^2$\n$\\mathrm{~K}_{\\mathrm{f}}-\\mathrm{K}_{\\mathrm{i}} \\propto \\mathrm{x}^2$",
    "image": null
  },
