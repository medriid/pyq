  "question": {
    "text": "An athlete in the olympic games covers a distance of $100 \\mathrm{~m}$ in $10 \\mathrm{~s}$. His kinetic energy can be estimated to be in the range",
    "image": null
  },
  "options": [
    {
      "id": "kKvai",
      "text": "\n$200 \\mathrm{~J}-500 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3M2v6",
      "text": "\n$2 \\times 10^5 \\mathrm{~J}-3 \\times 10^5 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rXb1W",
      "text": "\n$20,000 \\mathrm{~J}-50,000 \\mathrm{~J}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fA05k",
      "text": "\n$2,000 \\mathrm{~J}-5,000 \\mathrm{~J}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Approximate mass $=60 \\mathrm{~kg}$\nApproximate velocity $=10 \\mathrm{~m} / \\mathrm{s}$\nApproximate $\\mathrm{KE}=\\frac{1}{2} \\times 60 \\times 100=3000 \\mathrm{~J}$\n$\\mathrm{KE}$ range $\\Rightarrow 2000$ to 5000 joule",
    "image": null
  },
