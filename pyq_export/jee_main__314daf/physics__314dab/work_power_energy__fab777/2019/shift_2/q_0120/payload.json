  "question": {
    "text": "A wedge of mass <math><mi>M</mi><mo>=</mo><mn>4</mn><mi>m</mi></math> lies on a frictionless plane. A particle of mass <math><mi>m</mi></math> approaches the wedge with speed <math><mi>v</mi><mo>.</mo></math> There is no friction between the particle and the plane or between the particle and the wedge. The maximum height climbed by the particle on the wedge is given by:"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>g</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi>g</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>2</mn><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>5</mn><mi>g</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>2</mn><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>7</mn><mi>g</mi></mrow></mfrac></math>",
      "is_correct": false
    }
  ],
