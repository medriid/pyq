    "C"
  ],
  "solution": {
    "text": "From conservation of linear momentum, <br/><img src=\"assets\\st0120_9d66df8082ad.png\"> <br/><math><mi>m</mi><mi>v</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mi>m</mi><mo>+</mo><mi>m</mi></mrow></mfenced><msub><mrow><mi>v</mi></mrow><mrow><mi>f</mi></mrow></msub></math>  <br/><math><msub><mrow><mi>v</mi></mrow><mrow><mi>f</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>v</mi></mrow><mrow><mn>5</mn></mrow></mfrac></math>  <br/>From conservation of mechanical energy, <br/><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>4</mn><mi>m</mi><mo>+</mo><mi>m</mi></mrow></mfenced><msubsup><mrow><mi>v</mi></mrow><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><mi>m</mi><mi>g</mi><mi>h</mi></math>  <br/><math><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>5</mn><msubsup><mrow><mi>v</mi></mrow><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><mn>2</mn><mi>g</mi><mi>h</mi></math>  <br/><math><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>5</mn><mo>×</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>v</mi></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>g</mi><mi>h</mi></math>  <br/><math><mi>h</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>5</mn><mi>g</mi></mrow></mfrac></math>"
  }
