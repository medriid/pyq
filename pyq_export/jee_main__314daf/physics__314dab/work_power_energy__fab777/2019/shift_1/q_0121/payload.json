    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><mi>M</mi><mi>g</mi><mi>L</mi></mrow><msup><mi>n</mi><mn>2</mn></msup></mfrac></math>",
