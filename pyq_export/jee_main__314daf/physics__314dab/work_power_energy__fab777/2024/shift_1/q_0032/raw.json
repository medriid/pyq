  "question": {
    "text": "If a rubber ball falls from a height $h$ and rebounds upto the height of $h / 2$. The percentage loss of total energy of the initial system as well as velocity ball before it strikes the ground, respectively, are :",
    "image": null
  },
  "options": [
    {
      "id": "qsbgh",
      "text": "$50 \\%, \\sqrt{2 \\mathrm{gh}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UqAam",
      "text": "$50 \\%, \\sqrt{\\mathrm{gh}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dmunj",
      "text": "$40 \\%, \\sqrt{2 \\mathrm{gh}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OFMxa",
      "text": "$50 \\%, \\sqrt{\\frac{\\mathrm{gh}}{2}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\text { Velocity just before collision }=\\sqrt{2 \\mathrm{gh}} \\\\\n& \\text { Velocity just after collision }=\\sqrt{2 \\mathrm{~g}\\left(\\frac{\\mathrm{h}}{2}\\right)} \\\\\n& \\therefore \\Delta \\mathrm{KE}=\\frac{1}{2} \\mathrm{~m}(2 \\mathrm{gh})-\\frac{1}{2} \\mathrm{mgh} \\\\\n& =\\frac{1}{2} \\mathrm{mgh} \\\\\n& \\therefore \\% \\text { loss in energy } \\\\\n& =\\frac{\\Delta \\mathrm{KE}}{\\mathrm{KE}_{\\mathrm{i}}} \\times 100=\\frac{\\frac{1}{2} \\mathrm{mgh}}{\\frac{1}{2} \\mathrm{mg} 2 \\mathrm{~h}} \\times 100=50 \\%\n\\end{aligned}$",
    "image": null
  },
