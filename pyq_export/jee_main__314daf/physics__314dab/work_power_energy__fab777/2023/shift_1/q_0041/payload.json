      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>500</mn><mo>&#177;</mo><mn>140</mn><mo>)</mo><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "is_correct": false
