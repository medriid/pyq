  "question": {
    "text": "<p>A body of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>5</mn><mo>&#177;</mo><mn>0</mn><mo>.</mo><mn>5</mn><mo>)</mo><mo>&#160;</mo><mi>kg</mi></math> is moving with a velocity&nbsp;of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>20</mn><mo>&#177;</mo><mn>0</mn><mo>.</mo><mn>4</mn><mo>)</mo><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>.</mo></math> Its kinetic energy will be</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1000</mn><mo>&#177;</mo><mn>0</mn><mo>.</mo><mn>14</mn><mo>)</mo><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math>",
      "is_correct": false
