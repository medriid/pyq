  "question": {
    "text": "A spring of spring constant $5 \\times 10^3 \\mathrm{~N} / \\mathrm{m}$ is stretched initially by $5 \\mathrm{~cm}$ from the unstretched position. Then the work required to stretch it further by another $5 \\mathrm{~cm}$ is"
  },
  "options": [
    {
      "text": "\n$12.50 \\mathrm{~N}-\\mathrm{m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$18.75 \\mathrm{~N}-\\mathrm{m}$\n",
      "is_correct": true
    },
    {
      "text": "\n$25.00 \\mathrm{~N}-\\mathrm{m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$6.25 \\mathrm{~N}-\\mathrm{m}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Required work done\n$=\\frac{1}{2} \\mathrm{~K}\\left(\\mathrm{x}_2^2-\\mathrm{x}_1^2\\right)=\\frac{1}{2} \\times 5 \\times 10^3\\left[10^2-5^2\\right] \\times 10^{-4}$\n$=\\frac{1}{2} \\times 5 \\times 75 \\times 10^3 \\times 10^{-4}=18.75$"
  }
}