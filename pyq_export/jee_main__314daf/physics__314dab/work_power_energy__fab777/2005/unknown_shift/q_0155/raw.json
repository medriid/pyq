  "question": {
    "text": "An annular ring with inner and outer radii $R_1$ and $R_2$ is rolling without slipping with a uniform angular speed. The ratio of the forces experienced by the two particles situated on the inner and outer parts of the ring, $F_1 / F_2$ is",
    "image": null
  },
  "options": [
    {
      "id": "0KvjQ",
      "text": "\n$\\frac{\\mathrm{R}_2}{\\mathrm{R}_1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mk8vO",
      "text": "\n$\\left(\\frac{\\mathrm{R}_1}{\\mathrm{R}_2}\\right)^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "c5obe",
      "text": "\n1\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "D80uI",
      "text": "\n$\\frac{\\mathrm{R}_1}{\\mathrm{R}_2}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\mathrm{F}_1}{\\mathrm{~F}_2}=\\frac{\\mathrm{R}_1 \\omega^2}{\\mathrm{R}_2 \\omega^2}=\\frac{\\mathrm{R}_1}{\\mathrm{R}_2}$",
    "image": null
  },
