  "question": {
    "text": "A body of mass $m$ is accelerated uniformly from rest to a speed $v$ in a time $T$. The instantaneous power delivered to the body as a function time is given by"
  },
  "options": [
    {
      "text": "\n$\\frac{\\mathrm{mv}^2}{\\mathrm{~T}^2} \\cdot \\mathrm{t}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{m v^2}{T^2} \\cdot t^2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{2} \\frac{\\mathrm{mv}^2}{\\mathrm{~T}^2} \\cdot \\mathrm{t}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{2} \\frac{\\mathrm{mv}^2}{\\mathrm{~T}^2} \\cdot \\mathrm{t}^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{P}=(\\mathrm{ma}) \\cdot \\mathrm{v}$\n$=m a^2 t$\n$=m \\frac{V^2}{T^2} t$"
  }
