  "question": {
    "text": "A spherical ball of mass $20 \\mathrm{~kg}$ is stationary at the top of a hill of height $100 \\mathrm{~m}$. It rolls down a smooth surface to the ground, then climbs up another hill of height $30 \\mathrm{~m}$ and finally rolls down to a horizontal base at a height of $20 \\mathrm{~m}$ above the ground. The velocity attained by the ball is"
  },
  "options": [
    {
      "text": "\n$40 \\mathrm{~m} / \\mathrm{s}$\n",
      "is_correct": true
    },
    {
      "text": "\n$20 \\mathrm{~m} / \\mathrm{s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$10 \\mathrm{~m} / \\mathrm{s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$10 \\sqrt{30} \\mathrm{~m} / \\mathrm{s}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{mgh}=1 / 2 \\mathrm{mv}^2$\n$\\mathrm{v}=\\sqrt{2 \\mathrm{gh}}$\n$=\\sqrt{2 \\times 10 \\times 80}=40 \\mathrm{~m} / \\mathrm{s}$"
  }
}