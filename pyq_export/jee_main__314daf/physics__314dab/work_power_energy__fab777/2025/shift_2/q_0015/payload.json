  "question": {
    "text": "A force $\\overrightarrow{\\mathrm{F}}=2 \\hat{i}+\\mathrm{b} \\hat{j}+\\hat{k}$ is applied on a particle and it undergoes a displacement $\\hat{i}-2 \\hat{j}-\\hat{k}$. What will be the value of $b$, if work done on the particle is zero."
  },
  "options": [
    {
      "text": "0",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": true
    },
    {
      "text": "2",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & w=0 \\\\ & \\therefore \\quad \\vec{F} \\cdot S=0 \\\\ & (2 \\hat{i}+b \\hat{j}+\\hat{k}) \\cdot(\\hat{i}-2 \\hat{j}-\\hat{k})=0 \\\\ & 2-2 b-1=0 \\\\ & b=\\frac{1}{2}\\end{aligned}$"
  }
}