  "question": {
    "text": "A body of mass ' \\(m\\) ' connected to a massless and unstretchable string goes in verticle circle of radius ' \\(R\\) 'under gravity \\(g\\). The other end of the string is fixed at the center of circle. If velocity at top of circular path is \\(n \\sqrt{g R}\\), where, \\(n \\geqslant 1\\), then ratio of kinetic energy of the body at bottom to that at top of the circle is",
    "image": null
  },
  "options": [
    {
      "id": "zfX2H",
      "text": "\\(\\frac{n^2}{n^2+4}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "C8mVb",
      "text": "\\(\\frac{n^2+4}{n^2}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "aLh4A",
      "text": "\\(\\frac{n+4}{n}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xdG1o",
      "text": "\\(\\frac{n}{n+4}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5gANTm719Psh3x7WpIkZIB3lqxm6kpjaozDeKZdBug8.original.fullsize.png\"><br>\n$\\begin{aligned} & v_0=\\sqrt{v^2+2 g(2 R)} \\\\ & v_0=\\sqrt{n^2 g R+4 g R} \\\\ & \\therefore \\quad \\frac{k_{\\text {bottom }}}{k_{\\text {top }}}=\\frac{v_0^2}{v^2}=\\frac{n^2+4}{n^2}\\end{aligned}$",
    "image": null
  },
