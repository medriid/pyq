  "question": {
    "text": "A particle is released from height $S$ above the surface of the earth. At certain height its kinetic energy is three times its potential energy. The height from the surface of the earth and the speed of the particle at that instant are respectively.",
    "image": null
  },
  "options": [
    {
      "id": "xC8hH",
      "text": "$\\frac{\\mathrm{S}}{2}, \\sqrt{\\frac{3 \\mathrm{gS}}{2}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LIcWU",
      "text": "$\\frac{\\mathrm{S}}{2}, \\frac{3 \\mathrm{gS}}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uWTX7",
      "text": "$\\frac{\\mathrm{S}}{4}, \\frac{3 \\mathrm{gS}}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FPIrd",
      "text": "$\\frac{\\mathrm{S}}{4}, \\sqrt{\\frac{3 \\mathrm{gS}}{2}}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\mathrm{V}^2=0+2 \\mathrm{~g}(\\mathrm{~S}-\\mathrm{x}) \\\\\n& \\mathrm{V}^2=2 \\mathrm{~g}(\\mathrm{~S}-\\mathrm{x})<br/>\\end{aligned}$<br/>At B, Potential energy $=m g x$<br/>$\\begin{aligned}<br/>& \\mathrm{mgx}=3 \\times \\frac{1}{2} \\mathrm{mv}^2 \\\\\n& \\mathrm{gx}=\\frac{3}{2} \\times 2 \\mathrm{~g}(\\mathrm{~S}-\\mathrm{x}) \\\\\n& 4 \\mathrm{x}=\\mathrm{S} \\\\\n& \\mathrm{x}=\\frac{\\mathrm{S}}{4}<br/>\\end{aligned}$<br/>$\\Rightarrow \\mathrm{V}=\\sqrt{2 \\mathrm{~g} \\times \\frac{3 \\mathrm{~S}}{4}}=\\sqrt{\\frac{3 \\mathrm{gS}}{2}}$",
    "image": null
  },
