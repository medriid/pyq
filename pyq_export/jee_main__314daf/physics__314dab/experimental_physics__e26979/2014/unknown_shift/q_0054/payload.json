  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi><msqrt><mfrac><mi>L</mi><mi>g</mi></mfrac></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mi>g</mi><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup><mi>L</mi></mrow><msup><mi>T</mi><mn>2</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>T</mi><mn>2</mn></msup><mi>L</mi></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mi>&#960;</mi><mn>2</mn></msup></mrow><mi>g</mi></mfrac><mo>=</mo><mi>tan&#952;</mi><mo>=</mo></math>slope of graph</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;&#160;&#160;</mo><mo>&#160;</mo><mi>g</mi><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></mrow><mi>tan&#952;</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8757;</mo><mo>&#160;</mo><mo>&#160;</mo><mi>tan&#952;</mi><mo>=</mo><mfrac><mrow><mn>8</mn><mo>&#8722;</mo><mn>2</mn></mrow><mtable columnalign=\"left\"><mtr><mtd><mn>2</mn><mo>&#8722;</mo><mn>0.5</mn></mtd></mtr></mtable></mfrac></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>6</mn><mn>1.5</mn></mfrac><mo>=</mo><mn>4</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mi>g</mi><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mo>=</mo><msup><mrow><mo>(</mo><mn>3.14</mn><mo>)</mo></mrow><mn>2</mn></msup></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup><mo>=</mo><msup><mfenced><mrow><mn>3</mn><mo>.</mo><mn>1</mn><mn>4</mn></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mn>9</