  "question": {
    "text": "A screw gauge gives the following reading when used to measure the diameter of a wire.\nMain scale reading : $0 \\mathrm{~mm}$\nCircular scale reading : 52 divisions\nGiven that $1 \\mathrm{~mm}$ on main scale corresponds to 100 divisions of the circular scale.\nThe diameter of wire from the above date is :"
  },
  "options": [
    {
      "text": "\n$0.052 \\mathrm{~cm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$0.026 \\mathrm{~cm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.005 \\mathrm{~cm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.52 \\mathrm{~cm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Diameter of wire $=\\frac{1}{100} \\times 52=0.52 \\mathrm{~mm}=0.052 \\mathrm{~cm}$"
  }
}