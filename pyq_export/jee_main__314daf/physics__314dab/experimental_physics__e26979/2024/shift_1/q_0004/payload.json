  "question": {
    "text": "One main scale division of a vernier caliper is equal to $m$ units. If $\\mathrm{n}^{\\text {th }}$ division of main scale coincides with $(n+1)^{\\text {th }}$ division of vernier scale, the least count of the vernier caliper is :"
  },
  "options": [
    {
      "text": "$\\frac{n}{(n+1)}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{(n+1)}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{m}{(n+1)}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{m}{n(n+1)}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{n} M S D=(\\mathrm{n}+1) \\mathrm{VSD} \\\\ & \\Rightarrow 1 \\mathrm{VSD}=\\frac{\\mathrm{n}}{\\mathrm{n}+1} \\mathrm{MSD} \\\\ & \\mathrm{L} \\cdot \\mathrm{C}=1 \\mathrm{MSD}-1 \\mathrm{VSD} \\\\ & \\mathrm{L} \\cdot \\mathrm{C}=\\mathrm{m}-\\mathrm{m}\\left(\\frac{\\mathrm{n}}{\\mathrm{n}+1}\\right) \\\\ & \\mathrm{L} \\cdot \\mathrm{C}=\\mathrm{m}\\left(\\frac{\\mathrm{n}+1-\\mathrm{n}}{\\mathrm{n}+1}\\right) \\\\ & \\Rightarrow \\mathrm{L} \\cdot \\mathrm{C}=\\left(\\frac{\\mathrm{m}}{\\mathrm{n}+1}\\right)\\end{aligned}$"
  }
}