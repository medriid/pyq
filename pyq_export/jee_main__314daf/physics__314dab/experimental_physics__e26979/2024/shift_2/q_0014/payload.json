  "question": {
    "text": "A vernier callipers has 20 divisions on the vernier scale, which coincides with $19^{\\text {th }}$ division on the main scale. The least count of the instrument is $0.1 \\mathrm{~mm}$. One main scale division is equal to _____$\\mathrm{mm}$."
  },
  "options": [
    {
      "text": "$0.5$",
      "is_correct": false
    },
    {
      "text": "$2$",
      "is_correct": true
    },
    {
      "text": "$5$",
      "is_correct": false
    },
    {
      "text": "$1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & 20 \\mathrm{VSD}=19 \\mathrm{MSD} \\\\ & 1 \\mathrm{VSD}=\\frac{19}{20} \\mathrm{MSD} \\\\ & \\text { L.C. }=1 \\mathrm{MSD}-1 \\mathrm{VSD} \\\\ & 0.1 \\mathrm{~mm}=1 \\mathrm{MSD}-\\frac{19}{20} \\mathrm{MSD} \\\\ & 0.1=\\frac{1}{20} \\mathrm{MSD} \\\\ & 1 \\mathrm{MSD}=2 \\mathrm{~mm}\\end{aligned}$"
  }
}