    },
    {
      "id": "prB8g",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>5</mn><mo>.5375</mo><mo>&#177;</mo><mn>0</mn><mo>.0740</mo></mrow></mfenced><mi>mm</mi></math>",
      "isCorrect": false,
