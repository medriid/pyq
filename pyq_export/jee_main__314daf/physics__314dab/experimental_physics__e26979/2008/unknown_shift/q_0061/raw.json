  "question": {
    "text": "Two full turns of the circular scale of a screw gauge cover a distance of $1 \\mathrm{~mm}$ on its main scale. The total number of divisions on the circular scale is 50 . Further, it is found that the screw gauge has a zero error of $-0.03 \\mathrm{~mm}$ while measuring the diameter of a thin wire, a student notes the main scale reading of $3 \\mathrm{~mm}$ and the number of circular scale divisions in line with the main scale as 35 . The diameter of the wire is",
    "image": null
  },
  "options": [
    {
      "id": "8wV23",
      "text": "\n$3.32 \\mathrm{~mm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rPkLd",
      "text": "\n$3.73 \\mathrm{~mm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dgA23",
      "text": "\n$3.67 \\mathrm{~mm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RiSDe",
      "text": "\n$3.38 \\mathrm{~mm}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Diameter $=$ M.S.R. $+$ C.S.R $\\times$ L.C. $+$ Z.E. $=3+35 \\times(0.5 / 50)+0.03=3.38 \\mathrm{~mm}$",
    "image": null
  },
