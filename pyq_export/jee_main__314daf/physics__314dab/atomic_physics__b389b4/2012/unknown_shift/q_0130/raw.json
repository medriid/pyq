      "id": "mh3IO",
      "text": "\n$D$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nkmUE",
      "text": "\n$B$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dZdN1",
