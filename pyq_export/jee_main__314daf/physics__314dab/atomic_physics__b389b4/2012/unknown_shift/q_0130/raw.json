  "question": {
    "text": "In the Rutherford experiment, $\\alpha$-particles are scattered from a nucleus as shown. Out of the four paths, which path is not possible?\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1YmEoYT18xLjWJb-OXGayewLVpSdx1B88IKO4KftYJs.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
