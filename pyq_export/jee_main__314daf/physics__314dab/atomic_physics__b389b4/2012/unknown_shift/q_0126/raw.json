  "question": {
    "text": "Which of the plots shown in the figure represents speed $(v)$ of the electron in a hydrogen atom as a function of the principal quantum number $(n)$ ?\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/OaH0usmTrcwNDMujlOSzcgLX5flVfN_Hw23otcZLR5U.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "MHKeB",
      "text": "\n$B$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5ufey",
      "text": "\n$D$\n",
      "image": null,
      "isCorrect": false
    },
    {
