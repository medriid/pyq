  "question": {
    "text": "Hydrogen atom is excited from ground state to another state with principal quantum number equal to $4$. Then the number of spectral lines in the emission spectra will be"
  },
  "options": [
    {
      "text": "\n$2$\n",
      "is_correct": false
    },
    {
      "text": "\n$3$\n",
      "is_correct": false
    },
    {
      "text": "\n$5$\n",
      "is_correct": false
    },
    {
      "text": "\n$6$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Number of spectral lines from a state $\\mathrm{n}$ to ground state is\n$=\\frac{n(n-1)}{2}=6.$"
  }
}