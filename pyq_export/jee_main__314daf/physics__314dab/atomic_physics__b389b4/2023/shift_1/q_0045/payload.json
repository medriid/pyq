  "question": {
    "text": "<p>The energy levels of an hydrogen atom are shown below. The transition corresponding to emission of shortest wavelength is</p><p><img src=\"assets\\qt0045_d78f39a45c9f.png\" style=\"width: 300px; height: 247px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>",
      "is_correct": false
    },
