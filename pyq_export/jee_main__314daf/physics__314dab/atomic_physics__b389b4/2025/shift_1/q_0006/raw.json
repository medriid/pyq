  "question": {
    "text": "In a hydrogen like ion, the energy difference between the $2^{\\text {nd }}$ excitation energy state and ground is 108.8 eV. The atomic number of the ion is",
    "image": null
  },
  "options": [
    {
      "id": "QhxWk",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "r3ewy",
      "text": "2",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Qv4xr",
      "text": "1",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cTmiA",
      "text": "3",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\mathrm{E}=13.6 \\mathrm{z}^2\\left[\\frac{1}{\\mathrm{n}_1^2}-\\frac{1}{\\mathrm{n}_2^2}\\right]$<br/>$(13.6) \\mathrm{z}^2\\left[\\frac{1}{1}-\\frac{1}{9}\\right]=108.8$<br/>$\\frac{(13.6)(8)}{9}\\left(z^2\\right)=108.8$<br/>$\\mathrm{z}=3$",
    "image": null
  },
