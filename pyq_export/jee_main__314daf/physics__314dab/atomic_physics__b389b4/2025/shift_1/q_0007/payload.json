  "question": {
    "text": "Considering the Bohr model of hydrogen like atoms, the ratio of the ratio of the radius $5^{\\text {th }}$ orbit of the electron in $\\mathrm{Li}^{2+}$ and $\\mathrm{He}^{+}$is"
  },
  "options": [
    {
      "text": "$\\frac{3}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{4}{9}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{9}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2}{3}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{r}=\\mathrm{r} \\cdot \\frac{\\mathrm{n}^2}{2}$<br/>for $\\mathrm{Li}^{2+}$<br/>$r_5=r \\cdot \\frac{25}{3}$<br/>for $\\mathrm{He}^{+}$<br/>$\\begin{aligned}<br/>& \\mathrm{r}_5=\\mathrm{r} \\cdot \\frac{25}{2} \\\\\n& \\therefore \\frac{\\mathrm{r}_{\\mathrm{Li}^{2+}}}{\\mathrm{r}_{\\mathrm{He}^{+}}}=\\frac{2}{3}<br/>\\end{aligned}$"
  }
}