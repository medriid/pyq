  "question": {
    "text": "Assuming the validity of Bohr's atomic model for hydrogen like ions the radius of $\\mathrm{Li}^{++}$ion in its ground state is given by $\\frac{1}{X} a_0$, where $X=$ _______. (Where $\\mathrm{a}_0$ is the first Bohr's radius.)"
  },
  "options": [
    {
      "text": "2",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "3",
      "is_correct": true
    },
    {
      "text": "9",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{r}=\\mathrm{r}_0 \\frac{\\mathrm{n}^2}{\\mathrm{z}} \\& \\mathrm{z}=3$ for $\\mathrm{Li}^{+2}$ and $\\mathrm{n}=1$<br/>$\\therefore \\mathrm{r}=\\mathrm{r}_0 \\frac{1^2}{3}=\\frac{\\mathrm{r}_0}{3} \\quad \\therefore \\mathrm{x}=3$"
  }
}