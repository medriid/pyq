  "question": {
    "text": "The frequency of revolution of the electron in Bohr's orbit varies with $n$, the principal quantum number as"
  },
  "options": [
    {
      "text": "$\\frac{1}{n^4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{n^2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{\\mathrm{n}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{n^3}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & f=\\frac{v}{2 \\pi r}=\\left(\\frac{V_0}{n}\\right)\\left(\\frac{1}{2 \\pi r_0 n^2}\\right) \\\\ & f=\\frac{V_0}{2 \\pi r_0}=\\left(\\frac{1}{n^3}\\right)=f_0\\left(\\frac{1}{n^3}\\right)\\end{aligned}$"
  }
