  "question": {
    "text": "If $13.6 \\mathrm{eV}$ energy is required to ionize the hydrogen atom, then the energy required to remove an electron from $n=2$ is",
    "image": null
  },
  "options": [
    {
      "id": "F44sF",
      "text": "\n$10.2 \\mathrm{eV}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "syglx",
      "text": "\n$0 \\mathrm{eV}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "75Vqb",
      "text": "\n$3.4 \\mathrm{eV}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "T2icX",
      "text": "\n$6.8 \\mathrm{eV}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$E_n=-\\frac{13.6}{n^2} \\Rightarrow E_2=-\\frac{13.6}{2^2}=3.4 \\mathrm{eV}$",
    "image": null
  },
