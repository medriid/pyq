  "solution": {
    "text": "For&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>H</mi><mo>-</mo></math>atom&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></mrow><mi>r</mi></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mi>&#960;</mi><msub><mi>&#1013;</mi><mi>o</mi></msub></mrow></mfrac><mfrac><msup><mi>e</mi><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup></mfrac><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced separators=\"|\"><mn>1</mn></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mi>v</mi><mi>r</mi><mo>=</mo><mfrac><mi>h</mi><mrow><mn>2</mn><mi>&#960;</mi></mrow></mfrac><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced separators=\"|\"><mn>2</mn></mfenced></math><br /><br />On squaring&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>m</mi><mn>2</mn></msup><msup><mi>v</mi><mn>2</mn></msup><msup><mi>r</mi><mn>2</mn></msup><mo>=</mo><mfrac><msup><mi>h</mi><mn>2</mn></msup><mrow><mn>4</mn><msup><mi>&#960;</mi><mn>2</mn></msup></mrow></mfrac></math><br /><br />On dividing both sides by&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>r</mi><mn>3</mn></msup><mi>&#160;</mi><mo>,</mo></math><br /><br /><math><mfrac><mrow><msup><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>r</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>4</mn><mi>&#960;</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mi>&#160;</mi><mo>&#8658;</mo><menclose notation=\"box\"><mfrac