    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/159acf02-e6d9-495d-bb55-f3cf98c4a8db-image.png\" style=\"width: 289px; height: 139px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#8594;</mo><mn>2</mn><mo>&#8658;</mo><mn>1</mn><mo>.</mo><mn>89</mn><mo>&#160;</mo><mi>eV</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi><mo>&#160;&#160;</mo><mi>r</mi><mo>=</mo><mn>7</mn><mo>&#160;</mo><mi>mm</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mfrac><mrow><mi>m</mi><mi>v</mi></mrow><mrow><mi>q</mi><mi>B</mi></mrow></mfrac><mo>&#8658;</mo><mi>m</mi><mi>v</mi><mo>=</mo><mi>q</mi><mi>r</mi><mi>B</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>E</mi><mo>=</mo><mfrac><msup><mi>P</mi><mn>2</mn></msup><mrow><mn>2</mn><mo>&#160;</mo><mi>m</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>(</mo><mi>q</mi><mi>R</mi><mi>B</mi><msup><mo>)</mo><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo>&#160;</mo><mi>m</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><msup><mfenced><mrow><mn>1</mn><mo>.</mo><mn>6</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>19</mn></mrow></msup><mo>&#215;</mo><mn>7</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#215;</mo><mn>5</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup></mrow></mfenced><mn>2</mn></msup><mrow><mn>2</mn><mo>&#215;</mo><mn>9</mn><mo>.</mo><mn>1</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>31</mn></mrow></msup><mi>Joule</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>3136</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>52</mn></mrow></msup></mrow><mrow><mn>18</mn><mo>