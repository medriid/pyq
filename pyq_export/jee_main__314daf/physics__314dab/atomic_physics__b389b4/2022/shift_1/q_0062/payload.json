  "question": {
    "text": "Find the ratio of energies of photons produced due to transition of an election of hydrogen atom from its(i) second permitted energy level to the first level, and (ii) the highest permitted energy level to the first permitted level."
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>:</mo><mn>4</mn></math>",
