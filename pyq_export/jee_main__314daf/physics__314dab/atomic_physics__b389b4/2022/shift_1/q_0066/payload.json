  "question": {
    "text": "The momentum of an electron revolving in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>n</mi><mrow><mi>t</mi><mi>h</mi><mo>&#160;</mo></mrow></msup></math> orbit is given by : (Symbols have their usual meanings)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>n</mi><mi>h</mi></mrow><mrow><mn>2</mn><mi>&#960;</mi><mi>r</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>n</mi><mi>h</mi></mrow><mrow><mn>2</mn><mi>r</mi></mrow></mfrac></math>",
      "is_correct": false
