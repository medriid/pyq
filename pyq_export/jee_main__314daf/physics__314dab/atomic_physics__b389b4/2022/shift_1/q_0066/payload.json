      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><mi>&#960;</mi><mi>r</mi></mrow><mrow><mi>n</mi><mi>h</mi></mrow></mfrac></math>",
