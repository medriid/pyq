  "level": 1,
  "question": {
    "text": "The ratio for the speed of the electron in the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mrow><mi>rd</mi><mo>&#160;</mo></mrow></msup></math> orbit of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>He</mi><mo>+</mo></msup></math>&nbsp;to the speed of the electron in the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mrow><mi>rd</mi><mo>&#160;</mo></mrow></msup></math> orbit of hydrogen atom will be :",
    "image": null
  },
  "options": [
    {
      "id": "JIeye",
