  "level": 1,
  "question": {
    "text": "<p>Hydrogen atom from excited state comes to the ground by emitting a photon of wavelength <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi></math>. The value of principal quantum number <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>&nbsp;of the excited state will be :</p><p>( <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>:</mo></math> Rydberg constant)</p>",
    "image": null
  },
  "options": [
    {
