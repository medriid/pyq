  "question": {
    "text": "If the wavelength of the first member of Lyman series of hydrogen is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>λ</mi></math>. The wavelength of the second member will be"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>27</mn><mn>32</mn></mfrac><mi>λ</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>32</mn><mn>27</mn></mfrac><mi>λ</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>27</mn><mn>5</mn></mfrac><mi>λ</mi></math>",
