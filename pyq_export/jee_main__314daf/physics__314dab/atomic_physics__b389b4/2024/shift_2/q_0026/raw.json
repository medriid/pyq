  "question": {
    "text": "According to Bohr's theory, the moment of momentum of an electron revolving in $4^{\\text {th }}$ orbit of hydrogen atom is:",
    "image": null
  },
  "options": [
    {
      "id": "3l6qs",
      "text": "$\\frac{h}{\\pi}$",
      "image": null,
      "isCorrect": false
    },
    {
