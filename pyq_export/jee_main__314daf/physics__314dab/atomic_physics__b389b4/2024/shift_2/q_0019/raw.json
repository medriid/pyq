  "question": {
    "text": "The angular momentum of an electron in a hydrogen atom is proportional to :\n(Where $r$ is the radius of orbit of electron)",
    "image": null
  },
  "options": [
    {
      "id": "eVCqY",
      "text": "r",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "II8jf",
      "text": "$\\sqrt{\\mathrm{r}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Tyti0",
      "text": "$\\frac{1}{\\sqrt{\\mathrm{r}}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WPNMy",
      "text": "$\\frac{1}{\\mathrm{r}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{F}_{\\mathrm{C}}=\\frac{\\mathrm{mv}^2}{\\mathrm{r}} \\\\ & \\frac{\\mathrm{Kq}_1 \\mathrm{q}_2}{\\mathrm{r}^2}=\\frac{\\mathrm{mv}^2}{\\mathrm{r}} \\\\ & \\mathrm{mv}^2 \\mathrm{r}^2=K \\mathrm{~K}_1 \\mathrm{q}_2 \\mathrm{r} \\\\ & \\frac{\\mathrm{L}^2}{\\mathrm{~m}}=K \\mathrm{Kq}_1 \\mathrm{q}_2 \\mathrm{r} \\\\ & \\mathrm{L} \\propto \\sqrt{\\mathrm{r}}\\end{aligned}$",
    "image": null
  },
