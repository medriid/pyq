enced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>4</mn><msup><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>m</mi><mi>k</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mrow><mrow><mn>1</mn></mrow><mo>/</mo><mrow><mn>4</mn></mrow></mrow></mrow></msup><mtext> </mtext><msup><mrow><mi>n</mi></mrow><mrow><mrow><mrow><mn>1</mn></mrow><mo>/</mo><mrow><mn>2</mn></mrow></mrow></mrow></msup></math><br /><br /><math><mi>r</mi><mo>&#8733;</mo><msqrt><mi>n</mi></msqrt></math><br /><br />From equation (i) <math><mi>U</mi><mo>&#8733;</mo><msqrt><mi>n</mi></msqrt></math><br /><br /><math><mi>K</mi><mi>E</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mi><mo>;&#160;</mo></mi></math><math><mi>P</mi><mi>E</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>k</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mi>E</mi><mo>=</mo><mi>K</mi><mo>+</mo><mi>U</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>k</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>k</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&#8733;</mo><mi>n</mi></math>"
