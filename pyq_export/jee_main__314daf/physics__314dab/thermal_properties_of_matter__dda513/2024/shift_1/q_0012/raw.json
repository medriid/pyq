  "question": {
    "text": "On celcius scale the temperature of body increases by $40^{\\circ} \\mathrm{C}$. The increase in temperature on Fahrenheit scale is :",
    "image": null
  },
  "options": [
    {
      "id": "nyZD6",
      "text": "$68^{\\circ} \\mathrm{F}$",
      "image": null,
      "isCorrect": false
    },
