  "question": {
    "text": "The figure shows a system of two concentric spheres of radii $r_1$ and $r_2$ and kept at temperatures $T_1$ and $T_2$ respectively. The radial rate of flow of heat in a substance between the two concentric sphere is proportional to\n<img src=\"assets\\qt0123_0e8f0a2f2cc7.png\"><br>"
  },
  "options": [
    {
      "text": "\n$\\frac{r_2-r_1}{r_1 r_2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\ln \\left(\\frac{r_2}{r_1}\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{r_1 r_2}{r_2-r_1}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\ln \\left(r_2-r_1\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\left(\\frac{\\mathrm{dQ}}{\\mathrm{dt}}\\right)=\\left(\\mathrm{T}_1-\\mathrm{T}_2\\right) \\frac{4 \\pi \\mathrm{r}_1 \\mathrm{r}_2 \\mathrm{~K}}{\\left(\\mathrm{r}_2-\\mathrm{r}_1\\right)}$"
  }
}