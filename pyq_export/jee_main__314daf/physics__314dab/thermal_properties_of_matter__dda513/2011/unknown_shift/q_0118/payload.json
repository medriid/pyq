  "question": {
    "text": "$100 \\mathrm{~g}$ of water is heated from $30^{\\circ} \\mathrm{C}$ to $50^{\\circ} \\mathrm{C}$. Ignoring the slight expansion of the water, the change in its internal energy is (specific heat of water is $4148 \\mathrm{~J} / \\mathrm{kg} / \\mathrm{K}$ ):"
  },
  "options": [
    {
      "text": "\n$8.4 \\mathrm{~kJ}$\n",
      "is_correct": true
    },
    {
      "text": "\n$84 \\mathrm{~kJ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2.1 \\mathrm{~kJ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$4.2 \\mathrm{~kJ}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\Delta \\mathrm{Q}=\\Delta \\mathrm{U}+\\Delta \\mathrm{W}$ (ignoring expansion)\n$\\Delta \\mathrm{U}=\\mathrm{ms} \\Delta \\mathrm{T}=0.1 \\times 4.184 \\times 20=8.368 \\mathrm{~kJ}$"
  }
