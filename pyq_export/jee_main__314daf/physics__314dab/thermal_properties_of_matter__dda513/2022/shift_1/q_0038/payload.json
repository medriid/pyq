  "question": {
    "text": "Two metallic wires of identical dimensions are connected is series. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#963;</mi><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#963;</mi><mn>2</mn></msub></math> are the conductivities of the these wires respectively, the effective conductivity of the combination is :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#963;</mi><mn>1</mn></msub><msub><mi>&#963;</mi><mn>2</mn></msub></mrow><mrow><msub><mi>&#963;</mi><mn>1</mn></msub><mo>+</mo><msub><mi>&#963;</mi><mn>2</mn></msub></mrow></mfrac></math>",
      "is_correct": false
