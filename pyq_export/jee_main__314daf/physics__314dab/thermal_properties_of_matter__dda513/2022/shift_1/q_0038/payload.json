      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#963;</mi><mn>1</mn></msub><mo>+</mo><msub><mi>&#963;</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><msub><mi>&#963;</mi><mn>1</mn></msub><msub><mi>&#963;</mi><mn>2</mn></msub></mrow></mfrac></math>",
      "is_correct": false
