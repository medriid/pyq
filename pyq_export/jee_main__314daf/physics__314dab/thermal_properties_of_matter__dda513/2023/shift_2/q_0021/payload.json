  "question": {
    "text": "<p>A body cools in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math> minutes from <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>60</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>&nbsp;to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>40</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>. The temperature of the surrounding is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>. The temperature of the body after the next <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math> minutes will be</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>30</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>32</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>34</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
