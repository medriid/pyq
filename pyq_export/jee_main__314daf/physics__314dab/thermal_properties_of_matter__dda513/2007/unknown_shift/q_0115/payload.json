  "question": {
    "text": "One end of a thermally insulated rod is kept at a temperature $T_1$ and the other at $T_2$. The rod is composed of two sections of lengths $\\ell_1$ and $\\ell_2$ and thermal conductivities $k_1$ and $k_2$ respectively. The temperature at the interface of the two sections is\n<img src=\"assets\\qt0115_888978c1b0a0.png\"><br>"
  },
  "options": [
    {
      "text": "\n$\\left(\\mathrm{k}_2 \\ell_2 \\mathrm{T}_1+\\mathrm{k}_1 \\ell_1 \\mathrm{T}_2\\right) /\\left(\\mathrm{k}_1 \\ell_1+\\mathrm{k}_2 \\ell_2\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(\\mathrm{k}_2 \\ell_1 \\mathrm{T}_1+\\mathrm{k}_1 \\ell_1 \\mathrm{T}_2\\right) /\\left(\\mathrm{k}_2 \\ell_1+\\mathrm{k}_1 \\ell_2\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(\\mathrm{k}_1 \\ell_2 \\mathrm{T}_1+\\mathrm{k}_2 \\ell_1 \\mathrm{T}_2\\right) /\\left(\\mathrm{k}_1 \\ell_2+\\mathrm{k}_2 \\ell_1\\right)$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\left(\\mathrm{k}_1 \\ell_1 \\mathrm{T}_1+\\mathrm{k}_2 \\ell_2 \\mathrm{T}_2\\right) /\\left(\\mathrm{k}_1 \\ell_1+\\mathrm{k}_2 \\ell_2\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\left(\\mathrm{T}_1-\\mathrm{T}\\right) \\mathrm{k}_1}{\\ell_1}=\\frac{\\left(\\mathrm{T}-\\mathrm{T}_2\\right) \\mathrm{k}_2}{\\ell_2}$\n$\\mathrm{~T}=\\frac{\\mathrm{T}_1 \\mathrm{k}_1 \\ell_2+\\mathrm{T}_2 \\mathrm{k}_2 \\ell_1}{\\mathrm{k}_1 \\ell_2+\\mathrm{k}_2 \\ell_1}$"
  }
