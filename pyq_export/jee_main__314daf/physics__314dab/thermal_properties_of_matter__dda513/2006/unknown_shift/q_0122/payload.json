  "question": {
    "text": "Assuming the sun to be a spherical body of radius $\\mathrm{R}$ at a temperature of $\\mathrm{T} \\mathrm{K}$, evaluate the total radiant power, incident on Earth, at a distance $r$ from the Sun."
  },
  "options": [
    {
      "text": "\n$\\frac{\\mathrm{R}^2 \\sigma \\mathrm{T}^4}{\\mathrm{r}^2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{4 \\pi r_0^2 R^2 \\sigma T^4}{r^2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\pi r_0^2 R^2 \\sigma T^4}{r^2}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{r_0^2 R^2 \\sigma T^4}{4 \\pi r^2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\pi r_0^2}{4 \\pi r^2}\\left(\\sigma \\mathrm{T}^4 \\cdot 4 \\pi \\mathrm{R}^2\\right)=\\frac{\\sigma \\pi \\mathrm{T}^4 \\mathrm{R}^2 \\mathrm{r}_0^2}{\\mathrm{r}^2}$"
  }
