  "question": {
    "text": "The heat radiated per unit area in 1 hour by a furnace whose temperature is $3000 \\mathrm{~K}$ is $(\\sigma=5.7 \\times$ $10^{-8} \\mathrm{~W} \\mathrm{~m}^{-2} \\mathrm{~K}^{-4}$ )",
    "image": null
  },
  "options": [
    {
      "id": "cDJ5Z",
      "text": "\n$1.7 \\times 10^{10} \\mathrm{~J}$\n",
      "image": null,
