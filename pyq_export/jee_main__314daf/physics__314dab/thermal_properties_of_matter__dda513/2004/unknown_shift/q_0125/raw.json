  "question": {
    "text": "Time taken by a $836 \\mathrm{~W}$ heater to heat one litre of water from $10^{\\circ} \\mathrm{C}$ to $40^{\\circ} \\mathrm{C}$ is",
    "image": null
  },
  "options": [
    {
      "id": "6kl6j",
      "text": "\n$50 \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QS9hP",
      "text": "\n$100 \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8eehp",
      "text": "\n$150 \\mathrm{~s}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "0X1PX",
      "text": "\n$200 \\mathrm{~s}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Let $\\mathrm{t}$ be the time taken, then\n$$\n\\begin{aligned}\n& \\frac{836 \\times t}{4.2}=1000 \\times 1 \\times(40-10)[\\text { using } Q=m s t] \\\\\n& \\Rightarrow t=150 \\text { sec. }\n\\end{aligned}\n$$",
    "image": null
  },
