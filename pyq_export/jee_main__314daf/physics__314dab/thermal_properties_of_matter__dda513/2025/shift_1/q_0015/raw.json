  "question": {
    "text": "Two spherical bodies of same materials having radii 0.2 m and 0.8 m are placed in same atmosphere. The temperature of the smaller body is 800 K and temperature of the bigger body is 400 K . If the energy radiated from the smaller body is E, the energy radiated from the bigger body is (assume, effect of the surrounding temperature to be negligible),",
    "image": null
  },
  "options": [
    {
      "id": "1XHmz",
      "text": "16 E",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Hqkpv",
      "text": "E",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "YCdmf",
      "text": "64 E",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cZ5J3",
      "text": "256 E",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\frac{\\mathrm{d} \\theta}{\\mathrm{dt}}=\\sigma \\mathrm{eAT}^4 \\Rightarrow \\mathrm{P} \\propto \\mathrm{AT}^4 \\\\ & \\frac{\\mathrm{P}_{\\text {smaller }}}{\\mathrm{P}_{\\text {larger }}}=\\frac{(0.2)^2 \\times 800^4}{(0.8)^2 \\times 400^4} \\\\ & \\frac{1}{16} \\times 16=1 \\\\ & \\therefore \\mathrm{P}_{\\text {larger }}=\\mathrm{P}_{\\text {smaller }}\\end{aligned}$",
    "image": null
  },
