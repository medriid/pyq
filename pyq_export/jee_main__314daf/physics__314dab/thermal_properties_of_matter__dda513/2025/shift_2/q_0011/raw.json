  "question": {
    "text": "The temperature of a body in air falls from $40^{\\circ} \\mathrm{C}$ to $24^{\\circ} \\mathrm{C}$ in 4 minutes. The temperature of the air is $16^{\\circ} \\mathrm{C}$. The temperature of the body in the next 4 minutes will be:",
    "image": null
  },
  "options": [
    {
      "id": "Iwsda",
      "text": "$\\frac{14}{3}{ }^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RaEs9",
      "text": "$\\frac{42}{3}^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LRgGn",
      "text": "$\\frac{28}{3}{ }^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "59Vd6",
      "text": "$\\frac{56}{3}{ }^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\Delta T=T_2-T_1=16^{\\circ} \\mathrm{C} \\\\\n& \\text { And } T_0=16^{\\circ} \\mathrm{C} \\\\\n& \\frac{\\Delta T}{t_1}=-k\\left(32-16^{\\circ}\\right)...(i) \\\\\n& \\frac{\\left(24-T_3\\right)}{4}=-k\\left(\\frac{24+T_3}{2}-16\\right) ....(ii) \\\\\n& \\frac{16}{4}=-k(16) \\\\\n& \\Rightarrow \\frac{\\left(24-T_3\\right)}{4}=-k\\left(12+\\frac{T_3}{2}-16\\right) \\\\\n& \\Rightarrow \\frac{16}{24-T_3}=\\frac{16}{T_3} T_2 \\\\\n& \\Rightarrow \\frac{T_3}{2}-4=24-T_3 \\\\\n& \\Rightarrow \\frac{3 T_3}{2}=28 \\\\\n& \\Rightarrow T_3=\\frac{56}{3}{ }^{\\circ} \\mathrm{C}\n\\end{aligned}$",
    "image": null
  },
