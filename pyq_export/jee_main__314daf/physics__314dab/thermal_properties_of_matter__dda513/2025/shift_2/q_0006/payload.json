  "question": {
    "text": "Water falls from a height of 200 m into a pool. Calculate the rise in temperature of the water assuming no heat dissipation from the water in the pool.<br/>$\\left(\\right.$ Take $g=10 \\mathrm{~m} / \\mathrm{s}^2$, specific heat of water $\\left.=4200 \\mathrm{~J} /(\\mathrm{kg} \\mathrm{K})\\right)$"
  },
  "options": [
    {
      "text": "0.23 K",
      "is_correct": false
    },
    {
      "text": "0.36 K",
      "is_correct": false
    },
    {
      "text": "0.14 K",
      "is_correct": false
    },
    {
      "text": "0.48 K",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{mgh}=\\mathrm{ms} \\Delta \\mathrm{T} \\\\ & \\Delta \\mathrm{T}=\\frac{\\mathrm{gh}}{\\mathrm{s}}=\\frac{10 \\times 200}{4200} \\mathrm{~K}=\\frac{10}{21} \\mathrm{~K}\\end{aligned}$"
  }
}