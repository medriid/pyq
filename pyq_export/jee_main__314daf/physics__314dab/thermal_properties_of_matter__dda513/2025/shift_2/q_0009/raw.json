  "question": {
    "text": "Consider a rectangular sheet of solid material of length $\\ell=9 \\mathrm{~cm}$ and width $\\mathrm{d}=4 \\mathrm{~cm}$. The coefficient of linear expansion is $\\alpha=3.1 \\times 10^{-5} \\mathrm{~K}^{-1}$ at room temperature and one atmospheric pressure. The mass of sheet $\\mathrm{m}=0.1 \\mathrm{~kg}$ and the specific heat capacity $\\mathrm{C}_{\\mathrm{v}}=900 \\mathrm{~J} \\mathrm{~kg}^{-1} \\mathrm{~K}^{-1}$. If the amount of heat supplied to the material is $8.1 \\times 10^2 \\mathrm{~J}$ then change in area of the rectangular sheet is :-",
    "image": null
  },
  "options": [
    {
      "id": "kLKG5",
      "text": "$2.0 \\times 10^{-6} \\mathrm{~m}^2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "W3AZ9",
      "text": "$3.0 \\times 10^{-7} \\mathrm{~m}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UCy1Q",
      "text": "$6.0 \\times 10^{-7} \\mathrm{~m}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "S8WYo",
      "text": "$4.0 \\times 10^{-7} \\mathrm{~m}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\Delta \\mathrm{Q}=\\mathrm{ms} \\Delta \\mathrm{T} \\\\ & 8.1 \\times 10^2=0.1 \\times 900 \\times \\Delta \\mathrm{T} \\\\ & \\Delta \\mathrm{A}=\\mathrm{A}_0 2 \\alpha \\Delta \\mathrm{~T}=2.0 \\times 10^{-6} \\mathrm{~m}^2\\end{aligned}$",
    "image": null
  },
