      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{mgh}=\\mathrm{ms} \\Delta \\mathrm{T} \\\\ & \\Delta \\mathrm{T}=\\frac{\\mathrm{gh}}{\\mathrm{s}}=\\frac{10 \\times 200}{4200} \\mathrm{~K}=\\frac{10}{21} \\mathrm{~K}\\end{aligned}$",
    "image": null
  },
