  "question": {
    "text": "Water falls from a height of 200 m into a pool. Calculate the rise in temperature of the water assuming no heat dissipation from the water in the pool.<br/>$\\left(\\right.$ Take $g=10 \\mathrm{~m} / \\mathrm{s}^2$, specific heat of water $\\left.=4200 \\mathrm{~J} /(\\mathrm{kg} \\mathrm{K})\\right)$",
    "image": null
  },
  "options": [
    {
      "id": "UnecX",
      "text": "0.23 K",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AiLrq",
      "text": "0.36 K",
      "image": null,
      "isCorrect": false
    },
    {
