  "level": 2,
  "question": {
    "text": "A thermometer graduated according to a linear scale reads a value $x_{0}$ when in contact with boiling water, and $x_{0} / 3$ when in contact with ice. What is the temperature of an object in ${ }^{\\circ} \\mathrm{C}$, if this thermometer in the contact with the object reads $x_{0} / 2 ?$",
    "image": null
  },
  "options": [
    {
      "id": "8zu08",
      "text": "25",
      "isCorrect": true,
      "image": null
    },
    {
