eparators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mi mathvariant=\"normal\">v</mi></mrow></msub></mrow></mfenced><mo>=</mo><mn>150</mn><mtext> </mtext><msub><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub></math>  <br/><math><mi mathvariant=\"normal\">m</mi><mo>=</mo><mfrac><mrow><mn>150</mn><msub><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">L</mi></mrow><mrow><mi mathvariant=\"normal\">v</mi></mrow></msub></mrow></mfrac></math>  <br/><math><mi mathvariant=\"normal\">m</mi><mo>=</mo><mn>20</mn><mtext> </mtext><mi mathvariant=\"normal\">g</mi></math>"
