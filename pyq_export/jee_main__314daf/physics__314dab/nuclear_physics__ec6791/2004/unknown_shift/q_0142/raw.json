  "question": {
    "text": "A nucleus disintegrates into two nuclear parts which have their velocities in the ratio $2: 1$. The ratio of their nuclear sizes will be",
    "image": null
  },
  "options": [
    {
      "id": "yT2R5",
      "text": "\n$2^{1 / 3}: 1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Y9sZ4",
      "text": "\n$1: 3^{1 / 2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Ci16s",
      "text": "\n$3^{1 / 2}: 1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XtqmZ",
      "text": "\n$1: 2^{1 / 3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{R_1}{R_2}=\\left(\\frac{m_2}{2 m_2}\\right)^{1 / 3}$\n$\\Rightarrow \\frac{R_1}{R_2}=1: 2^{1 / 3}$",
    "image": null
  },
