      "text": "\n$19.2 \\mathrm{MeV}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Energy released $=$ total binding energy of product $-$ total binding energy of reactants $\\Rightarrow 28-(2 \\times 2.2)=28-4.4=236 \\mathrm{MeV}$",
    "image": null
  },
