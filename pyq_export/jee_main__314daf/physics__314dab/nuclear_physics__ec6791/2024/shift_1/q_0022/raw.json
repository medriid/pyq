  "question": {
    "text": "Binding energy of a certain nucleus is $18 \\times 10^8 \\mathrm{~J}$. How much is the difference between total mass of all the nucleons and nuclear mass of the given nucleus:",
    "image": null
  },
  "options": [
    {
      "id": "dFHNk",
      "text": "$10 \\mu \\mathrm{g}$",
      "image": null,
      "isCorrect": false
