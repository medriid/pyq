  "question": {
    "text": "Binding energy of a certain nucleus is $18 \\times 10^8 \\mathrm{~J}$. How much is the difference between total mass of all the nucleons and nuclear mass of the given nucleus:"
  },
  "options": [
    {
      "text": "$10 \\mu \\mathrm{g}$",
      "is_correct": false
    },
    {
      "text": "$20 \\mu \\mathrm{g}$",
      "is_correct": true
    },
    {
      "text": "$0.2 \\mu \\mathrm{g}$",
      "is_correct": false
    },
    {
      "text": "$2 \\mu \\mathrm{g}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\Delta \\mathrm{mc}^2=18 \\times 10^8 \\\\ & \\Delta \\mathrm{m} \\times 9 \\times 10^{16}=18 \\times 10^8 \\\\ & \\Delta \\mathrm{m}=2 \\times 10^{-8} \\mathrm{~kg}=20 \\mu \\mathrm{g}\\end{aligned}$"
  }
}