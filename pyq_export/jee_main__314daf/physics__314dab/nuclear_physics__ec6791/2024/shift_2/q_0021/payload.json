  "question": {
    "text": "The mass number of nucleus having radius equal to half of the radius of nucleus with mass number <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>192</mn></math> is:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn></math>",
      "is_correct": true
    },
    {
