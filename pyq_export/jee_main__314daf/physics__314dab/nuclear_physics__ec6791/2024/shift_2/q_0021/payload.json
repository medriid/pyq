  "question": {
    "text": "If $M_o$ is the mass of isotope ${ }_5^{12} B, M_P$ and $M_n$ are the masses of proton and neutron, then nuclear binding energy of isotope is :"
  },
  "options": [
    {
      "text": "$\\left(M_o-5 M_p\\right) C^2$",
      "is_correct": false
    },
    {
      "text": "$\\left(5 M_p+7 M_n-M_o\\right) C^2$",
      "is_correct": true
    },
    {
      "text": "$\\left(M_0-12 M_n\\right) C^2$",
      "is_correct": false
    },
    {
      "text": "$\\left(M_o-5 M_p-7 M_n\\right) C^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { B.E. }=\\Delta m C^2 \\\\ & \\left(5 M_p+7 M_n-M_o\\right) C^2\\end{aligned}$"
  }
