  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/NMl0IJisRbuOYBS8isMLijQtvanuRouaMqzS2rLjNgM.original.fullsize.png\"/><br/>$\\begin{aligned} & E_B=\\mathrm{BE}_{\\text {reactant }}-\\mathrm{BE}_{\\text {product }} \\\\ & =1.1 \\times 2+1.1 \\times 2-7 \\times 4=-23.6 \\mathrm{MeV} \\\\ & =\\mathrm{Q}=23.6 \\mathrm{MeV}\\end{aligned}$",
