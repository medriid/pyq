  "question": {
    "text": "Energy released when two deuterons $\\left({ }_1 \\mathrm{H}^2\\right)$ fuse to form a helium nucleus $\\left({ }_2 \\mathrm{He}^4\\right)$ is :<br/>(Given : Binding energy per nucleon of ${ }_1 \\mathrm{H}^2=1.1 \\mathrm{MeV}$ and binding energy per nucleon of ${ }_2 \\mathrm{He}^4=7.0 \\mathrm{MeV}$)"
  },
  "options": [
    {
      "text": "8.1 MeV",
      "is_correct": false
    },
    {
      "text": "5.9 MeV",
      "is_correct": false
    },
    {
      "text": "23.6 MeV",
      "is_correct": true
    },
    {
      "text": "26.8 MeV",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0004_53f28b1ca253.png\"/><br/>$\\begin{aligned} & E_B=\\mathrm{BE}_{\\text {reactant }}-\\mathrm{BE}_{\\text {product }} \\\\ & =1.1 \\times 2+1.1 \\times 2-7 \\times 4=-23.6 \\mathrm{MeV} \\\\ & =\\mathrm{Q}=23.6 \\mathrm{MeV}\\end{aligned}$"
  }
