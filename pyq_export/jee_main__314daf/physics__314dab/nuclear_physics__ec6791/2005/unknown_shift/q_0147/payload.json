      "text": "\n10 minutes\n",
      "is_correct": false
    },
    {
      "text": "\n15 minutes\n",
      "is_correct": false
    },
    {
      "text": "\n5 minutes\n",
      "is_correct": true
    },
    {
      "text": "\n$7 \\frac{1}{2}$ minutes",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{N}_0 \\stackrel{\\mathrm{t}_{1 / 2}}{\\longrightarrow} \\frac{\\mathrm{N}_0}{2} \\stackrel{\\mathrm{t}_{1 / 2}}{\\longrightarrow} \\frac{\\mathrm{N}_0}{4} \\stackrel{\\mathrm{t}_{1 / 2}}{\\longrightarrow} \\frac{\\mathrm{N}_0}{8}$\n$3 \\mathrm{t}_{1 / 2}=15 \\therefore \\mathrm{t}_{1 / 2}=5$"
  }
