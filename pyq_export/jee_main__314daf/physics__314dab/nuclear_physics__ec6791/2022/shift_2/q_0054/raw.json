  "question": {
    "text": "Mass numbers of two nuclei are in the ratio of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>:</mo><mn>3</mn></math>. Their nuclear densities will be in the ratio of",
    "image": null
  },
  "options": [
    {
      "id": "WSZ1J",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>:</mo><mn>3</mn></math>",
