      "image": null
    },
    {
      "id": "ZcrR5",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mn>3</mn><mn>4</mn></mfrac></mfenced><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></math>",
