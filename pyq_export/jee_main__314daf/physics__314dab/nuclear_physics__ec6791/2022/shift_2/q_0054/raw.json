    {
      "id": "xVyyX",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mn>4</mn><mn>3</mn></mfrac></mfenced><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></math>",
      "isCorrect": false,
