  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "What is the half-life period of a radioactive material if its activity drops to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msup><mn>16</mn><mrow><mi>th</mi><mo>&#160;</mo></mrow></msup></mfrac></math> of its initial value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn></math> years ?",
    "image": null
  },
  "options": [
    {
      "id": "5Rxjw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>.</mo><mn>5</mn></math> years",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lmq70",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>.</mo><mn>5</mn></math> years",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "uZ8GX",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mo>.</mo><mn>5</mn></math>&nbsp;years",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "5AG9Z",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>.</mo><mn>5</mn></math> years",
      "isCorrect": false,
