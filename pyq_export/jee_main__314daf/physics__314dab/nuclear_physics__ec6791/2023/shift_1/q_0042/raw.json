  "question": {
    "text": "If a radioactive element having half-life of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn></math> min is undergoing beta decay, the fraction of radioactive element remains undecayed after <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>90</mn></math> min&nbsp;will be :",
    "image": null
  },
