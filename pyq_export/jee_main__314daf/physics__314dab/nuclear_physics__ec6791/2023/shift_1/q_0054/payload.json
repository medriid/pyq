      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>210</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>80</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>211</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>80</mn></math>",
