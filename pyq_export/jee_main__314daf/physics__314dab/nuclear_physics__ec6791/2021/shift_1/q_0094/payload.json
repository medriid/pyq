  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mi>x</mi></msub><mo>=</mo><mi>t</mi><mo>;</mo><msub><mi>T</mi><mi>y</mi></msub><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><msub><mi>T</mi><mi mathvariant=\"normal\">y</mi></msub><mo>=</mo><mn>6</mn><mi mathvariant=\"normal\">t</mi><mo>,</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>N</mi><mn>1</mn><mo>&#39;</mo></msubsup><mo>=</mo><msubsup><mi>N</mi><mn>2</mn><mo>&#39;</mo></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>N</mi><mn>1</mn></msub><msup><mi>e</mi><mrow><mo>-</mo><msub><mi>&#955;</mi><mn>1</mn></msub><mn>6</mn><mi>t</mi></mrow></msup><mo>=</mo><msub><mi>N</mi><mn>2</mn></msub><msup><mi>e</mi><mrow><mo>-</mo><msub><mi>&#955;</mi><mn>2</mn></msub><mn>6</mn><mi>t</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>N</mi><mn>1</mn></msub><mrow><mo>&#160;</mo><msub><mi>N</mi><mn>2</mn></msub></mrow></mfrac><mo>=</mo><msup><mi>e</mi><mrow><mfenced><mrow><msub><mi>&#955;</mi><mn>1</mn></msub><mo>-</mo><msub><mi>&#955;</mi><mn>2</mn></msub></mrow></mfenced><mn>6</mn><mi>t</mi></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><mfenced open=\"[\" close=\"]\"><mrow><mfenced><mrow><mfrac><mn>1</mn><mi>t</mi></mfrac><mo>-</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>t</mi></mrow></mfrac></mrow></mfenced><mo>&#215;</mo><mn>6</mn><mi>t</mi></mrow></mfenced><mi>ln</mi><mn>2</mn></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><mi>ln</mi><mfenced><msup><mn>2</mn><mn>3</mn></msup></mfenced></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><mi>ln</mi><mn>8</mn></mrow></msup><mo>=</mo><mn>8</mn></math></p>"
