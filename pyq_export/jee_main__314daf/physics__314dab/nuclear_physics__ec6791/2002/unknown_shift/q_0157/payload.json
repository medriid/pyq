  "question": {
    "text": "If $\\mathrm{N}_0$ is the original mass of the substance of half- life period $\\mathrm{t}_{1 / 2}=5$ years, then the amount of substance left after 15 years is"
  },
  "options": [
    {
      "text": "\n$\\mathrm{N}_0 / 8$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{N}_0 / 16$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{N}_0 / 2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{N}_0 / 4$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Amount left $=N_0 / 2^n=N_0 / 8 \\quad($ Here $n=15 / 5=3)$"
  }
