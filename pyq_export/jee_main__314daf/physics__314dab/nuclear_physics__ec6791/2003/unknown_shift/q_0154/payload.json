  "question": {
    "text": "When a $U^{238}$ nucleus originally at rest, decays by emitting an alpha particle having a speed ' $u$ ', the recoil speed of the residual nucleus is"
  },
  "options": [
    {
      "text": "\n$\\frac{4 \\mathrm{u}}{238}$\n",
      "is_correct": true
    },
    {
      "text": "\n$-\\frac{4 \\mathrm{u}}{234}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{4 \\mathrm{u}}{234}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-\\frac{4 \\mathrm{u}}{238}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Applying the principle of conservation of linear momentum\n(4) $(\\mathrm{u})=(\\mathrm{v})(238) \\Rightarrow \\mathrm{v}=\\frac{4 \\mathrm{u}}{238}$"
  }
}