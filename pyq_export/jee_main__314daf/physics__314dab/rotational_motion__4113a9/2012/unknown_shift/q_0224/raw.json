  "question": {
    "text": "A solid sphere having mass $m$ and radius $r$ rolls down an inclined plane. Then its kinetic energy is",
    "image": null
  },
  "options": [
    {
      "id": "W2Xew",
      "text": "\n$\\frac{5}{7}$ rotational and $\\frac{2}{7}$ translational\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ni0vW",
      "text": "\n$\\frac{2}{7}$ rotational and $\\frac{5}{7}$ translational\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GnYjF",
      "text": "\n$\\frac{2}{5}$ rotational and $\\frac{3}{5}$ translational\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FdOvb",
      "text": "\n$\\frac{1}{2}$ rotational and $\\frac{1}{2}$ translational",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& K . E_{\\text {rotational }}=\\frac{1}{2} I \\omega^2 \\\\\n& =\\frac{1}{2} \\frac{2}{5} \\omega r^2 d^2\\left(\\because I_{\\text {Solid sphere }}=\\frac{2}{5} m r^2\\right) \\\\\n& K \\cdot E_{\\text {translational }}=\\frac{1}{2} m v^2 \\\\\n& \\therefore \\frac{K \\cdot E_{\\text {rotational }}}{K \\cdot E_{\\text {translational }}}=\\frac{2}{5}\n\\end{aligned}\n$$\nHence option (b) is correct",
    "image": null
  },
