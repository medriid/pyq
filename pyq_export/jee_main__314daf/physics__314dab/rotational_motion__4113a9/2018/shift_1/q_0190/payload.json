  "question": {
    "text": "A force of $40 \\mathrm{~N}$ acts on a point $\\mathrm{B}$ at the end of an L-shaped object, as shown in the figure. The angle $\\theta$ that will produce maximum moment of the force about point $\\mathrm{A}$ is given by:\n<img src=\"assets\\qt0190_eb4ca9918b93.png\"><br>"
  },
  "options": [
    {
      "text": "\n$\\tan \\theta=\\frac{1}{4}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\tan \\theta=2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\tan \\theta=\\frac{1}{2}$\n",
      "is_correct": true
    },
    {
      "text": "\n $\\tan \\theta=4$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "To produce maximum moment of force line of action of force must be perpendicular to line $\\mathrm{AB}$.\n<img src=\"assets\\st0190_7d3dadfd112c.png\"><br>\n$\\therefore \\tan \\theta=\\frac{2}{4}=\\frac{1}{2}$"
  }
}