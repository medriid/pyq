    "text": "From angular momentum conservation<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mi>M</mi><msub><mi>V</mi><mn>0</mn></msub><mi>L</mi><mo>=</mo><mi>M</mi><mi>V</mi><mo>(</mo><mi>L</mi><mo>-</mo><mi>l</mi><mo>)</mo></mtd></mtr><mtr><mtd><mi>V</mi><mo>=</mo><msub><mi>V</mi><mn>0</mn></msub><mfenced separators=\"|\"><mfrac><mi>L</mi><mrow><mi>L</mi><mo>-</mo><mi>l</mi></mrow></mfrac></mfenced></mtd></mtr></mtable></math><br />Now<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>W</mi><mo>=</mo><mi>M</mi><mi>g</mi><mi>l</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>M</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><msub><mi>V</mi><mn>0</mn></msub><mn>2</mn></msup><msup><mfenced separators=\"|\"><mfrac><mi>L</mi><mrow><mi>L</mi><mo>-</mo><mi>l</mi></mrow></mfrac></mfenced><mn>2</mn></msup><mo>-</mo><msup><msub><mi>V</mi><mn>0</mn></msub><mn>2</mn></msup></mrow></mfenced></math><br />Since <math><mi>l</mi><mo>&#8810;</mo><mi>L</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mi>W</mi><mo>=</mo><mi>M</mi><mi>g</mi><mi>l</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>M</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><msub><mi>V</mi><mn>0</mn></msub><mn>2</mn></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mfrac><mi>l</mi><mi>L</mi></mfrac></mrow></mfenced><mrow><mo>-</mo><mn>2</mn></mrow></msup><mo>-</mo><msup><msub><mi>V</mi><mn>0</mn></msub><mn>2</mn></msup></mrow></mfenced></mtd></mtr><mtr><mtd><mo mathvariant=\"italic\">=</mo><mi>M</mi><mi>g</mi><mi>l</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>M</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><msub><mi>V</mi><mn>0</mn></msub><mn>2</mn></msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mfrac><mi>l</mi><mi>L</mi></mfrac></mrow></mfenced><mo>-</mo><msup><msub><mi mathvariant=\"normal\