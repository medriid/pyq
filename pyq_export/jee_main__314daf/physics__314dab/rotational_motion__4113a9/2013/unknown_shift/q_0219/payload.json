  "question": {
    "text": "A hoop of radius <math> <mrow> <mtext>r</mtext> </mrow> </math> and mass <math> <mrow> <mtext>m</mtext> </mrow> </math> rotating with an angular velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#969;</mi><mn>0</mn></msub></math> is placed on a rough horizontal surface. The initial velocity of the centre of the hoop is zero. What will be the velocity of the centre of the hoop when it ceases to slip?"
  },
  "options": [
    {
      "text": "<math> <mrow> <mfrac> <mrow> <mtext>r</mtext> <msub> <mi>ω</mi> <mn>0</mn> </msub> </mrow> <mrow> <mn>2</mn> </mrow> </mfrac> </mrow> </math>",
