  "correctValue": null,
  "solution": {
    "text": "<p>By conservation of angular momentum at the point of contact&nbsp;<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/a02a8fc2-9e95-4962-b5a3-dee0b5b49c3b-image.png\" style=\"width: 370px; height: 117px;\" />&nbsp;<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><msup><mi>r</mi><mn>2</mn></msup><msub><mi>&#969;</mi><mn>0</mn></msub><mo>=</mo><mi>m</mi><mi>v</mi><mi>r</mi><mo>+</mo><mi>m</mi><msup><mi>r</mi><mn>2</mn></msup><mi>&#969;</mi><mo>=</mo><mi>m</mi><mi>v</mi><mi>r</mi><mo>+</mo><mi>m</mi><msup><mi>r</mi><mn>2</mn></msup><mo>.</mo><mi>v</mi><mo>/</mo><mi>r</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><msup><mi>r</mi><mn>2</mn></msup><msub><mi>&#969;</mi><mn>0</mn></msub><mo>=</mo><mn>2</mn><mi>v</mi><mi>r</mi><mo>&#8658;</mo><mi>v</mi><mo>=</mo><mi>r</mi><msub><mi>&#969;</mi><mn>0</mn></msub><mo>/</mo><mn>2</mn></math></p><p>&nbsp;</p>",
