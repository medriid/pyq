  "question": {
    "text": "The moment of inertia of a circular ring of mass $M$ and diameter r about a tangential axis lying in the plane of the ring is :",
    "image": null
  },
  "options": [
    {
      "id": "6FLBf",
      "text": "$\\frac{1}{2} \\mathrm{Mr}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BcNx6",
      "text": "$\\frac{3}{8} \\mathrm{Mr}^2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "I8ox8",
      "text": "$\\frac{3}{2} \\mathrm{Mr}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qRXMl",
      "text": "$2 \\mathrm{Mr}^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Diameter is given as R.<br/>$\\begin{aligned}<br/>& \\therefore \\text { Radius }=\\mathrm{R} / 2 \\\\\n& \\mathrm{I}_{\\text {tan gent }}=\\frac{3}{2} \\mathrm{~m}\\left(\\frac{\\mathrm{R}}{2}\\right)^2=\\frac{3}{8} \\mathrm{mR}^2<br/>\\end{aligned}$",
    "image": null
  },
