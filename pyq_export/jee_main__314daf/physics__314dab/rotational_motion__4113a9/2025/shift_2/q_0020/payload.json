  "question": {
    "text": "A rod of linear mass density ' $\\lambda$ ' and length ' $L$ ' is bent to form a ring of radius 'R'. Moment of inertia of ring about any of its diameter is :"
  },
  "options": [
    {
      "text": "$\\frac{\\lambda \\mathrm{L}^3}{16 \\pi^2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\lambda \\mathrm{L}^3}{12}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\lambda \\mathrm{L}^3}{4 \\pi^2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\lambda L^3}{8 \\pi^2}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$L=2 \\pi R$<br/>$\\mathrm{I}=\\frac{\\mathrm{MR}^2}{2}=\\frac{\\lambda \\times \\mathrm{L}}{2} \\times\\left(\\frac{\\mathrm{L}}{2 \\pi}\\right)^2=\\frac{\\lambda \\mathrm{L}^3}{8 \\pi^2}$"
  }
}