  "question": {
    "text": "A solid sphere is rolling without slipping on a horizontal plane. The ratio of the linear kinetic energy of the centre of mass of the sphere and rotational kinetic energy is :",
    "image": null
  },
  "options": [
    {
      "id": "5YGBD",
      "text": "$\\frac{3}{4}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1SA9m",
      "text": "$\\frac{4}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aWePz",
      "text": "$\\frac{5}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "3kKRV",
      "text": "$\\frac{2}{5}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{KE}_{(T)}=\\frac{1}{2} m v^2 \\\\\n& \\mathrm{KE}_{(R)}=\\frac{1}{2} \\cdot \\frac{2}{5} m R^2 \\cdot \\frac{v^2}{R^2}=\\frac{1}{2} m v^2\\left(\\frac{2}{5}\\right)\n\\end{aligned}$\nSo, $\\frac{\\mathrm{KE}_{(T)}}{\\mathrm{KE}_{(R)}}=\\frac{5}{2}$",
    "image": null
  },
