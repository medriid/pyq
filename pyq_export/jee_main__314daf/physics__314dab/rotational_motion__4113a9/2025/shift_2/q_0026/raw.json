  "question": {
    "text": "The torque due to the force $(2 \\hat{i}+\\hat{j}+2 \\hat{k})$ about the origin, acting on a particle whose position vector is $(\\hat{i}+\\hat{j}+\\hat{k})$, would be",
    "image": null
  },
  "options": [
    {
      "id": "InhAx",
      "text": "$\\hat{i}-\\hat{k}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9ezkX",
      "text": "$\\hat{i}+\\hat{k}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "u7ZD0",
      "text": "$\\hat{j}+\\hat{k}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "d2f7x",
      "text": "$\\hat{i}-\\hat{j}+\\hat{k}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} \\tau & =\\dot{r} \\times \\dot{F} \\\\ \\tau & =\\left|\\begin{array}{lll}\\hat{i} & \\hat{j} & \\hat{k} \\\\ 1 & 1 & 1 \\\\ 2 & 1 & 2\\end{array}\\right| \\\\ \\tau & =\\hat{i}(2-1)-\\hat{j}[0]+\\hat{k}(1-2) \\\\ & =\\hat{i}-\\hat{k}\\end{aligned}$",
    "image": null
  },
