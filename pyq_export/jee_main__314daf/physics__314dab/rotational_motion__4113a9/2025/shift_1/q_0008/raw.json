  "question": {
    "text": "If $\\overrightarrow{\\mathrm{L}}$ and $\\overrightarrow{\\mathrm{P}}$ represent the angular momentum and linear momentum respectively of a particle of mass ' m ' having position vector $\\overrightarrow{\\mathrm{r}}=\\mathrm{a}(\\hat{\\mathrm{i}} \\cos \\omega \\mathrm{t}+\\hat{\\mathrm{j}} \\sin \\omega \\mathrm{t})$. The direction of force is",
    "image": null
  },
  "options": [
    {
      "id": "nNcbE",
      "text": "Opposite to the direction of $\\vec{r}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ad154",
      "text": "Opposite to the direction of $\\overrightarrow{\\mathrm{L}}$",
      "image": null,
