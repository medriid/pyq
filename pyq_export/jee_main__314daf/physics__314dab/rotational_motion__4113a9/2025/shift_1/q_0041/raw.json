  "question": {
    "text": "A uniform solid cylinder of mass ' $m$ ' and radius ' $r$ ' rolls along an inclined rough plane of inclination $45^{\\circ}$. If it starts to roll from rest from the top of the plane then the linear acceleration of the cylinder's axis will be",
    "image": null
  },
  "options": [
    {
      "id": "tKFB0",
      "text": "$\\frac{1}{\\sqrt{2}} \\mathrm{~g}$",
      "image": null,
