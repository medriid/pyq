  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned} & a=\\frac{\\mathrm{g} \\sin \\theta}{1+\\frac{\\mathrm{I}}{\\mathrm{mR}^2}} \\\\ & a=\\frac{\\frac{g}{\\sqrt{2}}}{1+\\frac{1}{2}}=\\frac{2 \\frac{g}{\\sqrt{2}}}{3}=\\frac{\\sqrt{2} g}{3}\\end{aligned}\\)",
