    },
    {
      "id": "0MPr4",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mi mathvariant=\"normal\">r</mi></mfrac><msqrt><mfrac><mrow><mn>2</mn><mi>gh</mi></mrow><mn>3</mn></mfrac></msqrt></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "TwDqB",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">r</mi><msqrt><mfrac><mn>3</mn><mrow><mn>4</mn><mi>gh</mi></mrow></mfrac></msqrt></math>",
      "isCorrect": false,
