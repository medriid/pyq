  "question": {
    "text": "A particle performing uniform circular motion has angular frequency is doubled \\& its kinetic energy halved, then the new angular momentum is",
    "image": null
  },
  "options": [
    {
      "id": "HVsL9",
      "text": "\n$\\frac{\\mathrm{L}}{4}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Xgh80",
      "text": "\n$2 \\mathrm{~L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cH26D",
      "text": "\n$4 \\mathrm{~L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "icnnf",
      "text": "\n$\\frac{\\mathrm{L}}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Angular momentum $\\propto \\frac{1}{\\text { Angular frequency }} \\propto$ Kinetic energy $\\Rightarrow \\vec{L}=\\frac{\\mathrm{K} . \\mathrm{E} .}{\\mathrm{w}}$\n$\\frac{\\mathrm{L}_1}{\\mathrm{~L}_2}=\\left(\\frac{\\mathrm{K} . \\mathrm{E}_1}{\\mathrm{w}_1}\\right) \\times \\frac{\\mathrm{w}_2}{\\mathrm{KE}_2}=4 \\Rightarrow \\mathrm{L}_2=\\frac{\\mathrm{L}}{4}$",
    "image": null
  },
