  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{w}_{\\mathrm{g}}+\\mathrm{w}_{\\mathrm{Fr}}+\\mathrm{w}_{\\mathrm{s}}=\\Delta \\mathrm{KE} \\\\ & 5 \\times 10 \\times 5-0.5 \\times 5 \\times 10 \\times \\mathrm{x}-\\frac{1}{2} \\mathrm{Kx}^2=0-0 \\\\ & 250=25 \\mathrm{x}+50 \\mathrm{x}^2 \\\\ & 2 \\mathrm{x}^2+\\mathrm{x}-10=0 \\\\ & \\mathrm{x}=2\\end{aligned}$",
    "image": null
