  "question": {
    "text": "<p>A disc of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> and mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> is rolling horizontally without slipping with speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math>. It then moves up an inclined smooth surface as shown in figure. The maximum height that the disc can go up the incline is:</p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/85a09b36-4b67-4c39-b4b7-bb08bcfe1dda.png\" style=\"width: 350px; height: 122px;\"/>",
    "image": null
  },
