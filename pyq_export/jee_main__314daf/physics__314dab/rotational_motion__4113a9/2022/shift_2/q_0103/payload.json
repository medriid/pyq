  "question": {
    "text": "A solid spherical ball is rolling on a frictionless horizontal plane surface about its axis of symmetry. The ratio of rotational kinetic energy of the ball to its total kinetic energy is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>5</mn></mfrac></math>",
      "is_correct": false
    },
