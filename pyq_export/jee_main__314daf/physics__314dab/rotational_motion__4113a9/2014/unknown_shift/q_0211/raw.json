row> <mo>&there4;&nbsp;&nbsp;&nbsp;</mo> <mfrac> <mrow> <mo>sin</mo> <msub> <mi>&theta;</mi> <mtext>C</mtext> </msub> </mrow> <mrow> <mo>sin</mo> <msub> <mi>&theta;</mi> <mtext>S</mtext> </msub> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>5</mn> <mo>&times;</mo> <mn>3</mn> </mrow> <mrow> <mn>7</mn> <mo>&times;</mo> <mn>2</mn> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> <mn>5</mn> </mrow> <mrow> <mn>1</mn> <mn>4</mn> </mrow> </mfrac> </mrow> </math>",
