  "question": {
    "text": "Consider a situation in which a ring, a solid cylinder and a solid sphere roll down on the same inclined plane without slipping. Assume that they start rolling from rest and having identical diameter. The correct statement for this situation is&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "ctYTN",
      "text": "The sphere has the greatest and the ring has the least velocity of the centre of mass at the bottom of the inclined plane.",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "ppjWH",
      "text": "The ring has the greatest and the cylinder has the least velocity of the centre of mass at the bottom of the inclined plane.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "mqVzz",
      "text": "All of them will have same velocity.",
      "isCorrect": false,
