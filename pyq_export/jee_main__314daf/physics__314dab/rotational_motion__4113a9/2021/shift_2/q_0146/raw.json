  "correctValue": "8",
  "solution": {
    "text": "<blockquote><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/d7d8da66-a7ef-4ae6-a092-47cc20108b17-image.png\" style=\"width: 370px; height: 206px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>61</mn><mo>=</mo><mn>2</mn><mo>.</mo><mn>4</mn></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><menclose notation=\"box\"><mi>&#8467;</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></menclose></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mo>&#160;</mo><mn>60</mn><mo>&#176;</mo><mo>=</mo><mfrac><mi>r</mi><mi>&#8467;</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>sin</mi><mo>&#160;</mo><mn>60</mn><mo>&#176;</mo><mo>=</mo><mfrac><mrow><mi>&#8467;</mi><msqrt><mn>3</mn></msqrt></mrow><mn>2</mn></mfrac></math></p><p>MOI,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mfenced close=\"]\" open=\"[\"><mrow><mfrac><mrow><mi>m</mi><msup><mi>&#8467;</mi><mn>2</mn></msup></mrow><mn>12</mn></mfrac><mo>+</mo><mi>m</mi><msup><mi>r</mi><mn>2</mn></msup></mrow></mfenced><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"]\" open=\"[\"><mrow><mfrac><mrow><mi>m</mi><msup><mi>&#8467;</mi><mn>2</mn></msup></mrow><mn>12</mn></mfrac><mo>+</mo><mi>m</mi><msup><mfenced><mfrac><mrow><mi>&#8467;</mi><msqrt><mn>3</mn></msqrt></mrow><mn>2</mn></mfrac></mfenced><mn>2</mn></msup></mrow></mfenced><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>5</mn><mo>&#160;</mo><mi>m</mi><msup><mi>l</mi><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>5</mn><mo>&#215;</mo><mn>1</mn><mo>&#215;</mo><mn>0</mn><mo>.</mo><mn>16</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>0</mn><mo>.</mo><mn>8</mn></math></