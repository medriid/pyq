  "question": {
    "text": "<p>A sphere of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>&nbsp;and mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> rolls along a horizontal plane with constant speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mn>0</mn></msub></math>. It encounters an inclined plane at angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#952;</mi></math> and climbs upward. Assuming that it rolls without slipping, how far up the sphere will travel?</p><p><img src=\"assets\\qt0127_3da06be6eb18.png\" style=\"width: 270px; height: 164px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>5</mn></mfrac><mfrac><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup><mrow><mo>&#160;</mo><mi>g</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfrac></math><br />&nbsp;",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>7</mn><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mrow><mrow><mn>10</mn><mo>&#160;</mo><mi>g</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup><mrow><mn>5</mn><mi>g</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfrac></math>",
