  "question": {
    "text": "A thin uniform rod of length $\\ell$ and mass $m$ is swinging freely about a horizontal axis passing through its end. Its maximum angular speed is $\\omega$. Its centre of mass rises to a maximum height of",
    "image": null
  },
  "options": [
    {
      "id": "3GoJX",
      "text": "\n$\\frac{1}{3} \\frac{\\ell^2 \\omega^2}{g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YsM1A",
      "text": "\n$\\frac{1}{6} \\frac{\\ell \\omega}{\\mathrm{g}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mLg86",
      "text": "\n$\\frac{1}{2} \\frac{\\ell^2 \\omega^2}{g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "frRR6",
      "text": "\n$\\frac{1}{6} \\frac{\\ell^2 \\omega^2}{\\mathrm{~g}}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { } \\\\\n& \\text { T.E }=T . E_{\\mathrm{f}} \\\\\n& \\frac{1}{2} I \\omega^2=m g h \\\\\n& \\frac{1}{2} \\times \\frac{1}{3} m \\ell^2 \\omega^2=m g h \\Rightarrow h=\\frac{1}{6} \\frac{\\ell^2 \\omega^2}{\\mathrm{~g}}\n\\end{aligned}\n$$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/kpRD3-SJtuYmqXKpGPf6pPu2339CVubCmC6OoUh3WZc.original.fullsize.png\"><br>",
