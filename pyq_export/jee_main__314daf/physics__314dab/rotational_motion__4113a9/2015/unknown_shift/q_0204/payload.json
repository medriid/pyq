    "A"
  ],
  "solution": {
    "text": "<img alt=\"\" height=\"113\" src=\"assets\\st0204_9cb16a21c94d.jpg\" width=\"230\" /><br /><br />From free body diagram of cylinder<br /><br /><math><mi>F</mi><mo>-</mo><msub><mrow><mi>f</mi></mrow><mrow><mi>s</mi></mrow></msub><mo>=</mo><mi>m</mi><mi>a</mi></math> .....(1)<br /><br /><math><mo>&#8757;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mrow><mo stretchy=\"false\">&#8721;</mo><mrow><mi>&#160;</mi><msub><mrow><mi>f</mi></mrow><mrow><mi>e</mi><mi>x</mi><mi>t</mi></mrow></msub></mrow></mrow><mo>=</mo><mi>m</mi><msub><mrow><mi>a</mi></mrow><mrow><mi>c</mi><mi>m</mi></mrow></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>l</mi><mi>s</mi><mi>o</mi><mi>&#160;</mi><mo>&#8721;</mo><msub><mi>&#964;</mi><mrow><mi>e</mi><mi>x</mi><mi>t</mi></mrow></msub><mo>=</mo><msub><mi>I</mi><mrow><mi>c</mi><mi>m</mi></mrow></msub><mi>&#945;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#10233;</mo><msub><mi>f</mi><mi>s</mi></msub><mi>&#160;</mi><mi>R</mi><mo>=</mo><msub><mi>I</mi><mrow><mi>c</mi><mi>m</mi></mrow></msub><mi>&#945;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#10233;</mo><msub><mi>f</mi><mi>s</mi></msub><mi>&#160;</mi><mi>R</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>&#160;</mi><mi>m</mi><msup><mi>R</mi><mn>2</mn></msup><mi>&#945;</mi></math> ..... (2)<br /><br />For rolling without slipping<br /><br /><br /><img alt=\"\" height=\"127\" src=\"assets\\st0204_9765cfae8b53.jpg\" width=\"232\" /><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mi>R</mi><mi>&#945;</mi></math> ...... (3)<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#10233;</mo><mi>&#160;</mi><mi>&#945;</mi><mo>=</mo><mfrac><mi>a</mi><mi>R</mi></mfrac></math><br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><msub><mrow><mi>f</mi></mrow><mrow><mi>s</mi></mrow></msub><mi>&#160;</mi><mi>R</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup><mfrac><mrow><mi>a</mi></mrow><mrow><mi>R</mi></mrow></mfrac></math><br /><br /><math><mo>&#10233;</mo><mi>&#160;</mi><msub><mrow><mi>f</mi></mrow><mrow><mi>s</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><mi>a</mi></math><br /><br />Put in (1)<br /><br /><math><mi>F</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><mi>a</mi><mo>=</mo><mi>m</mi><mi>a</mi></math><br /><br /><math><mo>&#10233;</mo><mi>F</mi><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><mi>a</mi><mi>&#160;</mi></math>"
  }
