      "image": null,
      "isCorrect": false
    },
    {
      "id": "nTRV7",
      "text": "<math><mfrac><mrow><mi>M</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>16</mn><msqrt><mn>2</mn></msqrt><mi>π</mi></mrow></mfrac></math>",
