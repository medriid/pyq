  "question": {
    "text": "From a solid sphere of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> and radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>, a cube of the maximum possible volume is cut. Moment of inertia of cube about an axis passing through its centre and perpendicular to one of its faces is:",
    "image": null
  },
  "options": [
    {
      "id": "fuMSR",
      "text": "<math><mfrac><mrow><mn>4</mn><mi>M</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt><mi>π</mi></mrow></mfrac></math>",
