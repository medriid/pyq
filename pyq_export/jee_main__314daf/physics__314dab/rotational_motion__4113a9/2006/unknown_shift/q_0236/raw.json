  "question": {
    "text": "Four point masses, each of value $\\mathrm{m}$, are placed at the corners of a square $A B C D$ of side $\\ell$. The moment of inertia through $A$ and parallel to $B D$ is",
    "image": null
  },
  "options": [
    {
      "id": "3omnw",
      "text": "\n$\\mathrm{m} \\ell^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ya0un",
      "text": "\n$2 \\mathrm{~m} \\ell^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9rD67",
      "text": "\n$3 m \\ell^2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uYPs6",
      "text": "\n$3 \\mathrm{~m} \\ell^2$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{I}=2 \\mathrm{~m}(\\ell / \\sqrt{2})^2=3 \\mathrm{~m} \\ell^2$",
    "image": null
  },
