  "question": {
    "text": "In the wave equation&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>5</mn><mi>sin</mi><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><mi>&#955;</mi></mfrac><mfenced><mrow><mn>400</mn><mi>t</mi><mo>-</mo><mi>x</mi></mrow></mfenced><mi>m</mi></math>&nbsp;the velocity of the wave will be :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": false
