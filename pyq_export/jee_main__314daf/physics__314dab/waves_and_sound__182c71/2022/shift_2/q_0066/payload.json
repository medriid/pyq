    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#215;</mo><msup><mn>10</mn><mn>8</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>13</mn><mo>&#215;</mo><msup><mn>10</mn><mn>5</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#215;</mo><msup><mn>10</mn><mn>10</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>.</mo><mn>48</mn><mo>&#215;</mo><msup><mn>10</mn><mn>5</mn></msup><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
