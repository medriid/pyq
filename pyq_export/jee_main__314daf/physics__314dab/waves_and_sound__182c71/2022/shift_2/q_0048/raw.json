  "question": {
    "text": "Sound travels in a mixture of two moles of helium and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> moles of hydrogen. If rms speed of gas molecules in the mixture is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>2</mn></msqrt></math> times the speed of sound, then the value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> will be",
    "image": null
  },
  "options": [
    {
      "id": "r0V21",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
