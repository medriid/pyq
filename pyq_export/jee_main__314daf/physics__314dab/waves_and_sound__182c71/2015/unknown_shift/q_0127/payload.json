    {
      "text": "Graph B with slope  <math><mo>=</mo><mfrac><mrow><msub><mrow><mi>f</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mfenced separators=\"|\"><mrow><mi>v</mi><mo>-</mo><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "Graph B with slope  <math><mo>=</mo><mfrac><mrow><msub><mrow><mi>f</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mfenced separators=\"|\"><mrow><mi>v</mi><mo>+</mo><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow></mfenced></mrow></mfrac></math>",
