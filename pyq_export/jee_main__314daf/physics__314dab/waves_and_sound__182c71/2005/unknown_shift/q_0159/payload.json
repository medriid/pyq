  "question": {
    "text": "An observer moves towards a stationary source of sound, with a velocity one fifth of the velocity of sound. What is the percentage increase in the apparent frequency?"
  },
  "options": [
    {
      "text": "\nzero\n",
      "is_correct": false
    },
    {
      "text": "\n$0.5 \\%$\n",
      "is_correct": false
    },
    {
      "text": "\n$5 \\%$\n",
      "is_correct": false
    },
    {
      "text": "\n$20 \\%$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\nf=\\frac{v+v / 5}{v} f=\\frac{6 f}{5}\n$$\n$\\%$ increase in frequency $=20 \\%$"
  }
