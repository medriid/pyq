  "question": {
    "text": "While measuring the speed of sound by performing a resonance column experiment, a student gets the first resonance condition at a column length of $18 \\mathrm{~cm}$ during winter. Repeating the same experiment during summer, she measures the column length to be $\\mathrm{xcm}$ for the second resonance. Then",
    "image": null
  },
  "options": [
    {
      "id": "LXQSK",
      "text": "\n$18>x$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KQhCV",
      "text": "\n$x>54$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "J2nhw",
      "text": "\n$54>x>36$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tvBHn",
      "text": "\n$36>x>18$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& n=\\frac{1}{4 x} \\sqrt{\\frac{\\gamma R T}{M}} \\\\\n& x n=\\frac{1}{4} \\sqrt{\\frac{\\gamma R T}{M}} \\\\\n& x \\propto \\sqrt{T}\n\\end{aligned}\n$$",
    "image": null
  },
