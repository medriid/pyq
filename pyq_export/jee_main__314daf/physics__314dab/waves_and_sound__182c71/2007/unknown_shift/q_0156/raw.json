  "question": {
    "text": "A sound absorber attenuates the sound level by $20 \\mathrm{~dB}$. The intensity decreases by a factor of",
    "image": null
  },
  "options": [
    {
      "id": "iwjzB",
      "text": "\n$1000$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "q5S0A",
      "text": "\n$10000$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WKgKh",
      "text": "\n$10$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "09v83",
      "text": "\n$100$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{B}_1=10 \\log \\left(\\frac{\\mathrm{I}}{\\mathrm{I}_0}\\right) \\\\\n& \\mathrm{B}_2=\\log \\left(\\frac{\\mathrm{I}^{\\prime}}{\\mathrm{I}_0}\\right)\n\\end{aligned}$\ngiven $B_2-B_1=20$\n$\\begin{aligned}\n& 20=10 \\log \\left(\\frac{\\mathrm{I^{\\prime}}}{\\mathrm{I}}\\right) \\\\\n& \\mathrm{I}^{\\prime}=100 \\mathrm{I}\n\\end{aligned}$",
