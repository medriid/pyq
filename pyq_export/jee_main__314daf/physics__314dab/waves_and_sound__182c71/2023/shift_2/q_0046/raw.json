  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td><strong>List I</strong></td>\t\t\t<td>&nbsp;</td>\t\t\t<td><strong>List II</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td>Troposphere</td>\t\t\t<td>I</td>\t\t\t<td>Approximate <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>65</mn><mo>-</mo><mn>75</mn><mo>&#160;</mo><mi>km</mi></math> over Earth&rsquo;s surface</td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td>E-Part of Stratosphere</td>\t\t\t<td>II</td>\t\t\t<td>Approximate <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>300</mn><mo>&#160;</mo><mi>km</mi></math> over Earth&rsquo;s surface</td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mn>2</mn></msub></math>-Part of Thermosphere</td>\t\t\t<td>III</td>\t\t\t<td>Approximate <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>km</mi></math> over Earth&rsquo;s surface</td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td>D-Part of Stratosphere</td>\t\t\t<td>IV</td>\t\t\t<td>Approximate <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>&#160;</mo><mi>km</mi></math> over Earth&rsquo;s surface</td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below :</p>",
    "image": null
  },
