  "question": {
    "text": "The equation of a wave on a string of linear mass density $0.04 \\mathrm{~kg} \\mathrm{~m}^{-1}$ is given by $y=0.02(\\mathrm{~m}) \\sin \\left[2 \\pi\\left(\\frac{\\mathrm{t}}{0.04(\\mathrm{~s})}-\\frac{\\mathrm{x}}{0.50(\\mathrm{~m})}\\right)\\right]$. The tension in the string is"
  },
  "options": [
    {
      "text": "\n$4.0 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$12.5 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.5 \\mathrm{~N}$\n",
      "is_correct": false
    },
    {
      "text": "\n$6.25 \\mathrm{~N}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{T}=\\mu \\mathrm{v}^2=\\mu \\frac{\\omega^2}{\\mathrm{k}^2}=0.04 \\frac{(2 \\pi / 0.004)^2}{(2 \\pi / 0.50)^2}=6.25 \\mathrm{~N}$"
  }
}