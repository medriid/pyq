  "question": {
    "text": "A wave $y=a \\sin (\\omega t-k x)$ on a string meets with another wave producing a node at $x=0$. Then the equation of the unknown wave is",
    "image": null
  },
  "options": [
    {
      "id": "nBk12",
      "text": "\n$y=a \\sin (\\omega t+k x)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CE2In",
      "text": "\n$y=-a \\sin (\\omega t+k x)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XJKXR",
      "text": "\n$\\mathrm{y}=\\mathrm{a} \\sin (\\omega \\mathrm{t}-\\mathrm{kx})$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yq4li",
      "text": "\n$\\mathrm{y}=-\\mathrm{a} \\sin (\\omega \\mathrm{t}-\\mathrm{kx})$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$y_1+y_2=a \\sin (\\omega t-k x)-a \\sin (\\omega t+k x)$\n$=-2 a \\cos \\omega t \\times \\sin k x \\Rightarrow y_1+y_2=0$ at $x=0$",
    "image": null
  },
