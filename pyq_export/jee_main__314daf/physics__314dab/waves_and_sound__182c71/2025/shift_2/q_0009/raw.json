  "question": {
    "text": "The equation of a wave travelling on a string is $\\mathrm{y}=\\sin [20 \\pi \\mathrm{x}+10 \\pi \\mathrm{t}]$, where x and t are distance and time in SI units. The minimum distance between two points having the same oscillating speed is :",
    "image": null
  },
  "options": [
    {
      "id": "n82nO",
      "text": "5.0 cm",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "lTYNM",
      "text": "20 cm",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "F6gdI",
      "text": "10 cm",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Y57uX",
      "text": "2.5 cm",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Minimum distance between 2 points having same speed is $\\frac{\\lambda}{2}$.<br/>$\\lambda=\\frac{2 \\pi}{\\mathrm{k}}=\\frac{1}{10} \\mathrm{~m}=10 \\mathrm{~cm}$<br/>$\\text { Distance }=\\frac{\\lambda}{2}=5 \\mathrm{~cm}$",
    "image": null
  },
