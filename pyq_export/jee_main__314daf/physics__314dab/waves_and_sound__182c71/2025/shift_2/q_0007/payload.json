  "question": {
    "text": "A sinusoidal wave of wavelength 7.5 cm travels a distance of 1.2 cm along the x -direction in 0.3 sec. The crest $P$ is at $x=0$ at $t=0 \\mathrm{sec}$ and maximum displacement of the wave is 2 cm. Which equation correctly represents this wave ?"
  },
  "options": [
    {
      "text": "$y=2 \\cos (0.83 x-3.35 t) \\mathrm{cm}$",
      "is_correct": true
    },
    {
      "text": "$y=2 \\sin (0.83 x-3.5 t) \\mathrm{cm}$",
      "is_correct": false
    },
    {
      "text": "$y=2 \\cos (3.35 x-0.83 t) \\mathrm{cm}$",
      "is_correct": false
    },
    {
      "text": "$y=2 \\cos (0.13 x-0.5 t) \\mathrm{cm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\mathrm{v}=\\frac{\\text { distance }}{\\text { time }} \\\\\n& \\mathrm{v}=\\frac{12}{0.3}=4 \\mathrm{~cm} / \\mathrm{s} \\\\\n& \\mathrm{k}=\\frac{2 \\pi}{\\lambda}=\\frac{2 \\pi}{7.5}=\\frac{4 \\pi}{15}=0.83 \\\\\n& \\mathrm{v}=\\frac{\\omega}{\\mathrm{k}} \\Rightarrow \\omega=\\mathrm{vk}=4 \\times \\frac{4 \\pi}{15}=3.35<br/>\\end{aligned}$<br/>So $y=A \\cos (k x-\\omega t)$"
  }
