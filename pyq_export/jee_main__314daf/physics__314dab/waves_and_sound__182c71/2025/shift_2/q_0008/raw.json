  "question": {
    "text": "Two strings with circular cross section and made of same material, are stretched to have same amount of tension. A transverse wave is then made to pass through both the strings. The velocity of the wave in the first string having the radius of cross section R is $\\mathrm{v}_1$, and that in the other string having radius of cross section $R / 2$ is $v_2$. Then $\\frac{v_2}{v_1}=$",
    "image": null
  },
  "options": [
    {
      "id": "6TR2Q",
      "text": "$\\sqrt{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jRSR6",
      "text": "2",
      "image": null,
      "isCorrect": true
    },
    {
