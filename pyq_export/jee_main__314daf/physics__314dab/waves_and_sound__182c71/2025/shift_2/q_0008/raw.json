    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & v=\\sqrt{\\frac{T}{\\mu}}=\\sqrt{\\frac{T}{f \\pi R^2}} \\\\ & \\frac{v_2}{v_1}=\\frac{R_1}{R_2}=2\\end{aligned}$",
    "image": null
