  "question": {
    "text": "Displacement of a wave is expressed as $x(t)=5 \\cos \\left(628 t+\\frac{\\pi}{2}\\right) m$. The wavelength of the wave when its velocity is $300 \\mathrm{~m} / \\mathrm{s}$ is :"
  },
  "options": [
    {
      "text": "5 m",
      "is_correct": false
    },
    {
      "text": "3 m",
      "is_correct": true
    },
    {
      "text": "0.5 m",
      "is_correct": false
    },
    {
      "text": "0.33 m",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{x}(\\mathrm{t})=5 \\cos \\left[628 \\mathrm{t}+\\frac{\\pi}{2}\\right] \\mathrm{m} \\\\ & \\text { velocity }\\left(\\mathrm{v}_\\omega\\right)=300 \\mathrm{~m} / \\mathrm{s} \\\\ & \\mathrm{v}_{\\mathrm{w}}=\\frac{\\omega}{\\mathrm{K}} \\\\ & 300=\\frac{628}{\\mathrm{~K}} \\Rightarrow \\mathrm{~K}=\\frac{628}{300} \\\\ & \\frac{2 \\pi}{\\lambda}=\\frac{628}{300} \\Rightarrow \\lambda=\\frac{2 \\times 3.14 \\times 300}{628} \\\\ & \\lambda=2 \\mathrm{~m}\\end{aligned}$"
  }
}