  "level": 2,
  "question": {
    "text": "Equation of travelling wave on a stretched string of linear density $5 \\mathrm{~g} / \\mathrm{m}$ is $\\mathrm{y}=0.03 \\sin (450 \\mathrm{t}-9 \\mathrm{x})$ where distance and time are measured in SI units. The tension in the string is:",
    "image": null
  },
  "options": [
    {
      "id": "IMWeR",
      "text": "$10 \\mathrm{~N}$",
      "isCorrect": false,
      "image": null
    },
    {
