  "level": 1,
  "question": {
    "text": "A closed organ pipe has a fundamental frequency of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1.5</mn><mtext>&#8201;</mtext><mi>kHz</mi></math>. The number of overtones that can be distinctly heard by a person with this organ pipe will be&nbsp;<math><mo>(</mo></math>Assume that the highest frequency a person can hear is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20,000</mn><mtext>&#8201;</mtext><mi>Hz</mi></math>).",
    "image": null
  },
  "options": [
    {
      "id": "jLhzT",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math>",
      "isCorrect": false,
