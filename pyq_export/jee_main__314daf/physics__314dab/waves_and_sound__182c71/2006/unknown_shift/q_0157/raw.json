  "question": {
    "text": "A string is stretched between fixed points separated by $75 \\mathrm{~cm}$. It is observed to have resonant frequencies of $420 \\mathrm{~Hz}$ and $315 \\mathrm{~Hz}$. There are no other resonant frequencies between these two. Then, the lowest resonant frequency for this string is",
    "image": null
  },
  "options": [
    {
      "id": "BMiu4",
      "text": "\n$10.5 \\mathrm{~Hz}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "q9ll7",
      "text": "\n$105 \\mathrm{~Hz}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "4SlRN",
      "text": "\n$1.05 \\mathrm{~Hz}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1TaFp",
      "text": "\n$1050 \\mathrm{~Hz}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\mathrm{n}}{2 \\ell}(\\mathrm{v})=315, \\frac{(\\mathrm{n}+1)}{2 \\ell} \\mathrm{v}=420$\nSolving $\\frac{\\mathrm{v}}{2 \\ell}=105$",
    "image": null
  },
