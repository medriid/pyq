  "question": {
    "text": "A whistle producing sound waves of frequencies $9500 \\mathrm{~Hz}$ and above is approaching a stationary person with speed $v \\mathrm{~ms}^{-1}$. The velocity of sound in air is $300 \\mathrm{~ms}^{-1}$. If the person can hear frequencies upto a maximum of $10,000 \\mathrm{~Hz}$, the maximum value of $\\mathrm{v}$ upto which he can hear the whistle is"
  },
  "options": [
    {
      "text": "\n$30 \\mathrm{~ms}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$15 \\sqrt{2} \\mathrm{~ms}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$15 / \\sqrt{2} \\mathrm{~ms}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$15 \\mathrm{~ms}^{-1}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$f_{a p p}=\\frac{f(300)}{300-v} \\Rightarrow v=15 \\mathrm{~m} / \\mathrm{s}$"
  }
}