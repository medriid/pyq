  "question": {
    "text": "A reagent which gives brilliant red precipitate with Nickel ions in basic medium is  ",
    "image": null
  },
  "options": [
    {
      "id": "Kz3xv",
      "text": "sodium nitroprusside",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BATFF",
      "text": "neutral <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>FeCl</mi><mn>3</mn></msub></math>",
      "image": null,
      "isCorrect": false
    },
    {
