  "question": {
    "text": "During the detection of acidic radical present in a salt, a student gets a pale yellow precipitate soluble with difficulty in \\(\\mathrm{NH}_4 \\mathrm{OH}\\) solution when sodium carbonate extract was first acidified with dil. \\(\\mathrm{HNO}_3\\) and then \\(\\mathrm{AgNO}_3\\) solution was added. This indicates presence of :"
  },
  "options": [
    {
      "text": "\\(\\mathrm{Br}^{-}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\mathrm{I}^{-}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{Cl}^{-}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{CO}_3{ }^{2-}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{array}{ll}\n\\mathrm{Ag}^{+}+\\mathrm{I}^{-} \\rightarrow \\mathrm{AgI} & \\text{Yellow ppt.} \\\\\n\\mathrm{Ag}^{+}+\\mathrm{Cl}^{-} \\rightarrow \\mathrm{AgCl} & \\text{White ppt} \\\\\n\\mathrm{Ag}^{+}+\\mathrm{Br}^{-} \\rightarrow \\mathrm{AgBr} & \\text{Pale yellow ppt}\n\\end{array}$"
  }
}