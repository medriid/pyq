  "question": {
    "text": "When a salt is treated with sodium hydroxide solution it gives gas $\\mathrm{X}$. On passing gas $\\mathrm{X}$ through reagent $\\mathrm{Y}$ a brown coloured precipitate is formed. $\\mathrm{X}$ and $\\mathrm{Y}$ respectively, are"
  },
  "options": [
    {
      "text": "$\\mathrm{X}=\\mathrm{NH}_3$ and $\\mathrm{Y}=\\mathrm{HgO}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{X}=\\mathrm{NH}_3$ and $\\mathrm{Y}=\\mathrm{K}_2 \\mathrm{HgI}_4+\\mathrm{KOH}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{X}=\\mathrm{NH}_4 \\mathrm{Cl}$ and $\\mathrm{Y}=\\mathrm{KOH}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{X}=\\mathrm{HCl}$ and $\\mathrm{Y}=\\mathrm{NH}_4 \\mathrm{Cl}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{NH}_4^{+}+\\mathrm{NaOH} \\longrightarrow \\mathrm{H}_2 \\mathrm{O}+\\mathrm{NH}_3 \\uparrow$<br /><img src=\"assets\\st0000_96c81ba6423a.png\"/><br />$\\mathrm{NH}_3$ is identify by $\\mathrm{K}_2\\left[\\mathrm{HgI}_4\\right]+\\mathrm{KOH}$"
  }
