  "question": {
    "text": "In the presence of a small amount of phosphorous, aliphatic carboxylic acid reacts with chlorine or bromine to yield a reaction in which,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#945;</mi><mo>-</mo></math>hydrogen&nbsp;is&nbsp;been replaced by halogen. This reaction is known as"
  },
  "options": [
    {
      "text": "Etard reaction",
      "is_correct": false
    },
    {
      "text": "Wolff-Kischner reaction",
      "is_correct": false
    },
    {
      "text": "Rosenmund reaction",
      "is_correct": false
    },
    {
      "text": "Hell-volhard-zelinsky reaction",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<p>This reaction is known as HVZ reaction.<img src=\"assets\\st0058_17d17d62c2ef.png\" style=\"width: 522px; height: 102px;\" /></p><p><span style=\"color: rgb(0, 0, 0); font-family: Arial, Helvetica, &quot;sans serif&quot;;\">Treatment with bromine and a catalytic amount of phosphorus leads to the selective <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#945;</mi><mo>-</mo></math>bromination of carboxylic acids.</span></p>"
  }
