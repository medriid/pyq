    "text": "<p>Match List - I with List - II.</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>List - I<br />\t\t\t(Chemical Reaction)</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>List - II<br />\t\t\t(Reagent used)</td>\t\t</tr>\t\t<tr>\t\t\t<td>a</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>COOCH</mi><mn>2</mn></msub><msub><mi>CH</mi><mn>3</mn></msub><mo>&#8594;</mo><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mi>OH</mi></math></td>\t\t\t<td>i</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mi>MgBr</mi><mo>/</mo><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub><msup><mi mathvariant=\"normal\">O</mi><mo>+</mo></msup></math><br />\t\t\t(one equivalent)</td>\t\t</tr>\t\t<tr>\t\t\t<td>b</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>COOCH</mi><mn>3</mn></msub><mo>&#8594;</mo><msub><mi>CH</mi><mn>3</mn></msub><mi>CHO</mi></math></td>\t\t\t<td>ii</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub><mo>/</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>c</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mi mathvariant=\"normal\">C</mi><mo>&#8801;</mo><mi mathvariant=\"normal\">N</mi><mo>&#8594;</mo><msub><mi>CH</mi><mn>3</mn></msub><mi>CHO</mi></math></td>\t\t\t<td>iii</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>DIBAL</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi><mo>/</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>d</td>\t\t\t<td><img src=\"assets\\qt00