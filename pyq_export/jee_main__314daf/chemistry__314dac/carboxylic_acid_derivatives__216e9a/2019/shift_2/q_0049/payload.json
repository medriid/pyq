    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mi mathvariant=\"normal\">A</mi></mfenced><mo>&#60;</mo><mfenced separators=\"|\"><mi mathvariant=\"normal\">B</mi></mfenced><mo>&#60;</mo><mfenced separators=\"|\"><mi mathvariant=\"normal\">D</mi></mfenced><mo>&#60;</mo><mfenced separators=\"|\"><mi mathvariant=\"normal\">C</mi></mfenced></math>",
      "is_correct": true
