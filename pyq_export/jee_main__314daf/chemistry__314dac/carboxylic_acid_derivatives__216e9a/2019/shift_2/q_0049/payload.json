    {
      "text": "<math><mfenced separators=\"|\"><mrow><mi>B</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>A</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>C</mi></mrow></mfenced><mo>&lt;</mo><mfenced separators=\"|\"><mrow><mi>D</mi></mrow></mfenced></math>",
