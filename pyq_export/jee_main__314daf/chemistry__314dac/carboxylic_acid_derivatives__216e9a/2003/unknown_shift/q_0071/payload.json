  "question": {
    "text": "When $\\mathrm{CH}_2=\\mathrm{CH}-\\mathrm{COOH}$ is reduced with $\\mathrm{LiAlH}_4$, the compound obtained will be"
  },
  "options": [
    {
      "text": "\n$\\mathrm{CH}_2=\\mathrm{CH}-\\mathrm{CH}_2 \\mathrm{OH}$\n",
      "is_correct": true
    },
    {
