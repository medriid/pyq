      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{CH}_3-\\mathrm{CH}_2-\\mathrm{CHO}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{CH}_3-\\mathrm{CH}_2-\\mathrm{COOH}$",
      "is_correct": false
