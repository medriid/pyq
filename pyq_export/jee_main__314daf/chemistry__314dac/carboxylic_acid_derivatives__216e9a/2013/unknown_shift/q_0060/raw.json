  "question": {
    "text": "An organic compound A upon reacting with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NH</mi><mn>3</mn></msub></math><sub>&nbsp;</sub>gives B. On heating, B gives C. C in presence of KOH reacts with Br<sub>2</sub> to give CH<sub>3</sub>CH<sub>2</sub>NH<sub>2</sub>. A is :",
    "image": null
  },
  "options": [
    {
      "id": "oSoiq",
      "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9c7283c3-2dd8-42ca-b561-61a2f3b4dfb0-image.png\" style=\"width: 182px; height: 78px;\" />",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0fXTu",
      "text": "<math> <mrow> <msub> <mtext>CH</mtext> <mn>3</mn> </msub> <msub> <mtext>CH</mtext> <mn>2</mn> </msub> <mtext>COOH</mtext> </mrow> </math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hmQl9",
      "text": "<math><mrow>  <msub>          <mtext>CH</mtext>        <mn>3</mn>  </msub>  <mtext>COOH</mtext></mrow></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GRgZW",
      "text": "<math><mrow>  <msub>          <mtext>CH</mtext>        <mn>3</mn>  </msub>  <msub>          <mtext>CH</mtext>        <mn>2</mn>  </msub>  <msub>          <mtext>CH</mtext>        <mn>2</mn>  </msub>  <mtext>COOH</mtext></mrow></math>",
      "image": null,
      "isCorrect": false
