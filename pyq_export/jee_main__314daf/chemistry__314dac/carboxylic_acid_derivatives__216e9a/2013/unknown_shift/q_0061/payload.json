  ],
  "solution": {
    "text": "<p style=\"text-align: justify;\">Ammonia reacts with carboxylic acid to form ammonium carboxylate (B). Which on heating form amide (C). Amide on reaction with bromine and KOH&nbsp;undergo Hoffmann Bromamide reaction to form amine with one carbon less.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable><mtr><mtd><msub><mi>CH</mi><mn>3</mn></msub><mo>&#8722;</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>&#8722;</mo><mover><mi mathvariant=\"normal\">C</mi><munder><mi mathvariant=\"normal\">O</mi><mrow><mo>|</mo><mo>|</mo></mrow></munder></mover><mo>&#8722;</mo><mi>OH</mi><mo>+</mo><msub><mi>NH</mi><mn>3</mn></msub></mtd></mtr><mtr><mtd><mo>(</mo><mi mathvariant=\"normal\">A</mi><mo>)</mo></mtd></mtr></mtable><mover><mo>&#8594;</mo><mrow></mrow></mover><mtable><mtr><mtd><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#8722;</mo><mover><mi mathvariant=\"normal\">C</mi><munder><mi mathvariant=\"normal\">O</mi><mrow><mo>|</mo><mo>|</mo></mrow></munder></mover><mo>&#8722;</mo><msup><mi mathvariant=\"normal\">O</mi><mo>&#8854;</mo></msup></mtd></mtr><mtr><mtd><mo>(</mo><mi mathvariant=\"normal\">B</mi><mo>)</mo></mtd></mtr></mtable><mover><mi mathvariant=\"normal\">N</mi><mo>&#8853;</mo></mover><msub><mi mathvariant=\"normal\">H</mi><mn>4</mn></msub><mspace linebreak=\"newline\"></mspace><mtable><mtr><mtd><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#8722;</mo><mover><mi mathvariant=\"normal\">C</mi><munder><mi mathvariant=\"normal\">O</mi><mrow><mo>|</mo><mo>|</mo></mrow></munder></mover><mo>&#8722;</mo><msup><mi mathvariant=\"normal\">O</mi><mo>&#8854;</mo></msup></mtd></mtr><mtr><mtd><mo>(</mo><mi mathvariant=\"normal\">B</mi><mo>)</mo></mtd></mtr></mtable><mover><mi mathvariant=\"normal\">N</mi><mo>&#8853;</mo></mover><msub><mi mathvariant=\"normal\">H</mi><mn>4</mn></msub><mover><mo>&#8594;</mo><mi mathvariant=\"normal\">&#916;</mi></mover><mtable><mtr><mtd><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#8722;</mo><mover><mi mathvariant=\"normal\">C</mi><munder><mi mathvariant=\"normal\">O</mi><mrow><mo>|</mo><mo>|</mo></mrow></munder></mover><mo>&#8722;</mo><msub><mi>NH</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd><mo>(</mo><mi mathvariant=\"normal\">C</mi><mo>)</mo></mtd></mtr></mtable><mspace linebreak=\"newline\"></mspace><mtable><mtr><mtd><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#8722;</mo><mover><mi mathvariant=\"normal\">C</mi><munder><mi mathvariant=\"normal\">O</mi><mrow><mo>|</mo><mo>|</mo></mrow></munder></mover><mo>&#8722;</mo><msub><mi>NH</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd><mo>(</mo><mi mathvariant=\"normal\">C</mi><mo>)</mo></mtd></mtr></mtable><munderover><mo>&#8594;</mo><mrow><mo>(</mo><mi>Hoffmann</mi><mo>&#160;</mo><mi>bromamide</mi><mo>&#160;</mo><mi>degradation</mi><mo>)</mo></mrow><mrow><msub><mi>Br</mi><mn>2</mn></msub><mo>/</mo><mi>KOH</mi></mrow></munderover><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mo>&#8722;</mo><msub><mi>NH</mi><mn>2</mn></msub></math></p>"
  }
