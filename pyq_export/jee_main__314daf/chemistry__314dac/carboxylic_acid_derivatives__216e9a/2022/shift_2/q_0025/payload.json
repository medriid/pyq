  "question": {
    "text": "<p>The reagent, from the following, which converts benzoic acid to benzaldehyde in one step is</p><p><img src=\"assets\\qt0025_4db6d8fdd710.png\" style=\"width: 300px; height: 159px;\" /></p>"
  },
