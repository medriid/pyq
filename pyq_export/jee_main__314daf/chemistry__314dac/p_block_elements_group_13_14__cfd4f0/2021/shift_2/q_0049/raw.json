      "isCorrect": false,
      "image": null
    },
    {
      "id": "w1N5A",
      "text": "It contains <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn></math> six-membered rings and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn></math> five-membered rings.",
      "isCorrect": true,
