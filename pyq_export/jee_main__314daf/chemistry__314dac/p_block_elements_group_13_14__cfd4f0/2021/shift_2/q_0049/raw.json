  "question": {
    "text": "The INCORRECT statement regarding the structure of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>60</mn></msub></math> is :",
    "image": null
  },
  "options": [
