  "question": {
    "text": "In which one of the following molecules strongest back donation of an electron pair from halide to boron is expected?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BI</mi><mn>3</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BBr</mi><mn>3</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BCl</mi><mn>3</mn></msub></math>",
      "is_correct": false
    },
