  "question": {
    "text": "The number of neutrons present in the more abundant isotope of boron is ' \\(x\\) '. Amorphous boron upon heating with air forms a product, in which the oxidation state of boron is ' \\(y\\) '. The value of \\(x+y\\) is _______",
    "image": null
  },
  "options": [
    {
      "id": "KirYM",
      "text": "3",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rIgIE",
      "text": "9",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "6tz6Y",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qDZK0",
      "text": "6",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "More abundant isotope $=\\mathrm{B}^{11}$\n[Number of neutrons $=6$ ]\n$\\begin{aligned}\n& \\mathrm{x}=6 \\\\\n& \\mathrm{~B}+\\mathrm{O}_2 \\rightarrow \\mathrm{B}_2 \\mathrm{O}_3\n\\end{aligned}$\nOxidation state of $\\mathrm{B}$ in $\\mathrm{B}_2 \\mathrm{O}_3=+3$\nSo, $y=3$\nHence $x+y=9$",
    "image": null
  },
