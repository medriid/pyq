  "question": {
    "text": "The relative stability of +1 oxidation state of group 13 elements follows the order"
  },
  "options": [
    {
      "text": "$\\mathrm{Al}  < \\mathrm{Ga} < \\mathrm{Tl} < \\mathrm{In}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{T} 1  < \\mathrm{In} < \\mathrm{Ga} < \\mathrm{Al}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Ga}  < \\mathrm{Al} < \\ln < \\mathrm{Tl}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Al}  < \\mathrm{Ga} < \\mathrm{In} < \\mathrm{Tl}$",
      "is_correct": true
