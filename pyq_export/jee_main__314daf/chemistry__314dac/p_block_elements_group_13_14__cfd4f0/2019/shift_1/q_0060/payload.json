    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">n</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">i</mi><mo>≈</mo><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">e</mi></math>",
