  "question": {
    "text": "The correct order of catenation is:"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">e</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">n</mi><mo>&gt;</mo><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">i</mi><mo>&gt;</mo><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\"> </mi></math>",
