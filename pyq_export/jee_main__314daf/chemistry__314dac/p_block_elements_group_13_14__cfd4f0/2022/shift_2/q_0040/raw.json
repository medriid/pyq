  "question": {
    "text": "Aqueous solution of which of the following boron compounds will be strongly basic in nature?",
    "image": null
  },
  "options": [
    {
      "id": "Lm4RW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NaBH</mi><mn>4</mn></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "o5DDU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>LiBH</mi><mn>4</mn></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SFcQA",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "f6cKN",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Na</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">B</mi><mn>4</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>7</mn></msub></math>",
      "isCorrect": true,
      "image": null
