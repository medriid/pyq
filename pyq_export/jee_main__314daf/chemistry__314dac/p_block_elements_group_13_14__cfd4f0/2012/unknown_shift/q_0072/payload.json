  "question": {
    "text": "Which of the oxide groups among the following cannot be reduced by carbon?"
  },
  "options": [
    {
      "text": "\n$\\mathrm{Cu}_2 \\mathrm{O}, \\mathrm{SnO}_2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{CaO}, \\mathrm{K}_2 \\mathrm{O}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{PbO}, \\mathrm{Fe}_2 \\mathrm{O}_4$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{Fe}_2 \\mathrm{O}_3, \\mathrm{ZnO}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{Ca}$ and $\\mathrm{K}$ are strong reducing agents, hence their oxides can not be reduced with carbon."
