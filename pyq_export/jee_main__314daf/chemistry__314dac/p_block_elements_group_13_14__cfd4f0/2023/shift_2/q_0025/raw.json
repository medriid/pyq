  "question": {
    "text": "Structures of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BeCl</mi><mn>2</mn></msub></math> in solid state, vapour phase and at very high temperature respectively are:",
    "image": null
  },
  "options": [
    {
      "id": "AZPxo",
      "text": "Monomeric, Dimeric, Polymeric",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AWds8",
      "text": "Dimeric, Polymeric, Monomeric",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YYOsC",
      "text": "Polymeric, Monomeric, Dimeric",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LTmrS",
      "text": "Polymeric, Dimeric, Monomeric",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BeCl</mi><mn>2</mn></msub></math> is dimeric in vapour phase. The coordination number of beryllium is 3.</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/b3b131b1-ffd4-4e27-8542-3c25560c2fb7-image.png\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BeCl</mi><mn>2</mn></msub></math> is monomeric at high temperature.&nbsp;The coordination number of beryllium is 2.</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/72621e97-2f1c-4a77-9c3d-9db8600412f0.png\" style=\"width: 210px; height: 56px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BeCl</mi><mn>2</mn></msub></math> is polymeric in solid state.&nbsp;The coordination number of beryllium is 4.</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f6c16fe5-3a98-4ed7-86e6-8c49b5411c03-image.png\" /></p></blockquote>",
    "image": null
  },
