  "question": {
    "text": "The ppm level of $\\mathrm{F}^{-}$in a $500 \\mathrm{~g}$ sample of a tooth paste containing $0.2 \\mathrm{~g} \\mathrm{~F}^{-}$is"
  },
  "options": [
    {
      "text": "\n400\n",
      "is_correct": true
    },
    {
      "text": "\n1000\n",
      "is_correct": false
    },
    {
      "text": "\n250\n",
      "is_correct": false
    },
    {
      "text": "\n200",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\text { ppm } & =\\frac{\\text { wt. of solute }}{\\text { wt. of solvent }} \\times 10^6 \\\\ & =\\frac{0.2}{500} \\times 10^6=400\\end{aligned}$"
  }
}