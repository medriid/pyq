  "question": {
    "text": "$\\mathrm{K}_{\\mathrm{f}}$ for water is $1.86 \\mathrm{~K} \\mathrm{~kg} \\mathrm{~mol}^{-1}$. If your automobile radiator holds $1.0 \\mathrm{~kg}$ of water, how many grams of ethylene glycol $\\left(\\mathrm{C}_2 \\mathrm{H}_6 \\mathrm{O}_2\\right)$ must you add to get the freezing point of the solution lowered to $-2.8^{\\circ} \\mathrm{C}$ ?",
    "image": null
  },
  "options": [
    {
      "id": "EFyb6",
      "text": "\n$72 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6kchQ",
      "text": "\n$93 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "KDmQO",
      "text": "\n$39 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RQolW",
      "text": "\n$27 \\mathrm{~g}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\mathrm{T}_{\\mathrm{f}}=\\mathrm{K}_{\\mathrm{f}} \\cdot \\mathrm{m}$\n$2.8=1.86 \\times \\frac{\\mathrm{wt}}{62} \\times \\frac{1000}{1000}$\n$\\mathrm{Wt}=93 \\mathrm{~g}$",
    "image": null
  },
