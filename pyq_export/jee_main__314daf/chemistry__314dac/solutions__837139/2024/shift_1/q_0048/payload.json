  "question": {
    "text": "The Molarity \\((\\mathrm{M})\\) of an aqueous solution containing \\(5.85 \\mathrm{~g}\\) of NaCl in \\(500 \\mathrm{~mL}\\) water is : (Given : Molar Mass \\(\\mathrm{Na}: 23\\) and \\(\\mathrm{Cl}: 35.5 \\mathrm{gmol}^{-1}\\) )"
  },
  "options": [
    {
      "text": "2",
      "is_correct": false
    },
    {
      "text": "20",
      "is_correct": false
    },
    {
      "text": "4",
      "is_correct": false
    },
    {
      "text": "0.2",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{M}=\\frac{\\mathrm{n}_{\\mathrm{NaCl}}}{\\left.\\mathrm{V}_{\\mathrm{sol}} \\text { (in } \\mathrm{L}\\right)} \\\\ & \\mathrm{M}=\\frac{\\frac{5.85}{58.5}}{0.5}=0.2 \\mathrm{M}\\end{aligned}$"
  }
