  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{M}=\\frac{\\mathrm{n}_{\\mathrm{NaCl}}}{\\left.\\mathrm{V}_{\\mathrm{sol}} \\text { (in } \\mathrm{L}\\right)} \\\\ & \\mathrm{M}=\\frac{\\frac{5.85}{58.5}}{0.5}=0.2 \\mathrm{M}\\end{aligned}$",
