  "question": {
    "text": "Identify the mixture that shows positive deviations from Raoult's Law"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><msub><mi>CH</mi><mn>3</mn></msub><msub><mo>)</mo><mn>2</mn></msub><mi>CO</mi><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CHCl</mi><mn>3</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CHCl</mi><mn>3</mn></msub><mo>+</mo><mo>(</mo><msub><mi>CH</mi><mn>3</mn></msub><msub><mo>)</mo><mn>2</mn></msub><mi>CO</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><msub><mi>CH</mi><mn>3</mn></msub><msub><mo>)</mo><mn>2</mn></msub><mi>CO</mi><mo>+</mo><msub><mi>CS</mi><mn>2</mn></msub></math>",
