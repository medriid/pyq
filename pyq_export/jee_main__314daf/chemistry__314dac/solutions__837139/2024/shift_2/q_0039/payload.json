  "question": {
    "text": "If a substance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>'</mo><mi>A</mi><mo>'</mo></math> dissolves in solution of a mixture of ' <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>' and ' <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> ' with their respective number of moles as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>n</mi><mi>A</mi></msub><mo>,</mo><msub><mi>n</mi><mi>B</mi></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>n</mi><mi>C</mi></msub></math>, mole fraction of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> in the solution is:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">C</mi></msub><mrow><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">A</mi></msub><mo>×</mo><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">B</mi></msub><mo>×</mo><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">C</mi></msub></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">C</mi></msub><mrow><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">A</mi></msub><mo>+</mo><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">B</mi></msub><mo>+</mo><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">C</mi></msub></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">C</mi></msub><mrow><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">A</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">B</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">C</mi></msub></mrow></mfrac></math>",
      "is_correct": false
