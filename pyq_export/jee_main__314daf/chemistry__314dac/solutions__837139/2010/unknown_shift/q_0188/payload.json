  "question": {
    "text": "If sodium sulphate is considered to be completely dissociated into cations and anions in aqueous solution, the change in freezing point of water $\\left(\\Delta \\mathrm{T}_{\\mathrm{f}}\\right)$, when $0.01 \\mathrm{~mol}$ of sodium sulphate is dissolved in $1 \\mathrm{~kg}$ of water, is $\\left(\\mathrm{K}_{\\mathrm{f}}=1.86 \\mathrm{~K} \\mathrm{~kg} \\mathrm{~mol}^{-1}\\right)$"
  },
  "options": [
    {
      "text": "\n$0.0372 \\mathrm{~K}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.0558 \\mathrm{~K}$\n",
      "is_correct": true
    },
    {
      "text": "\n$0.0744 \\mathrm{~K}$\n",
