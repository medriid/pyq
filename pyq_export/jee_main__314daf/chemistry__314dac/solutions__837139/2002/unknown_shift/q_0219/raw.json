  "question": {
    "text": "Freezing point of an aqueous solution is $(-0.186)^{\\circ} \\mathrm{C}$. Elevation of boiling point of the same solution is $\\mathrm{K}_{\\mathrm{b}}=0.512^{\\circ} \\mathrm{C}, \\mathrm{K}_{\\mathrm{f}}=1.86^{\\circ} \\mathrm{C}$, find the increase in boiling point.",
    "image": null
  },
  "options": [
    {
      "id": "oPZsv",
      "text": "\n$0.186{ }^{\\circ} \\mathrm{C}$\n",
      "image": null,
