    {
      "id": "20Oha",
      "text": "\n$0.2372{ }^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\mathrm{T}_{\\mathrm{b}}=\\mathrm{K}_{\\mathrm{b}} \\times \\frac{\\mathrm{W}_{\\mathrm{B}}}{\\mathrm{M}_{\\mathrm{B}} \\times \\mathrm{W}_{\\mathrm{A}}} \\times 1000 ; \\Delta \\mathrm{T}_{\\mathrm{f}}=\\mathrm{K}_{\\mathrm{f}} \\frac{\\mathrm{W}_{\\mathrm{B}}}{\\mathrm{M}_{\\mathrm{B}} \\times \\mathrm{W}_{\\mathrm{A}}} \\times 1000 ; \\frac{\\Delta \\mathrm{T}_{\\mathrm{b}}}{\\Delta \\mathrm{T}_{\\mathrm{f}}}=\\frac{\\mathrm{K}_{\\mathrm{b}}}{\\mathrm{K}_{\\mathrm{f}}}=\\frac{\\Delta \\mathrm{T}_{\\mathrm{b}}}{-0.186}=\\frac{0.512}{1.86}=0.0512^0 \\mathrm{C}$",
    "image": null
  },
