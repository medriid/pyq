  "question": {
    "text": "The vapour pressure of water at $20^{\\circ} \\mathrm{C}$ is $17.5 \\mathrm{~mm} \\mathrm{Hg}$. If $18 \\mathrm{~g}$ of glucose $\\left(\\mathrm{C}_6 \\mathrm{H}_{12} \\mathrm{O}_6\\right)$ is added to $178.2 \\mathrm{~g}$ of water at $20^{\\circ} \\mathrm{C}$, the vapour pressure of the resulting solution will be"
  },
  "options": [
    {
      "text": "\n$17.675 \\mathrm{~mm} \\mathrm{Hg}$\n",
      "is_correct": false
    },
    {
      "text": "\n$15.750 \\mathrm{~mm} \\mathrm{Hg}$\n",
      "is_correct": false
    },
    {
      "text": "\n$16.500 \\mathrm{~mm} \\mathrm{Hg}$\n",
      "is_correct": false
    },
    {
      "text": "\n$17.325 \\mathrm{~mm} \\mathrm{Hg}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\frac{P^0-P_s}{P_s}=X_{\\text {solute }} \\\\\n& \\frac{17.5-P_s}{P_s}=\\frac{0.1}{10} \\\\\n& \\frac{17.5-P_s}{P_s}=0.01 \\\\\n& \\Rightarrow P_s=17.325 \\mathrm{~mm} \\mathrm{Hg}\n\\end{aligned}\n$$"
  }
}