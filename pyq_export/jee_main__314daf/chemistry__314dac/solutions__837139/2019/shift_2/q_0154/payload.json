    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">b</mi></msub><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">&#160;</mi><msub><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">f</mi></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">b</mi></msub><mo>=</mo><mn>1</mn><mo>.5</mo><mtext>&#8201;</mtext><msub><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">f</mi></msub></math>",
