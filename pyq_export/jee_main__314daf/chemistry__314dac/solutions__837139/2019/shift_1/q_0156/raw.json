  "solution": {
    "text": "Since, <math><msubsup><mrow><mi>P</mi></mrow><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msubsup><mo>=</mo><mn>7</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><mi>P</mi><mi>a</mi><mo>;</mo><mtext> </mtext><msubsup><mrow><mi>P</mi></mrow><mrow><mi>B</mi></mrow><mrow><mn>0</mn></mrow></msubsup><mo>=</mo><mn>12</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><mi>P</mi><mi>a</mi></math> and <math><msub><mrow><mi>X</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>=</mo><mn>0.4</mn></math>,&nbsp;<math> <mrow> <msub> <mi>X</mi> <mi>B</mi> </msub> <mo>=</mo><mn>1</mn><mo>−</mo><mn>0.4</mn><mo>=</mo><mn>0.6</mn></mrow> </math><br /><br />According to Raoult's Law: <math><msub><mrow><mi>P</mi></mrow><mrow><mi>T</mi></mrow></msub><mo>=</mo><msubsup><mrow><mi>P</mi></mrow><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msubsup><msub><mrow><mi>X</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>+</mo><msubsup><mrow><mi>P</mi></mrow><mrow><mi>B</mi></mrow><mrow><mn>0</mn></mrow></msubsup><msub><mrow><mi>X</mi></mrow><mrow><mi>B</mi></mrow></msub></math><br /><br /><math><msub><mrow><mi>P</mi></mrow><mrow><mi>T</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>7</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>0.4</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mn>12</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>0.6</mn></mrow></mfenced></math><br /><br /><math><msub><mrow><mi>P</mi></mrow><mrow><mi>T</mi></mrow></msub><mo>=</mo><mn>10</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><mi>P</mi><mi>a</mi></math><br /><br />Now, <math><msubsup><mrow><mi>P</mi></mrow><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msubsup><msub><mrow><mi>X</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>=</mo><msub><mrow><mi>P</mi></mrow><mrow><mi>T</mi></mrow></msub><msub><mrow><mi>x</mi></mrow><mrow><mi>A</mi></mrow></msub></math><br /><br /><math><msub><mrow><mi>x</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>=</mo><mfrac><mrow><msubsup><mrow><mi>P</mi></mrow><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msubsup><msub><mrow><mi>X</mi></mrow><mrow><mi>A</mi></mrow></msub></mrow><mrow><msub><mrow><mi>P</mi></mrow><mrow><mi>T</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>7</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><mo>×</mo><mn>0.4</mn></mrow><mrow><msup><mrow><mn>10</mn></mrow><mrow><mn>4</mn></mrow></msup></mrow></mfrac><mo>⇒</mo><mn>0.28</mn></math><br /><br /><math><msub><mrow><mi>x</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><mn>1</mn><mo>-</mo><msub><mrow><mi>x</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>⇒</mo><mtext> </mtext><mn>1</mn><mo>-</mo><mn>0.28</mn><mo>⇒</mo><mn>0.72</mn></math><br /><br />&nbsp;",
