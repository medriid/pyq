    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">g</mi></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
