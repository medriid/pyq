  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">M</mi><mo>=</mo><mfrac><mrow><msub><mi mathvariant=\"normal\">W</mi><mi>solute</mi></msub><mo>&#215;</mo><mn>1000</mn></mrow><mrow><msub><mi>GMM</mi><mi>solute</mi></msub><mo>&#215;</mo><msub><mi mathvariant=\"normal\">V</mi><mi>ml</mi></msub></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>6</mn><mo>.</mo><mn>3</mn><mo>&#215;</mo><mn>1000</mn></mrow><mrow><mn>126</mn><mo>&#215;</mo><mn>250</mn></mrow></mfrac><mo>=</mo><mn>0</mn><mo>.</mo><mn>2</mn><mo>&#160;</mo><mi mathvariant=\"normal\">M</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>20</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>2</mn></mrow></msup></math><br />So <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>=</mo><mn>20</mn></math></p>",
