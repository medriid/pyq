  "correct_answer": "14",
  "solution": {
    "text": "<p>Since,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">p</mi><msub><mo>&#176;</mo><mi mathvariant=\"normal\">A</mi></msub><mo>&#215;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">A</mi></msub></mrow><mrow><mi mathvariant=\"normal\">p</mi><msub><mo>&#176;</mo><mi mathvariant=\"normal\">A</mi></msub><mo>&#215;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">A</mi></msub><mo>+</mo><mi mathvariant=\"normal\">p</mi><msub><mo>&#176;</mo><mi mathvariant=\"normal\">B</mi></msub><mo>&#215;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">B</mi></msub></mrow></mfrac></math></p><p>and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mn>0</mn><mo>.</mo><mn>3</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><mn>0</mn><mo>.</mo><mn>7</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mfrac><mrow><mn>50</mn><mo>&#215;</mo><mn>0</mn><mo>.</mo><mn>3</mn></mrow><mrow><mn>50</mn><mo>&#215;</mo><mn>0</mn><mo>.</mo><mn>3</mn><mo>+</mo><mn>100</mn><mo>&#215;</mo><mn>0</mn><mo>.</mo><mn>7</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mfrac><mn>15</mn><mn>85</mn></mfrac></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">Y</mi><mi mathvariant=\"normal\">B</mi></msub><mrow><mn>1</mn><mo>-</mo><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">B</mi></msub></mrow></mfrac><mo>=</mo><mfrac><msubsup><mi mathvariant=\"normal\">P</mi><mi mathvariant=\"normal\">B</mi><mn>0</mn></msubsup><msubsup><mi mathvariant=\"normal\">P</mi><mi mathvariant=\"normal\">A</mi><mn>0</mn></msubsup></mfrac><mfenced close=\"]\" open=\"[\"><mfrac><msub><mi mathvariant=\"normal\">X</mi><mi mathvariant=\"normal\">B</mi></msub><mrow><mn>1</mn><mo>-</mo><msub><mi mathvariant=\"normal\">X</mi><mi mathvariant=\"normal\">B</mi></msub></mrow></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">B</mi></msub><mrow><mn>1</mn><mo>-</mo><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">B</mi></msub></mrow></mfrac><mo>=</mo><mfrac><mn>100</mn><mn>50</mn></mfrac><mfenced close=\"]\" open=\"[\"><mfrac><mrow><mn>0</mn><mo>.</mo><mn>7</mn></mrow><mrow><mn>0</mn><mo>.</mo><mn>3</mn></mrow></mfrac></mfenced><mo>=</mo><mfrac><mn>14</mn><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><mfrac><mn>14</mn><mn>17</mn></mfrac></math></p>"
