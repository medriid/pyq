  "question": {
    "text": "$12 \\mathrm{~g}$ of a nonvolatile solute dissolved in $108 \\mathrm{~g}$ of water produces the relative lowering of vapour pressure of $0.1$. The molecular mass of the solute is :"
  },
  "options": [
    {
      "text": "\n$80$\n",
      "is_correct": false
    },
    {
      "text": "\n$60$\n",
      "is_correct": false
    },
    {
      "text": "\n$20$\n",
      "is_correct": true
    },
    {
      "text": "\n$40$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{P}^{\\mathrm{o}}-\\mathrm{P}_s}{\\mathrm{P}^{\\mathrm{o}}}=\\frac{n}{N}=\\frac{w}{m} \\times \\frac{\\mathrm{M}}{W}$\n$0.1=\\frac{12}{m} \\times \\frac{18}{108}$\n$m=\\frac{12 \\times 18}{0.1 \\times 108}=20$"
  }
}