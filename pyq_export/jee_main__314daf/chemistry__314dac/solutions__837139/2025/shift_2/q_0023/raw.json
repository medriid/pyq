  "correctValue": null,
  "solution": {
    "text": "$\\underset{1^{\\circ} \\mathrm{C}}{\\text { Water }} \\xrightarrow[\\text { decreases }]{\\text { Volume }}\\underset{4^{\\circ} \\mathrm{C}}{\\text { Water }} \\xrightarrow[\\text { thermal expansion }]{\\text { Volume increases }} \\underset{25^{\\circ} \\mathrm{C}}{\\text { Water }}$ Water<br />$\\text { Molarity }=\\frac{\\mathrm{n}_{\\text {solute }}}{(\\text { Volume of solution })_{\\ell}}$<br />Hence<br />$1^{\\circ} \\mathrm{C} \\xrightarrow[\\text { increases }]{\\text { molarity }} 4^{\\circ} \\mathrm{C} \\xrightarrow[\\text { decreases }]{\\text { molarity }} 25^{\\circ} \\mathrm{C}$",
    "image": null
  },
