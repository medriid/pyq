  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} \\Delta \\mathrm{T}_{\\mathrm{f}} & =\\mathrm{K}_{\\mathrm{b}} \\cdot \\mathrm{m} \\\\ 0.4 & =\\mathrm{K}_{\\mathrm{b}} \\frac{\\frac{1}{256}}{50 \\times 10^{-3}} \\\\ \\mathrm{~K}_{\\mathrm{b}} & =5.12 \\mathrm{~K} \\mathrm{~kg} / \\mathrm{mol}\\end{aligned}$",
    "image": null
