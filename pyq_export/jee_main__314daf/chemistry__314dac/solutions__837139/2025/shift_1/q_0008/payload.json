  "question": {
    "text": "2 moles each of ethylene glycol and glucose are dissolved in 500 g of water. The boiling point of the resulting solution is :<br />(Given : Ebullioscopic constant of water $\\left.=0.52 \\mathrm{~K} \\mathrm{~kg} \\mathrm{~mol}^{-1}\\right)$"
  },
  "options": [
    {
      "text": "379.2 K",
      "is_correct": false
    },
    {
      "text": "377.3 K",
      "is_correct": true
    },
    {
      "text": "375.3 K",
      "is_correct": false
    },
    {
      "text": "277.3 K",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\Delta \\mathrm{T}_{\\mathrm{b}}=\\mathrm{i}_1 \\mathrm{~m}_1 \\mathrm{k}_{\\mathrm{b}}+\\mathrm{i}_2 \\mathrm{~m}_2 \\mathrm{k}_{\\mathrm{b}} \\\\ & =1 \\times \\frac{2}{0.5} \\times 0.52+\\frac{1 \\times 2}{0.5} \\times 0.52=4.16 \\\\ & \\left(\\mathrm{~T}_{\\mathrm{b}}\\right)_{\\text {solution }}=373.16+4.16=377.3 \\mathrm{~K}.\\end{aligned}$"
  }
