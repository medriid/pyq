  "question": {
    "text": "The percentage dissociation of a salt $\\left(\\mathrm{MX}_3\\right)$ solution at given temperature (van't Hoff factor $\\mathrm{i}=$ 2) is ______ % (Nearest integer)"
  },
  "options": [],
  "correct_answer": "33",
  "solution": {
    "text": "$\\mathrm{MX}_3 \\rightarrow \\mathrm{M}^{+3}+3 \\mathrm{X}^{\\ominus}$<br />$\\begin{aligned} & \\mathrm{i}=1+(\\mathrm{n}-1) \\alpha \\\\ & \\mathrm{i}=1+(4-1) \\alpha=2\\end{aligned}$<br />$\\alpha=\\frac{1}{3}=33.33 \\% \\approx 33 \\%$"
  }
}