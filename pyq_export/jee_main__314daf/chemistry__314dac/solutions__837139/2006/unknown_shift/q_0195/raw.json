  "question": {
    "text": "$18 \\mathrm{~g}$ of glucose $\\left(\\mathrm{C}_6 \\mathrm{H}_{12} \\mathrm{O}_6\\right)$ is added to $178.2 \\mathrm{~g}$ of water. The vapour pressure of water for this aqueous solution at $100^{\\circ} \\mathrm{C}$ is",
    "image": null
  },
  "options": [
    {
      "id": "o20yX",
      "text": "\n$759.00$ Torr\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gRKi7",
      "text": "\n$7.60$ Torr\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nSSdQ",
      "text": "\n$76.00$ Torr\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "x8KkN",
      "text": "\n$752.40$ Torr",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\frac{\\mathrm{P}^{\\circ}-\\mathrm{P}_{\\mathrm{s}}}{\\mathrm{P}_{\\mathrm{s}}}=\\frac{\\mathrm{n}}{\\mathrm{N}} \\\\\n& \\frac{760-\\mathrm{P}_{\\mathrm{s}}}{\\mathrm{P}_{\\mathrm{s}}}=\\frac{\\frac{18}{180}}{\\frac{178.2}{18}}=\\frac{\\frac{1}{10}}{9.9}=\\frac{0.1}{9.9} \\\\\n& 760-\\mathrm{P}_{\\mathrm{s}}=\\frac{1}{99} \\mathrm{P}_{\\mathrm{s}} \\\\\n& 760 \\times 99-\\mathrm{P}_{\\mathrm{s}} \\times 99=\\mathrm{P}_{\\mathrm{s}} \\\\\n& 760 \\times 99=100 \\mathrm{P}_{\\mathrm{s}} \\\\\n& \\mathrm{P}_{\\mathrm{s}}=\\frac{760 \\times 99}{100}=752.4\n\\end{aligned}\n$$",
    "image": null
  },
