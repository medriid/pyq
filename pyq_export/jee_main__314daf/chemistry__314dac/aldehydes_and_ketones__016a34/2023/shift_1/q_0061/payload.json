  "question": {
    "text": "<p>Match List I with List II.</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">List I</td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">List II</td>\t\t</tr>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">Reaction</td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">Reagents</td>\t\t</tr>\t\t<tr>\t\t\t<td>(A)</td>\t\t\t<td>Hoffmann<br />\t\t\tDegradation</td>\t\t\t<td>(I)</td>\t\t\t<td>Conc.<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>KOH</mi><mo>,</mo><mi mathvariant=\"normal\">&#916;</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(B)</td>\t\t\t<td>Clemmensen<br />\t\t\treduction</td>\t\t\t<td>(II)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CHCl</mi><mn>3</mn></msub><mo>,</mo><mi>NaOH</mi><mo>/</mo><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub><msup><mi mathvariant=\"normal\">O</mi><mo>+</mo></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(C)</td>\t\t\t<td>Cannizzaro reaction</td>\t\t\t<td>(III)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Br</mi><mn>2</mn></msub><mo>,</mo><mi>NaOH</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(D)</td>\t\t\t<td>Reimer-Tiemann<br />\t\t\treaction</td>\t\t\t<td>(IV)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Zn</mi><mo>-</mo><mi>Hg</mi><mo>/</mo><mi>HCl</mi></math></td>\t\t</tr>\t</tbody></table>"
