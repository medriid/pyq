  "question": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/35844d5b-7c55-49b0-91d3-364f3ac6328b-image.png\" style=\"width: 500px; height: 103px;\" /></p><p>The ratio x/y on completion of the above reaction is ______ .</p>",
    "image": null
