  "question": {
    "text": "In the given transformation, which of the following is the most appropriate reagent?\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/QbYIeXE0ieMpoHkLlkRhatE3H_ovt-YLOj8ITsmgezQ.original.fullsize.png\"><br>",
