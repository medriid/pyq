  "question": {
    "text": "Which of the following conditions or reaction sequence will NOT give acetophenone as the major product?",
    "image": null
  },
  "options": [
    {
      "id": "1EvVl",
      "text": "<p>(a)</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/d30191fd-dd66-45ba-9d36-880827b88be6-image.png\" style=\"width: 300px; height: 103px;\" /></p><p>(b)&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>Cr</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>7</mn></msub><mo>,</mo><msup><mi mathvariant=\"normal\">H</mi><mo>+</mo></msup></math></p>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "fLRzQ",
      "text": "<p>(a)</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5a74c46c-b41f-4963-8a78-c12d94e3fe2f-image.png\" style=\"width: 300px; height: 109px;\" /></p><p>(b)&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>PCC</mi><mo>,</mo><mi>DCM</mi></math></p>",
