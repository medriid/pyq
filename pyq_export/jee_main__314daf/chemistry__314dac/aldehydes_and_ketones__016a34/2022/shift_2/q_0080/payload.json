  "question": {
    "text": "Toluene can be easily converted into benzaldehyde by which of the following reagents?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CrO</mi><mn>3</mn></msub></math> /acetic acid,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub><msup><mi mathvariant=\"normal\">O</mi><mo>+</mo></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CrO</mi><mn>3</mn></msub></math> /acetic anhydride,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub><msup><mi mathvariant=\"normal\">O</mi><mo>+</mo></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>KMnO</mi><mn>4</mn></msub><mo>/</mo><mi>HCl</mi><mo>,</mo><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub><msup><mi mathvariant=\"normal\">O</mi><mo>+</mo></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CO</mi><mo>,</mo><mo>&#160;</mo><mi>HCl</mi><mo>,</mo><mo>&#160;</mo><mi>Anhyd</mi><mo>.</mo><mo>&#160;</mo><msub><mi>AlCl</mi><mn>3</mn></msub></math>",
