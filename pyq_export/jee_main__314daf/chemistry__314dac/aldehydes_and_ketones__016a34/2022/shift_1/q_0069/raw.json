  "question": {
    "text": "<p>Which reactant will give the following alcohol on reaction with one mole of phenyl magnesium bromide&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>PhMgBr</mi></mfenced></math>&nbsp;followed by acidic hydrolysis?</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/389c30db-f9c6-4b5d-b44a-33c36fa96b0b-image.png\" style=\"width: 118px; height: 120px;\" /></p>",
    "image": null
