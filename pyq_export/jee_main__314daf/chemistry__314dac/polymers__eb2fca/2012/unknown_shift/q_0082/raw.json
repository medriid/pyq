  "question": {
    "text": "Synthetic polymer bakelite can be prepared from following compounds",
    "image": null
  },
  "options": [
    {
      "id": "k2yFv",
      "text": "\nStyrene and vinyl chloride\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZDDSP",
      "text": "\nAcrylonitrile and vinyl chloride\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "w6Irm",
      "text": "\nAdipic acid and ethylene glycol\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "S3CxX",
      "text": "\nPhenol and formaldehyde",
      "image": null,
      "isCorrect": true
