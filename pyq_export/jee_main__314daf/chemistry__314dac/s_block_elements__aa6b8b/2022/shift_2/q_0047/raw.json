  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "Amongst baking soda, caustic soda and washing soda carbonate anion is present in :<br />&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "hDu3L",
      "text": "Washing Soda only",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "NBf1J",
      "text": "washing soda and caustic soda only.<br />&nbsp;",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "UApyU",
      "text": "washing soda and baking soda only.<br />&nbsp;",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "hj25G",
      "text": "baking soda, caustic soda and washing soda.",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<p>Washing soda&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>CO</mi><mn>3</mn></msub><mo>.</mo><mn>10</mn><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced></math>&nbsp;contains carbonate ion. Baking soda&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><msub><mi>NaHCO</mi><mn>3</mn></msub></mfenced></math>&nbsp;contains bicarbonate ion. Caustic soda is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaOH</mi></math>.</p><p>Hence, carbonate ion is present only in washing soda.</p>",
    "image": null
  },
