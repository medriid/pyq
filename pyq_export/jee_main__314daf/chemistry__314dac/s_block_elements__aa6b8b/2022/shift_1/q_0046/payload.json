    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Li</mi><mo>&#60;</mo><mi>Na</mi><mo>&#60;</mo><mi mathvariant=\"normal\">K</mi><mo>&#60;</mo><mi>Cs</mi><mo>&#60;</mo><mi>Rb</mi></math>",
