  "question": {
    "text": "Choose the correct order of density of the alkali metals"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Li</mi><mo>&#60;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi><mo>&#60;</mo><mi>Na</mi><mo>&#60;</mo><mi>Rb</mi><mo>&#60;</mo><mi>Cs</mi></math>",
