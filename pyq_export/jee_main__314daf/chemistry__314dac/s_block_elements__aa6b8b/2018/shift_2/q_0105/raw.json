  "question": {
    "text": "In $\\mathrm{KO}_2$, the nature of oxygen species and the oxidation state of oxygen atom are, respectively:",
    "image": null
  },
  "options": [
    {
      "id": "msbLF",
      "text": "\nSuperoxide and $-1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "V7yaf",
      "text": "\nSuperoxide and $-1 / 2$\n",
      "image": null,
      "isCorrect": true
