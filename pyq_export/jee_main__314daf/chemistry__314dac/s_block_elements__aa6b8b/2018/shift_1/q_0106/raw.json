  "question": {
    "text": "A white sodium salt dissolves readily in water to give a solution which is neutral to litmus. When silver nitrate solution is added to the aforementioned solution, a white precipitate is obtained which does not dissolve in dil. nitric acid. The anion is :",
    "image": null
  },
  "options": [
    {
      "id": "wyaSA",
      "text": "\n$\\mathrm{CO}_3^{2-}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1rgB5",
      "text": "\n$\\mathrm{SO}_4^{2-}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FH4Wv",
      "text": "\n$\\mathrm{S}^{2-}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XZJzn",
      "text": "\n$\\mathrm{Cl}^{-}$",
      "image": null,
      "isCorrect": true
    }
  ],
