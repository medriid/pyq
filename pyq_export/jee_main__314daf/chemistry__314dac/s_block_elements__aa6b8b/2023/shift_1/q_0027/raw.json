  "question": {
    "text": "The magnetic behaviour of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Li</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Na</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>KO</mi><mn>2</mn></msub></math>, respectively, are",
    "image": null
  },
  "options": [
    {
      "id": "Dl1u6",
      "text": "diamagnetic, paramagnetic and diamagnetic",
      "isCorrect": false,
      "image": null
    },
