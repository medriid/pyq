  "question": {
    "text": "<p>Match List-I with List-II:</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>List-I</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>List-II</td>\t\t</tr>\t\t<tr>\t\t\t<td>A.</td>\t\t\t<td>K</td>\t\t\t<td>I.</td>\t\t\t<td>Thermonuclear reactions</td>\t\t</tr>\t\t<tr>\t\t\t<td>B.</td>\t\t\t<td>KCI</td>\t\t\t<td>II.</td>\t\t\t<td>Fertilizer</td>\t\t</tr>\t\t<tr>\t\t\t<td>C.</td>\t\t\t<td>KOH</td>\t\t\t<td>III.</td>\t\t\t<td>Sodium potassium pump</td>\t\t</tr>\t\t<tr>\t\t\t<td>D.</td>\t\t\t<td>Li</td>\t\t\t<td>IV.</td>\t\t\t<td>Absorbent of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CO</mi><mn>2</mn></msub></math></td>\t\t</tr>\t</tbody></table><p>&nbsp;</p>"
