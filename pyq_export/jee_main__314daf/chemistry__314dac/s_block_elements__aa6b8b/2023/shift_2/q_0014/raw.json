  "question": {
    "text": "Ion having highest hydration enthalpy among the given alkaline earth metal ions is:",
    "image": null
  },
  "options": [
    {
      "id": "Y3LbR",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Be</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "93hmn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Sr</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5SN1f",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ba</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mye5y",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ca</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": false
