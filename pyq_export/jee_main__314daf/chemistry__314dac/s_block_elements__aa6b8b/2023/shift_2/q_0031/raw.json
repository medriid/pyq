  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\">List I</td>\t\t\t<td colspan=\"2\" rowspan=\"1\">List II</td>\t\t</tr>\t\t<tr>\t\t\t<td>A.</td>\t\t\t<td>Cobalt catalyst</td>\t\t\t<td>I.</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mo>+</mo><msub><mi>Cl</mi><mn>2</mn></msub></mrow></mfenced></math>&nbsp;production</td>\t\t</tr>\t\t<tr>\t\t\t<td>B.</td>\t\t\t<td>Syngas</td>\t\t\t<td>II.</td>\t\t\t<td>Water gas production</td>\t\t</tr>\t\t<tr>\t\t\t<td>C.</td>\t\t\t<td>Nickel catalyst</td>\t\t\t<td>III.</td>\t\t\t<td>Coal gasification</td>\t\t</tr>\t\t<tr>\t\t\t<td>D.</td>\t\t\t<td>Brine solution</td>\t\t\t<td>IV.</td>\t\t\t<td>Methanol production</td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below:-</p>",
    "image": null
  },
  "options": [
    {
      "id": "caqqR",
      "text": "A-IV, B-I, C-II, D-III",
