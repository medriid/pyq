      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi>and</mi><mo>&#160;</mo><mn>10</mn><mo>&#160;</mo></math>",
      "is_correct": false
