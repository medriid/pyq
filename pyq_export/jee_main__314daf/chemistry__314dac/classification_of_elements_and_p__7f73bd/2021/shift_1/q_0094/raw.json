    "text": "<p>Match List-<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math>&nbsp;with List-<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi></math>.</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td style=\"text-align: center;\">List-<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math><br />\t\t\tElectronic configuration of elements</td>\t\t\t<td style=\"text-align: center;\">&nbsp;</td>\t\t\t<td style=\"text-align: center;\">List-<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi></math><br />\t\t\t<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">&#916;</mi><mi mathvariant=\"normal\">i</mi></msub><mi mathvariant=\"normal\">H</mi></math> in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>kJ</mi><mo>&#160;</mo><msup><mi>mol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">a</mi></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><msup><mi mathvariant=\"normal\">s</mi><mn>2</mn></msup><mn>2</mn><msup><mi mathvariant=\"normal\">s</mi><mn>2</mn></msup></math></td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">p</mi></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>801</mn></math></td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">b</mi></mfenced></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><msup><mi mathvariant=\"normal\">s</mi><mn>2</mn></msup><mn>2</mn><msup><mi mathvariant=\"normal\">s</mi><mn>2</mn></msup><mn>2</mn><msup><mi mathvariant=\"normal\">p</mi><mn>4</mn><