      "text": "<span style=\"color:null;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Mg</mi><mo>&#60;</mo><mi>Al</mi><mo>&#60;</mo><mi mathvariant=\"normal\">S</mi><mo>&#60;</mo><mi mathvariant=\"normal\">P</mi></math></span>",
