  "question": {
    "text": "The CORRECT order of first ionisation enthalpy is:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Mg</mi><mo>&#60;</mo><mi mathvariant=\"normal\">S</mi><mo>&#60;</mo><mi>Al</mi><mo>&#60;</mo><mi mathvariant=\"normal\">P</mi></math>",
      "is_correct": false
    },
    {
      "text": "<span style=\"color:null;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Mg</mi><mo>&#60;</mo><mi>Al</mi><mo>&#60;</mo><mi mathvariant=\"normal\">S</mi><mo>&#60;</mo><mi mathvariant=\"normal\">P</mi></math></span>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Al</mi><mo>&#60;</mo><mi>Mg</mi><mo>&#60;</mo><mi mathvariant=\"normal\">S</mi><mo>&#60;</mo><mi mathvariant=\"normal\">P</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Mg</mi><mo>&#60;</mo><mi>Al</mi><mo>&#60;</mo><mi mathvariant=\"normal\">P</mi><mo>&#60;</mo><mi mathvariant=\"normal\">S</mi></math>",
