  "question": {
    "text": "Which is the correct order of second ionization potential of $\\mathrm{C}, \\mathrm{N}, \\mathrm{O}$ and $\\mathrm{F}$ in the following ?",
    "image": null
  },
  "options": [
    {
      "id": "PrHcE",
      "text": "\n$\\mathrm{O}>\\mathrm{N}>\\mathrm{F}>\\mathrm{C}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "H8lcX",
      "text": "\n$\\mathrm{O}>\\mathrm{F}>\\mathrm{N}>\\mathrm{C}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "gkXiQ",
      "text": "\nF $>$ O $>\\mathrm{N}>\\mathrm{C}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zZLpO",
      "text": "\n$\\quad$ C $>$ N $>\\mathrm{O}>\\mathrm{F}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The second ionization potential means removal of electron from cation $\\mathrm{C}^{+}=1 s^2 2 s^2 2 p^1, \\mathrm{~N}^{+}=1 s^2 2 s^2 2 p^2$ $\\mathrm{O}^{+}=1 s^2 2 s^2 2 p^3, \\mathrm{~F}^{+}=1 s^2 2 s^2 2 p^4$ Therefore $\\mathrm{O}>\\mathrm{F}>\\mathrm{N}>\\mathrm{C}$",
    "image": null
  },
