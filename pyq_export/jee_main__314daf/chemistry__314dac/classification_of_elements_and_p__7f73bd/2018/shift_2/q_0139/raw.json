  "question": {
    "text": "The correct order of electron affinity is:",
    "image": null
  },
  "options": [
    {
      "id": "V7APg",
      "text": "\n$\\mathrm{O}>\\mathrm{F}>\\mathrm{Cl}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "htO6j",
