  "question": {
    "text": "For $\\mathrm{Na}^{+}, \\mathrm{Mg}^{2+}, \\mathrm{F}^{-}$and $\\mathrm{O}^{2-}$; the correct order of increasing Ionic radii is :",
    "image": null
  },
  "options": [
    {
      "id": "IDjqz",
      "text": "\n$\\mathrm{O}^{2-} < \\mathrm{F}^{-} < \\mathrm{Na}^{+} < \\mathrm{Mg}^{2+}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CLy0p",
      "text": "\n$\\mathrm{Na}^{+} < \\mathrm{Mg}^{2+} < \\mathrm{F}^{-} < \\mathrm{O}^{2-}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7CxSj",
      "text": "\n$\\mathrm{Mg}^{2+} < \\mathrm{Na}^{+} < \\mathrm{F}^{-} < \\mathrm{O}^{2-}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1Z0Ju",
      "text": "\n$\\mathrm{Mg}^{2+} < \\mathrm{O}^{2-} < \\mathrm{Na}^{+} < \\mathrm{F}^{-}$",
