  "question": {
    "text": "The property/properties that show irregularity in first four elements of group-17 is/are :<br />(A) Covalent radius<br />(B) Electron affinity<br />(C) Ionic radius<br />(D) First ionization energy<br />Choose the correct answer from the options given below:",
    "image": null
  },
  "options": [
    {
      "id": "0HWvE",
      "text": "B and D only",
      "image": null,
      "isCorrect": false
    },
