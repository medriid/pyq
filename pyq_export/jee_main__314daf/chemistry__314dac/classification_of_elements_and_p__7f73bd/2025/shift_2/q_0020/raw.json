      "text": "A &lt; C &lt; B &lt; D",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RjevX",
      "text": "A &lt; B &lt; C &lt; D",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zYUlF",
      "text": "D &lt; A &lt; B &lt; C",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{N}:-1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^3$ (Electronegativity $\\left.=3\\right)$<br />$\\mathrm{O}:-1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^4$ (Electronegativity $=3.5$)<br />$\\mathrm{F}:-1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^5$ (Electronegativity $=4$)<br />$\\mathrm{C}:-1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^2$ (Electronegativity $=2.55$)<br />Correct order $=\\mathrm{C} \\gt \\mathrm{B} \\gt \\mathrm{A} \\gt \\mathrm{D}$",
    "image": null
  },
