  "question": {
    "text": "The type of oxide formed by the element among $\\mathrm{Li}, \\mathrm{Na}, \\mathrm{Be}, \\mathrm{Mg}, \\mathrm{B}$ and Al that has the least atomic radius is :",
    "image": null
  },
  "options": [
