  "question": {
    "text": "The successive 5 ionisation energies of an element are $800,2427,3658,25024$ and $32824 \\mathrm{~kJ} / \\mathrm{mol}$, respectively. By using the above values predict the group in which the above element is present :",
    "image": null
  },
  "options": [
    {
      "id": "aoctJ",
      "text": "Group 13",
      "image": null,
      "isCorrect": true
