      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">N</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">L</mi><msub><mi mathvariant=\"normal\">i</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi><msub><mi mathvariant=\"normal\">l</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub></math>",
