  "question": {
    "text": "<p>What is the correct oder of electron gain enthalpy of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Cl</mi><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">F</mi><mo>,</mo><mo>&#160;</mo><mi>Te</mi><mo>,</mo><mo>&#160;</mo><mi>Po</mi></math></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Cl</mi><mo>&#62;</mo><mi>Te</mi><mo>&#62;</mo><mi>Po</mi><mo>&#160;</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Cl</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Te</mi><mo>&#160;</mo><mo>&#62;</mo><mi>Po</mi><mo>&#160;</mo></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Te</mi><mo>&#62;</mo><mi>Po</mi><mo>&#62;</mo><mi>Cl</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Po</mi><mo>&#62;</mo><mi>Te</mi><mo>&#62;</mo><mi mathvariant=\"normal\">F</mi><mo>&#62;</mo><mi>Cl</mi></math>",
