      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>&#60;</mo><mi mathvariant=\"normal\">A</mi><mo>&#60;</mo><mi mathvariant=\"normal\">D</mi><mo>&#60;</mo><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": true
