  "question": {
    "text": "The metal that has very low melting point and its periodic position is closer to a metalloid is",
    "image": null
  },
  "options": [
    {
      "id": "nLyjH",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Al</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "2bH8c",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Ga</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "jjn3j",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Se</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "CT2oO",
