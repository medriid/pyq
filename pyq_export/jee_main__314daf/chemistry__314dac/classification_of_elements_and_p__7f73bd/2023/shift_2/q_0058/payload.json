  "question": {
    "text": "Bond dissociation energy of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">E</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi></math> bond of the &quot;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">E</mi></math>&quot; hydrides of group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn></math> elements (given below), follows order.<br />(A)&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">O</mi></math><br />(B) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">S</mi></math><br />(C) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Se</mi></math><br />(D) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Te</mi></math>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>&#62;</mo><mi mathvariant=\"normal\">B</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi mathvariant=\"normal\">D</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>&#62;</mo><mi mathvariant=\"normal\">B</mi><mo>&#62;</mo><mi mathvariant=\"normal\">D</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>&#62;</mo><mi mathvariant=\"normal\">A</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi mathvariant=\"normal\">D</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">D</mi><mo>&#62;</mo><mi mathvariant=\"normal\">C</mi><mo>&#62;</mo><mi mathvariant=\"normal\">B</mi><mo>&#62;</mo><mi mathvariant=\"normal\">A</mi></math>",
