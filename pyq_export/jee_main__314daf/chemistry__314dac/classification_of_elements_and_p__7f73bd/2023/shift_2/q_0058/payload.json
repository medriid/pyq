      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaF</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaCl</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaBr</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaI</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaCl</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaF</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaBr</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaI</mi></math>",
