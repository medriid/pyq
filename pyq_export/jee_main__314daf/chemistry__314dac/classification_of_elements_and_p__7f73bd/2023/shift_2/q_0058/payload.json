  "question": {
    "text": ". Identify the correct order of standard enthalpy of formation of sodium halides."
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaI</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaBr</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaF</mi><mo>&#160;</mo><mo>&#60;</mo><mo>&#160;</mo><mi>NaCl</mi></math>",
