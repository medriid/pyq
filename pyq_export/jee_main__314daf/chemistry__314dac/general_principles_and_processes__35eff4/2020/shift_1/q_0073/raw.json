    "text": "<p>An Ellingham diagram provides information about:</p>",
    "image": null
  },
  "options": [
    {
      "id": "szW2Z",
      "text": "the conditions of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>pH</mi></math>&nbsp;and potential under which a species is thermodynamically stable.",
