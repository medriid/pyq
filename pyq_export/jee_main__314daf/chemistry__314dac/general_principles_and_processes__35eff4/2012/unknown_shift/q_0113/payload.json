  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Van Arkel method\n$\\begin{aligned}\n& \\mathrm{Ti}(\\mathrm{s})+2 \\mathrm{I}_2(\\mathrm{g}) \\stackrel{523 \\mathrm{~K}}{\\longrightarrow} \\mathrm{TiI}_4(\\mathrm{g}) \\\\\n& \\mathrm{Til}_4(\\mathrm{g}) \\stackrel{1700 \\mathrm{~K}}{\\longrightarrow} \\mathrm{Ti}(\\mathrm{s})+2 \\mathrm{I}_2(\\mathrm{g})\n\\end{aligned}$"
  }
