    {
      "id": "gHy8U",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Fe</mi><mover><mo>&#8594;</mo><mrow><msub><mi>Cl</mi><mn>2</mn></msub><mo>,</mo><mo>&#160;</mo><mo>heat</mo></mrow></mover><msub><mi>FeCl</mi><mn>3</mn></msub><mover><mo>&#8594;</mo><mrow><mi>heat</mi><mo>,</mo><mo>&#160;</mo><mi>air</mi></mrow></mover><msub><mi>FeCl</mi><mn>2</mn></msub><mover><mo>&#8594;</mo><mi>Zn</mi></mover><mi>Fe</mi></math>",
