  "question": {
    "text": "In Goldschmidt aluminothermic process which of the following reducing agents is used :",
    "image": null
  },
  "options": [
    {
      "id": "OzTIU",
      "text": "\ncalcium\n",
      "image": null,
      "isCorrect": false
