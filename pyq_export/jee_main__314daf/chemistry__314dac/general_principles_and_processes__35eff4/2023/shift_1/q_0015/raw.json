  "question": {
    "text": "In the extraction of copper, its sulphide ore is heated in a reverberatory furnace after mixing with silica to:",
    "image": null
  },
  "options": [
    {
      "id": "3OXwn",
      "text": "separate <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CuO</mi></math>&nbsp;as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CuSiO</mi><mn>3</mn></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "HqTdI",
      "text": "remove calcium as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CaSiO</mi><mn>3</mn></msub></math>",
