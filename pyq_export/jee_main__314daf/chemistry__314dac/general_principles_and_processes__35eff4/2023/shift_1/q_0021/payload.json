    "text": "<p>Match List I with List II.</p><p><style type=\"text/css\"><!--td {border: 1px solid #cccccc;}br {mso-data-placement:same-cell;}--></style></p><table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" dir=\"ltr\" xmlns=\"http://www.w3.org/1999/xhtml\">\t<colgroup>\t\t<col width=\"45\" />\t\t<col width=\"147\" />\t\t<col width=\"52\" />\t\t<col width=\"138\" />\t</colgroup>\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;List I&quot;}\" rowspan=\"1\">List I</td>\t\t\t<td colspan=\"2\" data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;List II&quot;}\" rowspan=\"1\">List II</td>\t\t</tr>\t\t<tr>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;A.&quot;}\">A.</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;Reverberatory furnace &quot;}\">Reverberatory furnace</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;I.&quot;}\">I.</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;Pig iron&quot;}\">Pig iron</td>\t\t</tr>\t\t<tr>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;B.&quot;}\">B.</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;Electrolytic cell&quot;}\">Electrolytic cell</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;II.&quot;}\">II.</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;Aluminium&quot;}\">Aluminium</td>\t\t</tr>\t\t<tr>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;C.&quot;}\">C.</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;Blast furnace&quot;}\">Blast furnace</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;III.&quot;}\">III.</td>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;Silicon&quot;}\">Silicon</td>\t\t</tr>\t\t<tr>\t\t\t<td data-sheets-value=\"{&quot;1&quot;:2,&quot;2&quot;:&quot;D.&quot;}\">D.</td>\t\t\t<td data-sheets-value=\"