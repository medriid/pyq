  "question": {
    "text": "For a reaction \\(\\mathrm{A} \\xrightarrow{\\mathrm{K}_1} \\mathrm{~B} \\xrightarrow{\\mathrm{K}_2} \\mathrm{C}\\)\nIf the rate of formation of \\(B\\) is set to be zero then the concentration of \\(B\\) is given by :",
    "image": null
  },
  "options": [
    {
      "id": "4RsBj",
      "text": "\\(\\left(\\mathrm{K}_1+\\mathrm{K}_2\\right)[\\mathrm{A}]\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JPXKn",
      "text": "\\(\\left(\\mathrm{K}_1 / \\mathrm{K}_2\\right)[\\mathrm{A}]\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1dnnl",
      "text": "\\(\\left(\\mathrm{K}_1-\\mathrm{K}_2\\right)[\\mathrm{A}]\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1mm4C",
      "text": "\\(\\mathrm{K}_1 \\mathrm{~K}_2[\\mathrm{~A}]\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Rate of formation of $B$ is\n$\\begin{aligned} & \\frac{\\mathrm{d}[\\mathrm{B}]}{\\mathrm{dt}}=\\mathrm{k}_1[\\mathrm{~A}]-\\mathrm{k}_2[\\mathrm{~B}] \\\\ & 0=\\mathrm{k}_1[\\mathrm{~A}]-\\mathrm{k}_2[\\mathrm{~B}] \\\\ & \\left(\\frac{\\mathrm{k}_1}{\\mathrm{k}_2}\\right)[\\mathrm{A}]=[\\mathrm{B}]\\end{aligned}$",
    "image": null
  },
