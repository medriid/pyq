  "question": {
    "text": "Which of the following statement is not true for radioactive decay?",
    "image": null
  },
  "options": [
    {
      "id": "55wq4",
      "text": "Decay constant increases with increase in temperature.",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UJXFP",
      "text": "Amount of radioactive substance remained after three half lives is $\\frac{1}{8}$ th of original amount.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FGHEN",
      "text": "Decay constant does not depend upon temperature.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "G9DOe",
