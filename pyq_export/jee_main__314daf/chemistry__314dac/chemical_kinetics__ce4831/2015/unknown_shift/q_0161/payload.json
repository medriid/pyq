  "solution": {
    "text": "<blockquote><p>&nbsp;Activation energy is the minimum amount of energy that must be provided for compounds to result in a chemical reaction.</p><p><math><mi mathvariant=\"normal\">A</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">g</mi></mrow></mfenced><mo>&#8652;</mo><mi mathvariant=\"normal\">B</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">g</mi></mrow></mfenced><mi mathvariant=\"normal\">&#160;</mi><mo>;</mo><mi mathvariant=\"normal\">&#160;</mi><mo>&#8710;</mo><mi mathvariant=\"normal\">H</mi><mo>=</mo><mo>-</mo><mn>40</mn></math> kJ/mole<br /><br /><math><mo>&#8710;</mo><mi mathvariant=\"normal\">H</mi><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">a</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">f</mi></mrow></mfenced></mrow></msub><mo>-</mo><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">a</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfenced></mrow></msub><mo>=</mo><mo>-</mo><mn>40</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">J</mi></math><br /><br /><math><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">a</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">f</mi></mrow></mfenced></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">a</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">b</mi></mrow></mfenced></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mrow><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">a</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">f</mi></mrow></mfenced></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><