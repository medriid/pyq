  "question": {
    "text": "A reaction was found to be second order with respect to the concentration of carbon monoxide. If the concentration of carbon monoxide is doubled, with everything else kept the same, the rate of reaction will",
    "image": null
  },
  "options": [
    {
      "id": "OTF7J",
      "text": "\nremain unchanged\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JkYei",
      "text": "\ntriple\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ehWqV",
      "text": "\nincrease by a factor of 4\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "r0RHY",
      "text": "\ndouble",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{R} \\propto[\\mathrm{W}]^2$\n$\\mathrm{R}^{\\prime} \\propto[2 \\mathrm{CO}]^2$\n$\\mathrm{R} \\propto 4[\\mathrm{~W}]^2$\n$\\mathrm{R} \\propto 4 \\mathrm{M}$",
    "image": null
