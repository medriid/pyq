      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\mathrm{NO}(\\mathrm{g})+\\mathrm{Br}_2(\\mathrm{~g}) \\rightleftharpoons \\mathrm{NOBr}_2(\\mathrm{~g})\n$$\n$$\n\\mathrm{NOBr}_2(\\mathrm{~g})+\\mathrm{NO}(\\mathrm{g}) \\longrightarrow 2 \\mathrm{NOBr}(\\mathrm{g})\n$$\n$$\n\\begin{aligned}\n\\mathrm{R} & =\\mathrm{K}\\left[\\mathrm{NOBr}_2\\right][\\mathrm{NO}] \\\\\n& =\\mathrm{K} \\cdot \\mathrm{K}_{\\mathrm{c}}[\\mathrm{NO}]\\left[\\mathrm{Br}_2\\right][\\mathrm{NO}], \\text { where } \\mathrm{K}_{\\mathrm{c}}=\\frac{\\left[\\mathrm{NOBr}_2\\right]}{\\left[\\mathrm{NO}_2\\right]\\left[\\mathrm{Br}_2\\right]} \\\\\n& =\\mathrm{K}^{\\prime}[\\mathrm{NO}]^2\\left[\\mathrm{Br}_2\\right]\n\\end{aligned}\n$$",
    "image": null
  },
