  "type": "numerical",
  "level": 2,
  "question": {
    "text": "If <math><mrow><mn>75</mn><mi>%</mi></mrow></math> of a first order reaction was completed in <math><mrow><mn>90</mn></mrow></math> minutes, <math><mrow><mn>60</mn><mi>%</mi></mrow></math> of the same reaction would be completed in approximately (in minutes) _____<br />(Take: <math><mrow><mi>log</mi><mn>2</mn><mo>=</mo><mn>0.30</mn><mo>&#160;</mo><mo>;</mo><mi>log</mi><mn>2.5</mn><mo>=</mo><mn>0.40</mn></mrow></math>)",
    "image": null
  },
  "options": [],
  "correctValue": "60",
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">T</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mo>.303</mo></mrow><mi mathvariant=\"normal\">K</mi></mfrac><mtext>&#8201;</mtext><mi>log</mi><mtext>&#8201;</mtext><mfenced close=\"]\" open=\"[\"><mfrac><mn>100</mn><mrow><mn>100</mn><mo>&#8722;</mo><mi mathvariant=\"normal\">x</mi><mo>%</mo></mrow></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>75</mn><mo>%</mo></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mo>.303</mo></mrow><mi mathvariant=\"normal\">K</mi></mfrac><mtext>&#8201;</mtext><mi>log</mi><mtext>&#8201;</mtext><mfenced close=\"]\" open=\"[\"><mfrac><mn>100</mn><mn>25</mn></mfrac></mfenced><mo>=</mo><mn>90</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>60</mn><mo>%</mo></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mo>.303</mo></mrow><mi mathvariant=\"normal\">K</mi></mfrac><mtext>&#8201;</mtext><mi>log</mi><mtext>&#8201;</mtext><mfenced open=\"[\" close=\"]\"><mfrac><mn>100</mn><mn>40</mn></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>75</mn><mo>%</mo></mrow></msub><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>60</mn><mo>%</mo></mrow></msub></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>log</mi><mn>2</mn></mrow><mrow><mi>log</mi><mn>2</mn><mo>.5</mo></mrow></mfrac></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>90</mn><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>60</mn><mo>%</mo></mrow></msub></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mo>&#215;</mo><mn>0</mn><mo>.3</mo></mrow><mrow><mn>0</mn><mo>.4</mo></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>60</mn><mo>%</mo></mrow></msub><mo>=</mo><mfrac><mrow><mn>90</mn><mo>&#215;</mo><mn>4</mn></mrow><mn>6</mn></mfrac><mo>=</mo><mn>60</mn><mtext>&#8201;</mtext><mi>min</mi></math>.</p>",
