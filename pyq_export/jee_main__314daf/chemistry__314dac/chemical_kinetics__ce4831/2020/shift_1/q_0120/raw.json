  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub><mo>=</mo><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub><msup><mi mathvariant=\"normal\">e</mi><mrow><mo>-</mo><mi>kt</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>300</mn></mfrac></math>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi mathvariant=\"normal\">k</mi><mo>=</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>180</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub></mfenced><mi mathvariant=\"normal\">A</mi></msub><msup><mi mathvariant=\"normal\">e</mi><mrow><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">A</mi></msub><mi mathvariant=\"normal\">t</mi></mrow></msup></math>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub></mfenced><mi mathvariant=\"normal\">B</mi></msub><msup><mi mathvariant=\"normal\">e</mi><mrow><mo>-</mo><msub><mi mathvariant=\"n