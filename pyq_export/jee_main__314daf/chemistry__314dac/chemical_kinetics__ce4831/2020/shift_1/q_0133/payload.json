    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>120</mn></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub><mo>=</mo><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub><msup><mi mathvariant=\"normal\">e</mi><mrow><mo>-</mo><mi>kt</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>300</mn></mfrac></math>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi mathvariant=\"normal\">k</mi><mo>=</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><msub><mi mathvariant=\"normal\">T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>180</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub></mfenced><mi mathvariant=\"normal\">A</mi></msub><msup><mi mathvariant=\"normal\">e</mi><mrow><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">A</mi></msub><mi mathvariant=\"normal\">t</mi></mrow></msup></math>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub></mfenced><mi mathvariant=\"normal\">B</mi></msub><msup><mi mathvariant=\"normal\">e</mi><mrow><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">B</mi></msub><mi mathvariant=\"normal\">t</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mrow><mo>,</mo><mi mathvariant=\"normal\">B</mi></mrow></msub><mrow><mfenced><msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mo>,</mo><mi mathvariant=\"normal\">A</mi></mrow></mfrac><mo>=</mo><mfrac><msub><mfenced><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub></mfenced><mrow><mo>,</mo><mi mathvariant=\"normal\">B</mi></mrow></msub><mrow><mfenced><msub><mi mathvariant=\"normal\">C</mi><mn>0</mn></msub></mfenced><mo>,</mo><mi mathvariant=\"normal\">A</mi></mrow></mfrac><mo>&#215;</mo><msup><mi mathvariant=\"normal\">e</mi><mrow><mfenced><mrow><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">A</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">B</mi></msub></mrow></mfenced><mi mathvariant=\"normal\">t</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>=</mo><msup><mi mathvariant=\"normal\">e</mi><mrow><mfenced><mrow><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">A</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">B</mi></msub></mrow></mfenced><mi mathvariant=\"normal\">t</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi>ln</mi><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>=</mo><mfenced close=\"]\" open=\"[\"><mrow><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>300</mn></mfrac><mo>-</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>180</mn></mfrac></mrow></mfenced><mi mathvariant=\"normal\">t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mo>-</mo><mn>2</mn><mi>ln</mi><mn>2</mn><mo>=</mo><mfenced close=\"]\" open=\"[\"><mrow><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>300</mn></mfrac><mo>-</mo><mfrac><mrow><mi>ln</mi><mn>2</mn></mrow><mn>180</mn></mfrac></mrow></mfenced><mi mathvariant=\"normal\">t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>=</mo><mfenced><mfrac><mn>120</mn><mrow><mn>180</mn><mo>&#215;</mo><mn>300</mn></mrow></mfrac></mfenced><mi mathvariant=\"normal\">t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">t</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mo>&#215;</mo><mn>180</mn><mo>&#215;</mo><mn>300</mn></mrow><mn>120</mn></mfrac><mo>=</mo><mn>900</mn><mo>&#160;</mo><mi>sec</mi></math></p>"
