  "question": {
    "text": "$\\mathrm{t}_{1 / 4}$ can be taken as the time taken for the concentration of a reactant to drop to $\\frac{3}{4}$ of its initial value. If the rate constant for a first order reaction is $\\mathrm{K}$, the $\\mathrm{t}_{1 / 4}$ can be written as",
    "image": null
  },
  "options": [
    {
      "id": "saki6",
      "text": "\n$0.10 / \\mathrm{K}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MRFW9",
      "text": "\n$0.29 / \\mathrm{K}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GyF8Z",
      "text": "\n$0.69 / \\mathrm{K}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ShiTq",
      "text": "\n$0.75 / \\mathrm{K}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\nt_{1 / 4}=\\frac{2.303}{K} \\log \\frac{1}{1-\\frac{1}{4}}=\\frac{0.29}{K}\n$$",
    "image": null
  },
