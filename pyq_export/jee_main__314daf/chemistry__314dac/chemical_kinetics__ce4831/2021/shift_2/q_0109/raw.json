l\">A</mi><mi mathvariant=\"normal\">t</mi></msub></mfenced><mo>=</mo><mfrac><msub><mi mathvariant=\"normal\">A</mi><mn>0</mn></msub><msup><mfenced><mn>2</mn></mfenced><mi mathvariant=\"normal\">n</mi></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>&#8594;</mo></math> no. of Half lives</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;Now from the relation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mi mathvariant=\"normal\">x</mi><msup><mfenced><mn>2</mn></mfenced><msub><mi mathvariant=\"normal\">n</mi><mn>1</mn></msub></msup></mfrac><mo>=</mo><mfrac><mi mathvariant=\"normal\">x</mi><msup><mfenced><mn>2</mn></mfenced><msub><mi mathvariant=\"normal\">n</mi><mn>2</mn></msub></msup></mfrac><mo>&#215;</mo><mn>16</mn><mo>&#8658;</mo><msup><mfenced><mn>2</mn></mfenced><msub><mi mathvariant=\"normal\">n</mi><mn>2</mn></msub></msup><mo>=</mo><msup><mfenced><mn>2</mn></mfenced><msub><mi mathvariant=\"normal\">n</mi><mn>1</mn></msub></msup><mo>&#215;</mo><msup><mfenced><mn>2</mn></mfenced><mn>4</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi mathvariant=\"normal\">n</mi><mn>2</mn></msub><mo>=</mo><msub><mi mathvariant=\"normal\">n</mi><mn>1</mn></msub><mo>+</mo><mn>4</mn><mo>&#8658;</mo><mfrac><mi mathvariant=\"normal\">t</mi><msub><mfenced><msub><mi mathvariant=\"normal\">t</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub></mfenced><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><mi mathvariant=\"normal\">t</mi><msub><mfenced><msub><mi mathvariant=\"normal\">t</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub></mfenced><mn>1</mn></msub></mfrac><mo>+</mo><mn>4</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi mathvariant=\"normal\">t</mi><mfenced><mrow><