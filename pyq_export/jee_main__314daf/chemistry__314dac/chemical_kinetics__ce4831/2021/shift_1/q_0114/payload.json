  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mo>&#160;</mo><mi mathvariant=\"normal\">k</mi><mo>=</mo><mi>log</mi><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi><mo>-</mo><mfrac><mi>Ea</mi><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mi>RT</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mi>Slope</mi></mfenced><mo>=</mo><mfrac><mrow><mo>&#160;</mo><mi>Ea</mi><mo>&#160;</mo></mrow><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mi mathvariant=\"normal\">R</mi></mrow></mfrac><mo>=</mo><mn>10</mn><mo>,</mo><mn>000</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mfenced><mfrac><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><mrow><mo>&#160;</mo><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub></mrow></mfrac></mfenced><mo>=</mo><mfrac><mi>Ea</mi><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mi mathvariant=\"normal\">R</mi></mrow></mfrac><mfenced><mrow><mfrac><mn>1</mn><mrow><mo>&#160;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub></mrow></mfrac><mo>-</mo><mfrac><mn>1</mn><mrow><mo>&#160;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub></mrow></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mfenced><mfrac><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup></mfrac></mfenced><mo>=</mo><mn>10</mn><mo>,</mo><mn>000</mn><mfenced close=\"]\" open=\"[\"><mrow><mfrac><mn>1</mn><mn>500</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mrow><mo>&#160;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub></mrow></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mfenced><mfrac><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup></mfrac></mfenced><mo>=</mo><mn>10</mn><mo>,</mo><mn>000</mn><mfenced close=\"]