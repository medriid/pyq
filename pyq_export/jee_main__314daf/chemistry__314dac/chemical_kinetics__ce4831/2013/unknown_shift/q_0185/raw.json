  "question": {
    "text": "The rate constant of a zero order reaction is $2.0 \\times$ $10^{-2} \\mathrm{~mol} \\mathrm{~L}^{-1} \\mathrm{~s}^{-1}$. If the concentration of the reactant after 25 seconds is $0.5 \\mathrm{M}$. What is the initial concentration?",
    "image": null
  },
  "options": [
    {
      "id": "wCtZq",
      "text": "\n$0.5 \\mathrm{M}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uJgO6",
      "text": "\n$1.25 \\mathrm{M}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Q9MIl",
      "text": "\n$12.5 \\mathrm{M}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Uv9UE",
      "text": "\n$1.0 \\mathrm{M}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For a zero order reaction\n$$\n\\begin{aligned}\n& \\text { Rate constant }=\\mathrm{k}=\\frac{a-x}{t} \\\\\n& 2 \\times 10^{-2}=\\frac{a-0.5}{25} \\\\\n& a-0.5=0.5 \\\\\n& a=1.0 \\mathrm{M}\n\\end{aligned}\n$$",
    "image": null
  },
