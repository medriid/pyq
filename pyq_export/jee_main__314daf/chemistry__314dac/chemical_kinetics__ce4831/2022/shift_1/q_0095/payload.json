thvariant=\"normal\">t</mi><mrow><mn>67</mn><mo>%</mo></mrow></msub><mo>=</mo><mn>1</mn><mo>.</mo><mn>585</mn><mo>&#215;</mo><msub><mi mathvariant=\"normal\">t</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn><mo>.</mo><mn>585</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi mathvariant=\"normal\">X</mi><mo>=</mo><mn>15</mn><mo>.</mo><mn>85</mn></math></p>"
