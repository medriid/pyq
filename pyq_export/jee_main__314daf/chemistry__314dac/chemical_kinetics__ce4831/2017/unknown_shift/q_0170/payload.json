  "solution": {
    "text": "From Arrhenius equation<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">k</mi><mo>=</mo><msup><mi>Ae</mi><mrow><mo>-</mo><mi>Ea</mi><mo>/</mo><mi>RT</mi></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub><mo>=</mo><msup><mi>Ae</mi><mrow><mo>-</mo><msub><mi>Ea</mi><mn>1</mn></msub><mo>/</mo><mi>RT</mi></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><mo>=</mo><msup><mi>Ae</mi><mrow><mo>-</mo><msub><mi>Ea</mi><mn>2</mn></msub><mo>/</mo><mi>RT</mi></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ln</mi><mfrac><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub></mfrac><mo>=</mo><msup><mi mathvariant=\"normal\">e</mi><mrow><mfenced separators=\"|\"><mrow><msub><mi>Ea</mi><mn>1</mn></msub><mo>-</mo><msub><mi>Ea</mi><mn>2</mn></msub></mrow></mfenced><mo>/</mo><mi>RT</mi></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ln</mi><mo>&#8289;</mo><mfrac><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub></mfrac><mo>=</mo><mfrac><mrow><msub><mi>Ea</mi><mn>1</mn></msub><mo>-</mo><msub><mi>Ea</mi><mn>2</mn></msub></mrow><mi>RT</mi></mfrac><mo>=</mo><mfrac><mrow><mn>10</mn><mo>&#215;</mo><mn>1000</mn></mrow><mrow><mn>8</mn><mo>.314</mo><mo>&#215;</mo><mn>300</mn></mrow></mfrac><mo>=</mo><mn>4</mn></math>"
