  "question": {
    "text": "The half - life of a radioisotope is four hours. If the initial mass of the isotope was $200 \\mathrm{~g}$, the mass remaining after 24 hours undecayed is"
  },
  "options": [
    {
      "text": "\n$1.042 \\mathrm{~g}$\n",
      "is_correct": false
    },
    {
      "text": "\n$4.167 \\mathrm{~g}$\n",
      "is_correct": false
    },
    {
      "text": "\n$3.125 \\mathrm{~g}$\n",
      "is_correct": true
    },
    {
      "text": "\n$2.084 \\mathrm{~g}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$2^6=\\frac{200}{a-x}$\n$(a-x)=3.125 \\mathrm{gm}$"
