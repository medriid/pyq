  "question": {
    "text": "For a first order reaction, $(A) \\rightarrow$ products, the concentration of $A$ changes from $0.1 \\mathrm{~M}$ to $0.025 \\mathrm{~M}$ in $40$ minutes. The rate of reaction when the concentration of $A$ is $0.01 \\mathrm{~M}$ is :"
  },
  "options": [
    {
      "text": "\n$1.73 \\times 10^{-5} \\mathrm{M} / \\mathrm{min}$\n",
      "is_correct": false
    },
    {
      "text": "\n$3.47 \\times 10^{-4} \\mathrm{M} / \\mathrm{min}$\n",
      "is_correct": true
    },
    {
      "text": "\n$3.47 \\times 10^{-5} \\mathrm{M} / \\mathrm{min}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.73 \\times 10^{-4} \\mathrm{M} / \\mathrm{min}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{k}=\\frac{2.303}{40} \\log \\frac{0.1}{0.025} \\\\\n& \\mathrm{k}=\\frac{0.693}{20}\n\\end{aligned}$\nFor a F.O.R., rate $=k[\\mathrm{~A}]$; \nrate $=\\frac{0.693}{20} \\times 10^{-2}=3.47 \\times 10^{-4} \\mathrm{~M} / \\mathrm{min}$."
  }
}