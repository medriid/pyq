  "question": {
    "text": "For a reaction $\\frac{1}{2} A \\rightarrow 2 B$, rate of disappearance of ' $A$ ' is related to the rate of appearance of 'B' by the expression",
    "image": null
  },
  "options": [
    {
      "id": "QfgWx",
      "text": "\n$-\\frac{\\mathrm{d}[\\mathrm{A}]}{\\mathrm{dt}}=\\frac{1}{2} \\frac{\\mathrm{d}[\\mathrm{B}]}{\\mathrm{dt}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bRF8i",
      "text": "\n$-\\frac{\\mathrm{d}[\\mathrm{A}]}{\\mathrm{dt}}=\\frac{1}{4} \\frac{\\mathrm{d}[\\mathrm{B}]}{\\mathrm{dt}}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "yD2Cw",
      "text": "\n$-\\frac{\\mathrm{d}[\\mathrm{A}]}{\\mathrm{dt}}=\\frac{\\mathrm{d}[\\mathrm{B}]}{\\mathrm{dt}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PkjiZ",
      "text": "\n$-\\frac{\\mathrm{d}[\\mathrm{A}]}{\\mathrm{dt}}=4 \\frac{\\mathrm{d}[\\mathrm{B}]}{\\mathrm{dt}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\frac{1}{2} \\mathrm{~A} \\longrightarrow 2 \\mathrm{~B} \\\\\n& \\frac{-2 \\mathrm{~d}[\\mathrm{~A}]}{\\mathrm{dt}}=+\\frac{\\mathrm{d}[\\mathrm{B}]}{2 \\mathrm{dt}} \\\\\n& \\frac{-\\mathrm{d}[\\mathrm{A}]}{\\mathrm{dt}}=\\frac{1}{4} \\frac{\\mathrm{d}[\\mathrm{B}]}{\\mathrm{dt}}\n\\end{aligned}\n$$",
    "image": null
  },
