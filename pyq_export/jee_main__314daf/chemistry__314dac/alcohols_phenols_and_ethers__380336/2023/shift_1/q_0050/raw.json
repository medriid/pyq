  "question": {
    "text": "<p>Decreasing order of dehydration of the following alcohols is</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/278b9f93-6cb3-4b74-9a38-211c65d75f08-9896773.png\" style=\"width: 700px; height: 130px;\" />&nbsp;</p>",
    "image": null
  },
  "options": [
