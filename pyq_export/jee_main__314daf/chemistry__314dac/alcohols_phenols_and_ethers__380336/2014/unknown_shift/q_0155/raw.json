  "question": {
    "text": "The most suitable reagent for the conversion of <math> <mrow> <mtext>R</mtext> <mo>-</mo> <msub> <mtext>CH</mtext> <mn>2</mn> </msub> <mo>-</mo> <mtext>OH</mtext> <mo>&#8594;</mo> <mtext>R</mtext> <mo>-</mo> <mtext>CHO</mtext> </mrow> </math> is :",
    "image": null
  },
  "options": [
    {
      "id": "VI2nG",
      "text": "KMnO<sub>4</sub>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TCiDm",
      "text": "K<sub>2</sub>Cr<sub>2</sub>O<sub>7</sub>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cL9l0",
      "text": "CrO<sub>3</sub>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RUTBP",
      "text": "PCC (Pyridinium Chlorochromate)",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<p style=\"text-align: justify;\">&bull; KMnO<sub>4</sub>&nbsp;will&nbsp;oxidize&nbsp;the alcohol to carboxylic acid.<br />&bull;&nbsp;K<sub>2</sub>Cr<sub>2</sub>O<sub>7</sub>&nbsp;will also make carboxylic acids.<br />&bull;&nbsp;​CrO<sub>3</sub>&nbsp;in acetic acid is Jones reagent, it also converts&nbsp;alcohols&nbsp;to carboxylic acid.<br />&bull;​ PCC is a weak oxidising agent. It limits the oxidation to the aldehyde.</p>",
    "image": null
  },
