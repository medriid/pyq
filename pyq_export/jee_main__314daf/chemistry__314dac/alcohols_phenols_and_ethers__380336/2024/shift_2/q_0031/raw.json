  "question": {
    "text": "Phenol treated with chloroform in presence of sodium hydroxide, which further hydrolysed in presence of an acid results",
    "image": null
  },
  "options": [
    {
      "id": "pXqGc",
      "text": "Salicyclic acid",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "793QY",
      "text": "Benzene-1,2-diol",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gjRGi",
      "text": "Benzene-1, 3-diol",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TCOlW",
      "text": "2-Hydroxybenzaldehyde",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<p>Chloroform <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><msub><mi>CHCl</mi><mn>3</mn></msub></mfenced></math> in the presence of an alkali <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>NaOH</mi></mfenced></math> undergoes formylation of phenol at the ortho-position. This is also called as the Reimer-Tiemann reaction.</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/0c717928-6141-4e90-9e6f-77e61cdc75fb.png\" style=\"width: 600px; height: 164px;\"/>Hence, the answer is option D.</p>",
    "image": null
  },
