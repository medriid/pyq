  "question": {
    "text": "In the Claisen-Schmidt reaction to prepare, dibenzalacetone from 5.3 g of benzaldehyde, a total of 3.51 g of product was obtained. The percentage yield in this reaction was ______ %.",
    "image": null
  },
  "options": [],
  "correctValue": "60",
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/xip3q87y_iZ5_6VEVX01xq8BmO_1I-Jplxb3QoFXY1c.original.fullsize.png\"><br>\n\n\n\n\n$\\begin{aligned} & \\text { Theoretical }=\\frac{1}{40} \\mathrm{Mol} \\\\ & \\% \\text { yield }=\\frac{0.015}{1 / 40} \\times 100 \\\\ & \\Rightarrow 60 \\%\\end{aligned}$",
    "image": null
  },
