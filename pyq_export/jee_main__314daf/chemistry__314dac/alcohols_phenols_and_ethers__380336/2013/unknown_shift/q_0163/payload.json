  "question": {
    "text": "Amongst the following alcohols which would react fastest with conc. $\\mathrm{HCl}$ and $\\mathrm{ZnCl}_2$ ?"
  },
  "options": [
    {
      "text": "\npentanol\n",
      "is_correct": false
    },
    {
      "text": "\n2-methyl butanol\n",
      "is_correct": false
    },
    {
      "text": "\n2-pentanol\n",
      "is_correct": false
    },
    {
      "text": "\n2-methyl butan-2-ol",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{ZnCl}_2+$ conc. $\\mathrm{HCl}$ is Lucas reagent. Lucas reagent reacts fastest with tertiary alcohol. $3^{\\circ}$ alcohol $+$ Lucas reagent $=$ Immediate turbidity"
