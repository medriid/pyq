  "question": {
    "text": "Cannizaro's reaction is not given by :"
  },
  "options": [
    {
      "text": "\n<img src=\"assets\\ot1_0169_a2adbbbf3d00.png\"><br>",
      "is_correct": false
    },
    {
      "text": "\n<img src=\"assets\\ot2_0169_d2b2b08d4673.png\"><br>",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{CH}_3 \\mathrm{CHO}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{HCHO}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Only those aldehydes which do not have $\\alpha-\\mathrm{H}$ atom undergo Cannizaro's reaction. \nHence $\\mathrm{CH}_3 \\mathrm{CHO}$ will not undergo Cannizaro's reaction as it has $3 \\alpha$ $\\mathrm{H}$ atoms."
  }
}