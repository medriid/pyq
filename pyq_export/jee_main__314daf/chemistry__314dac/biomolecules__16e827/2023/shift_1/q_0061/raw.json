    "text": "<p>Match List I and List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\">\t\t\t<p style=\"text-align: center;\">List I</p>\t\t\t<p style=\"text-align: center;\">Vitamin</p>\t\t\t</td>\t\t\t<td colspan=\"2\" rowspan=\"1\">\t\t\t<p style=\"text-align: center;\">List II</p>\t\t\t<p style=\"text-align: center;\">Deficiency disease</p>\t\t\t</td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math></td>\t\t\t<td style=\"text-align: center;\">Vitamin A</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math></td>\t\t\t<td style=\"text-align: center;\">Beri-Beri</td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math></td>\t\t\t<td style=\"text-align: center;\">Thiamine</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi></math></td>\t\t\t<td style=\"text-align: center;\">Cheilosis</td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi></math></td>\t\t\t<td style=\"text-align: center;\">Ascorbic acid</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>III</mi></math></td>\t\t\t<td style=\"text-align: center;\">Xerophthalmia</td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">D</mi></math></td>\t\t\t<td style=\"text-align: center;\">Riboflavin</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IV</mi></math></td>\t\t\t<td style=\"text-align: center;\">Scurvy</td>\t\t</tr>\t</tbody></ta