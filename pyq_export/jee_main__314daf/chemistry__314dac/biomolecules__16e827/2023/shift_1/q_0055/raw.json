  "question": {
    "text": "<p>The correct representation in six membered pyranose form for the following sugar [<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">X</mi></math>] is</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/86397945-3e4b-4f84-938c-fa4a2a7f5965-9896769.png\" style=\"width: 250px; height: 469px;\" />&nbsp;</p>",
