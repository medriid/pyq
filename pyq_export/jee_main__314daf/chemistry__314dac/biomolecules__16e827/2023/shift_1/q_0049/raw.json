  "question": {
    "text": "<p>Sulphur (S) containing amino acids from the following are:</p><p>(a) isoleucine</p><p>(b) cysteine</p><p>(c) lysine</p><p>(d) methionine</p><p>(e) glutamic acid</p>",
    "image": null
  },
