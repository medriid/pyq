  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\"> <tbody> <tr> <td> </td> <td style=\"text-align: center;\"><strong>List-I</strong></td> <td style=\"text-align: center;\"> </td> <td style=\"text-align: center;\"><strong>List-II</strong></td> </tr> <tr> <td>A.</td> <td>Glucose/<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NaHCO</mi><mn>3</mn></msub><mo>/</mo><mo>∆</mo></math></td> <td>I.</td> <td>Gluconic acid</td> </tr> <tr> <td>B.</td> <td>Glucose/<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>HNO</mi><mn>3</mn></msub></math></td> <td>II.</td> <td>No reaction</td> </tr> <tr> <td>C.</td> <td>Glucose/<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HI</mi><mo>/</mo><mo>∆</mo></math></td> <td>III.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi></math>-hexane</td> </tr> <tr> <td>D.</td> <td>Glucose/Bromine water</td> <td>IV.</td> <td>Saccharic acid</td> </tr> </tbody></table><p>Choose the correct answer from the options given below:</p>",
    "image": null
  },
  "options": [
    {
      "id": "A4u2m",
      "text": "A-IV, B-I, C-III, D-II",
      "image": null,
