  "question": {
    "text": "<p>Match List I with List I</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\"> <tbody> <tr> <td> </td> <td>List I (Substances)</td> <td> </td> <td>List II (Element Present)</td> </tr> <tr> <td>A.</td> <td>Ziegler catalyst</td> <td>I.</td> <td>Rhodium</td> </tr> <tr> <td>B.</td> <td>Blood Pigment</td> <td>II.</td> <td>Cobalt</td> </tr> <tr> <td>C.</td> <td>Wilkinson catalyst</td> <td>III.</td> <td>Iron</td> </tr> <tr> <td>D.</td> <td>Vitamin B12</td> <td>IV.</td> <td>Titanium</td> </tr> </tbody></table><p>Choose the correct answer from the options given below:</p>",
    "image": null
  },
