  "question": {
    "text": "Type of amino acids obtained by hydrolysis of proteins is :",
    "image": null
  },
  "options": [
    {
      "id": "DvNbP",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>β</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JBDuw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "LiDEC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>δ</mi></math>",
      "image": null,
