      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{P}_{\\mathrm{B}}=\\mathrm{P}_{\\mathrm{B}}^{\\circ} \\times \\mathrm{B}=75 \\times \\frac{1}{1.5}=50$ torr",
    "image": null
