  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "<p>For <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi>mol</mi></math>&nbsp;of gas, the plot of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>pV</mi></math> vs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">p</mi></math> is shown below. p is the pressure and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">V</mi></math> is the volume of the gas.</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/243e7a1b-f499-4e99-a001-6dd5cffb223a-9894989.png\" style=\"width: 400px; height: 281px;\" /></p><p>What is the value of compressibility factor at point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>?</p>",
    "image": null
  },
  "options": [
    {
      "id": "oMAS1",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>-</mo><mfrac><mi mathvariant=\"normal\">a</mi><mi>RTV</mi></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "aUAUn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mfrac><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">V</mi></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "v7qle",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>-</mo><mfrac><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">V</mi></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Ke5jD",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mfrac><mi mathvariant=\"normal\">a</mi><mi>RTV</mi></mfrac></math>",
      "isCorrect": false,
      "image": null
