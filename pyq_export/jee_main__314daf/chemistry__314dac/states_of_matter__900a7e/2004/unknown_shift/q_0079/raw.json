  "question": {
    "text": "As the temperature is raised from $20^{\\circ} \\mathrm{C}$ to $40^{\\circ} \\mathrm{C}$, the average kinetic energy of neon atoms changes by a factor of which of the following?",
    "image": null
  },
  "options": [
    {
      "id": "M0QmP",
      "text": "\n$1 / 2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ptnV8",
      "text": "\n2\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "derly",
      "text": "\n$\\frac{313}{293}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UguuG",
      "text": "\n$\\sqrt{\\frac{313}{293}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{E_1}{E_2}=\\frac{T_1}{T_2}$\n$\\frac{E_1}{E_2}=\\frac{293}{313}$\n$\\because$ factor $=\\frac{313}{293}$",
    "image": null
  },
