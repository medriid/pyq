  "question": {
    "text": "By how many folds the temperature of a gas would increase when the root mean square velocity of the gas molecules in a container of fixed volume is increased from $5 \\times 10^4 \\mathrm{~cm} / \\mathrm{s}$ to $10 \\times 10^4 \\mathrm{~cm} / \\mathrm{s}$ ?",
    "image": null
  },
  "options": [
    {
      "id": "0w72P",
      "text": "\nTwo\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "h5MWI",
      "text": "\nThree\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nGFkg",
      "text": "\nSix\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4ZEc8",
      "text": "\nFour",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "r.m.s. velocity $\\mathrm{V}_{\\mathrm{rms}}=\\sqrt{\\frac{3 R T}{M}}$\ni.e., $\\frac{\\mathrm{V}_1}{\\mathrm{~V}_2}=\\sqrt{\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}}$\n$\\frac{5 \\times 10^4}{10 \\times 10^4}=\\frac{1}{2}=\\sqrt{\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}}$\n$\\therefore \\mathrm{T}_2=4 \\mathrm{T}_1$",
    "image": null
  },
