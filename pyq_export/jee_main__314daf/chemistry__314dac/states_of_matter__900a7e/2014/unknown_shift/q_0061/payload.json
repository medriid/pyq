  "question": {
    "text": "If Z is the compressibility factor, then Van der Waal's equation at low pressure can be written as:"
  },
  "options": [
    {
      "text": "<math> <mrow> <mtext>Z</mtext> <mo>=</mo> <mn>1</mn> <mo>+</mo> <mfrac> <mrow> <mtext>RT</mtext> </mrow> <mrow> <mtext>Pb</mtext> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mtext>Z</mtext> <mo>=</mo> <mn>1</mn> <mo>-</mo> <mfrac> <mrow> <mtext>a</mtext> </mrow> <mrow> <mtext>VRT</mtext> </mrow> </mfrac> </mrow> </math>",
