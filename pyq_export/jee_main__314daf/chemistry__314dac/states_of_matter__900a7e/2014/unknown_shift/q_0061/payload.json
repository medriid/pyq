    },
    {
      "text": "<math> <mrow> <mtext>Z</mtext> <mo>=</mo> <mn>1</mn> <mo>-</mo> <mfrac> <mrow> <mtext>Pb</mtext> </mrow> <mrow> <mtext>RT</mtext> </mrow> </mfrac> </mrow> </math>",
