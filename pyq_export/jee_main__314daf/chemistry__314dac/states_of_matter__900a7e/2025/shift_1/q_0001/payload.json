  "question": {
    "text": "For a reaction, $\\mathrm{N}_2 \\mathrm{O}_{5(\\mathrm{~g})} \\rightarrow 2 \\mathrm{NO}_{2(\\mathrm{~g})}+\\frac{1}{2} \\mathrm{O}_{2(\\mathrm{~g})}$ in a constant volume container, no products were present initially. The final pressure of the system when $50 \\%$ of reaction gets completed is"
  },
  "options": [
    {
      "text": "5 times of initial pressure",
      "is_correct": false
    },
    {
      "text": "$5 / 2$ times of initial pressure",
      "is_correct": false
    },
    {
      "text": "$7 / 2$ times of initial pressure",
      "is_correct": false
    },
    {
      "text": "$7 / 4$ times of initial pressure",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0001_27d9e08d6158.png\"><br>\n\n\n\n$\\begin{gathered}x=\\frac{P_0}{2} \\\\ P_{\\text {total }}=P_0-\\frac{P_0}{2}+P_0+\\frac{P_0}{4}=\\frac{7}{4} P_0\\end{gathered}$"
  }
}