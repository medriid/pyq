  "question": {
    "text": "The relationship among most probable velocity, average velocity and root mean square velocity is respectively"
  },
  "options": [
    {
      "text": "\n$\\sqrt{2}: \\sqrt{3}: \\sqrt{8 / \\pi}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sqrt{2}: \\sqrt{8 / \\pi}: \\sqrt{3}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\sqrt{8 / \\pi}: \\sqrt{3}: \\sqrt{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sqrt{3}: \\sqrt{8 / \\pi}: \\sqrt{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Most probable speed $\\left(C^*\\right)=\\sqrt{\\frac{2 R T}{M}}$ Average speed $(\\bar{C})=\\sqrt{\\frac{8 R T}{\\pi M}}$ Root mean square velocity $(C)=\\sqrt{\\frac{3 R T}{M}}$ $C^*: \\bar{C}: C=\\sqrt{2}: \\sqrt{\\frac{8}{\\pi}}: \\sqrt{3}$"
  }
}