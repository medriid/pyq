  "question": {
    "text": "For $1 \\mathrm{~mol}$ of an ideal gas at a constant temperature $T$, the plot of $(\\log P)$ against $(\\log V)$ is a ( $P$ : Pressure, $V$ : Volume)",
    "image": null
  },
  "options": [
    {
