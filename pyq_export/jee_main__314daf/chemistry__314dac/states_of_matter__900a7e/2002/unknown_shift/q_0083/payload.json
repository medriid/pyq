  "question": {
    "text": "For an ideal gas, number of moles per litre in terms of its pressure P, gas contant R and temperature T is"
  },
  "options": [
    {
      "text": "\nPT/R\n",
      "is_correct": false
    },
    {
      "text": "\nPRT\n",
      "is_correct": false
    },
    {
      "text": "\nP/RT\n",
      "is_correct": true
    },
    {
      "text": "\nRT/P",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "PV = nRT (number of moles = n/V) $\\therefore$ n/V = P/RT"
  }
