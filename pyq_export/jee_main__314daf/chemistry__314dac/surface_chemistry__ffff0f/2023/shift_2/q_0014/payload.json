  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List I</strong></td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List II</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td>Physisorption</td>\t\t\t<td>I</td>\t\t\t<td>Single Layer Adsorption</td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td>Chemisorption</td>\t\t\t<td>II</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn><mo>-</mo><mn>40</mn><mo>&#160;</mo><mi>kJ</mi><mo>&#160;</mo><msup><mi>mol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">N</mi><mn>2</mn></msub><mfenced><mi mathvariant=\"normal\">g</mi></mfenced><mo>+</mo><mn>3</mn><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mfenced><mi mathvariant=\"normal\">g</mi></mfenced><mover><mo>&#10230;</mo><mrow><mi>Fe</mi><mo>(</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo></mrow></mover><mn>2</mn><msub><mi>NH</mi><mn>3</mn></msub><mfenced><mi mathvariant=\"normal\">g</mi></mfenced></math></td>\t\t\t<td>III</td>\t\t\t<td>Chromatography</td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td>Analytical Application or Adsorption</td>\t\t\t<td>IV</td>\t\t\t<td>Heterogeneous catalysis</td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below:</p>"
  },
