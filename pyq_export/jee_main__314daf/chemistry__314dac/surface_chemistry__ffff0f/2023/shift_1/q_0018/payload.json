  "question": {
    "text": "Which of the following salt solutions would coagulate the colloid soloution formed when <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>FeCl</mi><mn>3</mn></msub></math>&nbsp;is added to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaOH</mi></math>&nbsp;solution, at the fastest rate?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>mL</mi></math>&nbsp;of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>2</mn><mo>&#160;</mo><mi>mol</mi><mo>&#160;</mo><msup><mi>dm</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#160;</mo><msub><mi>AlCl</mi><mn>3</mn></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>mL</mi></math>&nbsp;of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>1</mn><mo>&#160;</mo><mi>mol</mi><mo>&#160;</mo><msup><mi>dm</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#160;</mo><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>mL</mi></math>&nbsp;of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>1</mn><mo>&#160;</mo><mi>mol</mi><mo>&#160;</mo><msup><mi>dm</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#160;</mo><msub><mi>Ca</mi><mn>3</mn></msub><msub><mfenced><msub><mi>PO</mi><mn>4</mn></msub></mfenced><mn>2</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>&#160;</mo><mi>mL</mi></math>&nbsp;of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>15</mn><mo>&#160;</mo><mi>mol</mi><mo>&#160;</mo><msup><mi>dm</mi><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#160;</mo><msub><mi>CaCl</mi><mn>2</mn></msub></math>",
      "is_correct": false
