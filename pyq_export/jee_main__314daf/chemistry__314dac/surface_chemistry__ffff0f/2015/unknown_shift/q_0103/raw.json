      "text": "Enthalpy of adsorption is negative",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W5EG5",
      "text": "On adsorption decrease in surface energy appears as heat",
      "image": null,
      "isCorrect": false
    },
    {
