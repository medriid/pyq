    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi mathvariant=\"normal\">D</mi></math>&nbsp;only",
