  "correctValue": null,
  "solution": {
    "text": "Gold Number is the minimum amount of lyophilic colloide in miligrams (starch in given case) which prevents the flocculation of $10 \\mathrm{ml}$ gold sol by the addition of $1 \\mathrm{ml}$ of $10 \\% \\mathrm{NaCl}$ solution.\n$\\therefore$ Gold number $=$ miligram of starch $=0.025 \\times 10^3 \\mathrm{mg}$ $=25$",
    "image": null
  },
