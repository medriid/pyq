  "question": {
    "text": "According to Freundlich adsorption isotherm, which of the following is correct ?",
    "image": null
  },
  "options": [
    {
      "id": "jUQmX",
      "text": "\n$\\frac{x}{m} \\propto P^0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xzpPR",
      "text": "\n$\\frac{x}{m} \\propto p^1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "h5yys",
      "text": "\n$\\frac{x}{m} \\propto p^{1 / n}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Uh1Jk",
      "text": "\nAll the above are correct for different ranges of pressure",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\mathrm{x}}{\\mathrm{m}} \\propto \\mathrm{P}^0$ is true at extremely high pressures\n$\\frac{x}{m} \\propto p^1 ; \\frac{x}{m} \\propto p^{1 / n}$ are true at low and moderate pressures.",
    "image": null
  },
