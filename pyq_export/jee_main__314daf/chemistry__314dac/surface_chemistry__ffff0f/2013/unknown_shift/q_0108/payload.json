  "question": {
    "text": "The coagulating power of electrolytes having ions <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Na</mi><mo>+</mo></msup></math>,&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Al</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ba</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>&nbsp;for arsenic sulphide sol increases in the order,"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ba</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi>Na</mi><mo>+</mo></msup><mo>&#60;</mo><msup><mi>Al</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Al</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi>Na</mi><mo>+</mo></msup><mo>&#60;</mo><msup><mi>Ba</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Al</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi>Ba</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi>Na</mi><mo>+</mo></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Na</mi><mo>+</mo></msup><mo>&#60;</mo><msup><mi>Ba</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mi>Al</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
