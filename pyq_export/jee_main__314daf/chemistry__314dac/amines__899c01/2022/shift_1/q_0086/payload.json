  "question": {
    "text": "<p>The reaction of&nbsp;<img src=\"assets\\qt0086_9cd740d77b27.png\" style=\"width: 150px; height: 80px;\" />&nbsp;with bromine and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>KOH</mi></math> gives <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>RNH</mi><mn>2</mn></msub></math> as the end product. Which one of the following is the intermediate product formed in this reaction?</p>"
  },
  "options": [
    {
      "text": "<img src=\"assets\\ot1_0086_f28ee6acbf1b.png\" style=\"width: 150px; height: 60px;\" />",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi><mo>-</mo><mi>NH</mi><mo>-</mo><mi>Br</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi><mo>-</mo><mi mathvariant=\"normal\">N</mi><mo>=</mo><mi mathvariant=\"normal\">C</mi><mo>=</mo><mi mathvariant=\"normal\">O</mi></math>",
      "is_correct": true
    },
    {
      "text": "<img src=\"assets\\ot4_0086_ebbefb9b1911.png\" style=\"width: 150px; height: 77px;\" />",
      "is_correct": false
