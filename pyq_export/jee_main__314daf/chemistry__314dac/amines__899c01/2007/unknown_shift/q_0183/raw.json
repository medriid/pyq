  "question": {
    "text": "Which one of the following is the strongest base in aqueous solution?",
    "image": null
  },
  "options": [
    {
      "id": "zperG",
      "text": "\nTrimethylamine\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RMyRK",
      "text": "\nAniline\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tNqk5",
      "text": "\nDimethylamine\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "NQ3lw",
      "text": "\nMethylamine",
      "image": null,
      "isCorrect": false
    }
