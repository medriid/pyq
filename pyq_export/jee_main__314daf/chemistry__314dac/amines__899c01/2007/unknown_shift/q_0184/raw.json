  "question": {
    "text": "In the chemical reaction, $\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{NH}_2-\\mathrm{CHCl}_3+3 \\mathrm{KOH} \\longrightarrow(\\mathrm{A})+(\\mathrm{B})+3 \\mathrm{H}_2 \\mathrm{O}$, the compound $\\mathrm{(A)}$ and $\\mathrm{(B)}$ are respectively",
    "image": null
  },
  "options": [
    {
      "id": "GRk70",
      "text": "\n$\\mathrm{C}_2 \\mathrm{H}_5 \\mathrm{CN}$ and $3 \\mathrm{KCl}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "n1vw1",
      "text": "\n$\\mathrm{CH}_3 \\mathrm{CH}_2 \\mathrm{CONH}_2$ and $3 \\mathrm{KCl}$\n",
      "image": null,
      "isCorrect": false
    },
    {
