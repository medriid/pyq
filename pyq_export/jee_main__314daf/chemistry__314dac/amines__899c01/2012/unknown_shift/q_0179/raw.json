  "question": {
    "text": "The conversion of benzene diazonium chloride to bromobenzene can be accomplished by",
    "image": null
  },
  "options": [
    {
      "id": "ta9Ll",
      "text": "\nReimer-Tiemann reaction\n",
      "image": null,
      "isCorrect": false
    },
    {
