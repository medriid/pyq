  "question": {
    "text": "<p>Choose the correct colour of the product for the following reaction.</p><p>&nbsp;</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/32f698bc-1483-45d4-87f6-6f9ad801b5b2-9894052.png\" style=\"width: 300px; height: 184px;\" /></p>",
