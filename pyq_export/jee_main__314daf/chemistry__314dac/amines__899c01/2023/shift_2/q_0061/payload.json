  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">List I (Amines)</td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\">List II <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>pKb</mi></mfenced></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>A.</td>\t\t\t<td>Aniline</td>\t\t\t<td>I.</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>25</mn></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>B.</td>\t\t\t<td>Ethanamine</td>\t\t\t<td>II.</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>00</mn></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>C.</td>\t\t\t<td>N-Ethylethanamine</td>\t\t\t<td>III.</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>.</mo><mn>38</mn></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>D.</td>\t\t\t<td>N, N-Diethylethanamine</td>\t\t\t<td>IV.</td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>.</mo><mn>29</mn></math></td>\t\t</tr>\t</tbody></table><p>Choose the correct answer from the options given below:-</p>"
  },
  "options": [
    {
      "text": "A-I, B-IV, C-II, D-III",
      "is_correct": false
    },
    {
      "text": "A-III, B-II, C-I, D-IV",
      "is_correct": false
    },
    {
      "text": "A-III, B-II, C-IV, D-I",
      "is_correct": false
    },
    {
      "text": "A-III, B-IV, C-II, D-I",
