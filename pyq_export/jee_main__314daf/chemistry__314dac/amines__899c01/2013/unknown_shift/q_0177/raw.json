  "question": {
    "text": "The order of basicity of amines in gaseous state is :",
    "image": null
  },
  "options": [
    {
      "id": "Qxpmu",
      "text": "\n$1^{\\circ}>2^{\\circ}>3^{\\circ}>\\mathrm{NH}_3$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A7pmW",
      "text": "\n$3^{\\circ}>2^{\\circ}>\\mathrm{NH}_3>1^{\\circ}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hkMvx",
      "text": "\n$3^{\\circ}>2^{\\circ}>1^{\\circ}>\\mathrm{NH}_3$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "VXaZT",
      "text": "\n$\\mathrm{NH}_3>1^{\\circ}>2^{\\circ}>3^{\\circ}$",
      "image": null,
