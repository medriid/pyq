  "question": {
    "text": "Consider the following bromides :\n<img src=\"assets\\qt0164_f99963fe2596.png\"><br>\nThe correct order of $\\mathrm{S}_{\\mathrm{N}} 1$ reactivity is"
  },
  "options": [
    {
      "text": "\n$B>C>A$\n",
      "is_correct": true
    },
    {
      "text": "\n$B>A>C$\n",
      "is_correct": false
    },
    {
      "text": "\n$C>B>A$\n",
      "is_correct": false
    },
    {
      "text": "\n$A>B>C$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{S}_{\\mathrm{N}} 1$ proceeds via carbocation intermediate, the most stable one forming the product faster. Hence reactivity order for $\\mathrm{A}, \\mathrm{B}, \\mathrm{C}$ depends on stability of carbocation created.\n<img src=\"assets\\st0164_6c77bea3ac42.png\"><br>"
  }
}