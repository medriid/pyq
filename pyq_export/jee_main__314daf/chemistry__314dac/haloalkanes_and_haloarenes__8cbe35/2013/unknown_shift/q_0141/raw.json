  "question": {
    "text": "The order of reactivity of the given haloalkanes towards nucleophile is :",
    "image": null
  },
  "options": [
    {
      "id": "6Z6QM",
      "text": "\n$\\mathrm{RI}>\\mathrm{RBr}>\\mathrm{RCl}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8qn7X",
      "text": "\n$\\mathrm{RCl}>\\mathrm{RBr}>\\mathrm{RI}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UUpOk",
      "text": "\n$\\mathrm{RBr}>\\mathrm{RCl}>\\mathrm{RI}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gujck",
      "text": "\n$\\mathrm{RBr}>\\mathrm{RI}>\\mathrm{RCl}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For a given alkyl group, the order of reactivity is\n$\\frac{\\mathrm{R}-\\mathrm{I}>\\mathrm{R}-\\mathrm{Br}>\\mathrm{R}-\\mathrm{Cl}>\\mathrm{R}-\\mathrm{F}}{\\text { increasing bond energy }}$\ndecreasing halogen reactivity.\nThis order depends on the carbon-halogen bond energy; the carbon-fluorine bond energy is maximum and thus fluorides are least reactive while carbon-iodine bond energy is minimum hence iodides are most reactive.",
    "image": null
  },
