  "question": {
    "text": "The increasing order of the reactivity of the following halides for the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">N</mi></msub><mn>1</mn></math> reaction is<br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/EM0178360.jpg\" style=\"width: 422px; height: 87px;\" />",
    "image": null
  },
