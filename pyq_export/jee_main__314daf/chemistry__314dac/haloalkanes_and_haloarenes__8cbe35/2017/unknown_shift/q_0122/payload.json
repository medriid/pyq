    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>III</mi><mo>)</mo><mo>&#60;</mo><mo>(</mo><mi>II</mi><mo>)</mo><mo>&#60;</mo><mo>(</mo><mi mathvariant=\"normal\">I</mi><mo>)</mo></math>",
