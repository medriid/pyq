  "question": {
    "text": "The increasing order of the reactivity of the following halides for the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">N</mi></msub><mn>1</mn></math> reaction is<br /><br /><img alt=\"\" src=\"assets\\qt0122_3e72b60df878.jpg\" style=\"width: 422px; height: 87px;\" />"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>II</mi><mo>)</mo><mo>&#60;</mo><mo>(</mo><mi mathvariant=\"normal\">I</mi><mo>)</mo><mo>&#60;</mo><mo>(</mo><mi>III</mi><mo>)</mo></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">I</mi><mo>)</mo><mo>&#60;</mo><mo>(</mo><mi>III</mi><mo>)</mo><mo>&#60;</mo><mo>(</mo><mi>II</mi><mo>)</mo></math>",
