  "question": {
    "text": "Which of the following reactions will yield $2, 2-$dibromopropane?",
    "image": null
  },
  "options": [
    {
      "id": "YPBwV",
      "text": "\n$\\mathrm{CH}_3-\\mathrm{C} \\equiv \\mathrm{CH}+2 \\mathrm{HBr} \\longrightarrow$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "OWYKX",
      "text": "\n$\\mathrm{CH}_3 \\mathrm{CH} \\equiv \\mathrm{CHBr}+\\mathrm{HBr} \\longrightarrow$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4TkeT",
      "text": "\n$\\mathrm{CH} \\equiv \\mathrm{CH}+2 \\mathrm{HBr} \\longrightarrow$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "C1Sws",
      "text": "\n$\\mathrm{CH}_3-\\mathrm{CH}=\\mathrm{CH}_2+\\mathrm{HBr} \\longrightarrow$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
