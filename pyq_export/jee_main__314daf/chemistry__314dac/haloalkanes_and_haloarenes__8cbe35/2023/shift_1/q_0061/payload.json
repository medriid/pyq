  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List I</strong></td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List II</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td><img src=\"assets\\qt0061_3727122f4364.png\" style=\"width: 300px; height: 140px;\" /></td>\t\t\t<td>I</td>\t\t\t<td>Fittig reaction</td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td><img src=\"assets\\qt0061_51e0a578f5a9.png\" style=\"width: 300px; height: 117px;\" /></td>\t\t\t<td>II</td>\t\t\t<td>Wurtz Fittig reaction</td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td><img src=\"assets\\qt0061_aa1da9737c4d.png\" style=\"width: 300px; height: 144px;\" /></td>\t\t\t<td>III</td>\t\t\t<td>Finkelstein reaction</td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mi>Cl</mi><mo>+</mo><mi>NaI</mi><mo>&#8594;</mo><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mi mathvariant=\"normal\">I</mi><mo>+</mo><mi>Nacl</mi></math></td>\t\t\t<td>IV</td>\t\t\t<td>Sandmeyer reaction</td>\t\t</tr>\t</tbody></table><p>&nbsp;</p>"
