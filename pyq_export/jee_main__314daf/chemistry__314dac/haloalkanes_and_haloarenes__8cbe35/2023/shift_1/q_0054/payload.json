    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>-</mo><mi>Br</mi><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo><mo>;</mo><mi mathvariant=\"normal\">B</mi><mo>-</mo><msub><mi mathvariant=\"normal\">I</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi>Br</mi><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo><mo>;</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><mi>Br</mi><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>-</mo><msub><mi>Br</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">B</mi><mo>-</mo><msub><mi mathvariant=\"normal\">I</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><msub><mi>Br</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">b</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><msub><mi>Br</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>-</mo><msub><mi>Br</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">B</mi><mo>-</mo><msub><mi mathvariant=\"normal\">I</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><msub><mi>Br</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub><mo>;</mo><mi mathvariant=\"normal\">D</mi><mo>-</mo><msub><mi>Br</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">a</mi><mo>)</mo></mrow></msub></math>",
