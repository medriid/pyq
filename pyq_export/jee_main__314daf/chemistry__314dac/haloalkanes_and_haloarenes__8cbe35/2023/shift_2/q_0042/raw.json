  "question": {
    "text": "<p>The correct order of reactivity of following haloarenes towards nucleophilic substitution with aqueous <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaOH</mi></math> is:<br /><br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9e2fe680-bb85-44b6-ac50-22c72a68df3d.png\" style=\"width: 662px; height: 166px;\" /></p><p>Choose the correct answer from the options given below:</p>",
    "image": null
  },
  "options": [
    {
