  "level": 1,
  "question": {
    "text": "<p>Decreasing order towards <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">N</mi></msub><mn>1</mn></math> reaction for the following compounds is:</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/28897d63-6e27-4d6d-a6c2-2de9fa2e91c5-9895989.png\" style=\"width: 500px; height: 263px;\" />&nbsp;</p>",
    "image": null
  },
  "options": [
    {
      "id": "tQ0ew",
      "text": "a &gt; c &gt; d &gt; b",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "miAAl",
      "text": "a &gt; b &gt; c &gt; d",
      "isCorrect": false,
      "image": null
