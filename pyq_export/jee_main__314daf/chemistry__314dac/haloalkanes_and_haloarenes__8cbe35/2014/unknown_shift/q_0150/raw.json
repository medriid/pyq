  "question": {
    "text": "The correct statement for the molecule <math> <mrow> <msub> <mtext>CsI</mtext> <mn>3</mn> </msub> </mrow> </math>, is :",
    "image": null
  },
  "options": [
    {
      "id": "d6rdb",
      "text": "It is a covalent molecule.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rKwSz",
      "text": "It contains <math> <mrow> <msup> <mtext>Cs</mtext> <mo>+</mo> </msup> </mrow> </math> and <math> <mrow> <msubsup> <mtext>I</mtext> <mn>3</mn> <mo>-</mo> </msubsup> </mrow> </math> ions.",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "coeA0",
      "text": "It contains <math> <mrow> <msup> <mtext>Cs</mtext> <mrow> <mn>3</mn> <mo>+</mo> </mrow> </msup> </mrow> </math> and <math> <mrow> <msup> <mtext>I</mtext> <mrow> <mo>-</mo> </mrow> </msup> </mrow> </math> ions.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pNN4S",
      "text": "It contains <math> <mrow> <msup> <mtext>Cs</mtext> <mo>+</mo> </msup> <msup> <mo>, I</mo> <mo>-</mo> </msup> </mrow> </math> and lattice <math> <mrow> <msub> <mtext>I</mtext> <mn>2</mn> </msub> </mrow> </math> molecule.",
      "image": null,
