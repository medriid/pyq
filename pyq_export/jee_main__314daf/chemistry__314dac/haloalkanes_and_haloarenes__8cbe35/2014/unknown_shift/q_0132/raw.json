  "question": {
    "text": "The major product obtained in the photo catalysed bromination of 2-methylbutane is:",
    "image": null
  },
  "options": [
    {
      "id": "8ztlh",
      "text": "\n1-bromo-2-methylbutane\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0YaGc",
      "text": "\n1-bromo-3-methylbutane\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RwFlk",
      "text": "\n2-bromo-3-methylbutane\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "te8Wi",
      "text": "\n2-bromo-2-methylbutane",
      "image": null,
      "isCorrect": true
    }
