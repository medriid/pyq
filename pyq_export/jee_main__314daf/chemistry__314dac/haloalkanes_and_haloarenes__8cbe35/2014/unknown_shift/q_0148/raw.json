      "text": "C<sub>6</sub>H<sub>5</sub>&nbsp;-&nbsp;CH&nbsp;=&nbsp;CH&nbsp;- Br +&nbsp;CH<sub>3</sub>&nbsp;-&nbsp;ONa",
      "image": null,
      "isCorrect": false
