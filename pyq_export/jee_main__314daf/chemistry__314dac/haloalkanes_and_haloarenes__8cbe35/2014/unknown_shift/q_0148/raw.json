    {
      "id": "bplQ8",
      "text": "CH<sub>2</sub> = CH - Br + C<sub>6</sub>H<sub>5</sub> - CH<sub>2</sub>&nbsp;- ONa",
      "image": null,
      "isCorrect": false
    },
    {
