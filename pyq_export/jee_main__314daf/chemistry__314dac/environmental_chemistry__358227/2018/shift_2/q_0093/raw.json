  "question": {
    "text": "Biochemical oxygen demand(BOD) value can be a measure of water pollution caused by the organic matter. Which of the following statements is correct?",
    "image": null
  },
  "options": [
    {
      "id": "OqbcS",
      "text": "\nPolluted water has BOD value higher than $10 \\mathrm{ppm}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "l8c47",
      "text": "\nAerobic bacteria decreases the BOD value\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Dc2E2",
      "text": "\nAnaerobic bacteria increases the BOD value\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8mLG2",
      "text": "\nClean water has BOD value higher than 10 ppm",
      "image": null,
      "isCorrect": false
