  "question": {
    "text": "Which one of the following substances used in dry cleaning is a better strategy to control environmental pollution?",
    "image": null
  },
  "options": [
    {
      "id": "xanAJ",
      "text": "Sulphur dioxide",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BFhka",
      "text": "Carbon dioxide",
      "image": null,
      "isCorrect": true
