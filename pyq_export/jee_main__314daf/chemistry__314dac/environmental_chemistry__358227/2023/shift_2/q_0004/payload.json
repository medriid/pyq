    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi>Cl</mi><mn>2</mn></msub><mo>&#160;</mo><msub><mi mathvariant=\"normal\">F</mi><mn>2</mn></msub></math>",
