  "question": {
    "text": "How do we differentiate between $\\mathrm{Fe}^{3+}$ and $\\mathrm{Cr}^{3+}$ in group III?",
    "image": null
  },
  "options": [
    {
      "id": "epC24",
      "text": "\nby taking excess of $\\mathrm{NH}_4 \\mathrm{OH}$ solution\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HRDJy",
      "text": "\nby increasing $\\mathrm{NH}_4{ }^{+}$ion concentration\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KrcW2",
      "text": "\nby decreasing $\\mathrm{OH}^{-}$ion concentration\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ic3gB",
      "text": "\nboth (b) and (c)",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{NH}_4^{+}$ions are increased to suppress release of $\\mathrm{OH}$ ions, hence solubility product of $\\mathrm{Fe}(\\mathrm{OH})_3$ is attained. Colour of precipitate is different.",
    "image": null
  },
