  "question": {
    "text": "10 mL of 2 M NaOH solution is added to 20 mL of 1 M HCl solution kept in a beaker. Now, 10 mL of this mixture is poured into a volumetric flask of 100 mL containing 2 moles of HCl and made the volume upto the mark with distilled water. The solution in this flask is :",
    "image": null
  },
  "options": [
    {
      "id": "Jt3mF",
      "text": "0.2 M NaCl solution",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VKYVY",
      "text": "20 M HCl solution",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UfoyQ",
      "text": "10 M HCl solution",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nLiBq",
      "text": "Neutral solution",
      "image": null,
      "isCorrect": false
    }
