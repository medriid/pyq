  "question": {
    "text": "$\\mathrm{K}_{\\text {sp }}$ for $\\mathrm{Cr}(\\mathrm{OH})_3$ is $1.6 \\times 10^{-30}$. What is the molar solubility of this salt in water?",
    "image": null
  },
  "options": [
    {
      "id": "Syo44",
      "text": "$\\frac{1.8 \\times 10^{-30}}{27}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "M85zY",
