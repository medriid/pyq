  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{Cr}(\\mathrm{OH})_3 \\rightleftharpoons \\underset{ \\mathrm{s}}{\\mathrm{Cr}^{3+}}(\\mathrm{aq})+\\underset{3 \\mathrm{~s}}{3 \\mathrm{OH}^{-}(\\mathrm{aq})} \\\\ & \\mathrm{K}_{\\mathrm{sp}}=\\mathrm{s}(3 \\mathrm{~s})^3 \\\\ & 1.6 \\times 10^{-30}=27 \\mathrm{~s}^4 \\\\ & \\sqrt[4]{\\frac{1.6 \\times 10^{-30}}{27}}=\\mathrm{s}\\end{aligned}$",
    "image": null
  },
