  "question": {
    "text": "A weak acid HA has degree of dissociation x . Which option gives the correct expression of ( pH $\\mathrm{pK}_{\\mathrm{a}}$ )?",
    "image": null
  },
  "options": [
    {
      "id": "7mF5R",
      "text": "0",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7pCrc",
      "text": "$\\log (1+2 \\mathrm{x})$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "78M8x",
      "text": "$\\log \\left(\\frac{1-x}{x}\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "r6HGD",
      "text": "$\\log \\left(\\frac{x}{1-x}\\right)$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/IOmiv6lP-eMI3GnjAsX4Bym_dzng1gDv5fWJbtB-gKA.original.fullsize.png\"><br>\n$\\begin{aligned} & \\mathrm{K}_{\\mathrm{a}}=\\frac{\\left[\\mathrm{H}^{+}\\right](\\mathrm{x})}{\\mathrm{C}(1-\\mathrm{x})} \\\\ & {\\left[\\mathrm{H}^{+}\\right]=\\mathrm{K}_{\\mathrm{a}} \\frac{(1-\\mathrm{x})}{\\mathrm{x}}} \\\\ & \\log \\mathrm{H}^{+}=\\log \\mathrm{K}_{\\mathrm{a}}+\\log \\left(\\frac{1-\\mathrm{x}}{\\mathrm{x}}\\right) \\\\ & -\\log \\mathrm{H}^{+}=-\\log \\mathrm{K}_{\\mathrm{a}}-\\log \\frac{1-\\mathrm{x}}{\\mathrm{x}} \\\\ & \\mathrm{pH}=\\mathrm{pK}_{\\mathrm{a}}-\\log \\frac{1-\\mathrm{x}}{\\mathrm{x}} \\\\ & \\mathrm{pH}-\\mathrm{pK}_{\\mathrm{a}}=\\log \\frac{\\mathrm{x}}{1-\\mathrm{x}}\\end{aligned}$",
    "image": null
  },
