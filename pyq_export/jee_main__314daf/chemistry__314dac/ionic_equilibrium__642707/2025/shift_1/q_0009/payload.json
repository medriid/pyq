  "question": {
    "text": "A weak acid HA has degree of dissociation x . Which option gives the correct expression of ( pH $\\mathrm{pK}_{\\mathrm{a}}$ )?"
  },
  "options": [
    {
      "text": "0",
      "is_correct": false
    },
    {
      "text": "$\\log (1+2 \\mathrm{x})$",
      "is_correct": false
    },
    {
      "text": "$\\log \\left(\\frac{1-x}{x}\\right)$",
      "is_correct": false
    },
    {
      "text": "$\\log \\left(\\frac{x}{1-x}\\right)$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0009_83bf7f0e1f5b.png\"><br>\n$\\begin{aligned} & \\mathrm{K}_{\\mathrm{a}}=\\frac{\\left[\\mathrm{H}^{+}\\right](\\mathrm{x})}{\\mathrm{C}(1-\\mathrm{x})} \\\\ & {\\left[\\mathrm{H}^{+}\\right]=\\mathrm{K}_{\\mathrm{a}} \\frac{(1-\\mathrm{x})}{\\mathrm{x}}} \\\\ & \\log \\mathrm{H}^{+}=\\log \\mathrm{K}_{\\mathrm{a}}+\\log \\left(\\frac{1-\\mathrm{x}}{\\mathrm{x}}\\right) \\\\ & -\\log \\mathrm{H}^{+}=-\\log \\mathrm{K}_{\\mathrm{a}}-\\log \\frac{1-\\mathrm{x}}{\\mathrm{x}} \\\\ & \\mathrm{pH}=\\mathrm{pK}_{\\mathrm{a}}-\\log \\frac{1-\\mathrm{x}}{\\mathrm{x}} \\\\ & \\mathrm{pH}-\\mathrm{pK}_{\\mathrm{a}}=\\log \\frac{\\mathrm{x}}{1-\\mathrm{x}}\\end{aligned}$"
  }
}