  "question": {
    "text": "$\\mathrm{K}_{\\text {sp }}$ for $\\mathrm{Cr}(\\mathrm{OH})_3$ is $1.6 \\times 10^{-30}$. What is the molar solubility of this salt in water?"
  },
  "options": [
    {
      "text": "$\\frac{1.8 \\times 10^{-30}}{27}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt[5]{1.8 \\times 10^{-30}}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt[4]{\\frac{1.6 \\times 10^{-30}}{27}}$",
      "is_correct": true
    },
    {
      "text": "$\\sqrt[2]{1.6 \\times 10^{-30}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{Cr}(\\mathrm{OH})_3 \\rightleftharpoons \\underset{ \\mathrm{s}}{\\mathrm{Cr}^{3+}}(\\mathrm{aq})+\\underset{3 \\mathrm{~s}}{3 \\mathrm{OH}^{-}(\\mathrm{aq})} \\\\ & \\mathrm{K}_{\\mathrm{sp}}=\\mathrm{s}(3 \\mathrm{~s})^3 \\\\ & 1.6 \\times 10^{-30}=27 \\mathrm{~s}^4 \\\\ & \\sqrt[4]{\\frac{1.6 \\times 10^{-30}}{27}}=\\mathrm{s}\\end{aligned}$"
  }
