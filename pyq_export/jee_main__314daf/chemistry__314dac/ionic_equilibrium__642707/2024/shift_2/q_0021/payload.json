  "question": {
    "text": "For a sparingly soluble salt \\(\\mathrm{AB}_2\\), the equilibrium concentrations of \\(\\mathrm{A}^{2+}\\) ions and \\(B^{-}\\)ions are \\(1.2 \\times 10^{-4} \\mathrm{M}\\) and \\(0.24 \\times 10^{-3} \\mathrm{M}\\), respectively. The solubility product of \\(\\mathrm{AB}_2\\) is :"
  },
  "options": [
    {
      "text": "\\(6.91 \\times 10^{-12}\\)",
      "is_correct": true
    },
    {
      "text": "\\(0.276 \\times 10^{-12}\\)",
      "is_correct": false
    },
    {
      "text": "\\(27.65 \\times 10^{-12}\\)",
      "is_correct": false
    },
    {
      "text": "\\(0.069 \\times 10^{-12}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{AB}_{2(\\mathrm{~s})} \\rightleftharpoons \\mathrm{A}_{(\\mathrm{aq})}^{+2}+2 \\mathrm{~B}_{(\\mathrm{aq})}^{-} \\\\ & \\mathrm{K}_{\\mathrm{sp}}=\\left[\\mathrm{A}^{+2}\\right]\\left[\\mathrm{B}^{-}\\right]^2 \\\\ &=1.2 \\times 10^{-4} \\times\\left(2.4 \\times 10^{-4}\\right)^2 \\\\ &=6.91 \\times 10^{-12} \\mathrm{M}^3\\end{aligned}$"
  }
}