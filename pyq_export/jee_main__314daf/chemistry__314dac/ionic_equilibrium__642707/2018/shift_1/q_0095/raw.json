  "question": {
    "text": "The minimum volume of water required to dissolve $0.1 \\mathrm{~g}$ lead (II) chloride to get a saturated solution $\\left(K_{\\mathrm{SP}}\\right.$ of $\\mathrm{PbCl}_2=3.2 \\times 10^{-8}$; atomic mass of $\\mathrm{Pb}=207 \\mathrm{~u})$ is :",
    "image": null
  },
  "options": [
    {
      "id": "2LXrr",
      "text": "\n$1.798 \\mathrm{~L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rMGg9",
      "text": "\n$0.36 \\mathrm{~L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8e7Od",
      "text": "\n$17.95 \\mathrm{~L}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0xXXf",
      "text": "\n$0.18 \\mathrm{~L}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\left(\\mathrm{K}_{\\mathrm{sp}}\\right)_{\\mathrm{PbCl}_2}=3.2 \\times 10^{-8}=32 \\times 10^{-9}$\n$\\mathrm{PbCl}_2 \\rightleftharpoons\\underset{\\mathrm{s}}{\\mathrm{Pb}^{2+}}+\\underset{2 \\mathrm{s}}{2 \\mathrm{Cl}^{-}}$\n$\\mathrm{K}_{\\mathrm{sp}}=\\left[\\mathrm{Pb}^{2+}\\right]\\left[\\mathrm{Cl}^{-}\\right]^2$\n$\\mathrm{~K}_{\\mathrm{sp}}=4 \\mathrm{s}^3=32 \\times 10^{-9}$\n$\\mathrm{~s}^3=8 \\times 10^{-9}$\n$\\mathrm{~s}=2 \\times 10^{-3} \\mathrm{M}$\n$\\frac{\\mathrm{w}}{\\mathrm{M} . \\mathrm{W}.} \\times \\frac{1}{\\mathrm{~V}_{\\mathrm{L}}}=2 \\times 10^{-3}$\n$\\frac{0.1}{278} \\times \\frac{1}{\\mathrm{~V}_{\\mathrm{L}}}=2 \\times 10^{-3}$\n$\\mathrm{~V}_{\\mathrm{L}}=\\frac{0.1 \\times 1000}{278 \\times 2}=0.18 \\mathrm{~L}$",
    "image": null
  },
