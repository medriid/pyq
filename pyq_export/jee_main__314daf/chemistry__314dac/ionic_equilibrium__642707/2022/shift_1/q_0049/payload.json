  "question": {
    "text": "The solubility of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AgCl</mi></math> will be maximum in which of the following?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>01</mn><mo>&#160;</mo><mi mathvariant=\"normal\">M</mi><mo>&#160;</mo><mi>HCl</mi></math>",
