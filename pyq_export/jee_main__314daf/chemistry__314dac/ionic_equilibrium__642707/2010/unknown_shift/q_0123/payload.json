  "question": {
    "text": "At $25^{\\circ} \\mathrm{C}$, the solubility product of $\\mathrm{Mg}(\\mathrm{OH})_2$ is $1.0 \\times 10^{-11}$. At which $\\mathrm{pH}$, will $\\mathrm{Mg}^{2+}$ ions start precipitating in the form of $\\mathrm{Mg}(\\mathrm{OH})_2$ from a solution of $0.001 \\mathrm{M} \\mathrm{Mg}^{2+}$ ions ?"
  },
  "options": [
    {
      "text": "\n9\n",
      "is_correct": false
    },
    {
      "text": "\n10\n",
      "is_correct": true
    },
    {
      "text": "\n11\n",
      "is_correct": false
    },
    {
      "text": "\n8",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{Mg}^{2+}+2 \\mathrm{OH}^{-} \\rightleftharpoons \\mathrm{Mg}(\\mathrm{OH})_2$\n$\\mathrm{~K}_{\\mathrm{sp}}=\\left[\\mathrm{Mg}^{2+}\\right]\\left[\\mathrm{OH}^{-}\\right]^2$\n$\\left[\\mathrm{OH}^{-}\\right]=\\sqrt{\\frac{\\mathrm{K}_{\\mathrm{sp}}}{\\left[\\mathrm{Mg}^{2+}\\right]}}=10^{-4}$\n$\\therefore \\mathrm{p}^{\\mathrm{OH}}=4$ and $\\mathrm{p}^{\\mathrm{H}}=10$"
  }
}