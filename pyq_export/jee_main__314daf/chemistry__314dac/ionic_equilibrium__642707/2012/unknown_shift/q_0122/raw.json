  "question": {
    "text": "The pH of a $0.1$ molar solution of the acid $\\mathrm{HQ}$ is $3$ . The value of the ionization constant, Ka of this acid is :",
    "image": null
  },
  "options": [
    {
      "id": "XKe2n",
      "text": "\n$3 \\times 10^{-1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iGKny",
      "text": "\n$1 \\times 10^{-3}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5ClW6",
      "text": "\n$1 \\times 10^{-5}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1efqq",
      "text": "\n$1 \\times 10^{-7}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\left[\\mathrm{H}^{+}\\right]=\\sqrt{\\mathrm{K}_{\\mathrm{a}} \\cdot \\mathrm{C}} \\Rightarrow 10^{-3}=\\sqrt{\\mathrm{K}_{\\mathrm{a}} \\cdot 10^{-1}}$\n$\\Rightarrow \\mathrm{K}_{\\mathrm{a}}=10^{-5}$",
    "image": null
  },
