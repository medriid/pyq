  "question": {
    "text": "The solubility of $\\mathrm{PbI}_2$ at $25^{\\circ} \\mathrm{C}$ is $0.7 \\mathrm{~g} \\mathrm{~L}^{-1}$. The solubility product of $\\mathrm{PbI}_2$ at this temperature is (molar mass of $\\mathrm{PbI}_2=461.2 \\mathrm{~g} \\mathrm{~mol}^{-1}$ )"
  },
  "options": [
    {
      "text": "\n$1.40 \\times 10^{-9}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.14 \\times 10^{-9}$\n",
      "is_correct": false
    },
    {
      "text": "\n$140 \\times 10^{-9}$\n",
      "is_correct": false
    },
    {
      "text": "\n$14.0 \\times 10^{-9}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{PbI}_2 \\leftrightharpoons \\mathrm{Pb}^{++}+2 \\mathrm{I}^{-}$\n$$\n\\begin{aligned}\nK_{\\text {sp }}= & s \\times(2 s)^2=4 s^3 \\\\\n& =4 \\times\\left(\\frac{0.7}{461.2}\\right)^3=14.0 \\times 10^{-9}\n\\end{aligned}\n$$"
  }
}