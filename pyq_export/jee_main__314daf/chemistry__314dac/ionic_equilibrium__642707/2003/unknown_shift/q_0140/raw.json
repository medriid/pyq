  "question": {
    "text": "The solubility in water of a sparingly soluble salt $\\mathrm{AB}$ is $1.0 \\times 10^{-5} \\mathrm{~mol} \\mathrm{~L}^{-1}$. Its solubility product number will be",
    "image": null
  },
  "options": [
    {
      "id": "eOSbK",
      "text": "\n$4 \\times 10^{-10}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Pdov9",
      "text": "\n$1 \\times 10^{-15}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "m0xPE",
      "text": "\n$1 \\times 10^{-10}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WGqem",
      "text": "\n$4 \\times 10^{-15}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{ll}{[\\mathrm{A}]=1.0 \\times 10^{-5},} & {[\\mathrm{~B}]=\\left[1.0 \\times 10^{-5}\\right]} \\\\ \\mathrm{K}_{\\mathrm{sp}}=[2 . \\mathrm{B}]^2[\\mathrm{~A}] \\quad=\\left[2 \\times 10^{-5}\\right]^2\\left[1.0 \\times 10^{-5}\\right]=4 \\times 10^{-15}\\end{array}$",
    "image": null
  },
