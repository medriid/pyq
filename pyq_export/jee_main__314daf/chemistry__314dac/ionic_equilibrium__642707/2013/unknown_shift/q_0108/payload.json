  "question": {
    "text": "What is the $\\mathrm{pH}$ of a $10^{-4} \\mathrm{M} \\mathrm{OH}^{-}$solution at $330 \\mathrm{~K}$, if $\\mathrm{K}_{\\mathrm{w}}$ at $330 \\mathrm{~K}$ is $10^{-13.6}$ ?"
  },
  "options": [
    {
      "text": "\n4\n",
      "is_correct": false
    },
    {
      "text": "\n$9.0$\n",
      "is_correct": false
    },
    {
      "text": "\n10\n",
      "is_correct": false
    },
    {
      "text": "\n$9.6$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Given at $330 \\mathrm{~K}$\n$$\n\\begin{aligned}\n\\mathrm{K}_w & =10^{-13.6} \\\\\n\\text { i.e. } \\quad \\mathrm{pK}_w & =\\mathrm{pH}+\\mathrm{pOH} \\\\\n\\because \\quad \\mathrm{pOH}^2 & =-\\log \\left[\\mathrm{OH}^{-}\\right] \\\\\n13.6 & =\\mathrm{pH}+\\mathrm{pOH} \\\\\n\\mathrm{pOH} & =-\\log 10^{-4} \\\\\n13.6 & =\\mathrm{pH}+4 \\\\\n\\therefore \\quad \\mathrm{pH} & =13.6-4 \\\\\n& =9.6\n\\end{aligned}\n$$"
  }
}