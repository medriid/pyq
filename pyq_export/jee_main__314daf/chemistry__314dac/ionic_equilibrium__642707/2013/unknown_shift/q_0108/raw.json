  "question": {
    "text": "What is the $\\mathrm{pH}$ of a $10^{-4} \\mathrm{M} \\mathrm{OH}^{-}$solution at $330 \\mathrm{~K}$, if $\\mathrm{K}_{\\mathrm{w}}$ at $330 \\mathrm{~K}$ is $10^{-13.6}$ ?",
    "image": null
  },
  "options": [
    {
      "id": "MVQ0c",
      "text": "\n4\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gqRNF",
      "text": "\n$9.0$\n",
      "image": null,
      "isCorrect": false
    },
    {
