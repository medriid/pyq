  "question": {
    "text": "$\\mathrm{NaOH}$ is a strong base. What will be $\\mathrm{pH}$ of $5.0 \\times 10^{-2} \\mathrm{M} \\mathrm{NaOH}$ solution ? $(\\log 2=0.3)$",
    "image": null
  },
  "options": [
    {
      "id": "HVhKJ",
      "text": "\n$14.00$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "itdkL",
      "text": "\n$13.70$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uoZsB",
      "text": "\n$13.00$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mlbEE",
      "text": "\n$12.70$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Given $\\left[\\mathrm{OH}^{-}\\right]=5 \\times 10^{-2}$\n$$\n\\begin{aligned}\n& \\therefore \\mathrm{pOH}=-\\log 5 \\times 10^{-2} \\\\\n& \\quad \\quad=-\\log 5+2 \\log 10=1.30 \\\\\n& \\because \\mathrm{pH}+\\mathrm{pOH}=14 \\\\\n& \\because \\mathrm{pH}=14-\\mathrm{pOH} \\\\\n& \\quad=14-1.30=12.70\n\\end{aligned}\n$$",
    "image": null
  },
