  "question": {
    "text": "The entropy of a sample of a certain substance increases by $0.836 \\mathrm{~J} \\mathrm{~K}^{-1}$ on adding reversibly $0.3344 \\mathrm{~J}$ of heat at constant temperature. The temperature of the sample is:"
  },
  "options": [
    {
      "text": "\n$2.5 \\mathrm{~K}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.3 \\mathrm{~K}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.016 \\mathrm{~K}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.4 \\mathrm{~K}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\Delta S=\\frac{\\Delta H}{T} ; T=\\frac{\\Delta H}{\\Delta S}=\\frac{0.3344}{0.836}=0.4 \\mathrm{~K}$"
  }
}