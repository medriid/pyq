  "question": {
    "text": "One mole of an ideal gas is expanded isothermally and reversibly to half of its initial pressure. $\\Delta S$ for the process in $\\mathrm{J} \\mathrm{K}^{-1} \\mathrm{~mol}^{-1}$ is\n$[\\ln 2=0.693$ and $R=8.314, \\mathrm{~J} /(\\mathrm{mol} \\mathrm{K})]$"
  },
  "options": [
    {
      "text": "\n$6.76$\n",
      "is_correct": false
    },
    {
      "text": "\n$5.76$\n",
      "is_correct": true
    },
    {
      "text": "\n$10.76$\n",
      "is_correct": false
    },
    {
      "text": "\n$8.03$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "For isothermal process $(\\Delta T=0)$\n$$\n\\begin{aligned}\n\\Delta S & =R \\ell \\mathrm{n} \\frac{P_1}{P_2}=8.314 \\ell \\mathrm{n} 2 \\\\\n& =8.314 \\times 0.693=5.76 \\mathrm{JK}^{-1} \\mathrm{~mol}^{-1}\n\\end{aligned}\n$$"
  }
}