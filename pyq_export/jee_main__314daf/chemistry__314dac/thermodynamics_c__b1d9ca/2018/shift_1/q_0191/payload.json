  "question": {
    "text": "For which of the following reactions, $\\Delta \\mathrm{H}$ is equal to $\\Delta \\mathrm{U}$ ?"
  },
  "options": [
    {
      "text": "\n$\\mathrm{N}_2(\\mathrm{g})+3 \\mathrm{H}_2(\\mathrm{g}) \\rightarrow 2 \\mathrm{NH}_3(\\mathrm{g})$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\mathrm{HI}(\\mathrm{g}) \\rightarrow \\mathrm{H}_2(\\mathrm{g})+\\mathrm{I}_2(\\mathrm{g})$\n",
      "is_correct": true
    },
    {
      "text": "\n$2 \\mathrm{SO}_2$ (g) $+\\mathrm{O}_2(\\mathrm{g}) \\rightarrow 2 \\mathrm{SO}_3(\\mathrm{g})$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\mathrm{NO}_2(\\mathrm{g}) \\rightarrow \\mathrm{N}_2 \\mathrm{O}_4(\\mathrm{g})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\Delta \\mathrm{H}=\\Delta \\mathrm{U}+\\Delta \\mathrm{n}_{\\mathrm{g}} \\mathrm{RT}$\n$\\begin{aligned}\n&2 \\mathrm{HI}(\\mathrm{g}) \\rightarrow \\mathrm{H}_2(\\mathrm{g})+\\mathrm{I}_2(\\mathrm{g}) ; \\Delta \\mathrm{n}_{\\mathrm{g}}=(1+1)-2=0 \\\\\n&\\therefore \\Delta \\mathrm{H}=\\Delta \\mathrm{U}+0\n\\end{aligned}$"
  }
