    "text": "Let assume initial moles is 1<br /><math><msub><mrow><mi>&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;A</mi></mrow><mrow><mn>2</mn></mrow></msub><mover accent=\"false\"><mo>&#8594;</mo><mrow><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi></mrow></mover><mi>&#160;</mi><mn>2</mn><mi>A</mi></math><br />t=0&nbsp; &nbsp; &nbsp; &nbsp;1<br />t=t&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<math><mn>1</mn><mo>-0</mo><mo>.</mo><mn>2</mn><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;0</mi><mo>.</mo><mn>2</mn><mo>&#215;</mo><mn>2</mn></math><br /><br /><math><mi>P</mi><mi>a</mi><mi>r</mi><mi>t</mi><mi>i</mi><mi>a</mi><mi>l</mi><mi>&#160;</mi><mi>p</mi><mi>r</mi><mi>e</mi><mi>s</mi><mi>s</mi><mi>u</mi><mi>r</mi><mi>e</mi><mi>&#160;</mi><mi>o</mi><mi>f</mi><mi>&#160;</mi><msub><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mo>0.</mo><mn>8</mn></mrow><mrow><mn>1.2</mn></mrow></mfrac><mo>&#215;</mo><mn>1</mn><mi>&#160;</mi></math><br /><math><mi>P</mi><mi>a</mi><mi>r</mi><mi>t</mi><mi>i</mi><mi>a</mi><mi>l</mi><mi>&#160;</mi><mi>p</mi><mi>r</mi><mi>e</mi><mi>s</mi><mi>s</mi><mi>u</mi><mi>r</mi><mi>e</mi><mi>&#160;</mi><mi>o</mi><mi>f</mi><mi>&#160;</mi><mi>A</mi><mo>=</mo><mfrac><mrow><mo>0.</mo><mn>4</mn></mrow><mrow><mn>1.2</mn></mrow></mfrac><mo>&#215;</mo><mn>1</mn>