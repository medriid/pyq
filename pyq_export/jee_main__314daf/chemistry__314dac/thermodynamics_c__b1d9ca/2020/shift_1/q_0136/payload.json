    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;&#160;</mo><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mn>323</mn><mi mathvariant=\"normal\">K</mi><mo>&#160;&#160;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>=</mo><mn>373</mn><mi mathvariant=\"normal\">K</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub><mo>=</mo><mn>10</mn><mo>&#160;&#160;</mo><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><mo>=</mo><mn>100</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mfenced><mfrac><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub></mfrac></mfenced><mo>=</mo><mfrac><mrow><mi>&#916;</mi><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mi mathvariant=\"normal\">R</mi></mrow></mfrac><mfenced open=\"[\" close=\"]\"><mrow><mfrac><mn>1</mn><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub></mfrac><mo>-</mo><mfrac><mn>1</mn><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mfenced><mfrac><mn>100</mn><mn>10</mn></mfrac></mfenced><mo>=</mo><mfrac><mrow><mi>&#916;</mi><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mo>&#215;</mo><mn>8</mn><mo>.</mo><mn>314</mn></mrow></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mfrac><mn>1</mn><mn>298</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>373</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mn>10</mn><mo>=</mo><mfrac><mrow><mi>&#916;</mi><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mo>&#215;</mo><mn>8</mn><mo>.</mo><mn>314</mn></mrow></mfrac><mfenced close=\"]\" open=\"[\"><mfrac><mn>75</mn><mrow><mn>298</mn><mo>&#215;</mo><mn>373</mn></mrow></mfrac></mfenced></