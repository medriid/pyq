  "question": {
    "text": "<p>Gibbs energy vs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">T</mi></math> plot for the formation of oxides is given below.</p><p><img src=\"assets\\qt0063_efa53ef0afb1.png\" style=\"width: 450px; height: 392px;\" /></p><p>For the given diagram, the correct statement is-</p>"
  },
  "options": [
    {
      "text": "At <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>600</mn><mo>&#176;</mo><mi mathvariant=\"normal\">C</mi><mo>,</mo><mi>CO</mi></math> cannot reduce&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>FeO</mi></math>",
      "is_correct": false
