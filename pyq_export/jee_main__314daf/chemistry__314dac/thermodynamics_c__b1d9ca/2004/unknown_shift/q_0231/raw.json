  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{ll}\\mathrm{C}+\\mathrm{O}_2 \\longrightarrow \\mathrm{CO}_2 & \\Delta \\mathrm{H}=-393.5 \\mathrm{~kJ} \\\\ 2 \\mathrm{CO}+1 / 2 \\mathrm{O}_2 \\longrightarrow 2 \\mathrm{CO}_2 & \\Delta \\mathrm{H}=-283 \\mathrm{~kJ} \\\\ 2 \\mathrm{C}+\\mathrm{O}_2 \\longrightarrow 2 \\mathrm{CO} & \\Delta \\mathrm{H}=-110 \\mathrm{~kJ}\\end{array}$",
