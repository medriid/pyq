  "question": {
    "text": "An ideal gas expands in volume from $1 \\times 10^{-3} \\mathrm{~m}^3$ to $1 \\times 10^{-2} \\mathrm{~m}^3$ at $300 \\mathrm{~K}$ against a constant pressure of $1 \\times 10^5 \\mathrm{Nm}^{-2}$. The work done is"
  },
  "options": [
    {
      "text": "\n$-900 \\mathrm{~J}$\n",
      "is_correct": true
    },
    {
      "text": "\n$900 \\mathrm{~kJ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2780 \\mathrm{~kJ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-900 \\mathrm{~kJ}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Work done $=-P(\\Delta V)$\n$$\n=-1 \\times 10^5\\left[10^{-2}-10^{-3}\\right]=-900 \\mathrm{~J}\n$$"
  }
