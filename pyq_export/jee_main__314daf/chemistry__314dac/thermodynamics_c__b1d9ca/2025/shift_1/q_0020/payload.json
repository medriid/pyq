      "text": "Volume of system increases .",
      "is_correct": false
    },
    {
      "text": "The solid phase (ice) disappears completely.",
      "is_correct": true
    },
    {
      "text": "Liquid phase disappears completely.",
      "is_correct": false
    },
    {
      "text": "The amount of ice decreases.",
      "is_correct": false
    }
