    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & (10 \\mathrm{~L}, 300 \\mathrm{~K}) \\xrightarrow{\\mathrm{n}=1}(20 \\mathrm{~L}, 300 \\mathrm{~K}) \\\\ & -\\mathrm{q}=\\mathrm{w}=-\\mathrm{nRT} \\ln \\frac{\\mathrm{V}_2}{\\mathrm{~V}_1} \\\\ & =-8.3 \\times 300 \\times \\ln \\left(\\frac{20}{10}\\right) \\\\ & =-1.718 \\mathrm{~kJ} \\\\ & \\Rightarrow \\mathrm{q}=1.718 \\mathrm{~kJ} \\\\ & \\mathrm{w}=-1.718 \\mathrm{~kJ} \\\\ & \\Delta \\mathrm{U}=0(\\because \\Delta \\mathrm{~T}=0)\\end{aligned}$",
    "image": null
  },
