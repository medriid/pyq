  "question": {
    "text": "A liquid when kept inside a thermally insulated closed vessel at $25^{\\circ} \\mathrm{C}$ was mechanically stirred from outside. What will be the correct option for the following thermodynamic parameters ?",
    "image": null
  },
  "options": [
    {
      "id": "q2RYC",
      "text": "$\\Delta \\mathrm{U} \\lt 0, \\mathrm{q}=0, \\mathrm{w}\\gt0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kyN1R",
      "text": "$\\Delta \\mathrm{U}=0, \\mathrm{q}=0, \\mathrm{w}=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9iHxX",
      "text": "$\\Delta \\mathrm{U}\\gt0, \\mathrm{q}=0, \\mathrm{w}\\gt0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jRtsh",
      "text": "$\\Delta \\mathrm{U}=0, \\mathrm{q} \\lt 0, \\mathrm{w}\\gt0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Thermally insulated $\\Rightarrow q=0$ from $\\mathrm{I}^{\\text {st }}$ law\n$\\begin{aligned}\n& \\Delta \\mathrm{U}=\\mathrm{q}+\\mathrm{w} \\\\\n& \\Delta \\mathrm{U}=\\mathrm{w} \\\\\n& \\mathrm{w}>0, \\Delta \\mathrm{U}>0\n\\end{aligned}$",
    "image": null
  },
