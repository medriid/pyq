  "question": {
    "text": "The hydration energies of $\\mathrm{K}^{+}$and $\\mathrm{Cl}^{-}$are -x and -y $\\mathrm{kJ} / \\mathrm{mol}$ respectively. If lattice energy of KCl is -z $\\mathrm{kJ} / \\mathrm{mol}$, then the heat of solution of KCl is :"
  },
  "options": [
    {
      "text": "$+x-y-z$",
      "is_correct": false
    },
    {
      "text": "$x+y+z$",
      "is_correct": false
    },
    {
      "text": "$z-(x+y)$",
      "is_correct": true
    },
    {
      "text": "$-\\mathrm{z}-(\\mathrm{x}+\\mathrm{y})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0013_2711b5eba084.png\"/><br />$\\begin{aligned} \\Delta \\mathrm{H}_{\\text {Sol}^{\\mathrm{n}}.} & =\\mathrm{L} \\cdot \\mathrm{E} \\cdot+(\\mathrm{H} \\cdot \\mathrm{E})_{\\mathrm{K}_{(\\mathrm{g})}^{+}}+(\\mathrm{HE})_{\\mathrm{Cl}_{(\\mathrm{g})}^{-1}} \\\\ & =\\mathrm{Z}-\\mathrm{x}-\\mathrm{y} \\\\ & =\\mathrm{z}-(\\mathrm{x}+\\mathrm{y})\\end{aligned}$"
  }
}