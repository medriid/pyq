  "question": {
    "text": "The hydration energies of $\\mathrm{K}^{+}$and $\\mathrm{Cl}^{-}$are -x and -y $\\mathrm{kJ} / \\mathrm{mol}$ respectively. If lattice energy of KCl is -z $\\mathrm{kJ} / \\mathrm{mol}$, then the heat of solution of KCl is :",
    "image": null
  },
  "options": [
    {
      "id": "RP5VC",
      "text": "$+x-y-z$",
      "image": null,
      "isCorrect": false
    },
    {
