  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/fd3zf8Rgsp2W6GIYpuemc624CRLpMNye8Bo96yR7Ir8.original.fullsize.png\"/><br />$\\begin{aligned} \\Delta \\mathrm{H}_{\\text {Sol}^{\\mathrm{n}}.} & =\\mathrm{L} \\cdot \\mathrm{E} \\cdot+(\\mathrm{H} \\cdot \\mathrm{E})_{\\mathrm{K}_{(\\mathrm{g})}^{+}}+(\\mathrm{HE})_{\\mathrm{Cl}_{(\\mathrm{g})}^{-1}} \\\\ & =\\mathrm{Z}-\\mathrm{x}-\\mathrm{y} \\\\ & =\\mathrm{z}-(\\mathrm{x}+\\mathrm{y})\\end{aligned}$",
    "image": null
