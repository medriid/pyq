  "question": {
    "text": "If at $298 \\mathrm{~K}$ the bond energies of $\\mathrm{C}-\\mathrm{H}, \\mathrm{C}-\\mathrm{C}, \\mathrm{C}=\\mathrm{C}$ and $\\mathrm{H}-\\mathrm{H}$ bonds are respectively $414,347,615$ and $435 \\mathrm{~kJ}$ $\\mathrm{mol}^{-1}$, the value of enthalpy change for the reaction $\\mathrm{H}_2 \\mathrm{C}=\\mathrm{CH}_2(\\mathrm{~g})+\\mathrm{H}_2(\\mathrm{~g}) \\rightarrow \\mathrm{H}_3 \\mathrm{C}-\\mathrm{CH}_3(\\mathrm{~g})$ at $298 \\mathrm{~K}$ will be",
    "image": null
  },
  "options": [
    {
      "id": "ti7VT",
      "text": "\n$-250 \\mathrm{~kJ}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YFTKV",
      "text": "\n$+125 \\mathrm{~kJ}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "45Iap",
      "text": "\n$-125 \\mathrm{~kJ}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "coaey",
      "text": "\n$+250 \\mathrm{~kJ}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{CH}_2=\\mathrm{CH}_2(\\mathrm{~g})+\\mathrm{H}_2(\\mathrm{~g}) \\rightarrow \\mathrm{CH}_3-\\mathrm{CH}_3$\n$\\Delta H=1(\\mathrm{C}=\\mathrm{C})+4(\\mathrm{C}-\\mathrm{H})+1(\\mathrm{H}-\\mathrm{H})-1(\\mathrm{C}-\\mathrm{C})-6(\\mathrm{C}-\\mathrm{H})=1(\\mathrm{C}=\\mathrm{C})+1(\\mathrm{H}-\\mathrm{H})-1(\\mathrm{C}-\\mathrm{C})-2(\\mathrm{C}-\\mathrm{H})$\n$=615+435-347-2 \\times 414=1050-1175=-125 \\mathrm{~kJ}$",
    "image": null
  },
