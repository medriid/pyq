  "question": {
    "text": "The internal energy change when a system goes from state $\\mathrm{A}$ to $\\mathrm{B}$ is $40 \\mathrm{~kJ} / \\mathrm{mole}$. If the system goes from $\\mathrm{A}$ to $\\mathrm{B}$ by a reversible path and retums to state $\\mathrm{A}$ by an irreversible path what would be the net change in internalenergy?",
    "image": null
  },
  "options": [
    {
      "id": "OD7gc",
      "text": "\n$>40 \\mathrm{~kJ}$\n",
      "image": null,
      "isCorrect": false
    },
    {
