      "image": null,
      "isCorrect": false
    },
    {
      "id": "8lShB",
      "text": "\nZero\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "SytEJ",
      "text": "\n$40 \\mathrm{~kJ}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For a cyclic process the net change in the internal energy is zero because the change in internal energy does not depend on the path.",
    "image": null
