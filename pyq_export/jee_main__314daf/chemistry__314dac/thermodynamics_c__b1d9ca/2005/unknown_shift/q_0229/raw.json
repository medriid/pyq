  "question": {
    "text": "Consider the reaction: $\\mathrm{N}_2+3 \\mathrm{H}_2 \\longrightarrow 2 \\mathrm{NH}_3$ carried out at constant temperature and pressure. If $\\Delta \\mathrm{H}$ and $\\Delta \\mathrm{U}$ are the enthalpy and internal energy changes for the reaction, which of the following expressions is true?",
    "image": null
  },
  "options": [
    {
      "id": "S5orZ",
      "text": "\n$\\Delta \\mathrm{H}=0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DN4Xp",
      "text": "\n$\\Delta \\mathrm{H}=\\Delta \\mathrm{U}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Z47ar",
      "text": "\n$\\Delta \\mathrm{H} < \\Delta \\mathrm{U}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "VsWsn",
      "text": "\n$\\Delta \\mathrm{H}>\\Delta \\mathrm{U}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\Delta \\mathrm{H}=\\Delta \\mathrm{U}+\\Delta \\mathrm{nRT} \\\\\n& \\Delta \\mathrm{n}=-2 \\\\\n& \\Delta \\mathrm{H}=\\Delta \\mathrm{U}-2 \\mathrm{RT} \\\\\n& \\Delta \\mathrm{H} < \\Delta \\mathrm{U}\n\\end{aligned}\n$$",
    "image": null
  },
