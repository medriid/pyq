  "question": {
    "text": "Consider an endothermic reaction, $X \\longrightarrow Y$ with the activation energies $E_b$ and $E_f$ for the backward and forward reactions, respectively. In general"
  },
  "options": [
    {
      "text": "\n$\\mathrm{E}_{\\mathrm{b}} < \\mathrm{E}_{\\mathrm{f}}$",
      "is_correct": true
    },
    {
      "text": "\n$E_b>E_f$\n",
      "is_correct": false
    },
    {
      "text": "\n$E_b=E_f$\n",
      "is_correct": false
    },
    {
      "text": "\nThere is no definite relation between $E_b$ and $E_f$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\Delta \\mathrm{H}=\\mathrm{E}_{\\mathrm{f}}-\\mathrm{E}_{\\mathrm{b}}$\nFor $\\Delta H=$ Positive, $E_b < E_f$"
  }
