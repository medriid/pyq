    "text": "<p><math><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">s</mi></mrow></mfenced><mo>&#8652;</mo><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi><mo>(</mo><mi mathvariant=\"script\">l</mi><mo>)</mo></math><br /><br />At melting point of <math><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></math> at (273 K = T)<br /><br />dG = VdP - SdT<br /><br />At constant temperature<br /><br /><math><mi mathvariant=\"normal\">d</mi><mfenced separators=\"|\"><mrow><mo>&#8710;</mo><mi mathvariant=\"normal\">G</mi></mrow></mfenced><mo>=</mo><mo>&#8710;</mo><mi mathvariant=\"normal\">V</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">P</mi></mrow></mfenced><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">M</mi></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#961;</mi></mrow><mrow><mi mathvariant=\"normal\">L</mi></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mi mathvariant=\"normal\">M</mi></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&#961;</mi></mrow><mrow><mi mathvariant=\"normal\">S</mi></mrow></msub></mrow></mfrac></mrow></mfenced><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">P</mi></math><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">&#961;</mi></mrow><mrow><mi mathvariant=\"normal\">L</mi></mrow></msub><mo>=</mo><mi>D</mi><mi>e</mi><mi>n</mi><mi>s</mi><mi>i</mi><mi>t</mi><mi>y</mi><mi>&#160;</mi><mi>o</mi><mi>f</mi><mi>&#160;</mi><mi>L</mi><mi>i</mi><mi>q</mi><mo>.</mo><mi>&#160;</mi><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>O</mi></math><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">&#961;</mi></mrow><mrow><mi mathvariant=\"normal\">S</mi></mrow></msub><mo>