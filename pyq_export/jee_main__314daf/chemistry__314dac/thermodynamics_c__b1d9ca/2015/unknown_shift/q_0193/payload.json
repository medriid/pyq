    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">B</mi><mo>.</mo><mi mathvariant=\"normal\">E</mi><mo>&#160;</mo><mo>(</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi><mo>)</mo></math> bond<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>360</mn><mo>&#160;</mo><mi>kJ</mi><mo>&#160;</mo><msup><mi>mol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>.<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>.</mo><mi mathvariant=\"normal\">E</mi><mo>&#160;</mo><mo>(</mo><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi><mo>)</mo></math> bond<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>90</mn><mo>&#160;</mo><mi>kJ</mi><mo>&#160;</mo><msup><mi>mol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>.<br /><br />In <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">B</mi><mo>.</mo><msub><mi mathvariant=\"normal\">E</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">C</mi></mrow></mfenced></msub><mo>+</mo><mn>6</mn><mo>&#215;</mo><mi mathvariant=\"normal\">B</mi><mo>.</mo><msub><mi mathvariant=\"normal\">E</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">H</mi></mrow></mfenced></msub><mo>=</mo><mn>620</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">J</mi></math>,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi><mo>.</mo><msub><mi mathvariant=\"normal\">E</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">C</mi><mo>-</mo><mi mathvariant=\"normal\">C</mi></mrow></mfenced></msub