    },
    {
      "text": "Isochoric process : <math><mi mathvariant=\"normal\">q</mi><mo>=</mo><mi mathvariant=\"normal\"> </mi><mo>–</mo><mi mathvariant=\"normal\">w</mi></math>",
      "is_correct": false
    },
    {
      "text": "Cyclic process : <math><mi mathvariant=\"normal\">q</mi><mo>=</mo><mi mathvariant=\"normal\"> </mi><mo>–</mo><mi mathvariant=\"normal\">w</mi></math>",
      "is_correct": false
    },
    {
      "text": "Adiabatic process : <math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">w</mi></math>",
