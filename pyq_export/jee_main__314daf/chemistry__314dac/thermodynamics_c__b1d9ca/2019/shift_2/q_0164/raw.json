  "level": 3,
  "question": {
    "text": "The standard reaction Gibbs energy for a chemical reaction at an absolute temperature $\\mathrm{T}$ is given by $\\Delta \\mathrm{G}^{\\circ}=\\mathrm{A}-\\mathrm{BT}$ where A and $B$ are non-zero constants. Which of the following is true about this reaction?",
    "image": null
  },
  "options": [
    {
      "id": "kRIqf",
      "text": "Exothermic if $B  < 0$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ahUn9",
      "text": "Endothermic if $\\mathrm{A}>0$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "ofH5y",
      "text": "Endothermic if $\\mathrm{A}  < 0$ and $\\mathrm{B}>0$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "5QVsp",
      "text": "Exothermic if $\\mathrm{A}>0$ and $\\mathrm{B}  < 0$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta G^{\\circ}=A-B T$\r\n\r\nA and B are non-zero constants\r\n\r\n$\\therefore \\Delta G^{\\circ}=\\Delta H^{\\circ}-T \\Delta S^{\\circ}=A-B T$\r\n\r\n$\\therefore$ Reaction will be endothermic if $\\Delta \\mathrm{G}^{\\circ}>0 .$\r\n\r\nHence, $\\mathrm{A}>0$ and $\\mathrm{B}  < 0$",
    "image": null
  },
