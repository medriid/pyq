  "question": {
    "text": "A system does&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math> of work and at the same time absorbs <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>150</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi></math> of heat. The magnitude of the change in internal energy is&nbsp; ______<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">J</mi></math>. (Nearest integer)"
  },
  "options": [],
  "correct_answer": "50",
  "solution": {
