  "question": {
    "text": "The enthalpy of formation of ethane \\(\\left(\\mathrm{C}_2 \\mathrm{H}_6\\right)\\) from ethylene by addition of hydrogen where the bond-energies of \\(\\mathrm{C}-\\mathrm{H}, \\mathrm{C}-\\mathrm{C}, \\mathrm{C}=\\mathrm{C}, \\mathrm{H}-\\mathrm{H}\\) are \\(414 \\mathrm{~kJ}, 347 \\mathrm{~kJ}, 615 \\mathrm{~kJ}\\) and \\(435 \\mathrm{~kJ}\\) respectively is \\(\\qquad\\) \\(\\mathrm{kJ}\\)",
    "image": null
  },
  "options": [],
  "correctValue": "125",
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{C}_2 \\mathrm{H}_4(\\mathrm{~g})+\\mathrm{H}_2(\\mathrm{~g}) \\rightarrow \\mathrm{C}_2 \\mathrm{H}_6(\\mathrm{~g}) \\\\ & \\Delta \\mathrm{H}=\\mathrm{BE}(\\mathrm{C}=\\mathrm{C})+4 \\mathrm{BE}(\\mathrm{C}-\\mathrm{H})+\\mathrm{BE}(\\mathrm{H}-\\mathrm{H}) \\\\ & -\\mathrm{BE}(\\mathrm{C}-\\mathrm{C})-6 \\mathrm{BE}(\\mathrm{C}-\\mathrm{H}) \\\\ & \\Delta \\mathrm{H}=\\mathrm{BE}(\\mathrm{C}=\\mathrm{C})+\\mathrm{BE}(\\mathrm{H}-\\mathrm{H})-\\mathrm{BE}(\\mathrm{C}-\\mathrm{C}) \\\\ & -2 \\mathrm{BE}(\\mathrm{C}-\\mathrm{H}) \\\\ & =615+435-347-2 \\times 414 \\\\ & =-125 \\mathrm{~kJ}\\end{aligned}$",
    "image": null
  },
