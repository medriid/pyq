  "question": {
    "text": "$(\\Delta \\mathrm{H}-\\Delta \\mathrm{U})$ for the formation of carbon monoxide (CO) from its elements at $298 \\mathrm{~K}$ is $\\left(\\mathrm{R}=8.314 \\mathrm{~J} \\mathrm{~K}^{-1} \\mathrm{~mol}^{-1}\\right)$"
  },
  "options": [
    {
      "text": "\n$-1238.78 \\mathrm{~J} \\mathrm{~mol}^{-1}$\n",
      "is_correct": true
    },
    {
      "text": "\n$1238.78 \\mathrm{~J} \\mathrm{~mol}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-2477.57 \\mathrm{~J} \\mathrm{~mol}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2477.57 \\mathrm{~J} \\mathrm{~mol}^{-1}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
