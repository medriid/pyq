  "question": {
    "text": "An ideal gas is allowed to expand both reversibly and irreversibly in an isolated system. If $T_i$ is the initial temperature and $T_f$ is the final temperature, which of the following statements is correct?",
    "image": null
  },
  "options": [
    {
      "id": "PbQQq",
      "text": "\n$\\left(T_f\\right)_{\\text {irev }}>\\left(T_f\\right)_{\\text {rev }}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iHp3L",
      "text": "\n$T_f>T_i$ for reversible process but $T_f=T_i$ for irreversible process\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4OZqt",
      "text": "\n$\\left(T_{\\mathrm{f}}\\right)_{\\text {rev }}=\\left(T_{\\mathrm{f}}\\right)$ irrev\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lavKz",
      "text": "\n$T_f=T_i$ for both reversible and irreversible processes",
      "image": null,
      "isCorrect": false
    }
