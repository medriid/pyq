  "question": {
    "text": "In Carius method for estimation of halogens, 180 mg of an organic compound produced 143.5 mg of AgCl . The percentage composition of chlorine in the compound is _______ \\%.\n(Given : molar mass in $\\mathrm{g} \\mathrm{mol}^{-1}$ of $\\mathrm{Ag}: 108, \\mathrm{Cl}: 35.5$ )",
    "image": null
  },
  "options": [],
  "correctValue": "20",
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{n}_{\\mathrm{Cl}}=\\mathrm{n}_{\\mathrm{AgCl}}=\\frac{143.5 \\times 10^{-3}}{143.5}=10^{-3} \\\\ & \\% \\mathrm{Cl}=\\frac{10^{-3} \\times 35.5}{180 \\times 10^{-3}} \\times 100=19.72\\end{aligned}$",
    "image": null
  },
