  "question": {
    "text": "Given below are two statements :\n<strong>Statement (I) :</strong><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5zt_vL97q-O18FUvZvKzjne97HzzWwR5SqdmUACVBI8.original.fullsize.png\"/><br/> are isomeric compounds.<strong>Statement (II) :</strong><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/Mz6Fq3bpMwm8HGSm69cbrw38u-9ZYqkubIM3tbOR008.original.fullsize.png\"/><br/> are functional group isomers.",
    "image": null
  },
  "options": [
    {
      "id": "5XPo9",
      "text": "Both <strong> Statement (I)</strong> and<strong> Statement (II)</strong> are false.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "srUot",
      "text": "Both <strong> Statement (I)</strong> and<strong> Statement (II)</strong> are true.",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "MhyKD",
      "text": "<strong> Statement (I)</strong> is false but<strong> Statement (II)</strong> is true.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2qFa9",
      "text": "<strong> Statement (I)</strong> is true but<strong> Statement (II)</strong> is false.",
      "image": null,
      "isCorrect": false
    }
