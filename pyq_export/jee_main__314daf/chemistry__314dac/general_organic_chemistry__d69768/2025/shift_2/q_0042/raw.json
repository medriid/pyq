  "question": {
    "text": "Given below are two statements :\nStatement (I): In partition chromatography, stationary phase is thin film of liquid present in the inert support.\nStatement (II) : In paper chromatography, the material of paper acts as a stationary phase.\nIn the light of the above statements, choose the correct answer from the options given below :",
    "image": null
  },
  "options": [
    {
      "id": "7JDvk",
      "text": "Statement I is true but Statement II is false",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "TrWoN",
      "text": "Statement I is false but Statement II is true",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fXv15",
      "text": "Both Statement I and Statement II are false",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ell1Y",
      "text": "Both Statement I and Statement II are true",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Statement $I$ is true.\nIn partition chromatography, stationary phase is thin liquid film present in the inert support.\nStatement II is false.\nBecause stationary phase in paper chromatography is water.",
    "image": null
  },
