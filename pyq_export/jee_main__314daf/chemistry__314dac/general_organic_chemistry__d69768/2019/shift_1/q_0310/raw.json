  "question": {
    "text": "<p>The increasing order of the <math><mi>p</mi><mi>K</mi><mi>a</mi></math> values of the following compounds is:<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/b2b94b6b-d44e-4d25-aea2-bb844dfc486f-image.png\" style=\"width: 391px; height: 204px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "QJ4oc",
      "text": "<math><mi>B</mi><mo>&lt;</mo><mi>C</mi><mo>&lt;</mo><mi>A</mi><mo>&lt;</mo><mi>D</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "BoFCu",
      "text": "<math><mi>D</mi><mo>&lt;</mo><mi>A</mi><mo>&lt;</mo><mi>C</mi><mo>&lt;</mo><mi>B</mi></math>",
