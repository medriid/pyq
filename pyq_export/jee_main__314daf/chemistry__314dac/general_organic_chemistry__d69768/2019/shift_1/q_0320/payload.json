  "question": {
    "text": "The increasing order of reactivity of the following compounds towards aromatic electrophilic substitution reaction is:<br /><img src=\"assets\\qt0320_9355d3263def.png\" style=\"width: 407px; height: 129px;\" />"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">A</mi><mo>&lt;</mo><mi mathvariant=\"normal\">B</mi><mo>&lt;</mo><mi mathvariant=\"normal\">C</mi><mo>&lt;</mo><mi mathvariant=\"normal\">D</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">B</mi><mo>&lt;</mo><mi mathvariant=\"normal\">C</mi><mo>&lt;</mo><mi mathvariant=\"normal\">A</mi><mo>&lt;</mo><mi mathvariant=\"normal\">D</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">D</mi><mo>&lt;</mo><mi mathvariant=\"normal\">B</mi><mo>&lt;</mo><mi mathvariant=\"normal\">A</mi><mo>&lt;</mo><mi mathvariant=\"normal\">C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">D</mi><mo>&lt;</mo><mi mathvariant=\"normal\">A</mi><mo>&lt;</mo><mi mathvariant=\"normal\">C</mi><mo>&lt;</mo><mi mathvariant=\"normal\">B</mi></math>",
