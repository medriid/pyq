  "question": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IUPAC</mi></math> name of following compound (P) is :<p><img src=\"assets\\qt0127_cf96908dd9e0.png\" style=\"width: 250px; height: 201px;\"/></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>-</mo><mi>Ethyl</mi><mo>-</mo><mn>5</mn><mo>,</mo><mo> </mo><mn>5</mn><mo>-</mo><mi>dimethylcyclohexane</mi></math>",
      "is_correct": false
