    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>-</mo><mi>Ethyl</mi><mo>-</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>-</mo><mi>dimethylcyclohexane</mi></math>",
      "is_correct": true
