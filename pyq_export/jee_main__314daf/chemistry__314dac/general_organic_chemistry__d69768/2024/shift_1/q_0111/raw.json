  "question": {
    "text": "Appearance of blood red colour, on treatment of the sodium fusion extract of an organic compound with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>FeSO</mi><mn>4</mn></msub></math> in presence of concentrated <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub></math> indicates the presence of element/s",
    "image": null
  },
  "options": [
    {
      "id": "kGoCm",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Br</mi></math>",
