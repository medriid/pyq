  "correctValue": null,
  "solution": {
    "text": "Order of basic strength is\n$\\mathrm{N}\\left(\\mathrm{sp}^3\\right.$, localized lone pair $)>\\mathrm{N}\\left(\\mathrm{sp}^2\\right.$, localized lone\npair $)>\\mathrm{N}\\left(\\mathrm{sp}^2\\right.$, delocalized lone pair, aromatic)\n$\\therefore$ Piperidine $>$ Pyridine $>$ Pyrrole",
    "image": null
