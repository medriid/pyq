  "question": {
    "text": "Correct order of basic strength of Pyrrole <img src=\"assets\\qt0049_c15d5628269c.png\"><br>, Pyridine<img src=\"assets\\qt0049_14db99894965.png\"><br>, and Piperidine<img src=\"assets\\qt0049_906ba1a1b0cf.png\"><br> is:"
  },
  "options": [
    {
      "text": "Pyrrole \\( > \\) Piperidine \\( > \\) Pyridine",
      "is_correct": false
    },
    {
      "text": "Pyrrole \\( > \\) Pyridine \\( > \\) Piperidine",
      "is_correct": false
    },
    {
      "text": "Pyridine \\( > \\) Piperidine \\( > \\) Pyrrole",
      "is_correct": false
    },
    {
      "text": "Piperidine \\( > \\) Pyridine \\( > \\) Pyrrole",
      "is_correct": true
