    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><mo>-</mo><mi mathvariant=\"normal\">O</mi><mo>-</mo><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub></math>",
