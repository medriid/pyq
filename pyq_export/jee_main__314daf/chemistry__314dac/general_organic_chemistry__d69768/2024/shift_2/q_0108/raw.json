  "question": {
    "text": "<p>Match List I with List II<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/37941d6f-2764-445f-88b8-73ed903bb395.png\" style=\"width: 550px; height: 285px;\"/><br>Choose the correct answer from the options given below:</p>",
    "image": null
  },
  "options": [
    {
      "id": "iU9sO",
      "text": "A-I, B-II, C-III, D-IV",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TJgFL",
      "text": "A-IV, B-I, C-II, D-III",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rvuIf",
      "text": "A-III, B-IV, C-I, D-II",
      "image": null,
