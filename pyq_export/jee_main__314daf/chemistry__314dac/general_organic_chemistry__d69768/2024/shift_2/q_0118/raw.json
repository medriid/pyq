  "question": {
    "text": "<p>The order of relative stability of the contributing structure is:</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/7a9c6159-df7b-424d-9017-255a579c5432.png\" style=\"width: 600px; height: 326px;\"/></p><p>Choose the correct answer from the options given below:</p>",
    "image": null
  },
  "options": [
    {
      "id": "vJZ9K",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>&gt;</mo><mi>II</mi><mo>&gt;</mo><mi>III</mi></math>",
      "image": null,
      "isCorrect": true
    },
