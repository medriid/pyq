  "question": {
    "text": "<p>According to IUPAC system, the compound  <img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/79b782be-b540-41c0-be39-658bc99c20a6.png\" style=\"width: 180px; height: 139px;\"/> is named as:</p>",
    "image": null
  },
