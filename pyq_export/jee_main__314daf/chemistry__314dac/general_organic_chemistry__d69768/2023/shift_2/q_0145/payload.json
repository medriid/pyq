  "question": {
    "text": "The correct IUPAC nomenclature for the&nbsp;following compound is:<br /><img src=\"assets\\qt0145_deeb5bceeefa.png\" style=\"width: 400px; height: 168px;\" />"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>-Methyl-<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math>-oxohexanoic acid",
