  "question": {
    "text": "<p>The correct order of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>pK</mi><mi mathvariant=\"normal\">a</mi></msub></math> values for the following compounds is:</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/db828c2c-0014-4d0e-bbc8-17357a1c98a7-9895985.png\" style=\"width: 500px; height: 258px;\" />&nbsp;</p>",
    "image": null
  },
