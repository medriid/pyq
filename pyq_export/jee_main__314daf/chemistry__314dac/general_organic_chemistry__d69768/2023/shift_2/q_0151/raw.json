  "type": "singleCorrect",
  "level": 3,
  "question": {
    "text": "<p>Given below are two statements:</p><p>Statement I: Sulphanilic acid gives esterification test for carboxyl group.</p><p>Statement II: Sulphanilic acid gives red colour in Lassigne&rsquo;s test for extra element detection.</p><p>In the light of the above statements, choose the most appropriate answer from the options given below:</p>",
    "image": null
  },
  "options": [
    {
      "id": "pkqyt",
      "text": "Statement I is correct but Statement II is incorrect.",
      "isCorrect": false,
      "image": null
