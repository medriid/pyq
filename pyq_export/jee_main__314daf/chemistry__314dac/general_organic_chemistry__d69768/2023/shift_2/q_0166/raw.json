  "question": {
    "text": "The correct IUPAC nomenclature for the&nbsp;following compound is:<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/44437ce8-ff8d-4677-b034-12d505b05b2a-image.png\" style=\"width: 400px; height: 168px;\" />",
