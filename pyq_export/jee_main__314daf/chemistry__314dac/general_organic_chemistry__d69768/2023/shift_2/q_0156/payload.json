  "question": {
    "text": "<p>Match List I with List II:</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 450px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>List I (Mixture)</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>List II<br />\t\t\t(Separation<br />\t\t\tTechnique)</td>\t\t</tr>\t\t<tr>\t\t\t<td>(A)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CHCl</mi><mn>3</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>NH</mi><mn>2</mn></msub></math></td>\t\t\t<td>I</td>\t\t\t<td>Steam distillation</td>\t\t</tr>\t\t<tr>\t\t\t<td>(B)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>14</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">C</mi><mn>5</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>12</mn></msub></math></td>\t\t\t<td>II</td>\t\t\t<td>Differential<br />\t\t\textraction</td>\t\t</tr>\t\t<tr>\t\t\t<td>(C)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>NH</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></td>\t\t\t<td>III</td>\t\t\t<td>Distillation</td>\t\t</tr>\t\t<tr>\t\t\t<td>(D)</td>\t\t\t<td>Organic compound in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></td>\t\t\t<td>IV</td>\t\t\t<td>Fractional<br />\t\t\tdistillation</td>\t\t</tr>\t</tbody></table>"
