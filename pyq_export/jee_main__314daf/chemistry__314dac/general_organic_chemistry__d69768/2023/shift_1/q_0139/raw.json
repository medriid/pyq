  "question": {
    "text": "<p>Thin layer chromatography of a mixture shows the following observation:</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/8077c43b-e511-4a17-9086-786ae384b8f8-image.png\" style=\"width: 150px; height: 154px;\" /></p><p>The correct order of elution in the silica gel column chromatography is</p>",
    "image": null
  },
  "options": [
    {
      "id": "aiV80",
      "text": "B, A, C",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oLX5r",
      "text": "B, C, A",
      "image": null,
      "isCorrect": false
    },
    {
