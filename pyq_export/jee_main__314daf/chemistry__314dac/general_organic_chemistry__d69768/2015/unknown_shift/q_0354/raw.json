  "question": {
    "text": "The number of structural isomers for <math><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>6</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>14</mn></mrow></msub></math> is:",
    "image": null
  },
  "options": [
    {
      "id": "q88aj",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
