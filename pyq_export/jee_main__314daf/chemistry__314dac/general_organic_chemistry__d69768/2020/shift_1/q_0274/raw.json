  "correctValue": null,
  "solution": {
    "text": "<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>(a)</td>\t\t\t<td><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/c934b736-62a3-4454-8807-39b4ac1241c9-image.png\" style=\"width: 266px; height: 122px;\" /></td>\t\t\t<td>(<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">N</mi><mo>-</mo></math>&nbsp;present in product so will show Kjeldhal Test)</td>\t\t</tr>\t\t<tr>\t\t\t<td>(b)</td>\t\t\t<td><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/17181aa5-edbd-4312-a6ad-298d13285777-image.png\" style=\"width: 254px; height: 128px;\" /></td>\t\t\t<td>(<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><msubsup><mi mathvariant=\"normal\">N</mi><mn>2</mn><mo>+</mo></msubsup></math>&nbsp;Never show Kjeldhal Test)</td>\t\t</tr>\t\t<tr>\t\t\t<td>(c)</td>\t\t\t<td><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f76d09dc-25a6-41ac-8fe3-f28f8876910c-image.png\" style=\"width: 280px; height: 114px;\" /></td>\t\t\t<td>(<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">N</mi><mo>-</mo></math>&nbsp;absent, wo will not show Kjeldhal Test)</td>\t\t</tr>\t</tbody></table><p>&nbsp;</p>",
