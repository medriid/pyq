  "question": {
    "text": "<p>Match the following :</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>Test/Method</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>Reagent</td>\t\t</tr>\t\t<tr>\t\t\t<td>(i)</td>\t\t\t<td>Lucas Test</td>\t\t\t<td>(a)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><msub><mi>SO</mi><mn>2</mn></msub><mi>Cl</mi><mo>/</mo><mi>aq</mi><mo>.</mo><mo>&#160;</mo><mi>KOH</mi></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(ii)</td>\t\t\t<td>&nbsp;Dumas method</td>\t\t\t<td>(b)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>HNO</mi><mn>3</mn></msub><mo>/</mo><msub><mi>AgNO</mi><mn>3</mn></msub></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(iii)</td>\t\t\t<td>Kjeldahl&#39;s method</td>\t\t\t<td>(c)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CuO</mi><mo>/</mo><msub><mi>CO</mi><mn>3</mn></msub></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(iv)</td>\t\t\t<td>Hinsberg Test</td>\t\t\t<td>(d)</td>\t\t\t<td>Conc.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HCl</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>ZnCl</mi><mn>2</mn></msub></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>&nbsp;</td>\t\t\t<td>&nbsp;</td>\t\t\t<td>(e)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub></math></td>\t\t</tr>\t</tbody></table><p>&nbsp;</p>"
