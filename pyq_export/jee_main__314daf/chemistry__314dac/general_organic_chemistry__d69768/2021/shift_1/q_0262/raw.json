  "question": {
    "text": "<p>Compound(s) which will liberate carbon dioxide with sodium bicarbonate solution is/are :</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/0f06f3d4-441d-40e9-88b5-a5f6805c1220-image.png\" style=\"width: 480px; height: 128px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "y6qZW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math>&nbsp;only",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "hBVLL",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi></math>&nbsp;only",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "yEm3f",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi></math>&nbsp;only",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ZlcvA",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math>&nbsp;only",
      "isCorrect": false,
      "image": null
