  "question": {
    "text": "<p>Given below are two statements :</p><p>Statement I : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mi>OH</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AgCN</mi></math> both can&nbsp;generate nucleophile.</p><p>Statement II : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>KCN</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AgCN</mi></math> both will generate nitrile nucleophile with all reaction conditions.</p><p>Choose the most appropriate option :</p>"
  },
  "options": [
    {
      "text": "Statement I is true but statement II is false",
      "is_correct": true
    },
    {
      "text": "Both statement I and statement II are true",
      "is_correct": false
    },
    {
      "text": "Statement I is false but statement II is true",
      "is_correct": false
    },
    {
      "text": "Both statement I and statement II are false",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>5</mn></msub><mi>OH</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AgCN</mi></math>&nbsp;both can generate nucleophiles.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AgCN</mi></math>&nbsp;generate isocyanide&nbsp;as a nucleophile but&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>KCN</mi></math>&nbsp;cyanide as a nucleophile.&nbsp;</p>"
  }
