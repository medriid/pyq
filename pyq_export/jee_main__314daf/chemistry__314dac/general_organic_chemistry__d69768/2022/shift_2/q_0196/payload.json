  "question": {
    "text": "<p>Match List-I with List-II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td style=\"text-align: center;\">&nbsp;</td>\t\t\t<td style=\"text-align: center;\"><strong>List-I<br />\t\t\t(Mixture)</strong></td>\t\t\t<td style=\"text-align: center;\">&nbsp;</td>\t\t\t<td style=\"text-align: center;\"><strong>List-II<br />\t\t\t(Purification Process)</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>A</td>\t\t\t<td>Chloroform &amp; Aniline</td>\t\t\t<td>I</td>\t\t\t<td>Steam distillation</td>\t\t</tr>\t\t<tr>\t\t\t<td>B</td>\t\t\t<td>Benzoic acid &amp; Napthalene</td>\t\t\t<td>II</td>\t\t\t<td>Sublimation</td>\t\t</tr>\t\t<tr>\t\t\t<td>C</td>\t\t\t<td>Water &amp; Aniline</td>\t\t\t<td>III</td>\t\t\t<td>Distillation</td>\t\t</tr>\t\t<tr>\t\t\t<td>D</td>\t\t\t<td>Napthalene&nbsp;&amp; Sodium chloride</td>\t\t\t<td>IV</td>\t\t\t<td>Crystallisation</td>\t\t</tr>\t</tbody></table>"
