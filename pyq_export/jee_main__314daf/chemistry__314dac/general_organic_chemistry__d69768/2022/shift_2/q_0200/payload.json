    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mover><mi mathvariant=\"normal\">O</mi><mo>&#168;</mo></mover><mo>&#62;</mo><msup><mi>OH</mi><mo>-</mo></msup></math>",
      "is_correct": false
