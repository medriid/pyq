    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>NH</mi><mn>2</mn><mo>-</mo></msubsup><mo>&#62;</mo><msub><mi>NH</mi><mn>3</mn></msub></math>",
