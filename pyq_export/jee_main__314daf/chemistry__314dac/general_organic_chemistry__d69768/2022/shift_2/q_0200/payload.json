  "question": {
    "text": "The correct order of nucleophilicity is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">F</mi><mo>-</mo></msup><mo>&#62;</mo><msup><mi>OH</mi><mo>-</mo></msup></math>",
      "is_correct": false
