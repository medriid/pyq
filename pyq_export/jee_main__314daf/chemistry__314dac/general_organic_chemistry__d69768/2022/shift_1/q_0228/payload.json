  "question": {
    "text": "<p>Phenol on reaction with dilute nitric acid, gives two products. Which method will be most efficient for large scale separation?</p>"
  },
  "options": [
    {
      "text": "Chromatographic separation",
      "is_correct": false
    },
    {
      "text": "Steam&nbsp;distillation",
      "is_correct": true
    },
