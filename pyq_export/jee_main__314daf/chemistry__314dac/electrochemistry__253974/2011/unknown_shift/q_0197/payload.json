  "question": {
    "text": "The reduction potential of hydrogen half cell will be negative if :"
  },
  "options": [
    {
      "text": "\n$\\mathrm{p}\\left(\\mathrm{H}_2\\right)=1 \\mathrm{~atm}$ and $\\left[\\mathrm{H}^{+}\\right]=1.0 \\mathrm{M}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{p}\\left(\\mathrm{H}_2\\right)=2 \\mathrm{~atm}$ and $\\left[\\mathrm{H}^{+}\\right]=1.0 \\mathrm{M}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{p}\\left(\\mathrm{H}_2\\right)=2 \\mathrm{~atm}$ and $\\left[\\mathrm{H}^{+}\\right]=2.0 \\mathrm{M}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{p}\\left(\\mathrm{H}_2\\right)=1 \\mathrm{~atm}$ and $\\left[\\mathrm{H}^{+}\\right]=2.0 \\mathrm{M}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$2 \\mathrm{H}^{+}+2 \\mathrm{e}^{-} \\rightarrow \\mathrm{H}_2(\\mathrm{~g})$\n$\\mathrm{E}=\\mathrm{E}^{\\circ}-0.059 \\log \\left(\\frac{\\mathrm{P}_{\\mathrm{H}_2}}{\\left[\\mathrm{H}^{+}\\right]^2}\\right)$ (here $\\mathrm{E}$ is -ve when $\\mathrm{P}_{\\mathrm{H}_2}>\\left[\\mathrm{H}^{+}\\right]^2$ )\n$=\\frac{-0.0591}{2} \\log _{10}\\left(\\frac{2}{1}\\right)=\\frac{-.0591}{2} \\times .3010=$ negative value"
  }
