  "question": {
    "text": "<p>The standard electrode potential of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">M</mi><mo>+</mo></msup><mo>/</mo><mi mathvariant=\"normal\">M</mi></math> in&nbsp;aqueous solution does not depend on</p>",
    "image": null
  },
  "options": [
    {
      "id": "7OvF1",
      "text": "Hydration of a gaseous metal ion",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KZnoC",
      "text": "<p>Sublimation of a solid metal</p>",
      "image": null,
      "isCorrect": false
    },
    {
