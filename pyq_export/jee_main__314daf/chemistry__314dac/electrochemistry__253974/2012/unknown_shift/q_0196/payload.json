  "question": {
    "text": "The standard reduction potentials for $\\mathrm{Zn}^{2+} / \\mathrm{Zn}, \\mathrm{Ni}^{2+} / \\mathrm{Ni}$, and $\\mathrm{Fe}^{2+} / \\mathrm{Fe}$ are $-0.76,-0.23$ and $-0.44 \\mathrm{~V}$ respectively. The reaction $\\mathrm{X}+\\mathrm{Y}^{2+} \\rightarrow \\mathrm{X}^{2+}+\\mathrm{Y}$ will be spontaneous when:"
  },
  "options": [
    {
      "text": "\n$X=N i, Y=F e$\n",
      "is_correct": false
    },
    {
      "text": "\n$X=N i, Y=Z n$\n",
      "is_correct": false
    },
    {
      "text": "\n$X=F e, Y=Z n$\n",
      "is_correct": false
    },
    {
      "text": "\n$X=Z n, Y=N i$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{Zn}+\\mathrm{Fe}^{+2} \\rightarrow \\mathrm{Zn}^{+2}+\\mathrm{Fe} \\\\\n& \\mathrm{Fe}+\\mathrm{Ni}^{+2} \\rightarrow \\mathrm{Fe}^{2+}+\\mathrm{Ni} \\\\\n& \\mathrm{Zn}+\\mathrm{Ni}^{2+} \\rightarrow \\mathrm{Zn}^{+2}+\\mathrm{Ni}\n\\end{aligned}$\nAll these are spontaneous"
  }
}