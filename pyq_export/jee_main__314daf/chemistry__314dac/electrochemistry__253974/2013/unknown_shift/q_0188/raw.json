  "question": {
    "text": "A solution of copper sulphate $\\left(\\mathrm{CuSO}_4\\right)$ is electrolysed for $10$ minutes with a current of $1.5$ amperes. The mass of copper deposited at the cathode (at. mass of $\\mathrm{Cu}=63 \\mathrm{u}$ ) is :",
    "image": null
  },
  "options": [
    {
      "id": "xkaZP",
      "text": "\n$0.3892 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "D9rsQ",
      "text": "\n$0.2938 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "tsUrj",
      "text": "\n$0.2398 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3MqhJ",
      "text": "\n$0.3928 \\mathrm{~g}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{W}=\\mathrm{Zit}$\nwhere $\\mathrm{Z}$ = Electrochemical equivalent\nEq. wt. of copper $=\\frac{63}{2}=31.5$\n$\\begin{aligned}\n& \\mathrm{Z}=\\frac{31.5}{96500} \\\\\n& \\mathrm{~W}=\\mathrm{Zit}=\\frac{31.5}{96500} \\times 1.5 \\times 10 \\times 60=0.2938 \\mathrm{~g}\n\\end{aligned}$",
    "image": null
  },
