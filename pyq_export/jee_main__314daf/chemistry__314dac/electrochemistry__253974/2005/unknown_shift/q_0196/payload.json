  "question": {
    "text": "Aluminium oxide may be electrolysed at $1000^{\\circ} \\mathrm{C}$ to furnish aluminium metal (Atomic mass $=27$ amu; 1 Faraday $=96,500$ Coulombs). The cathode reaction is \n$\\mathrm{Al}^{3+}+3 \\mathrm{e}^{-} \\longrightarrow \\mathrm{Al}^{\\circ}$\nTo prepare $5.12 \\mathrm{~kg}$ of aluminium metal by this method would require"
  },
  "options": [
    {
      "text": "\n$5.49 \\times 10^7 \\mathrm{C}$ of electricity\n",
      "is_correct": true
    },
    {
      "text": "\n$1.83 \\times 10^7$ C of electricity\n",
      "is_correct": false
    },
    {
      "text": "\n$5.49 \\times 10^4 \\mathrm{C}$ of electricity\n",
      "is_correct": false
    },
    {
      "text": "\n$5.49 \\times 10^1 \\mathrm{C}$ of electricity",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\mathrm{Q}=\\frac{\\mathrm{mFZ}}{\\mathrm{M}}=\\frac{5.12 \\times 10^5 \\times 96500 \\times 3}{27} \\\\\n& =5.49 \\times 10^7 \\mathrm{C}\n\\end{aligned}\n$$"
  }
}