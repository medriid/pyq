  "question": {
    "text": "For the redox reaction $\\mathrm{Zn}(\\mathrm{s})+\\mathrm{Cu}^{2+}(0.1 \\mathrm{M}) \\rightarrow \\mathrm{Zn}^{2+}(1 \\mathrm{M})+\\mathrm{Cu}(\\mathrm{s})$ taking place in a cell, $\\mathrm{E}_{\\text {cell }}^0$ is $1.10$ volt. $\\mathrm{E}^{\\circ}$\nfor the cell will be $\\left(2.303 \\frac{\\mathrm{RT}}{\\mathrm{F}}=0.0591\\right)$"
  },
  "options": [
    {
      "text": "\n$1.80$ volt\n",
      "is_correct": false
    },
    {
      "text": "\n$1.07$ volt\n",
      "is_correct": true
    },
    {
      "text": "\n$0.82$ volt\n",
      "is_correct": false
    },
    {
      "text": "\n$2.14$ volt",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{E}_{\\text {cell }}=\\mathrm{E}_{\\text {cell }}^0+\\frac{0.059}{\\mathrm{n}} \\log \\left[\\frac{\\mathrm{Cu}^{+2}}{\\mathrm{Zn}^{+2}}\\right]$\n$=1.10+\\frac{0.059}{2} \\log [0.1]=1.10-0.0295=1.07 \\mathrm{~V}$"
  }
}