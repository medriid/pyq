  "question": {
    "text": "When during electrolysis of a solution of $\\mathrm{AgNO}_3 9650$ coulombs of charge pass through the electroplating bath, the mass of silver deposited on the cathode will be",
    "image": null
  },
  "options": [
    {
      "id": "2qAQa",
      "text": "\n$10.8 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "22FQK",
      "text": "\n$21.6 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WNXCA",
      "text": "\n$108 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "46vkZ",
      "text": "\n$1.08 \\mathrm{~g}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "No. of moles of silver $=\\frac{9650}{96500}=\\frac{1}{10}$ moles\n$\\therefore$ Mass of silver deposited $=\\frac{1}{10} \\times 108=10.8 \\mathrm{~g}$",
    "image": null
  },
