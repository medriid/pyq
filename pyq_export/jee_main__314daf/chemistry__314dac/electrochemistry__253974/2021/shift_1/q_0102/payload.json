  "solution": {
    "text": "For given cell reaction <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>2</mn></math><br />and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;G</mi><mo>&#176;</mo><mo>=</mo><mo>-</mo><mi>nFE</mi><mo>&#176;</mo><mmultiscripts><mo>,</mo><mprescripts></mprescripts><mi>cell</mi><none></none></mmultiscripts><mo>&#160;</mo><mi>&#916;G</mi><mo>&#176;</mo><mo>=</mo><mi>&#916;H</mi><mo>&#176;</mo><mo>-</mo><mi>T&#916;S</mi></math><br />Then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;H</mi><mo>&#176;</mo><mo>=</mo><mn>825</mn><mo>.</mo><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi><mo>/</mo><mi>mole</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">T</mi><mo>=</mo><mn>298</mn><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">E</mi><msub><mo>&#176;</mo><mi>cell</mi></msub><mo>=</mo><mn>4</mn><mo>.</mo><mn>315</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">F</mi><mo>=</mo><mn>96487</mn><mo>&#160;</mo><mi mathvariant=\"normal\">C</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;S</mi><mo>&#176;</mo><mo>=</mo><mfrac><mrow><mo>-</mo><mfenced><mrow><mo>-</mo><mi>nFE</mi><msub><mo>&#176;</mo><mi>cell</mi></msub><mo>-</mo><mi>&#916;H</mi></mrow></mfenced></mrow><mi mathvariant=\"normal\">T</mi></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;S</mi><mo>&#176;</mo><mo>=</mo><mfrac><mrow><mo>-</mo><mfenced><mrow><mo>-</mo><mn>2</mn><mo>&#215;</mo><mn>96487</mn><mo>&#215;</mo><mn>4</mn><mo>.</mo><mn>315</mn><mo>-</mo><mfenced><mrow><mo>-</mo><mn>825</mn><mo>.</mo><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup></mrow></mfenced></mrow></mfenced></mrow><mn>298</mn></mfrac><mo>=</mo><mfrac><mrow><mn>832</mn><mo>.</mo><mn>682</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup><mo>-</mo><mn>825</mn><mo>.</mo><mn>2</mn><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup></mrow><mn>298</mn></mfrac><mo>=</mo><mfrac><mn>7482</mn><mn>298</mn></mfrac><mo>&#215;</mo><msup><mn>10</mn><mn>3</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;S</mi><mo>&#176;</mo><mo>=</mo><mn>25</mn><mo>.</mo><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">J</mi><mo>/</mo><mi mathvariant=\"normal\">k</mi></math>"
