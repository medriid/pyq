<mrow><mn>0</mn><mo>.</mo><mn>0591</mn></mrow><mn>3</mn></mfrac><mi>log</mi><mfrac><msub><mi mathvariant=\"normal\">P</mi><mi>NO</mi></msub><msup><mi mathvariant=\"normal\">y</mi><mn>5</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>17</mn><mo>=</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>0591</mn></mrow><mn>3</mn></mfrac><mfenced open=\"[\" close=\"]\"><mrow><mi>log</mi><mfrac><msub><mi mathvariant=\"normal\">P</mi><mi>NO</mi></msub><msup><mi mathvariant=\"normal\">y</mi><mn>5</mn></msup></mfrac><mo>-</mo><mi>log</mi><mfrac><msubsup><mi mathvariant=\"normal\">P</mi><msub><mi>NO</mi><mn>2</mn></msub><mn>3</mn></msubsup><msup><mi mathvariant=\"normal\">y</mi><mn>9</mn></msup></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>17</mn><mo>=</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>0591</mn></mrow><mn>3</mn></mfrac><mfenced open=\"[\" close=\"]\"><mrow><mi>log</mi><mfrac><msub><mi mathvariant=\"normal\">P</mi><mi>NO</mi></msub><msup><mi mathvariant=\"normal\">y</mi><mn>5</mn></msup></mfrac><mo>&#215;</mo><mfrac><msup><mi mathvariant=\"normal\">y</mi><mn>9</mn></msup><msubsup><mi mathvariant=\"normal\">P</mi><msub><mi>NO</mi><mn>2</mn></msub><mn>3</mn></msubsup></mfrac></mrow></mfenced></math></p><p>Assume <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">P</mi><mi>NO</mi></msub><mo>&#8771;</mo><msub><mi mathvariant=\"normal\">P</mi><msub><mi>NO</mi><mn>2</mn></msub></msub><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>bar</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>0</mn><mo>.</mo><mn>17</mn><mo>&#215;</mo><mn>3</mn></mrow><mrow><mn>0</mn><mo>.</mo><mn>059</mn></mrow></mfrac><mo>=</mo><msup><mi>logy</mi><mn>4</mn></msup><mo>=</mo><mn>8</mn><mo>.</mo><mn>644</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mn>8</mn><mo>.</mo><mn>644</mn></mrow><mn>4</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>log</mi><mi>y</mi><mo>=</mo><mn>2</mn><mo>.</mo><mn>161</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msup><mn>10</mn><mrow><mn>2</mn><mo>.</mo><mn>1</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mn>2</mn><mi mathvariant=\"normal\">x</mi><mo>=</mo><mn>2</mn><mo>&#215;</mo><mn>2</mn><mo>.</mo><mn>161</mn><mo>=</mo><mn>4</mn><mo>.</mo><mn>322</mn></math></p><p>Answer (4)</p>"
