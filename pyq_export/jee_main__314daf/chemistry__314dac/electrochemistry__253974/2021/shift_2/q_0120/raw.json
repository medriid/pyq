fenced close=\"]\" open=\"[\"><msup><mi mathvariant=\"normal\">H</mi><mo>&#8853;</mo></msup></mfenced><mo>=</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup><mi mathvariant=\"normal\">M</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">E</mi><mn>2</mn></msub><mo>=</mo><msup><mi mathvariant=\"normal\">E</mi><mn>0</mn></msup><mo>-</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>059</mn></mrow><mn>5</mn></mfrac><mi>log</mi><mfrac><mfenced close=\"]\" open=\"[\"><msup><mi>Mn</mi><mrow><mo>+</mo><mn>2</mn></mrow></msup></mfenced><mfenced close=\"]\" open=\"[\"><msubsup><mi>MnO</mi><mn>4</mn><mo>-</mo></msubsup></mfenced></mfrac><mo>&#215;</mo><mfrac><mn>1</mn><msup><mfenced><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup></mfenced><mn>8</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi mathvariant=\"normal\">E</mi><mn>0</mn></msup><mo>-</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>059</mn></mrow><mn>5</mn></mfrac><mi>log</mi><mfrac><msup><mi>Mn</mi><mrow><mo>+</mo><mn>2</mn></mrow></msup><mfenced close=\"]\" open=\"[\"><msubsup><mi>MnO</mi><mn>4</mn><mo>-</mo></msubsup></mfenced></mfrac><mo>+</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>059</mn></mrow><mn>5</mn></mfrac><mi>log</mi><msup><mn>10</mn><mrow><mo>-</mo><mn>32</mn></mrow></msup></math></p><p>therefore:&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><msub><mi mathvariant=\"normal\">E</mi><mn>1</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">E</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>059</mn></mrow><mn>5</mn></mfrac><mo>&#215;</mo><mn>32</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>0</mn><mo>.</mo><mn>3776</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi><mo>=</mo><mn>3776</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup></math></p><p><math 