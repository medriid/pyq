  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{lll}\\text { Cathode } & \\left(\\mathrm{Ag}+(\\mathrm{aq})+\\mathrm{e}^{-}\\right. & \\rightarrow \\mathrm{Ag}) \\times 2 \\\\ \\text { Anode } & \\mathrm{Mg} & \\rightarrow \\mathrm{Mg}^{2+}(\\mathrm{aq})+2 \\mathrm{e}^{-}\\end{array}$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5fehv2XCOqyVLYn-Jebb22QyBHpkAqQVDjHWF23wOqg.original.fullsize.png\"><br>\nBy Nernst equation\n$\\begin{aligned}\n& \\mathrm{E}_{\\text {cell }}=\\mathrm{E}_{\\mathrm{cell}}^{\\circ}-\\frac{\\mathrm{RT}}{\\mathrm{nF}} \\ln \\mathrm{Q} \\\\\n& \\mathrm{E}_{\\text {cell }}=\\mathrm{E}_{\\mathrm{cell}}^{\\circ}-\\frac{\\mathrm{RT}}{\\mathrm{nF}} \\ln \\frac{\\left[\\mathrm{Mg}^{2+}\\right]}{\\left[\\mathrm{Ag}^{+}\\right]^2} \\\\\n& =\\mathrm{E}_{\\text {cell }}^{\\circ}+\\frac{\\mathrm{RT}}{2 \\mathrm{~F}} \\ln \\frac{\\left[\\mathrm{Ag}^{+}\\right]^2}{\\left[\\mathrm{Mg}^{2+}\\right]}\n\\end{aligned}$",
    "image": null
  },
