    },
    {
      "id": "GcLqE",
      "text": "\\(\\mathrm{E}_{\\text {cell }}=\\mathrm{E}_{\\text {cell }}^{\\mathrm{o}}+\\frac{\\mathrm{RT}}{2 \\mathrm{~F}} \\ln \\frac{\\left[\\mathrm{Ag}^{+}\\right]^2}{\\left[\\mathrm{Mg}^{2+}\\right]}\\)",
