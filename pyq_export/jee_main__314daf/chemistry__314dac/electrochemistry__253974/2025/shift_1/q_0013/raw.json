  "question": {
    "text": "For a \\(\\mathrm{Mg}\\left|\\mathrm{Mg}^{2+}(\\mathrm{aq})\\right|\\left|\\mathrm{Ag}^{+}(\\mathrm{aq})\\right| \\mathrm{Ag}\\) the correct Nernst Equation is :",
    "image": null
  },
  "options": [
    {
      "id": "B7y6O",
      "text": "\\(\\mathrm{E}_{\\text {cell }}=\\mathrm{E}_{\\text {cell }}^{\\mathrm{o}}-\\frac{\\mathrm{RT}}{2 \\mathrm{~F}} \\ln \\frac{\\left[\\mathrm{Ag}^{+}\\right]}{\\left[\\mathrm{Mg}^{2+}\\right]}\\)",
      "image": null,
