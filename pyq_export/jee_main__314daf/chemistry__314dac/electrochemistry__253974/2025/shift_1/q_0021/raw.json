  "question": {
    "text": "Correct order of limiting molar conductivity for cations in water at 298 K is :",
    "image": null
  },
  "options": [
    {
      "id": "pKhHG",
      "text": "$\\mathrm{H}^{+} \\gt \\mathrm{Na}^{+} \\gt \\mathrm{K}^{+} \\gt \\mathrm{Ca}^{2+} \\gt \\mathrm{Mg}^{2+}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "E1hUq",
      "text": "$\\mathrm{H}^{+} \\gt \\mathrm{Ca}^{2+} \\gt \\mathrm{Mg}^{2+} \\gt \\mathrm{K}^{+} \\gt \\mathrm{Na}^{+}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Y0LiA",
      "text": "$\\mathrm{Mg}^{2+} \\gt \\mathrm{H}^{+} \\gt \\mathrm{Ca}^{2+} \\gt \\mathrm{K}^{+} \\gt \\mathrm{Na}^{+}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KQQYT",
      "text": "$\\mathrm{H}^{+} \\gt \\mathrm{Na}^{+} \\gt \\mathrm{Ca}^{2+} \\gt \\mathrm{Mg}^{2+} \\gt \\mathrm{K}^{+}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Limiting Molar Conductivities of Ions:<br />- $\\stackrel{\\oplus}{\\mathrm{H}}: 349.8 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1}$<br />- $\\mathrm{Na}^{+}: 50.11 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1}$<br />- $\\mathrm{K}^{+}: 73.52 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1}$<br />- $\\mathrm{Ca}^{+2}: 119 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1}$<br />- $\\mathrm{Mg}^{+2}: 106.12 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1}$<br />Therefore correct order of limiting molar conductivity of cations will be -<br />$\\stackrel{\\oplus}{\\mathrm{H}} \\gt \\mathrm{Ca}^{+2} \\gt \\mathrm{Mg}^{+2} \\gt \\mathrm{K}^{+} \\gt \\mathrm{Na}^{+}$",
    "image": null
  },
