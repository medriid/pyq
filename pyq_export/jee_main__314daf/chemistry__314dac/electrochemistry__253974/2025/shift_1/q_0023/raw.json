  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Al}^{1++}+3 \\mathrm{e}^{-} \\longrightarrow \\mathrm{Al}$\n$\\begin{aligned}\n\\text { Moles of electron } & =\\frac{2 \\times 30 \\times 60}{96500} \\\\\n& =\\frac{36}{965}\n\\end{aligned}$\n$\\begin{aligned}\n\\text { Moles of } \\mathrm{Al} & =\\frac{36}{3 \\times 965} \\\\\n& =\\frac{12}{965}\n\\end{aligned}$\n$\\text { Mass of } \\mathrm{Al}=\\frac{12}{965} \\times 27$\n$=0.336 \\mathrm{gm}$",
    "image": null
  },
