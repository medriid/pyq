i>cell</mi><mn>0</mn></msubsup><mo>=</mo><msubsup><mi mathvariant=\"normal\">E</mi><mrow><msup><mi>Ag</mi><mo>+</mo></msup><mo>/</mo><mi>Ag</mi></mrow><mn>0</mn></msubsup><mo>-</mo><msubsup><mi mathvariant=\"normal\">E</mi><mrow><msup><mi>Cu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>/</mo><mi>Cu</mi></mrow><mn>0</mn></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>46</mn><mo>=</mo><mn>0</mn><mo>.</mo><mn>80</mn><mo>-</mo><msubsup><mi mathvariant=\"normal\">E</mi><mrow><msup><mi>Cu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>/</mo><mi>Cu</mi></mrow><mn>0</mn></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi mathvariant=\"normal\">E</mi><mrow><msup><mi>Cu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>/</mo><mi>Cu</mi></mrow><mn>0</mn></msubsup><mo>=</mo><mn>0</mn><mo>.</mo><mn>34</mn></math> volt</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi mathvariant=\"normal\">E</mi><mrow><msup><mi>Cu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>/</mo><mi>Cu</mi></mrow><mn>0</mn></msubsup><mo>=</mo><mn>34</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></p></blockquote>"
