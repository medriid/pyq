  "type": "singleCorrect",
  "level": 3,
  "question": {
    "text": "In the industrial production of which of the following, molecular hydrogen is obtained as a bye product.",
    "image": null
  },
  "options": [
    {
      "id": "C0MKz",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>CO</mi><mn>3</mn></msub></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "qw6fW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaOH</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "lD2FN",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Na</mi></math>&nbsp;metal",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "wgvFO",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NaHCO</mi><mn>3</mn></msub></math>",
      "isCorrect": false,
      "image": null
