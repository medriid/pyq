  "correctValue": "7",
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mfenced><mi mathvariant=\"normal\">g</mi></mfenced><mo>+</mo><msup><mi>Cu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mfenced><mrow><mi>aq</mi><mo>.</mo></mrow></mfenced><mo>&#8594;</mo><mn>2</mn><msup><mi mathvariant=\"normal\">H</mi><mo>+</mo></msup><mfenced><mrow><mi>aq</mi><mo>.</mo></mrow></mfenced><mo>+</mo><mi>Cu</mi><mfenced><mi mathvariant=\"normal\">s</mi></mfenced></math></p><p>Applying nernst equation</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">E</mi><mi>cell</mi></msub><mo>=</mo><msubsup><mi mathvariant=\"normal\">E</mi><mi>cell</mi><mn>0</mn></msubsup><mo>-</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>06</mn></mrow><mi mathvariant=\"normal\">n</mi></mfrac><mi>log</mi><mstyle displaystyle=\"false\"><mfrac><mfenced open=\"[\" close=\"]\"><mi>products</mi></mfenced><mfenced open=\"[\" close=\"]\"><mi>Reactants</mi></mfenced></mfrac></mstyle></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">E</mi><mi>cell</mi></msub><mo>=</mo><mi>Cell</mi><mo>&#160;</mo><mi>potential</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>31</mn><mi mathvariant=\"normal\">V</mi><mspace linebreak=\"newline\"/><msubsup><mi mathvariant=\"normal\">E</mi><mi>cell</mi><mn>0</mn></msubsup><mo>=</mo><mn>0</mn><mo>.</mo><mn>34</mn><mspace linebreak=\"newline\"/><msup><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">H</mi></msup><mo>=</mo><mn>3</mn><mo>,</mo><mi>Hence</mi><mo>,</mo><mfenced open=\"[\" close=\"]\"><msup><mi mathvariant=\"normal\">H</mi><mo>+</mo></msup></mfenced><mo>=</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>.</mo><mn>31</mn><mo>=</mo><mn>0</mn><mo>.</mo><mn>34</mn><mo>-</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>06</mn></mrow><mn>2</mn></mfrac><mi>log</mi><mfrac><msu