  "correct_answer": "4",
  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">E</mi><mo>=</mo><msup><mi mathvariant=\"normal\">E</mi><mn>0</mn></msup><mo>-</mo><mfrac><mrow><mn>2</mn><mo>.</mo><mn>303</mn><mi>RT</mi></mrow><mi>nF</mi></mfrac><mi>logQ</mi></math></p><p>Here,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">E</mi><mo>=</mo><mo>+</mo><mn>0</mn><mo>.</mo><mn>801</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi><mspace linebreak=\"newline\"></mspace><msup><mi mathvariant=\"normal\">E</mi><mn>0</mn></msup><mo>=</mo><msubsup><mi mathvariant=\"normal\">E</mi><mi>Cathode</mi><mo>&#8728;</mo></msubsup><mo>-</mo><msubsup><mi mathvariant=\"normal\">E</mi><mi>Anode</mi><mo>&#8728;</mo></msubsup><mfenced><mrow><mi>Both</mi><mo>&#160;</mo><mi>are</mi><mo>&#160;</mo><mi>SRP</mi><mo>&#160;</mo><mi>values</mi></mrow></mfenced><mspace linebreak=\"newline\"></mspace><msup><mi mathvariant=\"normal\">E</mi><mn>0</mn></msup><mo>=</mo><mn>0</mn><mo>.</mo><mn>008</mn><mo>-</mo><mfenced><mrow><mo>-</mo><mn>0</mn><mo>.</mo><mn>763</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>+</mo><mn>0</mn><mo>.</mo><mn>771</mn><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mn>0</mn><mo>.</mo><mn>801</mn><mo>=</mo><mo>+</mo><mn>0</mn><mo>.</mo><mn>771</mn><mo>-</mo><mfrac><mrow><mn>0</mn><mo>.</mo><mn>06</mn></mrow><mi mathvariant=\"normal\">n</mi></mfrac><mi>log</mi><msup><mn>10</mn><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>4</mn></math></p></blockquote>"
