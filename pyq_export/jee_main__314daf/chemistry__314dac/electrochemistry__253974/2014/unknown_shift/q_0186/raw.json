    {
      "id": "8PRJV",
      "text": "<math> <mrow> <msub> <mi>&lambda;</mi> <mtext>C</mtext> </msub> <mo>=</mo> <msub> <mi>&lambda;</mi> <mo>&infin;</mo> </msub> <mo>+</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>B</mtext> </mrow> </mfenced> <msqrt> <mtext>C</mtext> </msqrt> </mrow> </math>",
