  "question": {
    "text": "The molar conductivities $\\wedge_{\\mathrm{NaOAC}}^{\\circ}$ and $\\wedge_{\\mathrm{HCl}}^{\\circ}$ at infinite dilution in water at $25^{\\circ} \\mathrm{C}$ are $91.0$ and $426.2 \\mathrm{~S} \\mathrm{~cm}^2 / \\mathrm{mol}$ respectively. To calculate $\\wedge_{\\mathrm{HOAc}}^O$, the additional value required is"
  },
  "options": [
    {
      "text": "\n$\\wedge_{\\mathrm{H}_2 \\mathrm{O}}^{\\circ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\wedge_{\\mathrm{KCl}}^{\\circ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\wedge_{\\mathrm{NaOH}}^{\\circ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\wedge_{\\mathrm{NaCl}}^{\\circ}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\lambda_{\\mathrm{CH}_3 \\mathrm{COONa}}^0=\\lambda_{\\mathrm{CH}_3 \\mathrm{COO}^{-}}^0+\\lambda_{\\mathrm{Na}^{+}}^0 \\\\\n& \\lambda_{\\mathrm{HCl}}^0=\\lambda_{\\mathrm{H}^{+}}^0+\\lambda_{\\mathrm{C}}^0 \\cdots \\cdots \\cdots \\cdots \\cdot \\\\\n& \\lambda_{\\mathrm{NaCl}}^0=\\lambda_{\\mathrm{Na}}^0+\\lambda_{\\mathrm{Cl}}^0 \\cdots \\cdots \\cdots \\cdots \\\\\n& \\lambda_{\\mathrm{CH}_3 \\mathrm{COOH}}^0=(1)+(2)-(3)\n\\end{aligned}\n$$"
  }
