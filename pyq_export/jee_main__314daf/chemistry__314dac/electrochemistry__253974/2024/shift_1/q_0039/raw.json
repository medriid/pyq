  "question": {
    "text": "What pressure (bar) of \\(\\mathrm{H}_2\\) would be required to make emf of hydrogen electrode zero in pure water at \\(25^{\\circ} \\mathrm{C}\\) ?",
    "image": null
  },
  "options": [
    {
      "id": "aOu8m",
      "text": "\\(10^{-7}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TOObm",
      "text": "0.5",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DhAh7",
      "text": "1",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KNTb9",
      "text": "\\(10^{-14}\\)",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & 2 \\mathrm{e}^{-}+2 \\mathrm{H}^{+}(\\mathrm{aq}) \\rightarrow \\mathrm{H}_2(\\mathrm{~g}) \\\\ & \\mathrm{E}=\\mathrm{E}^{\\circ}-\\frac{0.059}{\\mathrm{n}} \\log \\frac{\\mathrm{P}_{\\mathrm{H}_2}}{\\left[\\mathrm{H}^{+}\\right]^2} \\\\ & 0=0-\\frac{0.059}{2} \\log \\frac{\\mathrm{P}_{\\mathrm{H}_2}}{\\left(10^{-7}\\right)^2} \\\\ & \\log \\frac{\\mathrm{P}_{\\mathrm{H}_2}}{\\left(10^{-7}\\right)^2}=0 \\\\ & \\frac{\\mathrm{P}_{\\mathrm{H}_2}}{10^{-14}}=1 \\\\ & \\mathrm{P}_{\\mathrm{H}_2}=10^{-14} \\text { bar }\\end{aligned}$",
    "image": null
  },
