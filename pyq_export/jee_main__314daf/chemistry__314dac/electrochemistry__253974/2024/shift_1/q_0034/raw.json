  "question": {
    "text": "Molar ionic conductivities of divalent cation and anion are \\(57 \\mathrm{~S} \\mathrm{~cm}^2 \\mathrm{~mol}^{-1}\\) and \\(73 \\mathrm{~S} \\mathrm{~cm}^2 \\mathrm{~mol}^{-1}\\) respectively. The molar conductivity of solution of an electrolyte with the above cation and anion will be :",
    "image": null
  },
  "options": [
    {
      "id": "aUmkL",
      "text": "\\(187 \\mathrm{~S} \\mathrm{~cm}^2 \\mathrm{~mol}^{-1}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8DnmZ",
      "text": "\\(260 \\mathrm{~S} \\mathrm{~cm}^2 \\mathrm{~mol}^{-1}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "328Jp",
      "text": "\\(130 \\mathrm{~S} \\mathrm{~cm}^2 \\mathrm{~mol}^{-1}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "eZHBK",
      "text": "\\(65 \\mathrm{~S} \\mathrm{~cm}^2 \\mathrm{~mol}^{-1}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\Lambda_{\\mathrm{C}}^{+2}=57 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1} \\\\ & \\Lambda_{\\mathrm{A}}^{+2}=73 \\mathrm{Scm}^2 \\mathrm{~mol}^{-1} \\\\ & \\Lambda_{\\text {Solution }}=\\lambda_{\\mathrm{C}}^{+2}+\\Lambda_{\\mathrm{A}}^{-2} \\\\ & =57+73=130\\end{aligned}$",
    "image": null
