    {
      "id": "EDKaj",
      "text": "\\(\\Lambda^2{ }_m \\mathrm{C}+\\mathrm{K}_{\\mathrm{a}} \\Lambda_{\\mathrm{m}}^{\\circ 2}-\\mathrm{K}_{\\mathrm{a}} \\Lambda_{\\mathrm{m}} \\Lambda_{\\mathrm{m}}^{\\circ}=0\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fxPgI",
      "text": "\\(\\Lambda_{\\mathrm{m}}-\\Lambda_{\\mathrm{m}}^{\\circ}-\\mathrm{AC}^{\\frac{1}{2}}=0\\)",
      "image": null,
      "isCorrect": false
