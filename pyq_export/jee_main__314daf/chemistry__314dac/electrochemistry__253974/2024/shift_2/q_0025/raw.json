  "question": {
    "text": "Which out of the following is a correct equation to show change in molar conductivity with respect to concentration for a weak electrolyte, if the symbols carry their usual meaning :",
    "image": null
  },
  "options": [
    {
      "id": "PGqJZ",
      "text": "\\(\\Lambda_{\\mathrm{m}}-\\Lambda_{\\mathrm{m}}^0+\\mathrm{AC}^{\\frac{1}{2}}=0\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WeBIL",
      "text": "\\(\\Lambda_m^2 \\mathrm{C}-\\mathrm{K}_{\\mathrm{a}} \\Lambda_{\\mathrm{m}}^{\\circ 2}+\\mathrm{K}_{\\mathrm{a}} \\Lambda_{\\mathrm{m}} \\Lambda_{\\mathrm{m}}=0\\)",
      "image": null,
      "isCorrect": true
