  "question": {
    "text": "EMF of a cell in terms of reduction potential of its left and right electrodes is"
  },
  "options": [
    {
      "text": "\n$E=E_{\\text {left }}-E_{\\text {right }}$\n",
      "is_correct": false
    },
    {
      "text": "\n$E=E_{\\text {left }}+E_{\\text {right }}$\n",
      "is_correct": false
    },
    {
      "text": "\n$E=E_{\\text {right }}-E_{\\text {left }}$\n",
      "is_correct": true
    },
    {
      "text": "\n$E=-\\left(E_{\\text {right }}+E_{\\text {left }}\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\mathrm{E}_{\\text {cell }} & =\\text { Reduction potential of cathode (right) - reduction potential of anode (left) } \\\\ & =\\mathrm{E}_{\\text {right }}-\\mathrm{E}_{\\text {left }}\\end{aligned}$"
  }
