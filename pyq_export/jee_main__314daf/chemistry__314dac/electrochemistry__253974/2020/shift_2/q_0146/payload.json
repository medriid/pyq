</mo><mn>2</mn></mrow> </msup> </mrow> </mfenced></mrow> <mrow> <mfenced close=\"]\" open=\"[\"> <mrow> <msup> <mrow> <mtext>Pb</mtext></mrow> <mrow> <mo>+</mo><mn>2</mn></mrow> </msup> </mrow> </mfenced></mrow> </mfrac> </mrow> </math><br /><br /><math> <mrow> <mo>&#8658;</mo><mtext>&#8195;</mtext><mfrac> <mn>1</mn> <mn>3</mn> </mfrac> <mo>=</mo><mi>log</mi><mfrac> <mrow> <mfenced close=\"]\" open=\"[\"> <mrow> <msup> <mrow> <mtext>Sn</mtext></mrow> <mrow> <mo>+</mo><mn>2</mn></mrow> </msup> </mrow> </mfenced></mrow> <mrow> <mfenced close=\"]\" open=\"[\"> <mrow> <msup> <mrow> <mtext>Pb</mtext></mrow> <mrow> <mo>+</mo><mn>2</mn></mrow> </msup> </mrow> </mfenced></mrow> </mfrac> </mrow> </math><br /><br /><math> <mrow> <mo>&#8658;</mo><mtext>&#8195;</mtext><mfrac> <mrow> <mfenced close=\"]\" open=\"[\"> <mrow> <msup> <mrow> <mtext>Sn</mtext></mrow> <mrow> <mo>+</mo><mn>2</mn></mrow> </msup> </mrow> </mfenced></mrow> <mrow> <mfenced close=\"]\" open=\"[\"> <mrow> <msup> <mrow> <mtext>Pb</mtext></mrow> <mrow> <mo>+</mo><mn>2</mn></mrow> </msup> </mrow> </mfenced></mrow> </mfrac> <mo>=</mo><mn>2.15</mn></mrow> </math>"
