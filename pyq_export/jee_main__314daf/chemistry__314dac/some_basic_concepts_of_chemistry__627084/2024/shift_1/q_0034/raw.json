  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Molality }=\\frac{1000 \\times \\mathrm{M}}{1000 \\times \\mathrm{d}-\\mathrm{M} \\times(\\mathrm{Mw})_{\\text {solute }}} \\\\ & 3=\\frac{1000 \\times \\mathrm{x}}{1000 \\times 1.12-(\\mathrm{x} \\times 40)} \\\\ & \\mathrm{x}=3\\end{aligned}$",
