  "question": {
    "text": "Concentrated nitric acid is labelled as $75 \\%$ by mass. The volume in mL of the solution which contains 30 g of nitric acid is \n____.\nGiven : Density of nitric acid solution is $1.25 \\mathrm{~g} / \\mathrm{mL}$.",
    "image": null
  },
  "options": [
    {
      "id": "i3ulA",
      "text": "$40$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hsaYy",
      "text": "$32$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "7Y6nR",
      "text": "$45$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "plLsC",
      "text": "$55$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$75 \\%$ by mass means :\n$\\because \\quad 75 \\mathrm{~g} \\mathrm{HNO}_3$ in 100 g solution.\n$\\therefore \\quad 30 \\mathrm{~g} \\mathrm{HNO}_3$ in $\\frac{100}{75} \\times 30 \\mathrm{~g}$ solution.\n$\\begin{aligned}\n& \\mathrm{m}_{\\text {solution }}=\\frac{100 \\times 30}{75} \\mathrm{~g} \\\\\n\\because \\quad & \\mathrm{~V}_{\\text {sol }}=\\frac{\\mathrm{m}_{\\text {sol }}}{\\mathrm{d}_{\\text {sol }}}=\\frac{100 \\times 30}{75 \\times 1.25}=32 \\mathrm{~mL}\n\\end{aligned}$",
    "image": null
  },
