  "question": {
    "text": "The amount of calcium oxide produced on heating 150 kg limestone ( $75 \\%$ pure) is ______ kg. (Nearest integer)<br />Given : Molar mass (in $\\mathrm{g} \\mathrm{mol}^{-1}$) of Ca-40, O-16, C-12",
    "image": null
  },
  "options": [],
  "correctValue": "63",
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{CaCO}_3 \\rightarrow \\mathrm{CaO}+\\mathrm{CO}_2 \\\\ & \\text { mass of } \\mathrm{CaCO}_3=\\frac{150 \\times 75}{100}=112.5 \\mathrm{~kg} \\\\ & =112500 \\mathrm{~g} \\\\ & \\mathrm{n}_{\\mathrm{CaCO}_3}=1125 \\\\ & \\mathrm{So} \\text { moles of } \\mathrm{CaO}=1125 \\\\ & \\quad \\text { mass of } \\mathrm{CaO}=\\frac{1125 \\times 56}{1000}=63 \\mathrm{~kg} \\\\ & \\text { Correct answer } \\Rightarrow 63\\end{aligned}$",
    "image": null
  },
