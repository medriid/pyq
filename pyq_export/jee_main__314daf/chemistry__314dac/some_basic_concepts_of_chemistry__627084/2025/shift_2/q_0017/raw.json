  "question": {
    "text": "The elemental composition of a compound is $54.2 \\% \\mathrm{C}, 9.2 \\% \\mathrm{H}$ and $36.6 \\% \\mathrm{O}$.\nIf the molar mass of the compound is $132 \\mathrm{~g} \\mathrm{~mol}^{-1}$, the molecular formula of the compound is :\n[Given : The relative atomic mass of $\\mathrm{C}: \\mathrm{H}: \\mathrm{O}=12: 1: 16$ ]",
    "image": null
  },
  "options": [
    {
      "id": "qb09o",
      "text": "$\\mathrm{C}_4 \\mathrm{H}_9 \\mathrm{O}_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Q3450",
      "text": "$\\mathrm{C}_6 \\mathrm{H}_{12} \\mathrm{O}_6$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "M1qvj",
      "text": "$\\mathrm{C}_4 \\mathrm{H}_8 \\mathrm{O}_2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A2oUh",
      "text": "$\\mathrm{C}_6 \\mathrm{H}_{12} \\mathrm{O}_3$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/-2MbQJb__JWl80JiUWFf4SJQJeUgWBOye1NDQndmhRI.original.fullsize.png\"><br>\nMolecular mass of compound $=132 \\mathrm{~g} \\mathrm{~mol}^{-1}$ Molecular formula of compound is $\\left(\\mathrm{C}_2 \\mathrm{H}_4 \\mathrm{O}\\right)_n$\n$\\mathrm{n}=\\frac{\\text { Molecular mass }}{\\mathrm{EF} \\text { mass }}=\\frac{132}{44}=3$\n$\\therefore$ Molecular formula of compound is $\\mathrm{C}_6 \\mathrm{H}_{12} \\mathrm{O}_3$",
    "image": null
  },
