  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & 3 \\mathrm{M} \\mathrm{NaCl}, \\mathrm{d}_{\\text {sol }}=1.25 \\mathrm{gm} / \\mathrm{mol} \\\\ & \\begin{aligned} \\text { Molality } & =\\frac{\\mathrm{M} \\times 1000}{1000 \\mathrm{~d}-\\mathrm{M} \\times \\mathrm{M}_{\\mathrm{W}}} \\\\ & =\\frac{3000}{1250-175.5}=2.79\\end{aligned}\\end{aligned}$",
