    "text": "<math><msub><mrow><mi>C</mi></mrow><mrow><mn>57</mn></mrow></msub><msub><mrow><mi>H</mi></mrow><mrow><mn>110</mn></mrow></msub><msub><mrow><mi>O</mi></mrow><mrow><mn>6</mn></mrow></msub><mo>+</mo><mfrac><mrow><mn>163</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi>O</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>&#8594;</mo><mn>57</mn><mi>C</mi><msub><mrow><mi>O</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>55</mn><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>O</mi></math><br /><br />Molecular weight of <math><msub><mrow><mi>C</mi></mrow><mrow><mn>57</mn></mrow></msub><msub><mrow><mi>H</mi></mrow><mrow><mn>110</mn></mrow></msub><msub><mrow><mi>O</mi></mrow><mrow><mn>6</mn></mrow></msub><mo>=</mo><mn>890</mn></math><br /><br />Moles of <math><msub><mrow><mi>C</mi></mrow><mrow><mn>57</mn></mrow></msub><msub><mrow><mi>H</mi></mrow><mrow><mn>110</mn></mrow></msub><msub><mrow><mi>O</mi></mrow><mrow><mn>6</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">t</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">m</mi></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">t</mi></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>445</mn></mrow><mrow><mn>890</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br />According to stoichiometry<br /><br /><math><mo>&#8757;</mo><mn>1</mn><mi>&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi><mi>&#160;</mi></math> of <math><msub><mrow><mi>C</mi></mrow><mrow><mn>57</mn></mrow></msub><msub><mrow><mi>H</mi></mrow><mrow><mn>110</mn></mrow></msub><msub><mrow><mi>O</mi></mrow><mrow><mn>6</mn></mrow></msub></math> gives <math><mo>=</mo><mn>55</mn><mi>&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi></math> of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>H</mi><mn>2</mn></msub><mi>O</mi></math><br /><br /><math><mo>&#8757;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi><mi>&#160;</mi></math> of <math><msub><mrow><mi>C</mi></mrow><mrow><mn>57</mn></mrow></msub><msub><mrow><mi>H</mi></mrow><mrow><mn>110</mn></mrow></msub><msub><mrow><mi>O</mi></mrow><mrow><mn>6</mn></mrow></msub></math> gives <math><mo>=</mo><mn>55</mn><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi></math> of <math><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>O</mi></math><br /><br />Wt. of <math><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>O</mi><mo>=</mo></math> mole of <math><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>O</mi><mo>&#215;</mo><mi>M</mi></math> Wt. of <math><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>O</mi></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn