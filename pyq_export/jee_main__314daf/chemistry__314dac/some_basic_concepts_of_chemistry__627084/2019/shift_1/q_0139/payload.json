      "text": "<math><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>4</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>10</mn></mrow></msub></math>",
      "is_correct": false
    },
    {
