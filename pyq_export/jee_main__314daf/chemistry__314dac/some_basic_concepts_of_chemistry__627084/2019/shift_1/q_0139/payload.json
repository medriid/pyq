    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>4</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>7</mn></mrow></msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">l</mi></math>",
