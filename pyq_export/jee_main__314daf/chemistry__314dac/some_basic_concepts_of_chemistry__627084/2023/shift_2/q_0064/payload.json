      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>5</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>8</mn></msub></math>",
      "is_correct": false
