  "question": {
    "text": "When a hydrocarbon <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math> undergoes complete combustion it requires <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>11</mn></math> equivalents of oxygen and produces <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> equivalents of water. What is the molecular formula of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math>?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>11</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>8</mn></msub></math>",
