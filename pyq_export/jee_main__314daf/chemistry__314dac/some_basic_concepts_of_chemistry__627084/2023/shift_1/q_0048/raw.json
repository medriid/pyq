      "isCorrect": false
    },
    {
      "id": "6i2hs",
      "text": "&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ag</mi><mo>+</mo></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">I</mi><mo>-</mo></msup></math>both",
