  "question": {
    "text": "To neutralize completely $20 \\mathrm{~mL}$ of $0.1 \\mathrm{M}$ aqueous solution of phosphorous acid $\\left(\\mathrm{H}_3 \\mathrm{PO}_3\\right)$, the volume of $0.1 \\mathrm{M}$ aqueous $\\mathrm{KOH}$ solution required is",
    "image": null
  },
  "options": [
    {
      "id": "1WuMo",
      "text": "\n$10 \\mathrm{~mL}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "auUHx",
      "text": "\n$60 \\mathrm{~mL}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WzJkD",
      "text": "\n$40 \\mathrm{~mL}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "x7u7I",
      "text": "\n$20 \\mathrm{~mL}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "No. of gm equivalents of phosphorous acid $=\\mathrm{No}$. of gm equivalents of $\\mathrm{KOH}$\n$$\n\\begin{aligned}\n& 20 \\times 0.1 \\times 2(n=\\text { factor })=0.1 \\times V \\\\\n& =0.1 \\times V\n\\end{aligned}\n$$ \n$\\mathrm{V}=\\frac{4}{0.1}=40 \\mathrm{ml}$",
    "image": null
  },
