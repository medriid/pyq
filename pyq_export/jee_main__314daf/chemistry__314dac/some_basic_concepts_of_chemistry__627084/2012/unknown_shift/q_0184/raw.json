  "question": {
    "text": "The density of a solution prepared by dissolving $120 \\mathrm{~g}$ of urea (mol. Mass $=60 \\mathrm{u}$ ) in $1000 \\mathrm{~g}$ of water is $1.15 \\mathrm{~g} / \\mathrm{mL}$. The molarity of this solution is :",
    "image": null
  },
  "options": [
    {
      "id": "T77kh",
      "text": "\n$0.50 \\mathrm{~M}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LBvtB",
      "text": "\n$1.78 \\mathrm{~M}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "y6nqV",
      "text": "\n$1.02 \\mathrm{~M}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "c8F60",
      "text": "\n$2.05 \\mathrm{~M}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Total weight of solution $=1000+120=1120 \\mathrm{~g}$\n$\\text { Molarity }=\\frac{120}{60} \\times \\frac{1000}{1120 / 1.15}=2.05 \\mathrm{~M}$",
    "image": null
  },
