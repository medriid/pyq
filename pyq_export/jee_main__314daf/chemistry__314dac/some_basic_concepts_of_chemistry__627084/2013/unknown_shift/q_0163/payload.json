  "question": {
    "text": "$10 \\mathrm{~mL}$ of $2(\\mathrm{M}) \\mathrm{~NaOH}$ solution is added to $200 \\mathrm{~mL}$ of $0.5$ $\\mathrm{(M)}$ of $\\mathrm{NaOH}$ solution. What is the final concentration ?"
  },
  "options": [
    {
      "text": "\n$0.57(\\mathrm{M})$\n",
      "is_correct": true
    },
    {
      "text": "\n$5.7(\\mathrm{M})$\n",
      "is_correct": false
    },
    {
      "text": "\n$11.4(\\mathrm{M})$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.14(\\mathrm{M})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "From molarity equation\n$\\begin{aligned}\n& \\mathrm{M}_1 \\mathrm{V}_1+\\mathrm{M}_2 \\mathrm{V}_2=\\mathrm{MV}_{\\text {(total) }} \\\\\n& 2 \\times \\frac{10}{1000}+0.5 \\times \\frac{200}{1000}=\\mathrm{M} \\times \\frac{210}{1000} \\\\\n& 120=\\mathrm{M} \\times 210 \\\\\n& \\mathrm{M}=\\frac{120}{210}=0.57 \\mathrm{~M}\n\\end{aligned}$"
  }
}