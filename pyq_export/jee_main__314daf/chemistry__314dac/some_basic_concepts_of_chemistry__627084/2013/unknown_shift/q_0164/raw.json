  "question": {
    "text": "How many grams of methyl alcohol should be added to $10$ litre tank of water to prevent its freezing at $268 \\mathrm{~K}$ ? ( $\\mathrm{K}_{\\mathrm{f}}$ for water is $1.86 \\mathrm{~K} \\mathrm{~kg}$ $\\left.\\mathrm{mol}^{-1}\\right)$",
    "image": null
  },
  "options": [
    {
      "id": "vlan5",
      "text": "\n$880.07 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "i3TpR",
      "text": "\n$899.04 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wJ38e",
      "text": "\n$886.02 \\mathrm{~g}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZCaC5",
      "text": "\n$868.06 \\mathrm{~g}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\mathrm{T}_f=\\mathrm{K}_f m$\nwhere $m=$ molality\n$273-268=1.86 \\times \\frac{w}{M \\times V}$\n$5=1.86 \\times \\frac{w}{32 \\times 10}$\n$w=\\frac{5 \\times 32 \\times 10}{1.86}$\n$=860.2 \\approx 868.06 \\mathrm{~g}$",
    "image": null
  },
