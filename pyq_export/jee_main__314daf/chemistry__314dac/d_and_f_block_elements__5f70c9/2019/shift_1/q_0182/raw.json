  "question": {
    "text": "The lanthanide ion that would show colour is:",
    "image": null
  },
  "options": [
    {
      "id": "wAZwk",
      "text": "<math><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">L</mi><msup><mrow><mi mathvariant=\"normal\">u</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "isCorrect": false,
