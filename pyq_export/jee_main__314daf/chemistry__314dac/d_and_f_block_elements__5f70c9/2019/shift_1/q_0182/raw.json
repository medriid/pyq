    },
    {
      "id": "ZY5ji",
      "text": "<math><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">L</mi><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "bWbf2",
      "text": "<math><mi mathvariant=\"normal\">G</mi><msup><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
