    },
    {
      "id": "SluBn",
      "text": "<math><mi mathvariant=\"normal\">S</mi><msup><mrow><mi mathvariant=\"normal\">m</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "isCorrect": true,
