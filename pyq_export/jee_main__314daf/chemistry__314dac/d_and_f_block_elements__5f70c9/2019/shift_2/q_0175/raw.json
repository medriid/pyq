  "question": {
    "text": "The transition elements that has the lowest enthalpy of atomisation is:",
    "image": null
  },
  "options": [
    {
      "id": "3qz5I",
      "text": "<math><mi>V</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "HXsuU",
      "text": "<math><mi>F</mi><mi>e</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "AEAzB",
      "text": "<math><mi>Z</mi><mi>n</mi></math>",
