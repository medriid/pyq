  "question": {
    "text": "Prolonged heating is avoided during the preparation of ferrous ammonium sulphate to",
    "image": null
  },
  "options": [
    {
      "id": "JXA9B",
      "text": "Prevent hydrolysis",
      "image": null,
      "isCorrect": false
    },
    {
