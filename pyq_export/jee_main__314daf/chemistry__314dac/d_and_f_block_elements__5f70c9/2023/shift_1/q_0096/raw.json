      "isCorrect": true,
      "image": null
    },
    {
      "id": "1Qd0m",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">V</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi mathvariant=\"normal\">V</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>5</mn></msub><mo>&#62;</mo><msub><mi mathvariant=\"normal\">V</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>4</mn></msub></math>",
      "isCorrect": false,
