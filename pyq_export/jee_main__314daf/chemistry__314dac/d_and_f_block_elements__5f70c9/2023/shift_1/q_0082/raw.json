  "question": {
    "text": "<p>The pair of lanthanides in which both elements have high third-ionization energy is:</p>",
    "image": null
  },
  "options": [
    {
      "id": "uDh0y",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Dy</mi><mo>,</mo><mi>Gd</mi></math>",
