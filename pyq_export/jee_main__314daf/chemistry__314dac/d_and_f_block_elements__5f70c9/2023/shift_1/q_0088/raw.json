      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi>Fe</mi><mo>&#160;</mo><mo>(</mo><mi>III</mi><mo>)</mo></math>",
      "image": null,
