  "question": {
    "text": "In chromyl chloride, the number of d-electrons present on chromium is same as in (Given at no. of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Ti</mi><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>22</mn><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">V</mi><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>23</mn><mo>,</mo><mo>&#160;</mo><mi>Cr</mi><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>24</mn><mo>,</mo><mo>&#160;</mo><mi>Mn</mi><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>25</mn><mo>,</mo><mo>&#160;</mo><mi>Fe</mi><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>26</mn></math>)",
    "image": null
  },
  "options": [
    {
      "id": "1B4OC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">V</mi><mo>&#160;</mo><mo>(</mo><mi>IV</mi><mo>)</mo></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zgZI7",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi>Mn</mi><mo>&#160;</mo><mo>(</mo><mi>VII</mi><mo>)</mo></math>",
      "image": null,
