  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "<p>Which of the following elements have half-filled f-orbitals in their ground state ?<br />(Given : atomic number <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Sm</mi><mo>-</mo><mn>62</mn><mo>;</mo><mi>Eu</mi><mo>=</mo><mn>63</mn><mo>;</mo><mi>Tb</mi><mo>=</mo><mn>65</mn><mo>;</mo><mi>Gd</mi><mo>=</mo><mn>64</mn><mo>,</mo><mi>Pm</mi><mo>=</mo><mn>61</mn></math>)</p><p>Choose the correct answer from the options given below :</p>",
    "image": null
  },
  "options": [
    {
      "id": "F5nDl",
      "text": "A and B only",
      "isCorrect": false,
      "image": null
    },
    {
