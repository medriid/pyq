  "question": {
    "text": "The radius of $\\mathrm{La}^{3+}$ (Atomic number of $\\mathrm{La}=57$ ) is $1.06 Å$. Which one of the following given values will be closest to the radius of $\\mathrm{Lu}^{3+}$ (Atomic number of $\\mathrm{Lu}=71$ )?",
    "image": null
  },
  "options": [
    {
      "id": "1zPhC",
      "text": "\n$1.40 Å$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4TSZD",
      "text": "\n$1.06 Å$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7BmXH",
      "text": "\n$0.85 Å$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ThPPH",
      "text": "\n$1.60 Å$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Omega \\propto \\frac{1}{\\mathrm{Z}}$\n$\\frac{\\Omega_1}{\\Omega_2}=\\frac{z_2}{z_1} \\Rightarrow \\frac{1.06}{\\Omega_2}=\\frac{71}{57} \\Rightarrow \\Omega_2=0.85 Å$",
    "image": null
  },
