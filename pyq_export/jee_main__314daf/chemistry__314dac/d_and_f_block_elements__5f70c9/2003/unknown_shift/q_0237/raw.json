      "text": "\n$\\mathrm{HgO}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "e2wyz",
      "text": "\n$\\mathrm{Pb}_3 \\mathrm{O}_4$\n",
      "image": null,
      "isCorrect": false
    },
