  "question": {
    "text": "What would happen when a solution of potassium chromate is treated with an excess of dilute nitric acid?",
    "image": null
  },
  "options": [
    {
      "id": "MXQwU",
      "text": "\n$\\mathrm{Cr}_2 \\mathrm{O}_7^{2-}$ and $\\mathrm{H}_2 \\mathrm{O}$ are formed\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Sm2Tw",
      "text": "\n$\\mathrm{CrO}^{2-}{ }_4$ is reduced to $+3$ state of $\\mathrm{Cr}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "j8AHG",
      "text": "\n$\\mathrm{CrO}_4^{2-}$ is oxidized to $+7$ state of $\\mathrm{Cr}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yNyCg",
      "text": "\n$\\mathrm{Cr}^{3+}$ and $\\mathrm{Cr}_2 \\mathrm{O}^{2-}{ }_7$ are formed",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Cr}_2 \\mathrm{O}_7^{2-}+\\mathrm{OH}^{-} \\rightarrow 2 \\mathrm{CrO}_4^{2-}+\\mathrm{H}^{+}$. The above equilibrium shifts to L.H.S. on addition of acid.",
    "image": null
