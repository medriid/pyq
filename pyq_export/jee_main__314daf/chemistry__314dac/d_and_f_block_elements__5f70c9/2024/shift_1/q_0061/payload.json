  "question": {
    "text": "Diamagnetic Lanthanoid ions are:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Nd</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Eu</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>La</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ce</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Nd</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ce</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Lu</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Eu</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
