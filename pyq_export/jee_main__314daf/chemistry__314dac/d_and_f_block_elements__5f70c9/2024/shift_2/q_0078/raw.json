  "question": {
    "text": "Choose the correct option having all the elements with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">d</mi><mn>10</mn></msup></math> electronic configuration from the following:",
