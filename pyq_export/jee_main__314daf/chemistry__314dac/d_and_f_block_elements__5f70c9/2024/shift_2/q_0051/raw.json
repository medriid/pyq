  "question": {
    "text": "The number of ions from the following that have the ability to liberate hydrogen from a dilute acid is _____.\n\\(\\mathrm{Ti}^{2+}, \\mathrm{Cr}^{2+}\\) and \\(\\mathrm{V}^{2+}\\)",
    "image": null
  },
  "options": [
    {
      "id": "FCNEv",
      "text": "2",
      "image": null,
      "isCorrect": false
