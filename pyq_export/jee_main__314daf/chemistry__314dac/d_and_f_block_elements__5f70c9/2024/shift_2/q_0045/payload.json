  "question": {
    "text": "When \\(\\mathrm{MnO}_2\\) and \\(\\mathrm{H}_2 \\mathrm{SO}_4\\) is added to a salt (A), the greenish yellow gas liberated as salt (A) is :"
  },
  "options": [
    {
      "text": "\\(\\mathrm{CaI}_2\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{NaBr}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{KNO}_3\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{NH}_4 \\mathrm{Cl}\\)",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & 2 \\mathrm{NH}_4 \\mathrm{Cl}+\\mathrm{MnO}_2+2 \\mathrm{H}_2 \\mathrm{SO}_4 \\xrightarrow{\\Delta} \\mathrm{MnSO}_4 \\\\ & +\\left(\\mathrm{NH}_4\\right)_2 \\mathrm{SO}_4+2 \\mathrm{H}_2 \\mathrm{O}+\\underset{\\substack{\\text { greenish } \\\\ \\text { yellow } \\\\ \\text { solution }}}{\\mathrm{Cl}_2 \\uparrow}\\end{aligned}$"
  }
