  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{ll} \n\\text{Unpaired electron} \\\\\n\\operatorname{Sc}[\\mathrm{Ar}] 4 \\mathrm{~s}^2 3 \\mathrm{~d}^1 & 1 \\\\\n\\mathrm{Cr}[\\mathrm{Ar}] 4 \\mathrm{~s}^1 3 \\mathrm{~d}^5 & 6 \\\\\n\\mathrm{V}[\\mathrm{Ar}] 4 \\mathrm{~s}^2 3 \\mathrm{~d}^3 & 3 \\\\\n\\mathrm{Ti}:[\\mathrm{Ar}] 4 \\mathrm{~s}^2 3 \\mathrm{~d}^2 & 2 \\\\\n\\mathrm{Mn}:[\\mathrm{Ar}] 4 \\mathrm{~s}^2 3 \\mathrm{~d}^5 & 5\n\\end{array}$",
