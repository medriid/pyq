  "question": {
    "text": "Magnetic moment of $\\mathrm{Gd}^{3+}$ ion $(\\mathrm{Z}=64)$ is"
  },
  "options": [
    {
      "text": "\n3.62 BM\n",
      "is_correct": false
    },
    {
      "text": "\n$9.72 \\mathrm{BM}$\n",
      "is_correct": false
    },
    {
      "text": "\n7.9 BM\n",
      "is_correct": true
    },
    {
      "text": "\n$10.60 \\mathrm{BM}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{Gd}(64)=[\\mathrm{Xe}] 4 f^7 5 d^1 6 s^2$\n$\\mathrm{Gd}^{3+}=[\\mathrm{Xe}] 4 f^7 5 d^0 6 s^0$\ni.e. no. of unpaired electrons $=7$\n$$\n\\begin{aligned}\n\\mu & =\\sqrt{n(n+2)}=\\sqrt{7(7+2)} \\\\\n& =\\sqrt{63}=7.93 \\mathrm{BM}\n\\end{aligned}\n$$"
  }
