  "question": {
    "text": "The $d$-electron configurations of $\\mathrm{Cr}^{2+}, \\mathrm{Mn}^{2+}, \\mathrm{Fe}^{2+}$ and $\\mathrm{Co}^{2+}$ are $d^4, d^5, d^6$ and $d^7$ respectively. Which one of the following will exhibit the lowest paramagnetic behaviour?\n(Atomic no. $\\mathrm{Cr}=24, \\mathrm{Mn}=25, \\mathrm{Fe}=26, \\mathrm{Co}=27$ ).",
    "image": null
  },
  "options": [
    {
      "id": "dpdYj",
      "text": "\n$\\left[\\mathrm{Co}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5evyW",
      "text": "\n$\\left[\\mathrm{Cr}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0leWl",
      "text": "\n$\\left[\\mathrm{Mn}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "osfw7",
      "text": "\n$\\left[\\mathrm{Fe}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{cc}\\text { electronic } & \\text { no. of unpaired } \\\\ \\text { configuration } & \\text { electrons }\\end{array}$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/8qlCO17NaaL2cx5_1gDRyYqT45Eu0s0WOC7hw5Lpwyo.original.fullsize.png\"><br>\n$\\therefore \\quad$ Since $\\mathrm{Co}^{2+}$ has lowest no. of unpaired electrons hence lowest paramagnetic behaviour is shown by $\\left[\\mathrm{Co}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$",
    "image": null
  },
