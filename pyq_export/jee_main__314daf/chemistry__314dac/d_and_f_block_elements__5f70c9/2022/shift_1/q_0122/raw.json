  "question": {
    "text": "<p>The number of terminal oxygen atoms present in the product <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math> obtained from the following reaction is</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>FeCr</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>4</mn></msub><mo>+</mo><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>CO</mi><mn>3</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub><mo>&#8594;</mo><mi mathvariant=\"normal\">A</mi><mo>+</mo><msub><mi>Fe</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub><mo>+</mo><msub><mi>CO</mi><mn>2</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>+</mo><msup><mi mathvariant=\"normal\">H</mi><mo>+</mo></msup><mo>&#8594;</mo><mi mathvariant=\"normal\">B</mi><mo>+</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi><mo>+</mo><msup><mi>Na</mi><mo>+</mo></msup></math></p>",
    "image": null
  },
  "options": [],
  "correctValue": "6",
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msub><mi>FeCr</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>4</mn></msub><mo>+</mo><mn>8</mn><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>CO</mi><mn>3</mn></msub><mo>+</mo><mn>7</mn><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub><mo>&#8594;</mo><mn>8</mn><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>CrO</mi><mn>4</mn></msub><mo>+</mo><mn>2</mn><msub><mi>Fe</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub><mo>+</mo><mn>8</mn><msub><mi>CO</mi><mn>2</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>CrO</mi><mn>4</mn></msub><mo>+</mo><mn>2</mn><msup><mi mathvariant=\"normal\">H</mi><mo>+</mo></msup><mo>&#8594;</mo><munder><munder><mrow><msub><mi>Na</mi><mn>2</mn></msub><msub><mi>Cr</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>7</mn></msub></mrow><mo>&#9183;</mo></munder><mi mathvariant=\"normal\">B</mi></munder><mo>+</mo><mn>2</mn><msup><mi>Na</mi><mo>+</mo></msup><mo>+</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/8ed9cb60-2c33-449f-91b1-963fc877d1d2-image.png\" style=\"width: 200px; height: 82px;\" /></p>",
