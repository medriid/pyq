  "question": {
    "text": "In following pairs, the one in which both transition metal ions are colourless is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Sc</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup><mo>,</mo><msup><mi>Zn</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ti</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup><mo>,</mo><msup><mi>Cu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">V</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>,</mo><msup><mi>Ti</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Zn</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>,</mo><msup><mi>Mn</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
