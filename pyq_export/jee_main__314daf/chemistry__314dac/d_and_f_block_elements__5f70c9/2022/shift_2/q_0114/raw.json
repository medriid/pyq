    "text": "<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 100%;\">\t<tbody>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><strong>Ion</strong></td>\t\t\t<td style=\"text-align: center;\"><strong>Electronic configuration</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Eu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi mathvariant=\"normal\">f</mi><mn>7</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tm</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi mathvariant=\"normal\">f</mi><mn>13</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Sm</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi mathvariant=\"normal\">f</mi><mn>6</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tm</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi mathvariant=\"normal\">f</mi><mn>12</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tb</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td style=\"text-align: center;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi mathvariant=\"normal\">f</mi><mn>7</mn></msup></math></td>\t\t</tr