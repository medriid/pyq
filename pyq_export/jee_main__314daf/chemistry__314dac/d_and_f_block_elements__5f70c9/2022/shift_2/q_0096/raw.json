  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "Which of the following <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi mathvariant=\"normal\">d</mi><mo>-</mo><mi>metal</mi></math> ion will give the lowest enthalpy of hydration <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msub><mi mathvariant=\"normal\">&#916;</mi><mi>hyd</mi></msub><mi mathvariant=\"normal\">H</mi></mrow></mfenced></math> when dissolved in water?",
    "image": null
  },
