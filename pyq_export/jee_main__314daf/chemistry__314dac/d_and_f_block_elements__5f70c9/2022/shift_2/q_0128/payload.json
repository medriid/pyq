      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Gd</mi><mfenced><mrow><mi>At</mi><mo>.</mo><mo>&#160;</mo><mi>No</mi><mo>,</mo><mn>64</mn></mrow></mfenced></math>",
