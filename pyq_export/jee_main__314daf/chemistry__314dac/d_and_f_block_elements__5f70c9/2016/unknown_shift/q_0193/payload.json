  "question": {
    "text": "Which of the following are the transition metal ions responsible for colour in ruby and emerald respectively?"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">o</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>  and  <math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">o</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>  and  <math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">o</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>  and  <math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ag</mi><mo>+</mo></msup></math>",
