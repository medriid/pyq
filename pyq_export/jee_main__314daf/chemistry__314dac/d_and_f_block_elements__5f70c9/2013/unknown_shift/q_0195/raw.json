  "question": {
    "text": "When a small amount of $\\mathrm{KMnO}_4$ is added to concentrated $\\mathrm{H}_2 \\mathrm{SO}_4$, a green oily compound is obtained which is highly explosive in nature. Compound may be :",
    "image": null
  },
  "options": [
    {
      "id": "vWXRI",
      "text": "\n$\\mathrm{MnSO}_4$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "IVm4s",
      "text": "\n$\\mathrm{Mn}_2 \\mathrm{O}_7$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "aWmaG",
      "text": "\n$\\mathrm{MnO}_2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hNxPR",
      "text": "\n$\\mathrm{Mn}_2 \\mathrm{O}_3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{KMnO}_4$ reacts with $\\mathrm{H}_2 \\mathrm{SO}_4$ to form $\\mathrm{Mn}_2 \\mathrm{O}_7$ which is highly explosive substance.\n$$\n2 \\mathrm{KMnO}_4+\\mathrm{H}_2 \\mathrm{SO}_4 \\underset{\\mathrm{K}_2 \\mathrm{SO}_4}{\\longrightarrow}+\\mathrm{Mn}_2 \\mathrm{O}_7+\\mathrm{H}_2 \\mathrm{O}\n$$",
    "image": null
  },
