  "question": {
    "text": "Potassium dichromate when heated with concentrated sulphuric acid and a soluble chloride, gives brown-red vapours of :",
    "image": null
  },
  "options": [
    {
      "id": "r44ye",
      "text": "\n$\\mathrm{CrO}_3$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QUq6z",
      "text": "\n$\\mathrm{CrCl}_3$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tU1Mg",
      "text": "\n$\\mathrm{CrO}_2 \\mathrm{Cl}_2$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "a7Tbd",
      "text": "\n$\\mathrm{Cr}_2 \\mathrm{O}_3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Solid potassium dichromate when heated with concentrated sulphuric acid and a soluble chloride gives orange red vapours of a volatile oily liquid $\\mathrm{CrO}_2 \\mathrm{Cl}_2$\n$\\mathrm{K}_2 \\mathrm{Cr}_2 \\mathrm{O}_7+4 \\mathrm{NaCl}+6 \\mathrm{H}_2 \\mathrm{SO}_4\\longrightarrow 2 \\mathrm{KHSO}_4+4 \\mathrm{NaHSO}_4+2 \\mathrm{CrO}_2 \\mathrm{Cl}_2$ chromyl chloride",
    "image": null
  },
