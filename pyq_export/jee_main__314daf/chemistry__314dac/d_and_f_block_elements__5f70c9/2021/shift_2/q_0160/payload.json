  "question": {
    "text": "The incorrect statement among the following is:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Cr</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>3</mn></msub></math> is an amphoteric oxide",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>VOSO</mi><mn>4</mn></msub></math> is a reducing agent",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>RuO</mi><mn>4</mn></msub></math> is an oxidizing agent",
      "is_correct": false
