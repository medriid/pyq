      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ni</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup><mtext>&#160;and&#160;</mtext><msup><mi>Cu</mi><mo>+</mo></msup></math>",
