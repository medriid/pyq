  "question": {
    "text": "The molar mass of the water insoluble product formed from the fusion of chromite ore \\(\\left(\\mathrm{FeCr}_2 \\mathrm{O}_4\\right)\\) with \\(\\mathrm{Na}_2 \\mathrm{CO}_3\\) in presence of \\(\\mathrm{O}_2\\) is _______ \\(\\mathrm{g} \\mathrm{mol}^{-1}\\).",
    "image": null
  },
  "options": [],
  "correctValue": "160",
  "solution": {
    "text": "$\\mathrm{FeCr}_2 \\mathrm{O}_4+\\mathrm{Na}_2 \\mathrm{CO}_3+\\mathrm{O}_2 \\rightarrow \\mathrm{Na}_2 \\mathrm{CrO}_4+\\mathrm{Fe}_2 \\mathrm{O}_3+\\mathrm{CO}_2$\nInsoluble product will be $\\mathrm{Fe}_2 \\mathrm{O}_3$\nmolar mass $=56 \\times 2+16 \\times 3$\n$\\begin{aligned}\n& =112+48 \\\\\n& =160\n\\end{aligned}$",
    "image": null
  },
