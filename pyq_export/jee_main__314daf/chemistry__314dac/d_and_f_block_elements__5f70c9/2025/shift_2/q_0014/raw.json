  "question": {
    "text": "The amphoteric oxide among $\\mathrm{V}_2 \\mathrm{O}_3, \\mathrm{~V}_2 \\mathrm{O}_4$ and $\\mathrm{V}_2 \\mathrm{O}_5$, upon reaction with alkali leads to formation of an oxide anion. The oxidation state of V in the oxide anion is :",
    "image": null
  },
  "options": [
    {
      "id": "F9s64",
      "text": "$+3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5Yvx3",
      "text": "$+4$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YGwyl",
      "text": "$+7$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4FEbE",
      "text": "$+5$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{V}_2 \\mathrm{O}_5$ is amphoteric oxide.\n$\\mathrm{V}_2 \\mathrm{O}_5$ gives $\\mathrm{VO}_4{ }^{3-}$ on reaction with alkali oxidation state of V in $\\mathrm{VO}_4{ }^{3-}=+5$",
    "image": null
  },
