  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{CrO}_3=\\text { Acidic } \\\\ & \\mathrm{Mn}_2 \\mathrm{O}_7=\\text { Acidic } \\\\ & \\therefore \\mathrm{x}=2\\end{aligned}$<br /><img src=\"assets\\st0001_b39e75bf8f95.png\"/><br />$\\begin{aligned} & \\therefore \\text { Primary valency }=3 \\\\ & \\therefore \\mathrm{x}+\\mathrm{y}=5\\end{aligned}$"
  }
