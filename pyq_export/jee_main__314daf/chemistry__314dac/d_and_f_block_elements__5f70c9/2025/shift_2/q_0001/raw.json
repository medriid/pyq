  "question": {
    "text": "' X ' is the number of acidic oxides among $\\mathrm{VO}_2$, $\\mathrm{V}_2 \\mathrm{O}_3, \\mathrm{CrO}_3, \\mathrm{~V}_2 \\mathrm{O}_5$ and $\\mathrm{Mn}_2 \\mathrm{O}_7$. The primary valency of cobalt in $\\left[\\mathrm{Co}\\left(\\mathrm{H}_2 \\mathrm{NCH}_2 \\mathrm{CH}_2 \\mathrm{NH}_2\\right)_3\\right]_2\\left(\\mathrm{SO}_4\\right)_3$ is Y. The value of $\\mathrm{X}+\\mathrm{Y}$ is :",
    "image": null
  },
  "options": [
    {
      "id": "zN9gS",
      "text": "5",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iuLvs",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5JsTC",
      "text": "2",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6r4sc",
      "text": "3",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{CrO}_3=\\text { Acidic } \\\\ & \\mathrm{Mn}_2 \\mathrm{O}_7=\\text { Acidic } \\\\ & \\therefore \\mathrm{x}=2\\end{aligned}$<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/4UfYDSFQc7VsSu81z5Ei19TfUGEZL_3IuzodFvESVJw.original.fullsize.png\"/><br />$\\begin{aligned} & \\therefore \\text { Primary valency }=3 \\\\ & \\therefore \\mathrm{x}+\\mathrm{y}=5\\end{aligned}$",
    "image": null
  },
