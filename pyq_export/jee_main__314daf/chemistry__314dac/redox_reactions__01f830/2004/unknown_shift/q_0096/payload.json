  "question": {
    "text": "Excess of $\\mathrm{KI}$ reacts with $\\mathrm{CuSO}_4$ solution and then $\\mathrm{Na}_2 \\mathrm{~S}_2 \\mathrm{O}_3$ solution is added to it. Which of the statements is incorrect for this reaction?"
  },
  "options": [
    {
      "text": "\n$\\mathrm{Cu}_2 \\mathrm{I}_2$ is reduced\n",
      "is_correct": false
    },
    {
      "text": "\nEvolved $\\mathrm{I}_2$ is reduced\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{Na}_2 \\mathrm{~S}_2 \\mathrm{O}_3$ is oxidized\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{Cul}_2$ is formed",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$2 \\mathrm{CuSO}_4+4 \\mathrm{KI}$ (excess) $\\longrightarrow 2 \\mathrm{~K}_2 \\mathrm{SO}_4+\\mathrm{Cu}_2 \\mathrm{I}_2+\\mathrm{I}_2 \\uparrow$\n$\\mathrm{Na}_2 \\mathrm{~S}_2 \\mathrm{O}_3+\\mathrm{I}_2 \\longrightarrow \\mathrm{Na}_2 \\mathrm{~S}_4 \\mathrm{O}_6+2 \\mathrm{Nal}$"
  }
