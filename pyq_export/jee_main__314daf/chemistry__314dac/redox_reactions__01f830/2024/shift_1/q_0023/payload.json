  "question": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>KMnO</mi><mn>4</mn></msub></math> decomposes on heating at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>513</mn><mo> </mo><mi mathvariant=\"normal\">K</mi></math> to form <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math> along with"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>MnO</mi><mn>2</mn></msub><mo>&amp;</mo><mo> </mo><msub><mi mathvariant=\"normal\">K</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math>",
