  "question": {
    "text": "Which of the following cannot function as an oxidising agent?",
    "image": null
  },
  "options": [
    {
      "id": "CDnyp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">N</mi><mrow><mn>3</mn><mo>-</mo></mrow></msup></math>",
