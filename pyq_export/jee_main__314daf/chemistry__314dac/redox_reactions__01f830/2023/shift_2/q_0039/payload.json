  "question": {
    "text": "Choose the correct representation of conductometric titration of benzoic acid vs sodium hydroxide."
  },
  "options": [
    {
      "text": "<img alt=\"\" src=\"assets\\ot1_0039_25c8787aa889.png\" style=\"width: 166px; height: 150px;\" />",
