  "question": {
    "text": "The species which does not undergo disproportionation reaction is :",
    "image": null
  },
  "options": [
    {
      "id": "53ecA",
      "text": "$\\mathrm{ClO}_3^{-}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jDzdn",
      "text": "$\\mathrm{ClO}^{-}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jPhmE",
      "text": "$\\mathrm{ClO}_2^{-}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "h9dwr",
      "text": "$\\mathrm{ClO}_4^{-}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{ClO}_4^{-} \\rightarrow x+\\{(-2) \\times 4\\}=-1 \\Rightarrow x=+7$\n\nChlorine is in its maximum oxidation state, so disproportionation not possible in $\\mathrm{ClO}_4^{-}$.",
    "image": null
  },
