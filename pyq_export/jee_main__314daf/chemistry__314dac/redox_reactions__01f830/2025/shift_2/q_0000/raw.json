      "id": "guKAa",
      "text": "A, C and D Only",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The primary standard is a highly pure stable compound with a known exact composition that can be accurately weighed and dissolved to creat a solution of known concentration.<br />NaOH is hygroscopic and can't be used.<br />$\\mathrm{FeSO}_4 \\cdot 6 \\mathrm{H}_2 \\mathrm{O}$ is unstable and can be easily oxidised.<br />$\\mathrm{Na}_2 \\mathrm{Cr}_2 \\mathrm{O}_7$ is hygroscopic and can't be used.",
    "image": null
