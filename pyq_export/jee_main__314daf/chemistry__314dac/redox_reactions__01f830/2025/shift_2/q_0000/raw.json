  "question": {
    "text": "Compounds that should not be used as primary standards in titrimetric analysis are :<br />A. $\\mathrm{Na}_2 \\mathrm{Cr}_2 \\mathrm{O}_7$<br />B. Oxalic acid<br />C. NaOH<br />D. $\\mathrm{FeSO}_4 \\cdot 6 \\mathrm{H}_2 \\mathrm{O}$<br />E. Sodium tetraborate<br />Choose the most appropriate answer from the options given below:",
    "image": null
  },
  "options": [
    {
      "id": "kttGY",
      "text": "B and D Only",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2ulNI",
      "text": "D and E Only",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XzsO8",
      "text": "C, D and E Only",
      "image": null,
      "isCorrect": false
    },
