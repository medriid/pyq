  "question": {
    "text": "The species which does not undergo disproportionation reaction is :"
  },
  "options": [
    {
      "text": "$\\mathrm{ClO}_3^{-}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{ClO}^{-}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{ClO}_2^{-}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{ClO}_4^{-}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{ClO}_4^{-} \\rightarrow x+\\{(-2) \\times 4\\}=-1 \\Rightarrow x=+7$\n\nChlorine is in its maximum oxidation state, so disproportionation not possible in $\\mathrm{ClO}_4^{-}$."
  }
