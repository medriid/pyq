  "question": {
    "text": "The number of radial node/s for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi mathvariant=\"normal\">p</mi></math> orbital is:",
    "image": null
  },
  "options": [
    {
      "id": "n3IkT",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
