  "question": {
    "text": "The correct set of four quantum numbers for the valence electron of rubidium atom <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>Z</mi><mo> </mo><mo>=</mo><mo> </mo><mn>37</mn><mo>)</mo></math> is:",
    "image": null
  },
  "options": [
    {
      "id": "srbAN",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math>",
