  "question": {
    "text": "According to the wave-particle duality of matter by de-Broglie, which of the following graph plot presents most appropriate relationship between wavelength of electron <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">λ</mi></mfenced></math> and momentum of electron <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">p</mi></mfenced><mo>?</mo></math>",
    "image": null
  },
