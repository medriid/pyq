  "question": {
    "text": "Consider the ground state of chromium atom $(\\mathrm{Z}=24)$. How many electrons are with Azimuthal quantum number $l=1$ and $l=2$ respectively ?",
    "image": null
  },
  "options": [
    {
      "id": "Eyezo",
      "text": "12 and 4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BnKCo",
      "text": "16 and 4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qgTGb",
      "text": "12 and 5",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9Vske",
      "text": "16 and 5",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{Cr}: 1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^6 3 \\mathrm{~s}^2 3 \\mathrm{p}^6 3 \\mathrm{~d}^5 4 \\mathrm{~s}^1 \\\\ & \\ell=1 \\quad \\ell=1 \\quad \\ell=2 \\\\ & \\text { electrons having } \\ell=1 \\Rightarrow 12 \\\\ & \\text { electrons having } \\ell=2 \\Rightarrow 5\\end{aligned}$",
    "image": null
