  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{Cr}: 1 \\mathrm{~s}^2 2 \\mathrm{~s}^2 2 \\mathrm{p}^6 3 \\mathrm{~s}^2 3 \\mathrm{p}^6 3 \\mathrm{~d}^5 4 \\mathrm{~s}^1 \\\\ & \\ell=1 \\quad \\ell=1 \\quad \\ell=2 \\\\ & \\text { electrons having } \\ell=1 \\Rightarrow 12 \\\\ & \\text { electrons having } \\ell=2 \\Rightarrow 5\\end{aligned}$"
