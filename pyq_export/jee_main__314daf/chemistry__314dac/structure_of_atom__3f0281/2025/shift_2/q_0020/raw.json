  "question": {
    "text": "For electron in ' 2 s ' and ' 2 p ' orbitals, the orbital angular momentum values, respectively are :",
    "image": null
  },
  "options": [
    {
      "id": "arjnY",
      "text": "$\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}$ and 0",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kCsjW",
      "text": "$\\frac{\\mathrm{h}}{2 \\pi}$ and $\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fpB3s",
      "text": "0 and $\\sqrt{6} \\frac{\\mathrm{~h}}{2 \\pi}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7zE0K",
      "text": "0 and $\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Orbital angular momentum }=\\sqrt{\\ell(\\ell+1)} \\frac{\\mathrm{h}}{2 \\pi} \\\\ & \\therefore \\quad \\text { For } 2 \\mathrm{~s} \\text { orbital }: \\ell=0 \\\\ & \\text { Orbital angular momentum }=0 \\\\ & \\therefore \\quad \\text { For } 2 \\mathrm{p} \\text { orbital }: \\ell=1 \\\\ & \\quad \\begin{aligned} \\text { Orbital angular momentum } & =\\sqrt{1(1+2)} \\frac{\\mathrm{h}}{2 \\pi} \\\\ & =\\sqrt{2} \\frac{\\mathrm{~h}}{2 \\pi}\\end{aligned}\\end{aligned}$",
    "image": null
  },
