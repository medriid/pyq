  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{r}=\\mathrm{a}_0\\left(\\frac{\\mathrm{n}^2}{\\mathrm{z}}\\right) \\\\ & \\mathrm{r}=\\frac{\\mathrm{a}_0(2)^2}{(2)} \\\\ & \\mathrm{r}=2 \\mathrm{a}_0\\end{aligned}$",
    "image": null
