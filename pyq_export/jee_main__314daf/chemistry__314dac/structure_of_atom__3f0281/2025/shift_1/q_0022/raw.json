  "question": {
    "text": "Radius of the first excited state of Helium ion is given as : $\\mathrm{a}_0 \\rightarrow$ radius of first stationary state of hydrogen atom.",
    "image": null
  },
  "options": [
    {
      "id": "Y1WMR",
      "text": "$\\mathrm{r}=4 \\mathrm{a}_0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sC84r",
      "text": "$\\mathrm{r}=2 \\mathrm{a}_0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1SI69",
      "text": "$r=\\frac{a_0}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kTxH5",
      "text": "$r=\\frac{a_0}{4}$",
      "image": null,
      "isCorrect": false
