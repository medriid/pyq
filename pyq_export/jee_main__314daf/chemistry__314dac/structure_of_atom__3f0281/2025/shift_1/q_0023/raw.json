  "question": {
    "text": "According to Bohr's model of hydrogen atom, which of the following statement is incorrect?",
    "image": null
  },
  "options": [
    {
      "id": "PH10I",
      "text": "Radius of \\(3^{\\text {rd }}\\) orbit is nine times larger than that of \\(1^{\\text {st }}\\) orbit.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1pwan",
      "text": "Radius of \\(8^{\\text {th }}\\) orbit is four times larger than that of \\(4^{\\text {th }}\\) orbit.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1SAAC",
      "text": "Radius of \\(6^{\\text {th }}\\) orbit is three time larger than that of \\(4^{\\text {th }}\\) orbit.",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fD7I0",
      "text": "Radius of \\(4^{\\text {th }}\\) orbit is four times larger than that of \\(2^{\\text {nd }}\\) orbit.",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\mathrm{r} \\propto \\mathrm{n}^2\\)<br />(1) \\(\\frac{\\mathrm{r}_3}{\\mathrm{r}_1}=\\frac{9}{1}\\)<br />(2) \\(\\frac{\\mathrm{r}_8}{\\mathrm{r}_4}=\\frac{64}{16}=4\\)<br />(3) \\(\\frac{\\mathrm{r}_6}{\\mathrm{r}_4}=\\left(\\frac{6}{4}\\right)^2=\\frac{9}{4}\\)<br />(4) \\(\\frac{\\mathrm{r}_4}{\\mathrm{r}_2}=\\left(\\frac{4}{2}\\right)^2=4\\)",
    "image": null
  },
