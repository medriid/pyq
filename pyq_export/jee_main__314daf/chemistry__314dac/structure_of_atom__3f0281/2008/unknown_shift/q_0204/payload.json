  "question": {
    "text": "The ionization enthalpy of hydrogen atom is $1.312 \\times 10^6 \\mathrm{Jmol}^{-1}$. The energy required to excite the electron in the atom from $n=1$ to $n=2$ is"
  },
  "options": [
    {
      "text": "\n$8.51 \\times 10^5 \\mathrm{Jmol}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$6.56 \\times 10^5 \\mathrm{Jmol}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$7.56 \\times 10^5 \\mathrm{Jmol}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$9.84 \\times 10^5 \\mathrm{Jmol}^{-1}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\Delta \\mathrm{E}=\\mathrm{E}_2-\\mathrm{E}_1=-\\frac{1.312 \\times 10^6}{2^2}-\\left(-\\frac{1.312 \\times 10^6}{1}\\right) \\\\\n& =9.84 \\times 10^5 \\mathrm{~J} \\mathrm{~mol}^{-1}\n\\end{aligned}\n$$"
  }
}