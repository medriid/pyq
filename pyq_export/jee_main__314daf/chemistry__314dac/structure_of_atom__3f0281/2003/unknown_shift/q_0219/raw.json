  "question": {
    "text": "The de Broglie wavelength of a tennis ball of mass $60 \\mathrm{~g}$ moving with a velocity of 10 metres per second is approximately",
    "image": null
  },
  "options": [
    {
      "id": "Zziqt",
      "text": "\n$10^{-31}$ metres\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "usCb1",
      "text": "\n$10^{-16}$ metres\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7gkun",
      "text": "\n$10^{-25}$ metres\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NpC6B",
      "text": "\n$10^{-33}$ metres Planck's constant, $\\mathrm{h}=6.63 \\times 10^{-34} \\mathrm{Js}$.",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\lambda=\\frac{\\mathrm{h}}{\\mathrm{mv}}=\\frac{6.6 \\times 10^{-34}}{60 \\times 10^{-3} \\times 10}=10^{-33} \\mathrm{~m}$",
    "image": null
  },
