  "question": {
    "text": "The orbital angular momentum for an electron revolving in an orbit is given by $\\sqrt{l(l+1)} \\cdot \\frac{\\mathrm{h}}{2 \\pi}$. This momentum for an s-electron will be given by"
  },
  "options": [
    {
      "text": "\nzero\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{\\mathrm{h}}{2 \\pi}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sqrt{2} \\cdot \\frac{\\mathrm{h}}{2 \\pi}$\n",
      "is_correct": false
    },
    {
      "text": "\n$+\\frac{1}{2} \\cdot \\frac{\\mathrm{h}}{2 \\pi}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "For s-electron, $l=0 \\quad \\therefore$ angular momentum $=$ zero"
  }
