  "question": {
    "text": "In an atom, an electron is moving with a speed of $600 \\mathrm{~m} / \\mathrm{s}$ with an accuracy of $0.005 \\%$. Certainity with which the position of the electron can be located is $\\left(h=6.6 \\times 10^{-34} \\mathrm{~kg} \\mathrm{~m}^2 \\mathrm{~s}^{-1}\\right.$, mass of electron, $e_m=9.1 \\times 10^{-31} \\mathrm{~kg}$ )"
  },
  "options": [
    {
      "text": "\n$1.52 \\times 10^{-4} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$5.10 \\times 10^{-3} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.92 \\times 10^{-3} \\mathrm{~m}$\n",
      "is_correct": true
    },
    {
      "text": "\n$3.84 \\times 10^{-3} \\mathrm{~m}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\Delta \\mathrm{x} . \\mathrm{m} \\Delta \\mathrm{v}=\\frac{\\mathrm{h}}{4 \\pi} \\\\\n& \\Delta \\mathrm{x}=\\frac{\\mathrm{h}}{4 \\pi \\mathrm{m} \\Delta \\mathrm{v}} \\\\\n& \\Delta \\mathrm{v}=600 \\times \\frac{0.005}{100}=0.03 \\\\\n& \\Rightarrow \\Delta \\mathrm{x}=\\frac{6.625 \\times 10^{-34}}{4 \\times 3.14 \\times 9.1 \\times 10^{-31} \\times 0.03}=1.92 \\times 10^{-3} \\mathrm{~m}\n\\end{aligned}\n$$"
  }
