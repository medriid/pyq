  "question": {
    "text": "Calculate the wavelength (in nanometer) associated with a proton moving at $1.0 \\times 10^3 \\mathrm{~ms}^{-1}$ (Mass of proton $=1.67 \\times 10^{-27} \\mathrm{~kg}$ and $\\mathrm{h}=6.63 \\times 10^{-34} \\mathrm{Js}$ ):"
  },
  "options": [
    {
      "text": "\n$0.032 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.40 \\mathrm{~nm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$2.5 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$14.0 \\mathrm{~nm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\lambda=\\frac{\\mathrm{h}}{\\mathrm{mv}}=\\frac{6.63 \\times 10^{-34}}{1.67 \\times 10^{-27} \\times 10^3} \\equiv 0.40 \\mathrm{~nm}\n$$"
  }
}