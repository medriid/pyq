  "question": {
    "text": "The wave number of the first emission line in the Balmer series of $\\mathrm{H}$-Spectrum is : $(\\mathrm{R}=$ Rydberg constant $)$ :",
    "image": null
  },
  "options": [
    {
      "id": "czyAN",
      "text": "\n$\\frac{5}{36} R$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Z8Xdm",
      "text": "\n$\\frac{9}{400} R$\n",
