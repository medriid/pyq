  "question": {
    "text": "The wave number of the first emission line in the Balmer series of $\\mathrm{H}$-Spectrum is : $(\\mathrm{R}=$ Rydberg constant $)$ :"
  },
  "options": [
    {
      "text": "\n$\\frac{5}{36} R$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{9}{400} R$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{7}{6} R$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{3}{4} R$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\bar{v}=\\mathrm{RZ}^2\\left(\\frac{1}{2^2}-\\frac{1}{3^2}\\right)$\n$$\n=\\mathrm{R}\\left(\\frac{1}{4}-\\frac{1}{9}\\right)=\\frac{5 \\mathrm{R}}{36}\n$$"
