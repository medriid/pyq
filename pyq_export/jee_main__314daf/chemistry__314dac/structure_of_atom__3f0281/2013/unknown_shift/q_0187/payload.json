  "question": {
    "text": "The de Broglie wavelength of a car of mass 1000 $\\mathrm{kg}$ and velocity $36 \\mathrm{~km} / \\mathrm{hr}$ is :"
  },
  "options": [
    {
      "text": "\n$6.626 \\times 10^{-34} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$6.626 \\times 10^{-38} \\mathrm{~m}$\n",
      "is_correct": true
    },
    {
      "text": "\n$6.626 \\times 10^{-31} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$6.626 \\times 10^{-30} \\mathrm{~m}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { } \\lambda=\\frac{h}{m v} \\\\\n& h=6.6 \\times 10^{-34} \\mathrm{~J}-\\mathrm{s} \\\\\n& m=1000 \\mathrm{~kg} \\\\\n& v=36 \\mathrm{~km} / \\mathrm{hr}=\\frac{36 \\times 10^3}{60 \\times 60} \\mathrm{~m} / \\mathrm{sec}=10 \\mathrm{~m} / \\mathrm{sec} \\\\\n& \\therefore \\quad \\lambda=\\frac{6.6 \\times 10^{-34}}{10^3 \\times 10}=6.6 \\times 10^{-38} \\mathrm{~m} \\\\\n&\n\\end{aligned}\n$$"
  }
}