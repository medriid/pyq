  "question": {
    "text": "Ionisation energy of $\\mathrm{He}^{+}$is $19.6 \\times 10^{-18} \\mathrm{~J} \\mathrm{atom}^{-1}$. The energy of the first stationary state $(\\mathrm{n}=1)$ of $\\mathrm{Li}^{2+}$ is",
    "image": null
  },
  "options": [
    {
      "id": "vPA4n",
      "text": "\n$4.41 \\times 10^{-16} \\mathrm{~J} \\mathrm{atom}^{-1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Ea6i3",
      "text": "\n$-4.41 \\times 10^{-17} \\mathrm{~J}_{\\text {atom }}{ }^{-1}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "pOb5u",
      "text": "\n$-2.2 \\times 10^{-15} \\mathrm{~J} \\mathrm{atom}^{-1}$\n",
      "image": null,
