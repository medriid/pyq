  "question": {
    "text": "The correct sequence which shows decreasing order of the ionic radii of the elements is"
  },
  "options": [
    {
      "text": "\n$\\mathrm{Al}^{3+}>\\mathrm{Mg}^{2+}>\\mathrm{Na}^{+}>\\mathrm{F}^{-}>\\mathrm{O}^{2-}$\n",
