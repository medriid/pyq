  "question": {
    "text": "Which of the following pair is not isoelectronic species?<br />(Atomic numbers&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Sm</mi><mo>=</mo><mn>62</mn><mo>;</mo><mo>&#160;</mo><mi>Er</mi><mo>=</mo><mn>68</mn><mo>;</mo><mo>&#160;</mo><mi>Yb</mi><mo>=</mo><mn>70</mn><mo>;</mo><mo>&#160;</mo><mi>Lu</mi><mo>=</mo><mn>71</mn><mo>;</mo><mo>&#160;</mo><mi>Eu</mi><mo>=</mo><mn>63</mn><mo>;</mo><mo>&#160;</mo><mi>Tb</mi><mo>=</mo><mn>65</mn><mo>;</mo><mo>&#160;</mo><mo>Tm</mo><mo>=</mo><mn>69</mn></math>)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Sm</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Er</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Yb</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Lu</mi><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Eu</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tb</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tb</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Tm</mi><mrow><mn>4</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": true
