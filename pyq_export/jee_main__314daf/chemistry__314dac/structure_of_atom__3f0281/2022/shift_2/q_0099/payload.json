    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>&#62;</mo><mfenced><mi mathvariant=\"normal\">D</mi></mfenced><mo>&#62;</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>&#62;</mo><mfenced><mi mathvariant=\"normal\">A</mi></mfenced></math>",
      "is_correct": false
