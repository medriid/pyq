  "question": {
    "text": "<p>The correct decreasing order of energy, for the orbitals having, following set of quantum numbers:</p><p>(A)&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>3</mn><mo>,</mo><mn>1</mn><mo>=</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>=</mo><mn>0</mn></math></p><p>(B) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>4</mn><mo>,</mo><mi mathvariant=\"normal\">l</mi><mo>=</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>=</mo><mn>0</mn></math></p><p>(C) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>3</mn><mo>,</mo><mi mathvariant=\"normal\">l</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>=</mo><mn>0</mn></math></p><p>(D) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>3</mn><mo>,</mo><mn>1</mn><mo>=</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>=</mo><mn>1</mn></math></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">D</mi></mfenced><mo>&#62;</mo><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>&#62;</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>&#62;</mo><mfenced><mi mathvariant=\"normal\">A</mi></mfenced></math>",
      "is_correct": true
