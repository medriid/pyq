  "question": {
    "text": "In a hydrogen atom, if energy of an electron in ground state is 13.6 eV, then that in the 2nd excited state is",
    "image": null
  },
  "options": [
    {
      "id": "p8pgr",
      "text": "\n1.51 eV\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Hw2NY",
      "text": "\n3.4 eV\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "EiIib",
      "text": "\n6.04 eV\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oyqLh",
      "text": "\n13.6 eV",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$2^{\\text {nd }}$ excited state will be the 3 rd energy level\n$$\n\\mathrm{E}_{\\mathrm{n}}=\\frac{13.6}{\\mathrm{n}^2} \\mathrm{eV} \\text { or } \\mathrm{E}=\\frac{13.6}{9} \\mathrm{eV}=1.51 \\mathrm{eV}\n$$",
    "image": null
  },
