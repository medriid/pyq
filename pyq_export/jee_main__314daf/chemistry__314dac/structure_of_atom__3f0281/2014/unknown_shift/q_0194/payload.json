  "question": {
    "text": "The de-Broglie wavelength of a particle of mass $6.63 \\mathrm{~g}$ moving with a velocity of $100 \\mathrm{~ms}^{-1}$ is:"
  },
  "options": [
    {
      "text": "\n$10^{-33} \\mathrm{~m}$\n",
      "is_correct": true
    },
    {
      "text": "\n$10^{-35} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$10^{-31} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$10^{-25} \\mathrm{~m}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "De Broglie wavelength $(\\lambda)=\\frac{h}{m v}$\n$$\n\\frac{6.63 \\times 10^{-34}}{6.63 \\times 10^{-3} \\times 100}=10^{-33} \\mathrm{~m}\n$$"
  }
}