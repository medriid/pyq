  "question": {
    "text": "The de-Broglie wavelength of a particle of mass $6.63 \\mathrm{~g}$ moving with a velocity of $100 \\mathrm{~ms}^{-1}$ is:",
    "image": null
  },
  "options": [
    {
      "id": "dvJc5",
      "text": "\n$10^{-33} \\mathrm{~m}$\n",
