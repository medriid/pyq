  "question": {
    "text": "Excited hydrogen atom emits light in the ultraviolet region at $2.47 \\times 10^{15} \\mathrm{~Hz}$. With this frequency, the energy of a single photon is: $\\left(\\mathrm{h}=6.63 \\times 10^{-34} \\mathrm{Js}\\right)$"
  },
  "options": [
    {
      "text": "\n$8.041 \\times 10^{-40} \\mathrm{~J}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2.680 \\times 10^{-19} \\mathrm{~J}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.640 \\times 10^{-18} \\mathrm{~J}$\n",
      "is_correct": true
    },
    {
      "text": "\n$6.111 \\times 10^{-17} \\mathrm{~J}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{E}=\\mathrm{hv}$\n$$\n\\begin{aligned}\n&=6.63 \\times 10^{-34} \\times 2.47 \\times 10^{15} \\\\\n&=1.640 \\times 10^{-18} \\mathrm{~J}\n\\end{aligned}\n$$"
  }
