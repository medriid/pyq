  "question": {
    "text": "A gas absorbs a photon of $355 \\mathrm{~nm}$ and emits at two wavelengths. If one of the emissions is at $680 \\mathrm{~nm}$, the other is at:",
    "image": null
  },
  "options": [
    {
      "id": "7XqaG",
      "text": "\n$325 \\mathrm{~nm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QVpQF",
      "text": "\n$743 \\mathrm{~nm}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "VRoVq",
      "text": "\n$518 \\mathrm{~nm}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "STdO6",
      "text": "\n$1035 \\mathrm{~nm}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{1}{\\lambda_{\\text {absorted }}}=\\frac{1}{\\lambda_1}+\\frac{1}{\\lambda_2}$\n$\\Rightarrow \\frac{1}{355}=\\frac{1}{680}+\\frac{1}{\\lambda_2}$\n$\\Rightarrow \\lambda_2=742.8 \\cong 743 \\mathrm{~nm}$",
    "image": null
  },
