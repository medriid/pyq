  "question": {
    "text": "Uncertainty in the position of an electron (mass $=9.1 \\times 10^{-31} \\mathrm{~kg}$ ) moving with a velocity $300 \\mathrm{~ms}^{-1}$, accurate upto $0.001 \\%$, will be"
  },
  "options": [
    {
      "text": "\n$19.2 \\times 10^{-2} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$5.76 \\times 10^{-2} \\mathrm{~m}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.92 \\times 10^{-2} \\mathrm{~m}$\n",
      "is_correct": true
    },
    {
      "text": "\n$3.84 \\times 10^{-2} \\mathrm{~m}$\n(h $\\left.=6.63 \\times 10^{-34} \\mathrm{Js}\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\Delta \\mathrm{x} . \\Delta \\mathrm{V} \\geq \\frac{\\mathrm{h}}{4 \\pi \\mathrm{m}} \\\\\n& \\Delta \\mathrm{x} \\geq \\frac{\\mathrm{h}}{4 \\pi \\mathrm{m} \\Delta \\mathrm{V}}=\\frac{6.63 \\times 10^{-34}}{4 \\times 3.14 \\times 9.1 \\times 10^{-31} \\times 300 \\times \\frac{0.001}{100}} \\\\\n&=\\frac{6.63 \\times 10^{-34}}{4 \\times 3.14 \\times 9.1 \\times 3 \\times 10^{-31} \\times 10^{-3}} \\\\\n&=0.01933 \\\\\n&=1.93 \\times 10^{-2}\n\\end{aligned}\n$$"
  }
