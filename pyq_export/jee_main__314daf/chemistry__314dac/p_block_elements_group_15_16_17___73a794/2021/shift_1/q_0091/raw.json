  "options": [
    {
      "id": "agStR",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">F</mi><mn>2</mn></msub></math> is a stronger oxidizing agent than <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Cl</mi><mn>2</mn></msub></math> in aqueous solution.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "zoVzD",
      "text": "On hydrolysis <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ClF</mi></math> forms <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HOCl</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HF</mi><mo>.</mo></math>",
