      "is_correct": false
    },
    {
      "text": "Phosphinic acid",
      "is_correct": true
    },
    {
      "text": "Hypophosphoric acid",
      "is_correct": false
    },
    {
      "text": "Pyrophosphorus acid",
      "is_correct": false
    }
  ],
