  "question": {
    "text": "The interhalogen compound formed from the reaction of bromine with excess of fluorine is a",
    "image": null
  },
  "options": [
    {
      "id": "lhi47",
      "text": "hypohalite",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "oktC6",
      "text": "halate",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "1NHLH",
      "text": "perhalate",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "nmnUm",
      "text": "halite",
      "isCorrect": false,
      "image": null
