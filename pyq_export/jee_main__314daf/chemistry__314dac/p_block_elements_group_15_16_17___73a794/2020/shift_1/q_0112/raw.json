  "question": {
    "text": "The correct statement with respect to dinitrogen is:",
    "image": null
  },
  "options": [
    {
      "id": "TapRd",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>N</mi><mn>2</mn></msub></math> is paramagnetic in nature.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "jve03",
      "text": "it can combine with dioxygen at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn><mo>&#176;</mo><mi mathvariant=\"normal\">C</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XEHuS",
      "text": "&nbsp;liquid dinitrogen is not used in cryosurgery.",
      "isCorrect": false,
