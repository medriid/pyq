  "question": {
    "text": "Iodine reacts with concentrated <math><mi>H</mi><mi>N</mi><msub><mrow><mi>O</mi></mrow><mrow><mn>3</mn></mrow></msub></math> to yield <math><mi>Y</mi></math> along with other products. The oxidation state of iodine in <math><mi>Y</mi></math> , is:",
    "image": null
  },
  "options": [
    {
      "id": "GcqwV",
      "text": "<math><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
