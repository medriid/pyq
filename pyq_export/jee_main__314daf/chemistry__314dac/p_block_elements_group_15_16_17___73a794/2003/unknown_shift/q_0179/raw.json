  "question": {
    "text": "What may be expected to happen when phosphine gas is mixed with chlorine gas?",
    "image": null
  },
  "options": [
    {
      "id": "d4E2O",
      "text": "\n$\\mathrm{PCI}_3$ and $\\mathrm{HCI}$ are formed and the mixture warms up\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lcfIb",
      "text": "\n$\\mathrm{PCI}_5$ and $\\mathrm{HCI}$ are formed and the mixture cools down\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "cIexj",
      "text": "\n$\\mathrm{PH}_3 . \\mathrm{Cl}_2$ is formed with warming up\n",
      "image": null,
      "isCorrect": false
    },
    {
