  "question": {
    "text": "The nature of oxide $\\left(\\mathrm{TeO}_2\\right)$ and hydride $\\left(\\mathrm{TeH}_2\\right)$ formed by Te , respectively are :",
    "image": null
  },
  "options": [
    {
      "id": "ZGYX9",
      "text": "Oxidising and acidic",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fCoes",
      "text": "Reducing and basic",
      "image": null,
      "isCorrect": false
    },
