  "question": {
    "text": "<p>The incorrect statement from the following for borazine is:</p>",
    "image": null
  },
  "options": [
    {
      "id": "hHTeC",
      "text": "It contains banana bonds",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Lmuay",
      "text": "<p>It can react with water</p>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mbjNs",
      "text": "<p>It is a cyclic compound</p>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cHu63",
      "text": "<p>It has electronic delocalization</p>",
      "image": null,
      "isCorrect": false
    }
