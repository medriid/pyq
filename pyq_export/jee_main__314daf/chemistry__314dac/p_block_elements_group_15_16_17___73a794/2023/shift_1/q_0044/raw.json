  "question": {
    "text": "Inert gases have positive electron gain enthalpy. Its correct order is",
    "image": null
  },
  "options": [
    {
      "id": "pa7es",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Xe</mi><mo>&#60;</mo><mi>Kr</mi><mo>&#60;</mo><mi>Ne</mi><mo>&#60;</mo><mi>He</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1AQSU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>He</mi><mo>&#60;</mo><mi>Ne</mi><mo>&#60;</mo><mi>Kr</mi><mo>&#60;</mo><mi>Xe</mi></math>",
      "isCorrect": false,
