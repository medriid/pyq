    },
    {
      "id": "lHtc4",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>He</mi><mo>&#60;</mo><mi>Xe</mi><mo>&#60;</mo><mi>Kr</mi><mo>&#60;</mo><mi>Ne</mi></math>",
