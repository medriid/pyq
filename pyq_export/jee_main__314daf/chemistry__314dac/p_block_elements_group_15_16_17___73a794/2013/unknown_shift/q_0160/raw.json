  "question": {
    "text": "$\\mathrm{XeO}_4$ molecule is tetrahedral having:",
    "image": null
  },
  "options": [
    {
      "id": "qGaj5",
      "text": "\nTwo $\\mathrm{p} \\pi-\\mathrm{d} \\pi$ bonds\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "728SS",
      "text": "\nOne $\\mathrm{p} \\pi-\\mathrm{d} \\pi$ bonds\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CAxgB",
      "text": "\nFour $\\mathrm{p} \\pi-\\mathrm{d} \\pi$ bonds\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "23zeh",
      "text": "\nThree $\\mathrm{p} \\pi-\\mathrm{d} \\pi$ bonds",
      "image": null,
      "isCorrect": false
