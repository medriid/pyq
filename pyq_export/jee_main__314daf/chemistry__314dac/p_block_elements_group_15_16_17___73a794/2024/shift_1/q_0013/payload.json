  "question": {
    "text": "On reaction of Lead Sulphide with dilute nitric acid which of the following is not formed?"
  },
  "options": [
    {
      "text": "Nitric oxide",
      "is_correct": false
    },
    {
      "text": "Nitrous oxide",
      "is_correct": true
    },
    {
      "text": "Lead nitrate",
      "is_correct": false
    },
    {
      "text": "Sulphur",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{PbS}+\\mathrm{HNO}_3 \\rightarrow \\mathrm{Pb}\\left(\\mathrm{NO}_3\\right)_2+\\mathrm{NO}+\\mathrm{S}+\\mathrm{H}_2 \\mathrm{O}$<br />Nitrous oxide $\\left(\\mathrm{N}_2 \\mathrm{O}\\right)$ is not formed during the reaction."
  }
