  "question": {
    "text": "The total number of isotopes of hydrogen and number of radioactive isotopes among them, respectively, are",
    "image": null
  },
  "options": [
    {
      "id": "Qu149",
      "text": "<math><mn>2</mn></math> and <math><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "FQ5Eo",
      "text": "<math><mn>2</mn></math>  and  <math><mn>0</mn></math>",
