  "solution": {
    "text": "As <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">L</mi></math>&nbsp;solution have <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup><mtext>&#8201;</mtext><mi>mol</mi><mtext>&#8201;</mtext><msub><mi>CaSO</mi><mn>4</mn></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Eq</mi><mo>.</mo><mtext>&#8201;&#8201;</mtext><mi>of</mi><mtext>&#8201;</mtext><msub><mi>CaSO</mi><mn>4</mn></msub><mo>=</mo><mi>eq</mi><mo>.</mo><mtext>&#8201;&#8201;</mtext><mi>of</mi><mtext>&#8201;</mtext><msub><mi>CaCO</mi><mn>3</mn></msub></math><br /><br />In <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">L</mi></math> solution<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">n</mi><msub><mi>CaSO</mi><mn>4</mn></msub></msub><mo>&#215;</mo><mi mathvariant=\"normal\">v</mi><mo>.</mo><mi mathvariant=\"normal\">f</mi><mo>=</mo><msub><mi mathvariant=\"normal\">n</mi><msub><mi>CaCO</mi><mn>3</mn></msub></msub><mo>&#215;</mo><mi mathvariant=\"normal\">v</mi><mo>.</mo><mi mathvariant=\"normal\">f</mi><mo>.</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup><mo>&#215;</mo><mn>2</mn><mo>=</mo><msub><mi mathvariant=\"normal\">n</mi><msub><mi>CaCO</mi><mn>3</mn></msub></msub><mo>&#215;</mo><mn>2</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">n</mi><msub><mi>CaCO</mi><mn>3</mn></msub></msub><mo>=</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup><mtext>&#8201;</mtext><mi>mol</mi><mtext>&#8201;</mtext><mi>in</mi><mtext>&#8201;</mtext><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">L</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi mathvariant=\"normal\">