      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub><mo>=</mo><mn>100</mn><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi><mo>,</mo><mo>&#160;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>=</mo><mn>1270</mn><mo>&#160;</mo><mi mathvariant=\"normal\">K</mi></math>",
