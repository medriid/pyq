  "question": {
    "text": "Which of the following can reduce decomposition of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math>&nbsp;on exposure to light",
    "image": null
  },
  "options": [
    {
      "id": "wJTlm",
      "text": "Urea",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "pXLSH",
      "text": "Alkali",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "35oEm",
      "text": "Glass containers",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yQFRT",
      "text": "Dust",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math>&nbsp;decomposes on exposure to sunlight or on heating. It also decomposes on standing but at a slow rate. These reactions occur explosively when&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math> is in contact with dust. Urea acts as a negative catalyst to this reaction and slow down the decomposition of hydrogen peroxide.</p></blockquote>",
