  "question": {
    "text": "The numbers of protons, electrons and neutrons in a molecule of heavy water are respectively :",
    "image": null
  },
  "options": [
    {
      "id": "2eqId",
      "text": "\n$8,10,11$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "EIFXw",
      "text": "\n$10,10,10$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "q3Sy7",
      "text": "\n$10,11,10$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bvsAH",
      "text": "\n$11,10,10$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Heavy water is $\\mathrm{D}_2 \\mathrm{O}$ hence\nnumber of electrons $=2+8=10$\nnumber of protons $=10$\nAtomic mass of $\\mathrm{D}_2 \\mathrm{O}=4+16=20$\nhence number of neutron\n$=$ Atomic mass $-$ number of protons\n$$\n=20-10=10\n$$",
    "image": null
  },
