  "question": {
    "text": "A group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn></math> element, which is a metal and forms a hydride with strongest reducing power among group <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn></math> hydrides. The element is :",
    "image": null
  },
  "options": [
    {
      "id": "oVsjw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Sb</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "aUNMH",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">P</mi></math>",
