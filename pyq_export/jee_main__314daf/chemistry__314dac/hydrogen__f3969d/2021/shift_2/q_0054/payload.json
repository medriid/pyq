  "question": {
    "text": "Water does not produce <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CO</mi></math> on reacting with :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CO</mi><mn>2</mn></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>4</mn></msub></math>",
      "is_correct": false
