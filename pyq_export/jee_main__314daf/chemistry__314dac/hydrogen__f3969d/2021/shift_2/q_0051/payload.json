  "question": {
    "text": "Which of the following forms of hydrogen emits low energy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">&#946;</mi><mo>-</mo></msup></math> particles?"
  },
  "options": [
    {
      "text": "Deuterium <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">H</mi><mprescripts/><mn>1</mn><mn>2</mn></mmultiscripts></math>",
      "is_correct": false
    },
    {
      "text": "Proton <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">H</mi><mo>+</mo></msup></math>",
      "is_correct": false
    },
    {
      "text": "Tritium <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">H</mi><mprescripts/><mn>1</mn><mn>3</mn></mmultiscripts></math>",
      "is_correct": true
    },
    {
      "text": "Protium <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">H</mi><mprescripts/><mn>1</mn><mn>1</mn></mmultiscripts></math>",
      "is_correct": false
