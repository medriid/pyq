  "question": {
    "text": "Arrange the following compounds in increasing order of their dipole moment : $\\mathrm{HBr}, \\mathrm{H}_2 \\mathrm{~S}, \\mathrm{NF}_3$ and $\\mathrm{CHCl}_3$",
    "image": null
  },
  "options": [
    {
      "id": "x8vzp",
      "text": "$\\mathrm{H}_2 \\mathrm{~S} \\lt \\mathrm{HBr} \\lt \\mathrm{NF}_3 \\lt \\mathrm{CHCl}_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vIAc3",
      "text": "$\\mathrm{NF}_3 \\lt \\mathrm{HBr} \\lt \\mathrm{H}_2 \\mathrm{~S} \\lt \\mathrm{CHCl}_3$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "6xf2u",
      "text": "$\\mathrm{HBr} \\lt \\mathrm{H}_2 \\mathrm{~S} \\lt \\mathrm{NF}_3 \\lt \\mathrm{CHCl}_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mkn1v",
      "text": "$\\mathrm{CHCl}_3 \\lt \\mathrm{NF}_3 \\lt \\mathrm{HBr} \\lt \\mathrm{H}_2 \\mathrm{~S}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& \\mu_{\\mathrm{HBr}}=0.78 \\mathrm{D} \\\\\n& \\mu_{\\mathrm{H}_2 \\mathrm{~S}}=0.95 \\mathrm{D} \\\\\n& \\mu_{\\mathrm{NF}_3}=0.24 \\mathrm{D} \\\\\n& \\mu_{\\mathrm{CHCl}_3}=1.01 \\mathrm{D}\n\\end{aligned}$\n\nHence dipole moment of\n$\\mathrm{NF}_3 < \\mathrm{HBr} < \\mathrm{H}_2 \\mathrm{~S} < \\mathrm{CHCl}_3$",
    "image": null
  },
