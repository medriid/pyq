  "question": {
    "text": "The number and type of bonds in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi mathvariant=\"normal\">C</mi><mn>2</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math>&nbsp;ion in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CaC</mi><mn>2</mn></msub></math> are:",
    "image": null
  },
  "options": [
    {
      "id": "poHqk",
      "text": "Two <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#963;</mi></math>-bonds and two&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#960;</mi></math>-bonds",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "20zMV",
      "text": "One <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#963;</mi></math>-bond and two&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#960;</mi></math>-bonds",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8O2aq",
      "text": "One <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#963;</mi></math>-bond and one&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#960;</mi></math>-bond",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QULTd",
      "text": "Two <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#963;</mi></math>-bonds and one <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#960;</mi></math>-bond",
      "image": null,
