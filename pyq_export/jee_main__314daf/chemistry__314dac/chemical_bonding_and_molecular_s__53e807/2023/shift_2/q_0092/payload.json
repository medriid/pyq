  "question": {
    "text": "Which one of the following pairs is an example of polar molecular solids?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>SO</mi><mn>2</mn></msub><mo>(</mo><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo><mo>,</mo><msub><mi>CO</mi><mn>2</mn></msub><mo>(</mo><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>SO</mi><mn>2</mn></msub><mo>(</mo><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo><mo>,</mo><msub><mi>NH</mi><mn>3</mn></msub><mo>(</mo><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>MgO</mi><mo>(</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo><mo>,</mo><msub><mi>SO</mi><mn>2</mn></msub><mfenced><mi mathvariant=\"normal\">s</mi></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HCl</mi><mo>(</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo><mo>,</mo><mi>AlN</mi><mo>(</mo><mi mathvariant=\"normal\">s</mi><mo>)</mo></math>",
