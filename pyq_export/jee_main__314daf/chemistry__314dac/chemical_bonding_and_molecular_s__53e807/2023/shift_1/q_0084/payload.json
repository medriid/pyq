    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced><msub><mi>NH</mi><mn>4</mn></msub></mfenced><mn>2</mn></msub><msub><mi>BeF</mi><mn>4</mn></msub></math>",
