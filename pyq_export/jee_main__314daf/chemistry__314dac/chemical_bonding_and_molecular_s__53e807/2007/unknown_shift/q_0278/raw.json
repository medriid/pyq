  "question": {
    "text": "Which of the following hydrogen bonds is the strongest?",
    "image": null
  },
  "options": [
    {
      "id": "V9WNb",
      "text": "\n$\\mathrm{O}-\\mathrm{H} \\ldots \\ldots \\mathrm{N}$\n",
