  "question": {
    "text": "The internuclear distances in $\\mathrm{O}-\\mathrm{O}$ bonds for $\\mathrm{O}_2^{+}, \\mathrm{O}_2, \\mathrm{O}_2^{-}$and $\\mathrm{O}_2^{2-}$ respectively are :"
  },
  "options": [
    {
      "text": "\n$1.30 ~Å, 1.49 ~Å, 1.12 ~Å, 1.21 ~Å$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.49 ~Å, 1.21 ~Å, 1.12 ~Å, 1.30 ~Å$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.21 ~Å, 1.12 ~Å, 1.49 ~Å, 1.30 ~Å$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.12 ~Å, 1.21 ~Å, 1.30 ~Å, 1.49 ~Å$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "The bond length follows the order\n$\\mathrm{O}_2^{+} < \\mathrm{O}_2 < \\mathrm{O}_2^{-} < \\mathrm{O}_2^{2-}$\nAccording to this the possible values are \n$1.12 ~Å, 1.21 ~Å, 1.30 ~Å, 1.49 ~Å$"
  }
