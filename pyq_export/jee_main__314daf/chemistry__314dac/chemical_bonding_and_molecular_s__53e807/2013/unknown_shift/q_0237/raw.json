  "question": {
    "text": "The internuclear distances in $\\mathrm{O}-\\mathrm{O}$ bonds for $\\mathrm{O}_2^{+}, \\mathrm{O}_2, \\mathrm{O}_2^{-}$and $\\mathrm{O}_2^{2-}$ respectively are :",
    "image": null
  },
  "options": [
