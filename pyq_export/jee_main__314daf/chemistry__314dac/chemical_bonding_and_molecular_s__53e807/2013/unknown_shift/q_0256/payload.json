  "question": {
    "text": "In which of the following ionization processes the bond energy has increased and also the magnetic behaviour has changed from paramagnetic to diamagnetic ?"
  },
  "options": [
    {
      "text": "\n$\\mathrm{NO} \\rightarrow \\mathrm{NO}^{+}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{N}_2 \\rightarrow \\mathrm{N}_2^{+}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{C}_2 \\rightarrow \\mathrm{C}_2^{+}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{O}_2 \\rightarrow \\mathrm{O}_2^{+}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "For $\\mathrm{NO}$\nTotal no. of electrons $=15$ \n$\\mathrm{B.O}=2.5$\nMag. Behaviour $=$ Paramagnetic \nFor $\\mathrm{NO}^{+}$\nTotal no. of electrons $=14$ \n$\\mathrm{B.O}$=3$\nMag. Behaviour $=$ Diamagnetic"
  }
