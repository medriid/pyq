  "question": {
    "text": "When \\(\\psi_{\\mathrm{A}}\\) and \\(\\psi_{\\mathrm{B}}\\) are the wave functions of atomic orbitals, then \\(\\sigma^*\\) is represented by :"
  },
  "options": [
    {
      "text": "\\(\\psi_{\\mathrm{A}}+2 \\psi_{\\mathrm{B}}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\psi_A-\\psi_B\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\psi_{\\mathrm{A}}+\\psi_{\\mathrm{B}}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\psi_A-2 \\psi_B\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Antibonding molecular orbitals are formed by destructive interference of wave functions.\n$(\\mathrm{ABMO}) \\sigma^*=\\psi_{\\mathrm{A}}-\\psi_{\\mathrm{B}}$"
  }
}