  "question": {
    "text": "Although $\\mathrm{CN}^{-}$ion and $\\mathrm{N}_2$ molecule are isoelectronic, yet $\\mathrm{N}_2$ molecule is chemically inert because of",
    "image": null
  },
  "options": [
    {
      "id": "AMCOl",
      "text": "\npresence of more number of electrons in bonding orbitals\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uKwzH",
      "text": "\nlone bond energy\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QajWn",
      "text": "\nabsence of bond polarity\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "TMxyc",
      "text": "\nuneven electron distribution.",
      "image": null,
      "isCorrect": false
