  "question": {
    "text": "Among the following, the species having the smallest bond is"
  },
  "options": [
    {
      "text": "\n$\\mathrm{NO}^{-}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{NO}^{+}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{O}_2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{NO}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{NO}^{-}(16)-$ B.O. $-2 \\quad \\mathrm{O}_2(16)-$ B.O. $-2$ $\\mathrm{NO}^{+}(14)-$ B.O. $-3 \\quad \\mathrm{NO}(15)-$ B.O. $-2.5$ Higher the bond order lower is the bond length. Hence $\\mathrm{NO}^{+}$will have smallest bond."
  }
