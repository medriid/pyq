  "level": 2,
  "question": {
    "text": "<p>Bonding in which of the following diatomic molecule(s) become(s) stronger, on the basis of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>MO</mi></math> Theory, by removal of an electron?</p><p>(A) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NO</mi></math></p><p>(B) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">N</mi><mn>2</mn></msub></math></p><p>(C) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math></p><p>(D) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub></math></p><p>(E)&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mn>2</mn></msub></math></p><p>Choose the most appropriate answer from the options given below :</p>",
    "image": null
  },
  "options": [
    {
      "id": "6FYWV",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">A</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced></math>&nbsp;only",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "HOiFU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">B</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">E</mi></mfenced></math>&nbsp;only",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "rdxA6",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">A</mi></mfenced><mo>,</mo><mfenced><mi mathvariant=\"normal\">C</mi></mfenced></math>&nbsp;only",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "IYtPY",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">D</mi></mfenced></math>&nbsp;only",
      "isCorrect": false,
      "image": null
    }
