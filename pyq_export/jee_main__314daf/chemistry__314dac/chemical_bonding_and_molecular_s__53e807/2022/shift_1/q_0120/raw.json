  "question": {
    "text": "Which of the following pair of molecules contain odd electron molecule and an expanded octet molecule?",
    "image": null
  },
  "options": [
    {
      "id": "pco3c",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BCl</mi><mn>3</mn></msub></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>SF</mi><mn>6</mn></msub></math>",
