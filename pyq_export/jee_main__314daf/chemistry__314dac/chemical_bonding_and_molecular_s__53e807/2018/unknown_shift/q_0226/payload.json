  "question": {
    "text": "According to molecular orbital theory, which of the following molecule will not be available?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi mathvariant=\"normal\">H</mi><mn>2</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>He</mi><mn>2</mn><mrow><mn>2</mn><mo>+</mo></mrow></msubsup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>He</mi><mn>2</mn><mo>+</mo></msubsup></math>",
      "is_correct": false
