  "question": {
    "text": "According to molecular orbital theory, which of the following is true with respect to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>Li</mi><mn>2</mn><mo>+</mo></msubsup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>Li</mi><mn>2</mn><mo>-</mo></msubsup></math> ?"
  },
  "options": [
    {
      "text": "<math><mi>L</mi><msubsup><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow><mrow><mo>+</mo></mrow></msubsup><mi> </mi></math> is stable and <math><mi>L</mi><msubsup><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow><mrow><mo>-</mo></mrow></msubsup><mi> </mi></math> is unstable",
      "is_correct": false
    },
    {
      "text": "Both are unstable",
      "is_correct": false
    },
    {
      "text": "Both are stable",
      "is_correct": true
    },
    {
      "text": "<math><mi>L</mi><msubsup><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow><mrow><mo>+</mo></mrow></msubsup><mi> </mi></math> is unstable and <math><mi>L</mi><msubsup><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow><mrow><mo>-</mo></mrow></msubsup><mi> </mi></math> is stable",
      "is_correct": false
