  "question": {
    "text": "The d- electronic configuration of an octahedral Co(II) complex having magnetic moment of 3.95 BM is:",
    "image": null
  },
  "options": [
    {
      "id": "cVWs8",
      "text": "$\\mathrm{t}_{2 \\mathrm{~g}}{ }^3 \\mathrm{e}_{\\mathrm{g}}{ }^0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ehfvE",
      "text": "$\\mathrm{t}_{2 \\mathrm{~g}}{ }^6 \\mathrm{e}_{\\mathrm{g}}{ }^1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TI4qv",
      "text": "$\\mathrm{t}_{2 \\mathrm{~g}}{ }^5 \\mathrm{e}_{\\mathrm{g}}{ }^2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "3mlVe",
      "text": "$\\mathrm{e}^4 \\mathrm{t}_2{ }^3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Co}^{2+}$ complex having $\\mu=3.95 \\mathrm{BM}$\nHence number of unpaired electron $=3$\n$\\mathrm{Co}^{2+} \\Rightarrow 3 d^7=\\mathrm{t}_{2 \\mathrm{~g}}^5 \\mathrm{e}_{\\mathrm{g}}^2$",
    "image": null
  },
