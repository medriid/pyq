  "question": {
    "text": "The metal ion whose electronic configuration is not affected by the nature of the ligand and which gives a violet colour in non-luminous flame under hot condition in borax bead test is",
    "image": null
  },
  "options": [
    {
      "id": "2sxWy",
      "text": "$\\mathrm{Mn}^{2+}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aJ2TY",
      "text": "$\\mathrm{Cr}^{3+}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0qetb",
      "text": "$\\mathrm{Ni}^{2+}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "f2hQa",
      "text": "$\\mathrm{Ti}^{3+}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Ni}^{2+}$ gives violet colour with borax bead test in nonluminous flame under hot conditions. $\\mathrm{Ni}^{2+}$ has $\\mathrm{d}^8$ configuration which does not depend on nature of ligand present in octahedral field.\n$\\mathrm{Ni}^{2+} \\Rightarrow \\mathrm{t}_{2 g}^6 \\mathrm{eg}^2$",
    "image": null
  },
