  "question": {
    "text": "From the magnetic behaviour of $\\left[\\mathrm{NiCl}_4\\right]^{2-}$ (paramagnetic) and $\\left[\\mathrm{Ni}(\\mathrm{CO})_4\\right]$ (diamagnetic), choose the correct geometry and oxidation state.",
    "image": null
  },
  "options": [
    {
      "id": "Suatz",
      "text": "$\\left[\\mathrm{NiCl}_4\\right]^{2-}: \\mathrm{Ni}^{\\mathrm{II}}$, tetrahedral\n$\\left[\\mathrm{Ni}(\\mathrm{CO})_4\\right]: \\mathrm{Ni}^{\\mathrm{II}}$, square planar",
      "image": null,
      "isCorrect": false
    },
    {
