  "question": {
    "text": "The type of hybridization and the magnetic property of $\\left[\\mathrm{MnCl}_6\\right]^{3-}$ are :",
    "image": null
  },
  "options": [
    {
      "id": "YDvBV",
      "text": "$d^2 s p^3$, paramagnetic with four unpaired electrons",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SsFI6",
      "text": "$\\mathrm{sp}^3 \\mathrm{~d}^2$, paramagnetic with four unpaired electrons",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "H4dRz",
      "text": "$\\mathrm{d}^2 \\mathrm{sp}^3$, paramagnetic with two unpaired electrons",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TaHUM",
      "text": "$\\mathrm{sp}^3 \\mathrm{~d}^2$, paramagnetic with two unpaired electrons",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & {\\left[\\mathrm{MnCl}_6\\right]^{3-} \\text { contains } \\mathrm{Mn}^{+3}} \\\\ & \\mathrm{Mn}^{+3}:-[\\mathrm{Ar}] 3 \\mathrm{~d}^4 \\\\ & \\text { Ligand } \\Rightarrow \\mathrm{Cl}^{-}(\\mathrm{WFL})\\end{aligned}$<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/Kr7e1TplIFkGuaGdS7wVdn6y7-cOVJEr_LA-inNoRDg.original.fullsize.png\"/><br />$\\text { Hybridisation }=\\mathrm{sp}^3 \\mathrm{~d}^2$<br />4 unpaired electrons",
    "image": null
  },
