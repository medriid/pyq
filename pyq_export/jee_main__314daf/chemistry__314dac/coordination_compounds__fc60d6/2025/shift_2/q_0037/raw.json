  "question": {
    "text": "The d-orbital electronic configuration of the complex among $\\quad\\left[\\mathrm{Co}(\\mathrm{en})_3\\right]^{3+}, \\quad\\left[\\mathrm{CoF}_6\\right]^{3-}$, $\\left[\\mathrm{Mn}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$ and $\\left[\\mathrm{Zn}\\left(\\mathrm{H}_2 \\mathrm{O}\\right)_6\\right]^{2+}$ that has the highest CFSE is :",
    "image": null
  },
  "options": [
    {
      "id": "yeHDz",
      "text": "$t_2^6 g_g^0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "rEIry",
      "text": "$t_2^6 e_g^4$",
      "image": null,
      "isCorrect": false
    },
