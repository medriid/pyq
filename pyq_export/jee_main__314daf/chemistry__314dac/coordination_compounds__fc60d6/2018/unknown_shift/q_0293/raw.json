    "text": "(i)&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>Cr</mi><msub><mfenced separators=\"|\"><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><msub><mi>Cl</mi><mn>3</mn></msub><mo>:</mo></math>&nbsp;Hexaaquachromium <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>III</mi></mfenced></math> chloride<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>6</mn><mo>&#215;</mo><mn>0</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn></mrow></mfenced><mo>&#215;</mo><mn>3</mn><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">x</mi><mo>=</mo><mo>+</mo><mn>3</mn></math><br /><br />(ii)&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>Cr</mi><msub><mfenced separators=\"|\"><mrow><msub><mi mathvariant=\"normal\">C</mi><mn>6</mn></msub><msub><mi mathvariant=\"normal\">H</mi><mn>6</mn></msub></mrow></mfenced><mn>2</mn></msub></mrow></mfenced><mo>:</mo><mi>bis</mi><mi mathvariant=\"normal\">&#160;</mi><mfenced separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">&#951;</mi><mn>6</mn></msup><mo>-</mo><mi>benzene</mi></mrow></mfenced></math>chromium <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mn>0</mn></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">y</mi><mo>+</mo><mn>2</mn><mo>&#215;</mo><mn>0</mn><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">y</mi><mo>=</mo><mn>0</mn></math><br /><br />(iii)&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">K</mi><mn>2</mn></msub><mfenced close=\"]\" open=