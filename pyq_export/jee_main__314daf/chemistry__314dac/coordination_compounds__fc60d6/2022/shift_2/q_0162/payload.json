  "question": {
    "text": "The metal complex that is diamagnetic is (Atomic number : <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Fe</mi><mo>,</mo><mn>26</mn><mo>;</mo><mi>Cu</mi><mo>,</mo><mn>29</mn></math>)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">K</mi><mn>3</mn></msub><mfenced open=\"[\" close=\"]\"><mrow><mi>Cu</mi><msub><mfenced><mi>CN</mi></mfenced><mn>4</mn></msub></mrow></mfenced></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">K</mi><mn>2</mn></msub><mfenced open=\"[\" close=\"]\"><mrow><mi>Cu</mi><msub><mfenced><mi>CN</mi></mfenced><mn>4</mn></msub></mrow></mfenced></math>",
      "is_correct": false
