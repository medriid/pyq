    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Co</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>;</mo><mo>&#160;</mo><msubsup><mi mathvariant=\"normal\">t</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">g</mi></mrow><mn>6</mn></msubsup><msubsup><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">g</mi><mn>0</mn></msubsup><mo>;</mo></math>&nbsp;CFSE&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced open=\"[\" close=\"]\"><mrow><mo>-</mo><mn>0</mn><mo>.</mo><mn>4</mn><mo>&#215;</mo><mn>6</mn><mo>+</mo><mn>0</mn><mo>.</mo><mn>6</mn><mo>&#215;</mo><mn>1</mn></mrow></mfenced><msub><mi mathvariant=\"normal\">&#916;</mi><mi mathvariant=\"normal\">o</mi></msub><mo>+</mo><mn>2</mn><mi mathvariant=\"normal\">P</mi><mo>=</mo><mo>&#8722;</mo><mn>1</mn><mo>.</mo><mn>8</mn><msub><mi mathvariant=\"normal\">&#916;</mi><mi mathvariant=\"normal\">o</mi></msub><mo>+</mo><mn>2</mn><mi mathvariant=\"normal\">P</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Co</mi><msub><mfenced><mi>CN</mi></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>-</mo></mrow></msup><mo>;</mo><mo>&#160;</mo><msubsup><mi mathvariant=\"normal\">t</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">g</mi></mrow><mn>6</mn></msubsup><msubsup><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">g</mi><mn>0</mn></msubsup><mo>;</mo></math>&nbsp;CFSE&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"]\" open=\"[\"><mrow><mo>-</mo><mn>0</mn><mo>.</mo><mn>4</mn><mo>&#215;</mo><mn>6</mn><mo>+</mo><mn>0</mn><mo>.</mo><mn>6</mn><mo>&#215;</mo><mn>0</mn></mrow></mfenced><msub><mi mathvariant=\"normal\">&#916;</mi><mi mathvariant=\"normal\">o</mi></msub