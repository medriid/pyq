  "question": {
    "text": "Which of the following complex is homoleptic?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Ni</mi><mo>(</mo><mi>CN</mi><msub><mo>)</mo><mn>4</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>-</mo></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>2</mn></msub><msub><mi>Cl</mi><mn>2</mn></msub></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Fe</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>4</mn></msub><msub><mi>Cl</mi><mn>2</mn></msub></mrow></mfenced><mo>+</mo></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Co</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>4</mn></msub><msub><mi>Cl</mi><mn>2</mn></msub></mrow></mfenced><mo>+</mo></msup></math>",
      "is_correct": false
