  "question": {
    "text": "Aluminium chloride in acidified aqueous solution forms an ion having geometry",
    "image": null
  },
  "options": [
    {
      "id": "xZjFc",
      "text": "Octahedral",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "x3XpW",
      "text": "Square Planar",
