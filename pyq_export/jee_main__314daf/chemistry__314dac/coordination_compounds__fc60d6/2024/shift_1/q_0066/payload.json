  "question": {
    "text": "An octahedral complex with the formula \\(\\mathrm{CoCl}_3 \\cdot \\mathrm{nNH}_3\\) upon reaction with excess of \\(\\mathrm{AgNO}_3\\) solution gives 2 moles of \\(\\mathrm{AgCl}\\). Consider the oxidation state of \\(\\mathrm{Co}\\) in the complex is ' \\(x\\) '. The value of \" \\(x+n\\) \" is ______"
  },
  "options": [
    {
      "text": "6",
      "is_correct": false
    },
    {
      "text": "8",
      "is_correct": true
    },
    {
      "text": "3",
      "is_correct": false
    },
    {
      "text": "5",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0066_995e275d7b57.png\"><br />$\\begin{aligned} & \\mathrm{x}+0-1-2=0 \\\\ & \\mathrm{x}=+3 \\\\ & \\mathrm{n}=5 \\\\ & \\therefore \\mathrm{x}+\\mathrm{n}=8\\end{aligned}$"
  }
