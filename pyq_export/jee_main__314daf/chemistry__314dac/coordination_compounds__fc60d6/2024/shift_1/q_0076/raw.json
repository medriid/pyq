  "question": {
    "text": "Which one of the following complexes will exhibit the least paramagnetic behaviour?\n[Atomic number, \\(\\mathrm{Cr}=24, \\mathrm{Mn}=25, \\mathrm{Fe}=26, \\mathrm{Co}=27\\) ]",
    "image": null
  },
  "options": [
