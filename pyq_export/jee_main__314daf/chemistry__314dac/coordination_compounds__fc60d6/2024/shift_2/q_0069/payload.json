  "question": {
    "text": "<p>The coordination geometry around the manganese in decacarbonyldimanganese<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mn>0</mn></mfenced></math></p>"
  },
  "options": [
