  "question": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Co</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><msub><mi>CoF</mi><mn>6</mn></msub></mfenced><mrow><mn>3</mn><mo>-</mo></mrow></msup></math> are respectively known as:",
    "image": null
  },
  "options": [
    {
      "id": "80hul",
      "text": "Spin free Complex, Spin paired Complex",
      "image": null,
      "isCorrect": false
    },
    {
