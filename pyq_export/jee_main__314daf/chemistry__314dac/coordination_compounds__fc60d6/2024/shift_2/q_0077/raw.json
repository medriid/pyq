      "isCorrect": false
    },
    {
      "id": "MdZaA",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Pt</mi><mo>(</mo><mi>Cl</mi><msub><mo>)</mo><mn>4</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>-</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": false
    },
    {
