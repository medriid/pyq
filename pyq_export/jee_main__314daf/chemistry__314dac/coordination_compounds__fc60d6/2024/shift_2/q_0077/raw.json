  "question": {
    "text": "Identify from the following species in which <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">d</mi><mn>2</mn></msup><msup><mi>sp</mi><mn>3</mn></msup></math> hybridization is shown by central atom:",
    "image": null
  },
  "options": [
    {
      "id": "kTSMz",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Co</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": true
