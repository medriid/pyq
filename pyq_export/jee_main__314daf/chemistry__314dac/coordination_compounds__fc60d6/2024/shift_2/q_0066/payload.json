  "question": {
    "text": "<p>Match List I with List II</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\"> <tbody> <tr> <td> </td> <td>LIST – I<br/>\t\t\t(Complex ion)</td> <td> </td> <td>LIST – II<br/>\t\t\t(Electronic<br/>\t\t\tConfiguration</td> </tr> <tr> <td>A.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>C</mi><mi>r</mi><msub><mfenced><mrow><msub><mi>H</mi><mn>2</mn></msub><mi>O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>+</mo></mrow></msup></math></td> <td>I.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>t</mi><mrow><mn>2</mn><mi>g</mi></mrow><mn>2</mn></msubsup><msubsup><mi>e</mi><mi>g</mi><mn>0</mn></msubsup></math></td> </tr> <tr> <td>B.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>F</mi><mi>e</mi><msub><mfenced><mrow><msub><mi>H</mi><mn>2</mn></msub><mi>O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>+</mo></mrow></msup></math></td> <td>II.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>t</mi><mrow><mn>2</mn><mi>g</mi></mrow><mn>3</mn></msubsup><msubsup><mi>e</mi><mi>g</mi><mn>0</mn></msubsup></math></td> </tr> <tr> <td>C.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>N</mi><mi>i</mi><msub><mfenced><mrow><msub><mi>H</mi><mn>2</mn></msub><mi>O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td> <td>III.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>t</mi><mrow><mn>2</mn><mi>g</mi></mrow><mn>3</mn></msubsup><msubsup><mi>e</mi><mi>g</mi><mn>2</mn></msubsup></math></td> </tr> <tr> <td>D.</td> <td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>V</mi><msub><mfenced><mrow><msub><mi>H</mi><mn>2</mn></msub><mi>O</mi>