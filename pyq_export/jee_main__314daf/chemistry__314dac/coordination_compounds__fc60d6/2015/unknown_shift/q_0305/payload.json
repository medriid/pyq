  "question": {
    "text": "Which molecule/ion among the following cannot act as a ligand in complex compounds?"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">N</mi></mrow><mrow><mo>-</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>4</mn></mrow></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">O</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">r</mi></mrow><mrow><mo>-</mo></mrow></msup></math>",
      "is_correct": false
