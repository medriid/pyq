  "question": {
    "text": "One mole of the complex compound $\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_5 \\mathrm{Cl}_3$, gives 3 moles of ions on dissolution in water. One mole of the same complex reacts with two moles of $\\mathrm{AgNO}_3$ solution to yield two moles of $\\mathrm{AgCl}$ (s). The structure of the complex is",
    "image": null
  },
  "options": [
    {
      "id": "rdoWZ",
      "text": "\n$\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_3 \\mathrm{Cl}_3\\right] \\cdot 2 \\mathrm{NH}_3$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Seeig",
      "text": "\n$\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_4 \\mathrm{Cl}_2\\right] \\mathrm{Cl} . \\mathrm{NH}_3$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "p9yQB",
      "text": "\n$\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_4 \\mathrm{Cl}\\right] \\mathrm{Cl}_2 . \\mathrm{NH}_3$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Fmcxj",
      "text": "\n$\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_5 \\mathrm{Cl}\\right] \\mathrm{Cl}_2$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_5 \\mathrm{Cl}_3\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_5 \\mathrm{Cl}\\right]^{+2}+2 \\mathrm{Cl}^{-}$\n$\\therefore$ Structure is $\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right)_5 \\mathrm{Cl}\\right] \\mathrm{Cl}_2$.",
    "image": null
  },
