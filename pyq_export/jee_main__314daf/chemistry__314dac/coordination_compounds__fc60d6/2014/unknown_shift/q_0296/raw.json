  "question": {
    "text": "A compound of vanadium chloride has spin only magnetic moment of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>73</mn></math> BM. Its formula is",
    "image": null
  },
