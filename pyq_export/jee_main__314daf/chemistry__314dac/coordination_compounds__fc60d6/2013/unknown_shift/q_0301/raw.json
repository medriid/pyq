  "question": {
    "text": "The magnetic moment of the complex anion $\\left[\\mathrm{Cr}(\\mathrm{NO})\\left(\\mathrm{NH}_3\\right)(\\mathrm{CN})_4\\right]^{2-}$ is :",
    "image": null
  },
  "options": [
    {
      "id": "T9k3C",
      "text": "\n$5.91 \\mathrm{BM}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gXUal",
      "text": "\n$3.87 \\mathrm{BM}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ldKhu",
      "text": "\n$1.73 \\mathrm{BM}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7Uf7m",
      "text": "\n$2.82 \\mathrm{BM}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\operatorname{In}\\left[\\mathrm{Cr}(\\mathrm{NO})\\left(\\mathrm{NH}_3\\right)(\\mathrm{CN})_4\\right]^{2-}$, $\\mathrm{Cr}^{2+}\\left(\\mathrm{d}^4\\right)$ is given as :\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/M-AzxfSV8cYMj3ikB4UxGObeMr7WsXXxjynMLDV4A7s.original.fullsize.png\"><br>\ni.e., 2 unpaired electrons\n$$\n\\mu=\\sqrt{2(2+2)}=\\sqrt{8}=2.82\n$$",
    "image": null
  },
