    {
      "text": "<p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>NO</mi><mn>2</mn><mo>-</mo></msubsup><mo>,</mo><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msubsup><mi mathvariant=\"normal\">O</mi><mn>4</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math>, EDTA <sup>4-</sup>&nbsp;</p>",
      "is_correct": false
    },
    {
      "text": "<p>&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msubsup><mi mathvariant=\"normal\">O</mi><mn>4</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup><mo>,</mo><msubsup><mi>NO</mi><mn>2</mn><mo>-</mo></msubsup><mo>,</mo><msup><mi>NCS</mi><mo>-</mo></msup></math></p>",
