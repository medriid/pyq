  "question": {
    "text": "The set which does not have ambidentate ligand(s) is"
  },
  "options": [
    {
      "text": "<p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msubsup><mi mathvariant=\"normal\">O</mi><mn>4</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math>, ethylene diammine, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></math></p><p>&nbsp;</p>",
      "is_correct": true
    },
    {
      "text": "<p>&nbsp;EDTA <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mo>,</mo><mprescripts></mprescripts><none></none><mrow><mn>4</mn><mo>-</mo></mrow></mmultiscripts><msup><mi>NCS</mi><mo>-</mo></msup><mo>,</mo><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub><msubsup><mi mathvariant=\"normal\">O</mi><mn>4</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math> &nbsp;</p>",
      "is_correct": false
