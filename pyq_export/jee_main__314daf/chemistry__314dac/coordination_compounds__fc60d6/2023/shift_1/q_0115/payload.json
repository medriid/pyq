    },
    {
      "text": "&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Fe</mi><mn>4</mn></msub><msub><mfenced open=\"[\" close=\"]\"><mrow><mi>Fe</mi><mo>(</mo><mi>CN</mi><msub><mo>)</mo><mn>6</mn></msub></mrow></mfenced><mn>3</mn></msub></math>&nbsp;",
