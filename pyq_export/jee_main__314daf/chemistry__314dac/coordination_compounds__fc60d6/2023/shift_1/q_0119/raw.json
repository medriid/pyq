  "question": {
    "text": "The octahedral diamagnetic low spin complex among the following is",
    "image": null
  },
  "options": [
    {
      "id": "KaRoc",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Co</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>3</mn><mo>+</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "c7y6Z",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><msub><mi>CoF</mi><mn>6</mn></msub></mfenced><mrow><mn>3</mn><mo>-</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DjRDe",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><msub><mi>CoCl</mi><mn>6</mn></msub></mfenced><mrow><mn>3</mn><mo>-</mo></mrow></msup></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "z1vmw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><msub><mi>NiCl</mi><mn>4</mn></msub></mfenced><mn>2</mn></msup></math>",
