  "question": {
    "text": "<p>Match List I with List II:</p><table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 400px;\">\t<tbody>\t\t<tr>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List I<br />\t\t\t(Complexes)</strong></td>\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"text-align: center;\"><strong>List II<br />\t\t\t(Hybridisation)</strong></td>\t\t</tr>\t\t<tr>\t\t\t<td>(A)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><mi>Ni</mi><mo>(</mo><mi>CO</mi><msub><mo>)</mo><mn>4</mn></msub></mrow></mfenced></math></td>\t\t\t<td>I</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sp</mi><mn>3</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(B)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Cu</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>4</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td>II</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>dsp</mi><mn>2</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(C)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Fe</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td>III</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sp</mi><mn>3</mn></msup><msup><mi mathvariant=\"normal\">d</mi><mn>2</mn></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td>(D)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><mrow><mi>Fe</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup></math></td>\t\t\t<td>IV</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">d</mi><mn>2</mn></msup><msup><mi>sp</mi><mn>3</mn></msup></math></td>\t\t</tr>\t</tbody></table><p>&nbsp;</p>"
  },
