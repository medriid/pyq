  "question": {
    "text": "Change in volume of the system does not alter the number of moles in which of the following equilibria ?"
  },
  "options": [
    {
      "text": "\n$\\mathrm{N}_2(\\mathrm{~g})+\\mathrm{O}_2(\\mathrm{~g}) \\rightleftharpoons 2 \\mathrm{NO}(\\mathrm{g})$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{PCl}_5(\\mathrm{~g}) \\rightleftharpoons \\mathrm{PCl}_3(\\mathrm{~g})+\\mathrm{Cl}_2(\\mathrm{~g})$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{N}_2(\\mathrm{~g})+3 \\mathrm{H}_2(\\mathrm{~g}) \\rightleftharpoons 2 \\mathrm{NH}_3(\\mathrm{~g})$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{SO}_2 \\mathrm{Cl}_2(\\mathrm{~g}) \\rightleftharpoons \\mathrm{SO}_2(\\mathrm{~g})+\\mathrm{Cl}_2(\\mathrm{~g})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "In this reaction the ratio of number of moles of reactants to products is same i.e. 2 : 2, hence change in volume will not alter the number of moles."
  }
}