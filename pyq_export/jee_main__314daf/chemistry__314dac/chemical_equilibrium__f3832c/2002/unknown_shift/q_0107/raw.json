  "question": {
    "text": "For the reaction $\\mathrm{CO}(\\mathrm{g})+(1 / 2) \\mathrm{O}_2(\\mathrm{~g})=\\mathrm{CO}_2(\\mathrm{~g}), \\mathrm{K}_{\\mathrm{p}} / \\mathrm{K}_{\\mathrm{c}}$ is",
    "image": null
  },
  "options": [
    {
      "id": "vvnY1",
      "text": "\n$\\mathrm{RT}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sDn0L",
      "text": "\n$(\\mathrm{RT})^{-1}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jeow3",
      "text": "\n$(R T)^{-1 / 2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "wEHH0",
      "text": "\n$(R T)^{1 / 2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{K}_{\\mathrm{p}}=\\mathrm{K}_{\\mathrm{c}}(\\mathrm{RT})^{\\Delta n} ; \\Delta \\mathrm{n}=1-\\left(1+\\frac{1}{2}\\right)=1-\\frac{3}{2}=-\\frac{1}{2}$\n$\\therefore \\frac{\\mathrm{K}_{\\mathrm{p}}}{\\mathrm{K}_{\\mathrm{c}}}=(\\mathrm{RT})^{-1 / 2}$",
    "image": null
  },
