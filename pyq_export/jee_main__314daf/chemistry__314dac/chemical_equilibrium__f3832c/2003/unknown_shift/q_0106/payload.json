  "question": {
    "text": "For the reaction equilibrium $\\mathrm{N}_2 \\mathrm{O}_4(\\mathrm{~g}) \\rightleftharpoons 2 \\mathrm{NO}_2(\\mathrm{~g})$ the concentrations of $\\mathrm{N}_2 \\mathrm{O}_4$ and $\\mathrm{NO}_2$ at equilibrium are $4.8 \\times 10^{-2}$ and $1.2 \\times 10^{-2} \\mathrm{~mol} \\mathrm{~L}^{-1}$ respectively. The value of $\\mathrm{K}_{\\mathrm{c}}$ for the reaction is"
  },
  "options": [
    {
      "text": "\n$3 \\times 10^{-1} \\mathrm{~mol} \\mathrm{~L}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$3 \\times 10^{-3} \\mathrm{~mol} \\mathrm{~L}^{-1}$\n",
      "is_correct": true
    },
    {
      "text": "\n$3 \\times 10^3 \\mathrm{~mol} \\mathrm{~L}^{-1}$\n",
      "is_correct": false
    },
    {
      "text": "\n$3.3 \\times 10^2 \\mathrm{~mol} \\mathrm{~L}^{-1}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{K}_{\\mathrm{C}}=\\frac{\\left[\\mathrm{NO}_2\\right]^2}{\\left[\\mathrm{~N}_2 \\mathrm{O}_4\\right]}=\\frac{\\left[1.2 \\times 10^{-2}\\right]^2}{\\left[4.8 \\times 10^{-2}\\right]}=3 \\times 10^{-3} \\mathrm{~mol} / \\mathrm{L}$"
  }
}