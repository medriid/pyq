  "question": {
    "text": "The ratio \\(\\frac{K_P}{K_C}\\) for the reaction : \\(\\mathrm{CO}_{(\\mathrm{g})}+\\frac{1}{2} \\mathrm{O}_{2(\\mathrm{~g})} \\rightleftharpoons \\mathrm{CO}_{2(\\mathrm{~g})}\\) is :"
  },
  "options": [
    {
      "text": "\\(\\frac{1}{\\sqrt{\\mathrm{RT}}}\\)",
      "is_correct": true
    },
    {
      "text": "\\((\\mathrm{RT})^{1 / 2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{RT}\\)",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{CO}(\\mathrm{g})+\\frac{1}{2} \\mathrm{O}_2(\\mathrm{~g}) \\rightleftharpoons \\mathrm{CO}_2(\\mathrm{~g}) \\\\ & \\Delta \\mathrm{n}_{\\mathrm{g}}=1-\\left(1+\\frac{1}{2}\\right)=-\\frac{1}{2} \\\\ & \\frac{\\mathrm{K}_{\\mathrm{p}}}{\\mathrm{K}_{\\mathrm{C}}}=(\\mathrm{RT})^{\\Delta \\mathrm{n}_{\\mathrm{g}}}=\\frac{1}{\\sqrt{\\mathrm{RT}}}\\end{aligned}$"
  }
}