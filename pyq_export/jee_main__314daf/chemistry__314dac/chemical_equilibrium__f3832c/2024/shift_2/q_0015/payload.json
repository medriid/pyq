  "question": {
    "text": "The equilibrium constant for the reaction\n\\(\\mathrm{SO}_3(\\mathrm{g}) \\rightleftharpoons \\mathrm{SO}_2(\\mathrm{~g})+\\frac{1}{2} \\mathrm{O}_2(\\mathrm{~g})\\)\nis \\(\\mathrm{K}_{\\mathrm{c}}=4.9 \\times 10^{-2}\\). The value of \\(\\mathrm{K}_{\\mathrm{c}}\\) for the reaction given below is \\(2 \\mathrm{SO}_2(\\mathrm{~g})+\\mathrm{O}_2(\\mathrm{~g}) \\rightleftharpoons 2 \\mathrm{SO}_3(\\mathrm{~g})\\) is :"
  },
  "options": [
    {
      "text": "4.9",
      "is_correct": false
    },
    {
      "text": "49",
      "is_correct": false
    },
    {
      "text": "41.6",
      "is_correct": false
    },
    {
      "text": "416",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{K}_{\\mathrm{C}}^{\\prime}=\\left(\\frac{1}{\\mathrm{~K}_{\\mathrm{C}}}\\right)^2=\\left(\\frac{1}{4.9 \\times 10^{-2}}\\right)^2 \\\\ & \\mathrm{~K}_{\\mathrm{C}}^{\\prime}=416.49\\end{aligned}$"
  }
