  "question": {
    "text": "For standardizing <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaOH</mi></math> solution, which of the following is used as a primary standard?",
    "image": null
  },
  "options": [
    {
      "id": "9GPTB",
      "text": "Sodium tetra borate",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mKk0k",
      "text": "Ferrous Ammonium sulphate",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2SmGC",
      "text": "Oxalic acid",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hn5st",
      "text": "Dil. HCl",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<blockquote><p>A&nbsp;<b>primary standard</b>&nbsp;in metrology is a standard&nbsp;that is sufficiently accurate such that it is not calibrated by or subordinate to other standards. Primary standards are defined via other quantities like length, mass&nbsp;and time. Primary standards are used to calibrate other standards referred to as working standards.</p><p>Oxalic acid is used as a primary standard for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>NaOH</mi></math> standardization.</p></blockquote>",
    "image": null
