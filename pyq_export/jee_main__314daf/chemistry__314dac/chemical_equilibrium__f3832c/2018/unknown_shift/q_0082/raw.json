  "question": {
    "text": "Which of the following lines correctly show the temperature dependence of equilibrium constant&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">K</mi><mo>,</mo></math> for an exothermic reaction?<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/0574e5f3-5aba-4164-92c9-b606092c19c1-image.png\" style=\"width: 259px; height: 235px;\" /><br />&nbsp;",
    "image": null
  },
  "options": [
