  "question": {
    "text": "The equilibrium constant $\\left(\\mathrm{K}_{\\mathrm{c}}\\right)$ for the reaction $\\mathrm{N}_2(\\mathrm{g})+\\mathrm{O}_2(\\mathrm{~g}) \\rightarrow 2 \\mathrm{NO}(\\mathrm{g})$ at temperature $\\mathrm{T}$ is $4 \\times 10^{-4}$. The value of $\\mathrm{K}_{\\mathrm{c}}$ for the reaction, $\\mathrm{NO}(\\mathrm{g}) \\rightarrow{1 / 2} \\mathrm{~N}_2(\\mathrm{g})+{1 / 2} \\mathrm{~O}_2(\\mathrm{g})$ at the same temperature is :"
  },
  "options": [
    {
      "text": "\n $0.02$\n",
      "is_correct": false
    },
    {
      "text": "\n$2.5 \\times 10^2$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\times 10^{-4}$\n",
      "is_correct": false
    },
    {
      "text": "\n$50.0$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{array}{ll}\\mathrm{N}_2+\\mathrm{O}_2 \\rightleftharpoons 2 \\mathrm{NO} & \\mathrm{K}_{\\mathrm{C}}=4 \\times 10^{-4} \\\\ \\mathrm{NO} \\rightleftharpoons \\frac{1}{2} \\mathrm{~N}_2+\\frac{1}{2} \\mathrm{O}_2 & \\mathrm{~K}_{\\mathrm{C}}^1=\\sqrt{\\frac{1}{\\mathrm{~K}_{\\mathrm{C}}}} \\\\ \\mathrm{K}_{\\mathrm{C}}^1=\\frac{1}{\\sqrt{4 \\times 10^{-4}}}=50 & \\end{array}$"
  }
}