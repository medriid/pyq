  "question": {
    "text": "A vessel at 1000 K contains $\\mathrm{CO}_2$ with a pressure of 0.5 atm . Some of $\\mathrm{CO}_2$ is converted into CO on addition of graphite. If total pressure at equilibrium is 0.8 atm , then Kp is :",
    "image": null
  },
  "options": [
    {
      "id": "60Kuh",
      "text": "1.8 atm",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "dMyR5",
      "text": "0.3 atm",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3ickH",
      "text": "3 atm",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v9a3M",
      "text": "0.18 atm",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{lc}\\mathrm{CO}_2(\\mathrm{~g})+\\mathrm{C}(\\mathrm{s}) \\rightleftharpoons & 2 \\mathrm{CO}(\\mathrm{g}) \\\\ 0.5 & - \\\\ 0.5-\\mathrm{x} & 2 \\mathrm{x}\\end{array}$\n\n\n$\\begin{aligned}\\mathrm{P}_{\\text {total }}=0.5+\\mathrm{x}=0.8 \\\\  \\mathrm{x}=0.3 \\\\  \\mathrm{~K}_{\\mathrm{P}}=\\frac{(0.6)^2}{0.2}=1.8\\end{aligned}$",
    "image": null
  },
