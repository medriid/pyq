  "question": {
    "text": "How many unit cells are present in a cubeshaped ideal crystal of $\\mathrm{NaCl}$ of mass $1.00 \\mathrm{~g}$ ? [Atomic masses: $\\mathrm{Na}=23, \\mathrm{Cl}=35.5$ ]",
    "image": null
  },
  "options": [
    {
      "id": "uoy0O",
      "text": "\n$5.14 \\times 10^{21}$ unit cells\n",
      "image": null,
      "isCorrect": false
    },
    {
