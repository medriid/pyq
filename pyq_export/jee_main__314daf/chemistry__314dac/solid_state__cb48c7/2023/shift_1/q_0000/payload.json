  "question": {
    "text": "Which of the following expressions is correct in case of a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>CsCl</mi></math>&nbsp;unit cell (edge length &lsquo;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">a</mi></math>&rsquo;)<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>?</mo></math>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cs</mi><mo>+</mo></msup></msub><mo>+</mo><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cl</mi><mo>-</mo></msup></msub><mo>=</mo><mfrac><mi mathvariant=\"normal\">a</mi><mn>2</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cs</mi><mo>+</mo></msup></msub><mo>+</mo><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cl</mi><mo>-</mo></msup></msub><mo>=</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mi mathvariant=\"normal\">a</mi></math>",
      "is_correct": true
