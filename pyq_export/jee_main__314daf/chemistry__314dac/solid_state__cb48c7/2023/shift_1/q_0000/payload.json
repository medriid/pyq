    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cs</mi><mo>+</mo></msup></msub><mo>+</mo><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cl</mi><mo>-</mo></msup></msub><mo>=</mo><mfrac><mi mathvariant=\"normal\">a</mi><msqrt><mn>2</mn></msqrt></mfrac></math>",
      "is_correct": false
