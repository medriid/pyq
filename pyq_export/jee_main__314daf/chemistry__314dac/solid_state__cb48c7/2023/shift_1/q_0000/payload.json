    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cs</mi><mo>+</mo></msup></msub><mo>+</mo><msub><mi mathvariant=\"normal\">r</mi><msup><mi>Cl</mi><mo>-</mo></msup></msub><mo>=</mo><mi mathvariant=\"normal\">a</mi></math>",
