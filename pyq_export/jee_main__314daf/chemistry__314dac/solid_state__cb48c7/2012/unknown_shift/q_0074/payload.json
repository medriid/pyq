  "question": {
    "text": "Lithium forms body centred cubic structure. The length of the side of its unit cell is $351 \\mathrm{pm}$. Atomic radius of the lithium will be:"
  },
  "options": [
    {
      "text": "\n$75 \\mathrm{~pm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$300 \\mathrm{~pm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$240 \\mathrm{~pm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$152 \\mathrm{~pm}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "For BCC, $\\sqrt{3} a=4 r$\n$r=\\frac{\\sqrt{3} \\times 351}{4}=152 \\mathrm{~pm}$"
  }
