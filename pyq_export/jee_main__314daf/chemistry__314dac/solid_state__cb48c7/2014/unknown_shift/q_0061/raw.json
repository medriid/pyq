      "text": "\nFrenkel defect\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kyM8b",
      "text": "\nInterstitial position\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2R9lQ",
      "text": "\nF-centres",
      "image": null,
      "isCorrect": true
    }
