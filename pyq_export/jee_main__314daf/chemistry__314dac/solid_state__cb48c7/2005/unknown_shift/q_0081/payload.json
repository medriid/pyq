  "question": {
    "text": "An ionic compound has a unit cell consisting of A ions at the corners of a cube and B ions on the centres of the faces of the cube. The empirical formula for this compound would be"
  },
  "options": [
    {
      "text": "\n$\\mathrm{A}\\mathrm{~B}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{A}_2 \\mathrm{~B}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{A}\\mathrm{~B}_3$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{A}_3 \\mathrm{~B}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\nA=\\frac{1}{8} \\times 8=1\n$$\n(Corner)\n$\\mathrm{B}=\\frac{1}{2} \\times 6=3$\n(Face centre)\n$\\therefore \\mathrm{AB}_3$"
  }
}