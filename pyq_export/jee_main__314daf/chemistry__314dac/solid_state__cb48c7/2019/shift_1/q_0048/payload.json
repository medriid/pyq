  "question": {
    "text": "A solid having density of $9 \\times 10^{3} \\mathrm{~kg} \\mathrm{~m}^{-3}$ forms face centred cubic crystals of edge length $200 \\sqrt{2} \\mathrm{pm} .$ What is the molar mass of the solid?\r\n\r\n[Avogadro constant $\\left.\\approx 6 \\times 10^{23} \\mathrm{~mol}^{-1}, \\pi \\approx 3\\right]$"
  },
  "options": [
    {
      "text": "$0.0432 \\mathrm{~kg} \\mathrm{~mol}^{-1}$",
      "is_correct": false
    },
    {
      "text": "$0.0216 \\mathrm{~kg} \\mathrm{~mol}^{-1}$",
      "is_correct": false
    },
    {
      "text": "$0.0305 \\mathrm{~kg} \\mathrm{~mol}^{-1}$",
      "is_correct": true
    },
    {
      "text": "$0.4320 \\mathrm{~kg} \\mathrm{~mol}^{-1}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Density $=\\frac{Z \\times M}{N_{A} \\times a^{3}}$\r\n\r\n$9 \\times 10^{3}=\\frac{4 \\times \\mathrm{M}}{\\left(200 \\times \\sqrt{2} \\times 10^{-12}\\right)^{3} 6 \\times 10^{23}}$"
  }
}