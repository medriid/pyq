  "question": {
    "text": "An element having an atomic radius of $0.14 \\mathrm{~nm}$ crystallizes in an $f_{c c}$ unit cell. What is the length of a side of the cell ?"
  },
  "options": [
    {
      "text": "\n$0.56 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.24 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.96 \\mathrm{~nm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$0.4 \\mathrm{~nm}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "For a fcc unit cell\n$\\begin{aligned}\n& r=\\frac{\\sqrt{2} a}{4} \\\\\n& a=\\frac{4 r}{\\sqrt{2}}=2 \\sqrt{2} \\times 0.14=0.39 \\approx 0.4 \\mathrm{~nm}.\n\\end{aligned}$"
  }
}