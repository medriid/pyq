  "question": {
    "text": "Copper crystallises in fcc with a unit length of $361 \\mathrm{~pm}$. What is the radius of copper atom ?"
  },
  "options": [
    {
      "text": "\n$157 \\mathrm{~pm}$\n",
      "is_correct": false
    },
    {
      "text": "\n$128 \\mathrm{~pm}$\n",
      "is_correct": true
    },
    {
      "text": "\n$108 \\mathrm{~pm}$\n",
