  "question": {
    "text": "In a compound atoms of element $Y$ from ccp lattice and those of element $X$ occupy $2 / 3^{\\text {rd }}$ of tetrahedral voids. The formula of the compound will be"
  },
  "options": [
    {
      "text": "\n$X_4 Y_3$\n",
      "is_correct": true
    },
    {
      "text": "\n$X_2 Y_3$\n",
      "is_correct": false
    },
    {
      "text": "\n$X_2 Y$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{X}_3 \\mathrm{Y}_4$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "No. of atoms of $Y=4$\nNo. of atoms of $X=\\frac{2}{3} \\times 8$\nFormula of compound will be $X_4 Y_3$"
  }
