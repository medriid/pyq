  "question": {
    "text": "<p>The product (C) in the below mentioned reaction is:</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>-</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>-</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>-</mo><mi>Br</mi><munderover><mo>→</mo><mo>∆</mo><msub><mi>KOH</mi><mfenced><mi>alc</mi></mfenced></msub></munderover><mi mathvariant=\"normal\">A</mi><mover><mo>→</mo><mi>HBr</mi></mover><mi mathvariant=\"normal\">B</mi><munderover><mo>→</mo><msub><mi>KOH</mi><mfenced><mi>aq</mi></mfenced></msub><mo>∆</mo></munderover><mi mathvariant=\"normal\">C</mi></math></p>",
    "image": null
  },
