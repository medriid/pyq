  "question": {
    "text": "<p>Product A and B formed in the following set of reactions are:</p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/35739813-b8e5-4f58-8ab1-8809fb0f5df2.png\" style=\"width: 750px; height: 149px;\"/>",
