  "question": {
    "text": "Presence of a nitro group in a benzene ring",
    "image": null
  },
  "options": [
    {
      "id": "N16uY",
      "text": "\nactivates the ring towards electrophilic substitution\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Fna7v",
      "text": "\nrenders the ring basic\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tf79e",
      "text": "\ndeactivates the ring towards nucleophilic substitution\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lGjaC",
      "text": "\ndeactivates the ring towards electrophilic substitution",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$-\\mathrm{NO}_2$ group shows $-\\mathrm{M}$ effect, so withdraws the electron density from the ring and hence deactivate the ring towards electrophilic aromatic substitution.\nHence, (D) is correct.",
    "image": null
  },
