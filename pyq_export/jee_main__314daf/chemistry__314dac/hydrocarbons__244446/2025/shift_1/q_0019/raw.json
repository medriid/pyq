  "question": {
    "text": "Following are the four molecules \"P\", \"Q\", \"R\" and \"S\".\nWhich one among the four molecules will react with $\\mathrm{H}-\\mathrm{Br}_{(\\mathrm{aq})}$ at the fastest rate?\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/JFljPFUyzLVBWu0y1iz93-nyB8X4TYqW4V226NIzbWo.original.fullsize.png\"/><br/>",
    "image": null
  },
  "options": [
    {
      "id": "jYPw0",
      "text": "R",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kKUsc",
      "text": "P",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OXFRo",
