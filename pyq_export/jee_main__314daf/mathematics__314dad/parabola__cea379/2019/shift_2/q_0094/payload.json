    {
      "text": "<math><mi>y</mi><mo>=</mo><mi>x</mi><mtext> </mtext><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi>Î¸</mi><mo>+</mo><mn>2</mn><mtext> </mtext><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">t</mi><mi>Î¸</mi></math>",
