      "text": "focus&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mn>4</mn><mn>3</mn></mfrac><mo>,</mo><mn>0</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "focus&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>0</mn><mo>,</mo><mfrac><mn>3</mn><mn>3</mn></mfrac></mrow></mfenced></math>",
