    },
    {
      "id": "6E32K",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mo>-</mo><mn>5</mn></mrow><mn>2</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
