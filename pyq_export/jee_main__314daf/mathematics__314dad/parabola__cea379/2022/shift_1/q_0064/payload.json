      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>5</mn><mo>+</mo><mn>6</mn><msqrt><mn>2</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>+</mo><mn>4</mn><msqrt><mn>2</mn></msqrt></math>",
