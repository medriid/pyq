  "question": {
    "text": "Let the shortest distance from $(\\mathrm{a}, 0), \\mathrm{a}\\gt0$, to the parabola $y^2=4 x$ be 4 . Then the equation of the circle passing through the point $(a, 0)$ and the focus of the parabola, and having its centre on the axis of the parabola is :",
    "image": null
  },
  "options": [
    {
      "id": "KMp3H",
      "text": "$x^2+y^2-10 x+9=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "H8qtJ",
      "text": "$x^2+y^2-6 x+5=0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "JKej9",
      "text": "$x^2+y^2-4 x+3=0$",
