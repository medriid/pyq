      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/Y6HIKcUIdBEHxkGYE0ojqvwQuIZKAK00B1BHJTbvUyk.original.fullsize.png\"><br>\n$\\begin{aligned}\n& \\therefore \\quad \\text { Equation of parabola is } P S=(1) P M \\\\\n& \\Rightarrow P S^2=P M^2 \\\\\n& (x-3)^2+(y-6)^2=\\left(\\frac{x+2 y}{\\sqrt{5}}\\right)^2 \\\\\n& 5 x^2-30 x+5 y^2-60 y+225=x^2+4 y^2+4 x y \\\\\n& 4 x^2+y^2-4 x y-30 x-60 y+225=0\n\\end{aligned}$\nWe get : $\\alpha=4, \\beta=1, \\gamma=4$\n$\\therefore \\alpha+\\beta+\\gamma=9$",
    "image": null
  },
