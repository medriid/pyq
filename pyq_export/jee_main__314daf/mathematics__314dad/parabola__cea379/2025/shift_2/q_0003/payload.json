  "question": {
    "text": "The axis of a parabola is the line $y=x$ and its vertex and focus are in the first quadrant at distances $\\sqrt{2}$ and $2 \\sqrt{2}$ units from the origin, respectively. If the point $(1, \\mathrm{k})$ lies on the parabola, then a possible value of $k$ is :-"
  },
  "options": [
    {
      "text": "$4$",
      "is_correct": false
    },
    {
      "text": "$9$",
      "is_correct": true
    },
    {
      "text": "$3$",
      "is_correct": false
    },
    {
      "text": "$8$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0003_3f3a35b53a5b.png\"/><br/>Directrix $x+y=0$<br/>$\\begin{aligned}<br/>& \\mathrm{PS}=\\mathrm{PM} \\\\\n& \\sqrt{(1-2)^2+(\\mathrm{K}-2)^2}=\\frac{(1+\\mathrm{K})}{\\sqrt{2}} \\\\\n& 2 \\mathrm{~K}^2+8-8 \\mathrm{~K}+2=\\mathrm{K}^2+1+2 \\mathrm{~K} \\\\\n& \\mathrm{~K}^2-10 \\mathrm{~K}+9=0 \\\\\n& \\mathrm{~K}=9 \\\\\n& \\text { option (2) }<br/>\\end{aligned}$"
  }
