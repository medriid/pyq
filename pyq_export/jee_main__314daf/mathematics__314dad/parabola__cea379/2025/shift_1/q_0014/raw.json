  "question": {
    "text": "If the line $3 x-2 y+12=0$ intersects the parabola $4 y=3 x^2$ at the points $A$ and $B$, then at the vertex of the parabola, the line segment $A B$ subtends an angle equal to",
    "image": null
  },
  "options": [
    {
      "id": "Rpe4Z",
      "text": "$\\tan ^{-1}\\left(\\frac{4}{5}\\right)$",
      "image": null,
