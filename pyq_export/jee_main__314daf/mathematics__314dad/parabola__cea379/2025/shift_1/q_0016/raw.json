  "question": {
    "text": "Two parabolas have the same focus \\((4,3)\\) and their directrices are the \\(x\\)-axis and the \\(y\\)-axis, respectively. If these parabolas intersects at the points \\(A\\) and \\(B\\), then \\((A B)^2\\) is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "Q0W6b",
      "text": "392",
      "image": null,
      "isCorrect": false
    },
    {
