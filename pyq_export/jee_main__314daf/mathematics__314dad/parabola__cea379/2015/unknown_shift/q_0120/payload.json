    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>6</mn></mrow><mrow><mn>17</mn></mrow></mfrac><mo>,</mo><mi> </mi><mfrac><mrow><mn>10</mn></mrow><mrow><mn>17</mn></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>4</mn></mrow><mrow><mn>17</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>17</mn></mrow></mfrac></mrow></mfenced></math>",
