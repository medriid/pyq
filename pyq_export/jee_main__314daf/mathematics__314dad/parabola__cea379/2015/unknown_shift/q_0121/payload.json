    "A"
  ],
  "solution": {
    "text": "General point on <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>=</mo><mn>8</mn><mi>y</mi></math>&nbsp;is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mfenced><mrow><mn>4</mn><mi>t</mi><mo>,</mo><mn>2</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfenced></math><p>Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced><mrow><mi>h</mi><mo>,</mo><mi>k</mi></mrow></mfenced></math>&nbsp;divide <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>O</mi><mi>Q</mi></math>&nbsp;in ratio <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>:</mo><mn>3</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>h</mi><mo>,</mo><mi>k</mi></mrow></mfenced><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mfenced separators=\"|\"><mrow><mn>4</mn><mi>t</mi></mrow></mfenced><mo>+</mo><mn>3</mn><mfenced><mn>0</mn></mfenced></mrow><mrow><mn>1</mn><mo>+</mo><mn>3</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>1</mn><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><mn>3</mn><mfenced><mn>0</mn></mfenced></mrow><mrow><mn>1</mn><mo>+</mo><mn>3</mn></mrow></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo mathvariant=\"italic\">h</mo><mo>,</mo><mi>k</mi></mrow></mfenced><mo>=</mo><mfenced><mrow><mi>t</mi><mi>,</mi><mfrac><mrow><mn>2</mn><msup><mi>t</mi><mn>2</mn></msup></mrow><mn>4</mn></mfrac></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>=</mo><mi>t</mi><mo>&#160;&#38;&#160;</mo><mi>k</mi><mo>=</mo><mfrac><msup><mi>t</mi><mn>2</mn></msup><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><msup><mi>h</mi><mn>2</mn></msup><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;&#160;&#160;</mo><msup><mi>x</mi><mn>2</mn></msup><mo>=</mo><mn>2</mn><mi>y</mi></math>&nbsp;&nbsp;is&nbsp;the required locus.&nbsp;</p>"
