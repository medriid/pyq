  "question": {
    "text": "The distance of the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>6</mn><mo>,</mo><mo>-</mo><mn>2</mn><msqrt><mn>2</mn></msqrt></mrow></mfenced></math>&nbsp;from the common tangent <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mi>m</mi><mi>x</mi><mo>+</mo><mi>c</mi><mo>,</mo><mi>m</mi><mo>&#62;</mo><mn>0</mn></math>, of the curves <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>2</mn><msup><mi>y</mi><mn>2</mn></msup></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>1</mn><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></math>&nbsp;is",
    "image": null
  },
