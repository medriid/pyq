      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>d</mi><mi>a</mi></mfrac><mo>,</mo><mfrac><mi>e</mi><mi>b</mi></mfrac><mo>,</mo><mfrac><mi>f</mi><mi>c</mi></mfrac></math> are in G.P.",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>d</mi><mi>a</mi></mfrac><mo>,</mo><mfrac><mi>e</mi><mi>b</mi></mfrac><mo>,</mo><mfrac><mi>f</mi><mi>c</mi></mfrac></math>&nbsp;are in A.P.",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mo>,</mo><mi>e</mi><mo>,</mo><mi>f</mi></math> are in G.P.",
