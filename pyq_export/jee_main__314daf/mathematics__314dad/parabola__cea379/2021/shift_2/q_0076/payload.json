    "text": "<p><img src=\"assets\\st0076_957a9e52ea09.png\" style=\"width: 228px; height: 186px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>:</mo><mi>y</mi><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><msup><mi>h</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>:</mo><mi>y</mi><mo>=</mo><mn>4</mn><mi>x</mi><mo>-</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>-</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi><mo>=</mo><mi>A</mi><mi>B</mi><mo>=</mo><mfenced open=\"|\" close=\"|\"><mfrac><mrow><mi>k</mi><mo>-</mo><mn>4</mn><mo>&#160;</mo><mi>h</mi><mo>+</mo><mn>1</mn></mrow><msqrt><mn>17</mn></msqrt></mfrac></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><mfrac><mrow><msup><mi>h</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mo>-</mo><mn>4</mn><mo>&#160;</mo><mi>h</mi><mo>+</mo><mn>1</mn></mrow><msqrt><mn>17</mn></msqrt></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mfenced><mi>D</mi></mfenced></mrow><mrow><mi>d</mi><mi>h</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mo>&#160;</mo><mi>h</mi><mo>-</mo><mn>4</mn></mrow><msqrt><mn>17</mn></msqrt></mfrac><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mfenced><mi>D</mi></mfenced></mrow><mrow><mi>d</mi><msup><mi>h</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><msqrt><mn>17</mn></msqrt></mfrac><mo>&#62;</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>k</mi><mo>=</mo><mn>4</mn><mo