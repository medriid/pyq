    {
      "id": "RatBn",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>(</mo><mi>x</mi><mo>-</mo><mn>3</mn><mi>y</mi><msup><mo>)</mo><mn>2</mn></msup><mo>+</mo><mo>(</mo><mn>3</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>)</mo><mo>+</mo><mn>2</mn><mo>=</mo><mn>0</mn></math>",
