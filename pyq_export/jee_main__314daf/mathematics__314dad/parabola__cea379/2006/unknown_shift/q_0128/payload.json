  "question": {
    "text": "Angle between the tangents to the curve $y=x^2-5 x+6$ at the points $(2,0)$ and $(3,0)$ is"
  },
  "options": [
    {
      "text": "\n$\\frac{\\pi}{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\pi}{2}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{\\pi}{6}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\pi}{4}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\frac{d y}{d x}=2 x-5$\n$\\therefore m_1=(2 x-5)_{(2,0)}=-1, m_2=(2 x-5)_{(3,0)}=1$\n$\\Rightarrow m_1 m_2=-1$"
  }
}