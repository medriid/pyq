  "question": {
    "text": "If $a, b, c$ are distinct $+v e$ real numbers and $a^2+b^2+c^2=1$ then $a b+b c+c a$ is"
  },
  "options": [
    {
      "text": "\nless than 1\n",
      "is_correct": true
    },
    {
      "text": "\nequal to 1\n",
      "is_correct": false
    },
    {
      "text": "\ngreater than 1\n",
      "is_correct": false
    },
    {
      "text": "\nany real no.",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$a b+b c+c a=\\frac{(a+b+c)^2-1}{2} < 1$"
  }
