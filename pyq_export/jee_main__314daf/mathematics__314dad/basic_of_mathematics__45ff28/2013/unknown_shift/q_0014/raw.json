  "question": {
    "text": "The least integral value $\\alpha$ of $x$ such that $\\frac{x-5}{x^2+5 x-14}>0$, satisfies :",
    "image": null
  },
  "options": [
    {
      "id": "LPSZL",
      "text": "\n$\\alpha^2+3 \\alpha-4=0$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "uQTID",
      "text": "\n$\\alpha^2-5 \\alpha+4=0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Bk8en",
      "text": "\n$\\alpha^2-7 \\alpha+6=0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iSdd8",
      "text": "\n$\\alpha^2+5 \\alpha-6=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\text { } \\begin{aligned}\n& \\frac{x-5}{x^2+5 x-14}>0 \\Rightarrow x^2+5 x-14 < x-5 \\\\\n& \\Rightarrow x^2+4 x-9 < 0 \\\\\n& \\Rightarrow \\alpha=-5,-4,-3,-2,-1,0,1\n\\end{aligned}\n$$\n$\\alpha=-5$ does not satisfy any of the options\n$\\alpha=-4$ satisfy the option (a) $\\alpha^2+3 \\alpha-4=0$",
    "image": null
  },
