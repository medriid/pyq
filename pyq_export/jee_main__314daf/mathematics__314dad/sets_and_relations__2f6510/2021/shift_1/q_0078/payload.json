      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>{</mo><mn>80</mn><mo>,</mo><mn>83</mn><mo>,</mo><mn>86</mn><mo>,</mo><mn>89</mn><mo>}</mo></math>",
