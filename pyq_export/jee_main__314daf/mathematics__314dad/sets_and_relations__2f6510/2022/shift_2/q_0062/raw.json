  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></mfenced><mo>&#8712;</mo><mi>N</mi><mo>&#215;</mo><mi>N</mi><mo>:</mo><mfenced close=\"|\" open=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced><mo>&#8804;</mo><mn>13</mn></mrow></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></mfenced><mo>&#8712;</mo><mi>N</mi><mo>&#215;</mo><mi>N</mi><mo>:</mo><mfenced close=\"|\" open=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced><mo>&#8800;</mo><mn>13</mn></mrow></mfenced></math>&nbsp;Then on <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi></math>:",
    "image": null
  },
  "options": [
    {
      "id": "NNEOV",
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;are equivalence relations",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QcsWU",
      "text": "Neither <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;nor&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;is an equivalence relation",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "fZsIw",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;is an equivalence relation but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;is not",
      "isCorrect": false,
      "image": null
    },
