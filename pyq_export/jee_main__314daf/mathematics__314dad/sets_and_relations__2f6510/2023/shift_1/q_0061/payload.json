  "question": {
    "text": "<p>The minimum number of elements that must be added to the relation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mo>(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>)</mo><mo>,</mo><mo>(</mo><mi>b</mi><mo>,</mo><mi mathvariant=\"normal\">c</mi><mo>)</mo></math> on the set <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>{</mo><mi mathvariant=\"normal\">a</mi><mo>,</mo><mi mathvariant=\"normal\">b</mi><mo>,</mo><mi mathvariant=\"normal\">c</mi><mo>}</mo></math> so that it becomes symmetric and transitive is:</p><p>&nbsp;</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>",
      "is_correct": false
    },
