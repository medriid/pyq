  "type": "singleCorrect",
  "level": 3,
  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced><mi mathvariant=\"normal\">S</mi></mfenced></math> denote the power set of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mo>&#8230;</mo><mo>,</mo><mn>10</mn></mrow></mfenced></math>. Define the relations <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;on <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced><mi>S</mi></mfenced></math> as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><msub><mi>R</mi><mn>1</mn></msub><mi>B</mi></math> if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>A</mi><mo>&#8745;</mo><msup><mi>B</mi><mi>c</mi></msup></mrow></mfenced><mo>&#8746;</mo><mfenced><mrow><mi>B</mi><mo>&#8745;</mo><msup><mi>A</mi><mi>c</mi></msup></mrow></mfenced><mo>=</mo><mi>&#981;</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><msub><mi>R</mi><mn>2</mn></msub><mo>&#160;</mo><mi>B</mi></math> if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>&#8746;</mo><msup><mi>B</mi><mi>c</mi></msup><mo>=</mo><mi>B</mi><mo>&#8746;</mo><msup><mi>A</mi><mi>c</mi></msup><mo>,</mo><mo>&#8704;</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo>&#8712;</mo><mi>P</mi><mfenced><mi>S</mi></mfenced></math> . Then :",
    "image": null
  },
  "options": [
    {
      "id": "MfpZM",
      "text": "both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;are equivalence relations",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "NRejk",
      "text": "only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;is an equivalence relation",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1gFeu",
      "text": "only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;is an equivalence relation",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "44QNH",
      "text": "both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub></math>&nbsp;are not equivalence relations",
      "isCorrect": false,
      "image": null
    }
