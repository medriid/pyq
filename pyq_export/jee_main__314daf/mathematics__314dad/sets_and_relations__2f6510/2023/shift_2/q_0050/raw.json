  "level": 1,
  "question": {
    "text": "Among the relations<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></mfenced><mo>:</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>&#8712;</mo><mi>R</mi><mo>-</mo><mfenced close=\"}\" open=\"{\"><mn>0</mn></mfenced><mo>,</mo><mn>2</mn><mo>+</mo><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>&#62;</mo><mn>0</mn></mrow></mfenced></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mfenced close=\"}\" open=\"{\"><mrow><mfenced><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></mfenced><mo>:</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>&#8712;</mo><mi>R</mi><mo>,</mo><msup><mi>a</mi><mn>2</mn></msup><mo>-</mo><msup><mi>b</mi><mn>2</mn></msup><mo>&#8712;</mo><mi>Z</mi></mrow></mfenced></math>,",
    "image": null
  },
  "options": [
    {
      "id": "N0KYz",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math> is transitive but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is not",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "TvEPw",
      "text": "both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> are symmetric",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "yQzsA",
      "text": "neither <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math> not <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is transitive",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "v7Ni1",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi></math> is symmetric but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi></math> is not",
      "isCorrect": true,
      "image": null
    }
