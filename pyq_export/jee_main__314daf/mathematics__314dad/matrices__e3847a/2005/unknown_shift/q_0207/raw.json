  "question": {
    "text": "If $A^2-A+I=0$, then the inverse of $A$ is",
    "image": null
  },
  "options": [
    {
      "id": "pBktF",
      "text": "\n$A+I$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "V43s1",
      "text": "\n$A$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mJOgK",
      "text": "\n$A-I$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "b7PWV",
      "text": "\n$I-A$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Given $A^2-A+I=0$\n$A^{-1} A^2-A^{-1} A+A^{-1}-I=A^{-1} \\cdot 0$ (Multiplying $A^{-1}$ on both sides)\n$\\Rightarrow A-I+A^{-1}=0$ or $A^{-1}=I-A$",
    "image": null
  },
