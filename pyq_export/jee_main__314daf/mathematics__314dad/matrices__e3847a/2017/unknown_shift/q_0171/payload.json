    "text": "Given <math> <mrow> <mi>A</mi><mo>+</mo><mi>B</mi><mo>=</mo><mn>2</mn><msup> <mi>B</mi> <mi>T</mi> </msup> </mrow> </math><br /><br /><math><mo>&#8658;</mo> <msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>+</mo><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>=</mo><mn>2</mn><mi>B</mi></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>B</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>+</mo><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mo>=</mo><mi>A</mi><mo>+</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>+</mo><msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mn>2</mn><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>A</mi><mo>+</mo><msup><mi>A</mi><mi>T</mi></msup><mo>=</mo><mn>3</mn><msup><mi>B</mi><mi>T</mi></msup></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>A</mi><mo>=</mo><mfrac><mrow><mn>3</mn><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>-</mo><msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mn>3</mn><mi>A</mi><mo>+</mo><mn>2</mn><mi>B</mi><mo>=</mo><msub><mrow><mi>I</mi></mrow><mrow><mn>3</mn></mrow></msub></math> ......<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>i</mi></mfenced></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mn>3</mn><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mro