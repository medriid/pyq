  "solution": {
    "text": "<blockquote><p>Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable columnalign=\"left\"><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math>&nbsp;</p><p>Now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>2</mn></msup><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable columnalign=\"left\"><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mfenced close=\"]\" open=\"[\"><mtable columnalign=\"left\"><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable columnalign=\"left\"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mi>I</mi></math></p><p>i.e.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>98</mn></msup><mo>=</mo><mi>I</mi><mo>;</mo><msup><mi>A</mi><mn>49</mn></msup><mo>=</mo><mi>A</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi>B</mi><mn>0</mn></msub><mo>=</mo><msup><mi>A</mi><mn>98</mn></msup><mo>+</mo><mn>2</mn><msup><mi>A</mi><mn>49</mn></msup><mo>=</mo><mi>I</mi><mo>+</mo><mn>2</mn><mi>A</mi><mo>=</mo><mfenced open=\"[\" close=\"]\"><mtable columnalign=\"left\"><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd></mtr></mtable></mfenced></math></p><p>Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>B</mi><mi>n</mi></msub><mo>=</mo><mo>adj</mo><mfenced><msub><mi>B</mi><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msub></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi>B</mi><mn>4</mn></msub><mo>=</mo><mo>adj</mo><mfenced><msub><mi>B</mi><mn>3</mn></msub></mfenced><mo>=</mo><mo>adj</mo><mfenced><mrow><mo>adj</mo><msub><mi>B</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mo>adj</mo><mfenced><mrow><mo>adj</mo><mfenced><mrow><mo>adj</mo><msub><mi>B</mi><mn>1</mn></msub></mrow></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>adj</mo><mfenced><mrow><mo>adj</mo><mfenced><mrow><mo>adj</mo><mfenced><mrow><mo>adj</mo><msub><mi>B</mi><mn>0</mn></msub></mrow></mfenced></mrow></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mfenced close=\"|\" open=\"|\"><msub><mi>B</mi><mn>4</mn></msub></mfenced><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><msub><mi>B</mi><mn>0</mn></msub></mfenced><msup><mn>2</mn><mn>4</mn></msup></msup><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><msub><mi>B</mi><mn>0</mn></msub></mfenced><mn>16</mn></msup></math></p><p>Now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>B</mi><mn>0</mn></msub></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable columnalign=\"left\"><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mo>-</mo><mn>9</mn></math></p><p>Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mi>B</mi><mn>4</mn></msub></mfenced><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><msub><mi>B</mi><mn>0</mn></msub></mfenced><mn>16</mn></msup><mo>=</mo><msup><mn>9</mn><mn>16</mn></msup><mo>=</mo><msup><mn>3</mn><mn>32</mn></msup></math></p></blockquote>"
