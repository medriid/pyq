  "solution": {
    "text": "<p>Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><msub><mfenced close=\"]\" open=\"[\"><msub><mi>a</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub></mfenced><mrow><mn>3</mn><mo>&#215;</mo><mn>3</mn></mrow></msub></math>&nbsp;where&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>=</mo><msup><mn>2</mn><mrow><mi>j</mi><mo>-</mo><mi>i</mi></mrow></msup></math>&nbsp;we get,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>4</mn></mtd></mtr><mtr><mtd><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mfrac><mn>1</mn><mn>4</mn></mfrac></mtd><mtd><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math></p><p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>2</mn></msup><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>4</mn></mtd></mtr><mtr><mtd><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mfrac><mn>1</mn><mn>4</mn></mfrac></mtd><mtd><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mfenced close=\"]\" open=\"[\"><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd><mtd><mn>4</mn></mtd></mtr><mtr><mtd><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mfrac><mn>1</mn><mn>4</mn></mfrac></mtd><mtd><mfrac><mn>1</mn><mn>2</mn></mfrac></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>A</mi><mn>2</mn></msup><mo>=</mo><mfenced close=\"]\" open=\"[\"><mtable><mtr><mtd><mn>3</mn></mtd><mtd><mn>6</mn></mtd><mtd><mn>12</mn></mtd></mtr><mtr><mtd><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd><mtd><mn>3</mn></mtd><mtd><mn>6</mn></mtd></mtr><mtr><mtd><mfrac><mn>3</mn><mn>4</mn></mfrac></mtd><mtd><mfrac><mn>3</mn><mn>2</mn></mfrac></mtd><mtd><mn>3</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mn>3</mn><mi>A</mi></math>&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>A</mi><mn>3</mn></msup><mo>=</mo><mn>3</mn><msup><mi>A</mi><mn>2</mn></msup><mo>=</mo><mn>9</mn><mi>A</mi></math></p><p>Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>2</mn></msup><mo>+</mo><msup><mi>A</mi><mn>3</mn></msup><mo>+</mo><msup><mi>A</mi><mn>4</mn></msup><mo>+</mo><mo>&#8943;</mo><msup><mi>A</mi><mn>10</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>3</mn><mi>A</mi><mo>+</mo><msup><mn>3</mn><mn>2</mn></msup><mi>A</mi><mo>+</mo><msup><mn>3</mn><mn>3</mn></msup><mi>A</mi><mo>+</mo><mo>&#8943;</mo><msup><mn>3</mn><mn>9</mn></msup><mi>A</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>3</mn><mi>A</mi><mfenced close=\"]\" open=\"[\"><mfrac><mrow><msup><mn>3</mn><mn>9</mn></msup><mo>-</mo><mn>1</mn></mrow><mrow><mn>3</mn><mo>-</mo><mn>1</mn></mrow></mfrac></mfenced><mo>=</mo><mi>A</mi><mfenced close=\"]\" open=\"[\"><mfrac><mrow><msup><mn>3</mn><mn>10</mn></msup><mo>-</mo><mn>3</mn></mrow><mn>2</mn></mfrac></mfenced></math></p>"
