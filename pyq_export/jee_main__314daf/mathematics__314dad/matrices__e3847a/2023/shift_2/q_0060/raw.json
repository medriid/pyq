  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math> is a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#215;</mo><mn>3</mn></math>&nbsp;real matrix such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>P</mi><mi>T</mi></msup><mo>=</mo><mi>a</mi><mi>P</mi><mo>+</mo><mo>(</mo><mi>a</mi><mo>-</mo><mn>1</mn><mo>)</mo><mi mathvariant=\"normal\">I</mi></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>&#62;</mo><mn>1</mn></math>, then",
    "image": null
  },
  "options": [
    {
      "id": "gjzuW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math> is a singular matrix",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "67J8t",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>|</mo><mo>Adj</mo><mi>P</mi><mo>|</mo><mo>&#62;</mo><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "J5AFY",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>|</mo><mo>Adj</mo><mi>P</mi><mo>|</mo><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math>",
      "isCorrect": false,
