    },
    {
      "id": "cIfsQ",
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mn>1</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mn>2</mn></math> are false",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XEwVs",
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mn>1</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mn>2</mn></math> are true",
      "isCorrect": false,
      "image": null
    }
