  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;is a&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#215;</mo><mn>3</mn></math>&nbsp;matrix and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mi>A</mi></mfenced><mo>=</mo><mn>2</mn></math>, then&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><mrow><mn>3</mn><mo mathvariant=\"italic\">adj</mo><mfenced><mrow><mfenced open=\"|\" close=\"|\"><mrow><mn>3</mn><mi>A</mi></mrow></mfenced><msup><mi>A</mi><mn>2</mn></msup></mrow></mfenced></mrow></mfenced></math>&nbsp;is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>12</mn></msup><mo>&#183;</mo><msup><mn>6</mn><mn>11</mn></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>12</mn></msup><mo>&#183;</mo><msup><mn>6</mn><mn>10</mn></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>10</mn></msup><mo>&#183;</mo><msup><mn>6</mn><mn>11</mn></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>3</mn><mn>11</mn></msup><mo>&#183;</mo><msup><mn>6</mn><mn>10</mn></msup></math>",
