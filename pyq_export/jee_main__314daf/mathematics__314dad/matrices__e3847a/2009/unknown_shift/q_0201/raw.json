  "question": {
    "text": "Let A be a $2 \\times 2$ matrix\nStatement-1 $: \\operatorname{adj}(\\operatorname{adj} A)=A$\nStatement-2 : $|\\operatorname{adj} \\mathrm{A}|=|\\mathrm{A}|$",
    "image": null
  },
  "options": [
    {
      "id": "FUQPj",
      "text": "\nStatement-1 is true, Statement-2 is true; Statement-2 is a correct explanation for Statement-1\n",
