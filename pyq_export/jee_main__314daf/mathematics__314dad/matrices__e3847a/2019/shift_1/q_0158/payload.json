  "solution": {
    "text": "Given <math><mi>A</mi></math> is symmetric and <math><mi>B</mi></math> is skew symmetric, hence&nbsp;<br /><math><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>b</mi></mtd><mtd><mi>c</mi></mtd></mtr></mtable></mrow></mfenced></math> and <math><mi>B</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>0</mn></mtd><mtd><mi>d</mi></mtd></mtr><mtr><mtd><mo>-</mo><mi>d</mi></mtd><mtd><mn>0</mn></mtd></mtr></mtable></mrow></mfenced></math><br />Now <math><mi>A</mi><mo>+</mo><mi>B</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi><mo>+</mo><mi>d</mi></mtd></mtr><mtr><mtd><mi>b</mi><mo>-</mo><mi>d</mi></mtd><mtd><mi>c</mi></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>2</mn></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mn>5</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><math><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mn>2</mn><mo>,</mo><mtext>&#8201;&#8201;</mtext><mi>b</mi><mo>=</mo><mn>4</mn><mo>,</mo><mtext>&#8201;&#8201;</mtext><mi>c</mi><mo>=</mo><mo>-</mo><mn>1</mn></math> and <math><mi>d</mi><mo>=</mo><mo>-</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>2</mn></mtd><mtd><mn>4</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr></mtable></mrow></mfenced></math> and <math><mi>B</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>0</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable></mrow></mfenced></math><br />Hence <math><mi>A</mi><mi>B</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>2</mn></mtd><mtd><mn>4</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr></mtable></mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>0</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mo>-</mo><mn>4</mn></mtd></mtr></mtable></mrow></mfenced></math>"
