    "text": "<math><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>5</mn><mi>a</mi></mtd><mtd><mo>-</mo><mi>b</mi></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>2</mn></mtd></mtr></mtable></mrow></mfenced></math> and <math><msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>5</mn><mi>a</mi></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mo>-</mo><mi>b</mi></mtd><mtd><mn>2</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><br /><math><mi>A</mi><msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>25</mn><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup></mtd><mtd><mn>15</mn><mi>a</mi><mo>-</mo><mn>2</mn><mi>b</mi></mtd></mtr><mtr><mtd><mn>15</mn><mi>a</mi><mo>-</mo><mn>2</mn><mi>b</mi></mtd><mtd><mn>13</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><br />Now, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>.</mo><mi>a</mi><mi>d</mi><mi>j</mi><mi>A</mi><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>A</mi></mfenced><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mn>10</mn><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>10</mn><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi></mtd></mtr></mtable></mfenced></math><br /><br />Given <math><mi>A</mi><msup><mrow><mi>A</mi></mrow><mrow><mi>T</mi></mrow></msup><mo>=</mo><mi>A</mi><mo>.</mo><mi>a</mi><mi>d</mi><mi>j</mi><mi>&#160;</mi><mi>A</mi></math><br /><br /><math><mn>15</mn><mi>a</mi><mo>-</mo><mn>2</mn><mi>b</mi><mo>=</mo><mn>0</mn></math> ......(i)<br /><br /><math><mn>10</mn><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi><mo>=</mo><mn>13</mn></math> .......(ii)<br /><br />Solving we get<br /><br /><math><mn>5</mn><mi>a</mi><mo>=</mo><mn>2</mn></math> and <math><mi>b</mi><mo>=</mo><mi>&#160;</mi><mn>3</mn></math><br /><br /><math><mo>&#8756;</mo></math> <math><mn>5</mn><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>5</mn></math>",
