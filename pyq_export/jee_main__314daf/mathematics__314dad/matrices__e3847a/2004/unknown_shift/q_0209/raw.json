  "question": {
    "text": "Let $A=\\left(\\begin{array}{ccc}0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ -1 & 0 & 0\\end{array}\\right)$\nThe only correct statement about the matrix $A$ is",
    "image": null
  },
  "options": [
    {
      "id": "8NXHt",
      "text": "\n$A$ is a zero matrix\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SosxS",
      "text": "\n$A^2=I$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "78jwA",
      "text": "\n$\\mathrm{A}^{-1}$ does not exist\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2PPXA",
      "text": "\n$A=(-1) I$, where $I$ is a unit matrix",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$A . A=\\left[\\begin{array}{lll}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{array}\\right]=I$",
    "image": null
  },
