    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>e</mi><mn>3</mn></msup><mo>+</mo><msup><mi>e</mi><mn>6</mn></msup><mo>+</mo><msup><mi>e</mi><mn>10</mn></msup></math>",
