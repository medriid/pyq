    },
    {
      "id": "7yYlJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>min</mi><mo>&#160;</mo><msup><mi>f</mi><mo>'</mo></msup><mfenced><mi>x</mi></mfenced><mo>=</mo><mn>1</mn><mo>+</mo><mi>max</mi><mo>&#160;</mo><msup><mi>g</mi><mo>'</mo></msup><mfenced><mi>x</mi></mfenced></math>",
      "isCorrect": false,
