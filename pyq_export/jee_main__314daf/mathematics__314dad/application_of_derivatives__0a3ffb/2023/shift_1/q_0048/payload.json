    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>max</mi><mo>&#160;</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>&#62;</mo><mi>max</mi><mo>&#160;</mo><mi>g</mi><mfenced><mi>x</mi></mfenced></math>",
      "is_correct": true
