  "question": {
    "text": "The value of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>,&nbsp;in the Lagrange&rsquo;s mean value theorem for the function <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>8</mn><mi>x</mi><mo>+</mo><mn>11</mn><mo>,</mo></math> when <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mn>0,1</mn></mfenced></math>, is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>4</mn><mo>-</mo><msqrt><mn>5</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>4</mn><mo>-</mo><msqrt><mn>7</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "is_correct": true
    },
