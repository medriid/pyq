    "text": "<p><img src=\"assets\\st0150_5d48e27b0c0f.png\" style=\"width: 234px; height: 199px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>(</mo><mi>&#945;</mi><mo>,</mo><mn>0</mn><mo>)</mo><mo>,</mo><mi>&#946;</mi><mo>(</mo><mo>-</mo><mi>&#945;</mi><mo>,</mo><mn>0</mn><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>D</mi><mfenced><mrow><mi>&#945;</mi><mo>,</mo><msup><mi>&#945;</mi><mn>2</mn></msup><mo>-</mo><mn>1</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>r</mi><mi>e</mi><mi>a</mi><mo>&#160;</mo><mo>(</mo><mi>A</mi><mi>B</mi><mi>C</mi><mi>D</mi><mo>)</mo><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mo>(</mo><mi>A</mi><mi>B</mi><mo>)</mo><mo>&#160;</mo><mo>(</mo><mi>A</mi><mi>D</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>S</mi><mo>=</mo><mo>(</mo><mn>2</mn><mi>&#945;</mi><mo>)</mo><mfenced><mrow><mn>1</mn><mo>-</mo><msup><mi>&#945;</mi><mn>2</mn></msup></mrow></mfenced><mo>=</mo><mn>2</mn><mi>&#945;</mi><mo>-</mo><mn>2</mn><msup><mi>&#945;</mi><mn>3</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>s</mi></mrow><mrow><mi>d</mi><mi>&#945;</mi></mrow></mfrac><mo>=</mo><mn>2</mn><mo>-</mo><mn>6</mn><msup><mi>&#945;</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>2</mn></msup><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>&#8658;</mo><mi>&#945;</mi><mo>=</mo><mfrac><mn>1</mn><msqrt><mn>3</mn></msqrt></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>&#160;Area&#160;</mtext><mo>=</mo><mn>2</mn><mi>&#945;</mi><mo>-</mo><mn>2</mn><msup><mi>&#945;</mi><mn>3</mn></msup><mo>=</mo><mfrac><mn>2</mn><msqrt><mn>3</mn></msqrt></mfrac><mo>-</mo><mfrac><mn>2</mn><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mn>4</mn><mrow><mn>3</mn><msqrt><mn>3</mn></ms