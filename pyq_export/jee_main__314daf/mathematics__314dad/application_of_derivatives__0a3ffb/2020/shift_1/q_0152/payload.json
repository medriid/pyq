    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo>+</mo><mn>26</mn><mo>=</mo><mn>0</mn></math>",
