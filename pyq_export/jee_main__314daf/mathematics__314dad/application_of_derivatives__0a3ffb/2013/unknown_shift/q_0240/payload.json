  "solution": {
    "text": "Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><munderover><mo>&#8747;</mo><mn>0</mn><mi>x</mi></munderover><mfenced open=\"|\" close=\"|\"><mi>t</mi></mfenced><mi>d</mi><mi>t</mi></math><br /><br />If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#62;</mo><mn>0</mn></math>, then<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><munderover><mo>&#8747;</mo><mn>0</mn><mi>x</mi></munderover><mi>t</mi><mi>d</mi><mi>t</mi></math><br .=\"\" br=\"\" /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>y</mi><mo>=</mo><mfrac><msup><mi>x</mi><mn>2</mn></msup><mn>2</mn></mfrac></math><br /><br />Ff <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#60;</mo><mn>0</mn></math>, then <math> <mrow> <mi>y</mi><mo>=</mo><mo>&#8722;</mo><mfrac> <mrow> <msup> <mi>x</mi> <mn>2</mn> </msup> </mrow> <mn>2</mn> </mfrac> </mrow> </math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mi>y</mi><mo>={</mo><mtable><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>,</mi></mtd><mtd><mi>x</mi><mo>&#62;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn><mi>,</mi></mtd><mtd><mi>x</mi><mo>&#60;</mo><mn>0</mn></mtd></mtr></mtable></math><br /><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mo>{</mo><mtable><mtr><mtd><mi>x</mi><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#62;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mo>-</mo><mi>x</mi><mi>,</mi></mtd><mtd><mi>x</mi><mo>&#60;</mo><mn>0</mn></mtd></mtr></mtable></math><br /><br />Slope of tangent <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2</mn></math><br /><br />Hence <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi>y</mi><mo>=</mo><mn>2</mn></math> or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mo>-</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi>y</mi><mo>=</mo><mo>-</mo><mn>2</mn></math><br /><br />Eq. of tangent <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>2</mn><mi>x</mi><mo>-</mo><mn>2</mn></math>&nbsp;or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>2</mn></math><br /><br />Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo></math>intercept <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>1</mn></math>&nbsp;or&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>1</mn></math>.<br />&nbsp;"
  }
