  "question": {
    "text": "The normal to the curve $x=a(1+\\cos \\theta), y=a \\sin \\theta$ at ' $\\theta$ ' always passes through the fixed point",
    "image": null
  },
  "options": [
    {
      "id": "oFNEb",
      "text": "\n$(a, 0)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fRFHR",
      "text": "\n$(0, a)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XftPB",
      "text": "\n$(0,0)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MwQOj",
      "text": "\n$(a, a)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Eliminating $\\theta$, we get $(x-a)^2+y^2=a^2$.\nHence normal always pass through $(a, 0)$",
    "image": null
  },
