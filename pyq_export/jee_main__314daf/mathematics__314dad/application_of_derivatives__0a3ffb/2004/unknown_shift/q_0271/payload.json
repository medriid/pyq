  "question": {
    "text": "The normal to the curve $x=a(1+\\cos \\theta), y=a \\sin \\theta$ at ' $\\theta$ ' always passes through the fixed point"
  },
  "options": [
    {
      "text": "\n$(a, 0)$\n",
      "is_correct": true
    },
    {
      "text": "\n$(0, a)$\n",
      "is_correct": false
    },
    {
      "text": "\n$(0,0)$\n",
      "is_correct": false
    },
    {
      "text": "\n$(a, a)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Eliminating $\\theta$, we get $(x-a)^2+y^2=a^2$.\nHence normal always pass through $(a, 0)$"
  }
}