  "question": {
    "text": "If the sum of the slopes of the lines given by $x^2-2 c x y-7 y^2=0$ is four times their product, then $c$ has the value"
  },
  "options": [
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n$-1$\n",
      "is_correct": false
    },
    {
      "text": "\n2\n",
      "is_correct": true
    },
    {
      "text": "\n$-2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$m_1+m_2=-\\frac{2 c}{7}$ and $m_1 m_2=-\\frac{1}{7}$\n$m_1+m_2=4 m_1 m_2 \\quad$ (given)\n$\\Rightarrow c=2$"
  }
