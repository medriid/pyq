    "text": "Given <math><mi>P</mi><mfenced separators=\"|\"><mrow><mn>4</mn><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn><mo>,</mo><mi>&#160;</mi><mn>8</mn><msup><mrow><mi>t</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfenced></math><br /><br /><math><mfrac><mrow><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></mrow><mrow><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mn>3</mn><mi>t</mi></math> (slope of tangent at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math>)<br /><br />Let <math><mi>Q</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>4</mn><msup><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn><mo>,</mo><mi>&#160;</mi><mn>8</mn><msup><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfenced></math><br /><br />Slope of <math><mi>P</mi><mi>Q</mi><mo>=</mo><mn>3</mn><mi>t</mi></math><br /><br /><math><mfrac><mrow><mn>8</mn><msup><mrow><mi>t</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><mn>8</mn><msup><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>4</mn><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><msup><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mn>3</mn><mi>t</mi></math><br /><br /><math><mo>&#8658;</mo></math> <math><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>t</mi><mi>&#955;</mi><mo>-</mo><mn>2</mn><msup><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>0</mn></math><br /><br /><math><mfenced separators=\"|\"><mrow><mi>t</mi><mo>-</mo><mi>&#955;</mi></mrow></mfenced><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mi>t</mi><mo>+</mo><mn>2</mn><mi>&#955;</mi></mrow></mfenced><mo>=