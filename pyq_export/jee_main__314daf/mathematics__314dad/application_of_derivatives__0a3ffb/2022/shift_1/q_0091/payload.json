    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced><mrow><mi>sin</mi><mfenced><mn>1</mn></mfenced><mo>+</mo><mi>sin</mi><mfenced><mn>2</mn></mfenced></mrow></mfenced></math>",
