  "question": {
    "text": "Area of the greatest rectangle that can be inscribed in the ellipse $\\frac{x^2}{a^2}+\\frac{y^2}{b^2}=1$ is"
  },
  "options": [
    {
      "text": "\n$2 a b$\n",
      "is_correct": true
    },
    {
      "text": "\n$a b$\n",
      "is_correct": false
    },
    {
      "text": "\n$3a b$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{a}{b}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0268_43940d9285c8.png\"><br>\nArea of rectangle $A B C D=(2 a\\cos \\theta)$\n$(2 b \\sin \\theta)=2 a b \\sin 2 \\theta$\n$\\Rightarrow$ Area of greatest rectangle is equal to\n$2 a b$\nwhen $\\sin 2 \\theta=1$."
  }
