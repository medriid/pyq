  "question": {
    "text": "If the equation\n$a_n x^n+a_{n-1} x^{n-1}+\\ldots \\ldots+a_1 x=0, a_1 \\neq 0, n \\geq 2$, has a positive root $x=\\alpha$, then the equation $n a_n x^{n-1}+(n-1) a_{n-1} x^{n-2}+\\ldots . .+a_1=0$ has a positive root, which is"
  },
  "options": [
    {
      "text": "\ngreater than $\\alpha$\n",
      "is_correct": false
    },
    {
      "text": "\nsmaller than $\\alpha$\n",
      "is_correct": true
    },
    {
      "text": "\ngreater than or equal to $\\alpha$\n",
      "is_correct": false
    },
    {
      "text": "\nequal to $\\alpha$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$f(0)=0, f(\\alpha)=0$\n$\\Rightarrow f^{\\prime}(k)=0$ for some $k \\in(0, \\alpha)$"
  }
