    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>−</mo><mfrac><mn>1</mn><msqrt><mn>5</mn></msqrt></mfrac><mo>,</mo><mn>0</mn></mrow></mfenced><mo>∪</mo><mfenced><mrow><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><msqrt><mn>5</mn></msqrt></mfrac></mrow></mfenced></math>",
