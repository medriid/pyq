  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/i05vVWEBBF5O4_CWNzP3pn1e3PEEmYKACgj_BqgrPIw.original.fullsize.png\"><br />$\\begin{aligned} & \\text { Area }=(4 \\cos \\theta+2 \\sin \\theta)(2 \\cos \\theta+4 \\sin \\theta) \\\\ & =8 \\cos ^2 \\theta+16 \\sin \\theta \\cos \\theta+4 \\sin \\theta \\cos \\theta+8 \\sin ^2 \\theta \\\\ & =8+20 \\sin \\theta \\cos \\theta \\\\ & =8+10 \\sin 2 \\theta \\\\ & \\text { Max Area }=8+10=18(\\sin 2 \\theta=1) \\theta=45^{\\circ} \\\\ & (a+b)^2=(4 \\cos \\theta+2 \\sin \\theta+2 \\cos \\theta+4 \\sin \\theta)^2 \\\\ & =(6 \\cos \\theta+6 \\sin \\theta)^2 \\\\ & =36(\\sin \\theta+\\cos \\theta)^2 \\\\ & =36(\\sqrt{2})^2\\end{aligned}$\n$=72$",
    "image": null
