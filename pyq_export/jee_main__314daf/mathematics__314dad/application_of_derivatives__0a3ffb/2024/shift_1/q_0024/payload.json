  "question": {
    "text": "Let $f(x)=4 \\cos ^3 x+3 \\sqrt{3} \\cos ^2 x-10$. The number of points of local maxima of $f$ in interval $(0,2 \\pi)$ is"
  },
  "options": [
    {
      "text": "3",
      "is_correct": false
    },
    {
      "text": "4",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "2",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{f}(\\mathrm{x})=4 \\cos ^3(\\mathrm{x})+3 \\sqrt{3} \\cos ^2(\\mathrm{x})-10 ; \\mathrm{x} \\in(0,2 \\pi) \\\\ & \\Rightarrow \\mathrm{f}^{\\prime}(\\mathrm{x})=12 \\cos ^2 \\mathrm{x}[-\\sin (\\mathrm{x})]+3 \\sqrt{3}(2 \\cos (\\mathrm{x}))[-\\sin (\\mathrm{x})] \\\\ & \\Rightarrow \\mathrm{f}^{\\prime}(\\mathrm{x})=-6 \\sin (\\mathrm{x}) \\cos (\\mathrm{x})[2 \\cos (\\mathrm{x})+\\sqrt{3}]\\end{aligned}$\n<img src=\"assets\\st0024_adc8240b46de.png\"><br />local maxima at $\\mathrm{x}=\\frac{5 \\pi}{6}, \\frac{7 \\pi}{6}$"
  }
