    },
    {
      "text": "44",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& f(x)=3 \\sqrt{x-2}+\\sqrt{4-x} \\\\\n& x-2 \\geq 0 \\& 4-x \\geq 0 \\\\\n& \\therefore x \\in[2,4]\n\\end{aligned}$<br />Let $x=2 \\sin ^2 \\theta+4 \\cos ^2 \\theta$\n$\\begin{aligned}\n& \\therefore \\mathrm{f}(\\mathrm{x})=3 \\sqrt{2}|\\cos \\theta|+\\sqrt{2}|\\sin \\theta| \\\\\n& \\therefore \\sqrt{2} \\leq 3 \\sqrt{2}|\\cos \\theta|+\\sqrt{2}|\\sin \\theta| \\leq \\sqrt{9 \\times 2+2} \\\\\n& \\sqrt{2} \\leq 3 \\sqrt{2}|\\cos \\theta|+\\sqrt{2}|\\sin \\theta| \\leq \\sqrt{20} \\\\\n& \\therefore \\alpha=\\sqrt{2} \\quad \\beta=\\sqrt{20} \\\\\n& \\alpha^2+2 \\beta^2=2+40=42\n\\end{aligned}$"
  }
