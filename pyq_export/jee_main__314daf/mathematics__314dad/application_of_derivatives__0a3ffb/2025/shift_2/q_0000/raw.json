  "question": {
    "text": "Let the function $f(x)=\\frac{x}{3}+\\frac{3}{x}+3, x \\neq 0$ be strictly increasing in $\\left(-\\infty, \\alpha_1\\right) \\mathrm{U}\\left(\\alpha_2, \\infty\\right)$ and strictly decreasing in $\\left(\\alpha_3, \\alpha_4\\right) \\mathrm{U}\\left(\\alpha_4, \\alpha_5\\right)$. Then $\\sum_{\\mathrm{i}=1}^5 \\alpha_{\\mathrm{i}}^2$ is equal to :-",
    "image": null
  },
  "options": [
    {
      "id": "xp74e",
      "text": "48",
      "image": null,
      "isCorrect": false
    },
    {
