      "isCorrect": false
    },
    {
      "id": "b7NX1",
      "text": "280",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{f}^{\\prime}(\\mathrm{x})=\\frac{2}{\\mathrm{x}-2}-2 \\mathrm{x}+\\mathrm{a} \\geq 0 \\\\ & \\mathrm{f}^{\\prime \\prime}(\\mathrm{x})=\\frac{-2}{(\\mathrm{x}-2)^2}-2 < 0 \\\\ & \\mathrm{f}^{\\prime}(\\mathrm{x}) \\downarrow \\\\ & \\mathrm{f}^{\\prime}(3) \\geq 0 \\\\ & 2-6+\\mathrm{a} \\geq 0 \\\\ & \\mathrm{a} \\geq 4 \\\\ & \\mathrm{a}_{\\min }=4 \\\\ & \\mathrm{~g}(\\mathrm{x})=(\\mathrm{x}-1)^3(\\mathrm{x}+2-\\mathrm{a})^2 \\\\ & \\mathrm{~g}(\\mathrm{x})=(\\mathrm{x}-1)^3(\\mathrm{x}-2)^2 \\\\ & \\mathrm{~g}{ }^{\\prime}(\\mathrm{x})=(\\mathrm{x}-1)^3 2(\\mathrm{x}-2)+(\\mathrm{x}-2)^2 3(\\mathrm{x}-1)^2 \\\\ & =(\\mathrm{x}-1)^2(\\mathrm{x}-2)(2 \\mathrm{x}-2+3 \\mathrm{x}-6) \\\\ & =(\\mathrm{x}-1)^2(\\mathrm{x}-2)(5 \\mathrm{x}-8) < 0 \\\\ & \\mathrm{x} \\in\\left(\\frac{8}{5}, 2\\right) \\\\ & 100(\\mathrm{a}+\\mathrm{b}-\\mathrm{c})=100\\left(4+\\frac{8}{5}-2\\right)=360\\end{aligned}$",
    "image": null
