  "question": {
    "text": "The shortest distance between the curves $y^2=8 \\mathrm{x}$ and $x^2+y^2+12 y+35=0$ is :",
    "image": null
  },
  "options": [
    {
      "id": "nfFxg",
      "text": "$2 \\sqrt{3}-1$",
      "image": null,
      "isCorrect": false
    },
