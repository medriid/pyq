  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\mathrm{f}(\\mathrm{x})=\\mathrm{x}^2+\\mathrm{ax}^2+\\mathrm{b} \\ell \\mathrm{n}|\\mathrm{x}|+1, \\quad \\mathrm{x} \\neq 0 \\\\\n& \\mathrm{f}^{\\prime}(\\mathrm{x})=3 \\mathrm{x}^2+2 \\mathrm{ax}+\\frac{\\mathrm{b}}{\\mathrm{x}} \\\\\n& \\mathrm{f}^{\\prime}(-1)=3-2 \\mathrm{a}-\\mathrm{b}=0 \\\\\n& \\mathrm{f}^{\\prime}(-2)=12+4 \\mathrm{a}-\\frac{\\mathrm{b}}{2}=0 \\\\\n& \\mathrm{a}=\\frac{-9}{2}, \\mathrm{~b}=12 \\\\\n& \\mathrm{f}^{\\prime}(\\mathrm{x})=3 \\mathrm{x}^2-9 \\mathrm{x}+\\frac{12}{\\mathrm{x}}=\\frac{3(\\mathrm{x}+1)(\\mathrm{x}+2)^2}{\\mathrm{x}}<br/>\\end{aligned}$<br/>Max. at $\\mathrm{n}=-1$<br/>$f(x)=x^2-\\frac{9}{2} x^2+12 \\ln |x|+1$<br/>$\\begin{aligned}<br/>& \\mathrm{f}(-1)=-1-\\frac{9}{2}+1=-\\frac{9}{2} \\\\\n& \\mathrm{M}=-4.5<br/>\\end{aligned}$<br/>Min. value at $\\mathrm{x}=-2$<br/>$\\begin{aligned}<br/>& \\mathrm{f}(-2)=-8-18+12 \\ell \\mathrm{n} 2+1 \\\\\n& \\mathrm{~m}=-25+12 \\ell \\mathrm{n} 2=-16.6 \\\\\n& |\\mathrm{M}+\\mathrm{m}|=21.1<br/>\\end{aligned}$"
  }
