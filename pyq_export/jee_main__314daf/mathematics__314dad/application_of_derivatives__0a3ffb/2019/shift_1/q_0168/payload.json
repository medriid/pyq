  "solution": {
    "text": "<img src=\"assets\\st0168_3895d99d9b92.png\"> <br/><math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mn>25</mn><mtext> </mtext><mrow><mrow><mi>c</mi><mi>m</mi></mrow><mo>/</mo><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">c</mi></mrow></mrow></math> , <math><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mo>?</mo></math>  <br/>Now, <math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>4</mn></math>  <br/>differentiating w.r.t. <math><mi>t</mi></math> both side <br/><math><mn>2</mn><mi>x</mi><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mi>y</mi><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>0</mn></math> <math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>4</mn></math> when <math><mi>y</mi><mo>=</mo><mn>1</mn></math> <math><mo>⇒</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>3</mn><mo>⇒</mo><mi>x</mi><mo>=</mo><msqrt><mn>3</mn></msqrt></math>  <br/><math><mo>⇒</mo><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfrac><mrow><mi>y</mi></mrow><mrow><mi>x</mi></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></math>  <br/><math><mo>⇒</mo><msub><mrow><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mi>d</mi><msub><mrow><mi>t</mi></mrow><mrow><mi> </mi></mrow></msub></mrow></mfrac></mrow><mrow><mfenced separators=\"|\"><mrow><msqrt><mn>3</mn></msqrt><mo>,</mo><mn>1</mn></mrow></mfenced></mrow></msub><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac><mo>×</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>25</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>25</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac><mi> </mi><mrow><mrow><mi>c</mi><mi>m</mi></mrow><mo>/</mo><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">c</mi></mrow></mrow></math>"
