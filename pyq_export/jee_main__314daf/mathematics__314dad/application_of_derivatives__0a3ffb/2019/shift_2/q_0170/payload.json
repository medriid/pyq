      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mn>2</mn><mi>&#945;</mi><mo>+</mo><mn>6</mn><mi>&#946;</mi></mrow></mfenced><mo>=</mo><mn>11</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mn>6</mn><mi>&#945;</mi><mo>+</mo><mn>2</mn><mi>&#946;</mi></mrow></mfenced><mo>=</mo><mn>19</mn></math>",
