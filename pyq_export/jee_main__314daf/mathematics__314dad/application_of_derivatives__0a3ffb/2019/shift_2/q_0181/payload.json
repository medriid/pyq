  "solution": {
    "text": "At <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi>&#160;</mi><msup><mi>f</mi><mi>&#8242;</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>0</mn></math><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><msup><mi>f</mi><mi>&#8242;</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>6</mn><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mi>x</mi><mo>+</mo><mn>3</mn><mi>a</mi></math></p><p>Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mo>&#39;</mo></msup><mfenced><mn>1</mn></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><mo>-</mo><mn>6</mn><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mn>3</mn><mi>a</mi><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mn>5</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mfrac><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>-</mo><mn>14</mn></mrow><msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mfrac><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>9</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>15</mn><mi>x</mi><mo>-</mo><mn>7</mn></mrow><msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mfrac><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mfenced><mrow><mi>x</mi><mo>-</mo><mn>7</mn></mrow></mfenced><mfenced><mrow><msup><mi>x</mi