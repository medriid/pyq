    "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>&#160;</mi><mfrac><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mn>0.6</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><msup><mrow><mi>f</mi></mrow><mrow><mi>&#8242;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>&#160;</mi><mfrac><mrow><mn>0.6</mn><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mo>-</mo><mn>0.4</mn></mrow></msup><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfenced><mo>-</mo><mn>0.6</mn><mi>&#160;</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>0.4</mn></mrow></msup><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mn>0.6</mn></mrow></msup></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><mo>=</mo><mn>0.6</mn><mi>&#160;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mo>-</mo><mn>0.4</mn></mrow></msup><mi>&#160;</mi><mfrac><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>0.6</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mo>-</mo><mn>0.4</mn></mrow></msup><mi>&#160;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>0.6</mn><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>0.4</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mn>0.4</mn></mrow></msup><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />Clearly it is always negative in <math><mo>[</mo><mn>0</mn><mo>,</mo><mi>&#160;</mi><mn>1</mn><mo>]</mo></math><br /><br />minimum value would be at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>1</mn></math>.<br /><br /><math><mfrac><mrow><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mn>1</mn><mo>)</mo></mrow><mrow><mn>0.6</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfrac><mo>=</mo><mi>&#160;</mi><mfrac><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>0.6</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><msup><mrow><mn>2</mn></mrow><mrow><mo>-</mo><mn>0.4</mn></mrow></msup><mo>=</mo><mi>k</mi></math><br /><br />&amp; maximum values would be at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>0</mn></math><br /><br /><math><mfrac><mrow><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mn>0</mn><mo>)</mo></mrow><mrow><mn>0.6</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced></mrow><mrow><mn>0.6</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn></mrow></mfrac><mo>=</mo><mi>K</mi></math><br /><br />Hence <math><mfenced separators=\"|\"><mrow><msup><mrow><mn>2</mn></mrow><mrow><mo>-</mo><mn>0.4</mn></mrow></msup><mo>,</mo><mn>1</mn></mrow></mfenced></math>"
