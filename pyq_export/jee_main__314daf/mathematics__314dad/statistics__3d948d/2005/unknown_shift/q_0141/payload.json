  "question": {
    "text": "Let $\\mathrm{x}_1, \\mathrm{x}_2, \\ldots, \\mathrm{x}_{\\mathrm{n}}$ be $\\mathrm{n}$ observations such that $\\sum \\mathrm{x}_{\\mathrm{i}}^2=400$ and $\\sum \\mathrm{x}_{\\mathrm{i}}=80$. Then a possible value of $\\mathrm{n}$ among the following is"
  },
  "options": [
    {
      "text": "\n15\n",
      "is_correct": false
    },
    {
      "text": "\n18\n",
      "is_correct": true
    },
    {
      "text": "\n9\n",
      "is_correct": false
    },
    {
      "text": "\n12",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\frac{\\sum x_i^2}{n} \\geq\\left(\\frac{\\sum x_i}{n}\\right)^2 \\\\\n& \\Rightarrow n \\geq 16\n\\end{aligned}\n$$"
  }
}