  "question": {
    "text": "Let $\\mathrm{x}_1, \\mathrm{x}_2, \\ldots, \\mathrm{x}_{\\mathrm{n}}$ be $\\mathrm{n}$ observations such that $\\sum \\mathrm{x}_{\\mathrm{i}}^2=400$ and $\\sum \\mathrm{x}_{\\mathrm{i}}=80$. Then a possible value of $\\mathrm{n}$ among the following is",
    "image": null
  },
  "options": [
    {
      "id": "3uAxi",
      "text": "\n15\n",
      "image": null,
      "isCorrect": false
    },
    {
