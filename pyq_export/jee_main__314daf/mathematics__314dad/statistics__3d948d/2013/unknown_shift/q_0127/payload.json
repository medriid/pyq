  "question": {
    "text": "The mean of a data set consisting of 20 observations is 40 . If one observation 53 was wrongly recorded as 33 , then the correct mean will be:"
  },
  "options": [
    {
      "text": "\n41\n",
      "is_correct": true
    },
    {
      "text": "\n49\n",
      "is_correct": false
    },
    {
      "text": "\n$40.5$\n",
      "is_correct": false
    },
    {
      "text": "\n$42.5$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n\\text { Correct mean }=\\frac{20 \\times 40-33+55}{20}=41.1\n$$\nNearest option : (a) 41"
  }
}