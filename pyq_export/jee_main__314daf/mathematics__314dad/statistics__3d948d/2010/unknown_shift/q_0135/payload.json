  "question": {
    "text": "For two data sets, each of size 5 , the variances are given to be 4 and 5 and the corresponding means are given to be 2 and 4 , respectively. The variance of the combined data set is"
  },
  "options": [
    {
      "text": "\n$\\frac{11}{2}$\n",
      "is_correct": true
    },
    {
      "text": "\n6\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{13}{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{5}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\sigma_x^2=4$\n$\\sigma_y^2=5$\n$\\bar{x}=2$\n$\\bar{y}=4$\n$\\begin{aligned} \\frac{\\sum x_i}{5} & =2 \\\\ \\sigma_x^2 & =\\left(\\frac{1}{2} \\sum x_i^2\\right)-(\\bar{x})^2=\\frac{1}{5}\\left(\\sum y_i^2\\right)-16 \\\\ \\sum x_i^2 & =40 \\\\ \\sum y_i^2 & =105 \\\\ \\sigma_z^2 & =\\frac{1}{10}\\left(\\sum x_i^2+\\sum y_i^2\\right)-\\left(\\frac{\\bar{x}+\\bar{y}}{2}\\right)^2=\\frac{1}{10}(40+105)-9=\\frac{145-90}{10}=\\frac{55}{10}=\\frac{11}{2}\\end{aligned}$"
  }
}