    },
    {
      "id": "TpUPJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mfenced><mrow><mn>9</mn><mo>+</mo><mfrac><mn>8</mn><msqrt><mn>7</mn></msqrt></mfrac></mrow></mfenced></math>",
