      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>34</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mfenced><mrow><mn>9</mn><mo>+</mo><mfrac><mn>8</mn><msqrt><mn>7</mn></msqrt></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>25</mn></math>",
