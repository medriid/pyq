  "question": {
    "text": "Let the mean of 6 observations <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mi>x</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi></math> be <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math> and their variance be <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn></math>. Then their mean deviation about the mean is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>7</mn><mn>3</mn></mfrac></math>",
