  "question": {
    "text": "Marks obtains by all the students of class 12 are presented in a freqency distribution with classes of equal width. Let the median of this grouped data be 14 with median class interval 12-18 and median class frequency 12 . If the number of students whose marks are less than 12 is 18 , then the total number of students is",
    "image": null
  },
  "options": [
    {
      "id": "0BbVA",
      "text": "$52$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zeQzp",
      "text": "$48$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aVkyA",
      "text": "$44$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hpAXH",
      "text": "$40$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { median }=\\ell+\\left(\\frac{\\frac{\\mathrm{N}}{2}-\\mathrm{F}}{\\mathrm{f}}\\right) \\times \\mathrm{h} \\\\ & =12+\\left(\\frac{\\frac{\\mathrm{N}}{2}-18}{12}\\right) \\times 6=14 \\\\ & \\Rightarrow\\left(\\frac{\\frac{\\mathrm{~N}}{2}-18}{12}\\right) \\times 6=2 \\\\ & \\frac{\\mathrm{~N}}{2}-18=4 \\Rightarrow \\mathrm{~N}=44\\end{aligned}$",
    "image": null
