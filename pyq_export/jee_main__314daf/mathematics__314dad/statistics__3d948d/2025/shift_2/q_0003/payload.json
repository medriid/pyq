  "question": {
    "text": "If the mean and the variance of $6,4, a, 8, b, 12,10$, 13 are 9 and 9.25 respectively, then $a+b+a b$ is equal to :"
  },
  "options": [
    {
      "text": "$105$",
      "is_correct": false
    },
    {
      "text": "$103$",
      "is_correct": true
    },
    {
      "text": "$100$",
      "is_correct": false
    },
    {
      "text": "$106$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\because \\text { mean }=9 \\\\ & \\therefore 53+\\mathrm{a}+\\mathrm{b}=72 \\\\ & \\Rightarrow \\mathrm{a}+\\mathrm{b}=19 \\\\ & \\because \\sigma^2=\\frac{37}{4} \\text { and }(\\overline{\\mathrm{X}})^2+\\sigma^2=\\frac{\\sum \\mathrm{x}_1^2}{\\mathrm{~N}} \\\\ & \\Rightarrow 81+\\frac{37}{4}=\\frac{529+\\mathrm{a}^2+\\mathrm{b}^2}{8} \\\\ & \\Rightarrow 648+74=529+\\mathrm{a}^2+\\mathrm{b}^2 \\\\ & \\Rightarrow \\mathrm{a}^2+\\mathrm{b}^2=193 \\\\ & \\because \\mathrm{a}+\\mathrm{b}=19 \\Rightarrow \\mathrm{a}^2+\\mathrm{b}^2+2 \\mathrm{ab}=361 \\\\ & \\Rightarrow 2 \\mathrm{ab}=168 \\\\ & \\Rightarrow \\mathrm{ab}=84 \\\\ & \\therefore \\mathrm{a}+\\mathrm{b}+\\mathrm{ab}=103\\end{aligned}$"
  }
