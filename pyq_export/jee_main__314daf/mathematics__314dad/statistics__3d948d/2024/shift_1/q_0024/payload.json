  "solution": {
    "text": "<p>Given: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>∑</mo><mrow><mi mathvariant=\"normal\">k</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msub><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">k</mi></msub><mo>=</mo><mn>50</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><msub><mi mathvariant=\"normal\">a</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">a</mi><mn>2</mn></msub><mo>+</mo><mo>…</mo><mo>+</mo><msub><mi mathvariant=\"normal\">a</mi><mn>10</mn></msub><mo>=</mo><mn>50</mn><mo> </mo><mo> </mo><mo> </mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mi>i</mi></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><msup><mfenced><mrow><msub><mi mathvariant=\"normal\">a</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">a</mi><mn>2</mn></msub><mo>+</mo><mo>…</mo><mo>+</mo><msub><mi mathvariant=\"normal\">a</mi><mn>10</mn></msub></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mn>2500</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><munderover><mo>∑</mo><mrow><mi mathvariant=\"normal\">i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msubsup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><munder><mo>∑</mo><mrow><mi mathvariant=\"normal\">k</mi><mo>&lt;</mo><mi mathvariant=\"normal\">j</mi></mrow></munder><msub><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">k</mi></msub><msub><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">j</mi></msub><mo>=</mo><mn>2500</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><munderover><mo>∑</mo><mrow><mi mathvariant=\"normal\">i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msubsup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><mo>×</mo><mn>1100</mn><mo>=</mo><mn>2500</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><munderover><mo>∑</mo><mrow><mi mathvariant=\"normal\">i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msubsup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>=</mo><mn>2500</mn><mo>-</mo><mn>2</mn><mfenced><mn>1100</mn></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><munderover><mo>∑</mo><mrow><mi mathvariant=\"normal\">i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msubsup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>=</mo><mn>300</mn></math></p><p> Standard deviation, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">σ</mi><mo>=</mo><msqrt><mfrac><mrow><mo>∑</mo><msubsup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup></mrow><mi mathvariant=\"normal\">n</mi></mfrac><mo>-</mo><msup><mfenced><mfrac><mrow><mo>∑</mo><msub><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi></msub></mrow><mi mathvariant=\"normal\">n</mi></mfrac></mfenced><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi mathvariant=\"normal\">σ</mi><mo>=</mo><msqrt><mfrac><mrow><mo>∑</mo><msubsup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup></mrow><mn>10</mn></mfrac><mo>-</mo><msup><mfenced><mfrac><mrow><mo>∑</mo><msub><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">i</mi></msub></mrow><mn>10</mn></mfrac></mfenced><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi mathvariant=\"normal\">σ</mi><mo>=</mo><msqrt><mfrac><mn>300</mn><mn>10</mn></mfrac><mo>-</mo><msup><mfenced><mfrac><mn>50</mn><mn>10</mn></mfrac></mfenced><mn>2</mn></msup></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi mathvariant=\"normal\">σ</mi><mo>=</mo>