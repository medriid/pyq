  "question": {
    "text": "A student scores the following marks in five tests: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>45,54,41,57,43</mn></math>. His score is not known for the sixth test. If the mean score is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>48</mn></math> in the six tests, then the standard deviation of the marks in six tests is:",
    "image": null
  },
