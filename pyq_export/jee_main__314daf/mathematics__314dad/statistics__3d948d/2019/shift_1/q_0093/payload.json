  "solution": {
    "text": "Let the numbers are <math><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><mo>&#8230;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>10</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>N</mi><mo>=</mo><mn>10</mn></mrow></mfenced></math><br />Given <math><mfenced close=\"}\" open=\"\" separators=\"|\"><mrow><mtable><mtr><mtd><mrow><maligngroup></maligngroup><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msub><mo>=</mo><mn>4.11</mn><mo>=</mo><mn>44</mn></mrow></mtd></mtr><mtr><mtd><mrow><maligngroup></maligngroup><msub><mrow><mi>x</mi></mrow><mrow><mn>5</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>6</mn></mrow></msub><mo>&#8230;</mo><mo>.</mo><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>10</mn></mrow></msub><mo>=</mo><mn>6.16</mn><mo>=</mo><mn>96</mn></mrow></mtd></mtr></mtable></mrow></mfenced><mo>&#8658;</mo><mrow><mo stretchy=\"false\">&#8721;</mo><mrow><msub><mrow><mi>x</mi></mrow><mrow><mi>i</mi></mrow></msub><mo>=</mo><mn>140</mn></mrow></mrow></math><br /><math><mo>&#8658;</mo><mi>&#160;</mi></math> variance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#963;</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mo>&#8721;</mo><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mi>N</mi></mfrac><mo>-</mo><msup><mfenced separators=\"|\"><mfrac><mrow><mo>&#8721;</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mi>N</mi></mfrac></mfenced><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#963;</mi><mn>2</mn></msup><mo>=</mo><mfrac><mn>2000</mn><mn>10</mn></mfrac><mo>-</mo><msup><mfenced separators=\"|\"><mfrac><mn>140</mn><mn>10</mn></mfrac></mfenced><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#963;</mi><mn>2</mn></msup><mo>=</mo><mn>200</mn><mo>-</mo><mn>196</mn><mo>=</mo><mn>4</mn></math><br /><math><mo>&#8658;</mo><mi>&#160;</mi></math>&nbsp;Standard deviation <math><mi>&#963;</mi><mo>=</mo><mn>2</mn><mo>.</mo></math>"
