  "question": {
    "text": "The average marks of boys in a class is $52$ and that of girls is $42$. The average marks of boys and girls combined is $50$. The percentage of boys in the class is",
    "image": null
  },
  "options": [
    {
      "id": "QKFLe",
      "text": "\n$40$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eKHQb",
      "text": "\n$20$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gkxjV",
      "text": "\n$80$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "t72xJ",
      "text": "\n$60$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$52 x+42 y=50(x+y)$\n$2 x=8 y$\n$\\Rightarrow \\frac{x}{y}=\\frac{4}{1}$ and $\\frac{x}{x+y}=\\frac{4}{5}$\n$\\therefore \\%$ of boys $=80$.",
    "image": null
  },
