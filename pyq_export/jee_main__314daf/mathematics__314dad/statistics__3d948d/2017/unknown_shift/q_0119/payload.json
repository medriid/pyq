  "solution": {
    "text": "<p>Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msub><mi>x</mi><mi>i</mi></msub><mo>=</mo><mn>400</mn></math> and<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>100</mn></munderover><msup><msub><mi>x</mi><mi>i</mi></msub><mn>2</mn></msup><mo>=</mo><mn>2475</mn></math><br /><br />Variance of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>97</mn></math>&nbsp;observations<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>&#963;</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mo>&#8721;</mo><msup><msub><mi>x</mi><mi>i</mi></msub><mn>2</mn></msup></mrow><mi>N</mi></mfrac><mo>-</mo><msup><mfenced separators=\"|\"><mfrac><mrow><mo>&#8721;</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mi>N</mi></mfrac></mfenced><mn>2</mn></msup><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>&#8756;</mo><mo>&#160;</mo><mn>3</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>5</mn><mo>=</mo><mn>12</mn><mo>,</mo><mo>&#160;</mo><msup><mn>3</mn><mn>2</mn></msup><mo>+</mo><msup><mn>4</mn><mn>2</mn></msup><mo>+</mo><msup><mn>5</mn><mn>2</mn></msup><mo>=</mo><mn>50</mn></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>2425</mn><mn>97</mn></mfrac><mo>-</mo><msup><mfenced separators=\"|\"><mfrac><mn>388</mn><mn>97</mn></mfrac></mfenced><mn>2</mn></msup></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>2425</mn></mrow><mrow><mn>97</mn></mrow></mfrac><mo>-</mo><mn>16</mn></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>2425</mn><mo>-</mo><mn>1552</mn></mrow><mrow><mn>97</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>873</mn></mrow><mrow><mn>97</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/M