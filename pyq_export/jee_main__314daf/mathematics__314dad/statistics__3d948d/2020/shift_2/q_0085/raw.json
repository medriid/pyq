    "text": "<table border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width: 500px;\">\t<tbody>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>x</mi><mi>i</mi></msub></math>&nbsp;(observation)</td>\t\t\t<td>0</td>\t\t\t<td>2</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>2</mn></msup></math>................</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mi mathvariant=\"normal\">n</mi></msup></math></td>\t\t</tr>\t\t<tr>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mi>i</mi></msub></math>&nbsp;(frequency)</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">C</mi><mn>0</mn><none></none><mprescripts></mprescripts><none></none><mi mathvariant=\"normal\">n</mi></mmultiscripts></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">C</mi><mn>1</mn><none></none><mprescripts></mprescripts><none></none><mi mathvariant=\"normal\">n</mi></mmultiscripts></math></td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">C</mi><mn>2</mn><none></none><mprescripts></mprescripts><none></none><mi mathvariant=\"normal\">n</mi></mmultiscripts></math>.............</td>\t\t\t<td><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi mathvariant=\"normal\">C</mi><mi>n</mi><none></none><mprescripts></mprescripts><none></none><mi mathvariant=\"normal\">n</mi></mmultiscripts></math></td>\t\t</tr>\t</tbody></table><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>x</mi><mo>&#175;</mo></mover><mo>=</mo><mfrac><mrow><mi>&#931;</mi><msub><mi>f</mi><mi>i</mi></msub><msub><mi>x</mi><mi>i</mi></msub></mrow><mrow><mi>&#931;</mi><msub><mi>f</mi><mi>i</mi></msub></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>0</mn><mo>&#21