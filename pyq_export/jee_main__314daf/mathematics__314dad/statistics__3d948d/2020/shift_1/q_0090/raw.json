  "solution": {
    "text": "<blockquote><p>Let remaining two observations are&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mstyle displaystyle=\"true\"><mi>&#931;</mi><msub><mi>x</mi><mi>i</mi></msub></mstyle><mi>n</mi></mfrac><mo>=</mo><mfrac><mrow><mn>5</mn><mo>+</mo><mn>7</mn><mo>+</mo><mn>12</mn><mo>+</mo><mn>10</mn><mo>+</mo><mn>15</mn><mo>+</mo><mn>14</mn><mo>+</mo><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mn>8</mn></mfrac><mo>=</mo><mn>10</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>63</mn><mo>+</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo mathvariant=\"italic\">=</mo><mn>80</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>17</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#963;</mi><mn>2</mn></msup><mo>=</mo><mfrac><mstyle displaystyle=\"true\"><mi>&#931;</mi><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mstyle><mi>n</mi></mfrac><mo>&#8722;</mo><msup><mfenced><mfrac><mstyle displaystyle=\"true\"><mi>&#931;</mi><msub><mi>x</mi><mi>i</mi></msub></mstyle><mi>n</mi></mfrac></mfenced><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>13</mn><mo>.5</mo><mo>=</mo><mfrac><mrow><mn>25</mn><mo>+</mo><mn>49</mn><mo>+</mo><mn>144</mn><mo>+</mo><mn>100</mn><mo>+</mo><mn>225</mn><mo>+</mo><mn>196</mn><mo>+</mo><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></mrow><mn>8</mn></mfrac><mo>&#8722;</mo><mn>100</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>908</mn><mo>=</mo><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>