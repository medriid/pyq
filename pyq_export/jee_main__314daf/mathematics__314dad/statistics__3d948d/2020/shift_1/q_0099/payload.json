  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>var</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo>&#8230;</mo><mi>n</mi></mrow></mfenced><mo>=</mo><mn>10</mn><mo>&#8658;</mo><mfrac><mrow><msup><mn>1</mn><mn>2</mn></msup><mo>+</mo><msup><mn>2</mn><mn>2</mn></msup><mo>+</mo><mo>&#8230;</mo><mo>+</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mi>n</mi></mfrac><mo>-</mo><msup><mfenced separators=\"|\"><mfrac><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mi>n</mi></mrow><mi>n</mi></mfrac></mfenced><mn>2</mn></msup><mo>=</mo><mn>10</mn></math></p><p><math><mo>&#8658;</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>6</mn></mrow></mfrac><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>10</mn></math></p><p><math><mo>&#8658;</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn><mo>=</mo><mn>120</mn><mo>&#8658;</mo><mi>n</mi><mo>=</mo><mn>11</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>var</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo>&#8230;</mo><mo>.</mo><mo>,</mo><mn>2</mn><mi>m</mi></mrow></mfenced><mo>=</mo><mn>16</mn><mo>&#8658;</mo><mi>var</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>&#8230;</mo><mo>.</mo><mo>,</mo><mi>m</mi></mrow></mfenced><mo>=</mo><mn>4</mn></math></p><p><math><mo>&#8658;</mo><msup><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn><mo>=</mo><mn>48</mn><mo>&#8658;</mo><mi>m</mi><mo>=</mo><mn>7</mn><mo>&#8658;</mo><mi>m</mi><mo>+</mo><mi>n</mi><mo>=</mo><mn>18</mn></math></p>"
