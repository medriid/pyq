  "question": {
    "text": "The mean and variance of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math> observations are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn></math>, respectively. If five observations are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>12</mn><mo>,</mo><mn>14</mn></math> then the absolute difference of the remaining two observations is :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
      "is_correct": false
    },
