  "question": {
    "text": "The variance of the first <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>50</mn></math> even natural numbers is :"
  },
  "options": [
    {
      "text": "<math> <mrow> <mn>4</mn> <mn>3</mn> <mn>7</mn> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <mn>4</mn> <mn>3</mn> <mn>7</mn> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <mn>8</mn> <mn>3</mn> <mn>3</mn> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> </mrow> </math>",
