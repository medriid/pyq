  "level": 1,
  "question": {
    "text": "A committee of <math><mn>11</mn></math> member&nbsp;is to be formed from <math><mn>8</mn></math> males and <math><mn>5</mn></math> females. If <math><mi>m</mi></math> is the number of ways the committee is formed with at least <math><mn>6</mn></math> males and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>&nbsp;is the number of ways the committee is formed with at least <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> females, then:",
    "image": null
  },
