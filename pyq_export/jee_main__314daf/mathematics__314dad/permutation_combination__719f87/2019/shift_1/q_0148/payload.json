up><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi><mo>-</mo><mi>r</mi></mrow></msub></math> and<br /><math><mo>&#8658;</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>21</mn></mrow></msup><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>4</mn></mrow></msub><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>21</mn></mrow></msub><mtext>&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;</mtext><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><mrow><maligngroup></maligngroup><mo>&#8757;</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>21</mn></mrow></msub><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><maligngroup></maligngroup><msup><mrow><mi>&#160;</mi></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>20</mn></mrow></msub><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>21</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mtd></mtr><mtr><mtd><mrow><maligngroup></m