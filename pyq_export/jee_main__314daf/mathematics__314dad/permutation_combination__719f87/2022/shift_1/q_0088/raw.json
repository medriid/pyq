  "question": {
    "text": "The total number of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math>-digit numbers, formed by using the digits <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>7</mn></math>&nbsp;without repetition, which are multiple of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math>, is",
    "image": null
  },
