  "question": {
    "text": "Number of ways of arranging <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn></math> identical books into <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> identical shelves where any number of shelves may remain empty is equal to "
  },
  "options": [
