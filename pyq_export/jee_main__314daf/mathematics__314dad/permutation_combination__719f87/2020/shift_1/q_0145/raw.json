  "level": 2,
  "question": {
    "text": "Total number of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>-</mo></math>&nbsp;digit numbers in which only and all the five digits <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>7</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn></math> appears, is",
    "image": null
  },
  "options": [
    {
