  "question": {
    "text": "How many different words can be formed by jumbling the letters in the word MISSISSIPPI in which no two $\\mathrm{S}$ are adjacent?",
    "image": null
  },
  "options": [
    {
      "id": "Fp2RR",
      "text": "\n$8 \\cdot{ }^6 \\mathrm{C}_4 \\cdot{ }^7 \\mathrm{C}_4$\n",
