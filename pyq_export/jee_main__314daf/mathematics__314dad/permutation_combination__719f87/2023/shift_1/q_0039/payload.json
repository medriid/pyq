  "question": {
    "text": "The total number of three-digit numbers, divisible by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math>, which can be formed using the digits <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>,</mo><mo>&#160;</mo><mn>3</mn><mo>,</mo><mo>&#160;</mo><mn>5</mn><mo>,</mo><mo>&#160;</mo><mn>8</mn></math>, if repetition of digits is allowed, is&nbsp;"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>21</mn></math>",
      "is_correct": false
    },
