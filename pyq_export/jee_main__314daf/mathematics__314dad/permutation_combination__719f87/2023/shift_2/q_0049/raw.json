  "question": {
    "text": "Eight persons are to be transported from city&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math> to city&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math> in three cars of different makes. If each car can accommodate at most three persons, then the number of ways, in which they can be transported, is",
    "image": null
  },
  "options": [
    {
      "id": "ZgF0h",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1120</mn></math>",
