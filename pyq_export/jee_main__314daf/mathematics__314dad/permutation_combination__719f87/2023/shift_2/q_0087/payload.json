  "question": {
    "text": "The number of integers, greater than <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7000</mn></math>&nbsp;that can be formed, using the digits&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>8</mn></math>&nbsp;without repetition is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>120</mn></math>",
      "is_correct": false
    },
    {
