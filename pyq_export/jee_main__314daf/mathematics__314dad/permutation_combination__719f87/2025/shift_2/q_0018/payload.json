  "question": {
    "text": "In a group of 3 girls and 4 boys, there are two boys $B_1$ and $B_2$. The number of ways, in which these girls and boys can stand in a queue such that all the girls stand together, all the boys stand together, but $B_1$ and $B_2$ are not adjacent to each other, is :"
  },
  "options": [
    {
      "text": "96",
      "is_correct": false
    },
    {
      "text": "144",
      "is_correct": true
    },
    {
      "text": "120",
      "is_correct": false
    },
    {
      "text": "72",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Total - when $\\mathrm{B}_1$ and $\\mathrm{B}_2$ are together\n$=2!(3!4!)-2!(3!(3!2!))=144$"
  }
}