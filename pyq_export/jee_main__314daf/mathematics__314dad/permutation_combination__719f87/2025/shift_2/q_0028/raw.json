  "question": {
    "text": "The number of ways, 5 boys and 4 girls can sit in a row so that either all the boys sit together or no two boys sit together, is $\\qquad$ -",
    "image": null
  },
  "options": [],
  "correctValue": "17280",
  "solution": {
    "text": "A : number of ways that all boys sit together $=5!\\times 5!$\nB : number of ways if no 2 boys\nsit together $=4!\\times 5$ !\n$\\mathrm{A} \\cap \\mathrm{B}=\\phi$\nRequired no. of ways $=5!\\times 5!+4!\\times 5!=17280$",
    "image": null
  },
