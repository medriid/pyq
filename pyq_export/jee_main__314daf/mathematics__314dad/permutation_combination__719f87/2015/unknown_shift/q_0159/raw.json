      "image": null,
      "isCorrect": false
    },
    {
      "id": "N7Ffc",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><msup><mo>&#183;</mo><mn>7</mn></msup><msub><mi>C</mi><mn>3</mn></msub></math>",
