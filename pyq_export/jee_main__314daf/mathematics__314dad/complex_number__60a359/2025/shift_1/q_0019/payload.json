    },
    {
      "text": "7",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0019_9fe91d3f09e4.png\"><br>\n\n\n\n$\\begin{aligned} & \\because \\mathrm{AB}=\\sqrt{100}=10 \\\\ & \\therefore\\left|\\mathrm{Z}_1-\\mathrm{Z}_2\\right|_{\\min }=10-2-1=7\\end{aligned}$"
  }
