  "question": {
    "text": "Let $z \\in C$ be such that $\\frac{z^2+3 i}{z-2+i}=2+3 i$. Then the sum of all possible values of $z^2$ is",
    "image": null
  },
  "options": [
    {
      "id": "1rkei",
      "text": "$19-2 \\mathrm{i}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sIAeL",
      "text": "$-19-2 \\mathrm{i}$",
      "image": null,
      "isCorrect": true
    },
    {
