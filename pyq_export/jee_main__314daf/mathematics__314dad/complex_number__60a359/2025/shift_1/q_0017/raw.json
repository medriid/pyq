      "image": null,
      "isCorrect": false
    },
    {
      "id": "cjHPW",
      "text": "$\\sqrt{3}+1$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\frac{2+\\mathrm{k}^2 \\mathrm{z}}{\\mathrm{k}+\\overline{\\mathrm{z}}}=\\mathrm{kz} \\\\ & |\\mathrm{z}|^2 \\mathrm{k}=2 \\\\ & \\mathrm{k}=2\\end{aligned}$<br/>point $\\mathrm{p}(2,4)$; center $(1,2)$<br/>distance from circle<br/>$(x-1)^2+(y-2)^2=1$ is max.<br/>if $(\\mathrm{OP}+\\mathrm{r})=\\sqrt{1+4}+1=\\sqrt{5}+1$",
    "image": null
  },
