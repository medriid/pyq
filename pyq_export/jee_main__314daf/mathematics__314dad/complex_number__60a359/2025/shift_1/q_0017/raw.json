  "question": {
    "text": "Let $z$ be a complex number such that $|z|=1$. If $\\frac{2+\\mathrm{k}^2 \\mathrm{z}}{\\mathrm{k}+\\overline{\\mathrm{z}}}=\\mathrm{kz}, \\mathrm{k} \\in \\mathbf{R}$, then the maximum distance of $\\mathrm{k}+\\mathrm{ik}^2$ from the circle $|\\mathrm{z}-(1+2 \\mathrm{i})|=1$ is:",
    "image": null
  },
  "options": [
    {
      "id": "DIQKk",
      "text": "$\\sqrt{5}+1$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "FnUd7",
      "text": "2",
      "image": null,
      "isCorrect": false
    },
    {
