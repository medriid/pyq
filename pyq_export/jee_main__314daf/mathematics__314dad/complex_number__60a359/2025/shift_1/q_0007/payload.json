  "question": {
    "text": "Let $z \\in C$ be such that $\\frac{z^2+3 i}{z-2+i}=2+3 i$. Then the sum of all possible values of $z^2$ is"
  },
  "options": [
    {
      "text": "$19-2 \\mathrm{i}$",
      "is_correct": false
    },
    {
      "text": "$-19-2 \\mathrm{i}$",
      "is_correct": true
    },
    {
      "text": "$19+2 i$",
      "is_correct": false
    },
    {
      "text": "$-19+2 i$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$z^2+3 i=z(2+3 i)-7-4 i$<br/>$\\mathrm{z}^2-\\mathrm{z}(2+3 \\mathrm{i})+7+7 \\mathrm{i}=0$<img src=\"assets\\st0007_c7074810cd07.png\"/><br/>$\\begin{aligned}<br/>& z_1^2+z_2^2=\\left(z_1+z_2\\right)^2-2 z_1 z_2 \\\\\n& =4-9+12 i-14-14 i \\\\\n& =-19-2 i<br/>\\end{aligned}$"
  }
