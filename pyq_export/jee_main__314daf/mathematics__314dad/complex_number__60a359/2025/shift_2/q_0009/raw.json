  "question": {
    "text": "Let $\\mathrm{A}=$<br/>$\\left\\{\\theta \\in[0,2 \\pi]: 1+10 \\operatorname{Re}\\left(\\frac{2 \\cos \\theta+i \\sin \\theta}{\\cos \\theta-3 i \\sin \\theta}\\right)=0\\right\\} .$<br/>Then $\\sum_{\\theta \\in A} \\theta^2$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "HmOmX",
      "text": "$\\frac{21}{4} \\pi^2$",
      "image": null,
      "isCorrect": true
    },
