  "solution": {
    "text": "Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mi>cos</mi><mo>&#160;</mo><mi>&#952;</mi><mo>+</mo><mi>i</mi><mo>&#160;</mo><mi>sin</mi><mo>&#160;</mo><mi>&#952;</mi></math><br /><br />Then, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>z</mi></mrow><mrow><mn>1</mn><mo>+</mo><mover><mi>z</mi><mo>&#175;</mo></mover></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>cos</mi><mo>&#160;</mo><mi>&#952;</mi><mo>+</mo><mi>i</mi><mo>&#160;</mo><mi>sin</mi><mo>&#160;</mo><mi>&#952;</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>cos</mi><mo>&#160;</mo><mi>&#952;</mi><mo>-</mo><mi>i</mi><mo>&#160;</mo><mi>sin</mi><mo>&#160;</mo><mi>&#952;</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>2</mn><mo>&#160;</mo><msup><mi>cos</mi><mn>2</mn></msup><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mo>+</mo><mi>i</mi><mo>&#183;</mo><mn>2</mn><mo>&#160;</mo><mi>sin</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mi>cos</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mrow><mrow><mn>2</mn><mo>&#160;</mo><msup><mi>cos</mi><mn>2</mn></msup><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mo>-</mo><mi>i</mi><mo>&#183;</mo><mn>2</mn><mo>&#160;</mo><mi>sin</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mi>cos</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi>cos</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mo>+</mo><mi>i</mi><mo>&#160;</mo><mi>sin</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mrow><mrow><mi>cos</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mo>-</mo><mi>i</mi><mo>&#160;</mo><mi>sin</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mfenced><mrow><mi>cos</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mo>+</mo><mi mathvariant=\"normal\">i</mi><mo>&#16