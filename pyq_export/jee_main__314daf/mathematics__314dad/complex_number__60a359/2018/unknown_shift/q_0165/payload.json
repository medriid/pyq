  "solution": {
    "text": "<p>For&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>w</mi></math>&nbsp;to be purely imaginary,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>1</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mi>z</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>z</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mover><mi>z</mi><mo>&#175;</mo></mover></mrow><mrow><mn>1</mn><mo>-</mo><mover><mi>z</mi><mo>&#175;</mo></mover></mrow></mfrac><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>1</mn><mo>-</mo><mover><mi>z</mi><mo>&#175;</mo></mover><mo>+</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mi>z</mi><mo>-</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mo>+</mo><mn>1</mn><mo>-</mo><mi>z</mi><mo>+</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mover><mi>z</mi><mo>&#175;</mo></mover><mo>-</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mo>-</mo><mfenced separators=\"|\"><mrow><mi>z</mi><mo>+</mo><mover><mi>z</mi><mo>&#175;</mo></mover></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>8</mn><mi>&#945;</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>z</mi><mo>+</mo><mover><mi>z</mi><mo>&#175;</mo></mover></mrow></mfenced><mo>-</mo><mn>2</mn><mo>+</mo><mn>16</mn><mi>&#945;</mi><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>8</mn><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mi>z</mi><mo>+</mo><mover><mi>z</mi>