    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mfrac><mi>&#960;</mi><mn>12</mn></mfrac><mo>-</mo><mi>i</mi><mi>sin</mi><mfrac><mi>&#960;</mi><mn>12</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>2</mn></msqrt><mfenced><mrow><mi>cos</mi><mfrac><mi>&#960;</mi><mn>12</mn></mfrac><mo>+</mo><mi>i</mi><mi>sin</mi><mfrac><mi>&#960;</mi><mn>12</mn></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>2</mn></msqrt><mfenced><mrow><mi>cos</mi><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>12</mn></mfrac><mo>+</mo><mi>i</mi><mi>sin</mi><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>12</mn></mfrac></mrow></mfenced></math>",
