      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo>)</mo></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "VpiwI",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math>",
      "isCorrect": false,
