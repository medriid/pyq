    },
    {
      "id": "eAdPk",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>0</mn><mo>,</mo><mo>-</mo><mn>2</mn><mo>)</mo></math>",
      "isCorrect": true,
