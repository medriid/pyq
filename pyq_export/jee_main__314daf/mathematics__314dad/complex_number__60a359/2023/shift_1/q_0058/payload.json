  "question": {
    "text": "<p>For all <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>&#8712;</mo><mi>C</mi></math> on the curve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub><mo>:</mo><mo>|</mo><mi>z</mi><mo>|</mo><mo>=</mo><mn>4</mn></math>, let the locus of the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">z</mi><mo>+</mo><mfrac><mn>1</mn><mi mathvariant=\"normal\">z</mi></mfrac></math> be the curve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub></math>. Then</p>"
  },
  "options": [
    {
      "text": "the curves <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">C</mi><mn>2</mn></msub></math>intersect at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> points",
      "is_correct": true
    },
    {
      "text": "the curves <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub></math>&nbsp;lies inside <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "the curves <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub></math>&nbsp;intersect at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math> points",
      "is_correct": false
    },
    {
      "text": "the curves <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub></math>&nbsp;lies inside <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub></math>",
