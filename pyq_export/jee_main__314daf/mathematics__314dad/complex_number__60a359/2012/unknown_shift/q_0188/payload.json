  "question": {
    "text": "$\\left|z_1+z_2\\right|^2+\\left|z_1-z_2\\right|^2$ is equal to"
  },
  "options": [
    {
      "text": "\n$2\\left(\\left|z_1\\right|+\\left|z_2\\right|\\right.$\n",
      "is_correct": false
    },
    {
      "text": "\n$2\\left(\\left|z_1\\right|^2+\\left|z_2\\right|^2\\right)$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\left|z_1\\right|\\left|z_2\\right|$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left|z_1\\right|^2+\\left|z_2\\right|^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\left|z_1+z_2\\right|^2+\\left|z_1-z_2\\right|^2$\n$$\n=\\left|z_1\\right|^2+\\left|z_2\\right|^2+2\\left|z_1\\right|\\left|z_2\\right|+\\left|z_1\\right|^2+\\left|z_2\\right|^2-2\\left|z_1\\right|\\left|z_2\\right|\n$$\n$$\n=2\\left|z_1\\right|^2+2\\left|z_2\\right|^2=2\\left[\\left|z_1\\right|^2+\\left|z_2\\right|^2\\right]\n$$"
  }
}