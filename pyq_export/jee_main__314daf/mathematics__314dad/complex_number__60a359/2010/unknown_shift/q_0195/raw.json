  "question": {
    "text": "The number of complex numbers $z$ such that $|z-1|=|z+1|=|z-i|$ equals",
    "image": null
  },
  "options": [
    {
      "id": "IKGCj",
      "text": "\n1\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "WYHD3",
      "text": "\n2\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a7Per",
      "text": "\n$\\infty$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7U6wK",
      "text": "\n0",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Let $z=x+i y$\n$$\n\\begin{array}{lll}\n|z-1|=|z+1| & \\Rightarrow \\operatorname{Re} z=0 & \\Rightarrow x=0 \\\\\n|z-1|=|z-i| & \\Rightarrow x=y & \\\\\n|z+1|=|z-i| & \\Rightarrow y=-x &\n\\end{array}\n$$\nOnly $(0,0)$ will satisfy all conditions.\n$\\Rightarrow$ Number of complex number $z=1$",
    "image": null
  },
