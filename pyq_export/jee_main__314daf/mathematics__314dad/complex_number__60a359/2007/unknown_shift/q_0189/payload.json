  "question": {
    "text": "If $|z+4| \\leq 3$, then the maximum value of $|z+1|$ is"
  },
  "options": [
    {
      "text": "\n$4$\n",
      "is_correct": false
    },
    {
      "text": "\n$10$\n",
      "is_correct": false
    },
    {
      "text": "\n$6$\n",
      "is_correct": true
    },
    {
      "text": "\n$0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "From the Argand diagram maximum value of $|z+1|$ is $6$.\nAlternative:\n$\\begin{aligned}\n& |z+1|=|z+4-3| \\\\\n& \\leq|z+4|+|-3|=6.\n\\end{aligned}$\n<img src=\"assets\\st0189_087c355bb3de.png\"><br>"
  }
}