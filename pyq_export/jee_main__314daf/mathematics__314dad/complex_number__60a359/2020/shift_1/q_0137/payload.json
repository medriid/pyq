  "solution": {
    "text": "<p>Let&nbsp;<math><mi>z</mi><mo>=</mo><mi>x</mi><mo>+</mo><mi>i</mi><mi>y</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mfrac><mrow><mi>z</mi><mo>-</mo><mn>1</mn></mrow><mrow><mn>2</mn><mi>z</mi><mo>+</mo><mi>i</mi></mrow></mfrac></mfenced><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi>i</mi><mi>y</mi></mrow><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>i</mi><mi>y</mi></mrow></mfenced><mo>+</mo><mi>i</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi>i</mi><mi>y</mi></mrow><mrow><mn>2</mn><mi>x</mi><mo>+</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>y</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>i</mi></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>y</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>i</mi></mrow><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>y</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>i</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mi>e</mi><mfenced separators=\"|\"><mfrac><mrow><mi>z</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn><mi>z</mi><mo>+</mo><mi>i</mi></mrow></mfrac></mfenced><mo>=</mo><mfrac><mrow><mn>2</mn><mi>x</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi>y</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><msup><mfenced><mrow><mn>2</mn><mi>y</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mn>1</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><msup><mi>x</mi><mn