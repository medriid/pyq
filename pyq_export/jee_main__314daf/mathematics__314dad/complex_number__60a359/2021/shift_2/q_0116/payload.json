  "solution": {
    "text": "<p>Let</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi><mo>+</mo><mn>2</mn><mi>i</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>z</mi><mo>=</mo><mfrac><mrow><mfenced><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi></mrow></mfenced><mo>-</mo><mn>2</mn><mi>i</mi><mi>sin</mi><mi>&#952;</mi></mrow><mrow><mfenced><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi><mo>+</mo><mn>2</mn><mi>i</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfenced><mfenced><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi><mo>-</mo><mn>2</mn><mi>i</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>z</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><mo>-</mo><mn>2</mn><mi>i</mi><mi>sin</mi><mi>&#952;</mi></mrow><mrow><mo>(</mo><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi><msup><mo>)</mo><mn>2</mn></msup><mo>+</mo><mn>4</mn><msup><mi>sin</mi><mn>2</mn></msup><mi>&#952;</mi></mrow></mfrac></math></p><p>Put,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mi>&#952;</mi><mo>=</mo><mn>2</mn><mi>sin</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mi>cos</mi><mfrac><mi>&#952;</mi><mn>2</mn></mfrac><mo>,</mo><mo>&#160;</mo><mn>1</mn><mo>-</mo><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>z</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><mo>-</mo><mn>4</mn><mi>i</mi><mi>sin</mi><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><mi>cos</mi><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced></mrow><mrow><mn>4</mn><msup><mi>sin</mi><mn>4</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><mo>+</mo><mn>16</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><msup><mi>cos</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced></mrow></mfrac></math></p><p>Hence,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mi>e</mi><mfenced><mi>z</mi></mfenced><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced></mrow><mrow><mn>4</mn><msup><mi>sin</mi><mn>4</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><mo>+</mo><mn>16</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><msup><mi>cos</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced><mo>+</mo><mn>8</mn><msup><mi>cos</mi><mn>2</mn></msup><mfenced><mstyle displaystyle=\"true\"><mfrac><mi>&#952;</mi><mn>2</mn></mfrac></mstyle></mfenced></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>5</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msup><mi>sin</mi><mn>2</mn></ms