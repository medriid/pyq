      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>|</mo><mi>z</mi><mo>+</mo><mi>i</mi><mi>z</mi><msup><mo>|</mo><mn>2</mn></msup></math>",
