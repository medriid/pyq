    },
    {
      "id": "5JA54",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>|</mo><mi>z</mi><msup><mo>|</mo><mn>2</mn></msup></math>",
