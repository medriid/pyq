  ],
  "solution": {
    "text": "<p>If a complex number is purely imaginary, then it must be equal to negative of its conjugate.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>z</mi><mo>-</mo><mi>&#945;</mi></mrow><mrow><mi>z</mi><mo>+</mo><mi>&#945;</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfenced><menclose notation=\"top\"><mfrac><mrow><mi>z</mi><mo>-</mo><mi>&#945;</mi></mrow><mrow><mi>z</mi><mo>+</mo><mi>&#945;</mi></mrow></mfrac></menclose></mfenced><mo>&#8658;</mo><mfrac><mrow><mi>z</mi><mo>-</mo><mi>&#945;</mi></mrow><mrow><mi>z</mi><mo>+</mo><mi>&#945;</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfenced separators=\"|\"><mfrac><mrow><mover><mi>z</mi><mo>-</mo></mover><mo>-</mo><mi>&#945;</mi></mrow><mrow><mover><mi>z</mi><mo>-</mo></mover><mo>+</mo><mi>&#945;</mi></mrow></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced><mrow><mi>z</mi><mo>-</mo><mi>&#945;</mi></mrow></mfenced><mfenced><mrow><mover><mi>z</mi><mo>-</mo></mover><mo>+</mo><mi>&#945;</mi></mrow></mfenced><mo>=</mo><mfenced><mrow><mi>z</mi><mo>+</mo><mi>&#945;</mi></mrow></mfenced><mfenced><mrow><mover><mi>z</mi><mo>-</mo></mover><mo>-</mo><mi>&#945;</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mi>z</mi><mover><mi>z</mi><mo>-</mo></mover><mo>+</mo><mi>&#945;</mi><mi>z</mi><mo>-</mo><mi>&#945;</mi><mover><mi>z</mi><mo>-</mo></mover><mo>-</mo><msup><mi>&#945;</mi><mn>2</mn></msup><mo>=</mo><mo>-</mo><mfenced separators=\"|\"><mrow><mi>z</mi><mover><mi>z</mi><mo>-</mo></mover><mo>-</mo><mi>&#945;</mi><mi>z</mi><mo>+</mo><mi>&#945;</mi><mover><mi>z</mi><mo>-</mo></mover><mo>-</mo><msup><mi>&#945;</mi><mn>2</mn></msup></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mi>z</mi></mfenced><mn>2</mn></msup><mo>=</mo><msup><mi>&#945;</mi><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mo>&#160;</mo><mfenced close=\"]\" open=\"[\"><mrow><mo>&#8757;</mo><mfenced close=\"|\" open=\"|\"><mi>z</mi></mfenced><mo>=</mo><mn>2</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#945;</mi><mo>=</mo><mo>&#177;</mo><mn>2</mn></math></p>"
