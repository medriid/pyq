  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi></math> are two complex numbers such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>z</mi><mi>&#969;</mi></mrow></mfenced><mo>=</mo><mn>1</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>r</mi><mi>g</mi><mfenced separators=\"|\"><mi>z</mi></mfenced><mo>-</mo><mi>a</mi><mi>r</mi><mi>g</mi><mrow><mo>(</mo><mi>&#969;</mi><mo>)</mo></mrow><mo>=</mo><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></mfrac></math>, then:",
    "image": null
  },
  "options": [
    {
      "id": "koLFs",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mover><mi mathvariant=\"normal\">&#969;</mi><mo>&#175;</mo></mover><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mi>i</mi></mrow><msqrt><mn>2</mn></msqrt></mfrac></math>",
      "isCorrect": false,
