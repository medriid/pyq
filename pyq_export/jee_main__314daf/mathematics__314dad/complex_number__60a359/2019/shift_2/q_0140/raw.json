    },
    {
      "id": "PftYy",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>z</mi><mo>&#175;</mo></mover><mi mathvariant=\"normal\">&#969;</mi><mo>=</mo><mo>-</mo><mi>i</mi></math>",
