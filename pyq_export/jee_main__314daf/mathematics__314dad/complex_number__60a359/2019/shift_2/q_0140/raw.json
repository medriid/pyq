      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>z</mi><mo>&#175;</mo></mover><mi>&#969;</mi><mo>=</mo><mi>i</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QzdDI",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mover><mi mathvariant=\"normal\">&#969;</mi><mo>&#175;</mo></mover><mo>=</mo><mfrac><mrow><mo>-</mo><mn>1</mn><mo>+</mo><mi>i</mi></mrow><msqrt><mn>2</mn></msqrt></mfrac></math>",
      "isCorrect": false,
