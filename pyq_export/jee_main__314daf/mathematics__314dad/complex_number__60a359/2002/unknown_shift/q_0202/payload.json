  "question": {
    "text": "$z$ and $w$ are two non zero complex no.s such that $|z|=|w|$ and $\\operatorname{Arg} z+\\operatorname{Arg} w=\\pi$ then $z$ equals"
  },
  "options": [
    {
      "text": "\n$\\overline{\\mathrm{W}}$\n",
      "is_correct": false
    },
    {
      "text": "\n-$\\overline{\\mathrm{W}}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{W}$\n",
      "is_correct": false
    },
    {
      "text": "\n-$\\mathrm{W}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Let $|\\mathrm{z}|=|\\omega|=\\mathrm{r} \\quad \\therefore \\mathrm{z}=\\mathrm{re}^{\\mathrm{i} \\theta}, \\omega=\\mathrm{re}^{\\mathrm{i} \\phi}$ where $\\theta+\\phi=\\pi \\quad \\therefore \\bar{\\omega}=\\mathrm{re}^{-\\mathrm{i \\phi}}$ $\\therefore z=\\mathrm{re}^{i(\\pi-\\phi)}=\\mathrm{re}^{\\mathrm{i} \\pi} \\cdot \\mathrm{e}^{-i \\phi}=-\\mathrm{re}^{-i \\phi}=-\\bar{\\omega}$"
  }
}