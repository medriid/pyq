      "text": "<math><mn>1</mn></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p><math><mi>&#969;</mi><mo>=</mo><mi>&#160;</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mi>i</mi></math> (cube root of unity)<br /><br />So,&nbsp;<math><mn>1</mn><mo>+</mo><mi>&#969;</mi><mo>+</mo><msup><mrow><mi>&#969;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>0</mn></math>&nbsp; and&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mo>&#969;</mo><mn>3</mn></msup><mo>=1</mo></math><br /><br />Now <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mi>&#969;</mi></mtd><mtd><msup><mrow><mi>&#969;</mi></mrow><mrow><mn>2</mn></mrow></msup></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><msup><mrow><mi>&#969;</mi></mrow><mrow><mn>2</mn></mrow></msup></mtd><mtd><mi>&#969;</mi></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mn>3</mn><mfenced separators=\"|\"><mrow><msup><mrow><mi>&#969;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mi>&#969;</mi></mrow></mfenced></math><br /><br />So <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><msup><mi>&#969;</mi><mn>2</mn></msup><mo>-</mo><mi>&#969;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>k</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>-</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mi>i</mi></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mi>i</mi></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>k</mi><mo>=</mo><mo>-</mo><msqrt><mn>3</mn></msqrt><mi>i</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>k</mi><mo>=</mo><mo>-</mo><mi>z</mi></math></p>"
