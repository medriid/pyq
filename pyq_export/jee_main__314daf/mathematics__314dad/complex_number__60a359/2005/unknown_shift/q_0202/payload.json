  "question": {
    "text": "If the cube roots of unity are $1, \\omega, \\omega^2$ then the roots of the equation $(x-1)^3+8=0$, are"
  },
  "options": [
    {
      "text": "\n$-1,-1+2 \\omega,-1-2 \\omega^2$\n",
      "is_correct": false
    },
    {
      "text": "\n$-1,-1,-1$\n",
      "is_correct": false
    },
    {
      "text": "\n$-1,1-2 \\omega, 1-2 \\omega^2$\n",
      "is_correct": true
    },
    {
      "text": "\n$-1,1+2 \\omega, 1+2 \\omega^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
