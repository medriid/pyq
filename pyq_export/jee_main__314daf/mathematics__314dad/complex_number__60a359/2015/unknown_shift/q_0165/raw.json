  "solution": {
    "text": "<p>Let,&nbsp;<math><mrow><mi>z</mi><mo>=</mo><mi>r</mi><mo stretchy=\"false\">(</mo><mtext>cos</mtext><mi>&#952;</mi><mo>+</mo><mi>i</mi><mtext>sin</mtext><mi>&#952;</mi><mo stretchy=\"false\">)</mo></mrow> </math><br /><br /><math> <mrow> <msup> <mi>z</mi> <mn>5</mn> </msup> <mo>=</mo><msup> <mi>r</mi> <mn>5</mn> </msup> <mo stretchy=\"false\">(</mo><mtext>cos</mtext><mn>5</mn><mi>&#952;</mi><mo>+</mo><mi>i</mi><mtext>sin</mtext><mn>5</mn><mi>&#952;</mi><mo stretchy=\"false\">)</mo></mrow> </math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mi>m</mi><mfenced><msup><mi>z</mi><mn>5</mn></msup></mfenced><mo>=</mo><msup><mi>r</mi><mn>5</mn></msup><mi>sin</mi><mn>5</mn><mi>&#952;</mi></math><br /><br />and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced separators=\"|\"><mrow><mi>I</mi><mi>m</mi><mi>&#160;</mi><mi>z</mi></mrow></mfenced><mn>5</mn></msup><mo>=</mo><msup><mi>r</mi><mn>5</mn></msup><msup><mi>sin</mi><mn>5</mn></msup><mi>&#952;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>I</mi><mi>m</mi><mi>&#160;</mi><mo>(</mo><msup><mi>z</mi><mn>5</mn></msup><mo>)</mo></mrow><msup><mfenced separators=\"|\"><mrow><mi>I</mi><mi>m</mi><mi>&#160;</mi><mi>z</mi></mrow></mfenced><mn>5</mn></msup></mfrac><mo>=</mo><mi>&#160;</mi><mfrac><mrow><mi>sin</mi><mn>5</mn><mi>&#952;</mi></mrow><mrow><msup><mi>sin</mi><mn>5</mn></msup><mi>&#952;</mi></mrow></mfrac><mo>=</mo><mi>A&#160;</mi></math>(Let)<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>d</mi><mi>A</mi></mrow><mrow><mi>d</mi><mi>&#952;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5</mn><msup><mi>sin</mi><mn>5</mn></msup><mi>&#952;</mi><mi>cos</mi><mn>5</mn><mi>&#952;</mi><mo>-</mo><mn>5</mn><mi>sin</mi><mn>5</mn><mi>&#952;</mi><msup><mi>sin</mi><mn>4</mn></msup><mi>&#952;</mi><mi>cos</mi><mi>&#952;</mi></mrow><msup><mfenced separators=\"|\"><mrow><msup><mi>sin</mi><mn>5</mn></msup><mi>&#952;</mi></mrow></mfenced><mn>2</mn></msup></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>d</mi><mi>A</mi></mrow><mrow><mi>d</mi><mi>&#952;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5</mn><msup><mi>sin</mi><mn>4</mn></msup><mi>&#952;</mi><mfenced separators=\"|\"><mrow><mi>sin</mi><mi>&#952;</mi><mi>cos</mi><mn>5</mn><mi>&#952;</mi><mo>-</mo><mi>sin</mi><mn>5</mn><mi>&#952;</mi><mi>cos</mi><mi>&#952;</mi></mrow></mfenced></mrow><mrow><msup><mi>sin</mi><mn>10</mn></msup><mi>&#952;</mi></mrow></mfrac></math><br /><br /><math> <mrow> <mo>&#8658;</mo><mfrac> <mrow> <mi>d</mi><mi>A</mi></mrow> <mrow> <mi>d</mi><mi>&#952;</mi></mrow> </mfrac> <mo>=</mo><mfrac> <mn>5</mn> <mrow> <msup> <mrow> <mi>sin</mi></mrow> <mn>6</mn> </msup> <mi>&#952;</mi></mrow> </mfrac> <mfenced close=\"]\" open=\"[\"> <mrow> <mi>sin</mi><mfenced> <mrow> <mo>&#8722;</mo><mn>4</mn><mi>&#952;</mi></mrow> </mfenced></mrow> </mfenced><mo>=</mo><mn>0</mn></mrow> </math><br /><br /><math><mo>&#8658;</mo><mi>&#952;</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></math><br /><br />The minimum value of <math><mi>A</mi></math> will be at &nbsp;<math><mi>&#952;</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac><mo>.</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>A</mi><mo>=</mo><mfrac><mrow><mi>sin</mi><mn>5</mn><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></mrow><msup><mfenced separators=\"|\"><mrow><mi>sin</mi><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></mrow></mfenced><mn>5</mn></msup></mfrac></math><br /><math><mo>=</mo><mfrac><mfrac><mrow><mo>-</mo><mn>1</mn></mrow><msqrt><mn>2</mn></msqrt></mfrac><msup><mfenced separators=\"|\"><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac></mfenced><mn>5</mn></msup></mfrac></math><br /><br /><math><mo>=</mo><mo>-</mo><msup><mfenced separators=\"|\"><msqrt><mn>2</mn></msqrt></mfenced><mn>4</mn></msup><mo>=</mo><mo>-</mo><mn>4</mn></mat