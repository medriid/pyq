  "level": 3,
  "question": {
    "text": "The area of the polygon, whose vertices are the non-real roots of the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>z</mi><mo>&#175;</mo></mover><mo>=</mo><mi>i</mi><msup><mi>z</mi><mn>2</mn></msup></math>&nbsp;is",
    "image": null
  },
  "options": [
    {
      "id": "CLZ67",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow><mn>2</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "DoIjC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow><mn>4</mn></mfrac></math>",
