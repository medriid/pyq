  "question": {
    "text": "The number of points of intersection <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mi>z</mi><mo>-</mo><mfenced><mrow><mn>4</mn><mo>+</mo><mn>3</mn><mi>i</mi></mrow></mfenced><mo>|</mo><mo>=</mo><mn>2</mn></mrow></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mi>z</mi></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\"><mrow><mi>z</mi><mo>-</mo><mn>4</mn></mrow></mfenced><mo>=</mo><mn>6</mn><mo>,</mo><mi>z</mi><mo>&#8712;</mo><mi>C</mi></math>&nbsp;is",
    "image": null
  },
