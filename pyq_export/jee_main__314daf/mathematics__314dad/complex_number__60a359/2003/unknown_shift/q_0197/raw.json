  "question": {
    "text": "If $\\left(\\frac{1+i}{1-i}\\right)^x=1$ then",
    "image": null
  },
  "options": [
    {
      "id": "NFast",
      "text": "\n$x=2 n+1$, where $n$ is any positive integer\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "42zIM",
      "text": "\n$x=4 n$, where $n$ is any positive integer\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "r5xEz",
      "text": "\n$x=2 n$, where $n$ is any positive integer\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sP4dQ",
      "text": "\n$x=4 n+1$, where $n$ is any positive integer",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\left(\\frac{1+\\mathrm{i}}{1-\\mathrm{i}}\\right)^{\\mathrm{x}}=1 \\Rightarrow\\left[\\frac{(1+\\mathrm{i})}{1-\\mathrm{i}^2}\\right]^{\\mathrm{x}}=1$\n$\\left(\\frac{1+\\mathrm{i}^2+2 \\mathrm{i}}{1+1}\\right)^{\\mathrm{x}}=1 \\Rightarrow(\\mathrm{i})^{\\mathrm{x}}=1 ; \\quad \\therefore \\mathrm{x}=4 \\mathrm{n} ; \\mathrm{n} \\in 1^{+}$",
    "image": null
  },
