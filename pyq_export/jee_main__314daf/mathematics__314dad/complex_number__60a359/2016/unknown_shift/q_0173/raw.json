      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mfrac><mn>1</mn><msqrt><mn>3</mn></msqrt></mfrac></mfenced></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "kcXyb",
