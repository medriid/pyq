  "question": {
    "text": "Let $z$, $w$ be complex numbers such that $\\bar{z}+i \\bar{w}=0$ and $\\arg z w=\\pi$. Then arg $z$ equals"
  },
  "options": [
    {
      "text": "\n$\\frac{\\pi}{4}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{5 \\pi}{4}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{3 \\pi}{4}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{\\pi}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Here $\\omega=\\frac{z}{i} \\Rightarrow \\arg \\left(z \\cdot \\frac{z}{i}\\right)=\\pi \\Rightarrow 2 \\arg (z)-\\arg (i)=\\pi \\Rightarrow \\arg (z)=\\frac{3 \\pi}{4}$."
  }
}