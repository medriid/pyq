    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"{\" close=\"}\"><mrow><mi>z</mi><mo>:</mo><mo>&#160;</mo><mfenced open=\"|\" close=\"|\"><mi>z</mi></mfenced><mo>=</mo><mn>1</mn></mrow></mfenced></math>",
