    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"{\" close=\"}\"><mrow><mi>z</mi><mo>:</mo><mo>&#160;</mo><mi>z</mi><mo>=</mo><mover><mi>z</mi><mo>&#175;</mo></mover></mrow></mfenced></math>",
      "is_correct": false
