  "question": {
    "text": "If $\\omega(\\neq 1)$ is a cube root of unity, and $(1+\\omega)^7=A+B \\omega$. Then $(A, B)$ equals",
    "image": null
  },
  "options": [
    {
      "id": "I3MsJ",
      "text": "\n$(1,1)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "eWCij",
      "text": "\n$(1,0)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AJkYD",
      "text": "\n$(-1,1)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kiCLd",
      "text": "\n$(0,1)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$1+\\omega=-\\omega^2$\n$(1+\\omega)^7=\\left(-\\omega^2\\right)^7=-\\omega^{14}=-\\omega^2=1+\\omega=A+B \\omega \\Rightarrow(A, B)=(1,1)$",
    "image": null
  },
