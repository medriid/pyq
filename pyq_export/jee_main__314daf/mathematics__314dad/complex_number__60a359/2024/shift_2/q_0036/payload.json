    "text": "<p>Given: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mn>2</mn><mo>-</mo><mi>i</mi><mfenced><mrow><mn>2</mn><mi>tan</mi><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>z</mi><mo>=</mo><mn>2</mn><mfenced close=\"]\" open=\"[\"><mrow><mn>1</mn><mo>-</mo><mi>i</mi><mi>tan</mi><mfenced><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>z</mi><mo>=</mo><mn>2</mn><mfenced close=\"]\" open=\"[\"><mrow><mn>1</mn><mo>-</mo><mfrac><mrow><mi>i</mi><mi>sin</mi><mfenced><mstyle displaystyle=\"true\"><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mstyle></mfenced></mrow><mrow><mi>cos</mi><mfenced><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mfenced></mrow></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>z</mi><mo>=</mo><mfrac><mn>2</mn><mrow><mi>cos</mi><mfenced><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mfenced></mrow></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mi>cos</mi><mfenced><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mfenced><mo>-</mo><mi>i</mi><mi>sin</mi><mfenced><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>z</mi><mo>=</mo><mfrac><mn>2</mn><mrow><mi>cos</mi><mfenced><mrow><mi>π</mi><mo>-</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mrow></mfenced></mrow></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mi>cos</mi><mfenced><mrow><mi>π</mi><mo>-</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mrow></mfenced><mo>-</mo><mi>i</mi><mi>sin</mi><mfenced><mrow><mi>π</mi><mo>-</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>8</mn></mfrac></mrow></mfenced></mro