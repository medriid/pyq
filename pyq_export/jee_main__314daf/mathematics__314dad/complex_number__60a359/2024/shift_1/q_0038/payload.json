y</mi><mo>=</mo><mn>1</mn><mo>⇒</mo><msub><mi>z</mi><mn>2</mn></msub><mo>=</mo><mn>1</mn><mo>+</mo><mi>i</mi></math> and for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo>−</mo><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>⇒</mo><mi>y</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>−</mo><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>⇒</mo><msub><mi>z</mi><mn>1</mn></msub><mo>=</mo><mfenced><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac></mrow></mfenced><mo>+</mo><mfrac><mi>i</mi><msqrt><mn>2</mn></msqrt></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><msqrt><mn>2</mn></msqrt><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><msub><mi>z</mi><mn>2</mn></msub></mrow></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><mfenced><mrow><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>+</mo><mn>1</mn></mrow></mfenced><msqrt><mn>2</mn></msqrt><mo>+</mo><mi>i</mi><mo>−</mo><mfenced><mrow><mn>1</mn><mo>+</mo><mi>i</mi></mrow></mfenced></mrow></mfenced><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><msqrt><mn>2</mn></msqrt><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><msub><mi>z</mi><mn>2</mn></msub></mrow></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><mn>1</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mo>+</mo><mi>i</mi><mo>−</mo><mfenced><mrow><mn>1</mn><mo>+</mo><mi>i</mi></mrow></mfenced></mrow></mfenced><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><msup><mfenced close=\"|\" open=\"|\"><mrow><msqrt><mn>2</mn></msqrt><msub><mi>z</mi><mn>1</mn></msub><mo>−</mo><msub><mi>z</mi><mn>2</mn></msub></mrow></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced><msqrt><mn>2</mn></msqrt></mfenced><mn>2</mn></msup></math></p><p><math 