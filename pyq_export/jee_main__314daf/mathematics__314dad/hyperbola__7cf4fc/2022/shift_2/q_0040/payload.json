  "question": {
    "text": "If the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo><mn>1</mn><mo>=</mo><mn>0</mn></math>, is a directrix of the hyperbola <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>6</mn></math>, then the hyperbola passes through the point"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>-</mo><mn>2</mn><msqrt><mn>5</mn></msqrt><mo>,</mo><mn>6</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>-</mo><msqrt><mn>5</mn></msqrt><mo>,</mo><mn>3</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msqrt><mn>5</mn></msqrt><mo>,</mo><mo>-</mo><mn>2</mn></mrow></mfenced></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>2</mn><msqrt><mn>5</mn></msqrt><mo>,</mo><mn>3</mn><msqrt><mn>6</mn></msqrt></mrow></mfenced></math>",
      "is_correct": false
