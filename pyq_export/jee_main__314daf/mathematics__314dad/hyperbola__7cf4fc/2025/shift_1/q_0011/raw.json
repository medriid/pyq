  "question": {
    "text": "Let the foci of a hyperbola be $(1,14)$ and $(1,-12)$. If it passes through the point $(1,6)$, then the length of its latus-rectum is :",
    "image": null
  },
  "options": [
    {
      "id": "nHO23",
      "text": "$\\frac{24}{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YCIO3",
      "text": "$\\frac{25}{6}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kONzz",
      "text": "$\\frac{144}{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jc3Xf",
      "text": "$\\frac{288}{5}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5h-Zdbp0RnuXpuKi0KILS9G9tvgPH_DsETA-W4RJlRg.original.fullsize.png\"><br>\n\n\n\n$\\begin{aligned} & \\mathrm{be}=13, \\mathrm{~b}=5 \\\\ & \\mathrm{a}^2=\\mathrm{b}^2\\left(\\mathrm{e}^2-1\\right) \\\\ & =\\mathrm{b}^2 \\mathrm{e}^2-\\mathrm{b}^2 \\\\ & =169-25=144 \\\\ & \\ell(\\text { LR })=\\frac{2 \\mathrm{a}^2}{\\mathrm{~b}}=\\frac{2 \\times 144}{5}=\\frac{288}{5}\\end{aligned}$",
    "image": null
  },
