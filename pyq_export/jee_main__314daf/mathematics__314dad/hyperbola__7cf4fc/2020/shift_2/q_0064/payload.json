    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mn>20</mn><mn>3</mn></mfrac><mo>,</mo><mo>&#160;</mo><mn>12</mn></mrow></mfenced></math>",
