      "isCorrect": false,
      "image": null
    },
    {
      "id": "Fisa8",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mn>5</mn><mn>3</mn></mfrac><mo>,</mo><mi mathvariant=\"normal\">&#160;</mi><mn>0</mn></mrow></mfenced></math>",
