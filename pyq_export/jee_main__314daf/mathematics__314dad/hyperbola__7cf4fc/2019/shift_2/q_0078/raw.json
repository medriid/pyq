    {
      "id": "RsVcF",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>5</mn><mo>,</mo><mi mathvariant=\"normal\">&#160;</mi><mn>0</mn></mrow></mfenced><mi mathvariant=\"normal\">&#160;</mi></math>",
