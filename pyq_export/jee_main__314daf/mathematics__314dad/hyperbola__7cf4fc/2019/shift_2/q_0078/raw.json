    },
    {
      "id": "u6IrI",
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mi mathvariant=\"normal\"> </mi><mn>0</mn></mrow></mfenced></math>",
      "isCorrect": false,
