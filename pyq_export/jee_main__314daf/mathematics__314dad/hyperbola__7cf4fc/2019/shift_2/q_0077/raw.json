  "question": {
    "text": "If a hyperbola has length of its conjugate axis equal to 5 and the distance between its foci is 13 , then the eccentricity of the hyperbola is:",
    "image": null
  },
  "options": [
    {
      "id": "rV70Y",
      "text": "$\\frac{13}{12}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "iPcOC",
      "text": "2",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "u0Bw6",
      "text": "$\\frac{13}{6}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "weTCE",
      "text": "$\\frac{13}{8}$",
      "isCorrect": false,
      "image": null
