    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi>e</mi><mn>4</mn></msup><mo>-</mo><mn>12</mn><msup><mi>e</mi><mn>2</mn></msup><mo>-</mo><mn>27</mn><mo>=</mo><mn>0</mn></math>",
