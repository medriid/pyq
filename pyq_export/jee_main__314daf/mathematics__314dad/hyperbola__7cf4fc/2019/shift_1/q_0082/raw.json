  "level": 1,
  "question": {
    "text": "If the vertices of a hyperbola be at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn><mo>,</mo><mi>&#160;</mi><mn>0</mn></mrow></mfenced></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mi>&#160;</mi><mn>0</mn></mrow></mfenced></math> and one of its foci be at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>3</mn><mo>,</mo><mi>&#160;</mi><mn>0</mn></mrow></mfenced></math>, then which one of the following points does not lie on this hyperbola ?",
    "image": null
  },
  "options": [
    {
      "id": "hHHdu",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>6</mn><mo>,</mo><mi>&#160;</mi><mn>5</mn><msqrt><mn>2</mn></msqrt></mrow></mfenced></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "8nR4g",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>6</mn><mo>,</mo><mi>&#160;</mi><mn>2</mn><msqrt><mn>10</mn></msqrt></mrow></mfenced></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lOgk9",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>2</mn><msqrt><mn>6</mn></msqrt><mo>,</mo><mi>&#160;</mi><mn>5</mn></mrow></mfenced></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "w4iIq",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mi>&#160;</mi><msqrt><mn>15</mn></msqrt></mrow></mfenced></math>",
      "isCorrect": false,
