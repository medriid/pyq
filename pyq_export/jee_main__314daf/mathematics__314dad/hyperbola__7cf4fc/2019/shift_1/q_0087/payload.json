    {
      "text": "<math><mfenced close=\"]\" separators=\"|\"><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi> </mi><mn>2</mn></mrow></mfenced></math>",
