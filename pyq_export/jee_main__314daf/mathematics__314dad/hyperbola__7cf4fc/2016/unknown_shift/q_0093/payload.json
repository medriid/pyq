    {
      "text": "<math> <mrow><mo>(</mo> <mrow> <mn>0</mn><mo>,</mo><mn>2</mn> </mrow> <mo>)</mo></mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>5</mn><mo>,</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></mrow></mfenced></math>",
