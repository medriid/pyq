  "question": {
    "text": "$\\lim _{x \\rightarrow 0} \\frac{\\sin \\left(\\pi \\cos ^2 x\\right)}{x^2}$ equals"
  },
  "options": [
    {
      "text": "\n$-\\pi$\n",
      "is_correct": false
    },
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n$-1$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\pi$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Consider\n$$\n\\begin{aligned}\n& \\lim _{x \\rightarrow 0} \\frac{\\sin \\left(\\pi \\cos ^2 x\\right)}{x^2} \\\\\n& =\\lim _{x \\rightarrow 0} \\frac{\\sin \\left(\\pi-\\pi \\sin ^2 x\\right)}{x^2} \\\\\n& =\\lim _{x \\rightarrow 0} \\frac{\\sin \\left(\\pi \\sin ^2 x\\right)}{\\pi \\sin ^2 x} \\times \\frac{\\left(\\pi \\sin ^2 x\\right)}{x^2}=\\pi\n\\end{aligned}\n$$"
  }
}