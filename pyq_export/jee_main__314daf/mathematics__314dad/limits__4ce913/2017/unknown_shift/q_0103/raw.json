    "text": "<p>Given,</p><p><math><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>3</mn></mrow></munder></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><msqrt><mn>3</mn><mi>x</mi></msqrt><mo>-</mo><mn>3</mn></mrow><mrow><msqrt><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn></msqrt><mo>-</mo><mi>&#160;</mi><msqrt><mn>2</mn></msqrt></mrow></mfrac></mrow></mrow></math><br /><br />On rationalization&nbsp;we get,<br /><br /><math><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>3</mn></mrow></munder></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mn>3</mn><mi>x</mi><mo>-</mo><mn>9</mn></mrow></mfenced><mo>&#215;</mo><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn></msqrt><mo>+</mo><mi>&#160;</mi><msqrt><mn>2</mn></msqrt></mrow></mfenced></mrow><mrow><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn></mrow></mfenced><mo>-</mo><mn>2</mn></mrow></mfenced><mo>&#215;</mo><mfenced separators=\"|\"><mrow><msqrt><mn>3</mn><mi>x</mi></msqrt><mo>+</mo><mn>3</mn></mrow></mfenced></mrow></mfrac></mrow></mrow></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>3</mn></mrow></munder></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mn>3</mn><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfenced></mrow><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfenced></mrow></mfrac></mrow></mrow><mo>&#215;</mo><mfrac><mrow><msqrt><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn></msqrt><mo>+</mo><mi>&#160;</mi><msqrt><mn>2</mn></msqrt></mrow><mrow><mfenced separators=\"|\"><mrow><msqrt><mn>3</mn><mi>x</mi></msqrt><mo>+</mo><mn>3</mn></mrow></mfenced></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>3</m