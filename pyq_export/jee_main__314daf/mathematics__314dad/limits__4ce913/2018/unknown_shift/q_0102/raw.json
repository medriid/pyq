  "question": {
    "text": "For each <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>&#8712;</mo><mi>R</mi><mo>,</mo></math> let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\" separators=\"|\"><mi>t</mi></mfenced></math> be the greatest integer less than or equal to&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi></math>. Then<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mi>x</mi><mfenced separators=\"|\"><mrow><mfenced open=\"[\" close=\"]\" separators=\"|\"><mfrac><mn>1</mn><mi>x</mi></mfrac></mfenced><mo>+</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mfrac><mn>2</mn><mi>x</mi></mfrac></mfenced><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mfrac><mn>15</mn><mi>x</mi></mfrac></mfenced></mrow></mfenced></math>",
    "image": null
  },
  "options": [
    {
      "id": "gziob",
      "text": "does not exist <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>in</mi><mo>&#160;</mo><mi>R</mi></mrow></mfenced></math>",
