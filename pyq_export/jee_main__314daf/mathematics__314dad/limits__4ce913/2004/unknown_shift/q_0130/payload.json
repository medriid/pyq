  "question": {
    "text": "Let $f(x)=\\frac{1-\\tan x}{4 x-\\pi}, x \\neq \\frac{\\pi}{4}, x \\in\\left[0, \\frac{\\pi}{2}\\right]$. If $f(x)$ is continuous in $\\left[0, \\frac{\\pi}{2}\\right]$, then $f\\left(\\frac{\\pi}{4}\\right)$ is"
  },
  "options": [
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$-\\frac{1}{2}$\n",
      "is_correct": true
    },
    {
      "text": "\n$-1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$f(x)=\\frac{1-\\tan x}{4 x-\\pi} \\Rightarrow \\lim _{x \\rightarrow \\frac{\\pi}{4}} \\frac{1-\\tan x}{4 x-\\pi}=-\\frac{1}{2}$"
  }
}