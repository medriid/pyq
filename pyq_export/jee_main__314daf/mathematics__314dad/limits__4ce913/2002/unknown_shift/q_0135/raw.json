  "question": {
    "text": "Let $f(x)=4$ and $f^{\\prime}(x)=4$. Then $\\operatorname{Lim}_{x \\rightarrow 2} \\frac{x f(2)-2 f(x)}{x-2}$ is given by",
    "image": null
  },
  "options": [
    {
      "id": "T40ce",
      "text": "\n2\n",
      "image": null,
      "isCorrect": false
    },
    {
