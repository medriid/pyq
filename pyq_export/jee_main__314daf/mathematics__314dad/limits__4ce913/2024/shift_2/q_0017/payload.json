  "question": {
    "text": "$\\lim _{x \\rightarrow 0} \\frac{e-(1+2 x)^{\\frac{1}{2 x}}}{x}$ is equal to"
  },
  "options": [
    {
      "text": "0",
      "is_correct": false
    },
    {
      "text": "$\\frac{-2}{e}$",
      "is_correct": false
    },
    {
      "text": "e",
      "is_correct": true
    },
    {
      "text": "$e-e^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\operatorname{Lim}_{x \\rightarrow 0} \\frac{e-e^{\\frac{1}{2 x} \\ln (1+2 x)}}{x} \\\\ & =\\operatorname{Lim}_{x \\rightarrow 0}(-e) \\frac{\\left(e^{\\frac{\\ln (1+2 x)}{2 x}-1}-1\\right)}{x} \\\\ & =\\operatorname{Lim}_{x \\rightarrow 0}(-e) \\frac{\\ln (1+2 x)-2 x}{2 x^2} \\\\ & =(-e) \\times(-1) \\frac{4}{2 \\times 2}=e\\end{aligned}$"
  }
}