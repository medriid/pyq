    "text": "<p>Given limit can be written as</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>1</mn><mo>-</mo></msup></mrow></munder><mfrac><mrow><msqrt><mi>&#960;</mi></msqrt><mo>-</mo><msqrt><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></msqrt></mrow><msqrt><mn>1</mn><mo>-</mo><mi>x</mi></msqrt></mfrac><mo>&#215;</mo><mfrac><mrow><msqrt><mi>&#960;</mi></msqrt><mo>+</mo><msqrt><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></msqrt></mrow><mrow><msqrt><mi>&#960;</mi></msqrt><mo>+</mo><msqrt><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></msqrt></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>L</mi><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>1</mn><mo>-</mo></msup></mrow></munder><mfrac><mrow><mi>&#960;</mi><mo>-</mo><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow><mrow><msqrt><mn>1</mn><mo>-</mo><mi>x</mi></msqrt><mi>&#160;</mi><mfenced separators=\"|\"><mrow><msqrt><mi>&#960;</mi></msqrt><mo>+</mo><msqrt><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></msqrt></mrow></mfenced></mrow></mfrac><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>1</mn><mo>-</mo></msup></mrow></munder><mfrac><mrow><mn>2</mn><msup><mi>cos</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow><mrow><msqrt><mn>1</mn><mo>-</mo><mi>x</mi></msqrt><mi>&#160;</mi><mfenced separators=\"|\"><mrow><msqrt><mi>&#960;</mi></msqrt><mo>+</mo><msqrt><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></msqrt></mrow></mfenced></mrow></mfrac></math></p><p>Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>K</mi><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>1</mn><mo>-</mo></msup></mrow></munde