  "question": {
    "text": "If&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mrow><msup><mi>e</mi><mrow><mi>a</mi><mi>x</mi></mrow></msup><mo>-</mo><mi>cos</mi><mo>(</mo><mi>b</mi><mi>x</mi><mo>)</mo><mo>-</mo><mfrac><mrow><mi>c</mi><mi>x</mi><msup><mi>e</mi><mrow><mo>-</mo><mi>c</mi><mi>x</mi></mrow></msup></mrow><mn>2</mn></mfrac></mrow><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mo>(</mo><mn>2</mn><mi>x</mi><mo>)</mo></mrow></mfrac><mo>=</mo><mn>17</mn></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></math>&nbsp;is equal to",
    "image": null
  },
