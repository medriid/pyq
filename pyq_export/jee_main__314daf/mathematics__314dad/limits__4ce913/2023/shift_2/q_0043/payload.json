      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mo>-</mo><mn>7</mn><mo>.</mo><mn>5</mn><mo>,</mo><mo>-</mo><mn>6</mn><mo>.</mo><mn>5</mn><mo>]</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><mo>-</mo><mn>7</mn><mo>.</mo><mn>5</mn><mo>,</mo><mo>-</mo><mn>6</mn><mo>.</mo><mn>5</mn></mrow></mfenced></math>",
      "is_correct": false
