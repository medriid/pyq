  "correctValue": null,
  "solution": {
    "text": "<p>Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mfenced><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>1</mn><mo>&#160;&#160;</mo><mo>&#8756;</mo><mo>&#160;&#160;</mo><mi>&#945;</mi><mo>=</mo><mn>2</mn></math></p><p>Now,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><mfrac><msqrt><mn>1</mn><mo>&#8722;</mo><mi>cos</mi><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>&#8722;</mo><mi>x</mi><mo>&#8722;</mo><mn>2</mn></mrow></mfenced></msqrt><mrow><mi>x</mi><mo>&#8722;</mo><mn>2</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><mfrac><msqrt><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mfenced><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>&#8722;</mo><mi>x</mi><mo>&#8722;</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mfenced></msqrt><mrow><mi>x</mi><mo>&#8722;</mo><mn>2</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><msqrt><mn>2</mn></msqrt><mo>&#183;</mo><mfrac><mfenced open=\"|\" close=\"|\"><mrow><mi>sin</mi><mfenced><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mfenced></mrow></mfenced><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><msqrt><mn>2</mn></msqrt><mo>&#183;</mo><mfrac><mrow><mi>sin</mi><mfenced><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mfenced></mrow><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfrac></math>&nbsp;(because&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#62;</mo><mn>2</mn></math>)</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><mo>&#160;</mo><mfrac><mrow><msqrt><mn>2</mn></msqrt><mi>sin</mi><mfenced><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mfenced></mrow><mrow><mfenced><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mfenced><mo>&#183;</mo><mn>2</mn></mrow></mfrac><mo>&#183;</mo><mfenced><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn></mrow><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><msup><mn>2</mn><mo>+</mo></msup></mrow></munder><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>&#183;</mo><mfrac><mrow><mfenced><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mfenced><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mfenced><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>3</mn><msqrt><mn>2</mn></msqrt></mfrac></math>.</p>",
