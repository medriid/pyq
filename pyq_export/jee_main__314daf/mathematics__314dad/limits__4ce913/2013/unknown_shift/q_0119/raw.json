  "question": {
    "text": "The value of $\\lim _{x \\rightarrow 0} \\frac{1}{x}\\left[\\tan ^{-1}\\left(\\frac{x+1}{2 x+1}\\right)-\\frac{\\pi}{4}\\right]$ is :",
    "image": null
  },
  "options": [
    {
      "id": "dPz1W",
      "text": "\n1\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7zIBm",
      "text": "\n$-\\frac{1}{2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "DTyVW",
      "text": "\n2\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rRfCy",
      "text": "\n0",
      "image": null,
      "isCorrect": false
    }
