  "question": {
    "text": "If $\\lim _{x \\rightarrow 0} \\frac{\\log (3+x)-\\log (3-x)}{x}=k$, the value of $k$ is"
  },
  "options": [
    {
      "text": "\n$-\\frac{2}{3}$\n",
      "is_correct": false
    },
    {
      "text": "\n0\n",
      "is_correct": false
    },
    {
      "text": "\n$-\\frac{1}{3}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{2}{3}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\operatorname{Lim}_{x \\rightarrow 0} \\frac{\\log (3+x)-\\log (3-x)}{x}=K$ (by L'Hospital rule)\n$\\operatorname{Lim}_{x \\rightarrow 0} \\frac{\\frac{1}{3+x}-\\frac{-1}{3-x}}{1}=K \\quad \\therefore \\frac{2}{3}=\\mathrm{K}$"
  }
}