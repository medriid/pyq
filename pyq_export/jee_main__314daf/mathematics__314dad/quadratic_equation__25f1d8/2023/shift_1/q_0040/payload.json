  "question": {
    "text": "<p>The sum of all the roots of the equation&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>x</mi><mo>+</mo><mn>15</mn></mrow></mfenced><mo>-</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>7</mn><mo>=</mo><mn>0</mn></math>&nbsp;is</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>-</mo><msqrt><mn>3</mn></msqrt></math>",
