  "question": {
    "text": "The number of real roots of the equation&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mfenced open=\"|\" close=\"|\"><mi>x</mi></mfenced><mo>-</mo><mn>5</mn><mfenced open=\"|\" close=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mn>6</mn><mo>=</mo><mn>0</mn></math>, is",
    "image": null
  },
  "options": [
    {
      "id": "yx1zV",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math>",
      "image": null,
