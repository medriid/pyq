  "solution": {
    "text": "<blockquote><p>Given,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><msqrt><mn>2</mn></msqrt><mi>x</mi><mo>+</mo><mn>2</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><msqrt><mn>2</mn></msqrt><mo>&#177;</mo><msqrt><mn>6</mn></msqrt><mi>i</mi></mrow><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mfenced><mfrac><mrow><mn>1</mn><mo>&#177;</mo><msqrt><mn>3</mn></msqrt><mi>i</mi></mrow><mn>2</mn></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mfenced><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#177;</mo><mfrac><mrow><msqrt><mn>3</mn></msqrt><mi>i</mi></mrow><mn>2</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mfenced><mrow><mi>cos</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac><mo>&#177;</mo><mi>i</mi><mi>sin</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac></mrow></mfenced></math></p><p>So,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mfenced><mrow><mi>cos</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac><mo>+</mo><mi>i</mi><mi>sin</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac></mrow></mfenced><mo>=</mo><msqrt><mn>2</mn></msqrt><msup><mi>e</mi><mfrac><mi>i&#960;</mi><mn>3</mn></mfrac></msup></math></p><p>And&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mfenced><mrow><mi>cos</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac><mo>-</mo><mi>i</mi><mi>sin</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac></mrow></mfenced><mo>=</mo><msqrt><mn>2</mn></msqrt><msup><mi>e</mi><mfrac><mrow><mo>-</mo><mi>i&#960;</mi></mrow><mn>3</mn></mfrac></msup></math></p><p>Now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><msup><mfenced><mrow><msqrt><mn>2</mn></msqrt><msup><mi>e</mi><mfrac><mi>i&#960;</mi><mn>3</mn></mfrac></msup></mrow></mfenced><mn>14</mn></msup><mo>+</mo><msup><mfenced><mrow><msqrt><mn>2</mn></msqrt><msup><mi>e</mi><mfrac><mrow><mo>-</mo><mi>i&#960;</mi></mrow><mn>3</mn></mfrac></msup></mrow></mfenced><mn>14</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><msup><mfenced><msqrt><mn>2</mn></msqrt></mfenced><mn>14</mn></msup><mfenced><mrow><msup><mi>e</mi><mfrac><mrow><mi>i</mi><mn>14</mn><mi>&#960;</mi></mrow><mn>3</mn></mfrac></msup><mo>+</mo><msup><mi>e</mi><mfrac><mrow><mo>-</mo><mi>i</mi><mn>14</mn><mi>&#960;</mi></mrow><mn>3</mn></mfrac></msup></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><msup><mfenced><msqrt><mn>2</mn></msqrt></mfenced><mn>14</mn></msup><mfenced><mrow><mi>cos</mi><mfrac><mrow><mn>14</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac><mo>+</mo><mi>i</mi><mi>sin</mi><mfrac><mrow><mn>14</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac><mo>+</mo><mi>cos</mi><mfrac><mrow><mn>14</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac><mo>-</mo><mi>i</mi><mi>sin</mi><mfrac><mrow><mn>14</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><msup><mn>2</mn><mn>7</mn></msup><mfenced><mrow><mn>2</mn><mi>cos</mi><mfrac><mrow><mn>14</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><msup><mn>2</mn><mn>8</mn></msup><mfenced><mrow><mi>cos</mi><mfenced><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi><mo>+</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mrow></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><msup><mn>2</mn><mn>8</mn></msup><mfenced><mrow><mi>cos</mi><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>&#945;</mi><mn>14</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>14</mn></msup><mo>=</mo><mo>-</mo><msup><mn>2</mn><mn>8</mn></msup><mo>&#215;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>=</mo><mo>-</mo><mn>128</mn></math></p></blockquote>"
