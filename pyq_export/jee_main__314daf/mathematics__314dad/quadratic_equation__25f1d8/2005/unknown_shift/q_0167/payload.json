  "question": {
    "text": "If roots of the equation $x^2-b x+c=0$ be two consectutive integers, then $b^2-4 c$ equals"
  },
  "options": [
    {
      "text": "\n$-2$\n",
      "is_correct": false
    },
    {
      "text": "\n3\n",
      "is_correct": false
    },
    {
      "text": "\n2\n",
      "is_correct": false
    },
    {
      "text": "\n1",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Let $\\alpha, \\alpha+1$ be roots\n$$\n\\begin{aligned}\n& \\alpha+\\alpha+1=b \\\\\n& \\alpha(\\alpha+1)=c \\\\\n& \\therefore b^2-4 c=(2 \\alpha+1)^2-4 \\alpha(\\alpha+1)=1 .\n\\end{aligned}\n$$"
  }
}