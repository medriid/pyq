  "question": {
    "text": "The value of $\\alpha$ for which the sum of the squares of the roots of the equation $x^2-(a-2) x-a-1=0$ assume the least value is",
    "image": null
  },
  "options": [
    {
      "id": "ju7P6",
      "text": "\n1\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "FCvlG",
      "text": "\n0\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cZQOS",
      "text": "\n3\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bdS35",
      "text": "\n2",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& x^2-(a-2) x-a-1=0 \\\\\n& \\Rightarrow \\alpha+\\beta=a-2 \\\\\n& \\alpha \\beta=-(a+1) \\\\\n& \\alpha^2+\\beta^2=(\\alpha+\\beta)^2-2 \\alpha \\beta \\\\\n& \\quad=a^2-2 a+6=(a-1)^2+5 \\\\\n& \\Rightarrow a=1 .\n\\end{aligned}\n$$",
    "image": null
  },
