  "question": {
    "text": "If the difference between the roots of the equation $x^2+a x+1=0$ is less than $\\sqrt{5}$, then the set of possible values of $a$ is",
    "image": null
  },
  "options": [
    {
      "id": "MAmlA",
      "text": "\n$(-3,3)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "6oAef",
      "text": "\n$(-3, \\infty)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CmCNJ",
      "text": "\n$(3, \\infty)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dficm",
      "text": "\n$(-\\infty,-3)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$x^2+a x+1=0$\n$\\alpha+\\beta=-a \\quad \\alpha \\beta=1$\n$|\\alpha-\\beta|=\\sqrt{(\\alpha+\\beta)^2-4 \\alpha \\beta}$\n$|\\alpha-\\beta|=\\sqrt{a^2-4}$\n$\\sqrt{a^2-4} < \\sqrt{5}$\n$a^2-4 < 5$\n$a^2-9 < 0$\n$a \\in(-3,3)$.",
    "image": null
  },
