  "question": {
    "text": "The sum of all the solutions of the equation $(8)^{2 x}-16 \\cdot(8)^x+48=0$ is :",
    "image": null
  },
  "options": [
    {
      "id": "UqsAt",
      "text": "$1+\\log _8(6)$",
      "image": null,
      "isCorrect": true
    },
    {
