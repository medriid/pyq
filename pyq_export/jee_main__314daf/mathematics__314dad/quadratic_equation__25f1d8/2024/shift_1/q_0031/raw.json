  "question": {
    "text": "If 2 and 6 are the roots of the equation $a x^2+b x+1=0$, then the quadratic equation, whose roots are $\\frac{1}{2 a+b}$ and $\\frac{1}{6 a+b}$, is :",
    "image": null
  },
  "options": [
    {
      "id": "E2rsy",
      "text": "$2 x^2+11 x+12=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LJs2D",
      "text": "$x^2+8 x+12=0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jxsIx",
      "text": "$4 x^2+14 x+12=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XqHtB",
      "text": "$x^2+10 x+16=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Sum }=8=-\\frac{b}{a} \\\\ & \\text { Product }=12=\\frac{1}{a} \\quad \\Rightarrow a=\\frac{1}{12} \\\\ & b=-\\frac{2}{3} \\\\ & 2 a+b=\\frac{2}{12}-\\frac{2}{3}=-\\frac{1}{2} \\\\ & 6 a+b=\\frac{6}{12}-\\frac{2}{3}=-\\frac{1}{6} \\\\ & \\text { sum }=-8 \\\\ & P=12 \\\\ & x^2+8 x+12=0\\end{aligned}$",
    "image": null
  },
