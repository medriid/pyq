  "question": {
    "text": "The number of solutions, of the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>e</mi><mrow><mi>sin</mi><mi>x</mi></mrow></msup><mo>−</mo><mn>2</mn><msup><mi>e</mi><mrow><mo>−</mo><mi>sin</mi><mi>x</mi></mrow></msup><mo>=</mo><mn>2</mn></math> is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "is_correct": false
    },
    {
