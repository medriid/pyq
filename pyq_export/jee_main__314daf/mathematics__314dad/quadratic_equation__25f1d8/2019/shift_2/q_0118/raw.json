    },
    {
      "id": "WYg8m",
      "text": "<math><mi>d</mi><mo>,</mo><mi> </mi><mi>e</mi><mo>,</mo><mi> </mi><mi>f</mi></math> are in A.P.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "wArPS",
      "text": "<math><mi> </mi><mi>d</mi><mo>,</mo><mi> </mi><mi>e</mi><mo>,</mo><mi> </mi><mi>f</mi></math> are in G.P.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "KVOKt",
      "text": "<math><mfrac><mrow><mi>d</mi></mrow><mrow><mi>a</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>e</mi></mrow><mrow><mi>b</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>f</mi></mrow><mrow><mi>c</mi></mrow></mfrac></math> are in G.P.",
      "isCorrect": false,
