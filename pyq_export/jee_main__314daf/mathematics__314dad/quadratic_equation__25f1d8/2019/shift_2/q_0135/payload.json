      "text": "<math><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,</mo><mi> </mi><mn>4</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mo>(</mo><mn>5</mn><mo>,</mo><mi> </mi><mn>6</mn><mo>)</mo></math>",
      "is_correct": false
