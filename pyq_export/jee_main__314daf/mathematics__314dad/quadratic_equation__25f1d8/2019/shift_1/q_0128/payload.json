  "solution": {
    "text": "<p>Given,</p><p>&nbsp; &nbsp; &nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><msqrt><mi>x</mi></msqrt><mfenced separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>4</mn></mrow></mfenced><mo>+</mo><mn>2</mn><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mi>x</mi><mo>-</mo><mn>4</mn><msqrt><mi>x</mi></msqrt><mo>+</mo><mn>2</mn><mo>=</mo><mn>0</mn><mi>&#160;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><msup><mfenced separators=\"|\"><msqrt><mi>x</mi></msqrt></mfenced><mn>2</mn></msup><mo>-</mo><mn>4</mn><msqrt><mi>x</mi></msqrt><mo>+</mo><mn>4</mn><mo>=</mo><mn>2</mn></math>&nbsp; &nbsp; &nbsp;&nbsp; (Adding <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>&nbsp;on both sides)<br /><math><mo>&#8658;</mo><msup><mrow><mfenced separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><mn>2</mn></math><br /><math><mo>&#8658;</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>t</mi><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn><mi>&#160;</mi></math>;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><mi>t</mi><mo>&#160;</mo><mo>;</mo><mo>&#160;</mo><mfenced><mrow><mi>t</mi><mo>&#62;</mo><mn>0</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>t</mi><mo>=</mo><mn>1</mn></math>or&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mo>-</mo><mn>2</mn></math>&nbsp;; Rejected because&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>&#62;</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><msqrt><mi>x</mi></msqrt><mo>=</mo><mn>3</mn></math> or <math><msqrt><mi>x</mi></msqrt><mo>=</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>9</mn></math> or <math><mi>x</mi><mo>=</mo><mn>1</mn></math><br />Hence, the required sum <math><mo>=</mo><mn>10</mn></math>.</p>"
