      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>p</mi><mn>2</mn></msup><mo>&#8211;</mo><mn>4</mn><mi>q</mi><mo>&#8211;</mo><mn>12</mn><mo>=</mo><mn>0</mn></math>",
      "isCorrect": true,
