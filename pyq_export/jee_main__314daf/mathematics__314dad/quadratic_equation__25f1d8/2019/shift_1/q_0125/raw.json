      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>p</mi><mo>+</mo><mn>14</mn><mo>=</mo><mn>0</mn></math>",
      "isCorrect": false,
