  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\text { (I) } x \\lt 2 \\\\\n& -x^2+2 x-3 x+9+1=0 \\\\\n& \\Rightarrow x^2+x-10=0 \\\\\n& \\Rightarrow x=\\frac{-1+\\sqrt{41}}{2}, \\frac{-1-\\sqrt{41}}{2} \\\\\n& \\quad \\times \\quad \\sqrt{ }<br/>\\end{aligned}$<br/>$\\begin{aligned}<br/>& \\text { (II) } 2 \\leq x \\lt 3 \\\\\n& \\Rightarrow x^2-2 x-3 x+9+1=0 \\\\\n& \\Rightarrow x^2-5 x+10=0 \\\\\n& \\text { D } \\lt 0 \\\\\n& \\text { (III) } x \\geq 3 \\\\\n& x^2-2 x+3 x-9+2=0 \\\\\n& \\Rightarrow x^2+x-8=0 \\\\\n& x=\\frac{-1+\\sqrt{32}}{2}, \\frac{-1-\\sqrt{32}}{2} \\\\\n& \\quad \\times \\quad \\times<br/>\\end{aligned}$<br/>1 real roots",
    "image": null
