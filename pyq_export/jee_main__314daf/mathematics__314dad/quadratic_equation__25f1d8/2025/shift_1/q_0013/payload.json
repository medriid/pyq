  "question": {
    "text": "Consider the equation $\\mathrm{x}^2+4 \\mathrm{x}-\\mathrm{n}=0$, where $\\mathrm{n} \\in[20,100]$ is a natural number. Then the number of all distinct values of $n$, for which the given equation has integral roots, is equal to"
  },
  "options": [
    {
      "text": "7",
      "is_correct": false
    },
    {
      "text": "8",
      "is_correct": false
    },
    {
      "text": "6",
      "is_correct": true
    },
    {
      "text": "5",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\mathrm{x}^2+4 \\mathrm{x}+4=\\mathrm{n}+4 \\\\\n& (\\mathrm{x}+2)^2=\\mathrm{n}+4 \\\\\n& \\mathrm{x}=-2 \\pm \\sqrt{\\mathrm{n}+4} \\\\\n& \\because 20 \\leq \\mathrm{n} \\leq 100 \\\\\n& \\sqrt{24} \\leq \\sqrt{\\mathrm{n}+4} \\leq \\sqrt{104} \\\\\n& \\Rightarrow \\sqrt{\\mathrm{n}+4} \\in\\{5,6,7,8,9,10\\}<br/>\\end{aligned}$<br/>$\\therefore ' 6$ ' integral values of ' $n$ ' are possible"
  }
}