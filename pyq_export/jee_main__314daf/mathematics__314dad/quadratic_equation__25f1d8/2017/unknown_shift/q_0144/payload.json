  "solution": {
    "text": "&nbsp;Assume ,&nbsp;<math><mi>p</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>a</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>b</mi><mi>x</mi><mo>+</mo><mi>c</mi></math><br /><br />Given ,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mfenced separators=\"|\"><mn>0</mn></mfenced><mo>=</mo><mn>1</mn><mo>&#8658;</mo><mi>c</mi><mo>=</mo><mn>1</mn></math><br /><br />Now,<math><mfenced close=\"]\" open=\"\" separators=\"|\"><mrow><mtable><mtr><mtd><mi>p</mi><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced><mo>=</mo><mn>4</mn></mtd></mtr><mtr><mtd><mi>p</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mn>6</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mi>&#160;</mi><mo>=</mo><mn>4</mn></mtd></mtr><mtr><mtd><mi>a</mi><mo>-</mo><mi>b</mi><mo>+</mo><mi>&#160;</mi><mi>c</mi><mo>=</mo><mn>6</mn></mtd></mtr></mtable></mfenced><mo>&#8658;</mo><mfenced open=\"\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mn>1</mn><mi>&#160;</mi><mo>=</mo><mn>4</mn></mtd></mtr><mtr><mtd><mi>a</mi><mo>-</mo><mi>b</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>6</mn></mtd></mtr></mtable></mfenced><mi>&#160;</mi><mspace linebreak=\"newline\"/><mfenced open=\"\" close=\"]\" separators=\"|\"><mrow><mfenced open=\"\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mi>a</mi><mo>+</mo><mi>b</mi><mi>&#160;</mi><mo>=</mo><mn>3</mn></mtd></mtr><mtr><mtd><mi>a</mi><mo>-</mo><mi>b</mi><mo>=</mo><mn>5</mn></mtd></mtr></mtable></mfenced><mi>&#160;</mi><mo>&#8658;</mo><mtable><mtr><mtd><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mi>a</mi><mo>=</mo><mn>4</mn></mtd></mtr><mtr><mtd><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&