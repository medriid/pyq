  "question": {
    "text": "If $p$ and $q$ are the roots of the equation $x^2+p x+q=0$, then",
    "image": null
  },
  "options": [
    {
      "id": "QMJXQ",
      "text": "\np =1, q = -2\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "D5Uou",
      "text": "\np = 0, q = 1\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W379X",
      "text": "\np = -2, q = 0\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UCVGq",
      "text": "\np = -2, q = 1",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$p+q=-p$ and $p q=q \\Rightarrow q(p-1)=0 \\Rightarrow q=0$ or $p=1$\nIf $q=0$, then $p=0$. i.e. $p=q \\quad \\therefore p=1$ and $q=-2$",
    "image": null
  },
