  "question": {
    "text": "The number of real roots of the equation, <math><msup><mrow><mi>e</mi></mrow><mrow><mn>4</mn><mi>x</mi></mrow></msup><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mn>3</mn><mi>x</mi></mrow></msup><mo>-</mo><mn>4</mn><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn><mi>x</mi></mrow></msup><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math> is:"
  },
  "options": [
    {
      "text": "<math><mn>1</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>3</mn></math>",
