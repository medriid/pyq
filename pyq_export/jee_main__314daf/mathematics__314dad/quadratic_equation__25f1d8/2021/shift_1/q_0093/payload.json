  "question": {
    "text": "The value of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>3</mn><mo>+</mo><mo>&#8230;</mo><mo>&#8734;</mo></mrow></mfrac></mrow></mfrac></mrow></mfrac></mrow></mfrac></math>&nbsp;is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>+</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></math>",
