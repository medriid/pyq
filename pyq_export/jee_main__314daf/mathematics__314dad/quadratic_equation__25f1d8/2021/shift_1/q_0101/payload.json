  "solution": {
    "text": "Consider <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><msup><mi>p</mi><mn>2</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><msup><mi>p</mi><mn>2</mn></msup><msup><mi>q</mi><mn>2</mn></msup><mo>=</mo><mn>272</mn></math><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><msup><mfenced><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><mi>p</mi><mi>q</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><msup><mi>p</mi><mn>2</mn></msup><msup><mi>q</mi><mn>2</mn></msup><mo>=</mo><mn>272</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><mo>-</mo><mn>16</mn><mi>p</mi><mi>q</mi><mo>+</mo><mn>2</mn><msup><mi>p</mi><mn>2</mn></msup><msup><mi>q</mi><mn>2</mn></msup><mo>=</mo><mn>272</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><mi>p</mi><mi>q</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>p</mi><mi>q</mi><mo>-</mo><mn>128</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><mi>p</mi><mi>q</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>p</mi><mi>q</mi><mo>-</mo><mn>128</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mi>q</mi><mo>=</mo><mfrac><mrow><mn>8</mn><mo>&#177;</mo><mn>24</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mn>16</mn><mo>,</mo><mo>-</mo><mn>8</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;&#160;</mo><mi>p</mi><mi>q</mi><mo>=</mo><mn>16</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;&#160;</mo></math>Required equation</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>:</mo><mo>&#160;</mo><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mfenced><mn>2</mn></mfenced><mi>x</mi><mo>+</mo><mn>16</mn><mo>=</mo><mn>0</mn></math></p>"
