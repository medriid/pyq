  "question": {
    "text": "The probability of selecting integers <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>&#8712;</mo><mfenced open=\"[\" close=\"]\"><mrow><mo>-</mo><mn>5</mn><mo>,</mo><mn>30</mn></mrow></mfenced></math>&nbsp;such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mo>&#160;</mo><mfenced><mrow><mi>a</mi><mo>+</mo><mn>4</mn></mrow></mfenced><mo>&#160;</mo><mi>x</mi><mo>-</mo><mn>5</mn><mi>a</mi><mo>+</mo><mn>64</mn><mo>&#62;</mo><mn>0</mn></math>, for all&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mi>R</mi></math>, is:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>7</mn><mn>36</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>9</mn></mfrac></math>",
      "is_correct": true
    },
