    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><msup><mi>&#946;</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#945;</mi><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mi>&#946;</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#945;</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#946;</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></math>",
