  "question": {
    "text": "In a binomial distribution $B\\left(n, p=\\frac{1}{4}\\right)$, if the probability of at least one success is greater than or equal to $\\frac{9}{10}$, then $n$ is greater than"
  },
  "options": [
    {
      "text": "\n$\\frac{1}{\\log _{10}{ }^4-\\log _{10}{ }^3}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{1}{\\log _{10} 4+\\log _{10} 3}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{9}{\\log _{10}{ }^4-\\log _{10} 3}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{4}{\\log _{10}{ }^4-\\log _{10} 3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n1-q^n \\geq \\frac{9}{10} \\Rightarrow\\left(\\frac{3}{4}\\right)^n \\leq \\frac{1}{10} \\Rightarrow n \\geq-\\log _{\\frac{3}{4}} 10 \\Rightarrow n \\geq \\frac{1}{\\log _{10}{ }^4-\\log _{10}{ }^3}\n$$"
  }
}