      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>{</mo><mi>x</mi><mo>&#8712;</mo><mi>R</mi><mo>:</mo><mo>|</mo><mi>x</mi><mo>-</mo><mn>5</mn><mo>|</mo><mo>&#8804;</mo><mn>1</mn><mo>}</mo></math>",
      "is_correct": false
