  "question": {
    "text": "<p>Two squares are chosen at random on a chessboard (see figure). The probability that they have a side in common is :</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f24da50c-1bca-49e3-8233-876270f8b013-image.png\" style=\"width: 355px; height: 218px;\" /></p>",
    "image": null
  },
