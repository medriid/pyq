  "level": 3,
  "question": {
    "text": "A bag contains <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn></math>&nbsp;balls. Two balls are drawn from it at random and both are found to be black. The probability that the bag contains at least <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math> black balls is",
    "image": null
  },
  "options": [
    {
      "id": "Ajsau",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mn>7</mn></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "PzJkU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>7</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "mZtAE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>7</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "xmmU3",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mn>6</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
