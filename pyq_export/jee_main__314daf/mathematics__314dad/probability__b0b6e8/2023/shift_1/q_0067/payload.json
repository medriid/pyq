  "question": {
    "text": "Fifteen football players of a club-team are given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn></math> T-shirts with their names written on the backside. If the players pick up the T-shirts randomly, then the probability that at least <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> players pick the correct T-shirt is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mn>24</mn></mfrac></math>",
      "is_correct": false
    },
