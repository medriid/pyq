  "question": {
    "text": "<p>Three dice are rolled. If the probability of getting different numbers on the three dice is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>p</mi><mi>q</mi></mfrac><mo>,</mo></math>&nbsp;where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi></math>&nbsp;are co-prime, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi><mo>-</mo><mi>p</mi></math>&nbsp;is equal to</p>",
    "image": null
  },
  "options": [
    {
      "id": "FiIOU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
