  "question": {
    "text": "If $C$ and $D$ are two events such that $C \\subset D$ and $P(D) \\neq 0$, then the correct statement among the following is",
    "image": null
  },
  "options": [
    {
      "id": "DfBYA",
      "text": "\n$P(C \\mid D) \\geq P(C)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "rA0LS",
      "text": "\n$P(C \\mid D) < P(C)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6OsNQ",
      "text": "\n$P(C \\mid D)=\\frac{P(D)}{P(C)}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9MYH3",
      "text": "\n$P(C \\mid D)=P(C)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{C} \\cap \\mathrm{D}=\\mathrm{C} \\Rightarrow \\mathrm{P}(\\mathrm{C} \\cap \\mathrm{D})=\\mathrm{P}(\\mathrm{C}) \\Rightarrow \\mathrm{P}\\left(\\frac{\\mathrm{C}}{\\mathrm{D}}\\right)=\\frac{\\mathrm{P}(\\mathrm{C} \\cap \\mathrm{D})}{\\mathrm{P}(\\mathrm{D})} \\geq \\mathrm{P}(\\mathrm{C})$",
    "image": null
  },
