  "question": {
    "text": "Five horses are in a race. Mr. A selects two of the horses at random and bets on them. The probability that Mr. A selected the winning horse is"
  },
  "options": [
    {
      "text": "\n$\\frac{2}{5}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{4}{5}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{3}{5}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{5}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{n}(\\mathrm{S})={ }^5 \\mathrm{C}_2 ; \\mathrm{n}(\\mathrm{E})={ }^2 \\mathrm{C}_1+{ }^2 \\mathrm{C}_1$\n$\\mathrm{p}(\\mathrm{E})=\\frac{\\mathrm{n}(\\mathrm{E})}{\\mathrm{n}(\\mathrm{S})}=\\frac{{ }^2 \\mathrm{C}_1+{ }^2 \\mathrm{C}_1}{{ }^5 \\mathrm{C}_2}=\\frac{2}{5}$"
  }
