  "question": {
    "text": "An urn contains nine balls of which three are red, four are blue and two are green. Three balls are drawn at random without replacement from the urn. The probability that the three balls have different colour is",
    "image": null
  },
  "options": [
    {
      "id": "RZ9DH",
      "text": "\n$\\frac{2}{7}$\n",
      "image": null,
      "isCorrect": true
