  "question": {
    "text": "A die is tossed 5 times. Getting an odd number is considered a success. Then the variance of distribution of success is",
    "image": null
  },
  "options": [
    {
      "id": "lFugR",
      "text": "\n8/3\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "roqeM",
      "text": "\n3/8\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DsOPw",
      "text": "\n4/5\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PyWXx",
      "text": "\n5/4",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The event follows binomial distribution with n = 5, p = 3/6 = 1/2\n$q=1-p=1 / 2 \\quad \\therefore$ Variance $n p q=5 / 4$",
    "image": null
  },
