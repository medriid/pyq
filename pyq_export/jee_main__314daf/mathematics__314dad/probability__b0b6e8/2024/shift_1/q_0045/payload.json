≥</mo><mn>6</mn><mo>)</mo><mo>=</mo><msup><mfenced><mfrac><mn>5</mn><mn>6</mn></mfrac></mfenced><mn>5</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi mathvariant=\"normal\">c</mi><mo>=</mo><mi mathvariant=\"normal\">P</mi><mfenced><mfrac><mrow><mi mathvariant=\"normal\">X</mi><mo>≥</mo><mn>6</mn></mrow><mrow><mi mathvariant=\"normal\">X</mi><mo>&gt;</mo><mn>3</mn></mrow></mfrac></mfenced><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">P</mi><mfenced><mrow><mfenced><mrow><mi mathvariant=\"normal\">X</mi><mo>≥</mo><mn>6</mn></mrow></mfenced><mo>∩</mo><mfenced><mrow><mi mathvariant=\"normal\">X</mi><mo>&gt;</mo><mn>3</mn></mrow></mfenced></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">P</mi><mfenced><mrow><mi mathvariant=\"normal\">X</mi><mo>&gt;</mo><mn>3</mn></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">P</mi><mfenced><mrow><mi mathvariant=\"normal\">X</mi><mo>≥</mo><mn>6</mn></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">P</mi><mfenced><mrow><mi mathvariant=\"normal\">X</mi><mo>&gt;</mo><mn>3</mn></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><msup><mfenced><mfrac><mn>5</mn><mn>6</mn></mfrac></mfenced><mn>5</mn></msup><msup><mfenced><mfrac><mn>5</mn><mn>6</mn></mfrac></mfenced><mn>3</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi mathvariant=\"normal\">c</mi><mo>=</mo><mfrac><mn>25</mn><mn>36</mn></mfrac><mo> </mo><mo> </mo><mo> </mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mrow><mi>i</mi><mi>i</mi><mi>i</mi></mrow></mfenced></math></p><p>Using <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>i</mi></mfenced><mo>,</mo><mo> </mo><mfenced><mrow><mi>i</mi><mi>i</mi></mrow></mfenced><mo> </mo><mtext>and</mtext><mo> </mo><mfenced><mrow><mi>i</mi><mi>i</mi><mi>i</mi></mrow></mfenced></math>,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi mathvariant=\"normal\">b</mi><mo>+</