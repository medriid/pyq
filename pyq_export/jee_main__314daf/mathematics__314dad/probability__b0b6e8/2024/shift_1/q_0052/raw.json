  "question": {
    "text": "A fair die is thrown until <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math> appears. Then the probability, that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math> appears in even number of throws, is",
    "image": null
  },
  "options": [
    {
      "id": "twU2t",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mn>6</mn></mfrac></math>",
