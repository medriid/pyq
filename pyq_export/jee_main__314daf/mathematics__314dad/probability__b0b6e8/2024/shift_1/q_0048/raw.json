      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mn>25</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4pPnc",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rt84e",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mn>75</mn></mfrac></math>",
      "image": null,
