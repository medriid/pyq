  "question": {
    "text": "Two marbles are drawn in succession from a box containing <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn></math> red, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn></math> white, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn></math> blue and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn></math> orange marbles, with replacement being made after each drawing. Then the probability, that first drawn marble is red and second drawn marble is white, is",
    "image": null
  },
  "options": [
    {
      "id": "cdEd0",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>25</mn></mfrac></math>",
