  "question": {
    "text": "If an unbiased dice is rolled thrice, then the probability of getting a greater number in the $i^{\\text {th }}$ roll than the number obtained in the $(i-1)^{\\text {th }}$ roll, $i=2,3$, is equal to",
    "image": null
  },
  "options": [
