  "correctValue": null,
  "solution": {
    "text": "Favourable cases $={ }^6 \\mathrm{C}_3$\nTotal out comes $=6^3$\nProbability of getting greater number than previous\n$\\text {one }=\\frac{{ }^6 \\mathrm{C}_3}{\\mathrm{r}^3}=\\frac{20}{216}=\\frac{5}{54}$",
    "image": null
