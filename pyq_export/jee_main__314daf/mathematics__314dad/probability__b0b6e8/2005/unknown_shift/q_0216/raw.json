  "question": {
    "text": "A random variable $X$ has Poisson distribution with mean 2. Then $P(X>1.5)$ equals",
    "image": null
  },
  "options": [
    {
      "id": "eYDQ4",
      "text": "\n$\\frac{2}{\\mathrm{e}^2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PzGuI",
      "text": "\n0\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yiExg",
      "text": "\n$1-\\frac{3}{\\mathrm{e}^2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "EXOCv",
      "text": "\n$\\frac{3}{\\mathrm{e}^2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& P(x=k)=e^{-\\lambda} \\frac{\\lambda^k}{k !} \\\\\n& P(x \\geq 2)=1-P(x=0)-P(x=1) \\\\\n& =1-e^{-\\lambda}-e^{-\\lambda}\\left(\\frac{\\lambda}{1 !}\\right) \\\\\n& =1-\\frac{3}{e^2} .\n\\end{aligned}\n$$",
    "image": null
  },
