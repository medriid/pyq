  "question": {
    "text": "Three houses are available in a locality. Three persons apply for the houses. Each applies for one house without consulting others. The probability that all the three apply for the same house is",
    "image": null
  },
  "options": [
    {
      "id": "FGsoS",
      "text": "\n$\\frac{2}{9}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fTQbZ",
      "text": "\n$\\frac{1}{9}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "3lx6L",
      "text": "\n$\\frac{8}{9}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "p0SiT",
      "text": "\n$\\frac{7}{9}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For a particular house being selected\nProbability $=\\frac{1}{3}$\nProb(all the persons apply for the same house) $=\\left(\\frac{1}{3} \\times \\frac{1}{3} \\times \\frac{1}{3}\\right) 3=\\frac{1}{9}$",
    "image": null
  },
