  "question": {
    "text": "Let a biased coin be tossed&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math> times. If the probability of getting&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> heads is equal to the probability of getting&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math> heads, then the probability of getting atmost two heads is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>46</mn><msup><mn>6</mn><mn>4</mn></msup></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>275</mn><msup><mn>6</mn><mn>5</mn></msup></mfrac></math>",
