  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/Yfw6kJOWsbLAtJOMXpdUSvYyuAwAQxSZUaTpULCAaas.original.fullsize.png\"><br>\n$\\begin{aligned}\n& \\text { Total }={ }^{16} \\mathrm{C}_2 \\\\\n& \\text { Required ways }=\\text { Total }- \\text { (adjacent square) } \\\\\n& ={ }^{16} \\mathrm{C}_2- \\\\\n& \\text { [3 pair in vertical \\& horizontal for } \\\\\n& \\text { each row and column] } \\\\\n& ={ }^{16} C_2-[3 \\times 4+3 \\times 4] \\\\\n& =96 \\\\\n& \\text { Probability }=\\frac{96}{120}=\\frac{4}{5}\n\\end{aligned}$",
    "image": null
