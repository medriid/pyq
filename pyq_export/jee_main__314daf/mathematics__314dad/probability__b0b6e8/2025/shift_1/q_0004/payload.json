  "solution": {
    "text": "\\begin{array}{|r|c|c|c|}\\hline x & \\mathrm{x}=0 & \\mathrm{x}=1 & \\mathrm{x}=2 \\\\\\hline \\mathrm{P}(\\mathrm{x}) & \\frac{{ }^7 \\mathrm{C}_2}{{ }^{10} \\mathrm{C}_2} & \\frac{{ }^7 \\mathrm{C}_1^3 \\mathrm{C}_1}{{ }^{10} \\mathrm{C}_2} & { }^3{ }^{10} \\mathrm{C}_2 \\\\\\hline\\end{array}<br/>$\\begin{aligned} & \\mu=\\Sigma \\mathrm{x}_{\\mathrm{i}} \\mathrm{P}\\left(\\mathrm{x}_{\\mathrm{i}}\\right)=0+\\frac{7}{15}+\\frac{2}{15}=\\frac{3}{5} \\\\ & \\text { Variance }(\\mathrm{x})=\\Sigma \\mathrm{P}_{\\mathrm{i}}\\left(\\mathrm{x}_{\\mathrm{i}}-\\mu\\right)^2=\\frac{28}{75}\\end{aligned}$"
