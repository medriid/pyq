  "question": {
    "text": "A coin is tossed three times. Let $X$ denote the number of times a tail follows a head. If $\\mu$ and $\\sigma^2$ denote the mean and variance of $X$, then the value of $64\\left(\\mu+\\sigma^2\\right)$ is :"
  },
  "options": [
    {
      "text": "$51$",
      "is_correct": false
    },
    {
      "text": "$64$",
      "is_correct": false
    },
    {
      "text": "$32$",
      "is_correct": false
    },
    {
      "text": "$48$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0030_938574387818.png\"><br>\n$\\begin{aligned} & \\mu=\\sum x_i P_i=\\frac{1}{2} \\\\ & \\sigma^2=\\sum x_i^2 P_i-\\mu^2 \\\\ & =\\frac{1}{2}-\\frac{1}{4}=\\frac{1}{4} \\\\ & 64\\left(\\mu+\\sigma^2\\right)=64\\left[\\frac{1}{2}+\\frac{1}{4}\\right] \\\\ & =64 \\times \\frac{3}{4}=48\\end{aligned}$"
  }
}