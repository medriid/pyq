  "question": {
    "text": "A coin is tossed three times. Let $X$ denote the number of times a tail follows a head. If $\\mu$ and $\\sigma^2$ denote the mean and variance of $X$, then the value of $64\\left(\\mu+\\sigma^2\\right)$ is :",
    "image": null
  },
  "options": [
    {
      "id": "EVLl2",
      "text": "$51$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bzc6q",
      "text": "$64$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xVID4",
      "text": "$32$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "b2nER",
      "text": "$48$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/4O_KXgsn98hRiagfZ8QAVcUtISYhlulpXc4hRqAHjkc.original.fullsize.png\"><br>\n$\\begin{aligned} & \\mu=\\sum x_i P_i=\\frac{1}{2} \\\\ & \\sigma^2=\\sum x_i^2 P_i-\\mu^2 \\\\ & =\\frac{1}{2}-\\frac{1}{4}=\\frac{1}{4} \\\\ & 64\\left(\\mu+\\sigma^2\\right)=64\\left[\\frac{1}{2}+\\frac{1}{4}\\right] \\\\ & =64 \\times \\frac{3}{4}=48\\end{aligned}$",
    "image": null
  },
