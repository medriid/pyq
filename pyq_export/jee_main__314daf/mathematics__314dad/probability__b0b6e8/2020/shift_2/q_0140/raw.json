  "question": {
    "text": "The probability that a randomly chosen <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math>- digit number is made from exactly two digits is :",
    "image": null
  },
  "options": [
    {
      "id": "PBobB",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>135</mn><msup><mn>10</mn><mn>4</mn></msup></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "SGxuW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>150</mn><msup><mn>10</mn><mn>4</mn></msup></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "vKo7v",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>134</mn><msup><mn>10</mn><mn>4</mn></msup></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XOkyK",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>121</mn><msup><mn>10</mn><mn>4</mn></msup></mfrac></math>",
      "isCorrect": false,
      "image": null
