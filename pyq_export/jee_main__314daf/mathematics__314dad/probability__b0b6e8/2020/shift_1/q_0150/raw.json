    },
    {
      "id": "aPsz6",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>8</mn></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "mBUq7",
      "text": "<math><mo>-</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>16</mn></mrow></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QPu85",
      "text": "<math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>8</mn></mrow></mfrac></math>",
      "isCorrect": false,
