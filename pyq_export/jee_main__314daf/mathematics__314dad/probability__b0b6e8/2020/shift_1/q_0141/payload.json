  "question": {
    "text": "A die is thrown two times and the sum of the scores appearing on the die is observed to be a multiple of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>. Then the conditional probability that the score <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> has appeared at least once is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>3</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>8</mn></mfrac></math>",
      "is_correct": false
    },
