      "text": "\n$0.50$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$P(E \\cup F)=P(E)+P(F)-P(E \\cap F)=0.62+0.50-0.35=0.77$",
    "image": null
