    "text": "<img alt=\"\" src=\"assets\\st0183_765062c22de6.jpg\" style=\"width: 160px; height: 113px;\" /><br /><br />Given <math><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>8</mn></mrow><mrow><mn>20</mn></mrow></mfrac></math> &amp; <math><mi>&#160;</mi><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>20</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>P</mi><mfenced separators=\"|\"><mrow><msup><mi>A</mi><mo>&#39;</mo></msup><mo>&#8746;</mo><msup><mi>B</mi><mo>&#39;</mo></msup></mrow></mfenced><mo>=</mo><mi>P</mi><msup><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mi>B</mi></mrow></mfenced><mo>&#39;</mo></msup></math><br /><br /><math><mo>=</mo><mn>1</mn><mo>-</mo><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mi>B</mi></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>20</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>17</mn></mrow><mrow><mn>20</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mfenced separators=\"|\"><mrow><msup><mi>A</mi><mo>'</mo></msup><mo>&#8746;</mo><msup><mi>B</mi><mo>'</mo></msup></mrow></mfenced></mrow></mfenced><mo>=</mo><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><msup><mi>B</mi><mo>'</mo></msup></mrow></mfenced></math><br /><br /><math><mo>=</mo><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi></mrow></mfenced><mo>-</mo><mi>P</mi><mfenced separators=\"|\"><mrow><mi>A</mi><mo>&#8745;</mo><mi>B</mi></mrow></mfenced></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>8</mn></mrow><mrow><mn>20</mn></mrow></mfr