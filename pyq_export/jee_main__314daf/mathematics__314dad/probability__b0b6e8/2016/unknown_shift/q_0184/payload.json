      "is_correct": true
    },
    {
      "text": "<math><msub><mrow><mi>E</mi></mrow><mrow><mn>1</mn></mrow></msub></math>  and  <math><msub><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msub></math>  are independent",
      "is_correct": false
    },
    {
      "text": "<math><msub><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msub></math>  and  <math><msub><mrow><mi>E</mi></mrow><mrow><mn>3</mn></mrow></msub></math>   are independent",
