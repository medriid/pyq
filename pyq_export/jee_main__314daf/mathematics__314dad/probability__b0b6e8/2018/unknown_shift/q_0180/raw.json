  "correctValue": null,
  "solution": {
    "text": "<blockquote><p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>&nbsp;number of children be&nbsp;there in each family.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>12</mn></mfrac><mo>=</mo><mfrac><mrow><msup><mi>&#160;</mi><mi>n</mi></msup><msub><mi>C</mi><mn>3</mn></msub><mo>&#183;</mo><mn>3</mn><mo>!</mo></mrow><mrow><msup><mi>&#160;</mi><mrow><mn>2</mn><mi>n</mi></mrow></msup><msub><mi>C</mi><mn>3</mn></msub><mo>&#183;</mo><mn>3</mn><mo>!</mo></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><msup><mi>&#160;</mi><mi>n</mi></msup><msub><mi>C</mi><mn>3</mn></msub></mrow><mrow><msup><mi>&#160;</mi><mrow><mn>2</mn><mi>n</mi></mrow></msup><msub><mi>C</mi><mn>3</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>12</mn></mfrac><mi>&#160;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mn>2</mn><mi>n</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>12</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><mi>n</mi><mo>-</mo><mn>6</mn><mo>=</mo><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>n</mi><mo>=</mo><mn>5</mn></math></p></blockquote>",
