  "correctValue": null,
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced separators=\"|\"><mrow><mi>E</mi><mo>&#8745;</mo><mi>F</mi></mrow></mfenced><mo>=</mo><mi>P</mi><mfenced separators=\"|\"><mi>E</mi></mfenced><mo>.</mo><mi>&#160;</mi><mi>P</mi><mfenced separators=\"|\"><mi>F</mi></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>12</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mi>y</mi><mo>=</mo><mfrac><mn>1</mn><mn>12</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>P</mi><mfenced separators=\"|\"><mrow><mover><mi>E</mi><mo>-</mo></mover><mo>&#8745;</mo><mover><mi>F</mi><mo>-</mo></mover></mrow></mfenced><mo>=</mo><mi>P</mi><mfenced separators=\"|\"><mover><mi>E</mi><mo>-</mo></mover></mfenced><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><mi>P</mi><mfenced separators=\"|\"><mover><mi>F</mi><mo>-</mo></mover></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>P</mi><mfenced separators=\"|\"><mi>E</mi></mfenced></mrow></mfenced><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>P</mi><mfenced separators=\"|\"><mi>F</mi></mfenced></mrow></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><br /><math><mo>&#8658;</mo><mn>1</mn><mo>-</mo><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mi>x</mi><mi>y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mn>1</mn><mo>-</mo><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>12</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo><mn>1</mn><mo>-</mo><mi>x</mi><mo>-</mo><mi>y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><