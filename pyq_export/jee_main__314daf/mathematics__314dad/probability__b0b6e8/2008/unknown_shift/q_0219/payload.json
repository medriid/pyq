  "question": {
    "text": "A die is thrown. Let $A$ be the event that the number obtained is greater than 3 . Let $B$ be the event that the number obtained is less than 5 . Then $P(A \\cup B)$ is"
  },
  "options": [
    {
      "text": "\n$\\frac{3}{5}$\n",
      "is_correct": false
    },
    {
      "text": "\n0\n",
      "is_correct": false
    },
    {
      "text": "\n1\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{2}{5}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\nA=\\{4,5,6\\}, B=\\{1,2,3,4\\} \\text {. }\n$$\nObviously $P(A \\cup B)=1$."
  }
