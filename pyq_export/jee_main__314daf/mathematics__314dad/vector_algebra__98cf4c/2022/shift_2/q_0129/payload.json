      "text": "Only&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;is true.",
      "is_correct": false
    },
    {
      "text": "Both&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>1</mn></mrow></mfenced></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;are true.",
      "is_correct": true
    },
    {
      "text": "Both&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>1</mn></mrow></mfenced></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;are false.",
