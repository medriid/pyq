  "correctValue": null,
  "solution": {
    "text": "<blockquote><p>Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mn>9</mn></math></p><p>And&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>x</mi><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>y</mi><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mn>6</mn><mi>y</mi><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>18</mn><mi>x</mi><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>0</mn></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"}\" open=\"{\"><mtext>as&#160;they&#160;are&#160;perpendicular</mtext></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>6</mn><mi>x</mi><mi>y</mi><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>18</mn><msup><mi>x</mi><mn>2</mn></msup><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mn>6</mn><msup><mi>y</mi><mn>2</mn></msup><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>-</mo><mn>18</mn><mi>x</mi><mi>y</mi><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>6</mn><mi>x</mi><mi>y</mi><mfenced><mrow><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>3</mn><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup></mrow></mfenced><mo>+</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mfenced><mrow><msup><mi>y</mi><mn>2</mn></msup><mo>-</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p>This should hold&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8704;</mo><mi mathvariant=\"normal\">x</mi><mo>,</mo><mi>y</mi><mo>&#8712;</mo><mi>R</mi><mo>&#215;</mo><mi>R</mi><mo>-</mo><mfenced close=\"}\" open=\"{\"><mfenced><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></mfenced></mfenced></math></p><p>So,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>3</mn><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>=</mo><mn>0</mn><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>=</mo><mn>3</mn><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mi>&#952;</mi><mo>=</mo><mn>90</mn><mo>&#176;</mo></math></p><p>Now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><msup><mi>sin</mi><mn>2</mn></msup><mi>&#952;</mi><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>&#160;</mo><mfenced close=\"}\" open=\"{\"><mrow><mtext>as&#160;</mtext><mi>&#952;</mi><mo>=</mo><msup><mn>90</mn><mo>&#176;</mo></msup></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>&#183;</mo><mfrac><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mn>3</mn></mfrac></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"}\" open=\"{\"><mrow><mtext>as&#160;</mtext><msup><mfenced close=\"|\" open=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>=</mo><mfrac><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mn>3</mn></mfrac></mrow></mfenced></math></p><p>So,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mfrac><msup><mfenced close=\"|\" open=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><msqrt><mn>3</mn></msqrt></mfrac><mo>=</mo><mfrac><mn>81</mn><msqrt><mn>3</mn></msqrt></mfrac><mo>=</mo><mn>27</mn><msqrt><mn>3</mn></msqrt></math></p></blockquote>",
