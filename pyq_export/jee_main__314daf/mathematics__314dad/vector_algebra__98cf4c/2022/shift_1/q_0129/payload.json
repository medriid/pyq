    {
      "text": "both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>1</mn></mrow></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;are false",
