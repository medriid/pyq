  "question": {
    "text": "The non-zero verctors $\\vec{a}, \\vec{b}$ and $\\vec{c}$ are related by $\\vec{a}=8 \\vec{b}$ and $\\vec{c}=-7 \\vec{b}$. Then the angle between $\\vec{a}$ and $\\overrightarrow{\\mathrm{c}}$ is",
    "image": null
  },
  "options": [
    {
      "id": "yPbfx",
      "text": "\n0\n",
      "image": null,
      "isCorrect": false
    },
    {
