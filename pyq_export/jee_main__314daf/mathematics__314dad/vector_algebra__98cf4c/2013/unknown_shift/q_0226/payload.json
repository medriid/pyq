  "question": {
    "text": "The vector $(\\hat{i} \\times \\vec{a} \\cdot \\vec{b}) \\hat{i}+(\\hat{j} \\times \\vec{a} \\vec{b}) \\hat{j}+(\\hat{k} \\times \\vec{a} \\cdot \\vec{b}) \\hat{k}$ is equal to:"
  },
  "options": [
    {
      "text": "\n$\\vec{b} \\times \\vec{a}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\vec{a}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\vec{a} \\times \\vec{b}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\vec{b}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$(\\hat{i} \\times \\vec{a} \\cdot \\vec{b}) \\hat{i}+(\\hat{j} \\times \\vec{a} \\cdot \\vec{b}) \\hat{j}+(\\hat{k} \\times \\vec{a} \\cdot \\vec{b}) \\hat{k}$\n$=(\\hat{i} \\cdot \\vec{a} \\times \\vec{b}) \\hat{i}+(\\hat{j} \\cdot \\vec{a} \\times \\vec{b}) \\hat{j}+(\\hat{k} \\cdot \\vec{a} \\times \\vec{b}) \\hat{k}$\n$(\\because \\vec{a} \\times \\vec{b} \\cdot \\vec{c}=\\vec{a} \\cdot \\vec{b} \\times \\vec{c})$\n$=(\\vec{a} \\times \\vec{b}) \\hat{i}+(\\vec{a} \\times \\vec{b}) \\hat{j}+(\\vec{a} \\times \\vec{b}) \\hat{k}$\n$==\\vec{a} \\times \\vec{b}$"
  }
}