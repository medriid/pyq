  "question": {
    "text": "$\\vec{a}, \\vec{b}, \\vec{c}$ are 3 vectors, such that $\\vec{a}+\\vec{b}+\\vec{c}=0,|\\vec{a}|=1,|\\vec{b}|=2 \\mid \\vec{a}$ then $\\vec{a} \\cdot \\vec{b}+\\vec{b} \\cdot \\vec{c}+\\vec{c} \\cdot \\vec{a}$ is equal to"
  },
  "options": [
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n0\n",
      "is_correct": false
    },
    {
      "text": "\n$-7$\n",
      "is_correct": true
    },
    {
      "text": "\n7",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\vec{a}+\\vec{b}+\\vec{c}=0 \\Rightarrow(\\vec{a}+\\vec{b}+\\vec{c}) \\cdot(\\vec{a}+\\vec{b}+\\vec{c})=0$\n$|\\vec{a}|^2+|\\vec{b}|^2+|\\vec{c}|^2+2(\\vec{a} \\cdot \\vec{b}+\\vec{b} \\cdot \\vec{c}+\\vec{c} \\cdot \\vec{a})=0$\n$\\vec{a} \\cdot \\vec{b}+\\vec{b} \\cdot \\vec{c}+\\vec{c} \\cdot \\vec{a}=\\frac{-1-4-9}{2}=-7$"
  }
}