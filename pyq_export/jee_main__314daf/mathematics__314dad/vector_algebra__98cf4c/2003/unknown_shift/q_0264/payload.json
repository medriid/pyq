  "question": {
    "text": "If $\\vec{u}, \\vec{v}$ and $\\vec{w}$ are three non-coplanar vectors, then $(\\vec{u}+\\vec{v}-\\vec{w}) .(\\vec{u}-\\vec{v}) \\times(\\vec{v}-\\vec{w})$ equals"
  },
  "options": [
    {
      "text": "\n$3 \\vec{u} . \\vec{v} \\times \\vec{w}$\n",
      "is_correct": false
    },
    {
      "text": "\n0\n",
      "is_correct": false
    },
    {
      "text": "\n$\\overrightarrow{\\mathrm{u}} \\cdot \\overrightarrow{\\mathrm{v}} \\times \\overrightarrow{\\mathrm{w}}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\overrightarrow{\\mathrm{u}} \\cdot \\overrightarrow{\\mathrm{w}} \\times \\overrightarrow{\\mathrm{v}}$",
