  "question": {
    "text": "The values of $a$, for which the points $A, B, C$ with position vectors $2 \\hat{i}-\\hat{j}+\\hat{k}, \\hat{i}-3 \\hat{j}-5 \\hat{k}$ and $a \\hat{i}-3 \\hat{j}+\\hat{k}$ respectively are the vertices of a right-angled triangle with $C=\\frac{\\pi}{2}$ are",
    "image": null
  },
  "options": [
    {
      "id": "RYTdI",
      "text": "\n2 and 1\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "aWwvo",
      "text": "\n−2 and −1\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bYn7e",
      "text": "\n−2 and 1\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "abuLt",
      "text": "\n2 and −1",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Rightarrow \\overrightarrow{B A}=\\hat{i}-2 \\hat{j}+6 \\hat{k}$\n$\\overrightarrow{C A}=(2-a) \\hat{i}+2 \\hat{j}$\n$\\overrightarrow{C B}=(1-a) \\hat{i}-6 \\hat{k}$\n$\\overrightarrow{C A} \\cdot \\overrightarrow{C B}=0 \\Rightarrow(2-a)(1-a)=0$\n$\\Rightarrow a=2,1$",
    "image": null
  },
