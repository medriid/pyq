  "question": {
    "text": "If $\\hat{u}$ and $\\hat{v}$ are unit vectors and $\\theta$ is the acute angle between them, then $2 \\hat{u} \\times 3 \\hat{v}$ is a unit vector for",
    "image": null
  },
  "options": [
    {
      "id": "XjjUU",
      "text": "\nexactly two values of $\\theta$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "p3SUD",
      "text": "\nmore than two values of $\\theta$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Tyl0e",
      "text": "\nno value of $\\theta$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nMnRM",
      "text": "\nexactly one value of $\\theta$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$|2 \\hat{u} \\times 3 \\hat{v}|=1$\n$\\begin{aligned}\n& 6|\\hat{u}\\|\\hat{v} \\| \\sin \\theta|=1 \\\\\n& \\sin \\theta=\\frac{1}{6}\n\\end{aligned}$\nHence there is exactly one value of $\\theta$ for which $2 \\hat{u} \\times 3 \\hat{v}$ is a unit vector.",
    "image": null
  },
