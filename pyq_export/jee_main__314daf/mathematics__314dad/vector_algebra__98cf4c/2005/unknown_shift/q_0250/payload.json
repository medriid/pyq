    },
    {
      "text": "\n$3: 2$\n",
      "is_correct": false
    },
    {
      "text": "\n$3: 2 \\sqrt{2}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0250_4aedee5a7bdb.png\"><br>\n$\\mathrm{F}^{\\prime}=3 \\mathrm{~F} \\cos \\theta$\n$\\mathrm{F}=3 \\mathrm{~F} \\sin \\theta$\n$\\Rightarrow \\mathrm{F}^{\\prime}=2 \\sqrt{2} \\mathrm{~F}$\n$\\mathrm{~F}: \\mathrm{F}^{\\prime}:: 3: 2 \\sqrt{2}$."
  }
