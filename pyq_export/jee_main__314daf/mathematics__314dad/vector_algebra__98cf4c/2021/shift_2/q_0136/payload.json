    "text": "<p><img alt=\"\" src=\"assets\\st0136_fe023d04ee60.png\" style=\"width: 440px; height: 375px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>AG</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>10</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mi mathvariant=\"normal\">h</mi><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mn>10</mn><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>BH</mi><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mn>10</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mi>h</mi><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mn>10</mn><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mfrac><mrow><mo>-</mo><mn>100</mn><mo>+</mo><msup><mi>h</mi><mn>2</mn></msup><mo>+</mo><mn>100</mn></mrow><msup><mfenced><msqrt><mn>200</mn><mo>+</mo><msup><mi>h</mi><mn>2</mn></msup></msqrt></mfenced><mn>2</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>5</mn></mfrac><mo>=</mo><mfrac><msup><mi>h</mi><mn>2</mn></msup><mrow><mn>200</mn><mo>+</mo><msup><mi>h</mi><mn>2</mn></msup></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>200</mn><mo>=</mo><mn>4</mn><msup><mrow><mo>&#160;</mo><mi mathvariant=\"normal\">h</mi></mrow><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">h</mi><mn>2</mn></msup><mo>=</mo><mn>50</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>h</mi><mo>=</mo><mn>5</mn><msqrt><mn>2</mn></msqrt></math></p>"
