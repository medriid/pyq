  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>v</mi><mo>&#8594;</mo></mover><mo>,</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>,</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></math>&nbsp;are coplanar</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>&#955;</mi><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>&#956;</mi><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mo>=</mo><mfenced><mrow><mn>2</mn><mi mathvariant=\"normal\">&#955;</mi><mo>+</mo><mi>&#956;</mi></mrow></mfenced><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mfenced><mrow><mn>2</mn><mi>&#956;</mi><mo>-</mo><mi>&#955;</mi></mrow></mfenced><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mfenced><mrow><mn>2</mn><mi>&#955;</mi><mo>-</mo><mi>&#956;</mi></mrow></mfenced><mover><mi>k</mi><mo>^</mo></mover></math></p><p>given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>v</mi><mo>&#8594;</mo></mover><mo>&#8869;</mo></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>3</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>-</mo><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mfenced><mrow><mn>3</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>-</mo><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>(</mo><mfenced><mrow><mn>2</mn><mi mathvariant=\"normal\">&#955;</mi><mo>+</mo><mi>&#956;</mi></mrow></mfenced><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mfenced><mrow><mn>2</mn><mi>&#956;</mi><mo>-</mo><mi>&#955;</mi></mrow></mfenced><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mfenced><mrow><mn>2</mn><mi>&#955;</mi><mo>-</mo><mi>&#956;</mi></mrow></mfenced><mover><mi>k</mi><mo>^</mo></mover><mo>)</mo><mo>.</mo><mo>(</mo><mn>3</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover><mi>j</mi><mo>^</mo></mover><mo>-</mo><mover><mi>k</mi><mo>^</mo></mover><mo>)</mo><mo>=</mo><mn>0</mn><mspace linebreak=\"newline\"></mspace></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><mo>(</mo><mn>2</mn><mi>&#955;</mi><mo>+</mo><mi>&#956;</mi><mo>)</mo><mo>+</mo><mn>2</mn><mo>(</mo><mn>2</mn><mi>&#956;</mi><mo>-</mo><mi>&#955;</mi><mo>)</mo><mo>-</mo><mo>(</mo><mn>2</mn><mi>&#955;</mi><mo>-</mo><mi>&#956;</mi><mo>)</mo><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mo>-</mo><mn>4</mn><mi mathvariant=\"normal\">&#956;</mi><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mi mathvariant=\"normal\">i</mi><mo>)</mo></math></p><p>and also <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>a</mi><mo>^</mo></mover><mo>=</mo><mn>19</mn><mo>&#8658;</mo><mn>9</mn><mi mathvariant=\"normal\">&#955;</mi><mo>-</mo><mn>2</mn><mi mathvariant=\"normal\">&#956;</mi><mo>=</mo><mn>57</mn><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mi>ii</mi></mfenced></math></p><p>solving <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">i</mi><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>ii</mi><mo>)</mo></math> we get</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><mo>=</mo><mn>6</mn><mo>,</mo><mo>&#160;</mo><mi>&#956;</mi><mo>=</mo><mo>-</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mover><mi mathvariant=\"normal\">v</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>21</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mn>18</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mn>27</mn><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>|</mo><mn>2</mn><mover><mi mathvariant=\"normal\">v</mi><mo>&#8594;</mo></mover><msup><mo>|</mo><mn>2</mn></msup><mo>=</mo><mn>441</mn><mo>+</mo><mn>324</mn><mo>+</mo><mn>729</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>1494</mn></math></p>"
