  "correct_answer": "6",
  "solution": {
    "text": "<p>We have,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>=</mo><msqrt><mn>3</mn></msqrt><mi>p</mi><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>=</mo><mn>2</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mfenced><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mover><mi>j</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#952;</mi><mo>=</mo><mfrac><mfenced><mrow><mi>&#945;</mi><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mfenced><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow></mfenced></mfrac></math></p><p>&nbsp;</p><p><img src=\"assets\\st0163_e27ce5b35d87.png\" style=\"width: 230px; height: 200px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>1</mn></msub></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\"><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><msup><mi>p</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>=</mo><mn>4</mn><mo>+</mo><mo>(</mo><mi>p</mi><mo>+</mo><mn>1</mn><msup><mo>)</mo><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><msup><mi>p</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mi>p</mi><mo>-</mo><mn>4</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>p</mi><mn>2</mn></msup><mo>-</mo><mi>p</mi><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>p</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mo>-</mo><mn>1</mn></math>&nbsp;(rejected)</p><p>Now,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mfrac><mrow><msub><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>&#183;</mo><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></mrow><mrow><mfenced close=\"|\" open=\"|\"><msub><mover accent=\"true\"><mi>v</mi><mo>&#8594;</mo></mover><mn>1</mn></msub></mfenced><mo>&#183;</mo><mfenced close=\"|\" open=\"|\"><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><msqrt><mn>3</mn></msqrt><mi>p</mi><mo>+</mo><mo>(</mo><mi>p</mi><mo>+</mo><mn>1</mn><mo>)</mo></mrow><mrow><msqrt><mo>(</mo><mi>p</mi><mo>+</mo><mn>1</mn><msup><mo>)</mo><mn>2</mn></msup><mo>+</mo><mn>4</mn></msqrt><msqrt><mn>3</mn><msup><mi>p</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></msqrt></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mfrac><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow><mrow><msqrt><mn>13</mn></msqrt><msqrt><mn>13</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow><mn>13</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>tan</mi><mi>&#952;</mi><mo>=</mo><mfrac><msqrt><mn>112</mn><mo>-</mo><mn>24</mn><msqrt><mn>3</mn></msqrt></msqrt><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><msqrt><msup><mfenced><mrow><mn>6</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>2</mn></mrow></mfenced><mn>2</mn></msup></msqrt><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>tan</mi><mi>&#952;</mi><mo>=</mo><mfrac><mrow><mn>6</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>2</mn></mrow><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>&#945;</mi><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>2</mn></mrow><mrow><mn>4</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>3</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#945;</mi><mo>=</mo><mn>6</mn></math></p>"
