      "id": "Kxm8U",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mtable columnalign=\"left\"><mtr><mtd><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover></mtd><mtd><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover></mtd><mtd><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover></mtd></mtr></mtable></mfenced><mo>+</mo><mfenced open=\"[\" close=\"]\"><mtable columnalign=\"left\"><mtr><mtd><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover></mtd><mtd><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover></mtd><mtd><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover></mtd></mtr></mtable></mfenced><mo>=</mo><mn>8</mn></math>",
      "isCorrect": false,
