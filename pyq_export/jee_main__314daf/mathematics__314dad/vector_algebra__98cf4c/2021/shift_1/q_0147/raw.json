    },
    {
      "id": "M0qfj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>|</mo><mn>3</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>2</mn><mover><mi>c</mi><mo>&#8594;</mo></mover><msup><mo>|</mo><mn>2</mn></msup><mo>=</mo><mn>51</mn></math>",
