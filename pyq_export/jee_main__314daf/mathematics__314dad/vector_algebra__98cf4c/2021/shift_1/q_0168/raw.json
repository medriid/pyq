  "solution": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>&#955;</mi><mfenced><mrow><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfenced></math><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>&#955;</mi><mfenced><mrow><mfenced><mrow><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mfenced><mrow><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover></mrow></mfenced><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>&#955;</mi><mfenced><mrow><mn>5</mn><mfenced><mrow><mo>-</mo><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced><mo>+</mo><mn>2</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>&#955;</mi><mfenced><mrow><mo>-</mo><mn>3</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>5</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>6</mn><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>7</mn><mo>&#8658;</mo><mn>3</mn><mi>&#955;</mi><mo>+</mo><mn>5</mn><mi>&#955;</mi><mo>+</mo><mn>6</mn><mi>&#955;</mi><mo>=</mo><mn>7</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/M