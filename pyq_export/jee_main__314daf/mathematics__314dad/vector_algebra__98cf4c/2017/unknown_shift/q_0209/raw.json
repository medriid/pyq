  "solution": {
    "text": "Let the given diagonals be <math> <mrow> <mover accent=\"true\"> <mrow> <msub> <mi>d</mi> <mn>1</mn> </msub> </mrow> <mo stretchy=\"true\">&#8594;</mo> </mover> </mrow> </math> and <math> <mrow> <mover accent=\"true\"> <mrow> <msub> <mi>d</mi> <mn>2</mn> </msub> </mrow> <mo stretchy=\"true\">&#8594;</mo> </mover> </mrow> </math> , then<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>d</mi><mn>1</mn></msub><mo>&#215;</mo><msub><mi>d</mi><mn>2</mn></msub><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mtable><mtr><mtd><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover></mtd><mtd><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover></mtd><mtd><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></mtd></mtr><mtr><mtd><mn>8</mn></mtd><mtd><mo>-</mo><mn>6</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>12</mn></mtd></mtr></mtable></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>72</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>96</mn></mrow></mfenced><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mn>50</mn><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>&#215;</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><msqrt><msup><mn>72</mn><mn>2</mn></msup><mo>+</mo><msup><mfenced><mrow><mo>-</mo><mn>96</mn></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mn>50</mn></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><msqrt><mn>5184</mn><mo>+</mo><mn>9216</mn><mo>+</mo><mn>2500</mn></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><msub><mi>d</mi><mn>2</mn><