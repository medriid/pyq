  "question": {
    "text": "Let a unit vector which makes an angle of $60^{\\circ}$ with $2 \\hat{i}+2 \\hat{j}-\\hat{k}$ and angle $45^{\\circ}$ with $\\hat{i}-\\hat{k}$ be $\\overrightarrow{\\mathrm{C}}$. Then $\\overrightarrow{\\mathrm{C}}+\\left(-\\frac{1}{2} \\hat{i}+\\frac{1}{3 \\sqrt{2}} \\hat{j}-\\frac{\\sqrt{2}}{3} \\hat{k}\\right)$ is :",
    "image": null
  },
  "options": [
    {
      "id": "QTd4O",
      "text": "$\\frac{\\sqrt{2}}{3} \\hat{i}-\\frac{1}{2} \\hat{k}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "3pN46",
      "text": "$\\left(\\frac{1}{\\sqrt{3}}+\\frac{1}{2}\\right) \\hat{i}+\\left(\\frac{1}{\\sqrt{3}}-\\frac{1}{3 \\sqrt{2}}\\right) \\hat{j}+\\left(\\frac{1}{\\sqrt{3}}+\\frac{\\sqrt{2}}{3}\\right) \\hat{k}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uK9jt",
      "text": "$\\frac{\\sqrt{2}}{3} \\hat{i}+\\frac{1}{3 \\sqrt{2}} \\hat{j}-\\frac{1}{2} \\hat{k}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nhRRO",
      "text": "$-\\frac{\\sqrt{2}}{3} \\hat{i}+\\frac{\\sqrt{2}}{3} \\hat{j}+\\left(\\frac{1}{2}+\\frac{2 \\sqrt{2}}{3}\\right) \\hat{k}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\overrightarrow{\\mathrm{C}}=\\mathrm{C}_1 \\hat{\\mathrm{i}}+\\mathrm{C}_2 \\hat{\\mathrm{j}}+\\mathrm{C}_3 \\hat{\\mathrm{k}}$\n$\\mathrm{C}_1{ }^2+\\mathrm{C}_2{ }^2+\\mathrm{C}_3{ }^2=1$\n$\\overrightarrow{\\mathrm{C}} \\cdot(2 \\hat{\\mathrm{i}}+2 \\hat{\\mathrm{j}}-\\hat{\\mathrm{k}})=|\\mathrm{C}| \\sqrt{9} \\cos 60^{\\circ}$\n$2 \\mathrm{C}_1+2 \\mathrm{C}_2-\\mathrm{C}_3=\\frac{3}{2}$\n$\\mathrm{C}_1-\\mathrm{C}_3=1$\n$\\mathrm{C}_1+2 \\mathrm{C}_2=\\frac{1}{2}$\n$\\mathrm{C}_1=\\frac{\\sqrt{2}}{3}+\\frac{1}{2}$\n$\\mathrm{C}_2=\\frac{-1}{3 \\sqrt{2}}$\n$\\mathrm{C}_3=\\frac{\\sqrt{2}}{3}-\\frac{1}{2}$",
    "image": null
  },
