  "question": {
    "text": "Let $A B C D$ be a tetrahedron such that the edges $\\mathrm{AB}, \\mathrm{AC}$ and AD are mutually perpendicular. Let the areas of the triangles $\\mathrm{ABC}, \\mathrm{ACD}$ and ADB be 5,6 and 7 square units respectively. Then the area (in square units) of the $\\triangle \\mathrm{BCD}$ is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "Sd2au",
      "text": "$\\sqrt{340}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mijmH",
      "text": "12",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9pfdE",
      "text": "$\\sqrt{110}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "KbMQv",
      "text": "$7 \\sqrt{3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\operatorname{Ar}(\\triangle B C D)$<br/>$=\\sqrt{(\\operatorname{Ar}(\\triangle \\mathrm{ABC}))^2+(\\mathrm{Ar}(\\mathrm{ACD}))^2+(\\operatorname{Ar}(\\triangle \\mathrm{ADB}))^2}$<br/>$=\\sqrt{5^2+6^2+7^2}$<br/>$=\\sqrt{110}$",
    "image": null
  },
