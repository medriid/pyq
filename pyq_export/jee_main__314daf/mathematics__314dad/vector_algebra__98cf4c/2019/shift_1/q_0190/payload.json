    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced separators=\"|\"><mrow><mn>3</mn><mover accent=\"true\"><mi>i</mi><mo>^</mo></mover><mo>-</mo><mn>9</mn><mover accent=\"true\"><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>5</mn><mover accent=\"true\"><mi>k</mi><mo>^</mo></mover></mrow></mfenced></math>",
