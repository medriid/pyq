mover><mo>+</mo><mn>4</mn><mover accent=\"true\"><mi>j</mi><mo>&#8594;</mo></mover><mo>+</mo><mn>2</mn><mover accent=\"true\"><mi>k</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mo>&#160;</mo><mi>cos</mi><mi>&#8736;</mi><mi>G</mi><mi>O</mi><mi>A</mi><mo>=</mo><mfrac><mrow><mover accent=\"true\"><mrow><mi>O</mi><mi>A</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>O</mi><mi>G</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover accent=\"true\"><mrow><mi>O</mi><mi>A</mi></mrow><mo>&#8594;</mo></mover></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover accent=\"true\"><mrow><mi>O</mi><mi>G</mi></mrow><mo>&#8594;</mo></mover></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>6</mn><mo>-</mo><mn>2</mn></mrow><mrow><msqrt><mn>10</mn></msqrt><msqrt><mn>24</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mn>4</mn><mrow><msqrt><mn>10</mn></msqrt><mi>&#160;</mi><mn>2</mn><msqrt><mn>6</mn></msqrt></mrow></mfrac></math></p><p><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>15</mn></msqrt></mrow></mfrac></math></p>"
