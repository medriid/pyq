  "solution": {
    "text": "<p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>cos</mi><mi>&#952;</mi><mo>=</mo><mi>b</mi><mi>cos</mi><mo>&#160;</mo><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mrow></mfenced><mo>=</mo><mi>c</mi><mi>cos</mi><mo>&#160;</mo><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mrow></mfenced><mo>=</mo><mi>k</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mfrac><mi>k</mi><mrow><mi>cos</mi><mi>&#952;</mi></mrow></mfrac><mo>,</mo><mo>&#160;</mo><mi>b</mi><mo>=</mo><mfrac><mi>k</mi><mrow><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced></mrow></mfrac><mo>,</mo><mo>&#160;</mo><mi>c</mi><mo>=</mo><mfrac><mi>k</mi><mrow><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>a</mi><mi>b</mi><mo>+</mo><mi>b</mi><mi>c</mi><mo>+</mo><mi>c</mi><mi>a</mi><mo>=</mo><msup><mi>k</mi><mn>2</mn></msup><mfrac><mrow><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced><mo>+</mo><mi>cos</mi><mi>&#952;</mi><mo>+</mo><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced></mrow><mrow><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced><mi>cos</mi><mi>&#952;</mi><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>k</mi><mn>2</mn></msup><mfenced close=\"]\" open=\"[\"><mfrac><mrow><mi>cos</mi><mi>&#952;</mi><mo>+</mo><mn>2</mn><mi>cos</mi><mfenced><mrow><mi mathvariant=\"normal\">&#952;</mi><mo>+</mo><mi mathvariant=\"normal\">&#960;</mi></mrow></mfenced><mo>.</mo><mi>cos</mi><mfenced><mstyle displaystyle=\"true\"><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac></mstyle></mfenced></mrow><mrow><mi>cos</mi><mi>&#952;</mi><mo>.</mo><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced><mo>.</mo><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced></mrow></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>k</mi><mn>2</mn></msup><mfenced close=\"]\" open=\"[\"><mfrac><mrow><mi>cos</mi><mi>&#952;</mi><mo>-</mo><mn>2</mn><mi>cos</mi><mi>&#952;</mi><mo>.</mo><mstyle displaystyle=\"true\"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mrow><mi>cos</mi><mi>&#952;</mi><mo>.</mo><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn></mfrac></mstyle></mrow></mfenced><mo>.</mo><mi>cos</mi><mfenced><mrow><mi>&#952;</mi><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>3</mn><