  "solution": {
    "text": "<p>Position vector&nbsp;of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math>&nbsp;is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>O</mi><mi>P</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>&#955;</mi><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8757;</mo><mo>&#160;&#160;</mo><mover><mi>OB</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>OP</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>3</mn><mo>|</mo><mover><mi>OA</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>OP</mi><mo>&#8594;</mo></mover><msup><mo>|</mo><mn>2</mn></msup><mo>=</mo><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mfenced><mfrac><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>&#955;</mi><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mfenced><mo>-</mo><mn>3</mn><msup><mfenced close=\"|\" open=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mfenced><mfrac><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>&#955;</mi><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mfenced></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mn>6</mn></math></p><p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>+</mo><mi>&#955;</mi><mo>|</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><msup><mo>|</mo><mn>2</mn></msup></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>3</mn><msup><mi>&#955;</mi><mn>2</mn></msup></mrow><mrow><mo>(</mo><mi>&#955;</mi><mo>+</mo><mn>1</mn><msup><mo>)</mo><mn>2</mn></msup></mrow></mfrac><mo>|</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><msup><mo>|</mo><mn>2</mn></msup><mo>=</mo><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mfrac><mrow><mn>6</mn><mo>+</mo><mi>&#955;</mi><mo>.</mo><mn>14</mn></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>3</mn><msup><mi>&#955;</mi><mn>2</mn></msup></mrow><mrow><mo>(</mo><mi>&#955;</mi><mo>+</mo><mn>1</mn><msup><mo>)</mo><mn>2</mn></msup></mrow></mfrac><mo>&#183;</mo><mn>6</mn><mo>=</mo><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mfrac><mrow><mn>18</mn><msup><mi>&#955;</mi><mn>2</mn></msup></mrow><mrow><mo>(</mo><mi>&#955;</mi><mo>+</mo><mn>1</mn><msup><mo>)</mo><mn>2</mn></msup></mrow></mfrac><mo>+</mo><mn>6</mn><mo>=</mo><mn>6</mn><mo>+</mo><mfrac><mrow><mn>8</mn><mi>&#955;</mi></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mn>18</mn><msup><mfenced><mfrac><mi>&#955;</mi><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mfenced><mn>2</mn></msup><mo>-</mo><mfrac><mrow><mn>8</mn><mi>&#955;</mi></mrow><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mn>0</mn></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mi>&#955;</mi><mrow><mi>&#955;</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>&#8800;</mo><mn>0</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mn>10</mn><mi>&#955;</mi><mo>=</mo><mn>8</mn><mo>&#8658;</mo><mo>&#160;&#160;</mo><mi>&#955;</mi><mo>=</mo><mn>0</mn><mo>.</mo><mn>8</mn></math>