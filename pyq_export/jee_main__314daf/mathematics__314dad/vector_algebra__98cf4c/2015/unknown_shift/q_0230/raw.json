    "text": "Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover><mi>&#160;</mi><mo>&#215;</mo><mi>&#160;</mi><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mi>&#160;</mi><mo>&#215;</mo><mi>&#160;</mi><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>&#160;</mi><mfrac><mn>1</mn><mn>3</mn></mfrac><mi>&#160;</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mi>&#160;</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mi>&#160;</mi><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover><mo>-</mo><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mi>&#160;</mi><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mi>&#160;</mi><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover accent=\"true\"><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mi>&#160;</mi><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mover accent=\"true\"><mi>a</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn><mi>&#160;</mi><mi>&#160