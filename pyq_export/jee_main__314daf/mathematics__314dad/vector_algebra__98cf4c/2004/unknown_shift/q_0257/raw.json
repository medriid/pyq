  "question": {
    "text": "In a right angle $\\triangle \\mathrm{ABC}, \\angle \\mathrm{A}=90^{\\circ}$ and sides a, b, c are respectively, $5 \\mathrm{~cm}, 4 \\mathrm{~cm}$ and $3 \\mathrm{~cm}$. If a force $\\vec{F}$ has moments 0,9 and 16 in $N$ cm. units respectively about vertices $A, B$ and $C$, then magnitude of $\\vec{F}$ is",
    "image": null
  },
  "options": [
    {
      "id": "wYTfU",
      "text": "\n3\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nTlM4",
      "text": "\n4\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bHVVa",
      "text": "\n5\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "D12Fp",
      "text": "\n9",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{F} \\cdot 3 \\sin \\theta=9$\n$\\mathrm{~F} \\cdot 4 \\cos \\theta=16$\n$\\Rightarrow \\mathrm{F}=5$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/9WJucfMi4S6ULrzpXQTjXKhHofPbMl4j2a9njmHKhWo.original.fullsize.png\"><br>",
