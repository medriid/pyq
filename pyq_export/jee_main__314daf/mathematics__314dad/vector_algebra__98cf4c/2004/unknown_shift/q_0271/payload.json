  "question": {
    "text": "In a right angle $\\triangle \\mathrm{ABC}, \\angle \\mathrm{A}=90^{\\circ}$ and sides a, b, c are respectively, $5 \\mathrm{~cm}, 4 \\mathrm{~cm}$ and $3 \\mathrm{~cm}$. If a force $\\vec{F}$ has moments 0,9 and 16 in $N$ cm. units respectively about vertices $A, B$ and $C$, then magnitude of $\\vec{F}$ is"
  },
  "options": [
    {
      "text": "\n3\n",
      "is_correct": false
    },
    {
      "text": "\n4\n",
      "is_correct": false
    },
    {
      "text": "\n5\n",
      "is_correct": true
    },
    {
      "text": "\n9",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{F} \\cdot 3 \\sin \\theta=9$\n$\\mathrm{~F} \\cdot 4 \\cos \\theta=16$\n$\\Rightarrow \\mathrm{F}=5$\n<img src=\"assets\\st0271_3a22a8ce4fe1.png\"><br>"
  }
