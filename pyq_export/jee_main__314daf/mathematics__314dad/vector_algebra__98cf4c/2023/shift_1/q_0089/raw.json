  "solution": {
    "text": "<p>Given:</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>&#945;</mi><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>n</mi><mo>^</mo></mover></math>&nbsp;where,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>&#8800;</mo><mn>0</mn></math>&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>&#945;</mi><mfenced><mrow><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>-</mo><mfenced><mrow><mover><mi>n</mi><mo>^</mo></mover><mo>&#183;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>12</mn><mi>&#945;</mi><mo>-</mo><mn>0</mn></math></p><p>Since,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>n</mi><mo>^</mo></mover><mo>&#8869;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#8658;</mo><mfenced><mrow><mover><mi>n</mi><mo>^</mo></mover><mo>&#183;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>0</mn></math>.</p><p>Now,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mfenced><mrow><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mfenced><mrow><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover></mrow></mfenced><mover><mi>b</mi><mo>&#8594;</mo></mo