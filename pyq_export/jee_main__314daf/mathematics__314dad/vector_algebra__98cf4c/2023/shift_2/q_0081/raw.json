  "question": {
    "text": "If the points <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi></math>&nbsp;are respectively the circumcenter and the orthocentre of a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8710;</mo><mi>A</mi><mi>B</mi><mi>C</mi></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>P</mi><mi>A</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover><mrow><mi>P</mi><mi>B</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover><mrow><mi>P</mi><mi>C</mi></mrow><mo>&#8594;</mo></mover></math> is equal to _______",
    "image": null
  },
