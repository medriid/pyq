  "solution": {
    "text": "<p style=\"margin:0cm 0cm 10pt\"><span style=\"font-size:11pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Give ellipse</span></span></span></p><p style=\"margin:0cm 0cm 10pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mn>5</mn></mfrac><mo>+</mo><mfrac><msup><mi>y</mi><mn>2</mn></msup><mn>4</mn></mfrac><mo>=</mo><mn>1</mn><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mn>1</mn></mfenced></math></p><p style=\"margin:0cm 0cm 10pt\"><span style=\"font-size:11pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced><mrow><msqrt><mn>5</mn></msqrt><mi>cos</mi><mi>&#952;</mi><mo>,</mo><mo>&#160;</mo><mn>2</mn><mi>sin</mi><mi>&#952;</mi></mrow></mfenced></math></span></span></span></p><p style=\"margin:0cm 0cm 10pt\"><span style=\"font-size:11pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Ellipse (1)</span></span></span></p><p style=\"margin:0cm 0cm 10pt\"><span style=\"font-size:11pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\">Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mfenced><mrow><mn>0</mn><mo>,</mo><mo>&#160;</mo><mo>-</mo><mn>4</mn></mrow></mfenced></math></span></span></span></p><p style=\"margin:0cm 0cm 10pt\"><span style=\"font-size:11pt\"><span style=\"line-height:115%\"><span style=\"font-family:Calibri,sans-serif\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><msup><mi>Q</mi><mn>2</mn></msup><mo>=</mo><msup><mfenced separators=\"|\"><msqrt><msup><mfenced separators=\"|\"><mrow><msqrt><mn>5</mn></msqrt><mi>cos</mi><mi>&#952;</mi></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>sin</mi><mi>&#952;</m