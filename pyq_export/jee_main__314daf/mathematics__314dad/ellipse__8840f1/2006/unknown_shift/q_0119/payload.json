  "question": {
    "text": "In an ellipse, the distance between its foci is 6 and minor axis is 8. Then its eccentricity is"
  },
  "options": [
    {
      "text": "\n$\\frac{3}{5}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{1}{2}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{4}{5}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{\\sqrt{5}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$2 a e=6 \\Rightarrow a e=3$\n$2 b=8 \\Rightarrow b=4$\n$b^2=a^2\\left(1-e^2\\right)$\n$16=a^2-a^2 e^2$\n$a^2=16+9=25$\n$a=5$\n$\\therefore e=\\frac{3}{a}=\\frac{3}{5}$"
  }
}