  "question": {
    "text": "The eccentricity of an ellipse having centre&nbsp;at the origin, axes along the co-ordinate axes and passing through the points&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>4</mn><mo>,</mo><mo>-</mo><mn>1</mn></mrow></mfenced></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>-</mo><mn>2</mn><mo>,</mo><mn>2</mn></mrow></mfenced></math>&nbsp;is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": true
