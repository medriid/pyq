  "question": {
    "text": "If the length of the minor axis of an ellipse is equal to one fourth of the distance between the foci, then the eccentricity of the ellipse is :",
    "image": null
  },
  "options": [
    {
      "id": "STCL7",
      "text": "$\\frac{4}{\\sqrt{17}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "lmyFs",
      "text": "$\\frac{\\sqrt{3}}{16}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AgBBj",
      "text": "$\\frac{3}{\\sqrt{19}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YHiM8",
      "text": "$\\frac{\\sqrt{5}}{7}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & 2 \\mathrm{~b}=\\frac{1}{4}(2 \\mathrm{ae}) \\\\ & \\frac{\\mathrm{b}}{\\mathrm{a}}=\\frac{\\mathrm{e}}{4} \\\\ & \\mathrm{e}=\\sqrt{1-\\frac{\\mathrm{b}^2}{\\mathrm{a}^2}} \\\\ & \\mathrm{e}=\\sqrt{1-\\frac{\\mathrm{e}^2}{16}} \\\\ & \\mathrm{e}^2\\left(1+\\frac{1}{16}\\right)=1 \\\\ & \\mathrm{e}=\\frac{4}{\\sqrt{17}}\\end{aligned}$",
    "image": null
  },
