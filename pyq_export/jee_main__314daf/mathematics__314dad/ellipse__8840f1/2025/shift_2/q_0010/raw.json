  "question": {
    "text": "Let<br/>$A=\\{(\\alpha, \\beta) \\in \\mathbf{R} \\times \\mathbf{R}:|\\alpha-1| \\leq 4 \\text { and }|\\beta-5| \\leq 6\\}$<br/>and<br/>$B=\\left\\{(\\alpha, \\beta) \\in \\mathbf{R} \\times \\mathbf{R}: 16(\\alpha-2)^2+9(\\beta-6)^2 \\leq 144\\right\\}$",
    "image": null
  },
  "options": [
    {
      "id": "GRTMF",
      "text": "$\\mathrm{B} \\subset \\mathrm{A}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "nQS0E",
      "text": "$\\mathrm{A} \\cup \\mathrm{B}=\\{(\\mathrm{x}, \\mathrm{y}):-4 \\leq \\mathrm{x} \\leq 4,-1 \\leq \\mathrm{y} \\leq 11\\}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oBsKR",
      "text": "neither $\\mathrm{A} \\subset \\mathrm{B}$ nor $\\mathrm{B} \\subset \\mathrm{A}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BxKcI",
      "text": "$A \\subset B$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { A : }|x-1| \\leq 4 \\text { and }|y-5| \\leq 6 \\\\ & \\Rightarrow-4 \\leq x-1 \\leq 4 \\Rightarrow-6 \\leq y-5 \\leq 6 \\\\ & \\Rightarrow-3 \\leq x \\leq 5 \\quad \\Rightarrow-1 \\leq y \\leq 11 \\\\ & \\text { B : } 16(x-2)^2+9(y-6)^2 \\leq 144 \\\\ & \\text { B : } \\frac{(x-2)^2}{9}+\\frac{(y-6)^2}{16} \\leq 1\\end{aligned}$<br/><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/gtdjsS85poiLSJpjf8mW6lPz7SF-nQFG2XIAdCutYoQ.original.fullsize.png\"/><br/>From Diagram $\\mathrm{B} \\subset \\mathrm{A}$",
    "image": null
  },
