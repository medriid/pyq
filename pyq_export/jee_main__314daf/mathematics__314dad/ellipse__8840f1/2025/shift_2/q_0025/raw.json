  "question": {
    "text": "The length of the chord of the ellipse $\\frac{x^2}{4}+\\frac{y^2}{2}=1$, whose mid-point is $\\left(1, \\frac{1}{2}\\right)$, is :",
    "image": null
  },
  "options": [
    {
      "id": "sCKdM",
      "text": "$\\frac{5}{3} \\sqrt{15}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2FO7n",
      "text": "$\\frac{1}{3} \\sqrt{15}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Tvzhl",
      "text": "$\\frac{2}{3} \\sqrt{15}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XaaYN",
      "text": "$\\sqrt{15}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}\n& T=S_1 \\\\\n& \\frac{x \\cdot 1}{4}+\\frac{y}{4}=\\frac{1}{4}+\\frac{1}{8} \\\\\n& \\Rightarrow 2 x+2 y=3 \\\\\n& \\frac{x^2}{4}+\\frac{\\left(\\frac{3-2 x}{2}\\right)^2}{2}=1 \\\\\n& \\Rightarrow x=\\frac{12 \\pm \\sqrt{120}}{12} \\Rightarrow y=\\frac{1}{2} \\mp \\frac{\\sqrt{120}}{12}\n\\end{aligned}$\n\nSo length of chord\n$=\\frac{2 \\sqrt{15}}{3}$",
    "image": null
  },
