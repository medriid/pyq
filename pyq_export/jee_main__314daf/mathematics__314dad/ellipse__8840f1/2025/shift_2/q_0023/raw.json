  "question": {
    "text": "The equation of the chord, of the ellipse $\\frac{x^2}{25}+\\frac{y^2}{16}=1$, whose mid-point is $(3,1)$ is :",
    "image": null
  },
  "options": [
    {
      "id": "mbcSv",
      "text": "$48 x+25 y=169$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "HvaCR",
      "text": "$5 x+16 y=31$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rpCTs",
      "text": "$25 x+101 y=176$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A9xXi",
      "text": "$4 x+122 y=134$",
      "image": null,
      "isCorrect": false
