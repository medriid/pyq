  "correctValue": null,
  "solution": {
    "text": "Equation of chord with given middle point\n$\\begin{aligned}\n& T=S_1 \\\\\n& \\Rightarrow \\frac{3 x}{25}+\\frac{\\mathrm{y}}{16}-1=\\frac{9}{25}+\\frac{1}{16}-1 \\\\\n& 48 \\mathrm{x}+25 \\mathrm{y}=144+25 \\\\\n& 48 \\mathrm{x}+25 \\mathrm{y}=169 \\text { Ans. }\n\\end{aligned}$",
    "image": null
  },
