  "question": {
    "text": "Let<br/>$A=\\{(\\alpha, \\beta) \\in \\mathbf{R} \\times \\mathbf{R}:|\\alpha-1| \\leq 4 \\text { and }|\\beta-5| \\leq 6\\}$<br/>and<br/>$B=\\left\\{(\\alpha, \\beta) \\in \\mathbf{R} \\times \\mathbf{R}: 16(\\alpha-2)^2+9(\\beta-6)^2 \\leq 144\\right\\}$"
  },
  "options": [
    {
      "text": "$\\mathrm{B} \\subset \\mathrm{A}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{A} \\cup \\mathrm{B}=\\{(\\mathrm{x}, \\mathrm{y}):-4 \\leq \\mathrm{x} \\leq 4,-1 \\leq \\mathrm{y} \\leq 11\\}$",
      "is_correct": false
    },
    {
      "text": "neither $\\mathrm{A} \\subset \\mathrm{B}$ nor $\\mathrm{B} \\subset \\mathrm{A}$",
      "is_correct": false
    },
    {
      "text": "$A \\subset B$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { A : }|x-1| \\leq 4 \\text { and }|y-5| \\leq 6 \\\\ & \\Rightarrow-4 \\leq x-1 \\leq 4 \\Rightarrow-6 \\leq y-5 \\leq 6 \\\\ & \\Rightarrow-3 \\leq x \\leq 5 \\quad \\Rightarrow-1 \\leq y \\leq 11 \\\\ & \\text { B : } 16(x-2)^2+9(y-6)^2 \\leq 144 \\\\ & \\text { B : } \\frac{(x-2)^2}{9}+\\frac{(y-6)^2}{16} \\leq 1\\end{aligned}$<br/><img src=\"assets\\st0002_6f34d76d4607.png\"/><br/>From Diagram $\\mathrm{B} \\subset \\mathrm{A}$"
  }
}