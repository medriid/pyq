  "question": {
    "text": "The length of the latus-rectum of the ellipse, whose foci are $(2,5)$ and $(2,-3)$ and eccentricity is $\\frac{4}{5}$, is",
    "image": null
  },
  "options": [
    {
      "id": "BOhvu",
      "text": "$\\frac{6}{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JFm6Q",
      "text": "$\\frac{50}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HzkNS",
      "text": "$\\frac{10}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
