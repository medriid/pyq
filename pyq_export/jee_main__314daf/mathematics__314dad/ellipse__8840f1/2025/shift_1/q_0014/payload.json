    },
    {
      "text": "$\\frac{50}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{10}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{18}{5}$",
      "is_correct": true
    }
