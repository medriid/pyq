    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mfrac><mn>32</mn><mrow><mn>7</mn><msqrt><mn>5</mn></msqrt></mrow></mfrac></mfenced></math>",
