      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msqrt><mn>6</mn></msqrt></mrow><mn>7</mn></mfrac></math>",
      "is_correct": false
