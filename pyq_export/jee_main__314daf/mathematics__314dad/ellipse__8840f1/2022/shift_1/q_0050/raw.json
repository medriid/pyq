      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>31</mn></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "jpZnq",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>32</mn></math>",
      "isCorrect": false,
      "image": null
