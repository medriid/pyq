  "solution": {
    "text": "<math><mn>2</mn><mi>a</mi><mi>e</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mn>2</mn><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>a</mi></mrow></mfrac></math><br /><br /><math><mn>2</mn><mi>e</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />We know that<br /><br /><math><mi>e</mi><mo>=</mo><msqrt><mn>1</mn><mo>-</mo><mfrac><mrow><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>e</mi><mo>=</mo><msqrt><mn>1</mn><mo>-</mo><mn>2</mn><mi>e</mi></msqrt></math><br /><br /><math><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>1</mn><mo>-</mo><mn>2</mn><mi>e</mi></math><br /><br /><math><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>e</mi><mo>-</mo><mn>1</mn><mo>=</mo><mn>0</mn></math><br /><br /><math><mfrac><mrow><mo>-</mo><mn>2</mn><mo>&#177;</mo><msqrt><mn>4</mn><mo>+</mo><mn>4</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>2</mn><mo>&#177;</mo><mn>2</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>1</mn><mo>+</mo><msqrt><mn>2</mn></msqrt><mi>&#160;</mi><mi>&#160;</mi><mo>&#38;</mo><mi>&#160;</mi><mo>-</mo><mn>1</mn><mo>-</mo><msqrt><mn>2</mn></msqrt></math><br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>e</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>-</mo><mn>1</mn></math>",
