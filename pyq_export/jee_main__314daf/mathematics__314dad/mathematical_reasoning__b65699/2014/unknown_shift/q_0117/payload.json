  "question": {
    "text": "Let $\\mathrm{p}, \\mathrm{q}, \\mathrm{r}$ denote arbitrary statements. Then the logically equivalent of the statement $\\mathrm{p} \\Rightarrow(\\mathrm{q} \\vee \\mathrm{r})$ is:"
  },
  "options": [
    {
      "text": "\n$(\\mathrm{p} \\vee \\mathrm{q}) \\Rightarrow \\mathrm{r}$\n",
      "is_correct": false
    },
    {
      "text": "\n$(\\mathrm{p} \\Rightarrow \\mathrm{q}) \\vee(\\mathrm{p} \\Rightarrow \\mathrm{r})$\n",
      "is_correct": true
    },
    {
      "text": "\n$(\\mathrm{p} \\Rightarrow \\sim \\mathrm{q}) \\wedge(\\mathrm{p} \\Rightarrow \\mathrm{r})$\n",
      "is_correct": false
    },
    {
      "text": "\n$(\\mathrm{p} \\Rightarrow \\mathrm{q}) \\wedge(\\mathrm{p} \\Rightarrow \\sim \\mathrm{r})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Given statement is\n$p \\Rightarrow(q \\vee r)$ which is equivalent to\n$$\n(p \\Rightarrow q) \\vee(p \\Rightarrow r)\n$$"
  }
}