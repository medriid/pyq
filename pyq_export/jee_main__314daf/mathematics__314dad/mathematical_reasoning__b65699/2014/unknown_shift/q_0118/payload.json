  "question": {
    "text": "The proposition $\\sim(p \\vee \\sim q) \\vee \\sim(p \\vee q)$ is logically equivalent to:"
  },
  "options": [
    {
      "text": "\n$\\mathrm{p}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{q}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sim \\mathrm{p}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\sim \\mathrm{q}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Given $\\sim(p \\vee \\sim q) \\vee \\sim(p \\vee q)$\n$$\n\\begin{aligned}\n&\\equiv(\\sim p \\vee q) \\vee(\\sim p \\vee \\sim q) \\\\\n&\\equiv \\sim p \\vee(q \\vee \\sim q) \\\\\n&\\equiv \\sim p\n\\end{aligned}\n$$"
  }
