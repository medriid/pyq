  "question": {
    "text": "The statement $p \\rightarrow(q \\rightarrow p)$ is equivalent to"
  },
  "options": [
    {
      "text": "\n$p \\rightarrow(p \\rightarrow q)$\n",
      "is_correct": false
    },
    {
      "text": "\n$p \\rightarrow(p \\vee q)$\n",
      "is_correct": true
    },
    {
      "text": "\n$p \\rightarrow(p \\wedge q)$\n",
      "is_correct": false
    },
    {
      "text": "\n$p \\rightarrow(p \\leftrightarrow q)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& p \\rightarrow(q \\rightarrow p)=\\sim p \\vee(q \\rightarrow p) \\\\\n& =\\sim p \\vee(\\sim q \\vee p) \\quad \\text { since } p \\vee \\sim p \\text { is always true } \\\\\n& =\\sim p \\vee p \\vee q=p \\rightarrow(p \\vee q) .\n\\end{aligned}\n$$"
  }
}