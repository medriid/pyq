    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8743;</mo><mo>,</mo><mo>&#8744;</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8744;</mo><mo>,</mo><mo>&#8594;</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8743;</mo><mo>,</mo><mo>&#8594;</mo></math>",
