  "question": {
    "text": "The statement $p \\rightarrow(q \\rightarrow p)$ is equivalent to :"
  },
  "options": [
    {
      "text": "\n$p \\rightarrow q$\n",
      "is_correct": false
    },
    {
      "text": "\n$p \\rightarrow(p \\vee q)$\n",
      "is_correct": true
    },
    {
      "text": "\n$p \\rightarrow(p \\rightarrow q)$\n",
      "is_correct": false
    },
    {
      "text": "\n$p \\rightarrow(p \\wedge q)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0123_63397c270e5b.png\"><br>\nSince truth value of $p \\rightarrow(q \\rightarrow p)$ and $p \\rightarrow(p \\vee q)$ are same, hence $p \\rightarrow(q \\rightarrow p)$ is equivalent to $p \\rightarrow(p \\vee q)$."
  }
}