    },
    {
      "text": "<math><mo>~</mo><mi>Q</mi><mo>↔</mo><mi>P</mi><mo>∨</mo><mo>~</mo><mi>R</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mo>~</mo><mi>Q</mi><mo>↔</mo><mi>P</mi><mo>∧</mo><mo>~</mo><mi>R</mi></math>",
