      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>&#8744;</mo><mo>(</mo><mi>q</mi><mo>&#8744;</mo><mo>(</mo><mo>-</mo><mi>p</mi><mo>)</mo><mo>)</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>&#8743;</mo><mo>(</mo><mi>q</mi><mo>&#8743;</mo><mo>(</mo><mo>-</mo><mi>p</mi><mo>)</mo><mo>)</mo></math>",
