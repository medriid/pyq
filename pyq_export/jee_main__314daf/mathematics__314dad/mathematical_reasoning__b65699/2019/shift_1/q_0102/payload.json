enced><mo>&#8743;</mo><mfenced><mrow><mo>~</mo><mi>p</mi><mo>&#8744;</mo><mi>q</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8801;</mo><mfenced><mrow><mi>q</mi><mo>&#8743;</mo><mi>p</mi></mrow></mfenced><mo>&#8743;</mo><mfenced><mrow><mo>~</mo><mi>p</mi><mo>&#8744;</mo><mi>q</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8801;</mo><mi>q</mi><mo>&#8743;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mi>p</mi><mo>&#8743;</mo><mfenced separators=\"|\"><mrow><mo>~</mo><mi>p</mi><mo>&#8744;</mo><mi>q</mi></mrow></mfenced></mrow></mfenced></math> (using associative property)</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8801;</mo><mi>q</mi><mo>&#8743;</mo><mfenced><mrow><mi>p</mi><mo>&#8743;</mo><mi>q</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8801;</mo><mi>p</mi><mo>&#8743;</mo><mi>q</mi></math></p>"
