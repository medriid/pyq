  "question": {
    "text": "Consider the following statements\n$\\mathrm{P}$ : Suman is brilliant\nQ : Suman is rich\n$\\mathrm{R}$ : Suman is honest\nThe negation of the statement \"Suman is brilliant and dishonest if and only if Suman is rich\" can be expressed as"
  },
  "options": [
    {
      "text": "\n$\\sim(\\mathrm{Q} \\leftrightarrow(\\mathrm{P} \\wedge \\sim \\mathrm{R}))$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\sim Q \\leftrightarrow \\sim P \\wedge R$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sim(P \\wedge \\sim R) \\leftrightarrow Q$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sim P \\wedge(Q \\leftrightarrow \\sim R)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\sim\\left\\{\\left(P_{\\wedge} \\sim R\\right) \\leftrightarrow Q\\right\\}=\\sim\\left\\{Q \\leftrightarrow\\left(P_{\\wedge} \\sim R\\right)\\right\\}$"
  }
}