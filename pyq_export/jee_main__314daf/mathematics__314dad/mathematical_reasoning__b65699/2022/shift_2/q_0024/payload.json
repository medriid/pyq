      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>&#8658;</mo><mfenced><mrow><mi>q</mi><mo>&#8744;</mo><mi>r</mi></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>p</mi><mo>&#8743;</mo><mfenced><mrow><mo>~</mo><mi>q</mi></mrow></mfenced></mrow></mfenced><mo>&#8658;</mo><mi>r</mi></math>",
