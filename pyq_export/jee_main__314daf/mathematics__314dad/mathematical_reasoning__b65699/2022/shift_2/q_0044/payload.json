      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>&#8594;</mo><mfenced><mrow><mi>A</mi><mo>&#8744;</mo><mi>C</mi></mrow></mfenced></math>",
      "is_correct": false
    },
