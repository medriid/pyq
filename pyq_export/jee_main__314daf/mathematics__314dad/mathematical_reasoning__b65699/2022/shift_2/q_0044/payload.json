    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>&#8594;</mo><mfenced><mrow><mfenced><mrow><mo>~</mo><mi>A</mi></mrow></mfenced><mo>&#8744;</mo><mfenced><mrow><mo>~</mo><mi>C</mi></mrow></mfenced></mrow></mfenced></math>",
      "is_correct": false
