  "question": {
    "text": "Let $p$ and $q$ denote the following statements $p$ : The sun is shining\n$q$ : I shall play tennis in the afternoon\nThe negation of the statement \"If the sun is shining then I shall play tennis in the afternoon\", is",
    "image": null
  },
  "options": [
    {
      "id": "RHkAb",
      "text": "\n$q \\Rightarrow \\sim p$\n",
      "image": null,
      "isCorrect": false
    },
