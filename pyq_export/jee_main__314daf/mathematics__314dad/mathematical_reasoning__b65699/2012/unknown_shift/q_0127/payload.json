  "question": {
    "text": "Let $p$ and $q$ be two Statements. Amongst the following, the Statement that is equivalent to $p \\rightarrow q$ is"
  },
  "options": [
    {
      "text": "\n$p \\wedge \\sim q$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\sim p \\vee q$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\sim p \\wedge q$\n",
      "is_correct": false
    },
    {
      "text": "\n$p \\vee \\sim q$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Let $p$ and $q$ be two statements. $p \\rightarrow q$ is equivalent to $\\sim p \\vee q$."
  }
