  "question": {
    "text": "The logically equivalent preposition of $p \\Leftrightarrow q$ is"
  },
  "options": [
    {
      "text": "\n$(p \\Rightarrow q \\wedge) q \\Rightarrow p \\quad)$\n",
      "is_correct": true
    },
    {
      "text": "\n$p \\wedge q$\n",
      "is_correct": false
    },
    {
      "text": "\n$(p \\wedge q \\vee) q \\neq p \\quad)$\n",
      "is_correct": false
    },
    {
      "text": "\n$(p \\wedge q \\Rightarrow q \\vee(p \\quad)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$(p \\Rightarrow q) \\wedge(q \\Rightarrow p)$ means $p \\Leftrightarrow q$"
  }
}