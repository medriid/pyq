  "question": {
    "text": "The logically equivalent preposition of $p \\Leftrightarrow q$ is",
    "image": null
  },
  "options": [
    {
      "id": "WYYBl",
      "text": "\n$(p \\Rightarrow q \\wedge) q \\Rightarrow p \\quad)$\n",
      "image": null,
      "isCorrect": true
    },
    {
