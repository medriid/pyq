  "question": {
    "text": "In a triangle with sides $a, b, c, r_1>r_2>r_3$ (which are the ex-radii) then",
    "image": null
  },
  "options": [
    {
      "id": "JHcVk",
      "text": "\na > b > c\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "d2fOU",
      "text": "\na  < b < c",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "H9a1C",
      "text": "\na > b and b  < c",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3RJaz",
      "text": "\na  < b and b > c",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$r_1>r_2>r_3 \\Rightarrow \\frac{\\Delta}{s-a}>\\frac{\\Delta}{s-b}>\\frac{\\Delta}{s-c} \\Rightarrow s-a < s-b < s-c \\Rightarrow-a < -b < -c \\Rightarrow a>b>c$",
    "image": null
  },
