  "question": {
    "text": "The sides of a triangle are $\\sin \\alpha, \\cos \\alpha$ and $\\sqrt{1+\\sin \\alpha \\cos \\alpha}$ for some $0 < \\alpha < \\frac{\\pi}{2}$. Then the greatest angle of the triangle is"
  },
  "options": [
    {
      "text": "\n$60^{\\circ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$90^{\\circ}$\n",
      "is_correct": false
    },
    {
      "text": "\n$120^{\\circ}$\n",
      "is_correct": true
    },
    {
      "text": "\n$150^{\\circ}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Greatest side is $\\sqrt{1+\\sin \\alpha \\cos \\alpha}$, by applying cos rule we get greatest angle $=120^{\\circ}$."
  }
