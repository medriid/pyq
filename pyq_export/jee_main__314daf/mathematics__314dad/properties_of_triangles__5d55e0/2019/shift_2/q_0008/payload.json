  "question": {
    "text": "If the lengths of the sides of a triangle are in A.P&nbsp;and the greatest angle is double the smallest, then a ratio of lengths of the sides of this triangle is:"
  },
  "options": [
    {
      "text": "<math><mn>3</mn><mo>:</mo><mn>4</mn><mo>:</mo><mn>5</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>5</mn><mo>:</mo><mn>6</mn><mo>:</mo><mn>7</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>5</mn><mo>:</mo><mn>9</mn><mo>:</mo><mn>13</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn><mo>:</mo><mn>5</mn><mo>:</mo><mn>6</mn></math>",
