  "question": {
    "text": "ABC is a triangle. Forces $\\vec{P}, \\vec{Q}, \\vec{R}$ acting along $I A, I B$ and $I C$ respectively are in equilibrium, where $I$ is the incentre of $\\triangle A B C$. Then $P: Q: R$ is",
    "image": null
  },
  "options": [
    {
      "id": "YAy5e",
      "text": "\n$\\sin A: \\sin B: \\sin C$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vA1N7",
      "text": "\n$\\sin \\frac{A}{2}: \\sin \\frac{B}{2}: \\sin \\frac{C}{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mhZUr",
      "text": "\n$\\cos \\frac{\\mathrm{A}}{2}: \\cos \\frac{\\mathrm{B}}{2}: \\cos \\frac{\\mathrm{C}}{2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "lJ1QS",
      "text": "\n$\\cos A: \\cos B: \\cos C$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/VLDsfCJ6TeCOiKS41idw6opm_JzwNVAxKzidF3VNVSg.original.fullsize.png\"><br>\nUsing Lami's Theorem\n$$\n\\therefore P: Q: R=\\cos \\frac{A}{2}: \\cos \\frac{B}{2}: \\cos \\frac{C}{2} \\text {. }\n$$",
    "image": null
  },
