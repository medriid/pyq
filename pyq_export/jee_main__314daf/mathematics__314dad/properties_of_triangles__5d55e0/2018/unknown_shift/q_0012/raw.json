    "text": "<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/560ac10b-d480-4d3e-80b5-9e51885842ab-3a8fd56f-5c9d-46f4-8445-0dacc2ef0e19-image.png\" style=\"width: 293px; height: 57px;\" /><br /><br />Centroid&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>&nbsp;divides the line joining Orthocentre&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;and circumcentre&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> in the ratio&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>:</mo><mn>1</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mi>&#160;</mi><msqrt><msup><mfenced separators=\"|\"><mrow><mn>3</mn><mo>+</mo><mn>3</mn></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced separators=\"|\"><mrow><mn>5</mn><mo>-</mo><mn>3</mn></mrow></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><mi>&#160;</mi><msqrt><msup><mn>6</mn><mn>2</mn></msup><mo>+</mo><msup><mn>2</mn><mn>2</mn></msup></msqrt><mo>=</mo><mi>&#160;</mi><msqrt><mn>40</mn></msqrt><mo>=</mo><mn>2</mn><msqrt><mn>10</mn></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>C</mi><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>&#215;</mo><mn>2</mn><msqrt><mn>10</mn></msqrt><mo>=</mo><mn>3</mn><msqrt><mn>10</mn></msqrt></math><br /><br />Radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi>A</mi><mi>C</mi></mrow><mn>2</mn></mfrac><mo>=</mo><mn>3</mn><msqrt><mfrac><mn>10</mn><mn>4</mn></mfrac></msqrt><mo>=</mo><mn>3</mn><msqrt><mfrac><mn>5</mn><mn>2</mn></mfrac></msqrt></math>",
