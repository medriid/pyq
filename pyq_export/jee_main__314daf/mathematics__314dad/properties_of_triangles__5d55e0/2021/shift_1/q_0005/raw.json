      "image": null
    },
    {
      "id": "5Al9V",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>+</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></math>",
