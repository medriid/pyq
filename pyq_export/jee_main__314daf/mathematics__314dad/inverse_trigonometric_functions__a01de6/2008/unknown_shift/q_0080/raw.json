  "question": {
    "text": "The value of $\\cot \\left(\\operatorname{cosec}^{-1} \\frac{5}{3}+\\tan ^{-1} \\frac{2}{3}\\right)$ is",
    "image": null
  },
  "options": [
    {
      "id": "mHyOg",
      "text": "\n$\\frac{6}{17}$\n",
