    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><msup><mfenced><mrow><msup><mi>cos</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mi>a</mi></math></p><p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mi>x</mi></mfenced><mo>=</mo><mi>t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mi>sin</mi><mo>&#160;</mo><mi>t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>sin</mi><mo>&#160;</mo><mi>t</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><msup><mfenced><mrow><msup><mi>cos</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>sin</mi><mo>&#160;</mo><mi>t</mi></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mi>a</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>t</mi><mn>2</mn></msup><mo>-</mo><msup><mfenced><mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>-</mo><mi>t</mi></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mi>a</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>t</mi><mn>2</mn></msup><mo>-</mo><mfenced><mrow><mfrac><msup><mi>&#960;</mi><mn>2</mn></msup><mn>4</mn></mfrac><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo>-</mo><mi>&#960;</mi><mi>t</mi></mrow></mfenced><mo>=</mo><mi>a</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#960;</mi><mi>t</mi><mo>-</mo><mfrac><msup><mi>&#960;</mi><mn>2</mn></msup><mn>4</mn></mfrac><mo>=</mo><mi>a</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mfrac><mi>a</mi><mi>&#960;</mi></mfrac><mo>+</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/M