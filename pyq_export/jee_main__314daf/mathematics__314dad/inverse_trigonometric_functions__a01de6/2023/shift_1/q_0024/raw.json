  "question": {
    "text": "If&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>=</mo><mfenced open=\"{\" close=\"}\"><mrow><mi>x</mi><mo>&#8712;</mo><mi mathvariant=\"normal\">&#8477;</mi><mo>:</mo><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mfrac><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>2</mn></msqrt></mfrac></mfenced><mo>-</mo><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced><mfrac><mi>x</mi><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></msqrt></mfrac></mfenced><mo>=</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></mrow></mfenced></math>&nbsp;then&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mo>&#8721;</mo><mrow><mi>x</mi><mo>&#8712;</mo><mi>S</mi></mrow></munder><mfenced><mrow><mi>sin</mi><mfenced><mrow><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>5</mn></mrow></mfenced><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow></mfenced><mo>-</mo><mi>cos</mi><mfenced><mrow><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>5</mn></mrow></mfenced><mi>&#960;</mi></mrow></mfenced></mrow></mfenced></math>&nbsp;is equal to&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mo>.</mo></math>",
    "image": null
  },
