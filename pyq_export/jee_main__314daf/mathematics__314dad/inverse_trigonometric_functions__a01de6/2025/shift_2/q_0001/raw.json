  "question": {
    "text": "The sum of the infinite series<br/>$\\cot ^{-1}\\left(\\frac{7}{4}\\right)+\\cot ^{-1}\\left(\\frac{19}{4}\\right)+$ $\\cot ^{-1}\\left(\\frac{39}{4}\\right)+\\cot ^{-1}\\left(\\frac{67}{4}\\right)+\\ldots .$ is :-",
    "image": null
  },
  "options": [
    {
      "id": "yd20n",
      "text": "$\\frac{\\pi}{2}+\\tan ^{-1}\\left(\\frac{1}{2}\\right)$",
      "image": null,
