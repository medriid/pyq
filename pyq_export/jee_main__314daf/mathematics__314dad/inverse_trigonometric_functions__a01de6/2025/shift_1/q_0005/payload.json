  "question": {
    "text": "$\\cos \\left(\\sin ^{-1} \\frac{3}{5}+\\sin ^{-1} \\frac{5}{13}+\\sin ^{-1} \\frac{33}{65}\\right)$ is equal to:"
  },
  "options": [
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "0",
      "is_correct": true
    },
    {
      "text": "$\\frac{32}{65}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{33}{65}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\cos \\left(\\sin ^{-1} \\frac{3}{5}+\\sin ^{-1} \\frac{5}{13}+\\sin ^{-1} \\frac{33}{65}\\right) \\\\ & \\cos \\left(\\tan ^{-1} \\frac{3}{4}+\\tan ^{-1} \\frac{5}{12}+\\tan ^{-1} \\frac{33}{56}\\right) \\\\ & \\cos \\left(\\tan ^{-1}\\left(\\frac{\\frac{3}{4}+\\frac{5}{12}}{1+\\frac{3}{4} \\cdot \\frac{5}{12}}\\right)+\\tan ^{-1} \\frac{33}{56}\\right) \\\\ & \\cos \\left(\\tan ^{-1} \\frac{56}{33}+\\cot ^{-1} \\frac{56}{33}\\right) \\\\ & \\cos \\left(\\frac{\\pi}{2}\\right)=0\\end{aligned}$"
  }
