  "question": {
    "text": "Considering the principal values of the inverse trigonometric functions, $\\sin ^{-1}\\left(\\frac{\\sqrt{3}}{2} x+\\frac{1}{2} \\sqrt{1-x^2}\\right),-\\frac{1}{2} \\lt x \\lt \\frac{1}{\\sqrt{2}}$, is equal to"
  },
  "options": [
    {
      "text": "$\\frac{\\pi}{4}+\\sin ^{-1} x$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{6}+\\sin ^{-1} x$",
      "is_correct": true
    },
    {
      "text": "$\\frac{-5 \\pi}{6}-\\sin ^{-1} x$",
      "is_correct": false
    },
    {
      "text": "$\\frac{5 \\pi}{6}-\\sin ^{-1} x$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\sin ^{-1}\\left(\\frac{\\sqrt{3}}{2} x+\\frac{1}{2} \\sqrt{1-x^2}\\right), \\frac{-1}{2} \\lt x \\lt \\frac{1}{\\sqrt{2}} \\\\ & \\Rightarrow \\text { Let } \\sin ^{-1}(x)=\\theta \\quad \\frac{-\\pi}{6} \\lt \\theta \\lt \\frac{\\pi}{4} \\\\ & \\Rightarrow x=\\sin \\theta, \\text { then } \\\\ & \\Rightarrow \\sin ^{-1}\\left(\\frac{\\sqrt{3}}{2} \\sin \\theta+\\frac{1}{2} \\cos \\theta\\right) \\\\ & \\Rightarrow \\sin ^{-1}\\left(\\sin \\left(\\theta+\\frac{\\pi}{6}\\right)\\right)=\\theta+\\frac{\\pi}{6} \\\\ & \\Rightarrow \\sin ^{-1}(x)+\\frac{\\pi}{6}\\end{aligned}$"
  }
}