    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mfrac><mn>65</mn><mn>156</mn></mfrac></mfenced></math>",
