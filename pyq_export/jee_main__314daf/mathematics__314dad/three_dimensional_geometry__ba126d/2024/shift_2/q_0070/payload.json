  "solution": {
    "text": "<p>Given,</p><p><img src=\"assets\\st0070_1fee808948c5.png\" style=\"width: 350px; height: 278px;\"/></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mover><mi>QP</mi><mo>→</mo></mover><mo>=</mo><mo>-</mo><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mn>4</mn><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>RP</mi><mo>→</mo></mover><mo>=</mo><mo>-</mo><mn>4</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mover><mi mathvariant=\"normal\">k</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mo>∠</mo><mi>QPR</mi><mo>=</mo><mfrac><mrow><mover><mi>QP</mi><mo>→</mo></mover><mo>·</mo><mover><mi>RP</mi><mo>→</mo></mover></mrow><mrow><mfenced close=\"|\" open=\"|\"><mover><mi>QP</mi><mo>→</mo></mover></mfenced><mfenced close=\"|\" open=\"|\"><mover><mi>RP</mi><mo>→</mo></mover></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>cos</mi><mo>∠</mo><mi>QPR</mi><mo>=</mo><mfrac><mrow><mn>4</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>1</mn></mrow><mrow><msqrt><mn>1</mn><mo>+</mo><mn>16</mn><mo>+</mo><mn>1</mn></msqrt><msqrt><mn>16</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>1</mn></msqrt></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>cos</mi><mo>∠</mo><mi>QPR</mi><mo>=</mo><mfrac><mn>9</mn><mn>18</mn></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mo>∠</mo><mi>QPR</mi><mo>=</mo><mfrac><mi mathvariant=\"normal\">π</mi><mn>3</mn></mfrac></math></p>"
