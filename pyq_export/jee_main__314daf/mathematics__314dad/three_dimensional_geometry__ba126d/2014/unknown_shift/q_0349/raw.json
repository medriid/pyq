  "question": {
    "text": "The angle between the lines whose direction cosines satisfy the equations <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi><mo>&#8289;</mo><mo>+</mo><mi>m</mi><mo>+</mo><mi>n</mi><mo>=</mo><mn>0</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi><msup><mo>&#8289;</mo><mn>2</mn></msup><mo>=</mo><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><msup><mi>n</mi><mn>2</mn></msup></math> is&nbsp;",
    "image": null
  },
