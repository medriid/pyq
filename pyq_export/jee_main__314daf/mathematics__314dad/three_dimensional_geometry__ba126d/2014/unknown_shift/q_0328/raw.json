    {
      "id": "ELDPm",
      "text": "<math> <mrow> <mfrac> <mrow> <mn>1</mn> <mn>3</mn> <mn>5</mn> </mrow> <mrow> <mn>7</mn> </mrow> </mfrac> </mrow> </math>",
