      "isCorrect": true,
      "image": null
    },
    {
      "id": "6KioX",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msqrt><mn>2</mn></msqrt></math>",
      "isCorrect": false,
      "image": null
    },
    {
