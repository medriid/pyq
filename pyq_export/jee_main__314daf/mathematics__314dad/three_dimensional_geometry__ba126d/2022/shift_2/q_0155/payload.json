      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>-</mo><mn>5</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo>-</mo><mn>1</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>3</mn><mo>,</mo><mo>-</mo><mn>1</mn><mo>,</mo><mn>0</mn></mrow></mfenced></math>",
