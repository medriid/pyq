  "question": {
    "text": "The vector $\\vec{a}=\\alpha \\hat{i}+2 \\hat{j}+\\beta \\hat{k}$ lies in the plane of the vectors $\\vec{b}=\\hat{i}+\\hat{j}$ and $\\vec{c}=\\hat{j}+\\hat{k}$ and bisects the angle between $\\vec{b}$ and $\\vec{c}$. Then which one of the following gives possible values of $\\alpha$ and $\\beta$ ?"
  },
  "options": [
    {
      "text": "\n$\\alpha=2, \\beta=2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\alpha=1, \\beta=2$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\alpha=2, \\beta=1$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\alpha=1, \\beta=1$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\overrightarrow{\\mathrm{a}}=\\lambda(\\hat{\\mathrm{b}}+\\hat{\\mathrm{c}}) \\\\\n& \\Rightarrow \\alpha \\hat{\\mathrm{i}}+2 \\hat{\\mathrm{j}}+\\beta \\hat{\\mathrm{k}}=\\lambda\\left(\\frac{\\hat{\\mathrm{i}}+2 \\hat{\\mathrm{j}}+\\hat{\\mathrm{k}}}{\\sqrt{2}}\\right) \\\\\n& \\lambda=\\sqrt{2} \\alpha \\text { and } \\lambda=\\sqrt{2} \\text { and } \\lambda=\\sqrt{2} \\beta \\\\\n& \\Rightarrow \\alpha=1 \\text { and } \\beta=1 .\n\\end{aligned}\n$$"
  }
}