  "question": {
    "text": "The shortest distance between the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi></math>&nbsp;- axis and the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mn>2</mn><mi>z</mi><mo>-</mo><mn>3</mn><mo>=</mo><mn>0</mn><mo>=</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo>+</mo><mn>4</mn><mi>z</mi><mo>-</mo><mn>4</mn><mo>,</mo></math> is",
    "image": null
  },
  "options": [
    {
      "id": "UnYxH",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math>",
      "image": null,
