  "question": {
    "text": "If the projections of a line segment on the $x, y$ and $z$-axes in 3-dimensional space are 2, 3 and 6 respectively, then the length of the line segment is :"
  },
  "options": [
    {
      "text": "\n12\n",
      "is_correct": false
    },
    {
      "text": "\n7\n",
      "is_correct": true
    },
    {
      "text": "\n9\n",
      "is_correct": false
    },
    {
      "text": "\n6",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Length of the line segment\n$$\n=\\sqrt{(2)^2+(3)^2+(6)^2}=7\n$$"
  }
}