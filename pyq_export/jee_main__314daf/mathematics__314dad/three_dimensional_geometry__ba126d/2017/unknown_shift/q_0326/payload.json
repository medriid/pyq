    "text": "<math><mover accent=\"true\"><mrow><mi>n</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>&#160;</mi><msub><mrow><mover accent=\"true\"><mrow><mi>n</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>&#215;</mo><msub><mrow><mover accent=\"true\"><mrow><mi>n</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>2</mn></mrow></msub><mi>&#160;</mi></math><br /><br />= <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover></mtd><mtd><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mtd><mtd><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn></mrow></mfenced><mo>-</mo><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mfenced separators=\"|\"><mrow><mo>-</mo><mn>7</mn></mrow></mfenced><mo>+</mo><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover><mfenced separators=\"|\"><mrow><mn>13</mn></mrow></mfenced></math><br /><br /><math><mover accent=\"true\"><mrow><mi>n</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>-2</mn><mo>i</mo><mo>+</mo><mn>7</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>13</mn><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math><br /><br />Now equations of plane are<br /><br /><math><mn>3</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mn>1</mn></math>&nbsp;and<br /><br /><math><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>-</mo><mn>2</mn><mi>z</mi><mo>=</mo><mn>2</mn></math><br /><br />Let,&nbsp;<math><mi>z</mi><mo>=</mo><mn>0<