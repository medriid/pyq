  "question": {
    "text": "The two lines $x=a y+b, z=c y+d$ and $x=a^{\\prime} y+b^{\\prime} z=c^{\\prime} y+d^{\\prime}$ will be perpendicular, if and only if"
  },
  "options": [
    {
      "text": "\n$a a^{\\prime}+c c^{\\prime}+1=0$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{a} \\mathrm{a}^{\\prime}+\\mathrm{b} \\mathrm{b}^{\\prime}+\\mathrm{c} \\mathrm{c}^{\\prime}+1=0$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\mathrm{a}^{\\prime}+\\mathrm{b} \\mathrm{b}^{\\prime}+\\mathrm{c} \\mathrm{c}^{\\prime}=0$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(a+a^{\\prime}\\right)\\left(b+b^{\\prime}\\right)+\\left(c+c^{\\prime}\\right)=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{x}-\\mathrm{b}}{\\mathrm{a}}=\\frac{\\mathrm{y}}{1}=\\frac{3-\\mathrm{d}}{\\mathrm{c}} ; \\frac{\\mathrm{x}-\\mathrm{b}^{\\prime}}{\\mathrm{a}^{\\prime}}=\\frac{\\mathrm{y}}{1}=\\frac{3-\\mathrm{d}^{\\prime}}{\\mathrm{c}^{\\prime}}$\nFor perpendicular $\\mathrm{aa}^{\\prime}+1+\\mathrm{cc}^{\\prime}=0$"
  }
