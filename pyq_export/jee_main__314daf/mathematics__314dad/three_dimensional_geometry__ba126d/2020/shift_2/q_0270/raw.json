  "solution": {
    "text": "<p>Equation PQ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>+</mo><mn>2</mn></mrow><mn>3</mn></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi><mo>-</mo><mn>3</mn></mrow><mrow><mo>-</mo><mn>6</mn></mrow></mfrac><mo>=</mo><mi>&#955;</mi></math><br />Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mo>&#8801;</mo><mo>(</mo><mn>2</mn><mi>&#955;</mi><mo>+</mo><mn>1</mn><mo>,</mo><mn>3</mn><mi>&#955;</mi><mo>-</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>6</mn><mi>&#955;</mi><mo>+</mo><mn>3</mn><mo>)</mo></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi></math> lies on <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mn>5</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mo>(</mo><mn>2</mn><mi>&#955;</mi><mo>+</mo><mn>1</mn><mo>)</mo><mo>-</mo><mo>(</mo><mn>3</mn><mi>&#955;</mi><mo>-</mo><mn>2</mn><mo>)</mo><mo>+</mo><mo>(</mo><mo>-</mo><mn>6</mn><mi>&#955;</mi><mo>+</mo><mn>3</mn><mo>)</mo><mo>=</mo><mn>5</mn><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mfrac><mn>1</mn><mn>7</mn></mfrac><mo>&#8658;</mo><mi>Q</mi><mo>&#8801;</mo><mfenced><mrow><mfrac><mn>9</mn><mn>7</mn></mfrac><mo>,</mo><mo>-</mo><mfrac><mn>11</mn><mn>7</mn></mfrac><mo>,</mo><mfrac><mn>15</mn><mn>7</mn></mfrac></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>PQ</mi><mo>=</mo><msqrt><msup><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mn>9</mn><mn>7</mn></mfrac></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mrow><mo>-</mo><mn>2</mn><mo>+</mo><mfrac><mn>11</mn><mn>7</mn></mfrac></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mrow><mn>3</mn><mo>-</mo><mfrac><mn>15</mn><mn>7</mn></mfrac></mrow></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><mn>1</mn></math></p><p><img src=\"https://cdn-questio