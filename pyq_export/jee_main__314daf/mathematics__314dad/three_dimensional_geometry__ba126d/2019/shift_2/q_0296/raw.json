  "question": {
    "text": "If a point <math><mi>R</mi><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi></mrow></mfenced></math> lies on the line segment joining the points <math><mi>P</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mo>-</mo><mn>3,4</mn></mrow></mfenced><mi>&#160;</mi></math> and <math><mi>Q</mi><mfenced separators=\"|\"><mrow><mn>8,0</mn><mo>,</mo><mn>10</mn></mrow></mfenced><mo>,</mo></math> then the distance of <math><mi>R</mi></math> from the origin is",
    "image": null
  },
  "options": [
    {
      "id": "Frz7i",
      "text": "<math><mn>2</mn><msqrt><mn>21</mn></msqrt></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "DxGOk",
      "text": "<math><mi mathvariant=\"normal\"> </mi><msqrt><mn>53</mn></msqrt></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QM3Mj",
      "text": "<math><mn>6</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "N6fkG",
      "text": "<math><mi> </mi><mn>2</mn><msqrt><mn>14</mn></msqrt></math>",
      "isCorrect": true,
      "image": null
