      "text": "<math><mi>b</mi><mi>b</mi><mi>’</mi><mo>+</mo><mi>c</mi><mi>c</mi><mi>’</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
