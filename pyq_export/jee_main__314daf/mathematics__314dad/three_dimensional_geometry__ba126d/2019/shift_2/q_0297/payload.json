    {
      "text": "<math><mi>c</mi><mi>c</mi><mi>’</mi><mo>+</mo><mi>a</mi><mo>+</mo><mi>a</mi><mi>’</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>a</mi><mi>a</mi><mi>’</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>c</mi><mi>’</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": true
