    {
      "text": "<math><mi>a</mi><mi>b</mi><mi>’</mi><mo>+</mo><mi>b</mi><mi>c</mi><mi>’</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math>",
