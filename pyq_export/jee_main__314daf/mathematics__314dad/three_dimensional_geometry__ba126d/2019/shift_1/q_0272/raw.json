    "text": "<math><mfrac><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi><mo>-</mo><mn>1</mn></mrow><mrow><mo>-</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mi>λ</mi></math>  <br/><math><mi>x</mi><mo>=</mo><mn>3</mn><mi>λ</mi><mo>+</mo><mn>2</mn><mo>,</mo><mtext> </mtext><mi>y</mi><mo>=</mo><mn>2</mn><mi>λ</mi><mo>-</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>z</mi><mo>=</mo><mo>-</mo><mi>λ</mi><mo>+</mo><mn>1</mn></math>  <br/>Intersection with plane <math><mn>2</mn><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo>-</mo><mi>z</mi><mo>+</mo><mn>13</mn><mo>=</mo><mn>0</mn></math>  <br/>Hence, <math><mn>2</mn><mfenced separators=\"|\"><mrow><mn>3</mn><mi>λ</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mn>3</mn><mfenced separators=\"|\"><mrow><mn>2</mn><mi>λ</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mi>λ</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mn>13</mn><mo>=</mo><mn>0</mn></math>  <br/><math><mn>13</mn><mi>λ</mi><mo>+</mo><mn>13</mn><mo>=</mo><mn>0</mn></math>  <br/><math><mi>λ</mi><mo>=</mo><mo>-</mo><mn>1</mn></math>  <br/><math><mo>∴</mo><mtext> </mtext><mi>P</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mo>-</mo><mn>3,2</mn></mrow></mfenced></math>  <br/>Intersection with plane <math><mn>3</mn><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mn>4</mn><mi>z</mi><mo>=</mo><mn>16</mn></math>  <br/>Hence, <math><mn>3</mn><mfenced separators=\"|\"><mrow><mn>3</mn><mi>λ</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>λ</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mn>4</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mi>λ</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mn>16</mn></math>  <br/><math><mi>λ</mi><mo>=</mo><mn>1</mn></math>  <br/><math><mi>Q</mi><mfenced separators=\"|\"><mrow><mn>5,1</mn><mo>,</mo><mn>0</mn></mrow></mfenced></math>  <br/><math><mi>P</mi><mi>Q</mi><mo>=</mo><msqrt><msup><mrow><mn>6</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mn>4</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mo>=</mo><msqrt><mn>56</mn></msqrt><mo>=</mo><mn>2</mn><msqrt><mn>14</mn></msqrt></math>",
