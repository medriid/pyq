      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mo>-</mo><mi>&#160;</mi><mn>1</mn><mo>,</mo><mi>&#160;</mi><mo>-</mo><mn>1</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mi>&#160;</mi><mo>-</mo><mn>1,</mn><mo>&#160;</mo><mn>1</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi> </mi><mn>1</mn><mo>,</mo><mi> </mi><mn>1</mn></mrow></mfenced></math>",
