  "question": {
    "text": "The length of the perpendicular from the point <math><mo>(</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>1</mn><mo>,</mo><mi>&#160;</mi><mn>4</mn><mo>)</mo></math> on the straight line <math><mfrac><mrow><mi>x</mi><mo>+</mo><mn>3</mn><mi>&#160;</mi></mrow><mrow><mn>10</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>-</mo><mn>2</mn></mrow><mrow><mo>-</mo><mn>7</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></mfrac></math> is"
  },
  "options": [
    {
      "text": "greater than <math><mn>3</mn></math> but less than <math><mn>4</mn></math>",
      "is_correct": true
    },
