      "isCorrect": false
    },
    {
      "id": "Ef56a",
      "text": "<math><mfrac><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></mfrac><mo>=</mo><mi> </mi><mn>1</mn></math>",
