    },
    {
      "id": "MI01J",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>y</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>z</mi></mrow></mfrac><mo>=</mo><mi> </mi><mfrac><mrow><mn>11</mn></mrow><mrow><mn>6</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LhKvC",
      "text": "<math><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mn>6</mn></math>",
