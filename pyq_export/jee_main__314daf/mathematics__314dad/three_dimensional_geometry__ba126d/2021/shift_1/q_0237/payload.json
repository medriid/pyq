  "solution": {
    "text": "<p style=\"margin:0cm 0cm 8pt\"><img src=\"assets\\st0237_0ca78894241e.png\" style=\"width: 389px; height: 200px;\" /></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi></math> lies on plane <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>-</mo><mi>m</mi><mi>a</mi><mo>-</mo><mi>n</mi><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mfrac><mi>m</mi><mi>n</mi></mfrac><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mi>a</mi></mfrac></math>&nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8230;</mo><mo>.</mo><mo>(</mo><mn>1</mn><mo>)</mo></math></p><p style=\"margin:0cm 0cm 8pt\">Also,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>CA</mi><mo>&#8594;</mo></mover></math>&nbsp;will be parallel to the normal to the plane</p><p style=\"margin:0cm 0cm 8pt\">So,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>CA</mi><mo>&#8594;</mo></mover><mo>&#160;</mo><mo>&#8214;</mo><mo>&#160;</mo><mi>l</mi><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>+</mo><mi>m</mi><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>+</mo><mi>n</mi><mover><mi>k</mi><mo mathvariant=\"italic\">^</mo></mover></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>a</mi><mo>-</mo><mn>0</mn></mrow><mi>l</mi></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mi>a</mi></mrow><mi>m</mi></mfrac><mo>=</mo><mfrac><mn>4</mn><mi>n</mi></mfrac><mo>&#8658;</mo><mfrac><mi>m</mi><mi>n</mi></mfrac><mo>=</mo><mo>-</mo><mfrac><mi>a</mi><mn>4</mn></mfrac></math>&nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mn>2</mn><mo>)</mo></math></p><p style=\"margin:0cm 0cm 8pt\">From <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>)</mo></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mo>)</mo></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mi>a</mi></mrow><mn>4</mn></mfrac><mo>&#8658;</mo><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mn>2</mn></math>&nbsp; &nbsp; (since <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>&#62;</mo><mn>0</mn></math>)</p><p style=\"margin:0cm 0cm 8pt\">From <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mo>)</mo></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>m</mi><mi>n</mi></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>1</mn></mrow><mn>2</mn></mfrac></math></p><p style=\"margin:0cm 0cm 8pt\">Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mo>-</mo><mi>t</mi><mo>&#8658;</mo><mi>n</mi><mo>=</mo><mn>2</mn><mi>t</mi></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mi>l</mi></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mrow><mo>-</mo><mi mathvariant=\"normal\">t</mi></mrow></mfrac><mo>&#8658;</mo><mi>l</mi><mo>=</mo><mi mathvariant=\"normal\">t</mi></math></p><p style=\"margin:0cm 0cm 8pt\">So plane :&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mfenced><mrow><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mn>2</mn><mi>z</mi></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mi>D</mi><mo>=</mo><mfrac><mn>6</mn><msqrt><mn>6</mn></msqrt></mfrac><mo>=</mo><msqrt><mn>6</mn></msqrt><mo>&#160;&#160;</mo></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mo>&#8801;</mo><mfenced><mrow><mn>0</mn><mo>,</mo><mo>-</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>1</mn></mrow></mfenced></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mi>D</mi><mo>=</mo><msqrt><mi>B</mi><msup><mi>C</mi><mn>2</mn></msup><mo>-</mo><mi>B</mi><msup><mi>D</mi><mn>2</mn></msup></msqrt></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mfenced><mrow><msup><mn>0</mn><mn>2</mn></msup><mo>+</mo><msup><mn>6</mn><mn>2</mn></msup><mo>+</mo><msup><mn>6</mn><mn>2</mn></msup></mrow></mfenced><mo>-</mo><msup><mfenced><msqrt><mn>6</mn></msqrt></mfenced><mn>2</mn></msup></msqrt></math></p><p style=\"margin:0cm 0cm 8pt\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mn>66</mn></msqrt></math></p>"
  }
