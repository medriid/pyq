      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
      "is_correct": false
