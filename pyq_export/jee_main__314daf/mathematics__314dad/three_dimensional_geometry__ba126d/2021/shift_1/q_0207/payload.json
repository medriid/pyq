  "question": {
    "text": "The distance of the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>1</mn><mo>,</mo><mo>-</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow></mfenced></math> from the plane <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mn>5</mn></math>&nbsp;measured parallel to a line, whose direction ratios are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>,</mo><mo>&#160;</mo><mn>3</mn><mo>,</mo><mo>&#160;</mo><mo>-</mo><mn>6</mn></math>,&nbsp;is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "is_correct": false
    },
