  "question": {
    "text": "The equation of the plane passing through the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>1</mn><mo>,</mo><mo>&#160;</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>3</mn></mrow></mfenced></math>&nbsp;and perpendicular to the planes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi><mo>+</mo><mi>y</mi><mo>-</mo><mn>2</mn><mi>z</mi><mo>=</mo><mn>5</mn></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>x</mi><mo>-</mo><mn>5</mn><mi>y</mi><mo>-</mo><mi>z</mi><mo>=</mo><mn>7</mn></math>, is",
    "image": null
  },
  "options": [
    {
