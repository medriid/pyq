    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>-</mo><mn>5</mn><mi>y</mi><mo>-</mo><mn>2</mn><mi>z</mi><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math>",
