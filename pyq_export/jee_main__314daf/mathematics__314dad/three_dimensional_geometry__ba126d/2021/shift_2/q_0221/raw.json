    },
    {
      "id": "mND1X",
      "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi>b</mi><mo>&#8712;</mo><mi>R</mi><mo>-</mo><mo>{</mo><mn>0</mn><mo>}</mo></math></p>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "dtNQ2",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi>b</mi><mo>=</mo><mn>2</mn></math>",
      "isCorrect": false,
