    {
      "id": "tAq5x",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi>a</mi><mo>&#8712;</mo><mi>R</mi><mo>-</mo><mo>{</mo><mn>0</mn><mo>}</mo></math>",
      "isCorrect": true,
