  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/e3213ed2-d1e2-4b73-ab57-86789a7f098b-image.png\" style=\"width: 355px; height: 200px;\" /></p><p>DC of line&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8801;</mo><mfenced><mrow><mfrac><mn>3</mn><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>,</mo><mfrac><mrow><mo>-</mo><mi>m</mi></mrow><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>,</mo><mfrac><mn>1</mn><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mo>&#8801;</mo><mfenced><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mn>3</mn><mi>r</mi></mrow><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>,</mo><mo>-</mo><mn>2</mn><mo>+</mo><mfrac><mrow><mo>-</mo><mi>m</mi><mi>r</mi></mrow><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>,</mo><mn>3</mn><mo>+</mo><mfrac><mi>r</mi><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi></math>&nbsp;lies on&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>-</mo><mn>3</mn><mi>z</mi><mo>+</mo><mn>10</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mfrac><mrow><mn>3</mn><mi>r</mi></mrow><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>-</mo><mn>4</mn><mo>-</mo><mfrac><mrow><mn>2</mn><mi>m</mi><mi>r</mi></mrow><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>-</mo><mn>9</mn><mo>-</mo><mfrac><mrow><mn>3</mn><mi>r</mi></mrow><msqrt><msup><mi>m</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn></msqrt></mfrac><mo>+</mo><mn>10</mn><mo>=</mo><mn>0</mn></math></p><p><math xml