    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>-</mo><mn>8</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>6</mn></mrow></mfenced></math>",
      "is_correct": false
