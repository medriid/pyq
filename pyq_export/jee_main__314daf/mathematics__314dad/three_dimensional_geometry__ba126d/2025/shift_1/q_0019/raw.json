  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/CDcU0duSunsrkhCgO0swlIxk-h0CM8zK51nxljBR7Jg.original.fullsize.png\"/><br/>$\\begin{aligned}<br/>& \\text { Dr's of } \\mathrm{AC} \\Rightarrow 2 \\lambda, 3 \\lambda-2,4 \\lambda \\\\\n& \\text { Dr's of } \\mathrm{BC} \\Rightarrow \\mu+2,2 \\mu+3, \\mu-1 \\\\\n& \\Rightarrow \\frac{\\mu+2}{2 \\lambda}=\\frac{2 \\mu+3}{3 \\lambda-2}=\\frac{\\mu-1}{4 \\lambda} \\\\\n& \\Rightarrow 2(\\mu+2)=\\mu-1 \\Rightarrow \\mu=-5 \\\\\n& \\Rightarrow \\text { Dr's of } \\mathrm{BC} \\Rightarrow 3,7,6 \\\\\n& \\Rightarrow \\text { equation of } \\mathrm{L} \\Rightarrow \\frac{\\mathrm{x}-1}{3}=\\frac{\\mathrm{y}-1}{7}=\\frac{\\mathrm{z}-1}{6}<br/>\\end{aligned}$<br/>$(7,15,13) \\text { satisfies. }$",
    "image": null
