  "question": {
    "text": "Each of the angles $\\beta$ and $\\gamma$ that a given line makes with the positive y - and z -axes, respectively, is half of the angle that this line makes with the positive x -axes. Then the sum of all possible values of the angle $\\beta$ is",
    "image": null
  },
  "options": [
    {
      "id": "JZo8q",
      "text": "$\\frac{3 \\pi}{4}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "L7F1a",
      "text": "$\\pi$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oxx0L",
      "text": "$\\frac{\\pi}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TyTfb",
      "text": "$\\frac{3 \\pi}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\beta=\\frac{\\alpha}{2}, \\gamma=\\frac{\\alpha}{2} \\\\\n& \\cos ^2 \\alpha+\\cos ^2 \\beta+\\cos ^2 \\gamma=1 \\\\\n& \\cos ^2 \\alpha+2 \\cos ^2 \\frac{\\alpha}{2}=1 \\\\\n& \\cos ^2 \\alpha+\\cos \\alpha=0 \\\\\n& \\cos \\alpha(\\cos \\alpha+1)=0 \\\\\n& \\cos \\alpha=0,-1 \\\\\n& \\alpha=\\frac{\\pi}{2}, \\pi<br/>\\end{aligned}$<br/>Now $\\beta=\\frac{\\alpha}{2} \\Rightarrow \\frac{\\pi}{4}, \\frac{\\pi}{2}$<br/>so sum is $\\frac{3 \\pi}{4}$",
    "image": null
  },
