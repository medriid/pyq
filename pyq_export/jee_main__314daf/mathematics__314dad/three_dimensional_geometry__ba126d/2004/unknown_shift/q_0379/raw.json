  "question": {
    "text": "Distance between two parallel planes $2 x+y+2 z=8$ and $4 x+2 y+4 z+5=0$ is",
    "image": null
  },
  "options": [
    {
      "id": "pmg4s",
      "text": "\n$\\frac{3}{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8CFeV",
      "text": "\n$\\frac{5}{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XAjMl",
      "text": "\n$\\frac{7}{2}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BTU8b",
      "text": "\n$\\frac{9}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Given planes are\n$$\n2 x+y+2 z-8=0,4 x+2 y+4 z+5=0 \\Rightarrow 2 x+y+2 z+5 / 2=0\n$$\nDistance between planes $=\\frac{\\left|d_1-d_2\\right|}{\\sqrt{a^2+b^2+c^2}}=\\frac{|-8-5 / 2|}{\\sqrt{2^2+1^2+2^2}}=\\frac{7}{2}$",
    "image": null
  },
