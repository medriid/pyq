  "question": {
    "text": "The intersection of the spheres $x^2+y^2+z^2+7 x-2 y-z=13$ and $x^2+y^2+z^2-3 x+3 y+4 z=8$ is the same as the intersection of one of the sphere and the plane",
    "image": null
  },
  "options": [
    {
      "id": "cxtat",
      "text": "\n$x-y-z=1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Y1nbm",
      "text": "\n$x-2 y-z=1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GA0SH",
      "text": "\n$x-y-2 z=1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gFDKD",
      "text": "\n$2 x-y-z=1$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Required plane is $S_1-S_2=0$ where $S_1=x^2+y^2+z^2+7 x-2 y-z-13=0$ and\n$$\n\\begin{aligned}\n& S_2=x^2+y^2+z^2-3 x+3 y+4 z-8=0 \\\\\n& \\Rightarrow 2 x-y-z=1\n\\end{aligned}\n$$",
    "image": null
  },
