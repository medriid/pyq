  "question": {
    "text": "Let the line $\\frac{x-2}{3}=\\frac{y-1}{-5}=\\frac{z+2}{2}$ lies in the plane $x+3 y-\\alpha z+\\beta=0$. Then $(\\alpha, \\beta)$ equals",
    "image": null
  },
  "options": [
    {
      "id": "8BUpH",
      "text": "\n$(6,-17)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8cBbb",
      "text": "\n$(-6,7)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "o8BqN",
      "text": "\n$(5,-15)$\n",
      "image": null,
      "isCorrect": false
    },
    {
