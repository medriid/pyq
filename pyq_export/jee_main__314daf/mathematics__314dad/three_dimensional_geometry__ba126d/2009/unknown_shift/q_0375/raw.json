  "question": {
    "text": "The projections of a vector on the three coordinate axis are $6,-3,2$ respectively. The direction cosines of the vector are",
    "image": null
  },
  "options": [
    {
      "id": "gCOJ5",
      "text": "\n$6,-3,2$\n",
      "image": null,
      "isCorrect": false
    },
    {
