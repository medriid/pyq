      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#946;</mi><mi>&#947;</mi></mfrac><mo>=</mo><mo>-</mo><mn>5</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#947;</mi><mi>&#945;</mi></mfrac><mo>=</mo><mfrac><mn>5</mn><mn>8</mn></mfrac></math>",
