      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><msqrt><mn>2</mn><mi>b</mi></msqrt><mo>+</mo><mi>c</mi><mo>=</mo><mn>1</mn></math>",
      "is_correct": true
