    "D"
  ],
  "solution": {
    "text": "<blockquote><p>Given:</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>x</mi><mo>-</mo><mn>4</mn></mrow><mn>4</mn></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>+</mo><mn>2</mn></mrow><mn>5</mn></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi><mo>+</mo><mn>3</mn></mrow><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow><mn>3</mn></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>-</mo><mn>3</mn></mrow><mn>4</mn></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi><mo>-</mo><mn>4</mn></mrow><mn>2</mn></mfrac></math></p><p>So,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>=</mo><mn>4</mn><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mn>2</mn><mover><mi>j</mi><mo>^</mo></mover><mo>-</mo><mn>3</mn><mover><mi>k</mi><mo>^</mo></mover><mspace linebreak=\"newline\"></mspace><msub><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>=</mo><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>4</mn><mover><mi>k</mi><mo>^</mo></mover></math></p><p>So,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>-</mo><msub><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>=</mo><mo>-</mo><mn>3</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>5</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>7</mn><mover><mi>k</mi><mo>^</mo></mover></math></p><p>And,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>&#215;</mo><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>=</mo><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mover><mi>i</mi><mo>^</mo></mover></mtd><mtd><mover><mi>j</mi><mo>^</mo></mover></mtd><mtd><mover><mi>k</mi><mo>^</mo></mover></mtd></mtr><mtr><mtd><mn>4</mn></mtd><mtd><mn>5</mn></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>4</mn></mtd><mtd><mn>2</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mo>-</mo><mn>2</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mover><mi>k</mi><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\"><mrow><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>&#215;</mo><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></mrow></mfenced><mo>=</mo><msqrt><msup><mfenced><mrow><mo>-</mo><mn>2</mn></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mn>1</mn></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mn>1</mn></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><msqrt><mn>6</mn></msqrt></math></p><p>Shortest distance between the lines&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"|\" open=\"|\"><mfrac><mrow><mfenced><mrow><msub><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>-</mo><msub><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>1</mn></msub></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>&#215;</mo><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></mrow></mfenced></mrow><mfenced close=\"|\" open=\"|\"><mrow><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>&#215;</mo><msub><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>2</mn></msub></mrow></mfenced></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"|\" open=\"|\"><mfrac><mrow><mfenced><mrow><mo>-</mo><mn>3</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>5</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>7</mn><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced><mrow><mo>-</mo><mn>2</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced></mrow><msqrt><mn>6</mn></msqrt></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"|\" open=\"|\"><mfrac><mrow><mn>6</mn><mo>+</mo><mn>5</mn><mo>+</mo><mn>7</mn></mrow><msqrt><mn>6</mn></msqrt></mfrac></mfenced><mo>=</mo><mfrac><mrow><mn>6</mn><mo>&#215;</mo><mn>3</mn></mrow><msqrt><mn>6</mn></msqrt></mfrac><mo>&#160;</mo><mi>units</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>3</mn><msqrt><mn>6</mn></msqrt><mo>&#160;</mo><mi>units</mi></math></p><p>Hence this is the correct option.</p></blockquote>"
  }
