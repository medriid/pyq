  "question": {
    "text": "If the angle between the line $x=\\frac{y-1}{2}=\\frac{z-3}{\\lambda}$ and the plane $x+2 y+3 z=4$ is $\\cos ^{-1}\\left(\\sqrt{\\frac{5}{14}}\\right)$, then $\\lambda$ equals",
    "image": null
  },
  "options": [
    {
      "id": "hjtIv",
      "text": "\n$\\frac{3}{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
