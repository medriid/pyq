    "chapter_name": "Trigonometric Ratios & Identities",
    "year": "2016",
    "shift": "unknown_shift"
  },
  "question": {
    "text": "If <math><mi>A</mi><mo>&#62;</mo><mn>0</mn><mo>,</mo><mi>&#160;</mi><mi>B</mi><mo>&#62;</mo><mn>0</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>+</mo><mi>B</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></math>,&nbsp;then the minimum positive value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>B</mi></mrow></mfenced></math>&nbsp;is :"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mo>-</mo><msqrt><mn>2</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>2</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>-</mo><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>B</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mi>tan</mi><mo>&#8289;</mo><mi>B</mi></mrow></mfrac></math><br /><br /><math><mo>&#8658;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msqrt><mn>3</mn></msqrt></mfrac><mo>=</mo><mfrac><mi>y</mi><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mi>&#160;</mi><mi>tan</mi><mo>&#8289;</mo><mi>B</mi></mrow></mfrac></math> where <math><mi>y</mi><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>A</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>B</mi></mrow></mrow></math><br /><br /><math><mo>&#8658;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mo>.</mo><mi>tan</mi><mo>&#8289;</mo><mi>B</mi><mo>=</mo><mn>1</mn><mo>-</mo><msqrt><mn>3</mn></msqrt><mi>y</mi></math><br /><br />&nbsp;and, also <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AM</mi><mo>&#8805;</mo><mi>GM</mi></math><br /><br /><math><mo>&#8658;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>B</mi></mrow><mn>2</mn></mfrac><mi>&#160;</mi><mo>&#8805;</mo><mi>&#160;</mi><msqrt><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mi>tan</mi><mo>&#8289;</mo><mi>B</mi></msqrt></math><br /><br /><math><mo>&#8658;</mo></math> <math><mi>y</mi><mi>&#160;</mi><mo>&#8805;</mo><mn>2</mn><msqrt><mn>1</mn><mo>-</mo><mi>&#160;</mi><msqrt><mn>3</mn></msqrt><mi>y</mi></msqrt></math><br /><br /><math><mo>&#8658;</mo></math> <math><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&#160;</mi><mo>&#8805;</mo><mn>4</mn><mo>-</mo><mn>4</mn><msqrt><mn>3</mn></msqrt><mi>y</mi><mo>&#8805;</mo><mn>0</mn></math><br /><br /><math><mo>&#8658;</mo></math> <math><mi>y</mi><mi>&#160;</mi><mo>&#8804;</mo><mi>&#160;</mi><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>4</mn></math> or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mi>&#160;</mi><mo>&#8805;</mo><mi>&#160;</mi><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>4</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mi>&#160;</mi><mo>&#8804;</mo><mi>&#160;</mi><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>4</mn></math>, is not possible&nbsp;as&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>&#8289;</mo><mi>A</mi><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>B</mi><mo>&#62;</mo><mn>0</mn></math></p><p>Therefore,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mi>&#160;</mi><mo>&#8805;</mo><mi>&#160;</mi><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>4</mn></math></p><p>Hence, minimum positive value is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt></math>.</p>"
  }
}