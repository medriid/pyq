  "question": {
    "text": "In a <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#916;</mi><mi>A</mi><mi>B</mi><mi>C</mi></math>,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>=</mo><mn>2</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></math>, and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#8736;</mi><mi>C</mi><mo>=</mo><mn>60</mn><mo>&#176;</mo><mo>.</mo></math>&nbsp;Then the ordered pair <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>&#8736;</mi><mi>A</mi><mo>,</mo><mi>&#8736;</mi><mi>B</mi><mo>)</mo></math> is equal to:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>105</mn><mo>&#176;</mo><mo>,</mo><mi>&#160;</mi><mn>15</mn><mo>&#176;</mo></mrow></mfenced></math>",
      "is_correct": true
