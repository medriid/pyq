    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>15</mn><mo>&#176;</mo><mo>,</mo><mi>&#160;</mi><mn>105</mn><mo>&#176;</mo></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>45</mn><mo>&#176;</mo><mo>,</mo><mi>&#160;</mi><mn>75</mn><mo>&#176;</mo></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>75</mn><mo>&#176;</mo><mo>,</mo><mi>&#160;</mi><mn>45</mn><mo>&#176;</mo><mo>)</mo></math>",
