  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>&#62;</mo><mn>1</mn><mo>&#8658;</mo><mo>&#8736;</mo><mi>A</mi><mo>&#62;</mo><mo>&#8736;</mo><mi>B</mi></mtd></mtr></mtable></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>+</mo><mi>B</mi><mo>=</mo><mn>120</mn><mi>&#176;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>s</mi><mi>i</mi><mi>n</mi><mo>(</mo><mn>120</mn><mi>&#176;</mi><mo>&#8722;</mo><mi>B</mi><mo>)</mo></mrow><mrow><mi>s</mi><mi>i</mi><mi>n</mi><mi>B</mi></mrow></mfrac><mo>=</mo><mn>2</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mtext>&#8658;&#8201;&#8201;</mtext><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mi>c</mi><mi>o</mi><mi>t</mi><mi>B</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>=</mo><mn>2</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></mtd></mtr></mtable></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mo>&#8658;</mo><mo>&#8201;</mo><mi>c</mi><mi>o</mi><mi>t</mi><mi>B</mi><mo>=</mo><mfrac><mn>2</mn><msqrt><mn>3</mn></msqrt></mfrac><mfenced><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>+</mo><msqrt><mn>3</mn></msqrt></mrow></mfenced></mtd></mtr></mtable></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8201;</mo><mo>&#8658;</mo><mi>c</mi><mi>o</mi><mi>t</mi><mi>B</mi><mo>=</mo><mn>2</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mo>&#8658;</mo><mtext>&#8201;&#8201;&#8201;</mtext><mi>B</mi><mo>=</mo><mn>15</mn><mi>&#176;</mi></mtd></mtr></mtable></math></p><p>Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mo>&#8736;</mo><mi>A</mi><mo>,</mo><mo>&#8736;</mo><mi>B</mi><mo>)</mo><mo>=</mo><mo>(</mo><mn>105</mn><mi>&#176;</mi><mo>,</mo><mn>15</mn><mi>&#176;</mi><mo>)</mo></math></p>"
  }
