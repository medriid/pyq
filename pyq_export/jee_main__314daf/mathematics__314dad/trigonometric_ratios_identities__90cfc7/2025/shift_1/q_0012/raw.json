  "question": {
    "text": "The value of $\\left(\\sin 70^{\\circ}\\right)\\left(\\cot 10^{\\circ} \\cot 70^{\\circ}-1\\right)$ is",
    "image": null
  },
  "options": [
    {
      "id": "VIeJt",
      "text": "$2 / 3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SWBq9",
      "text": "$1$",
      "image": null,
      "isCorrect": true
