  "question": {
    "text": "The value of $\\left(\\sin 70^{\\circ}\\right)\\left(\\cot 10^{\\circ} \\cot 70^{\\circ}-1\\right)$ is"
  },
  "options": [
    {
      "text": "$2 / 3$",
      "is_correct": false
    },
    {
      "text": "$1$",
      "is_correct": true
    },
    {
      "text": "$0$",
      "is_correct": false
    },
    {
      "text": "$3 / 2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\left(\\sin 70^{\\circ}\\right)\\left(\\cot 10^{\\circ} \\cot 70^{\\circ}-1\\right) \\\\ & =\\sin 70^{\\circ} \\cot 10^{\\circ} \\cot 70^{\\circ}-\\sin 70^{\\circ} \\\\ & =\\cot 10^{\\circ} \\cos 70^{\\circ}-\\sin 70^{\\circ} \\\\ & =\\frac{\\cos 10^{\\circ} \\cos 70^{\\circ}-\\sin 70^{\\circ} \\sin 10^{\\circ}}{\\sin 10^{\\circ}} \\\\ & =\\frac{\\cos \\left(10^{\\circ}+70^{\\circ}\\right)}{\\sin 10^{\\circ}} \\\\ & =\\frac{\\cos 80^{\\circ}}{\\sin 10^{\\circ}}=1\\end{aligned}$"
  }
