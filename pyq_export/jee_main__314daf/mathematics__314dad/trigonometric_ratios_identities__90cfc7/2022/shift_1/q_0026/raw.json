    "text": "<p>Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><mn>7</mn></mfrac><mo>+</mo><mi>cos</mi><mfrac><mrow><mn>4</mn><mi>&#960;</mi></mrow><mn>7</mn></mfrac><mo>+</mo><mi>cos</mi><mfrac><mrow><mn>6</mn><mi>&#960;</mi></mrow><mn>7</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>sin</mi><mfenced><mstyle displaystyle=\"true\"><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>7</mn></mfrac></mstyle></mfenced></mrow></mfrac><mfenced close=\"}\" open=\"{\"><mrow><mn>2</mn><mi>cos</mi><mfenced><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><mn>7</mn></mfrac></mfenced><mi>sin</mi><mfenced><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>7</mn></mfrac></mfenced><mo>+</mo><mn>2</mn><mi>cos</mi><mfenced><mfrac><mrow><mn>4</mn><mi>&#960;</mi></mrow><mn>7</mn></mfrac></mfenced><mi>sin</mi><mfenced><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>7</mn></mfrac></mfenced><mo>+</mo><mn>2</mn><mi>cos</mi><mfenced><mfrac><mrow><mn>6</mn><mi>&#960;</mi></mrow><mn>7</mn></mfrac></mfenced><mi>sin</mi><mfenced><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>7</mn></mfrac></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>sin</mi><mstyle displaystyle=\"true\"><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>7</mn></mfrac></mstyle></mrow></mfrac><mfenced close=\"}\" open=\"{\"><mrow><mi>sin</mi><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>7</mn></mfrac><mo>-</mo><mi>sin</mi><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>7</mn></mfrac><mo>+</mo><mi>sin</mi><mfrac><mrow><mn>5</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>7</mn></mfrac><mo>-</mo><mi>sin</mi><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>7</mn></mfrac><mo>+</mo><mi>sin</mi><mfrac><mrow><mn>7</mn><mi mathvariant=\"normal\">&#960