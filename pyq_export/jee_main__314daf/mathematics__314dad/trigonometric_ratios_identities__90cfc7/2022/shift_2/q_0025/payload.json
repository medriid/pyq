  "question": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><mi>sin</mi><mn>36</mn><mo>&#176;</mo></math>&nbsp;is a root of which of the following equation"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><msup><mi>x</mi><mn>4</mn></msup><mo>-</mo><mn>20</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><msup><mi>x</mi><mn>4</mn></msup><mo>+</mo><mn>20</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><msup><mi>x</mi><mn>4</mn></msup><mo>-</mo><mn>10</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>5</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><msup><mi>x</mi><mn>4</mn></msup><mo>-</mo><mn>10</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mo>=</mo><mn>0</mn></math>",
