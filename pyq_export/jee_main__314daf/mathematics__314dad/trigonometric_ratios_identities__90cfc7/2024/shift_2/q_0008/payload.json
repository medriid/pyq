    "text": "<blockquote><p>Given:</p><p> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow></mfenced><mo>=</mo><mn>2</mn><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>-</mo><mi>β</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow></mfenced></mrow><mrow><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>-</mo><mi>β</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow></mfenced><mo>+</mo><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>-</mo><mi>β</mi></mrow></mfenced></mrow><mrow><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>+</mo><mi>β</mi></mrow></mfenced><mo>-</mo><mi>sin</mi><mfenced><mrow><mi>α</mi><mo>-</mo><mi>β</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mo>+</mo><mn>3</mn></mrow><mrow><mn>2</mn><mo>-</mo><mn>3</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mn>2</mn><mi>sin</mi><mi>α</mi><mi>cos</mi><mi>β</mi></mrow><mrow><mn>2</mn><mi>cos</mi><mi>α</mi><mi>sin</mi><mi>β</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mn>5</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>tan</mi><mi>α</mi></mrow><mrow><mi>tan</mi><mi>β</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mn>5</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>tan</mi><mi>α</mi><mo>=</mo><mo>-</mo><mn>5</mn><mi>tan</mi><mi>β</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>k</mi><mo>=</mo><mo>-</mo><mn>5</mn></math></p></blockquote>"
