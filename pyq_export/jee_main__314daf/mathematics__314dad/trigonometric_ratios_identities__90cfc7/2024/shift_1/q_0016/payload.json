  "solution": {
    "text": "Given, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>A</mi><mo>=</mo><mfrac><mn>1</mn><msqrt><mi>x</mi><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></msqrt></mfrac><mo>,</mo><mi>tan</mi><mi>B</mi><mo>=</mo><mfrac><msqrt><mi>x</mi></msqrt><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></msqrt></mfrac></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>C</mi><mo>=</mo><msup><mfenced><mrow><msup><mi>x</mi><mrow><mo>−</mo><mn>3</mn></mrow></msup><mo>+</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>+</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>=</mo><mfrac><msqrt><mn>1</mn><mo>+</mo><mi>x</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt><mrow><mi>x</mi><msqrt><mi>x</mi></msqrt></mrow></mfrac></math><p>We know that,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mfenced><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi>tan</mi><mi>A</mi><mo>+</mo><mi>tan</mi><mi>B</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>tan</mi><mi>A</mi><mi>tan</mi><mi>B</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>tan</mi><mfenced><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mfrac><mn>1</mn><msqrt><mi>x</mi><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></msqrt></mfrac><mo>+</mo><mfrac><msqrt><mi>x</mi></msqrt><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></msqrt></mfrac></mrow><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>tan</mi><mfenced><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mfenced><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced><mfenced><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></msqrt></mfenced></mrow><mrow><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi></mrow></mfenced><mfenced><msqrt><mi>x</mi></msqrt></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>tan</mi><mfenced><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mfenced><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced><mfenced><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></msqrt></mfenced></mrow><mrow><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi></mrow></mfenced><mfenced><msqrt><mi>x</mi></msqrt></mfenced></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>tan</mi><mfenced><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></msqrt><mrow><mi>x</mi><msqrt><mi>x</mi></msqrt></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>tan</mi><mfenced><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow></mfenced><mo>=</mo><mi>tan</mi><mi>C</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>A</mi><mo>+</mo><mi>B</mi><mo>=</mo><mi>C</mi></math></p>"
