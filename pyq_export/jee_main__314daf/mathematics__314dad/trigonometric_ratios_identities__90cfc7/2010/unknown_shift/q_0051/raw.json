  "question": {
    "text": "Let $\\cos (\\alpha+\\beta)=\\frac{4}{5}$ and let $\\sin (\\alpha-\\beta)=\\frac{5}{13}$, where $0 \\leq \\alpha, \\beta \\leq \\frac{\\pi}{4}$, then $\\tan 2 \\alpha=$",
    "image": null
  },
  "options": [
    {
      "id": "OyUd6",
      "text": "\n$\\frac{56}{33}$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "dT8By",
      "text": "\n$\\frac{19}{12}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "55HQ5",
