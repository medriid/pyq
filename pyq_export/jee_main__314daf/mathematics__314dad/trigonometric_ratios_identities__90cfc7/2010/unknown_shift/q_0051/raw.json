      "text": "\n$\\frac{25}{16}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{ll}\\cos (\\alpha+\\beta)=\\frac{4}{5} & \\Rightarrow \\tan (\\alpha+\\beta)=\\frac{3}{4} \\\\ \\sin (\\alpha-\\beta)=\\frac{5}{13} & \\Rightarrow \\tan (\\alpha-\\beta)=\\frac{5}{12} \\\\ \\tan 2 \\alpha=\\tan (\\alpha+\\beta+\\alpha-\\beta)=\\frac{\\frac{3}{4}+\\frac{5}{12}}{1-\\frac{3}{4} \\frac{5}{12}}=\\frac{56}{33}\\end{array}$",
    "image": null
  },
