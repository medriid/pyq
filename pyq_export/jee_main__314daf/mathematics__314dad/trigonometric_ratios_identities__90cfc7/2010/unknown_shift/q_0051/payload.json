  "question": {
    "text": "Let $\\cos (\\alpha+\\beta)=\\frac{4}{5}$ and let $\\sin (\\alpha-\\beta)=\\frac{5}{13}$, where $0 \\leq \\alpha, \\beta \\leq \\frac{\\pi}{4}$, then $\\tan 2 \\alpha=$"
  },
  "options": [
    {
      "text": "\n$\\frac{56}{33}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{19}{12}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{20}{7}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{25}{16}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{array}{ll}\\cos (\\alpha+\\beta)=\\frac{4}{5} & \\Rightarrow \\tan (\\alpha+\\beta)=\\frac{3}{4} \\\\ \\sin (\\alpha-\\beta)=\\frac{5}{13} & \\Rightarrow \\tan (\\alpha-\\beta)=\\frac{5}{12} \\\\ \\tan 2 \\alpha=\\tan (\\alpha+\\beta+\\alpha-\\beta)=\\frac{\\frac{3}{4}+\\frac{5}{12}}{1-\\frac{3}{4} \\frac{5}{12}}=\\frac{56}{33}\\end{array}$"
  }
}