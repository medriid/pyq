  "question": {
    "text": "Let $f: \\mathbf{R}-\\{0\\} \\rightarrow(-\\infty, 1)$ be a polynomial of degree 2, satisfying $f(x) f\\left(\\frac{1}{x}\\right)=f(x)+f\\left(\\frac{1}{x}\\right)$. If $f(K)=-2 K$, then the sum of squares of all possible values of $K$ is :",
    "image": null
  },
  "options": [
    {
      "id": "2Wy23",
      "text": "$7$",
      "image": null,
      "isCorrect": false
    },
    {
