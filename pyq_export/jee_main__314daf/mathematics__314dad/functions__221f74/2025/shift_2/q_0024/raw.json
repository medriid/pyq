  "question": {
    "text": "Let $\\mathrm{A}=\\{1,2,3,4\\}$ and $\\mathrm{B}=\\{1,4,9,16\\}$. Then the number of many-one functions $f: \\mathrm{A} \\rightarrow \\mathrm{B}$ such that $1 \\in f(\\mathrm{~A})$ is equal to :",
    "image": null
  },
  "options": [
