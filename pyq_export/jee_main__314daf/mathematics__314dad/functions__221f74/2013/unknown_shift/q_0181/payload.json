  "question": {
    "text": "Let $A=\\{1,2,3,4\\}$ and $R: A \\rightarrow A$ be the relation defined by $R=\\{(1,1),(2,3),(3,4),(4,2)\\}$. The correct statement is :"
  },
  "options": [
    {
      "text": "\n$R$ does not have an inverse.\n",
      "is_correct": false
    },
    {
      "text": "\n $R$ is not a one to one function.\n",
      "is_correct": false
    },
    {
      "text": "\n$R$ is an onto function.\n",
      "is_correct": true
    },
    {
      "text": "\n$R$ is not a function.",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Domain }=\\{1,2,3,4\\} \\\\ & \\text { Range }=\\{1,2,3,4\\} \\\\ & \\therefore \\quad \\text { Domain }=\\text { Range }\\end{aligned}$"
  }
}