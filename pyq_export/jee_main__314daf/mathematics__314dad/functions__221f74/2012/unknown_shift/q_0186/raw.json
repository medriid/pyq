  "question": {
    "text": "The range of the function $f(x)=\\frac{x}{1+|x|}, x \\in R$, is",
    "image": null
  },
  "options": [
    {
      "id": "fg2bq",
      "text": "\n$R$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SSM0F",
      "text": "\n$(-1,1)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ZNzUb",
      "text": "\n$R-\\{0\\}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "x6iov",
      "text": "\n$[-1,1]$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$f(x)=\\frac{x}{1+|x|}, x \\in R$\nIf $x>0,|x|=x \\Rightarrow f(x)=\\frac{x}{1+x}$ which is not defined for $x=-1$\nIf $x < 0,|x|=-x \\Rightarrow f(x)=\\frac{x}{1-x}$ which is not defined for $x=1$ Thus $f(x)$ defined for all values of $\\mathrm{R}$ except 1 and $-1$\nHence, range $=(-1,1)$.",
    "image": null
  },
