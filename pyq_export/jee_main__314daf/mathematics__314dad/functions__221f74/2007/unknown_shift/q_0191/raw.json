  "question": {
    "text": "The largest interval lying in $\\left(-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right)$ for which the function $\\left[f(x)=4^{-x^2}+\\cos ^{-1}\\left(\\frac{x}{2}-1\\right)+\\log (\\cos x)\\right]$ is defined, is",
    "image": null
  },
  "options": [
    {
      "id": "TyiXJ",
      "text": "\n$[0, \\pi]$\n",
      "image": null,
      "isCorrect": false
