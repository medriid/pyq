  "question": {
    "text": "The function $f(x)=\\log \\left(x+\\sqrt{x^2+1}\\right)$, is",
    "image": null
  },
  "options": [
    {
      "id": "VyZsy",
      "text": "\nneither an even nor an odd function\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "h1gpJ",
      "text": "\nan even function\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PHJbD",
      "text": "\nan odd function\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8AGo5",
      "text": "\na periodic function",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$f(x)=\\log \\left(x+\\sqrt{x^2+1}\\right)$\n$f(-x)=-\\log \\left(x+\\sqrt{x^2+1}\\right)$\n$f(-x)=-f(x)$, i.e., $f(x)$ is an odd function.",
    "image": null
  },
