  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>:</mo><mo>&#160;</mo><mi>R</mi><mo>&#8594;</mo><mi>R</mi></math>&nbsp;be defined by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfrac><mrow><mfenced close=\"|\" open=\"|\"><mi>x</mi></mfenced><mo>-</mo><mn>1</mn></mrow><mrow><mfenced close=\"|\" open=\"|\"><mi>x</mi></mfenced><mo>+</mo><mn>1</mn></mrow></mfrac><mo>,</mo></math>&nbsp;then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi></math>&nbsp;is&nbsp;",
    "image": null
  },
