  "question": {
    "text": "Let a function $f:(0, \\infty) \\rightarrow(0, \\infty)$ be defined by\r\n\r\n$f(x)=\\left|1-\\frac{1}{x}\\right| .$ Then $f$ is :",
    "image": null
  },
  "options": [
    {
