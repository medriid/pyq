    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mo>-</mo><mn>1</mn></mrow></mfenced><mo>&#8746;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mn>0</mn></mrow></mfenced><mo>&#8746;</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi>&#8734;</mi></mrow></mfenced></math>",
