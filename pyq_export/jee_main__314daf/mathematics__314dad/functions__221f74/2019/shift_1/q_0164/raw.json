  "question": {
    "text": "Let $f: R \\rightarrow R$ be defined by $f(x)=\\frac{x}{1+x^{2}}, x \\in R .$ Then the range of $f$ is",
    "image": null
  },
  "options": [
    {
      "id": "Pvm5Q",
      "text": "$\\left[-\\frac{1}{2}, \\frac{1}{2}\\right]$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Z9hU3",
      "text": "$R-[-1,1]$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "L52Ga",
      "text": "$R-\\left[-\\frac{1}{2}, \\frac{1}{2}\\right]$",
      "isCorrect": false,
      "image": null
    },
    {
