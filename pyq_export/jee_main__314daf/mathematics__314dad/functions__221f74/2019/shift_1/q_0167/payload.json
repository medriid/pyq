    },
    {
      "text": "<math><mi>f</mi><mo>(</mo><mi>g</mi><mo>(</mo><mi>S</mi><mo>)</mo><mo>)</mo><mo>≠</mo><mi>f</mi><mo>(</mo><mi>S</mi><mo>)</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>g</mi><mfenced separators=\"|\"><mrow><mi>S</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mi>S</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>S</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mi>g</mi><mfenced separators=\"|\"><mrow><mi>S</mi></mrow></mfenced></math>",
