  "question": {
    "text": "Let $f(x)=\\frac{1}{7-\\sin 5 x}$ be a function defined on $\\mathbf{R}$. Then the range of the function $f(x)$ is equal to ;",
    "image": null
  },
  "options": [
    {
      "id": "3QCAG",
      "text": "$\\left[\\frac{1}{7}, \\frac{1}{6}\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iuqO3",
      "text": "$\\left[\\frac{1}{8}, \\frac{1}{5}\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GGMzT",
      "text": "$\\left[\\frac{1}{7}, \\frac{1}{5}\\right]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "krIFU",
      "text": "$\\left[\\frac{1}{8}, \\frac{1}{6}\\right]$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\sin 5 x \\in[-1,1] \\\\ & -\\sin 5 x \\in[-1,1] \\\\ & 7-\\sin 5 x \\in[6,8] \\\\ & \\frac{1}{7-\\sin 5 x} \\in\\left[\\frac{1}{8}, \\frac{1}{6}\\right]\\end{aligned}$",
    "image": null
  },
