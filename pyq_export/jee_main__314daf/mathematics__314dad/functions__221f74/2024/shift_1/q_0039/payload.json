  "question": {
    "text": "Let $A=\\{1,3,7,9,11\\}$ and $B=\\{2,4,5,7,8,10,12\\}$. Then the total number of one-one maps $f: \\mathrm{A} \\rightarrow \\mathrm{B}$, such that $f(1)+f(3)=14$, is :"
  },
  "options": [
    {
      "text": "480",
      "is_correct": false
    },
    {
      "text": "240",
      "is_correct": true
    },
    {
      "text": "120",
      "is_correct": false
    },
    {
      "text": "180",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0039_2a425d4712de.png\"><br />$\\begin{aligned}\n& A=\\{1,3,7,9,11\\} \\\\\n& B=\\{2,4,5,7,8,10,12\\} \\\\\n& f(1)+f(3)=14\n\\end{aligned}$\n(i) $2+12$\n(ii) $4+10$\n$2 \\times(2 \\times 5 \\times 4 \\times 3)=240$"
  }
}