  "question": {
    "text": "The probability that a randomly chosen one-one function from the set <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"}\" open=\"{\"><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi></mrow></mfenced></math>&nbsp;to the set <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"}\" open=\"{\"><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn></mrow></mfenced></math>&nbsp;satisfied&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>a</mi></mfenced><mo>+</mo><mn>2</mn><mo>&#160;</mo><mi>f</mi><mfenced><mi>b</mi></mfenced><mo>-</mo><mi>f</mi><mfenced><mi>c</mi></mfenced><mo>=</mo><mi>f</mi><mfenced><mi>d</mi></mfenced></math>&nbsp;is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>24</mn></mfrac></math>",
      "is_correct": false
    },
