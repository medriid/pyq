    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\"><mrow><mo>-</mo><mo>&#8734;</mo><mo>,</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></mrow></mfenced></math>",
