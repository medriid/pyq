  "question": {
    "text": "The graph of the function $y=f(x)$ is symmetrical about the line $x=2$, then"
  },
  "options": [
    {
      "text": "\n$f(x+2)=f(x-2)$\n",
      "is_correct": false
    },
    {
      "text": "\n$f(2+x)=f(2-x)$\n",
      "is_correct": true
    },
    {
      "text": "\n$f(x)=f(-x)$\n",
      "is_correct": false
    },
    {
      "text": "\n$f(x)=-f(-x)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "If $y=f(x)$ is symmetric about the line $x=2$ then $f(2+x)=f(2-x)$"
  }
}