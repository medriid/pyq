  "question": {
    "text": "The graph of the function $y=f(x)$ is symmetrical about the line $x=2$, then",
    "image": null
  },
  "options": [
    {
      "id": "DhlUV",
      "text": "\n$f(x+2)=f(x-2)$\n",
      "image": null,
      "isCorrect": false
    },
    {
