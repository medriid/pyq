  "question": {
    "text": "If $f: R \\rightarrow S$, defined by $f(x)=\\sin x-\\sqrt{3} \\cos x+1$, is onto, then the interval of $S$ is",
    "image": null
  },
  "options": [
    {
      "id": "Rgled",
      "text": "\n$[0,3]$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "D0DFu",
      "text": "\n$[-1,1]$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UHuJI",
      "text": "\n$[0,1]$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "leMm6",
      "text": "\n$[-1,3]$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$-2 \\leq \\sin x-\\sqrt{3} \\cos x \\leq 2 \\Rightarrow-1 \\leq \\sin x-\\sqrt{3} \\cos x+1 \\leq 3$\n$\\Rightarrow$ range of $f(x)$ is $[-1,3]$.\nHence $S$ is $[-1,3]$",
    "image": null
  },
