  "question": {
    "text": "The range of the function $f(x)={ }^{7-x} P_{x-3}$ is"
  },
  "options": [
    {
      "text": "\n$\\{1,2,3\\}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\{1,2,3,4,5\\}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\{1,2,3,4\\}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\{1,2,3,4,5,6\\}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$f(x)={ }^{7-x} P_{x-3}$\n$7-x \\geq 0 \\Rightarrow x \\leq 7$\n$x-3 \\geq 0 \\Rightarrow x \\geq 3$,\nand $7-x \\geq x-3 \\Rightarrow x \\leq 5$\n$\\Rightarrow 3 \\leq x \\leq 5 \\Rightarrow x=3,4,5 \\Rightarrow$ Range is $\\{1,2,3\\}$"
  }
}