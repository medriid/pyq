    {
      "text": "There exists a one-one function <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>:</mo><mi>N</mi><mo>&#8594;</mo><mi>N</mi></math> such<br />that&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mi>o</mi><mi>g</mi><mo>=</mo><mi>f</mi></math>",
      "is_correct": false
