  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mi>x</mi></mfenced></math> denote the greatest integer less than or equal to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>.</mo></math>&nbsp;Then, the values of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mi>R</mi></math> satisfying the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced close=\"]\" open=\"[\"><msup><mi>e</mi><mi>x</mi></msup></mfenced><mn>2</mn></msup><mo>+</mo><mfenced close=\"]\" open=\"[\"><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mo>-</mo><mn>3</mn><mo>=</mo><mn>0</mn></math>&nbsp;lie in the interval:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\"><mrow><mn>0</mn><mo>,</mo><mo>&#160;</mo><mfrac><mn>1</mn><mi>e</mi></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\"><mrow><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>2</mn><mo>,</mo><mo>&#160;</mo><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>3</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\"><mrow><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi>e</mi></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\"><mrow><mn>0</mn><mo>,</mo><mo>&#160;</mo><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>2</mn></mrow></mfenced></math>",
      "is_correct": true
