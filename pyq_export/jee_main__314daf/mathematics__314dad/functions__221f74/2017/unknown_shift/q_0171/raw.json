  "solution": {
    "text": "<p>Given <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mi>x</mi></math></p><p>Where,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><msup><mn>2</mn><mn>10</mn></msup><mi>x</mi><mo>+</mo><mn>1</mn></math>&nbsp;,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><msup><mn>3</mn><mn>10</mn></msup><mi>x</mi><mo>-</mo><mn>1</mn><mo>.</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>f</mi><mfenced separators=\"|\"><mrow><msup><mn>3</mn><mn>10</mn></msup><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><msup><mn>2</mn><mn>10</mn></msup><mfenced separators=\"|\"><mrow><msup><mn>3</mn><mn>10</mn></msup><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+1</mo></math><br /><br /><math><mo>&#8658;</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>10</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mrow><mn>3</mn></mrow><mrow><mn>10</mn></mrow></msup><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mn>1</mn><mo>=</mo><mi>x</mi></math><br /><br /><math><mo>&#8658;</mo><mi>x</mi><mfenced separators=\"|\"><mrow><msup><mrow><mn>6</mn></mrow><mrow><mn>10</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>10</mn></mrow></msup><mo>-</mo><mn>1</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>-</mo><mn>1</mn></mrow><mrow><msup><mn>6</mn><mn>10</mn></msup><mo>-</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mstyle displaystyle=\"true\"><mfrac><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>-</mo><mn>1</mn></mrow><msup><mn>2</mn><mn>10</mn></msup></mfrac></mstyle><mstyle displaystyle=\"true\"><mfrac><mrow><mo>(</mo><mn>2</mn><