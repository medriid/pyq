  "question": {
    "text": "Suppose $f(x)$ is differentiable $x=1$ and $\\lim _{h \\rightarrow 0} \\frac{1}{h} f(1+h)=5$, then $f^{\\prime}(1)$ equals",
    "image": null
  },
  "options": [
    {
      "id": "0WByF",
      "text": "\n3\n",
      "image": null,
      "isCorrect": false
