  "question": {
    "text": "<p>Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>:</mo><mi mathvariant=\"bold-italic\">R</mi><mo>&#8594;</mo><mi mathvariant=\"bold-italic\">R</mi></math>&nbsp;be defined as&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><mi>x</mi><mo>-</mo><mn>5</mn></math>.&nbsp;If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi><mfenced><mi>x</mi></mfenced></math>&nbsp;is a function such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mrow><mi>g</mi><mfenced><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mi>x</mi><mo>,</mo><mo>&#8704;</mo><mi>x</mi><mo>&#8712;</mo><mi mathvariant=\"bold-italic\">R</mi></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>g</mi><mo>&#39;</mo></msup><mfenced><mn>63</mn></mfenced></math>&nbsp;is equal to ______</p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>49</mn></math>",
      "is_correct": false
    },
