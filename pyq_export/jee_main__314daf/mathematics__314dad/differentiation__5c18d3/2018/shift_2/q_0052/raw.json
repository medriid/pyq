  "question": {
    "text": "If $f(x)=\\sin ^{-1}\\left(\\frac{2 \\times 3^x}{1+9^x}\\right)$, then $f^{\\prime}\\left(-\\frac{1}{2}\\right)$ equals.",
    "image": null
  },
  "options": [
    {
      "id": "StW4L",
      "text": "\n$\\sqrt{3} \\log _e \\sqrt{3}$\n",
      "image": null,
