  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><msqrt><msup><mn>2</mn><mrow><msup><mi>cosec</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>t</mi></mrow></msup></msqrt></math>&nbsp;and&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msqrt><msup><mn>2</mn><mrow><msup><mi>sec</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>t</mi></mrow></msup></msqrt><mo>,</mo><mo>&#160;</mo><mfenced separators=\"|\"><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mi>t</mi></mfenced><mo>&#8805;</mo><mn>1</mn></mrow></mfenced><mo>,</mo></math>&nbsp;then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math>&nbsp;is equal to",
    "image": null
  },
