  "question": {
    "text": "If $x \\log _{e}\\left(\\log _{e} x\\right)-x^{2}+y^{2}=4(y>0),$ then $\\frac{d y}{d x}$ at $x=e$ is\r\n\r\nequal to :",
    "image": null
  },
  "options": [
    {
      "id": "mjISq",
      "text": "$\\frac{(1+2 e)}{2 \\sqrt{4+e^{2}}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ix6CO",
      "text": "$\\frac{(2 e-1)}{2 \\sqrt{4+e^{2}}}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "txlnc",
      "text": "$\\frac{(1+2 e)}{\\sqrt{4+e^{2}}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "W8F5y",
      "text": "$\\frac{e}{\\sqrt{4+e^{2}}}$",
      "isCorrect": false,
      "image": null
    }
