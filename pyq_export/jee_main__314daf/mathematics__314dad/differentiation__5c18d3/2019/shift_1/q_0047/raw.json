  "level": 2,
  "question": {
    "text": "For <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#62;</mo><mn>1</mn></math>, if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi></mrow></mfenced><mrow><mn>2</mn><mi>y</mi></mrow></msup><mo>=</mo><mn>4</mn><msup><mi>e</mi><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mn>2</mn><mi>y</mi></mrow></msup></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msub><mi>log</mi><mi>e</mi></msub><mo>&#8289;</mo><mn>2</mn><mi>x</mi></mrow></mfenced><mn>2</mn></msup><mi>&#160;</mi><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math>&nbsp;is equal to",
    "image": null
  },
  "options": [
    {
      "id": "qN9A0",
      "text": "<math><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn><mi>x</mi></mrow></mrow></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "cbrRr",
      "text": "<math><mfrac><mrow><mi>x</mi><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></mrow></mrow></mrow><mrow><mi>x</mi></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "dQu4y",
      "text": "<math><mi>x</mi><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn><mi>x</mi></mrow></mrow></math>",
