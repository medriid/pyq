  "solution": {
    "text": "<p>Given:</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><mo>=</mo><msup><mi>cos</mi><mn>2</mn></msup><mn>2</mn><mi>x</mi><mo>-</mo><mn>2</mn><msup><mi>sin</mi><mn>4</mn></msup><mi>x</mi><mo>-</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><msup><mfenced><mrow><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><msup><mfenced><mrow><mn>1</mn><mo>-</mo><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mn>4</mn><msup><mi>cos</mi><mn>4</mn></msup><mi>x</mi><mo>-</mo><mn>4</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>+</mo><mn>1</mn><mo>-</mo><mn>2</mn><mfenced><mrow><mn>1</mn><mo>-</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>+</mo><msup><mi>cos</mi><mn>4</mn></msup><mi>x</mi></mrow></mfenced><mo>-</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mn>2</mn><msup><mi>cos</mi><mn>4</mn></msup><mi>x</mi><mo>-</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>+</mo><mn>1</mn><mo>-</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mn>2</mn><msup><mi>cos</mi><mn>4</mn></msup><mi>x</mi><mo>-</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>-</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mn>2</mn><mfenced open=\"[\" close=\"]\"><mrow><msup><mi>cos</mi><mn>4</mn></msup><mi>x</mi><mo>-</mo><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>-</mo>