  "question": {
    "text": "The number of values of $x$ in the interval $[0,3 \\pi]$ satisfying the equation $2 \\sin ^2 x+5 \\sin x-3=0$ is"
  },
  "options": [
    {
      "text": "\n4\n",
      "is_correct": true
    },
    {
      "text": "\n6\n",
      "is_correct": false
    },
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n2",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$2 \\sin ^2 x+5 \\sin x-3=0$\n$\\Rightarrow(\\sin x+3)(2 \\sin x-1)=0$\n$\\Rightarrow \\sin x=\\frac{1}{2} \\quad \\therefore \\ln (0,3 \\pi), x$ has 4 values"
  }
}