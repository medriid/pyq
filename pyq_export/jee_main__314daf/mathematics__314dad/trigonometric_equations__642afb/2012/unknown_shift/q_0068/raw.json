  "question": {
    "text": "The equation $e^{\\sin x}-e^{-\\sin x}-4=0$ has",
    "image": null
  },
  "options": [
    {
      "id": "iRj3a",
      "text": "\ninfinite number of real roots\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Hzzm7",
      "text": "\nno real roots\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BN1cQ",
      "text": "\nexactly one real root\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tqU8K",
      "text": "\nexactly four real roots",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$e^{\\sin x}-e^{-\\sin x}=4 \\quad \\Rightarrow e^{\\sin x}=t$\n$t-\\frac{1}{t}=4$\n$\\begin{array}{ll}t^2-4 t-1=0 & \\Rightarrow t=\\frac{4 \\pm \\sqrt{16+4}}{2} \\\\ \\Rightarrow t=\\frac{4 \\pm 2 \\sqrt{5}}{2} & \\Rightarrow t=2 \\pm \\sqrt{5}\\end{array}$\n$e^{\\sin x}=2 \\pm \\sqrt{5} \\quad \\quad-1 \\leq \\sin x \\leq 1 \\quad \\quad \\frac{1}{e} \\leq e^{\\sin x} \\leq e$\n$e^{\\sin x}=2+\\sqrt{5}$ not possible \n$e^{\\sin x}=2-\\sqrt{5}$ not possible\n$\\therefore$ hence no solution",
    "image": null
  },
