    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mo>-</mo><mfrac><msqrt><mn>17</mn></msqrt><mn>2</mn></mfrac><mo>,</mo><mfrac><msqrt><mn>17</mn></msqrt><mn>2</mn></mfrac></mrow></mfenced></math>",
