  "solution": {
    "text": "<p>Given: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><mi>cos</mi><mn>2</mn><mi>x</mi><mo>+</mo><msup><mi>cos</mi><mn>3</mn></msup><mn>2</mn><mi>x</mi></mrow><mrow><msup><mi>cos</mi><mn>6</mn></msup><mi>x</mi><mo>-</mo><msup><mi>sin</mi><mn>6</mn></msup><mi>x</mi></mrow></mfrac><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>cos</mi><mn>2</mn><mi>x</mi><mfenced><mrow><mn>3</mn><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mn>2</mn><mi>x</mi></mrow></mfenced></mrow><mrow><msup><mfenced><mrow><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mn>3</mn></msup><mo>-</mo><msup><mfenced><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mn>3</mn></msup></mrow></mfrac><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>cos</mi><mn>2</mn><mi>x</mi><mfenced><mrow><mn>3</mn><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mn>2</mn><mi>x</mi></mrow></mfenced></mrow><mrow><mfenced><mrow><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><mo>-</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mfenced><mrow><msup><mi>cos</mi><mn>4</mn></msup><mi>x</mi><mo>+</mo><msup><mi>sin</mi><mn>4</mn></msup><mi>x</mi><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mfenced><mrow><mn>3</mn><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mn>2</mn><mi>x</mi></mrow></mfenced><mrow><msup><mfenced><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi><mo>+</mo><msup