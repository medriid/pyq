  "question": {
    "text": "The number of solutions of the equation<br/>$\\cos 2 \\theta \\cos \\frac{\\theta}{2}+\\cos \\frac{5 \\theta}{2}=2 \\cos ^3 \\frac{5 \\theta}{2}$<br/>in $\\left[-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right]$ is :",
    "image": null
  },
  "options": [
