  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}<br/>& \\cos 2 \\theta \\cos \\frac{\\theta}{2}+\\cos \\frac{5 \\theta}{2}=2 \\cos ^3 \\frac{5 \\theta}{2} \\\\\n& \\frac{1}{2}\\left(2 \\cos 2 \\theta \\cos \\frac{\\theta}{2}\\right)+\\cos \\frac{50}{2} \\\\\n& =\\frac{1}{2}\\left(\\cos \\frac{15 \\theta}{2}+3 \\cos \\frac{5 \\theta}{2}\\right)<br/>\\end{aligned}$<br/>or solving<br/>$\\begin{aligned}<br/>& \\cos \\frac{3 \\theta}{2}=\\cos \\frac{15 \\theta}{2} \\\\\n& \\cos \\frac{15 \\theta}{2}-\\cos \\frac{3 \\theta}{2}=0 \\\\\n& 2 \\sin 30 \\sin \\frac{9 \\theta}{2}=0<br/>\\end{aligned}$<br/>$3 \\theta=\\mathrm{n} \\pi \\text { or } \\frac{9 \\theta}{2}=\\mathrm{m} \\pi$<br/>$\\begin{aligned}<br/>& \\theta=\\frac{\\mathrm{n} \\pi}{3} \\quad \\theta=\\frac{2 \\mathrm{~m} \\pi}{9} \\\\\n& \\theta=\\left\\{-\\frac{\\pi}{2}, \\frac{\\pi}{3}, 0\\right\\} \\\\\n& \\theta=\\left\\{-\\frac{4 \\pi}{9}, \\frac{-2 \\pi}{9}, \\frac{4 \\pi}{9}, \\frac{2 \\pi}{9}\\right\\}<br/>\\end{aligned}$",
    "image": null
  },
