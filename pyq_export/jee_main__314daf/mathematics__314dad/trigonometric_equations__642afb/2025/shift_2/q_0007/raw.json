  "question": {
    "text": "If $\\theta \\in\\left[-\\frac{7 \\pi}{6}, \\frac{4 \\pi}{3}\\right]$, then the number of solutions of $\\sqrt{3} \\operatorname{cosec}^2 \\theta-2(\\sqrt{3}-1) \\operatorname{cosec} \\theta-4=0$, is equal to",
    "image": null
  },
  "options": [
    {
      "id": "Ilchd",
      "text": "$6$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "czJKA",
      "text": "$8$",
      "image": null,
      "isCorrect": false
    },
