  "question": {
    "text": "The number of solutions of equation $(4-\\sqrt{3}) \\sin x$ $-2 \\sqrt{3} \\cos ^2 x=-\\frac{4}{1+\\sqrt{3}}, x \\in\\left[-2 \\pi, \\frac{5 \\pi}{2}\\right]$ is",
    "image": null
  },
  "options": [
    {
      "id": "2zOKj",
      "text": "$4$",
      "image": null,
      "isCorrect": false
    },
