  "question": {
    "text": "The number of solutions of the equation $\\sin 2 x-2 \\cos x+4 \\sin x=4$ in the interval $[0,5 \\pi]$ is :",
    "image": null
  },
  "options": [
    {
      "id": "U6kCM",
      "text": "\n3\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UI49j",
      "text": "\n5\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "w8GdK",
      "text": "\n4\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JoYNA",
      "text": "\n6",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\text { } \\begin{aligned}\n& \\sin 2 x-2 \\cos x+4 \\sin x=4 \\\\\n& \\Rightarrow 2 \\sin x \\cdot \\cos x-2 \\cos x+4 \\sin x-4=0 \\\\\n& \\Rightarrow(\\sin x-1)(\\cos x-2)=0\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n& \\because \\cos x-2 \\neq 0, \\therefore \\sin x=1 \\\\\n& \\therefore \\quad x=\\frac{\\pi}{2}, \\frac{5 \\pi}{2}, \\frac{9 \\pi}{2}\n\\end{aligned}\n$$",
    "image": null
  },
