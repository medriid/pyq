    "text": "Given&nbsp;<br /><mo><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mo>&#160;</mo><mi>&#945;</mi><mo>&#160;</mo><mo>+</mo><mo>&#160;</mo><mi>cos</mi><mo>&#160;</mo><mi>&#946;</mi><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math></mo><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mo>&#160;</mo><mi>&#945;</mi><mo>&#160;</mo><mo>+</mo><mo>&#160;</mo><mi>sin</mi><mo>&#160;</mo><mi>&#946;</mi><mo>&#160;</mo><mo>=</mo><mo>&#160;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><math><mo>&#8658;</mo><mn>2</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mo>(</mo><mfrac><mrow><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>)</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mo>(</mo><mfrac><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>)</mo><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math> ......(i) and<br /><br /><math><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mo>(</mo><mfrac><mrow><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>)</mo></mrow></mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mo>&#8289;</mo><mo>(</mo><mfrac><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>)=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math> ....(ii)<br /><br />Dividing (ii) and (i)<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>&#160;</mo><mfenced><mfrac><mfenced><mrow><mi>&#945;</mi><mo>&#160;</mo><mo>+</mo><mo>&#160;</mo><mi>&#946;</mi></mrow></mfenced><mn>2</mn></mfrac></mfenced></math><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi><mi>&#160;</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mrow></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi><mo>+</mo><mi>cos</mi><mo>&#8289;</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi><mi>&#160;</mi><mo>=</mo></math> <math><mfrac><mrow><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow></mrow></mfrac><mo>+</mo><mi>&#160;</mi><mfrac><mrow><mn>1</mn><mo>-</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>9</mn></mrow></mfrac></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>9</mn></mrow></mfrac></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>9</mn></mrow></mfrac></mrow></mfrac></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mfrac><mrow><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>8</mn></mrow><mrow><mn>9</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mn>10</mn></mrow><mrow><mn>9</mn