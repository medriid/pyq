  "question": {
    "text": "The number of solutions of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sin</mi><mn>7</mn></msup><mi>x</mi><mo>+</mo><msup><mi>cos</mi><mn>7</mn></msup><mi>x</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi>x</mi><mo>&#8712;</mo><mo>[</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mn>4</mn><mi>&#960;</mi><mo>]</mo></math>&nbsp; is equal to",
    "image": null
  },
  "options": [
    {
      "id": "YvXCp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>11</mn></math>",
