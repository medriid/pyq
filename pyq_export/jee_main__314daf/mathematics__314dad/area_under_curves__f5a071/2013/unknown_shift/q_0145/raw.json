  "question": {
    "text": "The area under the curve $y=|\\cos x-\\sin x|$, $0 \\leq x \\leq \\frac{\\pi}{2}$, and above $x$-axis is :",
    "image": null
  },
  "options": [
    {
      "id": "rwdiR",
      "text": "\n$2 \\sqrt{2}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "X1aiT",
      "text": "\n$2 \\sqrt{2}-2$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GJ9IO",
      "text": "\n$2 \\sqrt{2}+2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MzHlK",
      "text": "\n0",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\text { } y=|\\cos x-\\sin x|\n$$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/atKCB74ZkroXBJdbLPn56sHqx0yarr6ySaTBFMpxDh4.original.fullsize.png\"><br>\n$$\n\\begin{aligned}\n\\text { Required area } & =2 \\int_0^{\\pi / 4}(\\cos x-\\sin x) d x \\\\\n& =2\\left[\\sin x+\\cos x 0_0^{\\pi / 4}\\right] \\\\\n& =2\\left[\\frac{2}{\\sqrt{2}}-1\\right]=(2 \\sqrt{2}-2) \\text { sq. units }\n\\end{aligned}\n$$",
    "image": null
  },
