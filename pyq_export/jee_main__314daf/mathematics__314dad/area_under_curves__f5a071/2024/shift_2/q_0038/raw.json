  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/EB4V2moWTRLoV_b6GTurOQk0e8k7KVNlCmLGArngsJ8.original.fullsize.png\"><br />$\\begin{aligned} & \\text { Shaded area }=\\int_{-\\frac{1}{2}}^1\\left(x_{\\text {Right }}-x_{\\text {Left }}\\right) d y \\\\ & y^2=2 x \\\\ & y=4 x-1 \\quad \\text { Solve } \\\\ & y=1, y=-\\frac{1}{2} \\\\ & \\text { Shaded area }=\\int_{-\\frac{1}{2}}^1\\left(\\frac{y+1}{4}-\\frac{y^2}{2}\\right) d y \\\\ & =\\left(\\frac{1}{4}\\left(\\frac{y^2}{2}+y\\right)-\\frac{y^3}{6}\\right)_{-\\frac{1}{2}}^1=\\frac{9}{32}\\end{aligned}$",
    "image": null
