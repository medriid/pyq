  "question": {
    "text": "The area enclosed between the curves $y^2=x$ and $y=|x|$ is",
    "image": null
  },
  "options": [
    {
      "id": "7E8Ux",
      "text": "\n$2 / 3$\n",
      "image": null,
      "isCorrect": false
    },
    {
