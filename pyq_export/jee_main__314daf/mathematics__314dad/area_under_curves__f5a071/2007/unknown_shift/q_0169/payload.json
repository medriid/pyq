  "question": {
    "text": "The area enclosed between the curves $y^2=x$ and $y=|x|$ is"
  },
  "options": [
    {
      "text": "\n$2 / 3$\n",
      "is_correct": false
    },
    {
      "text": "\n$1$\n",
      "is_correct": false
    },
    {
      "text": "\n$1 / 6$\n",
      "is_correct": true
    },
    {
      "text": "\n$1 / 3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$A=\\int_0^1(\\sqrt{x}-x) d x$\n$=\\left[\\frac{2}{3} x^{3 / 2}-\\frac{x^2}{2}\\right]_0^1$\n$=\\frac{2}{3}-\\frac{1}{2}=\\frac{1}{6}$.\n<img src=\"assets\\st0169_565730bc8862.png\"><br>"
  }
}