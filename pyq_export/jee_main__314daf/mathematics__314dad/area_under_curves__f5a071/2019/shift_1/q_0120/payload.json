  "question": {
    "text": "The region represented by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mi>y</mi></mrow></mfenced><mo>&#8804;</mo><mn>2</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></mfenced><mo>&#8804;</mo><mn>2</mn></math> is bounded by a"
  },
  "options": [
    {
      "text": "rhombus of area <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><msqrt><mn>2</mn></msqrt><mo>&#160;</mo><mi>sq</mi><mo>.</mo><mo>&#160;</mo><mi>units</mi></math>.",
      "is_correct": false
