  "question": {
    "text": "The area (in sq. units) of the region bounded by the curves <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msup><mn>2</mn><mi mathvariant=\"italic\">x</mi></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced></math>, in the first quadrant is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>&#8289;</mo><mn>2</mn></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>log</mi><mi>e</mi></msub><mo>&#8289;</mo><mn>2</mn><mo>+</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
