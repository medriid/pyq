  "question": {
    "text": "The area of the region bounded by the curves $y=|x-1|$ and $y=3-|x|$ is"
  },
  "options": [
    {
      "text": "\n6 sq. units\n",
      "is_correct": false
    },
    {
      "text": "\n2 sq. units\n",
      "is_correct": false
    },
    {
      "text": "\n3 sq. units\n",
      "is_correct": false
    },
    {
      "text": "\n4 sq. units",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0174_0f8853ce34cf.png\"><br>\n$A=\\int_{-1}^0\\{(3+x)-(-x+1)\\} d x+\\int_0^1\\{(3-x)-(-x+1)\\} d x+\\int_1^2\\{(3-x)-(-x-1)\\} d x$\n$=\\int_{-1}^0(2+2 x) d x+\\int_0^1 2 d x+\\int_1^2(4-2 x) d x$\n$=\\left[2 x-x^2\\right]_{-1}^0+[2 x]_0^1+\\left[4 x-x^2\\right]_1^2$\n$=0-(-2+1)+(2-0)+(8-4)-(4-1)$\n$=1+2+4-3=4$ sq. units"
  }
}