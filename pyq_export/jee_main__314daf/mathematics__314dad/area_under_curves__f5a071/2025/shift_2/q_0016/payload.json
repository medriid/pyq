  "question": {
    "text": "The area of the region enclosed by the curves $y=x^2-4 x+4$ and $y^2=16-8 x$ is :"
  },
  "options": [
    {
      "text": "$\\frac{8}{3}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{4}{3}$",
      "is_correct": false
    },
    {
      "text": "8",
      "is_correct": false
    },
    {
      "text": "5",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0016_0ac092f9e059.png\"><br>\n$\\begin{aligned} \\text { Area } & =\\int_0^2\\left(\\sqrt{16-8 x}-\\left(x^2-4 x+4\\right)\\right) d x \\\\ & \\left.=\\frac{-(16-8 x)^{3 / 2}}{12}-\\frac{x^3}{3}+2 x^2+4 x\\right]_0^2 \\\\ & =\\frac{8}{3}\\end{aligned}$"
  }
}