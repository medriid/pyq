  "question": {
    "text": "The area of the region enclosed by the curves $y=x^2-4 x+4$ and $y^2=16-8 x$ is :",
    "image": null
  },
  "options": [
    {
      "id": "0ygYW",
      "text": "$\\frac{8}{3}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "yUxI3",
      "text": "$\\frac{4}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gg8KC",
      "text": "8",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gNx4m",
      "text": "5",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/1_jYEcxFbOuu0w4BbjMWmeZGfErds5nUzuLElpwyO_w.original.fullsize.png\"><br>\n$\\begin{aligned} \\text { Area } & =\\int_0^2\\left(\\sqrt{16-8 x}-\\left(x^2-4 x+4\\right)\\right) d x \\\\ & \\left.=\\frac{-(16-8 x)^{3 / 2}}{12}-\\frac{x^3}{3}+2 x^2+4 x\\right]_0^2 \\\\ & =\\frac{8}{3}\\end{aligned}$",
    "image": null
  },
