  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/g_2ptiFl2NYU6rlw74V-bVufOA8OSFmao5QJbxD1MPc.original.fullsize.png\"><br>\n$\\begin{aligned} & e^x=1-e^x \\Rightarrow 2 e^x=1 \\\\ & \\Rightarrow e^x=\\frac{1}{2} \\\\ & \\Rightarrow x=\\ln \\frac{1}{2} \\\\ & \\int_{\\ln (1 / 2)}^0\\left[e^x-\\left(1-e^x\\right)\\right] d x \\\\ & =\\int_{\\ln 2}^0\\left(2 e^x-1\\right) d x=2 e^x-\\left.x\\right|_{-\\ln 2} ^0 \\\\ & =2-(1+\\ln 2) \\\\ & =1-\\log _e 2\\end{aligned}$",
    "image": null
  },
