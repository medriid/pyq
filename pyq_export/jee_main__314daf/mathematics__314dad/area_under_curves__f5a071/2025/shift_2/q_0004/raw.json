  "question": {
    "text": "The area of the region $\\{(x, y):|x-y| \\leq y \\leq 4 \\sqrt{x}\\}$ is",
    "image": null
  },
  "options": [
    {
      "id": "lrR8z",
      "text": "$512$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KI4Tg",
      "text": "$\\frac{1024}{3}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "di3MY",
      "text": "$\\frac{512}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0qte2",
      "text": "$\\frac{2048}{3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/uDlfzYA5BRRtF4DSpHcut-DD2s_998_5pG96Eh8NQrk.original.fullsize.png\"/><br/>$\\begin{aligned} & |x-y| \\leq y \\leq 4 \\sqrt{x} \\\\ & \\text { Now } y=|x-y| \\\\ & y^2=(x-y)^2 \\\\ & \\Rightarrow y=\\frac{x}{2} \\text { and } x=0\\end{aligned}$<br/>$\\begin{aligned} & \\text { Now area }=\\int_0^{64}\\left(4 \\sqrt{\\mathrm{x}}-\\frac{\\mathrm{x}}{2}\\right) \\mathrm{dx} \\\\ & =\\left[\\frac{4 \\mathrm{x}^{3 / 2}}{3 / 2}-\\frac{\\mathrm{x}^2}{4}\\right]_0^{64}=\\frac{8}{3} \\cdot 8^3-\\frac{64^2}{4}=64^2\\left(\\frac{1}{12}\\right) \\\\ & =\\frac{1024}{3}\\end{aligned}$",
    "image": null
  },
