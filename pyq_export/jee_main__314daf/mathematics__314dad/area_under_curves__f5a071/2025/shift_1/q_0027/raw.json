  "question": {
    "text": "The area of the region, inside the circle $(x-2 \\sqrt{3})^2+y^2=12$ and outside the parabola $y^2=2 \\sqrt{3} x$ is :",
    "image": null
  },
  "options": [
    {
      "id": "X44Nr",
      "text": "$3 \\pi+8$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lxfN3",
      "text": "$6 \\pi-16$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "0WK1J",
      "text": "$3 \\pi-8$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "h7WI9",
      "text": "$6 \\pi-8$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/rQTw_nIFyNU_s37f49dRGnVXC8XAlzNA8eCJjDL5RUs.original.fullsize.png\"><br>\n$\\begin{aligned} & \\text { Required area }=2 \\int_0^{2 \\sqrt{3}}\\left(\\sqrt{4 \\sqrt{3} x-x^2}-\\sqrt{2 \\sqrt{3} x}\\right) d x \\\\ & =2 \\int_0^{2 \\sqrt{3}}\\left(\\sqrt{12-(x-2 \\sqrt{3})^2}-\\sqrt{2 \\sqrt{3} x}\\right) d x \\\\ & =2\\left[\\frac{x-2 \\sqrt{3}}{2} \\sqrt{12-(x-2 \\sqrt{3})^2}+\\frac{12}{2} \\sin ^{-1}\\left(\\frac{x-2 \\sqrt{3}}{2 \\sqrt{3}}\\right)\\right. \\\\ & \\left.-\\frac{\\sqrt{2 \\sqrt{3}} x^{\\frac{3}{2}}}{\\frac{3}{2}}\\right]_0^{2 \\sqrt{3}} \\\\ & =2\\{3 \\pi-8\\} \\\\ & =6 \\pi-16 \\text { sq. units. }\\end{aligned}$",
    "image": null
  },
