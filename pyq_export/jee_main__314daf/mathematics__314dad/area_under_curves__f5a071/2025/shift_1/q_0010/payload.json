  "question": {
    "text": "The area (in sq. units) of the region\n$\\left\\{(x, y): 0 \\leq \\mathrm{y} \\leq 2|x|+1,0 \\leq \\mathrm{y} \\leq x^2+1,|x| \\leq 3\\right\\}$ is"
  },
  "options": [
    {
      "text": "$\\frac{80}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{64}{3}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{32}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{17}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
