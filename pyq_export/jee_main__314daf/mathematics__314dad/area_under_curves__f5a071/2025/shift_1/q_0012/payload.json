      "text": "$\\frac{730}{119}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{625}{111}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{821}{123}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{567}{121}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
