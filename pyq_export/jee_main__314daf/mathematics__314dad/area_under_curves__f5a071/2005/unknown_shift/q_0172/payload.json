      "text": "\n1\n",
      "is_correct": true
    },
    {
      "text": "\n2\n",
      "is_correct": false
    },
    {
      "text": "\n3\n",
      "is_correct": false
    },
    {
      "text": "\n4",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Required area }(O A B)=\\int_{1-e}^0 \\ln (x+e) d x \\\\\n& =\\left[x \\ln (x+e)-\\int \\frac{1}{x+e} x d x\\right]_0^1=1 .\n\\end{aligned}\n$$"
