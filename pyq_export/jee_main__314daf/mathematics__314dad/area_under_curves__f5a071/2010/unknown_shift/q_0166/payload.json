  "question": {
    "text": "The area bounded by the curves $y=\\cos x$ and $y=\\sin x$ between the ordinates $x=0$ and $x=\\frac{3 \\pi}{2}$ is"
  },
  "options": [
    {
      "text": "\n$4 \\sqrt{2}+2$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\sqrt{2}-1$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\sqrt{2}+1$\n",
      "is_correct": false
    },
    {
      "text": "\n$4 \\sqrt{2}-2$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\int_0^{\\frac{\\pi}{4}}(\\cos x-\\sin x) d x+\\int_{\\frac{\\pi}{4}}^{\\frac{5 \\pi}{4}}(\\sin x-\\cos x) d x+\\int_{\\frac{5 \\pi}{4}}^{\\frac{3 \\pi}{2}}(\\cos x-\\sin x)=4 \\sqrt{2}-2$\n<img src=\"assets\\st0166_13617ed592f5.png\"><br>"
  }
}