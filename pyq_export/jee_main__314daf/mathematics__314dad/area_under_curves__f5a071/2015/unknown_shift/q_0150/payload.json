    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>7</mn><mrow><mn>3</mn><mn>2</mn></mrow></mfrac><mo>&#160;</mo><mi>sq</mi><mo>.</mo><mi>units</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mrow><mn>6</mn><mn>4</mn></mrow></mfrac><mo>&#160;</mo><mi>sq</mi><mo>.</mo><mi>units</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>15</mn><mrow><mn>6</mn><mn>4</mn></mrow></mfrac><mo>&#160;</mo><mi>sq</mi><mo>.</mo><mi>units</mi></math>",
