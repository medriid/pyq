  "question": {
    "text": "The area (in sq. units) of the region described by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><mfenced><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></mfenced><mo>:</mo><mo>&#160;</mo><msup><mi>y</mi><mn>2</mn></msup><mo>&#8804;</mo><mn>2</mn><mi>x</mi><mo>&#160;</mo><mi>and</mi><mo>&#160;</mo><mi>y</mi><mo>&#8805;</mo><mn>4</mn><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced></math> is&nbsp;"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>9</mn><mn>32</mn></mfrac><mo>&#160;</mo><mi>sq</mi><mo>.</mo><mi>units</mi></math>",
      "is_correct": true
