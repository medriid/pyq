  "question": {
    "text": "The area (in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sq</mi><mo>.</mo><mi>units</mi></math>) of the region <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>{</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>,</mo><mi>&#160;</mi><mi>y</mi></mrow></mfenced><mo>:</mo><msup><mi>y</mi><mn>2</mn></msup><mo>&#8805;</mo><mn>2</mn><mi>x</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>&#8804;</mo><mn>4</mn><mi>x</mi><mo>,</mo><mi>&#160;</mi><mi>x</mi><mi>&#160;</mi><mo>&#8805;</mo><mn>0</mn><mo>,</mo><mi>&#160;</mi><mi>y</mi><mi>&#160;</mi><mo>&#8805;</mo><mn>0</mn><mo>}</mo><mi>&#160;</mi></math> is",
    "image": null
  },
  "options": [
    {
      "id": "Tj2Dd",
      "text": "<math><mi>&#960;</mi><mo>-</mo><mfrac><mrow><mn>4</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
