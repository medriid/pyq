  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>(</mo><mn>4</mn><mo>-</mo><mi>x</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mi>y</mi></mfenced><mo>=</mo><mfrac><mrow><mo>|</mo><mi>x</mi><mo>|</mo></mrow><mn>2</mn></mfrac><msqrt><mo>(</mo><mn>4</mn><mo>-</mo><mi>x</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>)</mo></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>y</mi><mn>1</mn></msub><mo>=</mo><mfrac><mi>x</mi><mn>2</mn></mfrac><msqrt><mo>(</mo><mn>4</mn><mo>-</mo><mi>x</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>)</mo></msqrt></math></p><p>and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>y</mi><mn>2</mn></msub><mo>=</mo><mfrac><mrow><mo>-</mo><mi>x</mi></mrow><mn>2</mn></mfrac><msqrt><mo>(</mo><mn>4</mn><mo>-</mo><mi>x</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>)</mo></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi><mo>:</mo><mi>x</mi><mo>&#8712;</mo><mo>[</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>]</mo></math></p><p>Required Area</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msubsup><mo>&#8747;</mo><mn>2</mn><mn>4</mn></msubsup><mfenced><mrow><msub><mi mathvariant=\"normal\">y</mi><mn>1</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">y</mi><mn>2</mn></msub></mrow></mfenced><mi>dx</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mn>2</mn><mn>4</mn></msubsup><mi mathvariant=\"normal\">x</mi><msqrt><mo>(</mo><mn>4</mn><mo>-</mo><mi mathvariant=\"normal\">x</mi><mo>)</mo><mo>(</mo><mi mathvariant=\"normal\">x</mi><mo>-</mo><mn>2</mn><mo>)</mo></msqrt><mi>dx</mi><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mn>1</mn></mfenced></math></p><p>Applying <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mo>&#8747;</mo><mi>a</mi><mi>b</mi></msubsup><mi>f</mi><mfenced><mi>x</mi></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mi>a</mi><mi>b</mi></msubsup><mi>f</mi><mfenced><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>-</mo><mi>x</mi></mrow></mfenced><mi>d</mi><mi>x</mi></math></p><p>Area <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msubsup><mo>&#8747;</mo><mn>2</mn><mn>4</mn></msubsup><mfenced><mrow><mn>6</mn><mo>-</mo><mi>x</mi></mrow></mfenced><msqrt><mo>(</mo><mn>4</mn><mo>-</mo><mi>x</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>)</mo></msqrt><mi>d</mi><mi>x</mi><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mn>2</mn></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>)</mo><mo>+</mo><mo>(</mo><mn>2</mn><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>A</mi><mo>=</mo><mn>6</mn><msubsup><mo>&#8747;</mo><mn>2</mn><mn>4</mn></msubsup><msqrt><mo>(</mo><mn>4</mn><mo>-</mo><mi>x</mi><mo>)</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>)</mo></msqrt><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mn>3</mn><msubsup><mo>&#8747;</mo><mn>2</mn><mn>4</mn></msubsup><msqrt><mn>1</mn><mo>-</mo><mo>(</mo><mi>x</mi><mo>-</mo><mn>3</mn><msup><mo>)</mo><mn>2</mn></msup></msqrt><mi>d</mi><mi>x</mi></math></p><p><img src=\"assets\\st0109_650b7877f849.png\" style=\"width: 407px; height: 250px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mn>3</mn><mo>&#183;</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>&#183;</mo><msup><mn>1</mn><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>2</mn></mfrac></math>&nbsp;sq. unit</p>"
