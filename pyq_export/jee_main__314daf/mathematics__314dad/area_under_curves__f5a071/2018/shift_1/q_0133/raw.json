  "question": {
    "text": "The area (in sq. units) of the region $\\{x \\in R: x \\geq 0, y \\geq 0, y \\geq x-2$ and $y \\leq \\sqrt{x}\\}$, is",
    "image": null
  },
  "options": [
    {
      "id": "JbC9z",
      "text": "\n$\\frac{13}{3}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VRswC",
      "text": "\n$\\frac{10}{3}$\n",
      "image": null,
      "isCorrect": true
    },
    {
