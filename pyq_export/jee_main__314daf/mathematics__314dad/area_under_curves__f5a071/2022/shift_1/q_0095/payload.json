      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><msqrt><mn>6</mn></msqrt><mo>+</mo><mn>16</mn><msqrt><mn>12</mn></msqrt><mo>-</mo><mn>72</mn></math>",
      "is_correct": true
