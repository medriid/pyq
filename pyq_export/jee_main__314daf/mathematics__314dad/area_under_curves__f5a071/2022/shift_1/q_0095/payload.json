    "text": "The area bounded by the curve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mfenced close=\"|\" open=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>9</mn></mrow></mfenced></math>&nbsp;and the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>3</mn></math>&nbsp;is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><msqrt><mn>6</mn></msqrt><mo>-</mo><mn>16</mn><msqrt><mn>12</mn></msqrt><mo>-</mo><mn>72</mn></math>",
      "is_correct": false
    },
