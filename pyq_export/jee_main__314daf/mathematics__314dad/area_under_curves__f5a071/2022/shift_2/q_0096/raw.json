  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "The area of the region enclosed between the parabolas <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>2</mn><mi>x</mi><mo>-</mo><mn>1</mn></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mi>x</mi><mo>-</mo><mn>3</mn></math> is.",
    "image": null
  },
  "options": [
    {
      "id": "frs7N",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>3</mn></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Zd9z7",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>6</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "FGuBr",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "HwkCp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>4</mn></mfrac></math>",
      "isCorrect": false,
