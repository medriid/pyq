  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mfrac><mrow><mi>x</mi><mo>-</mo><mn>4</mn></mrow><mrow><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfrac></mfenced><mo>=</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>&#8712;</mo><mi>R</mi><mo>-</mo><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mo>-</mo><mn>2</mn></mrow></mfenced></mrow></mfenced></math>, then<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8747;</mo><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mi>d</mi><mi>x</mi></math>&nbsp;is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mi>ln</mi><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mo>-</mo><mn>3</mn><mi>x</mi><mo>+</mo><mi>C</mi><mi>&#160;</mi></math>",
