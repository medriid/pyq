      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>12</mn><mi>ln</mi><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mo>-</mo><mn>3</mn><mi>x</mi><mo>+</mo><mi>C</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mi>ln</mi><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mo>+</mo><mn>3</mn><mi>x</mi><mo>+</mo><mi>C</mi></math>",
