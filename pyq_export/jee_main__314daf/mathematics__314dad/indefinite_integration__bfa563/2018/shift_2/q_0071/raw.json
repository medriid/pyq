  "question": {
    "text": "$$\n\\int \\frac{2 x+5}{\\sqrt{7-6 x-x^2}} d x=A \\sqrt{7-6 x-x^2}+B \\sin ^{-1}\\left(\\frac{x+3}{4}\\right)+C\n$$\n(where $C$ is a constant of integration), then the ordered pair $(A, B)$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "Lfzmm",
      "text": "\n$(-2,-1)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1OrI3",
      "text": "\n$(2,-1)$\n",
      "image": null,
      "isCorrect": false
    },
