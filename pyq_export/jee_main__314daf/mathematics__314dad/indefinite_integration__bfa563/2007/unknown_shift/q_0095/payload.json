  "question": {
    "text": "$\\int \\frac{d x}{\\cos x+\\sqrt{3} \\sin x}$ equals"
  },
  "options": [
    {
      "text": "\n$\\frac{1}{2} \\log \\tan \\left(\\frac{x}{2}+\\frac{\\pi}{12}\\right)+c$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{1}{2} \\log \\tan \\left(\\frac{x}{2}-\\frac{\\pi}{12}\\right)+c$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\log \\tan \\left(\\frac{\\mathrm{x}}{2}+\\frac{\\pi}{12}\\right)+\\mathrm{c}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\log \\tan \\left(\\frac{\\mathrm{x}}{2}-\\frac{\\pi}{12}\\right)+\\mathrm{c}$",
