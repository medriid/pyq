    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi><mo>-</mo><msup><mi>g</mi><mo>&#39;</mo></msup></math>&nbsp;is increasing in&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mn>0</mn><mo>,</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow></mfenced></math>",
      "is_correct": true
