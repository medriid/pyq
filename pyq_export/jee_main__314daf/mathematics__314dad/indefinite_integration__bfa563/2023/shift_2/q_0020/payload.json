  "question": {
    "text": "The integral <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8747;</mo><mfenced><mrow><msup><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mi>x</mi></msup><mo>+</mo><msup><mfenced><mfrac><mn>2</mn><mi>x</mi></mfrac></mfenced><mi>x</mi></msup></mrow></mfenced><msub><mi>log</mi><mn>2</mn></msub><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></math> is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mi>x</mi></msup><mo>+</mo><msup><mfenced><mfrac><mn>2</mn><mi>x</mi></mfrac></mfenced><mi>x</mi></msup><mo>+</mo><mi>C</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mi>x</mi></msup><mo>-</mo><msup><mfenced><mfrac><mn>2</mn><mi>x</mi></mfrac></mfenced><mi>x</mi></msup><mo>+</mo><mi>C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mi>x</mi></msup><msub><mi>log</mi><mn>2</mn></msub><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mo>+</mo><mi>C</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mi>x</mi></msup><msub><mi>log</mi><mn>2</mn></msub><mfenced><mfrac><mn>2</mn><mi>x</mi></mfrac></mfenced><mo>+</mo><mi>C</mi></math>",
      "is_correct": false
