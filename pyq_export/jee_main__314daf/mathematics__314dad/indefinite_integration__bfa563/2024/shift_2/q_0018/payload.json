>3</mn><mn>2</mn></mfrac></msup><mi>x</mi></mrow><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi><msup><mi>cos</mi><mfrac><mn>3</mn><mn>2</mn></mfrac></msup><mi>x</mi><msqrt><mi>cos</mi><mi>θ</mi><mo>-</mo><mi>cot</mi><mi>x</mi><mi>sin</mi><mi>θ</mi></msqrt></mrow></mfrac><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>I</mi><mo>=</mo><mo>∫</mo><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi><msqrt><mi>tan</mi><mi>x</mi><mi>cos</mi><mi>θ</mi><mo>-</mo><mi>sin</mi><mi>θ</mi></msqrt></mrow></mfrac><mi>d</mi><mi>x</mi><mo>+</mo><mo>∫</mo><mfrac><mn>1</mn><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi><msqrt><mi>cos</mi><mi>θ</mi><mo>-</mo><mi>cot</mi><mi>x</mi><mi>sin</mi><mi>θ</mi></msqrt></mrow></mfrac><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>I</mi><mo>=</mo><mo>∫</mo><mfrac><mrow><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi></mrow><msqrt><mi>tan</mi><mi>x</mi><mi>cos</mi><mi>θ</mi><mo>-</mo><mi>sin</mi><mi>θ</mi></msqrt></mfrac><mi>d</mi><mi>x</mi><mo>+</mo><mo>∫</mo><mfrac><mrow><msup><mo>cosec</mo><mn>2</mn></msup><mi>x</mi></mrow><msqrt><mi>cos</mi><mi>θ</mi><mo>-</mo><mi>cot</mi><mi>x</mi><mi>sin</mi><mi>θ</mi></msqrt></mfrac><mi>d</mi><mi>x</mi></math></p><p>So, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><msub><mi>I</mi><mn>2</mn></msub><mo> </mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced close=\"}\" open=\"{\"><mi>let</mi></mfenced></math></p><p>For <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub></math>, let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>x</mi><mi>cos</mi><mi>θ</mi><mo>-</mo><mi>sin</mi><mi>θ</mi><mo>=</mo><msup><mi>t</mi><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>cos</mi><mi>θ</mi><mo>×</mo><msup><mi>sec</mi><mn>2</mn></msup>