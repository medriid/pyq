  "question": {
    "text": "$\\int \\frac{d x}{\\cos x-\\sin x}$ is equal to"
  },
  "options": [
    {
      "text": "\n$\\frac{1}{\\sqrt{2}} \\log \\left|\\tan \\left(\\frac{x}{2}-\\frac{\\pi}{8}\\right)\\right|+C$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{\\sqrt{2}} \\log \\left|\\cot \\left(\\frac{x}{2}\\right)\\right|+C$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{\\sqrt{2}} \\log \\left|\\tan \\left(\\frac{x}{2}-\\frac{3 \\pi}{8}\\right)\\right|+C$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{1}{\\sqrt{2}} \\log \\left|\\tan \\left(\\frac{x}{2}+\\frac{3 \\pi}{8}\\right)\\right|+C$",
      "is_correct": true
