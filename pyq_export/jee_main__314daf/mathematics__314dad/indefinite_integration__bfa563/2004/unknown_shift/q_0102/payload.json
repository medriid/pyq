  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\int \\frac{d x}{\\cos x-\\sin x}=\\frac{1}{\\sqrt{2}} \\int \\frac{1}{\\cos \\left(x+\\frac{\\pi}{4}\\right)} d x=\\frac{1}{\\sqrt{2}} \\int \\sec \\left(x+\\frac{\\pi}{4}\\right) d x=\\frac{1}{\\sqrt{2}} \\log \\left|\\tan \\left(\\frac{x}{2}+\\frac{3 \\pi}{8}\\right)\\right|+C$"
  }
