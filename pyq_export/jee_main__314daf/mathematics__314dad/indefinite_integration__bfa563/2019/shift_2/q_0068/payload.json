  "solution": {
    "text": "We have,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mn>5</mn><msup><mi>x</mi><mn>8</mn></msup><mo>+</mo><mn>7</mn><msup><mi>x</mi><mn>6</mn></msup></mrow><msup><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mn>2</mn><msup><mi>x</mi><mn>7</mn></msup></mrow></mfenced><mn>2</mn></msup></mfrac><mi>&#160;</mi><mi>d</mi><mi>x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mn>5</mn><msup><mi>x</mi><mn>8</mn></msup><mo>+</mo><mn>7</mn><msup><mi>x</mi><mn>6</mn></msup></mrow><mrow><msup><mi>x</mi><mn>14</mn></msup><msup><mfenced separators=\"|\"><mrow><mfrac><mn>1</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>7</mn></msup></mfrac><mo>+</mo><mn>2</mn></mrow></mfenced><mn>2</mn></msup></mrow></mfrac><mi>d</mi><mi>x</mi></math><br /><br /><math><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>6</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>7</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>8</mn></mrow></msup></mrow></mfrac></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>5</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>7</mn></mrow></msup></mrow></mfrac><mo>+</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><br />Put,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>7</mn></msup></mfrac><mo>+</mo><mn>2</mn><mo>=</mo><mi>t</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mn>5</mn><msup><mi>x</mi><mn>6</mn></msup></mfrac><mo>-</mo><mfrac><mn>7</mn><msup><mi>x</mi><mn>8</mn></msup></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>-</mo><mo>&#8747;</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><msup><mi>t</mi><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mn>1</mn><mi>t</mi></mfrac><mo>+</mo><mi>c</mi></math>, where&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>&nbsp;is the constant of integration.<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><msup><mi>x</mi><mn>7</mn></msup><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo>+</mo><mn>2</mn><msup><mi>x</mi><mn>7</mn></msup></mrow></mfrac><mo>+</mo><mi>c</mi></math><br /><br />Now,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#160;</mi><mi>f</mi><mfenced separators=\"|\"><mn>0</mn></mfenced><mo>=</mo><mn>0</mn></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mi>c</mi><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>f</mi><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mo>+</mo><msup><mrow><mn>2.1</mn></mrow><mrow><mn>7</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></math>"
