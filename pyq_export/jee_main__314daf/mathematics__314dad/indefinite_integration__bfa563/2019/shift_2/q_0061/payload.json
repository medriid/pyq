  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8747;</mo><msup><mi>x</mi><mn>5</mn></msup><msup><mi>e</mi><mrow><mo>-</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><mn>48</mn></mfrac><msup><mi>e</mi><mrow><mo>-</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup></mrow></msup><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>+</mo><mi>C</mi></math>, where <math><mi>C</mi></math> is a constant of integration, then <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>1</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mo>-</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mo>-</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><mn>1</mn></math>",
