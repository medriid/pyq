    "text": "Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mn>2</mn><msup><mi>x</mi><mn>12</mn></msup><mo>+</mo><mn>5</mn><msup><mi>x</mi><mn>9</mn></msup></mrow><msup><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>5</mn></msup><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mn>3</mn></msup></mfrac><mi>d</mi><mi>x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi>x</mi><mn>12</mn></msup><mo>+</mo><mn>5</mn><msup><mi>x</mi><mn>9</mn></msup></mrow></mfenced><mi>d</mi><mi>x</mi></mrow><mrow><msup><mi>x</mi><mn>15</mn></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac></mrow></mfenced><mn>3</mn></msup></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mfrac><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac><mo>+</mo><mfrac><mn>5</mn><msup><mi>x</mi><mn>6</mn></msup></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi></mrow><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac></mrow></mfenced><mn>3</mn></msup></mfrac></math><br /><br />Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac><mo>=</mo><mi>t</mi></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac><mo>-</mo><mfrac><mn>5</mn><msup><mi>x</mi><mn>6</mn></msup></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mfrac><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac><mo>+</mo><mfrac><mn>5</mn><msup><mi>x</mi><mn>6</mn></msup></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mo>-</mo><mi>d</mi><mi>t</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mo>-</mo><mo>&#8747;</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><msup><mi>t</mi><mn>3</mn></msup></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>&#160;</mi><mo>.</mo><mi>&#160;</mi><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfrac><mn>1</mn><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>5</mn></msup></mfrac></mrow></mfenced><mn>2</mn></msup></mfrac><mo>+</mo><mi>c</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfrac><msup><mi>x</mi><mn>10</mn></msup><msup><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>5</mn></msup><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mfrac><mo>+</mo><mi>c</mi></math><br />Where&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>&nbsp;is the constant of integration.<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><msup><mi>x</mi><mn>10</mn></msup><mrow><mn>2</mn><msup><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>5</mn></msup><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mrow></mfrac><mo>+</mo><mi>c</mi></math>",
