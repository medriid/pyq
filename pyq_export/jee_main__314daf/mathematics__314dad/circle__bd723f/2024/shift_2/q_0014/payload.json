  "question": {
    "text": "Let the circle $C_1: x^2+y^2-2(x+y)+1=0$ and $C_2$ be a circle having centre at $(-1,0)$ and radius 2 . If the line of the common chord of $\\mathrm{C}_1$ and $\\mathrm{C}_2$ intersects the $y$-axis at the point $\\mathrm{P}$, then the square of the distance of $\\mathrm{P}$ from the centre of $\\mathrm{C}_1$ is :"
  },
  "options": [
    {
      "text": "2",
      "is_correct": true
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "4",
      "is_correct": false
    },
    {
      "text": "6",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & S_1: x^2+y^2-2 x-2 y+1=0 \\\\ & S_2: x^2+y^2+2 x-3=0 \\\\ & \\text { Common chord }=S_1-S_2=0 \\\\ & -4 x-2 y+4=0 \\\\ & 2 x+y=2 \\Rightarrow P(0,2) \\\\ & d_{(c, p)}^2=(1-0)^2+(2-1)^2=2\\end{aligned}$"
  }
}