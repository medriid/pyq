  "question": {
    "text": "Four distinct points <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mi mathvariant=\"normal\">k</mi><mo>,</mo><mn>3</mn><mi mathvariant=\"normal\">k</mi><mo>)</mo><mo>,</mo><mo>(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>)</mo><mo>,</mo><mo>(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>)</mo></math> lie on a circle for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math> equal to :",
    "image": null
  },
