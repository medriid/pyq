  "question": {
    "text": "Consider a family of circles which are passing through the point $(-1,1)$ and are tangent to $x-$ axis. If $(h, k)$ are the co-ordinates of the centre of the circles, then the set of values of $k$ is given by the interval",
    "image": null
  },
  "options": [
    {
      "id": "3n7GJ",
      "text": "\n$0 < \\mathrm{k} < 1 / 2$",
      "image": null,
      "isCorrect": false
    },
    {
