  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn.quizrr.in/question-assets/jee_main_pyq/EuZIOp2BhCaOIxnjU8OLkOqyOiUpyTo98WiwyfOnwFY.original.fullsize_2.png\">\r\n$\\begin{aligned} & C_1 C_2=\\sqrt{(2+2)^2+(5-2)^2} \\\\ & =\\sqrt{16+9} \\\\ & =5 \\\\ & r+2>5 \\\\ & r>3 \\\\ & r < 5+2 \\\\ & r < 7 \\\\ & \\therefore \\alpha=3, \\beta=7 \\\\ & 3 \\beta-2 \\alpha=3(7)-2(3)=21-6=15\\end{aligned}$",
    "image": null
