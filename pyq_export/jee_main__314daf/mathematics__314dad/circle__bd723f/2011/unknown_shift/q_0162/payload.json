  "question": {
    "text": "The two circles $x^2+y^2=a x$ and $x^2+y^2=c^2(c>0)$ touch each other if"
  },
  "options": [
    {
      "text": "\n$|a|=c$\n",
      "is_correct": true
    },
    {
      "text": "\n$a=2 c$\n",
      "is_correct": false
    },
    {
      "text": "\n$|a|=2 c$\n",
      "is_correct": false
    },
    {
      "text": "\n$2|a|=c$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{c}_1=\\left(\\frac{\\mathrm{a}}{2}, 0\\right) ; \\mathrm{c}_2=(0,0)$\n$\\mathrm{r}_1=\\frac{\\mathrm{a}}{2} ; \\mathrm{r}_2=\\mathrm{c}$\n$\\mathrm{c}_1 \\mathrm{c}_2=\\mathrm{r}_1-\\mathrm{r}_2 \\Rightarrow \\frac{\\mathrm{a}}{2}=\\mathrm{c}-\\frac{\\mathrm{a}}{2} \\Rightarrow \\mathrm{c}=\\mathrm{a}$"
  }
}