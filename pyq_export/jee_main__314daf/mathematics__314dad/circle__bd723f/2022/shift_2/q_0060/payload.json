    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mfenced><mrow><msqrt><mn>6</mn></msqrt><mo>+</mo><msqrt><mn>3</mn></msqrt></mrow></mfenced><mn>2</mn></mfrac></math>",
