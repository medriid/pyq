  "question": {
    "text": "The circle $x^2+y^2=4 x+8 y+5$ intersects the line $3 x-4 y=m$ at two distinct points if",
    "image": null
  },
  "options": [
    {
      "id": "a6Z6P",
      "text": "\n$-35 < m < 15$",
      "image": null,
      "isCorrect": true
    },
    {
