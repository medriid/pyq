  "question": {
    "text": "If the lines $2 x+3 y+1=0$ and $3 x-y-4=0$ lie along diameters of a circle of circumference $10 \\pi$, then the equation of the circle is",
    "image": null
  },
  "options": [
    {
      "id": "SCLo9",
      "text": "\n$x^2+y^2-2 x+2 y-23=0$\n",
