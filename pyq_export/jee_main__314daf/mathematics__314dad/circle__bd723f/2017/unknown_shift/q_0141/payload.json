  "solution": {
    "text": "Given circle&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>-</mo><mn>5</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mn>5</mn><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mfrac><mn>5</mn><mn>2</mn></mfrac></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced separators=\"|\"><mrow><mi>y</mi><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math><br />On circle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mo>=</mo><mrow><mo>(</mo><mfrac><mn>5</mn><mn>2</mn></mfrac><mo>+</mo><msqrt><mfrac><mn>3</mn><mn>2</mn></mfrac></msqrt><mi>cos</mi><mi>&#952;</mi><mo>,</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><msqrt><mfrac><mn>3</mn><mn>2</mn></mfrac></msqrt><mi>sin</mi><mi>&#952;</mi><mo>)</mo></mrow></math><br /><br /><math><mi>P</mi><msup><mrow><mi>Q</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;&#8203;</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><msqrt><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;&#8203;</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><msup><mi>Q</mi><mn>2</mn></msup><mo>=</mo><mfrac><mn>25</mn><mn>2</mn></mfrac><mo>+</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>+</mo><mn>5</mn><msqrt><mfrac><mn>3</mn><mn>2</mn></mfrac></msqrt><mfenced separators=\"|\"><mrow><mi>cos</mi><mi>&#952;&#8203;</mi><mo>+</mo><mi>sin</mi><mi>&#952;&#8203;</mi></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>14</mn><mo>+</mo><mn>5</mn><msqrt><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;&#8203;</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;&#8203;</mi></mrow></mrow></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo></math>Maximum value of <math><msup><mrow><mfenced separators=\"|\"><mrow><mi>P</mi><mi>Q</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>14</mn><mo>+</mo><mn>5</mn><msqrt><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn></msqrt></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>14</mn><mo>+</mo><mn>5</mn><msqrt><mn>3</mn></msqrt></math>."
