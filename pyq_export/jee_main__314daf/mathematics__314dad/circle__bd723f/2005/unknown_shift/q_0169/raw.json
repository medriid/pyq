  "question": {
    "text": "If the pair of lines $a x^2+2(a+b) x y+b y^2=0$ lie along diameters of a circle and divide the circle into four sectors such that the area of one of the sectors is thrice the area of another sector then",
    "image": null
  },
  "options": [
    {
      "id": "HJlVH",
      "text": "\n$3 a^2-10 a b+3 b^2=0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FJJZe",
      "text": "\n$3 a^2-2 a b+3 b^2=0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "IrZbU",
      "text": "\n$3 a^2+10 a b+3 b^2=0$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nj0Mx",
      "text": "\n$3 a^2+2 a b+3 b^2=0$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\left|\\frac{2 \\sqrt{(a+b)^2-a b}}{a+b}\\right|=1 \\\\\n& \\Rightarrow(a+b)^2=4\\left(a^2+b^2+a b\\right) \\\\\n& \\Rightarrow 3 a^2+3 b^2+2 a b=0 .\n\\end{aligned}\n$$",
    "image": null
  },
