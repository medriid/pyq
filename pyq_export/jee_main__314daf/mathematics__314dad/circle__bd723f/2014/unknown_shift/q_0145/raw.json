    {
      "id": "iQI19",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><msup><mo>&#8289;</mo><mn>2</mn></msup><mo>+</mo><mi>y</mi><msup><mo>&#8289;</mo><mn>2</mn></msup><mo>+</mo><mn>3</mn><mi>x</mi><mo>&#8289;</mo><mo>+</mo><mi>y</mi><mo>&#8289;</mo><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math>",
