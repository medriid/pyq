  "question": {
    "text": "The length of the diameter of the circle which touches the $x$-axis at the point $(1,0)$ and passes through the point $(2,3)$ is"
  },
  "options": [
    {
      "text": "\n$\\frac{10}{3}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{3}{5}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{6}{5}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{5}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Let $(h, k)$ be centre.\n$\\begin{array}{ll}\n(h-1)^2+(k-0)^2=k^2 & \\Rightarrow h=1 \\\\\n(h-2)^2+(k-3)^2=k^2 & \\Rightarrow k=\\frac{5}{3}\n\\end{array}$\n$\\therefore$ diameter is $2 \\mathrm{k}=\\frac{10}{3}$\n<img src=\"assets\\st0161_c96c3154c0fa.png\"><br>"
  }
}