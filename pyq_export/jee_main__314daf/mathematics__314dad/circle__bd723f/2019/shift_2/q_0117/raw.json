    {
      "id": "Mv9Ay",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msqrt><mn>1</mn><mo>+</mo><mn>2</mn><mi>x</mi></msqrt><mo>,</mo><mo>&#160;</mo><mi>x</mi><mo>&#8805;</mo><mn>0</mn></math>",
