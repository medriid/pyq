  "solution": {
    "text": "<blockquote><p>We have,</p><p><img src=\"assets\\st0126_601d928bf31b.png\" style=\"width: 444px; height: 250px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mi>M</mi><mo>=</mo><mi>P</mi><mi>N</mi><mo>=</mo><msqrt><msup><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><msup><mfenced separators=\"|\"><mrow><mi>b</mi><mo>-</mo><mi>a</mi></mrow></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><mn>2</mn><msqrt><mi>a</mi><mi>b</mi></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi><mi>Q</mi><mo>=</mo><mi>M</mi><mi>S</mi><mo>=</mo><msqrt><msup><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>c</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><msup><mfenced separators=\"|\"><mrow><mi>c</mi><mo>-</mo><mi>a</mi></mrow></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><mn>2</mn><msqrt><mi>a</mi><mi>c</mi></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mi>Q</mi><mo>=</mo><mi>S</mi><mi>T</mi><mo>=</mo><msqrt><msup><mfenced separators=\"|\"><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><msup><mfenced separators=\"|\"><mrow><mi>c</mi><mo>-</mo><mi>b</mi></mrow></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><mn>2</mn><msqrt><mi>b</mi><mi>c</mi></msqrt></math><br /><br /><math><mo>&#8757;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mi>Q</mi><mo>=</mo><mi>P</mi><mi>N</mi><mo>+</mo><mi>N</mi><mi>Q</mi></math><br /><br /><math><mo>&#8658;</mo><mn>2</mn><msqrt><mi>b</mi><mi>c</mi></msqrt><mo>=</mo><mn>2</mn><msqrt><mi>a</mi><mi>b</mi></msqrt><mo>+</mo><mn>2</mn><msqrt><mi>a</mi><mi>c</mi></msqrt></math><br /><br /><math><mo>&#8658;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mi>a</mi></msqrt></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mi>b</mi></msqrt></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mi>c</mi></msqrt></mrow></mfrac></math></p><p><img src=\"assets\\st0126_b9ffff893864.png\" style=\"width: 370px; height: 280px;\" /></p></blockquote>"
