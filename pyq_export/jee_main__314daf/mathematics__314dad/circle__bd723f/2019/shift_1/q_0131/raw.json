  "question": {
    "text": "A square is inscribed in the circle $x^{2}+y^{2}-6 x+8 y-103=0$ with its sides parallel to the coordinate axes. Then the distance of the vertex of this square which is nearest to the origin is:",
    "image": null
  },
  "options": [
    {
      "id": "VY17N",
      "text": "6",
      "isCorrect": false,
      "image": null
