  "solution": {
    "text": "<math><mi>x</mi><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>y</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced><mi>d</mi><mi>t</mi></mrow></mrow><mo>=</mo><mi>x</mi><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mi>d</mi><mi>t</mi><mo>+</mo><mi>&#160;</mi><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mi>d</mi><mi>t</mi></math><br /><br />Differentiate w.r.t. <math><mi>x</mi></math><br /><br /><math><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi><mo>+</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi><mo>+</mo><mi>x</mi><mo>[</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>]</mo><mo>+</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></math><br /><br /><math><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi></mrow></mrow><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mi>&#160;</mi></mrow></mrow></math><br /><br />Differentiate again w.r.t. <math><mi>x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>+</mo><mn>2</mn><mi>x</mi><mi>&#160;</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mo>&#39;</mo></msup><mo>(</mo><mi>x</mi><mo>)</mo><mi>&#160;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mi>x</mi></mrow></mfenced><mi>y</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mo>&#39;</mo></msup><mfenced separators=\"|\"><mi>x</mi></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi>y</mi><mo>&#39;</mo></msup><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow><mrow><mi>y</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mi>x</mi></mrow><msup><mi>x</mi><mn>2</mn></msup></mfrac></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>y</mi></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mi>x</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />Integrating on both sides<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>ln</mi><mi>y</mi><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mi>x</mi></mfrac><mo>-</mo><mn>3</mn><mi>ln</mi><mi>x</mi><mo>+</mo><mi>C</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>ln</mi><mo>(</mo><mi>y</mi><msup><mi>x</mi><mn>3</mn></msup><mo>)</mo><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mi>x</mi></mfrac><mo>+</mo><mi>C</mi></math><br /><br /><math xmlns=\"http:/