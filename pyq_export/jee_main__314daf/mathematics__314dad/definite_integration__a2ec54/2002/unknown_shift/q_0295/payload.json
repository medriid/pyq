    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\int_1^0\\left[x^2\\right] d x+\\int_1^{\\sqrt{2}}\\left[x^2\\right] d x=0+\\int_1^{\\sqrt{2}} d x=\\sqrt{2}-1$"
  }
