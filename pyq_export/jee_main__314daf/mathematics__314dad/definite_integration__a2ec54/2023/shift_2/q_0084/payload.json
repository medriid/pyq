    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>2</mn></math>",
