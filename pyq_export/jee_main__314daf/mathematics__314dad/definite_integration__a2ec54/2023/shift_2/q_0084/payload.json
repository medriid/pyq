  "question": {
    "text": "The value of the integral&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mo>&#8747;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mn>2</mn></msubsup><mfrac><mrow><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow><mi>x</mi></mfrac><mi>d</mi><mi>x</mi></math>&nbsp; &nbsp;is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#960;</mi><mo>&#160;</mo><msub><mi>log</mi><mi>e</mi></msub><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#960;</mi><mn>4</mn></mfrac><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>2</mn></math>",
      "is_correct": false
