  "question": {
    "text": "<p>If&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mo>&#8747;</mo><mrow><mo>-</mo><mn>0</mn><mo>.</mo><mn>15</mn></mrow><mrow><mn>0</mn><mo>.</mo><mn>15</mn></mrow></msubsup><mfenced close=\"|\" open=\"|\"><mrow><mn>100</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mi>k</mi><mn>3000</mn></mfrac><mo>,</mo></math>&nbsp;then&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math>&nbsp;is equal to _____.</p>",
    "image": null
  },
