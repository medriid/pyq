  "question": {
    "text": "The value of $\\int_{-\\pi}^\\pi \\frac{\\cos ^2 x}{1+a^x} d x, a>0$, is"
  },
  "options": [
    {
      "text": "\n$a \\pi$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\pi}{2}$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{\\pi}{a}$\n",
      "is_correct": false
    },
    {
      "text": "\n$2 \\pi$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\int_{-\\pi}^\\pi \\frac{\\cos ^2 x}{1+a^x} d x=\\int_0^\\pi \\cos ^2 x d x=\\frac{\\pi}{2} .\n$$"
  }
