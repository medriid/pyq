  "question": {
    "text": "The value of the integral $\\int_0^{0.9}[x-2[x]] d x$, where [.] denotes the greatest integer function is"
  },
  "options": [
    {
      "text": "\n$0.9$\n",
      "is_correct": false
    },
    {
      "text": "\n$1.8$\n",
      "is_correct": false
    },
    {
      "text": "\n$-0.9$\n",
      "is_correct": false
    },
    {
      "text": "\n0",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Since $\\int_0^a[x]=0$ where $0 \\leq a \\leq 1$\n$$\n\\therefore \\int_0^{0.9}[x-2[x]] d x=0\n$$"
  }
}