  "question": {
    "text": "The value of the integral $\\int_0^{0.9}[x-2[x]] d x$, where [.] denotes the greatest integer function is",
    "image": null
  },
  "options": [
    {
      "id": "ER8Zq",
      "text": "\n$0.9$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ND798",
      "text": "\n$1.8$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LaRLj",
      "text": "\n$-0.9$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mdn0D",
      "text": "\n0",
