  "question": {
    "text": "Let $F(x)=f(x)+f\\left(\\frac{1}{x}\\right)$, where $f(x)=\\int_1^x \\frac{\\log t}{1+t} d t$. Then $F(e)$ equals",
    "image": null
  },
  "options": [
    {
      "id": "t2aH3",
      "text": "\n$\\frac{1}{2}$\n",
      "image": null,
      "isCorrect": true
