  "question": {
    "text": "Let $p(x)$ be a function defined on $R$ such that $p^{\\prime}(x)=p^{\\prime}(1-x)$, for all $x \\in[0,1], p(0)=1$ and $p(1)=41$. Then $\\int_0^1 p(x) d x$ equals",
    "image": null
  },
  "options": [
    {
      "id": "JgkE8",
      "text": "\n21\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ikVKo",
      "text": "\n41\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2EzKv",
      "text": "\n42\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ufq6c",
      "text": "\n$\\sqrt{41}$",
      "image": null,
      "isCorrect": false
    }
