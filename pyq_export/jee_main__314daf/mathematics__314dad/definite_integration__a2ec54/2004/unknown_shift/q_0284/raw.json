  "question": {
    "text": "If $\\int_0^\\pi x f(\\sin x) d x=A \\int_0^{\\pi / 2} f(\\sin x) d x$, then $A$ is",
    "image": null
  },
  "options": [
    {
      "id": "pwsAr",
      "text": "\n0\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Myncf",
      "text": "\n$\\pi$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "xshBI",
      "text": "\n$\\frac{\\pi}{4}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v47dd",
      "text": "\n$2 \\pi$",
      "image": null,
      "isCorrect": false
