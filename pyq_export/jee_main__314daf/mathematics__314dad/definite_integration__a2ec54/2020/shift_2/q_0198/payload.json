  "question": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mrow><msubsup><mo stretchy=\"true\">&#8747;</mo><mn>0</mn><mi>x</mi></msubsup><mi>t</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mn>10</mn><mi>t</mi></mrow></mfenced><mi>d</mi><mi>t</mi></mrow><mi>x</mi></mfrac></math>, is equal to"
  },
  "options": [
