  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>k</mi><mn>6</mn></mfrac><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mfrac><msup><mi>x</mi><mn>2</mn></msup><mstyle displaystyle=\"true\"><msup><mfenced><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mfrac><mn>3</mn><mn>2</mn></mfrac></msup></mstyle></mfrac><mi>d</mi><mi>x</mi></math></p><p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mi>sin</mi><mi>&#952;</mi><mo>&#8658;</mo><mi>d</mi><mi>x</mi><mo>=</mo><mi>cos</mi><mi>&#952;</mi><mi>d</mi><mi>&#952;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mi>k</mi><mn>6</mn></mfrac><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></msubsup><mfrac><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo>&#160;</mo><mi>&#952;</mi></mrow><msup><mfenced><mrow><mn>1</mn><mo>-</mo><msup><mi>sin</mi><mn>2</mn></msup><mo>&#160;</mo><mi>&#952;</mi></mrow></mfenced><mstyle displaystyle=\"true\"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle></msup></mfrac><mi>cos</mi><mi>&#952;</mi><mi>d</mi><mi>&#952;</mi><mo>&#8658;</mo><mfrac><mi>k</mi><mn>6</mn></mfrac><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></msubsup><mfrac><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo>&#160;</mo><mi>&#952;</mi></mrow><mfenced><mrow><msup><mi>cos</mi><mn>3</mn></msup><mo>&#160;</mo><mi>&#952;</mi></mrow></mfenced></mfrac><mi>cos</mi><mi>&#952;</mi><mi>d</mi><mi>&#952;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mi>k</mi><mn>6</mn></mfrac><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></msubsup><msup><mi>tan</mi><mn>2</mn></msup><mi>&#952;</mi><mi>d</mi><mi>&#952;</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></msubsup><mfenced><mrow><mi>s