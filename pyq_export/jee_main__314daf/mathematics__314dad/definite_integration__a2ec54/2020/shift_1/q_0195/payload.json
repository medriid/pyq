bsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>i</mi><mi>i</mi><mi>i</mi></mrow></mfenced><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mfenced><mrow><mi>i</mi><mi>v</mi></mrow></mfenced><mo>&#160;</mo></math>we get,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>I</mi><mo>=</mo><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi><msubsup><mo>&#8747;</mo><mn>0</mn><mrow><mi mathvariant=\"normal\">&#960;</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mn>1</mn><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mn>2</mn><mi>&#960;</mi><msubsup><mfenced close=\"]\" open=\"[\"><mi>x</mi></mfenced><mn>0</mn><mrow><mi mathvariant=\"normal\">&#960;</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></math></p>"
