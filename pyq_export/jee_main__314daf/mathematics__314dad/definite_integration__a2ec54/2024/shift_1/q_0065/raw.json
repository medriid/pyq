    "text": "<p>Given:</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>∫</mo><mfrac><mrow><mi>cosec</mi><mi>x</mi><mo>+</mo><mi>sin</mi><mi>x</mi></mrow><mrow><mi>cosec</mi><mi>x</mi><mi>sec</mi><mi>x</mi><mo>+</mo><mi>tan</mi><mi>x</mi><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow></mfrac><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>∫</mo><mfrac><mrow><mstyle displaystyle=\"true\"><mfrac><mn>1</mn><mrow><mi>sin</mi><mi>x</mi></mrow></mfrac></mstyle><mo>+</mo><mi>sin</mi><mi>x</mi></mrow><mrow><mstyle displaystyle=\"true\"><mfrac><mn>1</mn><mrow><mi>sin</mi><mi>x</mi><mi>cos</mi><mi>x</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><mrow><mi>sin</mi><mi>x</mi></mrow><mrow><mi>cos</mi><mi>x</mi></mrow></mfrac></mstyle><mfenced><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced></mrow></mfrac><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>∫</mo><mfrac><mstyle displaystyle=\"true\"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow><mrow><mi>sin</mi><mi>x</mi></mrow></mfrac></mstyle><mstyle displaystyle=\"true\"><mfrac><mrow><mn>1</mn><mo>+</mo><msup><mi>sin</mi><mn>4</mn></msup><mi>x</mi></mrow><mrow><mi>sin</mi><mi>x</mi><mi>cos</mi><mi>x</mi></mrow></mfrac></mstyle></mfrac><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mo>∫</mo><mfrac><mstyle displaystyle=\"true\"><mfenced><mrow><mn>1</mn><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mi>cos</mi><mi>x</mi></mstyle><mstyle displaystyle=\"true\"><mn>1</mn><mo>+</mo><msup><mi>sin</mi><mn>4</mn></msup><mi>x</mi></mstyle></mfrac><mi>d</mi><mi>x</mi></math>