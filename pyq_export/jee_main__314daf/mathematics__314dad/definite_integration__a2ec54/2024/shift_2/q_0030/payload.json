  "question": {
    "text": "Let $\\beta(\\mathrm{m}, \\mathrm{n})=\\int_0^1 x^{\\mathrm{m}-1}(1-x)^{\\mathrm{n}-1} \\mathrm{~d} x, \\mathrm{~m}, \\mathrm{n}>0$. If $\\int_0^1\\left(1-x^{10}\\right)^{20} \\mathrm{~d} x=\\mathrm{a} \\times \\beta(\\mathrm{b}, \\mathrm{c})$, then $100(\\mathrm{a}+\\mathrm{b}+\\mathrm{c})$ equals____"
  },
  "options": [
    {
      "text": "1021",
      "is_correct": false
    },
    {
      "text": "2120",
      "is_correct": true
    },
    {
      "text": "2012",
      "is_correct": false
    },
    {
      "text": "1120",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$I=\\int_0^1 1 \\cdot\\left(1-x^{10}\\right)^{20} d x$\n$x^{10}=t$\n$x=t^{1 / 10}$\n$d x=\\frac{1}{10}(t)^{-9 / 10} d t$\n$I=\\int_0^1(1-t)^{20} \\frac{1}{10}(t)^{-9 / 10} d t$\n$I=\\frac{1}{10} \\int_0^1 t^{-9 / 10}(1-t)^{20} d t$\n$a=\\frac{1}{10} \\quad b=\\frac{1}{10} \\quad c=21$"
  }
