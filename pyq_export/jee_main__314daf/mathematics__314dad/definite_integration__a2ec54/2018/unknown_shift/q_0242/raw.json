    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mi>&#160;</mi><munderover><mo>&#8747;</mo><mrow><mo>-</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></munderover><mfrac><mrow><msup><mi>sin</mi><mn>2</mn></msup><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mn>2</mn><mi>x</mi></msup></mrow></mfrac><mi>&#160;</mi><mi>d</mi><mi>x</mi><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>(</mo><mi mathvariant=\"normal\">i</mi><mo>)</mo></math><br /><br />As <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8747;</mo><mi>a</mi><mi>b</mi></munderover><mrow><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo><mi>d</mi><mi>x</mi></mrow><mo>=</mo><munderover><mo>&#8747;</mo><mi>a</mi><mi>b</mi></munderover><mrow><mi>f</mi><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>&#8722;</mo><mi>x</mi><mo>)</mo></mrow><mi>d</mi><mi>x</mi></math><br /><br /><math><mi>I</mi><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mo>-</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></munderover><mrow><mfrac><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mi>x</mi></mrow></mfenced></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mn>2</mn></mrow><mrow><mo>-</mo><mi>x</mi></mrow></msup></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mi>&#160;</mi><munderover><mo>&#8747;</mo><mrow><mo>-</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></munderover><mfrac><mrow><msup><mn>2</mn><mi>x</mi></msup><msup><mi>sin</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mn