  "question": {
    "text": "Let $\\mathrm{I}=\\int_0^1 \\frac{\\sin \\mathrm{x}}{\\sqrt{\\mathrm{x}}} \\mathrm{dx}$ and $\\mathrm{J}=\\int_0^1 \\frac{\\cos \\mathrm{x}}{\\sqrt{\\mathrm{x}}} \\mathrm{dx}$. Then which one of the following is true?"
  },
  "options": [
    {
      "text": "\n$\\mathrm{I}>\\frac{2}{3}$ and $\\mathrm{J}>2$\n",
      "is_correct": false
    },
    {
      "text": "\n$I < \\frac{2}{3}$ and $J < 2$",
      "is_correct": true
    },
    {
      "text": "\n$\\mathrm{I} < \\frac{2}{3}$ and $\\mathrm{J}>2$",
      "is_correct": false
    },
    {
      "text": "\n$I>\\frac{2}{3}$ and $\\mathrm{J} < 2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\mathrm{I}=\\int_0^1 \\frac{\\sin x}{\\sqrt{x}} \\mathrm{dx} < \\int_0^1 \\frac{\\mathrm{x}}{\\sqrt{\\mathrm{x}}} \\mathrm{dx}=\\int_0^1 \\sqrt{\\mathrm{x}} \\mathrm{dx}=\\left.\\frac{2}{3} \\mathrm{x}^{3 / 2}\\right|_0 ^1=\\frac{2}{3} \\\\\n& \\Rightarrow \\mathrm{I} < \\frac{2}{3} \\\\\n& \\mathrm{~J}=\\int_0^1 \\frac{\\cos x}{\\sqrt{\\mathrm{x}}} \\mathrm{dx} < \\int_0^1 \\frac{1}{\\sqrt{\\mathrm{x}}} \\mathrm{dx}=\\left.2 \\sqrt{\\mathrm{x}}\\right|_0 ^1=2 \\\\\n& \\therefore \\mathrm{J} \\leq 2 .\n\\end{aligned}\n$$"
  }
}