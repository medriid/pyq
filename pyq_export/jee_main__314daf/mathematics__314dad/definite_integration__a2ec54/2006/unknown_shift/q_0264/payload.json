  "question": {
    "text": "$\\int_0^\\pi x f(\\sin x) d x$ is equal to"
  },
  "options": [
    {
      "text": "\n$\\pi \\int_0^\\pi f(\\cos x) d x$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\pi \\int_0^\\pi f(\\sin x) d x$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\pi}{2} \\int_0^{\\pi / 2} f(\\sin x) d x$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\pi \\int_0^{\\pi / 2} f(\\cos x) d x$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$I=\\int_0^\\pi x f(\\sin x) d x=\\int_0^\\pi(\\pi-x) f(\\sin x) d x$\n$=\\pi \\int_0^\\pi f(\\sin x) d x-1$\n$2 I=\\pi \\int_0^\\pi f(\\sin x) d x$\n$I=\\frac{\\pi}{2} \\int_0^\\pi f(\\sin x) d x=\\pi \\int_0^{\\pi / 2} f(\\sin x) d x$\n$=\\pi \\int_0^{\\pi / 2} f(\\cos x) d x$"
  }
}