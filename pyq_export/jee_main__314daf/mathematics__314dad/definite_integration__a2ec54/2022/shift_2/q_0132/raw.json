  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mo>:</mo><mi mathvariant=\"bold-italic\">R</mi><mo>&#8594;</mo><mi mathvariant=\"bold-italic\">R</mi></math>&nbsp;be continuous function satisfying <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>+</mo><mi>f</mi><mfenced><mrow><mi>x</mi><mo>+</mo><mi>k</mi></mrow></mfenced><mo>=</mo><mi>n</mi></math>, for all <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mi mathvariant=\"bold-italic\">R</mi></math>&nbsp;where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>&#62;</mo><mn>0</mn></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>&nbsp;is a positive integer. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mrow><mn>4</mn><mi>n</mi><mi>k</mi></mrow></msubsup><mi>f</mi><mfenced><mi>x</mi></mfenced><mi>d</mi><mi>x</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><msubsup><mo>&#8747;</mo><mrow><mo>-</mo><mi>k</mi></mrow><mrow><mn>3</mn><mi>k</mi></mrow></msubsup><mi>f</mi><mfenced><mi>x</mi></mfenced><mi>d</mi><mi>x</mi></math>, then",
    "image": null
  },
  "options": [
    {
      "id": "UndKj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><mn>2</mn><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mn>4</mn><mi>n</mi><mi>k</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "cfe3y",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><mn>2</mn><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn><mi>n</mi><mi>k</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "pnQH6",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><mi>n</mi><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mn>4</mn><msup><mi>n</mi><mn>2</mn></msup><mo>&#160;</mo><mi>K</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "82lDk",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><mi>n</mi><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mn>6</mn><msup><mi>n</mi><mn>2</mn></msup><mi>k</mi></math>",
      "isCorrect": false,
