    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>17</mn></msqrt><mo>-</mo><mn>13</mn></mrow><mn>8</mn></mfrac></math>",
