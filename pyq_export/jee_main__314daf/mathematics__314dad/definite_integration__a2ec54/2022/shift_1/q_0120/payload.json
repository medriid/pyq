  ],
  "solution": {
    "text": "<p>The graph of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mo>-</mo><mn>8</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><mi>x</mi><mo>-</mo><mn>1</mn></math>&nbsp;will be as shown&nbsp;</p><p><img src=\"assets\\st0120_95e1e8a60d68.png\" style=\"width: 250px; height: 209px;\" /></p><p>Now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mfenced close=\"]\" open=\"[\"><mrow><mo>-</mo><mn>8</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi><mi>x</mi></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mfrac><mn>1</mn><mn>4</mn></mfrac></msubsup><mfenced><mrow><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi><mi>x</mi><mo>+</mo><msubsup><mo>&#8747;</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mfrac><mn>1</mn><mn>2</mn></mfrac></msubsup><mfenced><mn>0</mn></mfenced><mi>d</mi><mi>x</mi><mo>+</mo><msubsup><mo>&#8747;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfrac><mn>3</mn><mn>4</mn></mfrac></msubsup><mfenced><mrow><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>+</mo><msubsup><mo>&#8747;</mo><mfrac><mn>3</mn><mn>4</mn></mfrac><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac></msubsup><mfenced><mrow><mo>-</mo><mn>2</mn></mrow></mfenced><mi>d</mi><mi>x</mi><mo>+</mo><msubsup><mo>&#8747;</mo><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac><mn>1</mn></msubsup><mfenced><mrow><mo>-</mo><mn>3</mn></mrow></mfenced><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><msubsup><mfenced close=\"]\" open=\"[\"><mi>x</mi></mfenced><mn>0</mn><mfrac><mn>1</mn><mn>4</mn></mfrac></msubsup><mo>+</mo><mn>0</mn><mo>-</mo><msubsup><mfenced close=\"]\" open=\"[\"><mi>x</mi></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac><mfrac><mn>3</mn><mn>4</mn></mfrac></msubsup><mo>+</mo><mo>-</mo><mn>2</mn><msubsup><mfenced close=\"]\" open=\"[\"><mi>x</mi></mfenced><mfrac><mn>3</mn><mn>4</mn></mfrac><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac></msubsup><mo>-</mo><mn>3</mn><msubsup><mfenced close=\"]\" open=\"[\"><mi>x</mi></mfenced><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac><mn>1</mn></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><mfenced><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>-</mo><mn>0</mn></mrow></mfenced><mo>-</mo><mfenced><mrow><mfrac><mn>3</mn><mn>4</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced><mo>-</mo><mn>2</mn><mfenced><mrow><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac><mo>-</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow></mfenced><mo>-</mo><mn>3</mn><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>+</mo><mfrac><mrow><mo>-</mo><mn>6</mn><mo>-</mo><mn>2</mn><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac><mo>+</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>-</mo><mn>3</mn><mo>+</mo><mfrac><mrow><mn>9</mn><mo>+</mo><mn>3</mn><msqrt><mn>17</mn></msqrt></mrow><mn>8</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><msqrt><mn>17</mn></msqrt><mo>-</mo><mn>13</mn></mrow><mn>8</mn></mfrac></math></p>"
