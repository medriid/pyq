  "solution": {
    "text": "<blockquote><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mi>x</mi><mo>-</mo><mn>1</mn><mo>,</mo></mtd></mtr><mtr><mtd><mn>1</mn><mo>-</mo><mi>x</mi><mo>,</mo></mtd></mtr></mtable><mtable columnalign=\"left\"><mtr><mtd><mn>1</mn><mo>&#8804;</mo><mi>x</mi><mo>&#60;</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn><mo>&#8804;</mo><mi>x</mi><mo>&#60;</mo><mn>1</mn></mtd></mtr></mtable></mrow></mfenced></math></p><p><img height=\"121\" src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/e9e0342f-0edd-4275-89a3-56619fe12899-image.png\" width=\"333\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced></math>&nbsp;is periodic with period&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>, and is even.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>I</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mrow><mo>-</mo><mn>10</mn></mrow><mn>10</mn></msubsup><mo>&#160;</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>&#160;</mo><mn>2</mn><msubsup><mo>&#8747;</mo><mn>0</mn><mn>10</mn></msubsup><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2</mn><mo>&#215;</mo><mn>5</mn><msubsup><mo>&#8747;</mo><mn>0</mn><mn>2</mn></msubsup><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>10</mn><mo>&#160;</mo><mfenced close=\"]\" open=\"[\"><mrow><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mfenced><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi><mo>+</mo><msubsup><mo>&#8747;</mo><mn>1</mn><mn>2</mn></msubsup><mfenced><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></mrow></mfenced><mo>=</mo><mn>10</mn><mfenced><mrow><msub><mi>I</mi><mn>1</mn></msub><mo>+</mo><msub><mi>I</mi><mn>2</mn></msub></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><msubsup><mo>&#8747;</mo><mn>1</mn><mn>2</mn></msubsup><mfenced><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></math></p><p>Put&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mi>t</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>2</mn></msub><mo>=</mo><mo>-</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mi>t</mi><mi>cos&#960;</mi><mi>t</mi><mi>d</mi><mi>t</mi><mo>&#160;</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mn>1</mn></msub><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mfenced><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mo>&#160;</mo><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi><mo>=</mo><mo>-</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mi>x</mi><mi>cos</mi><mfenced><mrow><mi>&#960;</mi><mi>x</mi></mrow></mfenced><mo>&#160;</mo><mi>d</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>I</mi><mo>=</mo><mn>10</mn><mfenced close=\"]\" open=\"[\"><mrow><mo>-</mo><mn>2</mn><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mi>x</mi><mi>cos&#960;</mi><mi>x</mi><mo>&#160;</mo><mi>d</mi><mi>x</mi></mrow></mfenced><mo>=</mo><mo>-</mo><mn>20</mn><msubsup><mfenced close=\"]\" open=\"[\"><mrow><mi>x</mi><mfrac><mrow><mi>sin&#960;</mi><mi>x</mi></mrow><mi mathvariant=\"normal\">&#960;</mi></mfrac><mo>+</mo><mfrac><mrow><mi>cos&#960;</mi><mi>x</mi></mrow><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></mfrac></mrow></mfenced><mn>0</mn><mn>1</mn></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><mn>20</mn><mfenced close=\"]\" open=\"[\"><mrow><mo>-</mo><mfrac><mn>1</mn><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></mfrac><mo>-</mo><mfrac><mn>1</mn><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></mfrac></mrow></mfenced><mo>=</mo><mfrac><mn>40</mn><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mfrac><msup><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></msup><mn>10</mn></mfrac><mi>I</mi><mo>=</mo><mn>4</mn></math></p></blockquote>",
