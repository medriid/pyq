      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>12</mn></mfrac><mo>&#60;</mo><mi>I</mi><mo>&#60;</mo><mfrac><msqrt><mn>2</mn></msqrt><mn>3</mn></mfrac><mi>&#960;</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>4</mn></mfrac><mo>&#60;</mo><mi>I</mi><mo>&#60;</mo><mi>&#960;</mi></math>",
