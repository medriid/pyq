    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac><mfrac><mi>&#960;</mi><mn>3</mn></mfrac></msubsup><mfenced><mfrac><mrow><mn>8</mn><mi>sin</mi><mi>x</mi><mo>-</mo><mi>sin</mi><mn>2</mn><mi>x</mi></mrow><mi>x</mi></mfrac></mfenced><mi>d</mi><mi>x</mi></math>. Then"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>&#60;</mo><mi>I</mi><mo>&#60;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>4</mn></mfrac></math>",
