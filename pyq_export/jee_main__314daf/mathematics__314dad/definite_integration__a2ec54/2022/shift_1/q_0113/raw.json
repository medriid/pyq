  "solution": {
    "text": "<blockquote><p>Given,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mrow><mi>l</mi><mi>i</mi><mi>m</mi></mrow><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mfrac><msup><mfenced><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mrow><mi>k</mi><mo>-</mo><mn>1</mn></mrow></msup><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mo>(</mo><mi>n</mi><mi>k</mi><mo>+</mo><mn>1</mn><mo>)</mo><mo>+</mo><mo>(</mo><mi>n</mi><mi>k</mi><mo>+</mo><mn>2</mn><mo>)</mo><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mfenced><mrow><mi>n</mi><mi>k</mi><mo>+</mo><mi>n</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>33</mn></math></p><p>Taking&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>LHS</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mfrac><msup><mfenced><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mrow><mi>k</mi><mo>-</mo><mn>1</mn></mrow></msup><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mi>n</mi><mi>k</mi><mo>&#183;</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mi>n</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mfrac><msup><mfenced><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><msup><mrow></mrow><mrow><mi>k</mi><mo>-</mo><mn>1</mn></mrow></msup></msup><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac><mo>&#183;</mo><mfenced close=\"]\" open=\"[\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mi>k</mi><mo>+</mo><mfrac><mrow><mi>n</mi><mfenced><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mn>2</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mfrac><mrow><msup><mfenced><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mrow><mi>k</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>&#183;</mo><msup><mi>n</mi><mn>2</mn></msup><mfenced><mrow><mi>k</mi><mo>+</mo><mfrac><mfenced><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mfenced><mn>2</mn></mfrac></mrow></mfenced></mrow><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mfenced><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mfenced><mfenced><mrow><mi>k</mi><mo>+</mo><mfrac><mfenced><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow></mfenced><mn>2</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced><mrow><mi>k</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced></math></p><p>Now taking&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>RHS</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>33</mn><munder><mi>lim</mi><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac><mfenced><mrow><msup><mn>1</mn><mi>k</mi></msup><mo>+</mo><msup><mn>2</mn><mi>k</mi></msup><mo>+</mo><mo>&#8230;</mo><mo>+</mo><msup><mi>n</mi><mi>k</mi></msup></mrow></mfenced><mo>=</mo><mn>33</mn><munder><mi>lim</mi><mrow><mi>n</mi><mo>&#8594;</mo><mo>&#8734;</mo></mrow></munder><munderover><mo>&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><mi>n</mi></mfrac><msup><mfenced><mfrac><mi>k</mi><mi>n</mi></mfrac></mfenced><mi>k</mi></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>33</mn><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><msup><mi>x</mi><mi>k</mi></msup><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mn>33</mn><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfrac></math></p><p>Now given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>LHS</mi><mo>=</mo><mi>RHS</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>k</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>=</mo><mn>33</mn><mo>&#183;</mo><mfrac><mn>1</mn><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced><mrow><mn>2</mn><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mfenced><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mn>66</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced><mrow><mi>k</mi><mo>-</mo><mn>5</mn></mrow></mfenced><mfenced><mrow><mn>2</mn><mi>k</mi><mo>+</mo><mn>13</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>k</mi><mo>=5</mo></math>&nbsp;or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mfrac><mn>13</mn><mn>2</mn></mfrac></math></p><p>So, integral value of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mn>5</mn></math></p></blockquote>",
