  "question": {
    "text": "If <math><mi>f</mi><mo>:</mo><mi>R</mi><mo>&#8594;</mo><mi>R</mi></math> is a differentiable function and <math><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mn>6</mn><mo>,</mo></math> then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>2</mn></mrow></munder><msubsup><mo>&#8747;</mo><mn>6</mn><mrow><mi>f</mi><mfenced><mi>x</mi></mfenced></mrow></msubsup><mfrac><mrow><mn>2</mn><mi>t</mi><mi>d</mi><mi>t</mi></mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mfrac></math> is:"
  },
  "options": [
    {
      "text": "<math><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mi>f</mi><mi>'</mi></msup><mfenced separators=\"|\"><mn>2</mn></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>24</mn><msup><mrow><mi>f</mi></mrow><mrow><mi>'</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>12</mn><msup><mrow><mi>f</mi></mrow><mrow><mi>'</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></math>",
      "is_correct": true
    }
  ],
