  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mi>a</mi><mi>b</mi></msubsup><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>4</mn></msup><mo>-</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mi>d</mi><mi>x</mi><mo>.</mo></math>&nbsp;If <math><mi>I</mi></math> is minimum then the ordered pair <math><mo>(</mo><mi>a</mi><mo>,</mo><mi>&#160;</mi><mi>b</mi><mo>)</mo></math> is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&#160;</mi><msqrt><mn>2</mn></msqrt></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn></msqrt><mo>,</mo><mi> </mi><mo>-</mo><msqrt><mn>2</mn></msqrt></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><mi> </mi><msqrt><mn>2</mn></msqrt><mo>,</mo><mn>0</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><msqrt><mn>2</mn></msqrt><mo>,</mo><mi> </mi><msqrt><mn>2</mn></msqrt></mrow></mfenced></math>",
      "is_correct": true
