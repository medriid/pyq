  "solution": {
    "text": "<p>Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><munderover><mo stretchy=\"true\">&#8747;</mo><mn>0</mn><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></mfrac></munderover><mfrac><mrow><mi>cot</mi><mi>x</mi></mrow><mrow><mi>cot</mi><mi>x</mi><mo>+</mo><mi>cosec</mi><mi>x</mi></mrow></mfrac><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><munderover><mo stretchy=\"true\">&#8747;</mo><mn>0</mn><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></mfrac></munderover><mfrac><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi></mrow><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><munderover><mo stretchy=\"true\">&#8747;</mo><mn>0</mn><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></mfrac></munderover><mfrac><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi><mo>+</mo><mn>1</mn><mo>-</mo><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><munderover><mo stretchy=\"true\">&#8747;</mo><mn>0</mn><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></mfrac></munderover><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mfrac><mi>x</mi><mn>2</mn></mfrac></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><munderover><m