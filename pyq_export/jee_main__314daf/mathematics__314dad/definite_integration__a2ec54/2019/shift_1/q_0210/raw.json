</mn><mi>I</mi><mo>=</mo><mfenced><mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>cos</mi><mn>2</mn><mfenced><mstyle displaystyle=\"true\"><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn></mfrac></mstyle></mfenced></mrow><mn>4</mn></mfrac></mrow></mfenced><mo>-</mo><mfenced><mrow><mn>0</mn><mo>+</mo><mfrac><mrow><mi>cos</mi><mn>2</mn><mfenced><mstyle displaystyle=\"true\"><mn>0</mn></mstyle></mfenced></mrow><mn>4</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mi>I</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mfrac><mn>1</mn><mn>4</mn></mfrac></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mi>I</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>=</mo><mfrac><mrow><mi>&#960;</mi><mo>-</mo><mn>1</mn></mrow><mn>4</mn></mfrac><mo>.</mo></math></p>",
