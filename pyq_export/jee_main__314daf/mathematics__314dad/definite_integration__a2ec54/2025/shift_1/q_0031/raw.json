  "question": {
    "text": "$\\operatorname{IfI}(m, n)=\\int_0^1 x^{m-1}(1-x)^{n-1} d x, m, n\\gt0$, then $I(9,14)+I(10,13)$ is",
    "image": null
  },
  "options": [
    {
      "id": "lAkt1",
      "text": "$\\mathrm{I}(19,27)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NaGRB",
      "text": "$\\mathrm{I}(9,1)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Homa5",
      "text": "$I(1,13)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "byJc0",
      "text": "$\\mathrm{I}(9,13)$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{I}(\\mathrm{m}, \\mathrm{m})=\\int_0^1 \\mathrm{x}^{\\mathrm{m}-1}(1-\\mathrm{x})^{\\mathrm{n}-1} d \\mathrm{x} \\\\ & \\text { Let } \\mathrm{x}=\\sin ^2 \\theta \\quad \\mathrm{dx}=2 \\sin \\theta \\cos \\theta \\mathrm{~d} \\theta \\\\ & \\mathrm{I}(\\mathrm{m}, \\mathrm{n})=2 \\int_0^{\\pi / 2}(\\sin \\theta)^{2 \\mathrm{~m}-1}(\\cos \\theta)^{2 \\mathrm{n}-1} d \\theta \\\\ & \\mathrm{I}(9,14)+\\mathrm{I}(10,13)=2 \\int_0^{\\pi / 2}(\\sin \\theta)^{17}(\\cos \\theta)^{27} d \\theta \\\\ & +2 \\int_0^{\\pi / 2}(\\sin \\theta)^{19}(\\cos \\theta)^{25} d \\theta \\\\ & =2 \\int_0^{\\pi / 2}(\\sin \\theta)^{17}(\\cos \\theta)^{25} d \\theta \\\\ & =\\mathrm{I}(9,13)\\end{aligned}$",
    "image": null
  },
