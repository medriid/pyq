  "question": {
    "text": "The integral $\\int_0^\\pi \\frac{(x+3) \\sin x}{1+3 \\cos ^2 x} d x$ is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "oLQrP",
      "text": "$\\frac{\\pi}{\\sqrt{3}}(\\pi+1)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HzKWC",
      "text": "$\\frac{\\pi}{\\sqrt{3}}(\\pi+2)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "e1jFC",
      "text": "$\\frac{\\pi}{3 \\sqrt{3}}(\\pi+6)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "EMFb8",
      "text": "$\\frac{\\pi}{2 \\sqrt{3}}(\\pi+4)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & I=\\int_0^\\pi \\frac{(x+3) \\sin x}{1+3 \\cos ^2 x} d x \\\\ & I=\\int_0^\\pi \\frac{(\\pi-x+3) \\sin x}{\\left(1+3 \\cos ^2 x\\right)} d x \\\\ & 2 I=\\int_0^\\pi \\frac{(\\pi+6) \\sin x \\cdot d x}{\\left(1+3 \\cos ^2 x\\right)}=2 \\int_0^{\\pi / 2} \\frac{(\\pi+6) \\sin x}{\\left(1+3 \\cos ^2 x\\right)} \\\\ & I=\\int_0^{\\pi / 2} \\frac{(\\pi+6) \\sin x \\cdot d x}{\\left(1+3 \\cos ^2 x\\right)}=\\frac{\\pi}{3 \\sqrt{3}}(\\pi+6) \\\\ & \\sqrt{3} \\cos x=t \\\\ & \\sqrt{3} \\sin x=d t\\end{aligned}$",
    "image": null
  },
