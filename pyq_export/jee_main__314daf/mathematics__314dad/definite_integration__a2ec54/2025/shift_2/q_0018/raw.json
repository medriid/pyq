  "question": {
    "text": "The integral $\\int_0^\\pi \\frac{8 x d x}{4 \\cos ^2 x+\\sin ^2 x}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "4F6Ww",
      "text": "$2 \\pi^2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "t5U5V",
      "text": "$4 \\pi^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eIS0w",
