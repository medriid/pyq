  "question": {
    "text": "$4 \\int_0^1\\left(\\frac{1}{\\sqrt{3+x^2}+\\sqrt{1+x^2}}\\right) d x-3 \\log _e(\\sqrt{3})$ is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "AhNHh",
      "text": "$2+\\sqrt{2}+\\log _e(1+\\sqrt{2})$",
