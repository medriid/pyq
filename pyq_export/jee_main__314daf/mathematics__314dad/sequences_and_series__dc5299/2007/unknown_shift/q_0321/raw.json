  "question": {
    "text": "If $p$ and $q$ are positive real numbers such that $p^2+q^2=1$, then the maximum value of $(p+q)$ is",
    "image": null
  },
  "options": [
    {
      "id": "OupYJ",
      "text": "\n$2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PacUl",
      "text": "\n$1 / 2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Y5sOA",
      "text": "\n$\\frac{1}{\\sqrt{2}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RZ3dP",
      "text": "\n$\\sqrt{2}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Using $A.M.$ $\\geq$ $G.M.$\n$\\begin{aligned}\n& \\frac{p^2+q^2}{2} \\geq p q \\\\\n& \\Rightarrow p q \\leq \\frac{1}{2} \\\\\n& (p+q)^2=p^2+q^2+2 p q \\\\\n& \\Rightarrow p+q \\leq \\sqrt{2} .\n\\end{aligned}$",
    "image": null
  },
