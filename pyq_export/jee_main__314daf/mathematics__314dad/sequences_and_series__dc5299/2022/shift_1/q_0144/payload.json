    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><munderover><mo>&#8721;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><mi>min</mi><mfenced close=\"}\" open=\"{\"><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><munderover><mo>&#8721;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><mi>max</mi><mfenced close=\"}\" open=\"{\"><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><mi>min</mi><mfenced><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi>min</mi><mfenced><mrow><mi>j</mi><mo>,</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mo>&#8230;</mo><mi>min</mi><mfenced><mrow><mi>i</mi><mo>,</mo><mn>10</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><munder><mfenced><mrow><mn>1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mn>1</mn></mrow></mfenced><mo>&#9183;</mo></munder><mrow><mn>19</mn><mo>&#160;</mo><mi>times</mi><mo>&#160;</mo></mrow></munder><mo>+</mo><munder><munder><mfenced><mrow><mn>2</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>&#8230;</mo><mo>+</mo><mn>2</mn></mrow></mfenced><mo>&#9183;</mo></munder><mrow><mn>17</mn><mo>&#160;</mo><mi>times</mi><mo>&#160;</mo></mrow></munder><mo>+</mo><munder><munder><mfenced><mrow><mn>3</mn><mo>+</mo><mn>3</mn><mo>+</mo><mn>3</mn><mo>&#8230;</mo><mo>+</mo><mn>3</mn></mrow></mfenced><mo>&#9183;</mo></munder><mrow><mn>15</mn><mo>&#160;</mo><mi>times</mi><mo>&#160;</mo></mrow></munder><m