  "question": {
    "text": "If <math><mn>5</mn><mo>,</mo><mi>&#160;</mi><mn>5</mn><mi>r</mi><mo>,</mo><mi>&#160;</mi><mn>5</mn><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></math> are the lengths of the sides of a triangle, then <math><mi>r</mi></math> can not be equal to:",
    "image": null
  },
  "options": [
    {
      "id": "r2GgJ",
