  "question": {
    "text": "If <math><mi>a</mi><mo>,</mo><mi>&#160;</mi><mi>b</mi></math> and <math><mi>c</mi></math> be three distinct real numbers in G.P. and <math><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mi>x</mi><mi>b</mi><mo>,</mo></math> then <math><mi>x</mi></math> cannot be:",
    "image": null
  },
  "options": [
    {
      "id": "NmFkJ",
      "text": "<math><mo>-</mo><mn>3</mn></math>",
      "isCorrect": false,
      "image": null
    },
