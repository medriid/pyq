  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mi mathvariant=\"normal\">n</mi><mn>4</mn></msup><mi>&#945;</mi><mo>+</mo><mn>4</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mi mathvariant=\"normal\">s</mi><mn>4</mn></msup><mi>&#946;</mi><mo>+</mo><mn>2</mn><mo>=</mo><mn>4</mn><msqrt><mn>2</mn></msqrt><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi>&#945;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#946;</mi></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>,</mo><mo>&#160;</mo><mi>&#946;</mi><mo>&#8712;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\">&#960;</mi></mrow></mfenced></math>,&nbsp;then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi></mrow></mfenced><mo>-</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow></mfenced></math> is equal to",
    "image": null
  },
  "options": [
    {
      "id": "ir7u7",
      "text": "<math><mo>-</mo><mn>1</mn></math>",
      "isCorrect": false,
