  "question": {
    "text": "If the sum and product of the first three terms in an <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>.</mo><mi>P</mi><mo>.</mo></math>&nbsp;are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>33</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1155</mn></math>, respectively, then a value of its <math><msup><mrow><mn>11</mn></mrow><mrow><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">h</mi></mrow></msup></math> term is:"
  },
  "options": [
    {
      "text": "<math><mo>-</mo><mn>25</mn></math>",
      "is_correct": true
    },
