    },
    {
      "text": "<math><mfrac><mrow><mn>7</mn></mrow><mrow><mn>13</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn></math>",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Let the first terms of A.P.&nbsp;be <math><mi>A</mi></math> and common difference be <math><mi>d</mi><mo>,</mo></math> then<br /><br /><math><mi>a</mi><mo>=</mo><mi>A</mi><mo>+</mo><mn>6</mn><mi>d</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mi>A</mi><mo>+</mo><mn>10</mn><mi>d</mi></math><br /><br /><math><mi>c</mi><mo>=</mo><mi>A</mi><mo>+</mo><mn>12</mn><mi>d</mi></math><br /><br />Given <math><mi>a</mi><mo>,</mo><mi>&#160;</mi><mi>b</mi><mo>,</mo><mi>&#160;</mi><mi>c</mi></math> are&nbsp;in G. P. <math><mo>&#8658;</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>a</mi><mi>c</mi></math><br /><br /><math><mo>&#8658;</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi>A</mi><mo>+</mo><mn>10</mn><mi>d</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfenced separators=\"|\"><mrow><mi>A</mi><mo>+</mo><mn>6</mn><mi>d</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>A</mi><mo>+</mo><mn>12</mn><mi>d</mi></mrow></mfenced></math><br /><br /><math><mo>&#8658;</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>100</mn><msup><mrow><mi>d</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>20</mn><mi>A</mi><mi>d</mi><mo>=</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>18</mn><mi>A</mi><mi>d</mi><mo>+</mo><mn>72</mn><msup><mrow><mi>d</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mo>&#8658;</mo><mi>A</mi><mo>=</mo><mo>-</mo><mn>14</mn><mi>d</mi></math><br /><br />Now <math><mfrac><mrow><mi>a</mi></mrow><mrow><mi>c</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>A</mi><mo>+</mo><mn>6</mn><mi>d</mi></mrow><mrow><mi>A</mi><mo>+</mo><mn>12</mn><mi>d</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>14</mn><mi>d</mi><mo>+</mo><mn>6</mn><mi>d</mi></mrow><mrow><mo>-</mo><mn>14</mn><mi>d</mi><mo>+</mo><mn>12</mn><mi>d</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>8</mn><mi>d</mi></mrow><mrow><mo>-</mo><mn>2</mn><mi>d</mi></mrow></mfrac><mo>=</mo><mn>4</mn></math>"
  }
