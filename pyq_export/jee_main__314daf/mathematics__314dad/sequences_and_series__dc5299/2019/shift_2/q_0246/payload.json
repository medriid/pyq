    "text": "<math><mi>S</mi><mo>=</mo><mi>&#160;</mi><mrow><munderover><mo stretchy=\"true\">&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>20</mn></mrow></munderover><mrow><mfrac><mrow><mi>k</mi></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mi>k</mi></mrow></msup></mrow></mfrac></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>4</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>4</mn></mrow></msup></mrow></mfrac><mo>+</mo><mo>&#8230;</mo><mo>.</mo><mo>.</mo><mo>+</mo><mfrac><mrow><mn>20</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>20</mn></mrow></msup></mrow></mfrac></math><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mi>S</mi><mo>=</mo><mi>&#160;</mi><mrow><munderover><mo stretchy=\"true\">&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>20</mn></mrow></munderover><mrow><mfrac><mrow><mi>k</mi></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mfrac></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>3</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>4</mn></mrow></msup></mrow></mfrac><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mfrac><mrow><mn>19</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>20</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>20</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br />By subtraction,<br /><math><mfr