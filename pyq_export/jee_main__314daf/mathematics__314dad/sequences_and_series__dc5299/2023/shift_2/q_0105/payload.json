mn></msub></mrow><mn>2</mn></mfrac><mo>-</mo><mfrac><mfenced><mrow><msub><mi>b</mi><mn>10</mn></msub><mo>+</mo><mn>2</mn><msub><mi>a</mi><mn>9</mn></msub></mrow></mfenced><msup><mn>2</mn><mn>11</mn></msup></mfrac><mo>+</mo><mfrac><mi>T</mi><mn>4</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mi>S</mi><mo>=</mo><mn>2</mn><mfenced><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></mfenced><mo>-</mo><mfrac><mfenced><mrow><msub><mi>b</mi><mn>10</mn></msub><mo>+</mo><mn>2</mn><msub><mi>a</mi><mn>9</mn></msub></mrow></mfenced><msup><mn>2</mn><mn>9</mn></msup></mfrac><mo>+</mo><mi>T</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced><mrow><mn>2</mn><mi>S</mi><mo>-</mo><mi>T</mi></mrow></mfenced><mo>=</mo><mn>2</mn><mfenced><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></mfenced><mo>-</mo><mfrac><mfenced><mrow><msub><mi>b</mi><mn>10</mn></msub><mo>+</mo><mn>2</mn><msub><mi>a</mi><mn>9</mn></msub></mrow></mfenced><msup><mn>2</mn><mn>9</mn></msup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mn>2</mn><mn>7</mn></msup><mo>(</mo><mn>2</mn><mi>S</mi><mo>-</mo><mi>T</mi><mo>)</mo><mo>=</mo><msup><mn>2</mn><mn>8</mn></msup><mfenced><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></mfenced><mo>-</mo><mfrac><mfenced><mrow><msub><mi>b</mi><mn>10</mn></msub><mo>+</mo><mn>2</mn><msub><mi>a</mi><mn>9</mn></msub></mrow></mfenced><mn>4</mn></mfrac></math></p><p>Given,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mi mathvariant=\"normal\">n</mi></msub><mo>-</mo><msub><mi>a</mi><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>n</mi><mo>-</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>2</mn></msub><mo>-</mo><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>3</mn></msub><mo>-</mo><msub><mi>a</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mspace linebreak=\"newline\"/><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mspace linebreak=\"newline\"/><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#8942;</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>9</mn></msub><mo>-</mo><msub><mi>a</mi><mn>8</mn></msub><mo>=</mo><mn>8</mn></math></p><p>Adding all equations, we get</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>9</mn></msub><mo>-</mo><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mo>&#8230;</mo><mo>+</mo><mn>8</mn><mo>=</mo><mn>36</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>a</mi><mn>9</mn></msub><mo>=</mo><mn>37</mn><mo>&#160;</mo><mfenced><mrow><mo>&#8757;</mo><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow></mfenced></math></p><p>So,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>7</mn></msup><mo>(</mo><mn>2</mn><mi>S</mi><mo>-</mo><mi>T</mi><mo>)</mo><mo>=</mo><msup><mn>2</mn><mn>9</mn></msup><mo>-</mo><mfrac><mfenced><mrow><msub><mi>b</mi><mn>10</mn></msub><mo>+</mo><mn>2</mn><mo>&#183;</mo><mn>37</mn></mrow></mfenced><mn>4</mn></mfrac></math></p><p>Also,</p><p><math xmlns=\"http://www.w3.org/1998/Math/Math