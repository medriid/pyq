  "question": {
    "text": "The sum of the series $1+\\frac{1}{4.2 !}+\\frac{1}{16.4 !}+\\frac{1}{64.6 !}+\\ldots \\ldots \\ldots$ ad inf. is",
    "image": null
  },
  "options": [
