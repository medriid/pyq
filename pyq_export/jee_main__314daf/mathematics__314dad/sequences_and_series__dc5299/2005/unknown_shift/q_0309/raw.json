      "text": "\n$\\frac{\\mathrm{e}-1}{2 \\sqrt{\\mathrm{e}}}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "opVXj",
      "text": "\n$\\frac{e+1}{2 \\sqrt{e}}$",
