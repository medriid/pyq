  "question": {
    "text": "The sum of the series $1+\\frac{1}{4.2 !}+\\frac{1}{16.4 !}+\\frac{1}{64.6 !}+\\ldots \\ldots \\ldots$ ad inf. is"
  },
  "options": [
    {
      "text": "\n$\\frac{\\mathrm{e}-1}{\\sqrt{\\mathrm{e}}}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mathrm{e}+1}{\\sqrt{\\mathrm{e}}}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{\\mathrm{e}-1}{2 \\sqrt{\\mathrm{e}}}$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\frac{e+1}{2 \\sqrt{e}}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{e^x+e^{-x}}{2}=1+\\frac{x^2}{2 !}+\\frac{x^4}{4 !}+\\frac{x^6}{6 !}+\\ldots \\ldots$\nputting $x=1 / 2$ we get\n$\\frac{e+1}{2 \\sqrt{e}}$"
  }
}