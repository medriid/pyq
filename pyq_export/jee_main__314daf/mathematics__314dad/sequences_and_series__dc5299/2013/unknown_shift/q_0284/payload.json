  "question": {
    "text": "The sum of the series :\n$(2)^2+2(4)^2+3(6)^2+\\ldots$ upto 10 terms is :"
  },
  "options": [
    {
      "text": "\n11300\n",
      "is_correct": false
    },
    {
      "text": "\n11200\n",
      "is_correct": false
    },
    {
      "text": "\n12100\n",
      "is_correct": true
    },
    {
      "text": "\n12300",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$2^2+2(4)^2+3(6)^2+\\ldots \\ldots$ upto 10 terms $=2^2\\left[1^3+2^3+3^3+\\ldots \\ldots\\right.$ upto 10 terms $]$\n$=4 \\cdot\\left(\\frac{10 \\times 11}{2}\\right)^2=12100$"
  }
}