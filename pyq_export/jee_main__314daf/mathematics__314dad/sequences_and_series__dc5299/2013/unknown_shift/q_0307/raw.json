  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>,</mo><mo>&#160;</mo><mi>y</mi><mo>,</mo><mo>&#160;</mo><mi>z</mi></math>&nbsp;are positive numbers in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>.</mo><mi mathvariant=\"normal\">P</mi><mo>.</mo></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></math>,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>y</mi></math> and&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>z</mi></math> are also in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi><mo>.</mo><mi mathvariant=\"normal\">P</mi><mo>.</mo></math>,&nbsp;then which of the following is correct.",
    "image": null
  },
  "options": [
    {
      "id": "QpFNJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>=</mo><mn>3</mn><mi>y</mi><mo>=</mo><mn>2</mn><mi>z</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cjloW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>=</mo><mn>4</mn><mi>y</mi><mo>=</mo><mn>3</mn><mi>z</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "x6ylo",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mi>y</mi><mo>=</mo><mi>z</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "0Y77z",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>x</mi><mo>=</mo><mn>3</mn><mi>y</mi><mo>=</mo><mn>6</mn><mi>z</mi></math>",
      "image": null,
      "isCorrect": false
