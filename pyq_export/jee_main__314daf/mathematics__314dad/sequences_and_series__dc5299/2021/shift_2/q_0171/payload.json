  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mrow><mn>2</mn><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mn>2</mn><mi>a</mi><mo>+</mo><mfenced><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi></mrow></mfenced><mo>,</mo><mo>&#160;</mo><msub><mi>S</mi><mrow><mn>4</mn><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mn>2</mn><mi>a</mi><mo>+</mo><mfenced><mrow><mn>4</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>S</mi><mn>2</mn></msub><mo>-</mo><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mo>[</mo><mn>2</mn><mi>a</mi><mo>+</mo><mo>(</mo><mn>4</mn><mi>n</mi><mo>-</mo><mn>1</mn><mo>)</mo><mi>d</mi><mo>]</mo><mo>-</mo><mfrac><mrow><mn>2</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mn>2</mn><mi>a</mi><mo>+</mo><mfenced><mrow><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>4</mn><mi>a</mi><mi>n</mi><mo>+</mo><mo>(</mo><mn>4</mn><mi>n</mi><mo>-</mo><mn>1</mn><mo>)</mo><mn>2</mn><mi>n</mi><mi>d</mi><mo>-</mo><mn>2</mn><mi>n</mi><mi>a</mi><mo>-</mo><mo>(</mo><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn><mo>)</mo><mi>d</mi><mi>n</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2</mn><mi>n</mi><mi>a</mi><mo>+</mo><mi>n</mi><mi>d</mi><mo>[</mo><mn>8</mn><mi>n</mi><mo>-</mo><mn>2</mn><mo>-</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn><mo>]</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mi>n</mi><mi>a</mi><mo>+</mo><mi>n</mi><mi>d</mi><mo>[</mo><mn>6</mn><mi>n</mi><mo>-</mo><mn>1</mn><mo>]</mo><mo>=</mo><mn>1000</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>+</mo><mfenced><mrow><mn>6</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi><mo>=</mo><mfrac><mn>1000</mn><mi>n</mi></mfrac></math></p><p>Now, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mrow><mn>6</mn><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>6</mn><mi>n</mi></mrow><mn>2</mn></mfrac><mfenced close=\"]\" open=\"[\"><mrow><mn>2</mn><mi>a</mi><mo>+</mo><mfenced><mrow><mn>6</mn><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>d</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>3</mn><mi>n</mi><mo>&#183;</mo><mfrac><mn>1000</mn><mi>n</mi></mfrac><mo>=</mo><mn>3000</mn></math></p>"
