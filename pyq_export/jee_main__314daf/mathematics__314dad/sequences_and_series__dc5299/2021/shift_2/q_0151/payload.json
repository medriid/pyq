o>=</mo><mfrac><mstyle displaystyle=\"true\"><mfrac><mn>2</mn><msup><mn>5</mn><mn>4</mn></msup></mfrac></mstyle><mstyle displaystyle=\"true\"><mfrac><mn>2</mn><msup><mn>5</mn><mn>3</mn></msup></mfrac></mstyle></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>5</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mi>k</mi></mrow><mn>5</mn></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>25</mn></mfrac><mfenced close=\"}\" open=\"{\"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>-</mo><mfrac><mn>1</mn><mn>5</mn></mfrac></mrow></mfrac></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>10</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><mfrac><mn>1</mn><mn>8</mn></mfrac></math></p><p>&nbsp;Now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mi>S</mi></mrow><mn>5</mn></mfrac><mo>-</mo><mfrac><mn>7</mn><mn>5</mn></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>8</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>4</mn><mi>S</mi></mrow><mn>5</mn></mfrac><mo>=</mo><mfrac><mn>7</mn><mn>5</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>8</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>=</mo><mfrac><mn>61</mn><mn>32</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>160</mn><mi>S</mi><mo>=</mo><mn>160</mn><mo>&#215;</mo><mfrac><mn>61</mn><mn>32</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>305</mn></math></p>"
