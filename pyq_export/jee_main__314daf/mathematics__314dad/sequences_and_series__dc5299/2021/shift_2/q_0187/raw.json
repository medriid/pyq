  "correctValue": null,
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mn>2</mn><mo>+</mo><mi>a</mi></mrow><mn>3</mn></mfrac><mo>=</mo><mfrac><mn>10</mn><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>4</mn></math></p><p>and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>c</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>b</mi></mrow><mn>3</mn></mfrac><mo>=</mo><mfrac><mn>7</mn><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi><mo>+</mo><mn>2</mn><mi>b</mi><mo>=</mo><mn>7</mn></math></p><p>also&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>b</mi><mo>=</mo><mi>a</mi><mo>+</mo><mi>c</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>b</mi><mo>-</mo><mi>a</mi><mo>+</mo><mn>2</mn><mi>b</mi><mo>=</mo><mn>7</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi><mo>=</mo><mfrac><mn>11</mn><mn>4</mn></mfrac></math></p><p>now&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>11</mn><mn>4</mn></mfrac><mi>x</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math></p><p>&nbsp;<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/c5889b0e-c719-4b2f-a8e9-95ad4f2ec421-image.png\" style=\"width: 51px; height: 71px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#945;</mi><mn>2</mn></msup><mo>+</mo><msup><mi>&#946;</mi><mn>2</mn></msup><mo>-</mo><mi>&#945;</mi><mi>&#946;</mi><mo>=</mo><msup><mfenced><mrow><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mn>3</mn><mi>&#945;</mi><mi>&#946;</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mfenced><mfrac><mrow><mo>-</mo><mn>11</mn></mrow><mn>16</mn></mfrac></mfenced><mn>2</mn></msup><mo>-</mo><mn>3</mn><mfenced><mfrac><mn>1</mn><mn>4</mn></mfr