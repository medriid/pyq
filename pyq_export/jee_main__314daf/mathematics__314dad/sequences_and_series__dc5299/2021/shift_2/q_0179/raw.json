  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced><mrow><mi>tan</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac><mo>+</mo><mi>tan</mi><mfrac><mrow><mn>7</mn><mi>&#960;</mi></mrow><mn>18</mn></mfrac></mrow></mfenced></math></p><p>and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>y</mi><mo>=</mo><mi>tan</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac><mo>+</mo><mi>tan</mi><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>18</mn></mfrac></math></p><p>so, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo><mn>2</mn><mi>y</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced><mrow><mi>tan</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac><mo>+</mo><mi>tan</mi><mfrac><mrow><mn>7</mn><mi>&#960;</mi></mrow><mn>18</mn></mfrac></mrow></mfenced></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mfenced><mrow><mi>tan</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac><mo>+</mo><mi>tan</mi><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>18</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn><mi>y</mi></mrow></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><mrow><mfrac><mrow><mi>cot</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac><mo>-</mo><mi>tan</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac></mrow><mn>2</mn></mfrac><mo>-</mo><mi>tan</mi><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>18</mn></mfrac></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn><mi>y</mi></mrow></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><mrow><mfrac><mrow><msup><mi>cot</mi><mn>2</mn></msup><mfrac><mi>&#960;</mi><mn>9</mn></mfrac><mo>-</mo><mn>1</mn></mrow><mrow><mn>2</mn><mi>c</mi><mi>o</mi><mi>t</mi><mfrac><mi>&#960;</mi><mn>9</mn></mfrac>