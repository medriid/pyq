  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mi>k</mi></msub><mo>=</mo><msub><mi>a</mi><mi>k</mi></msub><mo>+</mo><msub><mi>b</mi><mi>k</mi></msub></math></p><p>where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mi>k</mi></msub><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo>(</mo><mi>k</mi><mo>-</mo><mn>1</mn><mo>)</mo><mo>(</mo><mo>-</mo><mn>3</mn><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>b</mi><mi>k</mi></msub><mo>=</mo><msub><mi>b</mi><mn>1</mn></msub><msup><mn>2</mn><mrow><mi>k</mi><mo>-</mo><mn>1</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mi>k</mi></msub><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo>(</mo><mi>k</mi><mo>-</mo><mn>1</mn><mo>)</mo><mo>(</mo><mo>-</mo><mn>3</mn><mo>)</mo><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub><msup><mn>2</mn><mrow><mi>k</mi><mo>-</mo><mn>1</mn></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msub><mi>c</mi><mi>k</mi></msub><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msub><mi>a</mi><mi>k</mi></msub><mo>+</mo><munderover><mo>&#8721;</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msub><mi>b</mi><mi>k</mi></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub><mo>-</mo><mn>3</mn><mo>+</mo><msub><mi>b</mi><mn>1</mn></msub><mo>(</mo><mn>2</mn><mo>)</mo><mo>=</mo><mn>12</mn><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>(</mo><mn>1</mn><mo>)</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>3</mn></msub><mo>=</mo><msub><mi>a</mi><mn>1</mn></msub><mo>-</mo><mn>6</mn><mo>+</mo><mn>4</mn><msub><mrow><mo>&#160;</mo><mi>b</mi></mrow><mn>1</mn></msub><mo>=</mo><mn>13</mn><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>(</mo><mn>2</mn><mo>)</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo></math></p><p>by solving (1) &amp; (2)<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msub><mi>b</mi><mn>1</mn></msub><mo>-</mo><mn>3</mn><mo>=</mo><mn>1</mn><mo>&#8658;</mo><msub><mi>b</mi><mn>1</mn></msub><mo>=</mo><mn>2</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mn>11</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi mathvariant=\"normal\">k</mi><mo>=</mo><mn>1</mn></mrow><mn>10</mn></munderover><msub><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">k</mi></msub><mo>=</mo><mfrac><mn>10</mn><mn>2</mn></mfrac><mfenced><mrow><mn>22</mn><mo>+</mo><mn>9</mn><mfenced><mrow><mo>-</mo><mn>3</mn></mrow></mfenced></mrow></mfenced><mo>+</mo><mfrac><mrow><mn>2</mn><mfenced><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn><mo>-</mo><mn>1</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><mn>25</mn><mo>+</mo><mn>2046</mn><mo>=</mo><mn>2021</mn></math></p>"
