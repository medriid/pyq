  "solution": {
    "text": "<p><math><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>8</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>12</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>16</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math> ........ upto ten terms<br /><br /><math><msub><mrow><mi>T</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>4</mn><mi>n</mi><mo>+</mo><mn>4</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><msub><mrow><mi>T</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><mn>16</mn><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mrow><mn>25</mn></mrow></mfrac></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><mfrac><mn>16</mn><mn>25</mn></mfrac><mfenced separators=\"|\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mi>n</mi></msub><mo>=</mo><mfrac><mn>16</mn><mn>25</mn></mfrac><mstyle displaystyle=\"false\"><munder><mo>&#8721;</mo><mrow></mrow></munder></mstyle><mfenced separators=\"|\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mi>n</mi></msub><mo>=</mo><mfenced separators=\"|\"><mfrac><mn>16</mn><mn>25</mn></mfrac></mfenced><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mn>6</mn></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mfenced separators=\"|\"><mi>n</mi></mfenced><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mn>2</mn></mfrac><mo>+</mo><mi>n</mi></mrow></mfenced></math><br /><br />Put <math><mi>n</mi><mo>=</mo><mn>10</mn><mi>&#160;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>16</mn><mn>25</mn></mfrac><mfenced separators=\"|\"><mrow><mfenced separators=\"|\"><mfrac><mrow><mn>10</mn><mo>&#183;</mo><mn>11</mn><mo>&#183;</mo><mn>21</mn></mrow><mn>6</mn></mfrac></mfenced><mo>+</mo><mfrac><mrow><mn>2</mn><mo>&#183;</mo><mn>10</mn><mo>&#183;</mo><mn>11</mn></mrow><mn>2</mn></mfrac><mo>+</mo><mn>10</mn></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>16</mn><mn>25</mn></mfrac><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mn>385</mn><mo>+</mo><mn>110</mn><mo>+</mo><mn>10</mn></mrow></mfenced><mo>=</mo><mfrac><mn>16</mn><mn>25</mn></mfrac><mo>&#183;</mo><mi>&#160;</mi><mn>505</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>16</mn><mn>5</mn></mfrac><mo>&#183;</mo><mn>101</mn></math><br /><br />Hence <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mn>101</mn></math></p>",
