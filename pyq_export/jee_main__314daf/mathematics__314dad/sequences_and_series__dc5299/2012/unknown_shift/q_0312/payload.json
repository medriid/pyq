  "question": {
    "text": "The sum of the series $1^2+2.2^2+3^2+2.4^2+5^2+2.6^2+\\ldots . .+2(2 m)^2$ is"
  },
  "options": [
    {
      "text": "\n$m(2 m+1)^2$\n",
      "is_correct": true
    },
    {
      "text": "\n$m^2(m+2)$\n",
      "is_correct": false
    },
    {
      "text": "\n$m^2(2 m+1)$\n",
      "is_correct": false
    },
    {
      "text": "\n$m(m+2)^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "The sum of the given series $1^2+2.2^2+3^2+$ $2.4^2+5^2+2.6^2+\\ldots \\ldots . .+2(2 m)^2$ is $\\frac{2 m\\left(2 m+1^2\\right.}{2} \\leqslant m\\left(2 m+1^2\\right)$"
  }
}