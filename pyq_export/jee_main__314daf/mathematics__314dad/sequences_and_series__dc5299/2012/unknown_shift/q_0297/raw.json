  "question": {
    "text": "If $100$ times the $100^{\\text {th }}$ term of an $AP$ with non zero common difference equals the $50$ times its $50^{\\text {th }}$ term, then the $150^{\\text {th }}$ term of this $A P$ is",
    "image": null
  },
  "options": [
    {
      "id": "pjr3m",
      "text": "\n$-150$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l8mN4",
      "text": "\n$150$ times its $50^{\\text {th }}$ term\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dradu",
      "text": "\n$150$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tFqQK",
      "text": "\nzero",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$100\\left(T_{100}\\right)=50\\left(T_{50}\\right) \\quad \\Rightarrow 2[a+99 d]=a+49 d \\Rightarrow a+149 d=0 \\quad \\Rightarrow T_{150}=0$",
    "image": null
  },
