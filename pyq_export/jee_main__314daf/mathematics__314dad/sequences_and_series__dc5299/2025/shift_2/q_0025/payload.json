  "question": {
    "text": "The sum $1+\\frac{1+3}{2!}+\\frac{1+3+5}{3!}+\\frac{1+3+5+7}{4!}+\\ldots$ upto $\\infty$ terms, is equal to"
  },
  "options": [
    {
      "text": "$6 e$",
      "is_correct": false
    },
    {
      "text": "$4 e$",
      "is_correct": false
    },
    {
      "text": "$3 e$",
      "is_correct": false
    },
    {
      "text": "$2 e$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{S}=1+\\frac{1+3}{2!}+\\frac{1+3+5}{3!}+\\ldots \\\\ & =\\sum_{\\mathrm{r}=1}^{\\infty} \\frac{\\mathrm{r}^2}{\\mathrm{r}!} \\\\ & =\\sum_{\\mathrm{r}=1}^{\\infty} \\frac{(\\mathrm{r}-1+1)}{(\\mathrm{r}-1)!}=\\sum_{\\mathrm{r}=2}^{\\infty} \\frac{1}{(\\mathrm{r}-2)!}+\\sum_{\\mathrm{r}=1}^{\\infty} \\frac{1}{(\\mathrm{r}-1)!} \\\\ & =2 \\mathrm{e}\\end{aligned}$"
  }
}