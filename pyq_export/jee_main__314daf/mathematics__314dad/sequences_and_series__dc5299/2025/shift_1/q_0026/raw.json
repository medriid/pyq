  "question": {
    "text": "The sum $1+3+11+25+45+71+.$. upto 20 terms, is equal to",
    "image": null
  },
  "options": [
    {
      "id": "hO6N2",
      "text": "$7240$",
      "image": null,
      "isCorrect": true
