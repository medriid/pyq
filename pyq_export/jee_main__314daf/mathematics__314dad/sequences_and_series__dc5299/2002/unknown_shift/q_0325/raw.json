  "correctValue": null,
  "solution": {
    "text": "$\\operatorname{ar}^4=2$\n$\\mathrm{a} \\times \\operatorname{ar} \\times \\mathrm{ar}^2 \\times a r^3 \\times \\mathrm{ar}^4 \\times \\mathrm{ar}^5 \\times a r^6 \\times a r^7 \\times a r^8$\n$=a^9 r^{36}=\\left(\\operatorname{ar}^4\\right)^9=2^9=512$",
    "image": null
  },
