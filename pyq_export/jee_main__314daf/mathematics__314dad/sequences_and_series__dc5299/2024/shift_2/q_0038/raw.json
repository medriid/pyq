  "question": {
    "text": "A software company sets up $m$ number of computer systems to finish an assignment in 17 days. If 4 computer systems crashed on the start of the second day, 4 more computer systems crashed on the start of the third day and so on, then it took 8 more days to finish the assignment. The value of $\\mathrm{m}$ is equal to:",
    "image": null
  },
  "options": [
    {
      "id": "xThwo",
      "text": "150",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "bSAMz",
      "text": "180",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zx4MP",
      "text": "160",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Qlc1h",
      "text": "125",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & 17 \\mathrm{~m}=\\mathrm{m}+(\\mathrm{m}-4)+(\\mathrm{m}-4 \\times 2) \\ldots+\\ldots(\\mathrm{m}-4 \\times 24) \\\\ & 17 \\mathrm{~m}=25 \\mathrm{~m}-4(1+2 \\ldots 24) \\\\ & 8 \\mathrm{~m}=\\frac{4 \\cdot 24 \\cdot 25}{2}=150\\end{aligned}$",
    "image": null
  },
