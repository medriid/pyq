  "question": {
    "text": "The value of $\\frac{1 \\times 2^2+2 \\times 3^2+\\ldots+100 \\times(101)^2}{1^2 \\times 2+2^2 \\times 3+\\ldots .+100^2 \\times 101}$ is",
    "image": null
  },
  "options": [
    {
      "id": "u2zPC",
      "text": "$\\frac{32}{31}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "drpOm",
      "text": "$\\frac{31}{30}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MOGwN",
      "text": "$\\frac{306}{305}$",
      "image": null,
      "isCorrect": false
    },
