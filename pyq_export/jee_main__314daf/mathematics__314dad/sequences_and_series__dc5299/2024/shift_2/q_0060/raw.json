  "question": {
    "text": "For $x \\geqslant 0$, the least value of $\\mathrm{K}$, for which $4^{1+x}+4^{1-x}, \\frac{\\mathrm{K}}{2}, 16^x+16^{-x}$ are three consecutive terms of an A.P., is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "x5qa6",
      "text": "8",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uPx2s",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oKypX",
      "text": "10",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ouEoS",
      "text": "16",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{gathered}\\mathrm{k}=4\\left(4^{\\mathrm{x}}+\\frac{1}{4^{\\mathrm{x}}}\\right)+\\left(4^{2 \\mathrm{x}}+\\frac{1}{4^{2 \\mathrm{x}}}\\right) \\\\ \\qquad \\geq 2 \\quad\\qquad\\qquad \\geq 2\\end{gathered}\\)\n$\\mathrm{k} \\geq 10$",
    "image": null
