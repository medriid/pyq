  "question": {
    "text": "If $\\frac{1}{\\sqrt{1}+\\sqrt{2}}+\\frac{1}{\\sqrt{2}+\\sqrt{3}}+\\ldots+\\frac{1}{\\sqrt{99}+\\sqrt{100}}=m$ and $\\frac{1}{1 \\cdot 2}+\\frac{1}{2 \\cdot 3}+\\ldots+\\frac{1}{99 \\cdot 100}=n$, then the point $(\\mathrm{m}, \\mathrm{n})$ lies on the line",
    "image": null
  },
  "options": [
    {
      "id": "vguwx",
      "text": "$11(x-1)-100(y-2)=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YbgtQ",
      "text": "$11 x-100 y=0$",
