  "question": {
    "text": "If the system of linear equations<br/>$\\begin{aligned} & 3 x+y+\\beta z=3 \\\\ & 2 x+\\alpha y-z=-3 \\\\ & x+2 y+z=4\\end{aligned}$<br/>has infinitely many solutions, then the value of $22 \\beta-9 \\alpha$ is :"
  },
  "options": [
    {
      "text": "49",
      "is_correct": false
    },
    {
      "text": "31",
      "is_correct": true
    },
    {
      "text": "43",
      "is_correct": false
    },
    {
      "text": "37",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\Delta=\\left|\\begin{array}{ccc}3 & 1 & \\beta \\\\ 2 & \\alpha & -1 \\\\ 1 & 2 & 1\\end{array}\\right|=0$<br/>$3 \\alpha+4 \\beta-\\alpha \\beta+3=0$<br/>$\\Delta_3=\\left|\\begin{array}{ccc}3 & 1 & 3 \\\\ 2 & \\alpha & -3 \\\\ 1 & 2 & 4\\end{array}\\right|=0$<br/>$9 \\alpha+19=0$<br/>$\\alpha=\\frac{-19}{9}, \\beta=\\frac{6}{11}$<br/>$\\Rightarrow 22 \\beta-9 \\alpha=31$"
  }
}