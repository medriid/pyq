  "question": {
    "text": "If the system of equations\n$\\begin{aligned}\n& x+2 y-3 z=2 \\\\\n& 2 x+\\lambda y+5 z=5 \\\\\n& 14 x+3 y+\\mu z=33\n\\end{aligned}$\nhas infinitely many solutions, then $\\lambda+\\mu$ is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "zqIHz",
      "text": "13",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KC9IM",
