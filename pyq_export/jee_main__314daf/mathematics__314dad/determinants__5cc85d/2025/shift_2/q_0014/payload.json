  "question": {
    "text": "The system of equations\n$\\begin{aligned}\n& x+y+z=6 \\\\\n& x+2 y+5 z=9, \\\\\n& x+5 y+\\lambda z=\\mu,\n\\end{aligned}$\nhas no solution if"
  },
  "options": [
    {
      "text": "$\\lambda=15, \\mu \\neq 17$",
      "is_correct": false
    },
    {
      "text": "$\\lambda \\neq 17, \\mu \\neq 18$",
      "is_correct": false
    },
    {
      "text": "$\\lambda=17, \\mu \\neq 18$",
      "is_correct": true
    },
    {
      "text": "$\\lambda=17, \\mu=18$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{D}=\\left|\\begin{array}{lll}1 & 1 & 1 \\\\ 1 & 2 & 5 \\\\ 1 & 5 & \\lambda\\end{array}\\right|=0 \\\\ & \\lambda=17 \\\\ & D_z=\\left|\\begin{array}{lll}1 & 1 & 6 \\\\ 1 & 2 & 9 \\\\ 1 & 5 & \\mu\\end{array}\\right| \\neq 0 \\\\ & \\mu \\neq 18\\end{aligned}$"
  }
}