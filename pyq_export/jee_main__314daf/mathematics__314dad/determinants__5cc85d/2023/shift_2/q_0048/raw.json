  "question": {
    "text": "For the system of linear equations <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mn>1</mn></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mi>a</mi><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mi>a</mi><mi>z</mi><mo>=</mo><mi>&#946;</mi></math>, which one of the following statements is NOT correct?",
    "image": null
  },
  "options": [
    {
      "id": "YyxW3",
      "text": "It has infinitely many solutions if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><mn>2</mn></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mo>-</mo><mn>1</mn></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "gqui2",
      "text": "It has no solution if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><mo>-</mo><mn>2</mn></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Eq62i",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></math> if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><mn>2</mn></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mn>1</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
