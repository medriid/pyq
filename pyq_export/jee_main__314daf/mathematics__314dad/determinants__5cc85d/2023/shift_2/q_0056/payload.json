      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mrow><mo>-</mo><mn>72</mn></mrow><mn>5</mn></mfrac><mo>,</mo><mfrac><mrow><mo>-</mo><mn>21</mn></mrow><mn>5</mn></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mn>72</mn><mn>5</mn></mfrac><mo>,</mo><mfrac><mrow><mo>-</mo><mn>21</mn></mrow><mn>5</mn></mfrac></mrow></mfenced></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mrow><mo>-</mo><mn>72</mn></mrow><mn>5</mn></mfrac><mo>,</mo><mfrac><mn>21</mn><mn>5</mn></mfrac></mrow></mfenced></math>",
