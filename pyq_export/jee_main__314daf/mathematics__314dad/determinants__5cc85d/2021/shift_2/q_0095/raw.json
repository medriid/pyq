  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi><mo>=</mo><mfenced open=\"|\" close=\"|\"><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>6</mn></mtd><mtd><mo>-</mo><mn>11</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mo>-</mo><mn>2</mn></mtd><mtd><mn>7</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>20</mn><mo>-</mo><mn>2</mn><mo>(</mo><mn>25</mn><mo>)</mo><mo>-</mo><mn>3</mn><mo>(</mo><mo>-</mo><mn>10</mn><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>20</mn><mo>-</mo><mn>50</mn><mo>+</mo><mn>30</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>D</mi><mn>1</mn></msub><mo>=</mo><mfenced open=\"|\" close=\"|\"><mtable><mtr><mtd><mi>a</mi></mtd><mtd><mn>2</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd></mtr><mtr><mtd><mi>b</mi></mtd><mtd><mn>6</mn></mtd><mtd><mo>-</mo><mn>11</mn></mtd></mtr><mtr><mtd><mi>c</mi></mtd><mtd><mo>-</mo><mn>2</mn></mtd><mtd><mn>7</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>20</mn><mi>a</mi><mo>-</mo><mn>2</mn><mo>(</mo><mn>7</mn><mi>b</mi><mo>+</mo><mn>11</mn><mi>c</mi><mo>)</mo><mo>-</mo><mn>3</mn><mo>(</mo><mo>-</mo><mn>2</mn><mi>b</mi><mo>-</mo><mn>6</mn><mi>c</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>20</mn><mi>a</mi><mo>-</mo><mn>14</mn><mi>b</mi><mo>-</mo><mn>22</mn><mi>c</mi><mo>+</mo><mn>6</mn><mi>b</mi><mo>+</mo><mn>18</mn><mi>c</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>20</mn><mi>a</mi><mo>-</mo><mn>8</mn><mi>b</mi><mo>-</mo><mn>4</mn><mi>c</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>4</mn><mo>(</mo><mn>5</mn><mi>a</mi><mo>-</mo><mn>2</mn><mi>b</mi><mo>-</mo><mi>c</mi><mo>)</m