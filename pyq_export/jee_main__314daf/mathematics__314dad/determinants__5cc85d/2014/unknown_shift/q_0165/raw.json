    },
    {
      "id": "k6R0q",
      "text": "Depends only on <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nsHyZ",
      "text": "Depends both on <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>",
