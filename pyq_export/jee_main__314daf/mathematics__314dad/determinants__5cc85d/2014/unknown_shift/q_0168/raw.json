    "text": "Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>a</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>x</mi><mo>=</mo><mi>y</mi><mo>+</mo><mi>z</mi><mo>&#8658;</mo><mfenced><mrow><mi>a</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>x</mi><mo>-</mo><mi>y</mi><mo>-</mo><mi>z</mi><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>b</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>y</mi><mo>=</mo><mi>z</mi><mo>+</mo><mi>x</mi><mo>&#8658;</mo><mo>-</mo><mi>x</mi><mo>+</mo><mfenced><mrow><mi>b</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>y</mi><mo>-</mo><mi>z</mi><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>c</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>z</mi><mo>=</mo><mi>y</mi><mo>+</mo><mi>x</mi><mo>=</mo><mo>-</mo><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mfenced><mrow><mi>c</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>z</mi><mo>=</mo><mn>0</mn></math><br /><br />For a non-trivial solution<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mi>a</mi><mo>-</mo><mn>1</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mi>b</mi><mo>-</mo><mn>1</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mi>c</mi><mo>-</mo><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;&#160;&#160;&#160;</mo><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mn>1</mn><mo>-</mo><mi>a</mi></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn><mo>-</mo><mi>b</mi></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn><mo>-</mo><mi>c</mi></mtd></mtr></mtable></mfenced><mo>=</mo><mn>0<