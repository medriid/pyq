    {
      "text": "<math><mi> </mi><mi>y</mi><mo>(</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>–</mo><mn>3</mn><mo>)</mo></math>",
