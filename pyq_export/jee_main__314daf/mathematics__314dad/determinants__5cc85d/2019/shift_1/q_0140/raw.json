  "question": {
    "text": "If the system of linear equations $2 x+2 y+3 z=a$\r\n\r\n$3 x-y+5 z=b$\r\n\r\n$x-3 y+2 z=c$\r\n\r\nwhere, $a, b,$ care non-zero real numbers, has more than onc solution, then",
    "image": null
  },
  "options": [
    {
      "id": "LeLek",
      "text": "$b-c+a=0$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lwqhP",
      "text": "$b-c-a=0$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "TvqQg",
      "text": "$a+b+c=0$",
      "isCorrect": false,
      "image": null
    },
    {
