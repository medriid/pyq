    "text": "<math><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>→</mo><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>-</mo><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><mtext>  </mtext><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>→</mo><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub></math>   <math><mo>(</mo></math> Let  <math><mi>α</mi></math>  is common ratio of  <math><mi>G</mi><mi>P</mi><mo>)</mo></math> <br/><br/> <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><msub><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><msubsup><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow><mrow><mi>r</mi></mrow></msubsup><msubsup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow><mrow><mi>k</mi></mrow></msubsup></mtd><mtd><msub><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><mfenced separators=\"|\"><mrow><msup><mrow><mi>α</mi></mrow><mrow><mi>r</mi><mo>+</mo><mi>k</mi></mrow></msup></mrow></mfenced></mtd><mtd><msub><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><mfenced separators=\"|\"><mrow><msup><mrow><mi>α</mi></mrow><mrow><mi>r</mi><mo>+</mo><mi>k</mi></mrow></msup></mrow></mfenced></mtd></mtr><mtr><mtd><msub><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><msubsup><mrow><mi>a</mi></mrow><mrow><mn>4</mn></mrow><mrow><mi>r</mi></mrow></msubsup><msubsup><mrow><mi>a</mi></mrow><mrow><mn>5</mn></mrow><mrow><mi>k</mi></mrow></msubsup></mtd><mtd><msub><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathv