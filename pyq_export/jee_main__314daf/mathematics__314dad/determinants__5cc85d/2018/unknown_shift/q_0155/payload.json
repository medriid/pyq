    "text": "<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mi>k</mi></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mi>k</mi></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>3</mn><mi>k</mi><mo>+</mo><mn>8</mn></mrow></mfenced><mo>-</mo><mn>3</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>3</mn><mi>k</mi><mo>-</mo><mn>12</mn></mrow></mfenced><mo>+</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>5</mn><mi>k</mi></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>-</mo><mn>4</mn><mi>k</mi><mo>+</mo><mn>44</mn><mo>=</mo><mn>0</mn></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math> <math><mi>k</mi><mo>=</mo><mn>11</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>+</mo><mn>11</mn><mi>y</mi><mo>+</mo><mn>3</mn><mi>z</mi><mo>=</mo><mn>0</mn><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mn>1</mn></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><mi>x</mi><mo>+</mo><mn>11</mn><mi>y</mi><mo>-</mo><mn>2</mn><mi>z</mi><mo>=</mo><mn>0</mn><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mn>2</mn></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>-</mo><mn>3</mn><mi>z</mi><mo>=</mo><mn>0</mn><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mn>3</mn></mfenced></math><br /><br />On solving equations<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mn>1</m