  "question": {
    "text": "The values of $m, n$, for which the system of equations\n$\\begin{aligned}\n& x+y+z=4, \\\\\n& 2 x+5 y+5 z=17, \\\\\n& x+2 y+\\mathrm{m} z=\\mathrm{n}\n\\end{aligned}$\nhas infinitely many solutions, satisfy the equation:"
  },
  "options": [
    {
      "text": "$m^2+n^2-m n=39$",
      "is_correct": true
    },
    {
      "text": "$m^2+n^2-m-n=46$",
      "is_correct": false
    },
    {
      "text": "$m^2+n^2+m+n=64$",
      "is_correct": false
    },
    {
      "text": "$m^2+n^2+m n=68$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{D}=\\left|\\begin{array}{lll}1 & 1 & 1 \\\\ 2 & 5 & 5 \\\\ 1 & 2 & \\mathrm{~m}\\end{array}\\right|=0 \\Rightarrow \\mathrm{m}=2 \\\\ & \\mathrm{D}_3=\\left|\\begin{array}{ccc}1 & 1 & 4 \\\\ 2 & 5 & 17 \\\\ 1 & 2 & \\mathrm{n}\\end{array}\\right|=0 \\Rightarrow \\mathrm{n}=7\\end{aligned}$"
  }
