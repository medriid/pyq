  "level": 2,
  "question": {
    "text": "For which of the following ordered pairs <math><mfenced separators=\"|\"><mrow><mi>&#956;</mi><mo>,</mo><mi></mi><mi>&#948;</mi></mrow></mfenced><mo>,</mo></math> the system of linear equations<br /><math><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>+</mo><mn>3</mn><mi>z</mi><mo>=</mo><mn>1</mn></math><br /><math><mn>3</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>5</mn><mi>z</mi><mo>=</mo><mi>&#956;</mi></math><br /><math><mn>4</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>4</mn><mi>z</mi><mo>=</mo><mi>&#948;</mi></math><br />is inconsistent?",
    "image": null
  },
  "options": [
    {
      "id": "qyHgy",
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mi></mi><mn>3</mn></mrow></mfenced></math>",
