  "solution": {
    "text": "<p>Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mi>a</mi><mo>=</mo><mi>y</mi><mo>+</mo><mi>b</mi><mo>=</mo><mi>z</mi><mo>+</mo><mi>c</mi><mo>+</mo><mn>1</mn></math></p><p>Now <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><mtable columnalign=\"left\"><mtr><mtd><mi>x</mi></mtd><mtd><mi>a</mi><mo>+</mo><mi>y</mi></mtd><mtd><mi>a</mi><mo>+</mo><mi>x</mi></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi>b</mi><mo>+</mo><mi>y</mi></mtd><mtd><mi>b</mi><mo>+</mo><mi>y</mi></mtd></mtr><mtr><mtd><mi>z</mi></mtd><mtd><mi>c</mi><mo>+</mo><mi>y</mi></mtd><mtd><mi>c</mi><mo>+</mo><mi>z</mi></mtd></mtr></mtable></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><mtable columnalign=\"left\"><mtr><mtd><mi>x</mi></mtd><mtd><mi>a</mi><mo>+</mo><mi>y</mi></mtd><mtd><mi>a</mi></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi>b</mi><mo>+</mo><mi>y</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>z</mi></mtd><mtd><mi>c</mi><mo>+</mo><mi>y</mi></mtd><mtd><mi>c</mi></mtd></mtr></mtable></mfenced><mfenced><mrow><msub><mi>C</mi><mn>3</mn></msub><mo>&#8594;</mo><msub><mi>C</mi><mn>3</mn></msub><mo>-</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"|\" open=\"|\"><mtable columnalign=\"left\"><mtr><mtd><mi>x</mi></mtd><mtd><mi>y</mi></mtd><mtd><mi>a</mi></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mi>y</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>z</mi></mtd><mtd><mi>y</mi></mtd><mtd><mi>c</mi></mtd></mtr></mtable></mfenced><mfenced><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&#8594;</mo><msub><mi>C</mi><mn>2</mn></msub><mo>-</mo><msub><mi>C</mi><mn>3</mn></msub></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>y</mi><mfenced close=\"|\" open=\"|\"><mtable columnalign=\"left\"><mtr><mtd><mi>x</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi>a</mi></mtd></mtr><mtr><mtd><mi>y</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>z</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi>c</mi></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub><mo>&#8594;</mo><msub><mi>R</mi><mn>2</mn></msub><mo>-</mo><msub><mi>R</mi><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>3</mn></msub><mo>&#8594;</mo><msub><mi>R</mi><mn>3</mn></msub><mo>-</mo><msub><mi>R</mi><mn>1</mn></msub></math></p><p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mi>x</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi>a</mi></mtd></mtr><mtr><mtd><mi>y</mi><mo>-</mo><mi>x</mi></mtd><mtd><mn>0</mn></mtd><mtd><mi>b</mi><mo>-</mo><mi>a</mi></mtd></mtr><mtr><mtd><mi>z</mi><mo>-</mo><mi>x</mi></mtd><mtd><mn>0</mn></mtd><mtd><mi>c</mi><mo>-</mo><mi>a</mi></mtd></mtr></mtable></mfenced><mo>=</mo><mi>y</mi><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mi>x</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi>a</mi></mtd></mtr><mtr><mtd><mi>a</mi><mo>-</mo><mi>b</mi></mtd><mtd><mn>0</mn></mtd><mtd><mo>-</mo><mo>(</mo><mi>a</mi><mo>-</mo><mi>b</mi><mo>)</mo></mtd></mtr><mtr><mtd><mi>z</mi><mo>-</mo><mi>x</mi></mtd><mtd><mn>0</mn></mtd><mtd><mi>c</mi><mo>-</mo><mi>a</mi></mtd></mtr></mtable></mfenced><mo>=</mo><mi>y</mi><mo>(</mo><mi>a</mi><mo>-</mo><mi>b</mi><mo>)</mo><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mi>x</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi>a</mi></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr><mtr><mtd><mi>z</mi><mo>-</mo><mi>x</mi></mtd><mtd><mn>0</mn></mtd><mtd><mi>c</mi><mo>-</mo><mi>a</mi></mtd></mtr></mtable></mfenced><mo>=</mo><mo>-</mo><mi>y</mi><mo>(</mo><mi>a</mi><mo>-</mo><mi>b</mi><mo>)</mo><mo>(</mo><mi>c</mi><mo>-</mo><mi>a</mi><mo>+</mo><mi>z</mi><mo>-</mo><mi>x</mi><mo>)</mo><mo>=</mo><mi>y</mi><mo>(</mo><mi>a</mi><mo>-</mo><mi>b</mi><mo>)</mo></math></p>"
