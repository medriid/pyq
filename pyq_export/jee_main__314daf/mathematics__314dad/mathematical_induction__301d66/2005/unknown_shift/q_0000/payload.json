  "question": {
    "text": "If $A=\\left[\\begin{array}{ll}1 & 0 \\\\ 1 & 1\\end{array}\\right]$ and $I=\\left[\\begin{array}{ll}1 & 0 \\\\ 0 & 1\\end{array}\\right]$, then which one of the following holds for all $n \\geq 1$, by the principle of mathematical indunction"
  },
  "options": [
    {
      "text": "\n$A^n=n A-(n-1) I$\n",
      "is_correct": true
    },
    {
      "text": "\n$A^n=2^{n-1} A-(n-1) I$\n",
      "is_correct": false
    },
    {
      "text": "\n$A^n=n A+(n-1) I$\n",
      "is_correct": false
    },
    {
      "text": "\n$A^n=2^{n-1} A+(n-1) I$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "By the principle of mathematical induction (A) is true."
  }
}