  "question": {
    "text": "If $\\mathrm{x}$ is positive, the first negative term in the expansion of $(1+x)^{27 / 5}$ is",
    "image": null
  },
  "options": [
    {
      "id": "Gmddu",
      "text": "\n6th term\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CNAU7",
      "text": "\n7th term\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QGXvK",
      "text": "\n5th term\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "boYSJ",
      "text": "\n8th term",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$T_{r+1}=\\frac{n(n-1)(n-2) \\ldots \\ldots \\ldots(n-r+1)}{r !}(x)^r$\nFor first negative term, $n-r+1 < 0$ or $r>\\frac{32}{5}$\n$\\therefore \\mathrm{r}=7$. Therefore, first negative term is $\\mathrm{T}_8$.",
    "image": null
  },
