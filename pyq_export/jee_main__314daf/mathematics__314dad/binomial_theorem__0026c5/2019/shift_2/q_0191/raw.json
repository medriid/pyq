    "text": "<math><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mo>)</mo></mrow><mrow><mi>n</mi></mrow></msup><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>x</mi><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msup></math><br />Diff. w. r. t. <math><mi>x</mi></math><br /><math><mo>&#8658;</mo><mi>n</mi><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mo>)</mo></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mtext>&#8201;</mtext><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>(</mo><mn>2</mn><mi>x</mi><mo>)</mo><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi></mrow></msub><mi>n</mi><msup><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup></math><br />Multiply by <math><mi>x</mi></math> both side<br /><math><mo>&#8658;</mo><mi>n</mi><mi>x</mi><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mo>)</mo></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>x</mi><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi></mrow></msub><mfenced separators=\"|\"><mrow><mi>n</mi><msup><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msup></mrow></mfenced></math><br />Diff. w. r. t. <math><mi>x</mi></math><br /><math><mo>&#8658;</mo><mi>n</mi><mo>[</mo><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mo>)</mo></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><mo>(</mo><mi>n</mi><mo>-</mo><mn>1</mn><mo>)</mo><mi>x</mi><msup><mrow><mo>(</mo><mn>1</mn><mo>+</mo><mi>x</mi><mo>)</mo></mrow><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></msup><mo>]</mo><mtext>&#8201;</mtext><mo>=</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mtext>&#8201;</mtext><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup><mi>X</mi><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>(</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>)</mo><msup><mrow><mi>x</mi></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup></math><br />Put <math><mi>x</mi><mo>=</mo><mn>1</mn></math> and <math><mi>n</mi><mo>=</mo><mn>20</mn></math><br /><math><mo>&#8658;</mo><msup><mrow><mtext>&#8201;</mtext></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mtext>&#8201;</mtext><msup><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>&#160;</mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mtext>&#8201;&#8201;</mtext><msup><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>&#160;</mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msup><mrow><mo>(</mo><mn>20</mn><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>&#160;</mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>20</mn></mrow></msub></math><br /><math><mo>=</mo><mn>20</mn><mo>&#215;</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>18</mn></mrow></msup><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mn>19</mn></mrow></mfenced><mo>=</mo><mn>420</mn><mfenced separators=\"|\"><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>18</mn></mrow></msup></mrow></mfenced><mo>=</mo><mi>A</mi><mfenced separators=\"|\"><mrow><msup><mrow><mn>2</mn></mrow><mrow><mi>&#946;</mi></mrow></msup></mrow></mfenced></math><br />Hence, <math><mfenced separators=\"|\"><mrow><mi>A</mi><mo>,</mo><mi>&#946;</mi></mrow></mfenced><mo>=</mo><mo>(</mo><mn>420</mn><mo>,</mo><mi>&#160;</mi><mn>18</mn><mo>)</mo></math>",
