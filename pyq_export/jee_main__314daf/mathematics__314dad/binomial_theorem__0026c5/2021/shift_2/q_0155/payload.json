  "solution": {
    "text": "<p>Given&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mfrac><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow><mrow><msup><mi>x</mi><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup><mo>-</mo><msup><mi>x</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow><mrow><mi>x</mi><mo>-</mo><msup><mi>x</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced><mn>10</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced><mrow><mfenced><mrow><msup><mi>x</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mo>-</mo><mfenced><mfrac><mrow><msqrt><mi>x</mi></msqrt><mo>+</mo><mn>1</mn></mrow><msqrt><mi>x</mi></msqrt></mfrac></mfenced></mrow></mfenced><mn>10</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced><mrow><msup><mi>x</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mo>-</mo><msup><mi>x</mi><mrow><mo>-</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfenced><mn>10</mn></msup></math></p><p>General term is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>10</mn><msub><mi>C</mi><mi>r</mi></msub><msup><mfenced><msup><mi>x</mi><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup></mfenced><mrow><mn>10</mn><mo>-</mo><mi>r</mi></mrow></msup><msup><mfenced><mrow><mo>-</mo><msup><mi>x</mi><mrow><mo>-</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfenced><mi>r</mi></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mfrac><mrow><mn>10</mn><mo>-</mo><mi>r</mi></mrow><mn>3</mn></mfrac><mo>-</mo><mfrac><mi>r</mi><mn>2</mn></mfrac><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mn>20</mn><mo>-</mo><mn>2</mn><mi>r</mi><mo>-</mo><mn>3</mn><mi>r</mi><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>r</mi><mo>=</mo><mn>4</mn></math></p><p>Then,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mn>5</mn></msub><mo>=</mo><mmultiscripts><mi>C</mi><mn>4</mn><none></none><mprescripts></mprescripts><none></none><mn>10</mn></mmultiscripts><mo>=</mo><mfrac><mrow><mn>10</mn><mo>&#215;</mo><mn>9</mn><mo>&#215;</mo><mn>8</mn><mo>&#215;</mo><mn>7</mn></mrow><mrow><mn>4</mn><mo>&#215;</mo><mn>3</mn><mo>&#215;</mo><mn>2</mn><mo>&#215;</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mn>210</mn></math></p>"
  }
