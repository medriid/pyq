  "question": {
    "text": "If the coefficients of $r$ th, $(r+1)$ th and $(r+2)$ th terms in the binomial expansion of $(1+$ $y)^m$ are in A.P., then $m$ and $r$ satisfy the equation",
    "image": null
  },
  "options": [
    {
      "id": "7EcsU",
      "text": "\n$m^2-m(4 r-1)+4 r^2-2=0$\n",
