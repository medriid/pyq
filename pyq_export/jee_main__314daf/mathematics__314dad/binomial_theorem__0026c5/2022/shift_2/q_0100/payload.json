math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mi>k</mi><mo>+</mo><msub><mi>n</mi><mn>0</mn></msub><mo>=</mo><mn>24</mn></math></p></blockquote>"
