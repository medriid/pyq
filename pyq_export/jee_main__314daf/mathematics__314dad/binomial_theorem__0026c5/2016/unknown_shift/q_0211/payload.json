  ],
  "solution": {
    "text": "<p>We have,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msup><mi>x</mi><mfrac><mn>1</mn><mn>3</mn></mfrac></msup></mrow></mfrac></mrow></mfenced><mn>18</mn></msup><mo>,</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>&#62;</mo><mn>0</mn></mrow></mfenced></math></p><p>General term,&nbsp;<math><msub><mrow><mi>T</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msup><mrow></mrow><mrow><mn>18</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msup></mrow></mfenced></mrow><mrow><mn>18</mn><mo>-</mo><mi>r</mi></mrow></msup><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msup></mrow></mfrac></mrow></mfenced></mrow><mrow><mi>r</mi></mrow></msup><mo>=</mo><msup><mrow></mrow><mrow><mn>18</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><mi>&#160;</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>6</mn><mo>-</mo><mfrac><mrow><mn>2</mn><mi>r</mi></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msup><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mi>r</mi></mrow></msup></mrow></mfrac></math><br />Now,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"\" open=\"\" separators=\"|\"><mtable><mtr><mtd><mn>6</mn><mo>-</mo><mfrac><mrow><mn>2</mn><mi>r</mi></mrow><mn>3</mn></mfrac><mo>=</mo><mo>-</mo><mn>2</mn></mtd><mtd><mo>&#8658;</mo></mtd><mtd><mi>r</mi><mo>=</mo><mn>12</mn></mtd></mtr></mtable></mfenced></math> and,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"\" open=\"\" separators=\"|\"><mtable><mtr><mtd><mn>6</mn><mo>-</mo><mfrac><mrow><mn>2</mn><mi>r</mi></mrow><mn>3</mn></mfrac><mo>=</mo><mo>-</mo><mn>4</mn></mtd><mtd><mo>&#8658;</mo></mtd><mtd><mi>r</mi><mo>=</mo><mn>15</mn></mtd></mtr></mtable></mfenced></math><br />Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>m</mi><mi>n</mi></mfrac><mo>=</mo><mfrac><mrow><mtext>Coefficient&#160;of</mtext><mo>&#160;</mo><msup><mi>x</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow><mrow><mtext>Coefficient&#160;of</mtext><mo>&#160;</mo><msup><mi>x</mi><mrow><mo>-</mo><mn>4</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mfrac><mmultiscripts><mi>C</mi><mn>12</mn><none/><mprescripts/><none/><mn>18</mn></mmultiscripts><msup><mn>2</mn><mn>12</mn></msup></mfrac><mfrac><mmultiscripts><mi>C</mi><mn>15</mn><none/><mprescripts/><none/><mn>18</mn></mmultiscripts><msup><mn>2</mn><mn>15</mn></msup></mfrac></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mstyle displaystyle=\"true\"><mfrac><mrow><mn>18</mn><mo>!</mo></mrow><mrow><mn>6</mn><mo>!</mo><mo>.</mo><mn>12</mn><mo>!</mo></mrow></mfrac></mstyle><mfrac><mrow><mn>18</mn><mo>!</mo></mrow><mrow><mn>3</mn><mo>!</mo><mo>.</mo><mn>15</mn><mo>!</mo></mrow></mfrac></mfrac><mo>&#215;</mo><msup><mn>2</mn><mn>3</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>15</mn><mo>&#215;</mo><mn>14</mn><mo>&#215;</mo><mn>13</mn></mrow><mrow><mn>6</mn><mo>&#215;</mo><mn>5</mn><mo>&#215;</mo><mn>4</mn></mrow></mfrac><mo>&#215;</mo><msup><mn>2</mn><mn>3</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>182</mn></math></p>"
  }
