    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>64</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2187</mn></math>",
      "is_correct": false
    }
  ],
