  "question": {
    "text": "The sum of the rational terms in the binomial expansion of $\\left(2^{\\frac{1}{2}}+3^{\\frac{1}{5}}\\right)^{10}$ is :",
    "image": null
  },
  "options": [
    {
      "id": "VkRAX",
      "text": "\n25\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MKIsR",
      "text": "\n32\n",
      "image": null,
      "isCorrect": false
    },
    {
