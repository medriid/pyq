  "question": {
    "text": "Suppose A and B are the coefficients of $30^{\\text {th }}$ and $12^{\\text {th }}$ terms respectively in the binomial expansion of $(1+x)^{2 \\mathrm{n}-1}$. If $2 \\mathrm{~A}=5 \\mathrm{~B}$, then n is equal to :"
  },
  "options": [
    {
      "text": "22",
      "is_correct": false
    },
    {
      "text": "20",
      "is_correct": false
    },
    {
      "text": "21",
      "is_correct": true
    },
    {
      "text": "19",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{A}={ }^{2 \\mathrm{n}-1} \\mathrm{C}_{29} \\quad \\mathrm{~B}={ }^{2 \\mathrm{n}-1} \\mathrm{C}_{11} \\\\ & 2^{2 \\mathrm{n}-1} \\mathrm{C}_{29}=5{ }^{2 \\mathrm{n}-1} \\mathrm{C}_{11} \\\\ & 2 \\frac{(2 \\mathrm{n}-1)!}{29!(2 \\mathrm{n}-30)!}=5 \\frac{(2 \\mathrm{n}-1)!}{(2 \\mathrm{n}-12)!11!} \\\\ & \\frac{1}{29 \\ldots 12 \\cdot 5}=\\frac{1}{(2 \\mathrm{n}-12)(2 \\mathrm{n}-13) \\ldots(2 \\mathrm{n}-29) 2} \\\\ & \\frac{1}{30 \\cdot 29 \\ldots 12}=\\frac{1}{(2 \\mathrm{n}-12)(2 \\mathrm{n}-13) \\ldots(2 \\mathrm{n}-29) 12} \\\\ & 2 \\mathrm{n}-12=30 \\\\ & \\mathrm{n}=21\\end{aligned}$"
  }
