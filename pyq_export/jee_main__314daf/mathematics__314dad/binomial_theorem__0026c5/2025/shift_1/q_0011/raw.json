  "question": {
    "text": "The term independent of $x$ in the expansion of $\\left(\\frac{(x+1)}{\\left(x^{2 / 3}+1-x^{1 / 3}\\right)}-\\frac{(x+1)}{\\left(x-x^{1 / 2}\\right)}\\right)^{10}, x\\gt1$ is:",
    "image": null
  },
  "options": [
    {
      "id": "bXpdA",
      "text": "$210$",
      "image": null,
      "isCorrect": true
    },
