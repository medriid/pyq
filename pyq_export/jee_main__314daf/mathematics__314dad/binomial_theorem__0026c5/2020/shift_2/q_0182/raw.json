  "correctValue": "51",
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mn>25</mn></munderover><msup><mfenced separators=\"|\"><mrow><mn>4</mn><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mn>25</mn></msup><msub><mi>C</mi><mi>r</mi></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>4</mn><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mn>25</mn></munderover><mi>r</mi><msup><mo>.</mo><mn>25</mn></msup><msub><mi>C</mi><mi>r</mi></msub><mo>+</mo><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mn>25</mn></munderover><mmultiscripts><mi>C</mi><mi>r</mi><none/><mprescripts/><mrow/><mn>25</mn></mmultiscripts></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>4</mn><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mn>25</mn></munderover><mi>r</mi><mo>&#215;</mo><mfrac><mn>25</mn><mi>r</mi></mfrac><mmultiscripts><mi>C</mi><mrow><mi>r</mi><mo>-</mo><mn>1</mn></mrow><none/><mprescripts/><mrow/><mn>24</mn></mmultiscripts><mo>+</mo><msup><mn>2</mn><mn>25</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>100</mn><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mn>25</mn></munderover><mmultiscripts><mi>C</mi><mrow><mi>r</mi><mo>-</mo><mn>1</mn></mrow><none/><mprescripts/><mrow/><mn>25</mn></mmultiscripts><mo>+</mo><msup><mn>2</mn><mn>25</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mn>100.2</mn><mn>24</mn></msup><mo>+</mo><msup><mn>2</mn><mn>25</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mn>2</mn><mn>25</mn></msup><mfenced separators=\"|\"><mrow><mn>50</mn><mo>+</mo><mn>1</mn></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>51</mn><msup><mo>.2</mo><mn>25</mn></msup></math><br />So,&n