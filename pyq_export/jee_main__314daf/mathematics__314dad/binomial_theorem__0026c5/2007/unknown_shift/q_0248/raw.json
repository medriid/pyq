  "question": {
    "text": "In the binomial expansion of $(a-b)^n, n \\geq 5$, the sum of $5^{\\text {th }}$ and $6^{\\text {th }}$ terms is zero, then $\\frac{a}{b}$ equals",
    "image": null
  },
  "options": [
    {
      "id": "fWLD2",
      "text": "\n$\\frac{5}{n-4}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tqlS5",
      "text": "\n$\\frac{6}{n-5}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZgsVr",
      "text": "\n$\\frac{n-5}{6}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9pI4P",
      "text": "\n$\\frac{n-4}{5}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "${ }^n C_4 a^{n-4}(-b)^4+{ }^n C_5 a^{n-5}(-b)^5=0$\n$\\Rightarrow\\left(\\frac{a}{b}\\right)=\\frac{n-5+1}{5}$.",
    "image": null
  },
