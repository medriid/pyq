  "question": {
    "text": "Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>t</mi></mfenced></math>&nbsp;denote the greatest integer&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8804;</mo><mi>t</mi></math>. if the&nbsp;constant term in the expansion of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mfrac><mn>1</mn><mrow><mn>2</mn><msup><mi>x</mi><mn>5</mn></msup></mrow></mfrac></mrow></mfenced><mn>7</mn></msup></math>&nbsp;is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>&nbsp;then&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>&#945;</mi></mfenced></math>&nbsp;is equal to&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi><mi>_</mi></math>",
    "image": null
  },
