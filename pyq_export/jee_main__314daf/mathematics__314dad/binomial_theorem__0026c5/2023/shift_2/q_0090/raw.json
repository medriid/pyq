  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><msup><mfenced><mrow><mn>8</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>13</mn></mrow></mfenced><mn>13</mn></msup></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msup><mfenced><mrow><mn>7</mn><msqrt><mn>2</mn></msqrt><mo>+</mo><mn>9</mn></mrow></mfenced><mn>9</mn></msup></math>. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mi>t</mi></mfenced></math> denotes the greatest integer <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8804;</mo><mi mathvariant=\"normal\">t</mi></math>, then",
    "image": null
  },
  "options": [
    {
      "id": "VgTfr",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>x</mi></mfenced><mo>+</mo><mfenced open=\"[\" close=\"]\"><mi>y</mi></mfenced></math> is even",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "X62V0",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>x</mi></mfenced></math> is odd but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>y</mi></mfenced></math> is even",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1b9s9",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>x</mi></mfenced></math> is even but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>y</mi></mfenced></math> is odd",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Dc12R",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>x</mi></mfenced></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mi>y</mi></mfenced></math> are both odd",
      "isCorrect": false,
      "image": null
