  "question": {
    "text": "The absolute difference of the coefficients of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>10</mn></msup></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>7</mn></msup></math>&nbsp;in the expansion of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>x</mi></mrow></mfrac></mrow></mfenced><mn>11</mn></msup></math> is equal to",
    "image": null
  },
  "options": [
    {
      "id": "WQjx9",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>13</mn><mn>3</mn></msup><mo>-</mo><mn>13</mn></math>",
