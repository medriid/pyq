  "question": {
    "text": "<p>Among the statements :</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>S</mi><mn>1</mn><mo>)</mo><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><msup><mn>2023</mn><mn>2022</mn></msup><mo>-</mo><msup><mn>1999</mn><mn>2022</mn></msup></math>&nbsp;is divisible by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn></math>.</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>S</mi><mn>2</mn><mo>)</mo><mo>&#160;</mo><mo>:</mo><mo>&#160;</mo><mn>13</mn><mo>(</mo><mn>13</mn><msup><mo>)</mo><mi>n</mi></msup><mo>-</mo><mn>11</mn><mi>n</mi><mo>-</mo><mn>13</mn></math>&nbsp;is divisible by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>144</mn></math>&nbsp;for infinitely many&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>&#8712;</mo><mi mathvariant=\"normal\">&#8469;</mi></math></p>"
  },
  "options": [
    {
      "text": "Only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;is correct",
      "is_correct": false
    },
    {
      "text": "Only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>S</mi><mn>1</mn><mo>)</mo></math>&nbsp;is correct",
      "is_correct": true
    },
    {
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>1</mn></mrow></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;are correct",
      "is_correct": false
    },
    {
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>1</mn></mrow></mfenced></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>S</mi><mn>2</mn></mrow></mfenced></math>&nbsp;are incorrect",
      "is_correct": false
    }
