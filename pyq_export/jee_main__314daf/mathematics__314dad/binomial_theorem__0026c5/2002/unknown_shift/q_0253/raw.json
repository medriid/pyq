  "question": {
    "text": "The coefficients of $x^p$ and $x^q$ in the expansion of $(1+x)^{p+q}$ are",
    "image": null
  },
  "options": [
    {
      "id": "sSANN",
      "text": "\nequal\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "c3chh",
      "text": "\nequal with opposite signs\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MdfYm",
      "text": "\nreciprocals of each other\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sg62w",
      "text": "\nnone of these",
      "image": null,
      "isCorrect": false
