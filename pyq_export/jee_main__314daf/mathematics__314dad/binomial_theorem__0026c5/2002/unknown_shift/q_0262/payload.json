  "question": {
    "text": "The coefficients of $x^p$ and $x^q$ in the expansion of $(1+x)^{p+q}$ are"
  },
  "options": [
    {
      "text": "\nequal\n",
      "is_correct": true
    },
    {
      "text": "\nequal with opposite signs\n",
      "is_correct": false
    },
    {
      "text": "\nreciprocals of each other\n",
      "is_correct": false
    },
    {
      "text": "\nnone of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "We have $t_{p+1}={ }^{p+q} C_p x^p$ and $t_{q+1}={ }^{p+q} C_q x^q \\quad{ }^{p+q} C_p={ }^{p+q} C_q$"
  }
