  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/f3860b30-4114-4c0a-9e58-c386560273cb-image.png\" style=\"width: 214px; height: 238px;\" /></p><p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8736;</mo><mi>A</mi><mi>B</mi><mi>C</mi><mo>=</mo><mo>&#8736;</mo><mi>B</mi><mi>C</mi><mi>D</mi><mo>=</mo><mi>&#945;</mi><mo>,</mo><mo>&#160;</mo><mo>&#8736;</mo><mi>A</mi><mi>C</mi><mi>B</mi><mo>=</mo><mi>&#952;</mi></math>&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mi>D</mi><mo>=</mo><mi>A</mi><mi>E</mi><mo>=</mo><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mi>D</mi><mi>E</mi><mo>=</mo><mi>a</mi></math></p><p>From Diagram</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>(</mo><mi>&#952;</mi><mo>+</mo><mi>&#945;</mi><mo>)</mo><mo>=</mo><mfrac><mi>x</mi><mi>b</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#945;</mi><mo>=</mo><mfrac><mi>x</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#952;</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>(</mo><mi>&#952;</mi><mo>+</mo><mi>&#945;</mi><mo>)</mo><mo>=</mo><mfrac><mrow><mi>tan</mi><mi>&#952;</mi><mo>+</mo><mi>tan</mi><mi>&#945;</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mi>&#952;</mi><mi>tan</mi><mi>&#945;</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mfrac><mi>x</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfrac></mrow><mrow><mn>1</mn><mo>&#8722;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#8901;</mo><mfrac><mi>x</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfrac></mrow></mfrac><mo>=</mo><mfrac><mi>x</mi><mi>b</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mn>2</mn><mi>x</mi></mrow><mrow><mn>2</mn><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo><mo>&#8722;</mo><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mi>x</mi><mi>b</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>b</mi><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>b</mi><mi>x</mi><mo>=</mo><mn>2</mn><mi>a</mi><mi>x</mi><mo>+</mo><mn>2</mn><mi>b</mi><mi>x</mi><mo>&#8722;</mo><msup><mi>x</mi><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>&#8722;</mo><mn>2</mn><mi>a</mi><mi>x</mi><mo>+</mo><mi>a</mi><mi>b</mi><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mi>a</mi><mi>x</mi><mo>+</mo><mi>b</mi><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo><mo>=</mo><mn>0</mn></math></p>",
