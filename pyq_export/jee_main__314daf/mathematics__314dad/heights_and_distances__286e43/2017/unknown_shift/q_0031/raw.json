  "correctValue": null,
  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/28d99d18-3b4c-4191-8f65-01dfe3a317ba-image.png\" style=\"width: 300px; height: 166px;\" /></p><p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8736;</mo><mi>A</mi><mi>P</mi><mi>C</mi><mo>=</mo><mi>&#945;</mi></math><br />Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mi>A</mi><mi>C</mi></mrow></mfenced><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mi>B</mi><mi>C</mi></mrow></mfenced></math><br /><br />Also&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>P</mi><mo>=</mo><mn>2</mn><mi>A</mi><mi>B</mi><mo>&#8658;</mo><mi>A</mi><mi>P</mi><mo>=</mo><mn>4</mn><mfenced separators=\"|\"><mrow><mi>A</mi><mi>C</mi></mrow></mfenced><mo>=</mo><mn>4</mn><mfenced separators=\"|\"><mrow><mi>B</mi><mi>C</mi></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>tan</mi><mi>&#945;</mi><mo>=</mo><mfrac><mrow><mi>A</mi><mi>C</mi></mrow><mrow><mi>A</mi><mi>P</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>A</mi><mi>C</mi></mrow><mrow><mn>4</mn><mfenced separators=\"|\"><mrow><mi>A</mi><mi>C</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>tan</mi><mfenced separators=\"|\"><mrow><mi>&#945;</mi><mo>+</mo><mi>&#946;</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi>A</mi><mi>B</mi></mrow><mrow><mi>A</mi><mi>P</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>A</mi><mi>B</mi></mrow><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mi>A</mi><mi>B</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><br />Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#946;</mi><mo>=</mo><mi>x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>tan</mi><mi>&#945;</mi><mo>+</mo><mi>tan</mi><mi>&#946;</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mi>&#945;</mi><mi>&#160;</mi><mo>&#8901;</mo><mi>tan</mi><mi>&#946;</mi></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mfrac><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>+</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>-</mo><mfrac><mi>x</mi><mn>4</mn></mfrac></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mfrac><mrow><mn>1</mn><mo>+</mo><mn>4</mn><mi>x</mi></mrow><mrow><mn>4</mn><mo>-</mo><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mn>2</mn><mo>+</mo><mn>8</mn><mi>x</mi><mo>-</mo><mn>4</mn><mo>+</mo><mi>x</mi><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mn>9</mn><mi>x</mi><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>x</mi><mo>=</mo><mfrac><mn>2</mn><mn>9</mn></mfrac></math></p>",
