  "solution": {
    "text": "<p><img src=\"assets\\st0039_33bfe6946ace.png\" style=\"width: 260px; height: 163px;\" /></p><p>Let <math><mi>&#8736;</mi><mi>B</mi><mi>D</mi><mi>C</mi><mo>=</mo><mi>&#945;</mi></math>, then<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#945;</mi><mo>=</mo><mfrac><mrow><mi>B</mi><mi>C</mi></mrow><mrow><mi>C</mi><mi>D</mi></mrow></mfrac><mo>=</mo><mfrac><mi>p</mi><mi>q</mi></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>E</mi><mo>=</mo><mi>B</mi><mi>C</mi><mo>=</mo><mi>p</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mfenced><mrow><mi>&#945;</mi><mo>+</mo><mi>&#952;</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi>A</mi><mi>E</mi></mrow><mrow><mi>E</mi><mi>D</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>E</mi><mi>D</mi><mo>=</mo><mfrac><mi>p</mi><mrow><mi>tan</mi><mfenced><mrow><mi>&#945;</mi><mo>+</mo><mi>&#952;</mi></mrow></mfenced></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi>p</mi><mfenced><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mi>&#945;</mi><mi>tan</mi><mi>&#952;</mi></mrow></mfenced></mrow><mrow><mi>tan</mi><mi>&#945;</mi><mo>+</mo><mi>tan</mi><mi>&#952;</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi>p</mi><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mi>p</mi><mn>q</mn></mfrac><mi>tan</mi><mi>&#952;</mi></mrow></mfenced></mrow><mrow><mfrac><mi>p</mi><mi>q</mi></mfrac><mo>+</mo><mi>tan</mi><mi>&#952;</mi></mrow></mfrac></math><br /><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mi>q</mi><mo>-</mo><mi>E</mi><mi>D</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>q</mi><mo>-</mo><mfrac><mrow><mi>p</mi><mfenced><mrow><mi>q</mi><mo>-</mo><mi>p</mi><mi>tan</mi><mi>&#952;</mi></mrow></mfenced></mrow><mrow><mfrac><mi>p</mi><mi>q</mi></mfrac><mo>+</mo><mi>q</mi><mi>tan</mi><mi>&#952;</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi>p</mi><mi>q</mi><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mi>tan</mi><mi>&#952;</mi><mo>-</mo><mi>p</mi><mi>q</mi><mo>+</mo><msup><mi>p</mi><mn>2</mn></msup><mi>tan</mi><mi>&#952;</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi><mi>tan</mi><mi>&#952;</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mfenced><mrow><msup><mi>p</mi><mn>2</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mfenced><mi>tan</mi><mi>&#952;</mi></mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi><mi>tan</mi><mi>&#952;</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mfenced><mrow><msup><mi>p</mi><mn>2</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mfenced><mi>sin</mi><mi>&#952;</mi></mrow><mrow><mi>p</mi><mi>cos</mi><mi>&#952;</mi><mo>+</mo><mi>q</mi><mi>sin</mi><mi>&#952;</mi></mrow></mfrac></math></p>"
