  "question": {
    "text": "A lizard, at an initial distance of $21 \\mathrm{~cm}$ behind an insect, moves from rest with an acceleration of $2 \\mathrm{~cm} / \\mathrm{s}^2$ and pursues the insect which is crawling uniformly along a straight line at a speed of $20 \\mathrm{~cm} / \\mathrm{s}$. Then the lizard will catch the insect after"
  },
  "options": [
    {
      "text": "\n$20 \\mathrm{~s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$1 \\mathrm{~s}$\n",
      "is_correct": false
    },
    {
      "text": "\n$21 \\mathrm{~s}$\n",
      "is_correct": true
    },
    {
      "text": "\n$24 \\mathrm{~s}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\frac{1}{2} 2 t^2=21+20 t \\\\\n& \\Rightarrow t=21 .\n\\end{aligned}\n$$"
  }
}