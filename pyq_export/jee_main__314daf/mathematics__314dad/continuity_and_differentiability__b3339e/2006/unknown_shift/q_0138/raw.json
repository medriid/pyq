  "question": {
    "text": "The set of points where $f(x)=\\frac{x}{1+|x|}$ is differentiable is",
    "image": null
  },
  "options": [
    {
      "id": "UgK4q",
      "text": "\n$(-\\infty, 0) \\cup(0, \\infty)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oSSkH",
      "text": "\n$(-\\infty,-1) \\cup(-1, \\infty)$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QmfZ5",
      "text": "\n$(-\\infty, \\infty)$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "e4Zb7",
      "text": "\n$(0, \\infty)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\nf(x)=\\left\\{\\begin{array}{ll}\n\\frac{x}{1-x}, & x < 0 \\\\\n\\frac{x}{1+x}, & x \\geq 0\n\\end{array} \\quad \\Rightarrow f^{\\prime}(x)= \\begin{cases}\\frac{1}{(1-x)^2}, & x < 0 \\\\\n\\frac{1}{(1+x)^2}, & x \\geq 0\\end{cases}\\right.\n$$\n$\\therefore f^{\\prime}(x)$ exist at everywhere.",
    "image": null
  },
