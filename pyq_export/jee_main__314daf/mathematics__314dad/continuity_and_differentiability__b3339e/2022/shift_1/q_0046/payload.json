    "text": "<blockquote><p>Given,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\"><mtable><mtr><mtd><mfenced close=\"|\" open=\"|\"><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>x</mi><mo>+</mo><mn>5</mn></mrow></mfenced><mo>,</mo></mtd><mtd><mi>if</mi><mo>&#160;</mo><mn>8</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>6</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>&#8805;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mfenced close=\"]\" open=\"[\"><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>x</mi><mo>+</mo><mn>5</mn></mrow></mfenced><mo>,</mo></mtd><mtd><mi>if</mi><mo>&#160;</mo><mn>8</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>6</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>&#60;</mo><mn>0</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced close=\"\" open=\"{\"><mtable><mtr><mtd><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>x</mi><mo>+</mo><mn>5</mn><mo>,</mo></mtd><mtd><mi>if</mi><mo>&#160;</mo><mi>x</mi><mo>&#8712;</mo><mfenced close=\"]\" open=\"[\"><mrow><mo>&#8722;</mo><mo>&#8734;</mo><mo>,</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></mrow></mfenced><mo>&#8746;</mo><mfenced open=\"[\"><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>,</mo><mo>&#8734;</mo></mrow></mfenced></mtd></mtr><mtr><mtd><mfenced close=\"]\" open=\"[\"><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>x</mi><mo>+</mo><mn>5</mn></mrow></mfenced></mtd><mtd><mi>if</mi><mo>&#160;</mo><mi>x</mi><mo>&#8712;</mo><mfenced><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>,</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\"><mrow><mtable><mtr><mtd><mn>4</mn><msup><mi>x</mi><m