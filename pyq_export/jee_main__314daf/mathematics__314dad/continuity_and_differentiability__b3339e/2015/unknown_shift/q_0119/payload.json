    "B"
  ],
  "solution": {
    "text": "LHD at&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>3</mn></math><br /><br /><math><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#10230;</mo><msup><mrow><mn>3</mn></mrow><mrow><mo>-</mo></mrow></msup></mrow></munder></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>k</mi><msqrt><mi>x</mi><mo>+</mo><mn>1</mn></msqrt><mo>-</mo><mn>2</mn><mi>k</mi></mrow><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfrac></mrow></mfenced></mrow></mrow></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><msup><mrow><mn>3</mn></mrow><mrow><mo>-</mo></mrow></msup></mrow></munder></mrow><mo>&#8289;k</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>.</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mi>x</mi><mo>+</mo><mn>1</mn></msqrt><mo>+</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>k</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mrow></math><br /><br />RHD at&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>3</mn></math><br /><br /><math><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><msup><mrow><mn>3</mn></mrow><mrow><mo>+</mo></mrow></msup></mrow></munder></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>m</mi><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>-</mo><mn>2</mn><mi>k</mi></mrow><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfrac></mrow></mrow></math><br /><br />Since this limit exists if&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>m</mi><mo>+</mo><mn>2</mn><mo>-</mo><mn>2</mn><mi>k</mi><mo>=</mo><mn>0</mn><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced><mi mathvariant=\"normal\">i</mi></mfenced></math>&nbsp;(<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>0</mn><mn>0</mn></mfrac></math>&nbsp;form)<br /><br />So,<math><mrow><mrow><munder><mrow><mi mathvariant=\"normal\">lim</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><msup><mrow><mn>3</mn></mrow><mrow><mo>+</mo></mrow></msup></mrow></munder></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>m</mi><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mi>m</mi><mo>+</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfrac><mo>=</mo><mi>m</mi></mrow></mrow></math><br /><br />Hence <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mfrac><mi>k</mi><mn>4</mn></mfrac><mo>&#160;</mo><mo>&#8230;</mo><mfenced><mi>ii</mi></mfenced></math><br /><br />From&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">i</mi></mfenced><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mfenced><mi>ii</mi></mfenced></math><br /><br /><math><mi>m</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mi>&#160;</mi><mo>&#38;</mo><mi>&#160;</mi><mi>k</mi><mo>=</mo><mfrac><mrow><mn>8</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mi>&#160;</mi><mi>&#160;</mi><mo>&#8658;</mo><mi>k</mi><mo>+</mo><mi>m</mi><mo>=</mo><mn>2</mn></math>&nbsp;"
  }
