  "question": {
    "text": "Let the function $f(x)=\\left(x^2+1\\right)\\left|x^2-a x+2\\right|+\\cos |x|$ be not differentiable at the two points $x=\\alpha=2$ and $x=\\beta$. Then the distance of the point $(\\alpha, \\beta)$ from the line $12 x+5 y+10=0$ is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "wk3DH",
      "text": "5",
      "image": null,
      "isCorrect": false
    },
    {
