    },
    {
      "id": "LKrQu",
      "text": "<math><mo>{</mo><mn>5</mn><mo>,</mo><mi> </mi><mn>10</mn><mo>,</mo><mi> </mi><mn>15</mn><mo>,</mo><mi> </mi><mn>20</mn><mo>}</mo></math>",
