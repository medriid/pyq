    {
      "text": "differentiable if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mi>'</mi></msup><mfenced separators=\"|\"><mi>c</mi></mfenced><mo>&#8800;</mo><mn>0</mn></math>",
      "is_correct": false
