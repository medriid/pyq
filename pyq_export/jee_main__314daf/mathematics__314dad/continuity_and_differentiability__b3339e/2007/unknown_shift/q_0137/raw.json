  "question": {
    "text": "Let $f: R \\rightarrow R$ be a function defined by $f(x)=\\operatorname{Min}\\{x+1,|x|+1\\}$. Then which of the following is true?",
    "image": null
  },
  "options": [
    {
      "id": "gMW7f",
      "text": "\n$f(x) \\geq 1$ for all $x \\in R$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GFi7c",
      "text": "\n$f(x)$ is not differentiable at $x=1$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yfH7z",
      "text": "\n$f(x)$ is differentiable everywhere\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "FQsbb",
      "text": "\n$f(x)$ is not differentiable at $x=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$f(x)=\\min \\{x+1,|x|+1\\}$\n$f(x)=x+1 \\forall x \\in R$.\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/PM6pTJ_Cv1cfSaOXPCyxKRt8G3SnRBjS7rvYa2iBQgc.original.fullsize.png\"><br>",
