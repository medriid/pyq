      "text": "\n$f(x) \\geq 1$ for all $x \\in R$\n",
      "is_correct": false
    },
    {
      "text": "\n$f(x)$ is not differentiable at $x=1$\n",
      "is_correct": false
    },
    {
      "text": "\n$f(x)$ is differentiable everywhere\n",
      "is_correct": true
    },
    {
      "text": "\n$f(x)$ is not differentiable at $x=0$",
      "is_correct": false
    }
  ],
