arators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>+</mo><mi>C</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>C</mi><mi>&#160;</mi><mo>=</mo><mn>13</mn><mi>log</mi><mo>&#8289;</mo><mrow><mo>(</mo><mn>2</mn><mo>)</mo></mrow></math><br /><br />If <math><mi>x</mi><mo>=</mo><mi>&#160;</mi><mo>-</mo><mn>4</mn><mo>,</mo></math> then <math><mi>y</mi></math><br /><br /><math><mi>y</mi><mo>=</mo><mfrac><mrow><mn>16</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mn>8</mn><mo>-</mo><mn>13</mn><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>&#8289;</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mn>13</mn><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>&#8289;</mo><mrow><mo>|</mo><mn>2</mn><mo>|</mo></mrow></mrow></mrow></mrow></math><br /><br /><math><mi>y</mi><mo>=</mo><mn>0</mn></math><br /><br />Hence, answer is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn></math>."
