      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><msup><mi>e</mi><msqrt><mn>2</mn><mi>e</mi></msqrt></msup><mn>2</mn></msup></math>",
      "is_correct": false
