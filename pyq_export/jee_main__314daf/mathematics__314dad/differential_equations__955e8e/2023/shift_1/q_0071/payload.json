    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msup><mi>e</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mfenced><mrow><mn>3</mn><msup><mi>e</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mfrac></math>",
