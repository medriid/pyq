    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>3</mn><msup><mi>x</mi><mn>3</mn></msup><mfenced><mrow><mn>1</mn><mo>+</mo><msub><mi>log</mi><mi>e</mi></msub><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mo>-</mo><mn>2</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>7</mn><mo>-</mo><mn>3</mn><msup><mi>x</mi><mn>3</mn></msup><mfenced><mrow><mn>2</mn><mo>+</mo><msub><mi>log</mi><mi>e</mi></msub><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced></mrow></mfrac></math>",
