    "text": "<p>Given,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><msup><mi mathvariant=\"normal\">x</mi><mn>2</mn></msup><mo>-</mo><mn>4</mn></mrow></mfenced><mi>dy</mi><mo>-</mo><mfenced><mrow><msup><mi mathvariant=\"normal\">y</mi><mn>2</mn></msup><mo>-</mo><mn>3</mn><mi mathvariant=\"normal\">y</mi></mrow></mfenced><mi>dx</mi><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mo>∫</mo><mfrac><mi>dy</mi><mrow><msup><mi mathvariant=\"normal\">y</mi><mn>2</mn></msup><mo>-</mo><mn>3</mn><mi mathvariant=\"normal\">y</mi></mrow></mfrac><mo>=</mo><mo>∫</mo><mfrac><mi>dx</mi><mrow><msup><mi mathvariant=\"normal\">x</mi><mn>2</mn></msup><mo>-</mo><mn>4</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>∫</mo><mfrac><mrow><mi mathvariant=\"normal\">y</mi><mo>-</mo><mo>(</mo><mi mathvariant=\"normal\">y</mi><mo>-</mo><mn>3</mn><mo>)</mo></mrow><mrow><mi mathvariant=\"normal\">y</mi><mo>(</mo><mi mathvariant=\"normal\">y</mi><mo>-</mo><mn>3</mn><mo>)</mo></mrow></mfrac><mi>dy</mi><mo>=</mo><mo>∫</mo><mfrac><mi>dx</mi><mrow><msup><mi mathvariant=\"normal\">x</mi><mn>2</mn></msup><mo>-</mo><mn>4</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>∫</mo><mfenced><mrow><mfrac><mn>1</mn><mrow><mi mathvariant=\"normal\">y</mi><mo>-</mo><mn>3</mn></mrow></mfrac><mo>-</mo><mfrac><mn>1</mn><mi mathvariant=\"normal\">y</mi></mfrac></mrow></mfenced><mi>dy</mi><mo>=</mo><mo>∫</mo><mfrac><mi>dx</mi><mrow><msup><mi mathvariant=\"normal\">x</mi><mn>2</mn></msup><mo>-</mo><msup><mn>2</mn><mn>2</mn></msup></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mfenced><mrow><mi>log</mi><mo>|</mo><mi mathvariant=\"normal\">y</mi><mo>-</mo><mn>3</mn><mo>|</mo><mo>-</mo><mi>log</mi><mo>|</mo>