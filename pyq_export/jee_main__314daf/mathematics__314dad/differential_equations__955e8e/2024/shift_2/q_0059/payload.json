      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p>Given: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>x</mi><mi>cos</mi><mfenced><mfrac><mi>y</mi><mi>x</mi></mfrac></mfenced></mrow></mfenced><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mi>y</mi><mi>cos</mi><mfenced><mfrac><mi>y</mi><mi>x</mi></mfrac></mfenced><mo>+</mo><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>cos</mi><mfenced><mfrac><mi>y</mi><mi>x</mi></mfrac></mfenced><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mi>y</mi><mi>x</mi></mfrac><mi>cos</mi><mfenced><mfrac><mi>y</mi><mi>x</mi></mfrac></mfenced><mo>+</mo><mn>1</mn></math></p><p>Putting, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mi>v</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mi>v</mi><mo>+</mo><mi>x</mi><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>cos</mi><mi>v</mi><mfenced><mrow><mi>v</mi><mo>+</mo><mi>x</mi><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></mrow></mfenced><mo>=</mo><mi>v</mi><mi>cos</mi><mi>v</mi><mo>+</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>v</mi><mo>+</mo><mi>x</mi><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mi>v</mi><mo>+</mo><mfrac><mn>1</mn><mrow><mi>cos</mi><mi>v</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>x</mi><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mi>cos</mi><mi>v</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfenced><mrow><mi>cos</mi><mi>v</mi></mrow></mfenced><mi>d</mi><mi>v</mi><mo>=</mo><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mi>x</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mo>∫</mo><mfenced><mrow><mi>cos</mi><mi>v</mi></mrow></mfenced><mi>d</mi><mi>v</mi><mo>=</mo><mo>∫</mo><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mi>x</mi></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>sin</mi><mi>v</mi><mo>=</mo><mi>log</mi><mfenced close=\"|\" open=\"|\"><mi>x</mi></mfenced><mo>+</mo><mi>c</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>sin</mi><mfenced><mfrac><mi>y</mi><mi>x</mi></mfrac></mfenced><mo>=</mo><mi>log</mi><mfenced close=\"|\" open=\"|\"><mi>x</mi></mfenced><mo>+</mo><mi>c</mi></math></p><p>Now, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced><mn>1</mn></mfenced><mo>=</mo><mfrac><mi>π</mi><mn>3</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>sin</mi><mfenced><mfrac><mi>π</mi><mn>3</mn></mfrac></mfenced><mo>=</mo><mi>log</mi><mfenced close=\"|\" open=\"|\"><mn>1</mn></mfenced><mo>+</mo><mi>c</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mo>=</mo><mi>c</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>sin</mi><mfenced><mfrac><mi>y</mi><mi>x</mi></mfrac></mfenced><mo>=</mo><mi>log</mi><mfenced close=\"|\" open=\"|\"><mi>x</mi></mfenced><mo>+</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></math></p><p>So, on comparing we get,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>α</mi><mo>=</mo><msqrt><mn>3</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><msup><mi>α</mi><mn>2</mn></msup><mo>=</mo><mn>3</mn></math></p>"
  }
