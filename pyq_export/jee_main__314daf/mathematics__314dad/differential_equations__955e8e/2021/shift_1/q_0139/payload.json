    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mn>4</mn><msup><mi>e</mi><mn>3</mn></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mn>4</mn><msup><mi>e</mi><mn>6</mn></msup></math>",
