      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>6</mn></mfrac><mfenced><mrow><mi>&#960;</mi><mo>-</mo><mn>1</mn></mrow></mfenced></math>",
