  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mi>y</mi><mi>tan</mi><mi>x</mi><mo>=</mo><mi>sin</mi><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>.</mo><mi mathvariant=\"normal\">F</mi><mo>.</mo><mo>=</mo><msup><mi>e</mi><mrow><mo>&#8747;</mo><mn>2</mn><mi>tan</mi><mi>x</mi><mi>d</mi><mi>x</mi></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><mn>2</mn><mi>ln</mi><mi>sec</mi><mi>x</mi></mrow></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>.</mo><mi mathvariant=\"normal\">F</mi><mo>.</mo><mo>=</mo><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>.</mo><mfenced><mrow><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mo>=</mo><mo>&#8747;</mo><mi>sin</mi><mi>x</mi><mo>.</mo><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi><mi>d</mi><mi>x</mi><mo>+</mo><mi>C</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>.</mo><mfenced><mrow><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mo>=</mo><mo>&#8747;</mo><mi>sec</mi><mi>x</mi><mi>tan</mi><mi>x</mi><mi>d</mi><mi>x</mi><mo>+</mo><mi>C</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>.</mo><mfenced><mrow><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi></mrow></mfenced><mo>=</mo><mi>sec</mi><mi>x</mi><mo>+</mo><mi>C</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac><mo>;</mo><mi>y</mi><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>C</mi><mo>=</mo><mo>-</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>y</mi><mo>=</mo><mfrac><mrow><mi>sec</mi><mi>x