    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>log</mi><mn>2</mn></msub><mo>(</mo><mn>2</mn><mi mathvariant=\"normal\">e</mi><mo>)</mo></math>",
      "is_correct": false
    },
