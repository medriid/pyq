  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mn>2</mn><mrow><mi>x</mi><mo>-</mo><mi>y</mi></mrow></msup><mfenced><mrow><msup><mn>2</mn><mi>y</mi></msup><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><msup><mn>2</mn><mi>x</mi></msup><mo>-</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mn>0</mn><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>&#62;</mo><mn>0</mn><mo>,</mo><mi>y</mi><mfenced><mn>1</mn></mfenced><mo>=</mo><mn>1</mn></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced><mn>2</mn></mfenced></math>&nbsp;is equal to",
    "image": null
  },
