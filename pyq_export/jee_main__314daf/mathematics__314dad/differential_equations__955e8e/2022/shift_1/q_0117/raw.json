  "question": {
    "text": "The surface area of a balloon of spherical shape being inflated, increases at a constant rate. If initially, the radius of balloon is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> units and after <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn></math>&nbsp;seconds, it becomes&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math> units, then its radius after&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn></math> seconds is",
    "image": null
  },
  "options": [
    {
      "id": "ZZTbj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn></math>",
      "isCorrect": true,
