      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>-</mo><mn>2</mn><msub><mi>log</mi><mi mathvariant=\"normal\">e</mi></msub><mn>3</mn></math>",
      "is_correct": false
