  "question": {
    "text": "The solution of the differential equation $y d x+\\left(x+x^2 y\\right) d y=0$ is"
  },
  "options": [
    {
      "text": "\n$-\\frac{1}{x y}=C$\n",
      "is_correct": false
    },
    {
      "text": "\n$-\\frac{1}{x y}+\\log y=C$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\frac{1}{x y}+\\log y=C$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\log y=C x$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$y d x+x d y+x^2 y d y=0$\n$\\frac{d(x y)}{x^2 y^2}+\\frac{1}{y} d y=0 \\Rightarrow-\\frac{1}{x y}+\\log y=C$"
  }
}