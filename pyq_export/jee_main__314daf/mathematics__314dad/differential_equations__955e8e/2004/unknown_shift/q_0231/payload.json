  "question": {
    "text": "The differential equation for the family of curves $x^2+y^2-2 a y=0$, where $a$ is an arbitrary constant is"
  },
  "options": [
    {
      "text": "\n$2\\left(x^2-y^2\\right) y^{\\prime}=x y$\n",
      "is_correct": false
    },
    {
      "text": "\n$2\\left(x^2+y^2\\right) y^{\\prime}=x y$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(x^2-y^2\\right) y^{\\prime}=2 x y$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\left(x^2+y^2\\right) y^{\\prime}=2 x y$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$2 x+2 y y^{\\prime}-2 a y^{\\prime}=0$\n$a=\\frac{x+y y^{\\prime}}{y^{\\prime}} \\quad$ (eliminating a)\n$\\Rightarrow\\left(x^2-y^2\\right) y^{\\prime}=2 x y$"
  }
}