  "question": {
    "text": "Let <math><mi>f</mi></math> be a polynomial function such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi>x</mi></mrow></mfenced><mo>=</mo><msup><mi>f</mi><mi>&#8242;</mi></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>.</mo><mi>&#160;</mi><msup><mi>f</mi><mrow><mi>&#8242;</mi><mi>&#8242;</mi></mrow></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>,</mo></math> for all <math><mi>x</mi><mo>&#8712;</mo><mi>R</mi><mo>.</mo></math> Then :"
  },
  "options": [
    {
      "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>+</mo><msup><mrow><mi>f</mi></mrow><mrow><mi>′</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mn>28</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi>f</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>-</mo><msup><mrow><mi>f</mi></mrow><mrow><mi>′</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>-</mo><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>+</mo><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mi> </mi><mn>10</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi>f</mi></mrow><mrow><mi>&prime;</mi><mi>&prime;</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mn>4</mn></math>",
