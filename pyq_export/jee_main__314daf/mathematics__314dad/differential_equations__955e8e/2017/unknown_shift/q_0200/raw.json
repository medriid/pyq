  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mi>sin</mi><mi>x</mi></mrow></mfenced><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfenced separators=\"|\"><mrow><mi>y</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>cos</mi><mi>x</mi><mo>=</mo><mn>0</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced separators=\"|\"><mn>0</mn></mfenced><mo>=</mo><mn>1</mn></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced separators=\"|\"><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mfenced></math> is equal to",
    "image": null
  },
  "options": [
    {
      "id": "S4hM5",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jgGXi",
      "text": "<math><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OkYOR",
      "text": "<math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
