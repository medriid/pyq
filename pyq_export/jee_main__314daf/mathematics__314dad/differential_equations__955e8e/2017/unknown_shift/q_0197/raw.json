      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mi> </mi><mn>4</mn></mrow></mfenced></math>",
      "image": null,
      "isCorrect": false
    },
