    "text": "<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mn>2</mn><mi>y</mi></mrow></mfrac></math><br /><math><mn>2</mn><mi>y</mi><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></math><br />Put <math><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>t</mi><mi>&#160;</mi><mo>&#8658;</mo><mn>2</mn><mi>y</mi><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math><br /><math><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mi>t</mi><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></math><br />&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>.</mo><mi>F</mi><mo>=</mo><msup><mi>e</mi><mrow><mo>&#8747;</mo><mi>sec</mi><mo>&#8289;</mo><mi>x</mi><mi>d</mi><mi>x</mi></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><mi>ln</mi><mo>(</mo><mi>sec</mi><mo>&#8289;</mo><mrow><mi>x</mi><mo>+</mo><mi>t</mi><mi>a</mi><mi>n</mi><mi>x</mi><mo>)</mo></mrow></mrow></msup><mo>=</mo><mi>sec</mi><mo>&#8289;</mo><mi>x</mi><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>x</mi></math><br /><math><mo>&#8658;</mo><mi>t</mi><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>t</mi><mfenced separators=\"|\"><mrow><mi>sec</mi><mo>&#8289;</mo><mi>x</mi><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mo>&#8747;</mo><mfenced separators=\"|\"><mrow><mi>sec</mi><mo>&#8289;</mo><mi>x</mi><mi>tan</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfenced><mi>d</mi><mi>x</mi><mo>+</mo><mo>&#8747;</mo><msup><mi>tan</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi><mi>d</mi><mi>x</mi></math><br /><math><mo>&#8658;</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>-</mo><mi>x</mi><mo>+</mo><mi>c</mi></math><br /><math><mi>y</mi><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced><mo>=</mo><mn>1</mn><mi>&#160;</mi><mo>&#8658;</mo><