  "question": {
    "text": "If $x=f(y)$ is the solution of the differential equation\n$\\left(1+y^2\\right)+\\left(x-2 \\mathrm{e}^{\\tan ^{-1} y}\\right) \\frac{\\mathrm{d} y}{\\mathrm{~d} x}=0, y \\in\\left(-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right)$\nwith $f(0)=1$, then $f\\left(\\frac{1}{\\sqrt{3}}\\right)$ is equal to :"
  },
  "options": [
    {
      "text": "$e^{\\pi / 12}$",
      "is_correct": false
    },
    {
      "text": "$e^{\\pi / 4}$",
      "is_correct": false
    },
    {
      "text": "$e^{\\pi / 3}$",
      "is_correct": false
    },
    {
      "text": "$e^{\\pi / 6}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\frac{\\mathrm{dx}}{\\mathrm{dy}}+\\frac{\\mathrm{x}}{1+\\mathrm{y}^2}=\\frac{2 \\mathrm{e}^{\\tan ^{-1} \\mathrm{y}}}{1+\\mathrm{y}^2} \\\\ & \\text { I.F. }=\\mathrm{e}^{\\tan ^{-1} \\mathrm{y}} \\\\ & \\mathrm{xe}^{\\tan ^{-1} \\mathrm{y}}=\\int \\frac{2\\left(\\mathrm{e}^{\\tan ^{-1} \\mathrm{y}}\\right)^2 \\mathrm{dy}}{1+\\mathrm{y}^2} \\\\ & \\text { Put } \\tan ^{-1} \\mathrm{y}=\\mathrm{t}, \\frac{\\mathrm{dy}}{1+\\mathrm{y}^2}=\\mathrm{dt} \\\\ & \\mathrm{xe}^{\\tan ^{-1} \\mathrm{y}}=\\int 2 \\mathrm{e}^{2 \\mathrm{t}} \\mathrm{dt} \\\\ & \\mathrm{xe}^{\\tan ^{-1} \\mathrm{y}}=\\mathrm{e}^{2 \\tan ^{-1} \\mathrm{y}}+\\mathrm{c} \\\\ & \\mathrm{x}=\\mathrm{e}^{\\tan ^{-1} \\mathrm{y}}+\\mathrm{ce}^{-\\tan ^{-1} \\mathrm{y}} \\\\ & \\because \\mathrm{y}=0, \\mathrm{x}=1 \\\\ & 1=1+\\mathrm{c} \\Rightarrow \\mathrm{c}=0 \\\\ & \\mathrm{y}=\\frac{1}{\\sqrt{3}}, \\mathrm{x}=\\mathrm{e}^{\\pi / 6}\\end{aligned}$"
  }
}