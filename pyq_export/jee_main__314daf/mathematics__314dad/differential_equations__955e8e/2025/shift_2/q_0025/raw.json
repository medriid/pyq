  "question": {
    "text": "Let $f:(0, \\infty) \\rightarrow \\mathbf{R}$ be a function which is differentiable at all points of its domain and satisfies the condition $x^2 f^{\\prime}(x)=2 x f(x)+3$, with $f(1)=4$. Then $2 f(2)$ is equal to :",
    "image": null
  },
  "options": [
    {
      "id": "ldgmI",
      "text": "39",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iILgb",
