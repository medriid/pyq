    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mfrac><msup><mi>&#960;</mi><mn>2</mn></msup><mrow><mn>2</mn><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
