    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi mathvariant=\"normal\">y</mi><mo>'</mo></msup><mfenced><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>4</mn></mfrac></mfenced><mo>+</mo><msup><mi mathvariant=\"normal\">y</mi><mo>'</mo></msup><mfenced><mrow><mo>-</mo><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>4</mn></mfrac></mrow></mfenced><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">&#160;</mi><msqrt><mn>2</mn></msqrt></math>",
