  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mn>3</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></mrow></mfrac><mi>y</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mi>x</mi></mrow></mfrac></math> , <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#160;</mi><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac><mo>,</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac></mrow></mfenced><mo>,</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced separators=\"|\"><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></mfenced><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mo>,</mo></math> then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></mrow></mfenced></math> equals"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "is_correct": false
    },
