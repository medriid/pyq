    },
    {
      "text": "<math><mn>2</mn><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>e</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>e</mi><mo>-</mo><mn>2</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mi mathvariant=\"normal\">e</mi></math>",
