    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>&#8211;</mo><mi>y</mi><mo>=</mo><mn>15</mn></math>",
      "is_correct": false
