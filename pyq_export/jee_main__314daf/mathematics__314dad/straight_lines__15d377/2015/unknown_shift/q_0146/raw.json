    },
    {
      "id": "237n0",
      "text": "<math><msqrt><mn>3</mn></msqrt><mi> </mi><mi>y</mi><mo>+</mo><mi>x</mi><mo>-</mo><mn>3</mn><mo>+</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>=</mo><mn>0</mn></math>",
