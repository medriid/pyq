      "id": "h4SPq",
      "text": "<math><mi>y</mi><mo>-</mo><msqrt><mn>3</mn></msqrt><mi>x</mi><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn><msqrt><mn>3</mn></msqrt><mo>=</mo><mn>0</mn></math>",
