  "solution": {
    "text": "<math><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>&#160;</mi><mo>:</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo>-</mo><mn>12</mn><mo>=</mo><mn>0</mn></math><br /><br /><math><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>:</mo><mn>3</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>-</mo><mn>12</mn><mo>=</mo><mn>0</mn></math><br /><br /><math><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mi>&#955;</mi><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8658;</mo></math><math><mfenced separators=\"|\"><mrow><mn>4</mn><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo>-</mo><mn>12</mn></mrow></mfenced><mo>+</mo><mi>&#955;</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>-</mo><mn>12</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8658;</mo></math><math><mi>x</mi><mfenced separators=\"|\"><mrow><mn>4</mn><mo>+</mo><mn>3</mn><mi>&#955;</mi></mrow></mfenced><mo>+</mo><mi>y</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mo>+</mo><mn>4</mn><mi>&#955;</mi></mrow></mfenced><mo>-</mo><mn>12</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>&#955;</mi></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><br />Point <math><mi>A</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>12</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>&#955;</mi></mrow></mfenced></mrow><mrow><mn>4</mn><mo>+</mo><mn>3</mn><mi>&#955;</mi></mrow></mfrac><mo>,</mo><mi>&#160;</mi><mn>0</mn></mrow></mfenced></math><br /><br />Point <math><mi>B</mi><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mfrac><mrow><mn>12</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>&#955;</mi></mrow></mfenced></mrow><mrow><mn>3</mn><mo>+</mo><mn>4</mn><mi>&#955;</mi></mrow></mfrac></mrow></mfenced></math><br /><br />Mid point <math><mo>&#8658;</mo><mi>h</mi><mo>=</mo><mfrac><mrow><mn>6</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>&#955;</mi></mrow></mfenced></mrow><mrow><mn>4</mn><mo>+</mo><mn>3</mn><mi>&#955;</mi></mrow></mfrac></math> .......<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">i</mi></mfenced></math><br /><br /><math><mi>k</mi><mo>=</mo><mfrac><mrow><mn>6</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>&#955;</mi></mrow></mfenced></mrow><mrow><mn>3</mn><mo>+</mo><mn>4</mn><mi>&#955;</mi></mrow></mfrac></math> .......<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>ii</mi></mfenced></math><br /><br />Eliminate <math><mi>&#955;</mi></math> from&nbsp;equations <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi mathvariant=\"normal\">i</mi></mfenced></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mi>ii</mi></mfenced></math>&nbsp;then<br /><br /><math><mn>6</mn><mfenced separators=\"|\"><mrow><mi>h</mi><mo>+</mo><mi>k</mi></mrow></mfenced><mo>=</mo><mi>&#160;</mi><mn>7</mn><mi>h</mi><mi>k</mi></math><br /><br />Hence, locus is<br /><br /><math><mn>6</mn><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></mfenced><mo>=</mo><mi>&#160;</mi><mn>7</mn><mi>x</mi><mi>y</mi></math>"
