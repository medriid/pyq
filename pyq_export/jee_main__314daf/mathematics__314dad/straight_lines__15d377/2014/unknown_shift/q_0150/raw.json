      "image": null,
      "isCorrect": false
    },
    {
      "id": "2ABOq",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>+</mo><mi>x</mi><mo>=</mo><mn>0</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "63JhF",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><mi>a</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup><mi>x</mi><mo>-</mo><msup><mfenced><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup><mi>y</mi><mo>=</mo><mn>0</mn></math>",
      "image": null,
