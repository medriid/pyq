  "question": {
    "text": "If $\\left(a, a^2\\right)$ falls inside the angle made by the lines $y=\\frac{x}{2}, x>0$ and $y=3 x, x>0$, then a belongs to"
  },
  "options": [
    {
      "text": "\n$\\left(0, \\frac{1}{2}\\right)$\n",
      "is_correct": false
    },
    {
      "text": "\n$(3, \\infty)$\n",
      "is_correct": false
    },
    {
      "text": "\n$\\left(\\frac{1}{2}, 3\\right)$\n",
      "is_correct": true
    },
    {
      "text": "\n$\\left(-3,-\\frac{1}{2}\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$a^2-3 a < 0$ and $a^2-\\frac{a}{2}>0 \\Rightarrow \\frac{1}{2} < a < 3$"
  }
}