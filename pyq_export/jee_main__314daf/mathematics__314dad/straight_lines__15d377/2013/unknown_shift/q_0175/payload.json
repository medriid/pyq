  "question": {
    "text": "A ray of light along <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><msqrt><mn>3</mn></msqrt><mi>y</mi><mo>=</mo><msqrt><mn>3</mn></msqrt></math>&nbsp;gets reflected upon reaching <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>X</mi><mo>-</mo></math>axis, the equation of the reflected ray is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msqrt><mn>3</mn></msqrt><mi>x</mi><mo>-</mo><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mi>y</mi><mo>=</mo><mi>x</mi><mo>-</mo><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mi>x</mi><mo>+</mo><msqrt><mn>3</mn></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>3</mn></msqrt><mi>y</mi><mo>=</mo><mi>x</mi><mo>-</mo><msqrt><mn>3</mn></msqrt></math>",
