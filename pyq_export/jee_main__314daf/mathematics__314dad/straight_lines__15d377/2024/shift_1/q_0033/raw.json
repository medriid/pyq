  "question": {
    "text": "Let two straight lines drawn from the origin $\\mathrm{O}$ intersect the line $3 x+4 y=12$ at the points $\\mathrm{P}$ and $\\mathrm{Q}$ such that $\\triangle \\mathrm{OPQ}$ is an isosceles triangle and $\\angle \\mathrm{POQ}=90^{\\circ}$. If $l=\\mathrm{OP}^2+\\mathrm{PQ}^2+\\mathrm{QO}^2$, then the greatest integer less than or equal to $l$ is :",
    "image": null
  },
  "options": [
    {
      "id": "NMnCs",
      "text": "42",
      "image": null,
      "isCorrect": false
    },
    {
