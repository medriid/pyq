  "question": {
    "text": "If $A(3,1,-1), B\\left(\\frac{5}{3}, \\frac{7}{3}, \\frac{1}{3}\\right), C(2,2,1)$ and $D\\left(\\frac{10}{3}, \\frac{2}{3}, \\frac{-1}{3}\\right)$ are the vertices of a quadrilateral $A B C D$, then its area is"
  },
  "options": [
    {
      "text": "$\\frac{2 \\sqrt{2}}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{5 \\sqrt{2}}{3}$",
      "is_correct": false
    },
    {
      "text": "$2 \\sqrt{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{4 \\sqrt{2}}{3}$",
      "is_correct": true
