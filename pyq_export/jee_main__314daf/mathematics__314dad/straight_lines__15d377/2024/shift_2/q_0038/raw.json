  "question": {
    "text": "Let $A(-1,1)$ and $B(2,3)$ be two points and $P$ be a variable point above the line $A B$ such that the area of $\\triangle \\mathrm{PAB}$ is 10 . If the locus of $\\mathrm{P}$ is $\\mathrm{a} x+\\mathrm{b} y=15$, then $5 \\mathrm{a}+2 \\mathrm{~b}$ is :",
    "image": null
  },
  "options": [
    {
      "id": "CqVUV",
      "text": "6",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iPXh9",
      "text": "$-\\frac{6}{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zsrr0",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nGmqD",
      "text": "$-\\frac{12}{5}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/kSOFsbb05i7OhgTAYgnHyhUyJ0WZick1B-9lyYtgpps.original.fullsize.png\"><br />$\\begin{aligned} & \\frac{1}{2}\\left|\\begin{array}{ccc}\\mathrm{h} & \\mathrm{k} & 1 \\\\ -1 & 1 & 1 \\\\ 2 & 3 & 1\\end{array}\\right|=10 \\\\ & -2 \\mathrm{x}+3 \\mathrm{y}=25 \\\\ & -\\frac{6}{5} \\mathrm{x}+\\frac{9}{5} \\mathrm{y}=15 \\\\ & \\mathrm{a}=-\\frac{6}{5}, \\mathrm{~b}=\\frac{9}{5} \\\\ & 5 \\mathrm{a}=-6,2 \\mathrm{~b}=\\frac{18}{5}\\end{aligned}$",
    "image": null
  },
