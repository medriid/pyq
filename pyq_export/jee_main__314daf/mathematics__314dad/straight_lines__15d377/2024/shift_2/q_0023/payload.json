  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0023_ce7a45295a85.png\"><br />$\\begin{aligned} & \\mathrm{m}_{\\mathrm{OA}}=\\frac{2}{5} \\\\ & \\mathrm{~m}_{\\mathrm{OB}}=\\frac{\\mathrm{a}}{2}\\end{aligned}$\n$\\begin{aligned} & \\tan \\frac{\\pi}{4}=\\left|\\frac{2}{5}-\\frac{a}{2}\\right| \\\\ & 1=\\left|\\frac{4-5 a}{10+2 a}\\right|\\end{aligned}$<img src=\"assets\\st0023_1c252a601d4c.png\"><br>"
