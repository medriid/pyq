  "question": {
    "text": "Let $P=(-1,0), Q=(0,0)$ and $R=(3,3 \\sqrt{3})$ be three points. The equation of the bisector of the angle $\\mathrm{PQR}$",
    "image": null
  },
  "options": [
    {
      "id": "eCJLS",
      "text": "\n$\\sqrt{3} x+y=0$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "wsTcx",
      "text": "\n$x+\\frac{\\sqrt{3}}{2} y=0$\n",
