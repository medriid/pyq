  "question": {
    "text": "If one of the lines of $m y^2+\\left(1-m^2\\right) x y-m x^2=0$ is a bisector of the angle between the lines $x y=0$, then $m$ is",
    "image": null
  },
  "options": [
    {
      "id": "Y27Dm",
      "text": "\n$-1 / 2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LqF3f",
      "text": "\n$-2$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rRKIV",
      "text": "\n$1$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "2MwJ7",
      "text": "\n$2$",
      "image": null,
      "isCorrect": false
    }
