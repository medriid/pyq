    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mn>11</mn><mn>5</mn></mfrac><mo>,</mo><mo>&#160;</mo><mfrac><mn>28</mn><mn>5</mn></mfrac></mrow></mfenced></math>",
      "is_correct": true
