  "solution": {
    "text": "<p><img src=\"assets\\st0109_460e044c5c45.png\" style=\"width: 264px; height: 281px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>m</mi><mrow><mi>A</mi><mi>C</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>&#946;</mi><mo>&#8722;</mo><mn>2</mn></mrow><mrow><mi>&#945;</mi><mo>&#8722;</mo><mn>1</mn></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>m</mi><mrow><mi>A</mi><mi>B</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mo>&#8722;</mo><mn>1</mn></mrow><mrow><mn>1</mn><mo>&#8722;</mo><mn>3</mn></mrow></mfrac><mo>=</mo><mo>&#8722;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>&#8869;</mo><mi>A</mi><mi>C</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>&#946;</mi><mo>&#8722;</mo><mn>2</mn></mrow><mrow><mi>&#945;</mi><mo>&#8722;</mo><mn>1</mn></mrow></mfrac><mfenced><mrow><mo>&#8722;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced><mo>=</mo><mo>&#8722;</mo><mn>1</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mn>2</mn><mi>&#945;</mi><mo>&#8722;</mo><mn>2</mn><mo>+</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#946;</mi><mo>=</mo><mn>2</mn><mi>&#945;</mi></math></p><p>Now area of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#916;</mi><mi>A</mi><mi>B</mi><mi>C</mi><mo>=</mo><mn>5</mn><msqrt><mn>5</mn></msqrt><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>A</mi><mi>B</mi><mo>.</mo><mi>A</mi><mi>C</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><msqrt><msup><mfenced><mrow><mn>3</mn><mo>&#8722;</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mrow><mn>1</mn><mo>&#8722;</mo><mn>2</mn></mrow></mfenced><mn>2</mn></msup></msqrt><mo>.</mo><msqrt><msup><mfenced><mrow><mi mathvariant=\"normal\">&#945;</mi><mo>&#8722;</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mrow><mi mathvariant=\"normal\">&#946;</mi><mo>&#8722;</mo><mn>2</mn></mrow></mfenced><mn>2</mn></msup></msqrt><mo>=</mo><mn>5</mn><msqrt><mn>5</mn></msqrt></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><msup><mfenced><mrow><mi mathvariant=\"italic\">&#945;</mi><mo mathvariant=\"italic\">&#8722;</mo><mn mathvariant=\"italic\">1</mn></mrow></mfenced><mn mathvariant=\"italic\">2</mn></msup><mo mathvariant=\"italic\">+</mo><msup><mfenced><mrow><mn mathvariant=\"italic\">2</mn><mi mathvariant=\"italic\">&#945;</mi><mo mathvariant=\"italic\">&#8722;</mo><mn mathvariant=\"italic\">2</mn></mrow></mfenced><mn mathvariant=\"italic\">2</mn></msup></msqrt><mo mathvariant=\"italic\">=</mo><mn mathvariant=\"italic\">10</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><msup><mfenced><mrow><mi mathvariant=\"italic\">&#945;</mi><mo mathvariant=\"italic\">&#8722;</mo><mn mathvariant=\"italic\">1</mn></mrow></mfenced><mn mathvariant=\"italic\">2</mn></msup></msqrt><msqrt><mn mathvariant=\"italic\">5</mn></msqrt><mo mathvariant=\"italic\">=</mo><mn mathvariant=\"italic\">10</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mi mathvariant=\"italic\">&#945;</mi><mo mathvariant=\"italic\">&#8722;</mo><mn mathvariant=\"italic\">1</mn></mrow></mfenced><mo mathvariant=\"italic\">=</mo><mn mathvariant=\"italic\">2</mn><msqrt><mn mathvariant=\"italic\">5</mn></msqrt></math></p><p><math xmlns=\"http:/