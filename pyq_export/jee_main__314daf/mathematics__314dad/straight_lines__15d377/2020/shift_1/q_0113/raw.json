  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#160;</mo><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mn>3</mn><mo>=</mo><mn>0</mn><mo>&#8230;</mo><mo>&#8230;</mo><mo>(</mo><mi>i</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>x</mi><mo>-</mo><mn>2</mn><mi>y</mi><mo>+</mo><mi>&#945;</mi><mo>=</mo><mn>0</mn><mo>&#160;&#160;</mo><mo>&#8658;</mo><mo>&#160;&#160;</mo><mn>2</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mfrac><mi>&#945;</mi><mn>2</mn></mfrac><mo>=</mo><mn>0</mn><mo>&#8230;</mo><mo>&#8230;</mo><mo>(</mo><mi>i</mi><mi>i</mi><mo>)</mo></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>-</mo><mn>3</mn><mi>y</mi><mo>+</mo><mi>&#946;</mi><mo>=</mo><mn>0</mn><mo>&#160;&#160;</mo><mo>&#8658;</mo><mo>&#160;&#160;</mo><mn>2</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mfrac><mi>&#946;</mi><mn>3</mn></mfrac><mo>=</mo><mn>0</mn><mo>&#8230;</mo><mo>&#8230;</mo><mo>(</mo><mi>i</mi><mi>i</mi><mi>i</mi><mo>)</mo></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">d</mi><mn>1</mn></msub><mo>=</mo><mfrac><mfenced close=\"|\" open=\"|\"><mrow><mfrac><mi>&#945;</mi><mn>2</mn></mfrac><mo>-</mo><mn>3</mn></mrow></mfenced><msqrt><msup><mn>2</mn><mn>2</mn></msup><mo>+</mo><msup><mn>1</mn><mn>2</mn></msup></msqrt></mfrac><mo>=</mo><mfrac><mn>1</mn><msqrt><mn>5</mn></msqrt></mfrac><mo>&#8658;</mo><mo>|</mo><mi>&#945;</mi><mo>-</mo><mn>6</mn><mo>|</mo><mo>=</mo><mn>2</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#160;&#160;</mo><mi>&#945;</mi><mo>-</mo><mn>6</mn><mo>=</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>2</mn><mo>&#8658;</mo><mo>&#160;&#160;</mo><mi>&#945;</mi><mo>=</mo><mn>8</mn><mo>,</mo><mn>4</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">d</mi><mn>2</mn></msub><mo>=</mo><mfrac><mfenced close=\"|\" open=\"|\"><mrow><mfrac><mi>&#94