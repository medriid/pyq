    {
      "text": "<math><mfenced separators=\"|\"><mrow><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>1</mn></mrow></mfenced><mi>x</mi><mo>+</mo><msqrt><mn>3</mn></msqrt><mi>y</mi><mo>=</mo><mn>8</mn><msqrt><mn>2</mn></msqrt></math>",
      "is_correct": false
