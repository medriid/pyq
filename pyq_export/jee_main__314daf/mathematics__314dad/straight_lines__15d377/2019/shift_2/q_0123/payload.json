  "solution": {
    "text": "<img src=\"assets\\st0123_6a7659da0fcc.png\" /><br />Let co-ordinates of <math><mi>B</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mi>&#160;</mi><mo>-</mo><mn>1</mn><mi>&#160;</mi><mi>&#160;</mi><mo>&#38;</mo><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>2</mn><mi>&#160;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mi>&#160;</mi><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mo>-</mo><mn>3</mn><mo>,</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8756;</mo><mi>B</mi><mo>=</mo><mo>(</mo><mo>-</mo><mn>3</mn><mo>,</mo><mi>&#160;</mi><mn>0</mn><mo>)</mo></math><br />Let co-ordinates of <math><mi>C</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>2</mn><mi>&#160;</mi><mi>&#160;</mi><mo>&#38;</mo><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>2</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>3</mn></math><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>C</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,</mo><mi>&#160;</mi><mn>4</mn></mrow></mfenced></math><br />Let centroid <math><mi>G</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mi>h</mi><mo>,</mo><mi>k</mi></mrow></mfenced></math><br /><math><mi>h</mi><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mo>+</mo><mn>3</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mi>&#160;</mi><mi>&#160;</mi></math><br /><math><mi>k</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mo>+</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mo>+</mo><mn>0</mn><mo>+</mo><mn>4</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><math><mo>&#8756;</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi></math> Centroid, <math><mi mathvariant=\"normal\">G</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mn>2</mn></mrow></mfenced></math>"
