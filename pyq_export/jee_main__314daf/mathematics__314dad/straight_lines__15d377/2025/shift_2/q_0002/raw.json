  "question": {
    "text": "If the orthocentre of the triangle formed by the lines $y=x+1, y=4 x-8$ and $y=m x+c$ is at $(3,-1)$, then $\\mathrm{m}-\\mathrm{c}$ is :",
    "image": null
  },
  "options": [
    {
      "id": "a0H8g",
      "text": "0",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "OCQCk",
      "text": "-2",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "c1wFd",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DM8Pw",
      "text": "2",
      "image": null,
