  "question": {
    "text": "Let the area of the triangle formed by a straight Line L: $\\mathrm{x}+\\mathrm{by}+\\mathrm{c}=0$ with co-ordinate axes be 48 square units. If the perpendicular drawn from the origin to the line L makes an angle of $45^{\\circ}$ with the positive x -axis, then the value of $\\mathrm{b}^2+\\mathrm{c}^2$ is:",
    "image": null
  },
  "options": [
    {
      "id": "J0L1h",
      "text": "$90$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CzkJ1",
