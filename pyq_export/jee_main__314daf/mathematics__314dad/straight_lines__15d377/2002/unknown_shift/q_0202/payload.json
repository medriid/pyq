  "question": {
    "text": "A triangle with vertices (4, 0), (-1, -1), (3, 5) is"
  },
  "options": [
    {
      "text": "\nisosceles and right angled\n",
      "is_correct": true
    },
    {
      "text": "\nisosceles but not right angled\n",
      "is_correct": false
    },
    {
      "text": "\nright angled but not isosceles\n",
      "is_correct": false
    },
    {
      "text": "\nneither right angled nor isoceles",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0202_65417ab7c530.png\"><br>\n$A B=\\sqrt{(4+1)^2+(0+1)^2}=\\sqrt{26} ; B C=\\sqrt{(3+1)^2+(5+1)^2}=\\sqrt{52}$\n$C A=\\sqrt{(4-3)^2+(0-5)^2}=\\sqrt{26} ;$ So, in isosceles triangle $A B=C A$\nFor right angled triangle $\\mathrm{BC}^2=\\mathrm{AB}^2+\\mathrm{AC}^2$\nSo, here $B C=\\sqrt{52}$ or $B C^2=52$ or $(\\sqrt{26})^2+(\\sqrt{26})^2=52$\nSo, given triangle is right angled and also isosceles"
  }
}