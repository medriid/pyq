  "question": {
    "text": "A triangle with vertices (4, 0), (-1, -1), (3, 5) is",
    "image": null
  },
  "options": [
    {
      "id": "QXIVx",
      "text": "\nisosceles and right angled\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "6YFar",
      "text": "\nisosceles but not right angled\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pdtrC",
      "text": "\nright angled but not isosceles\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Ko8yc",
      "text": "\nneither right angled nor isoceles",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/5uah9BCrW3671i5XGmZNPI-xIFPRIREtrjpUHAR9atc.original.fullsize.png\"><br>\n$A B=\\sqrt{(4+1)^2+(0+1)^2}=\\sqrt{26} ; B C=\\sqrt{(3+1)^2+(5+1)^2}=\\sqrt{52}$\n$C A=\\sqrt{(4-3)^2+(0-5)^2}=\\sqrt{26} ;$ So, in isosceles triangle $A B=C A$\nFor right angled triangle $\\mathrm{BC}^2=\\mathrm{AB}^2+\\mathrm{AC}^2$\nSo, here $B C=\\sqrt{52}$ or $B C^2=52$ or $(\\sqrt{26})^2+(\\sqrt{26})^2=52$\nSo, given triangle is right angled and also isosceles",
    "image": null
  },
