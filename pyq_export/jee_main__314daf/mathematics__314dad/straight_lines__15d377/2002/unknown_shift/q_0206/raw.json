  "correctValue": null,
  "solution": {
    "text": "$3 a+a^2-2=0 \\Rightarrow a^2+3 a-2=0 \\Rightarrow a=\\frac{-3 \\pm \\sqrt{9+8}}{2}=\\frac{-3 \\pm \\sqrt{17}}{2}$",
    "image": null
