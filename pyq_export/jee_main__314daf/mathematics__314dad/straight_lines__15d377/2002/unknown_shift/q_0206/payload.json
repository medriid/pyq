  "question": {
    "text": "The point of lines represented by $3 a x^2+5 x y+\\left(a^2-2\\right) y^2=0$ and perpendicular to each other for"
  },
  "options": [
    {
      "text": "\ntwo values of a\n",
      "is_correct": true
    },
    {
      "text": "\n$\\forall a$\n",
      "is_correct": false
    },
    {
      "text": "\nfor one value of a\n",
      "is_correct": false
    },
    {
      "text": "\nfor no values of a",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$3 a+a^2-2=0 \\Rightarrow a^2+3 a-2=0 \\Rightarrow a=\\frac{-3 \\pm \\sqrt{9+8}}{2}=\\frac{-3 \\pm \\sqrt{17}}{2}$"
  }
