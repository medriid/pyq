      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><msup><mi>p</mi><mn>2</mn></msup></math>",
      "is_correct": false
