    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/jee_main/3db16443-942f-4c29-aa83-5721f5e0a28b-image.png\" style=\"width: 227px; height: 120px;\" /></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>&#8801;</mo><mfenced><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi>m</mi><msub><mi>x</mi><mn>1</mn></msub></mrow></mfenced></math></p><p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi><mo>&#8801;</mo><mfenced><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mi>m</mi><msub><mi>x</mi><mn>2</mn></msub></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>1</mn></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><mn>3</mn></mtd><mtd><mn>4</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mfrac><mn>13</mn><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>2</mn></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced close=\"|\" open=\"|\"><mtable><mtr><mtd><msub><mi>x</mi><mn>1</mn></msub></mtd><mtd><mi>m</mi><msub><mi>x</mi><mn>1</mn></msub></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><msub><mi>x</mi><mn>2</mn></msub></mtd><mtd><mi>m</mi><msub><mi>x</mi><mn>2</mn></msub></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>2</mn></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced close=\"|\" open=\"|\"><mrow><mn>2</mn><mfenced><mrow><mi>m</mi><msub><mi>x</mi><mn>1</mn></msub><mo>-</mo><mi>m</mi><msub><mi>x</mi><mn>2</mn></msub></mrow></mfenced></mrow></mfenced><mo>=</mo><mi>m</mi><mfenced close=\"|\" open=\"|\"><mrow><msu