  "question": {
    "text": "If the line $2 x+y=k$ passes through the point which divides the line segment joining the points $(1,1)$ and $(2,4)$ in the ratio $3: 2$, then $k$ equals",
    "image": null
  },
  "options": [
    {
      "id": "mBjNr",
      "text": "\n$\\frac{29}{5}$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "j3Qql",
      "text": "\n$5$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HxeCv",
      "text": "\n$6$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "l0DJS",
      "text": "\n$\\frac{11}{5}$",
      "image": null,
      "isCorrect": false
