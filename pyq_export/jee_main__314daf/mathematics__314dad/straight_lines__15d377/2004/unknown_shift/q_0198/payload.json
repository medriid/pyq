  "question": {
    "text": "If one of the lines given by $6 x^2-x y+4 c y^2=0$ is $3 x+4 y=0$, then $c$ equals"
  },
  "options": [
    {
      "text": "\n1\n",
      "is_correct": false
    },
    {
      "text": "\n$-1$\n",
      "is_correct": false
    },
    {
      "text": "\n3\n",
      "is_correct": false
    },
    {
      "text": "\n$-3$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$m_1+m_2=\\frac{1}{4 c}, m_1 m_2=\\frac{6}{4 c}$ and $m_1=-\\frac{3}{4}$ Hence c $=-3$"
  }
