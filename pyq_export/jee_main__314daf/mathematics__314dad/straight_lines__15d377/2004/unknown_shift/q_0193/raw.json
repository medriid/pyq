  "question": {
    "text": "Let $A(2,-3)$ and $B(-2,1)$ be vertices of a triangle $A B C$. If the centroid of this triangle moves on the line $2 x+3 y=1$, then the locus of the vertex $C$ is the line",
    "image": null
  },
  "options": [
    {
      "id": "kAseK",
      "text": "\n$2 x+3 y=9$\n",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "YzTuG",
      "text": "\n$2 x-3 y=7$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l5Pii",
      "text": "\n$3 x+2 y=5$\n",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WEqPW",
      "text": "\n$3 x-2 y=3$",
      "image": null,
      "isCorrect": false
