      "text": "infinite",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\because$ Two distinct real roots 1,2\n$f(x)=|x-1|+|x-2|$\n$\\therefore$ Differentiable in $[1,2]$"
