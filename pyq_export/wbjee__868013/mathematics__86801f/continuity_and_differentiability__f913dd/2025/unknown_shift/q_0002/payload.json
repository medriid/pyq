      "text": "$a=0, b=5$",
      "is_correct": false
    },
    {
      "text": "$a=0, b=3$",
      "is_correct": false
    },
    {
      "text": "$a=b=3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{LHL}=\\mathrm{RHL} \\Rightarrow 4+\\mathrm{a}=\\mathrm{b}+2 \\\\ & \\mathrm{LHD}=\\mathrm{RHD} \\Rightarrow \\mathrm{b}=5 \\Rightarrow \\mathrm{a}=3\\end{aligned}$"
  }
