  "question": {
    "text": "Let $f(x)=a_0+a_1|x|+a_2|x|^2+a_3|x|^3$, where $a_0, a_1, a_2, a_3$ are real constants. Then $f(x)$ is differentiable at $x=0$",
    "image": null
  },
  "options": [
    {
      "id": "cRz3A",
      "text": "whatever be $a_0, a_1, a_2, a_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gIjXz",
      "text": "for no values of $a_0, a_1, a_2, a_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FcehN",
      "text": "only if $a_1=0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fqqyb",
      "text": "only if $a_1=0, a_3=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$f^{\\prime}\\left(0^{+}\\right)=\\lim _{x \\rightarrow 0}\\left(a_1+2 a_1 x+3 a_3 x^2\\right)=a_1$\n$f^{\\prime}\\left(0^{-}\\right)=\\lim _{x \\rightarrow 0}\\left(-a_1+2 a_1 x-3 a_3 x^2\\right)=-a_1$\n$f^{\\prime}\\left(0^{+}\\right)=f^{\\prime}\\left(0^{-}\\right) \\quad \\Rightarrow a_1=0$",
    "image": null
  },
