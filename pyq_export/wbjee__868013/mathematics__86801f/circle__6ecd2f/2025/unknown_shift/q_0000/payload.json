  "question": {
    "text": "Let $x-y=0$ and $x+y=1$ be two perpendicular diameters of a circle of radius $R$. The circle will pass through the origin if $R$ is equal to"
  },
  "options": [
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{\\sqrt{2}}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{\\sqrt{3}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img width=\"150px\" src=\"assets\\st0000_aaf601515e2a.png\"/><br/>\n\n$\\begin{aligned} & \\left(x-\\frac{1}{2}\\right)^2+\\left(y-\\frac{1}{2}\\right)^2=R^2 \\\\ & \\Rightarrow R^2=\\frac{1}{2} ; R=\\frac{1}{\\sqrt{2}}\\end{aligned}$"
  }
}