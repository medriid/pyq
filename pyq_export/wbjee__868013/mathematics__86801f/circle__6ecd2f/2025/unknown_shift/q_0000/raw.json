  "question": {
    "text": "Let $x-y=0$ and $x+y=1$ be two perpendicular diameters of a circle of radius $R$. The circle will pass through the origin if $R$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "7Ujrq",
      "text": "$\\frac{1}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uINPM",
      "text": "$\\frac{1}{\\sqrt{2}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "JiMKz",
      "text": "$\\frac{1}{\\sqrt{3}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nUWLX",
      "text": "$\\frac{1}{3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img width=\"150px\" src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/QYY3qS5pLDyGrSBtAWc-ttmXPkl2Dti0PljBQY2XZ-Q.original.fullsize.png\"/><br/>\n\n$\\begin{aligned} & \\left(x-\\frac{1}{2}\\right)^2+\\left(y-\\frac{1}{2}\\right)^2=R^2 \\\\ & \\Rightarrow R^2=\\frac{1}{2} ; R=\\frac{1}{\\sqrt{2}}\\end{aligned}$",
    "image": null
  },
