  "question": {
    "text": "The circles $\\mathrm{x}^2+\\mathrm{y}^2-10 \\mathrm{x}+16=0$ and $\\mathrm{x}^2+\\mathrm{y}^2=\\mathrm{a}^2$ intersect at two distinct points if",
    "image": null
  },
  "options": [
    {
      "id": "lCMcW",
      "text": "$\\mathrm{a} < 2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l5XBm",
      "text": "$2 < $ a $ < 8$",
