  "question": {
    "text": "Two circle $S_1=p x^2+p y^2+2 g^{\\prime} x+2 f^{\\prime} y+d=0$ and $S_2=x^2+y^2+2 g x+2 f y+d^{\\prime}=0$ have a common chord $P Q$. The equation of $\\mathrm{PQ}$ is"
  },
  "options": [
    {
      "text": "$S_1-S_2=0$",
      "is_correct": false
    },
    {
      "text": "$S_1+S_2=0$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{S}_1-\\mathrm{pS}_2=0$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{S}_1+\\mathrm{pS}_2=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{S}_1}{\\mathrm{p}}-\\mathrm{S}_2=0 \\Rightarrow \\mathrm{S}_1-\\mathrm{pS}_2=0$"
  }
}