  "question": {
    "text": "If \\(f(x+2 y, x-2 y)=x y\\), then \\(f(x, y)\\) is equal to"
  },
  "options": [
    {
      "text": "\\(\\frac{1}{4} x y\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{4}\\left(x^2-y^2\\right)\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{8}\\left(x^2-y^2\\right)\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{1}{2}\\left(x^2+y^2\\right)\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\\text{Hint: }\n& x+2 y=a \\\\\n& \\frac{x-2 y=b}{2 x=a+b} \\\\\n& 4 y=a-b\n\\end{aligned}\\)\n\\(f(a, b)=\\left(\\frac{a+b}{2}\\right)\\left(\\frac{a-b}{4}\\right)=\\frac{a^2-b^2}{8}\\)"
  }
}