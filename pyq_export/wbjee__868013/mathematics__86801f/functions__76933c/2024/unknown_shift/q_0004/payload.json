  "question": {
    "text": "The function $f: \\mathbb{R} \\rightarrow \\mathbb{R}$ defined by $f(x)=e^x+e^{-x}$ is"
  },
  "options": [
    {
      "text": "one-one",
      "is_correct": false
    },
    {
      "text": "onto",
      "is_correct": false
    },
    {
      "text": "bijective",
      "is_correct": false
    },
    {
      "text": "not bijective",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Hint: } \\because \\mathrm{f}(\\mathrm{x}) \\text { is even function } \\quad \\therefore \\text { Not one-one } \\\\ & \\because \\mathrm{e}^{\\mathrm{x}}+\\mathrm{e}^{-\\mathrm{x}} \\text { can't be negative } \\quad \\therefore \\text { Not onto }\\end{aligned}$"
  }
}