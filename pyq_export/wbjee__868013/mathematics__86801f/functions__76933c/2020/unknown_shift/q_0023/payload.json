  "question": {
    "text": "Let $\\mathrm{f}(\\mathrm{x})=\\sqrt{\\mathrm{x}^{2}-3 \\mathrm{x}+2}$ and $\\mathrm{g}(\\mathrm{x})=\\sqrt{\\mathrm{x}}$ be two given functions. If $\\mathrm{S}$ be the domain of $\\mathrm{f} \\circ \\mathrm{g}$ and $\\mathrm{T}$ be the domain of $\\mathrm{g}$ of then"
  },
  "options": [
    {
      "text": "$S=T$",
      "is_correct": false
    },
    {
      "text": "$S \\cap T=\\phi$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{S} \\cap \\mathrm{T}$ is a singleton",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{S} \\cap \\mathrm{T}$ is an interval",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hint: \r\n$f(x)=\\sqrt{(x-1)(x-2)}, g(x)=\\sqrt{x}$\r\n$f(g(x))=\\sqrt{(\\sqrt{x}-1)(\\sqrt{x}-2)}$\r\n$S=\\{x: x \\in[0,1] \\cup[4, \\infty)\\}$\r\n$g(f(x))=\\sqrt{\\sqrt{(x-1)(x-2)}}$\r\n$T=\\{x: x \\in(-\\infty, 1] \\cup[2, \\infty)\\}$"
  }
}