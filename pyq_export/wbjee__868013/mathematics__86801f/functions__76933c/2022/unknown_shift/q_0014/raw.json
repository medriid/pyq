  "question": {
    "text": "For the mapping $f: \\mathbb{R}-\\{1\\} \\rightarrow \\mathbb{R}-\\{2\\}$, given by $f(x)=\\frac{2 x}{x-1}$, which of the following is correct ?",
    "image": null
  },
  "options": [
    {
      "id": "x8cnA",
      "text": "$\\mathrm{f}$ is one-one but not onto",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hfT5u",
      "text": "f is onto but not one-one",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "29N7K",
      "text": "$\\mathrm{f}$ is neither one-one nor onto",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DF0ee",
      "text": "$\\mathrm{f}$ is both one-one and onto",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$f(x)=\\frac{2 x}{x-1} \\Rightarrow f^{\\prime}(x)=\\frac{-2}{(x-1)^2}  < 0$\n$\\therefore \\mathrm{f}(\\mathrm{x})$ is one-one\nLet, $\\mathrm{y}_1 \\in \\mathbb{R}-\\{2\\}$ and $\\mathrm{f}\\left(\\mathrm{x}_1\\right)=\\mathrm{y}_1$\nThen, $y_1=\\frac{2 x_1}{x_1-1} \\Rightarrow x_1=\\frac{y_1}{y_1-2} \\in \\mathbb{R}-\\{1\\}$\n$\\therefore f(x)$ is onto.",
    "image": null
  },
