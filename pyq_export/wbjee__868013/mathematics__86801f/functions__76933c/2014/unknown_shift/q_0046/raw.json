  "question": {
    "text": "The function $f(x)=x^{2}+b x+c,$ where $b$ and $c$ real constants, describes",
    "image": null
  },
  "options": [
    {
      "id": "Fq8H7",
      "text": "one-to-one mapping",
      "isCorrect": false,
      "image": null
    },
    {
