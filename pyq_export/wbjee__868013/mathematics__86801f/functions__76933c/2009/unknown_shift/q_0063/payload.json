  "question": {
    "text": "If $\\mathrm{P}=\\frac{1}{2} \\sin ^2 \\theta+\\frac{1}{3} \\cos ^2 \\theta$ then"
  },
  "options": [
    {
      "text": "$\\frac{1}{3} \\leq \\mathrm{P} \\leq \\frac{1}{2}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{P} \\geq \\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\quad 2 \\leq \\mathrm{P} \\leq 3$",
      "is_correct": false
    },
    {
      "text": "$-\\frac{\\sqrt{13}}{6} \\leq \\mathrm{P} \\leq \\frac{\\sqrt{13}}{6}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: $P=\\frac{1}{2} \\sin ^2 \\theta+\\frac{1}{3} \\cos ^2 \\theta=\\frac{1}{2} \\sin ^2 \\theta+\\frac{1}{3}\\left(1-\\sin ^2 \\theta\\right)=\\frac{1}{3}+\\frac{1}{6} \\sin ^2 \\theta$\n$$\n\\begin{aligned}\n& 0 \\leq \\sin ^2 \\theta \\leq 1 \\Rightarrow \\frac{1}{3} \\leq \\frac{1}{3}+\\frac{1}{6} \\sin ^2 \\theta \\leq \\frac{1}{3}+\\frac{1}{6} \\\\\n& \\Rightarrow \\frac{1}{3} \\leq \\mathrm{P} \\leq \\frac{1}{2}\n\\end{aligned}\n$$"
  }
