  "question": {
    "text": "The domain of definition of the function $f(x)=\\sqrt{1+\\log _{\\mathrm{e}}(1-x)}$ is",
    "image": null
  },
  "options": [
    {
      "id": "dfkCH",
      "text": "$-\\infty < x \\leq 0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "k0epd",
      "text": "$-\\infty < x \\leq \\frac{e-1}{e}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "OHwVR",
      "text": "$-\\infty < x \\leq 1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0Dzzn",
      "text": "$x \\geq 1-e$",
      "image": null,
      "isCorrect": false
    }
