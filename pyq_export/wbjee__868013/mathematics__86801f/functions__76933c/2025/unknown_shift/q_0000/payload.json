  "question": {
    "text": "Let $u+v+w=3, u, v, w \\in \\mathbb{R}$ and $f(x)=u x^2+v x+w$ be such that $f(x+y)=f(x)+f(y)+x y, \\forall x, y \\in \\mathbb{R}$. Then $f(1)$ is equal to"
  },
  "options": [
    {
      "text": "$\\frac{5}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{\\sqrt{2}}$",
      "is_correct": false
    },
    {
      "text": "$3$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & u+v+w=3 \\\\ & f(x)=u x^2+v x+w \\\\ & f(x+y)=f(x)+f(y)+x y \\\\ & f(1)=3\\end{aligned}$"
  }
}