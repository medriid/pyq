  "question": {
    "text": "Let $f: R \\rightarrow R$ be such that $f(0)=0$ and $\\left|f^{\\prime}(x)\\right| \\leq 5$ for all $x$. Then $f(1)$ is in",
    "image": null
  },
  "options": [
