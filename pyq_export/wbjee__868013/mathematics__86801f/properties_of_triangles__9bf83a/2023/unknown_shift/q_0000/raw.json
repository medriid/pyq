  "correctValue": null,
  "solution": {
    "text": "Hint : <img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/qg5mbamKNxxHoRAl1txrB3BjZRIJICEuPO_3KQ-w7d0.original.fullsize.png\"><br>\n\\(\\begin{aligned} & A P=\\sqrt{15^2-5^2}=10 \\sqrt{2} \\\\ & \\Delta=\\frac{1}{2} \\cdot B C \\cdot A P=50 \\sqrt{2} \\\\ & s=\\frac{15+15+10}{2}=20 \\\\ & \\because r=\\frac{\\Delta}{s}=\\frac{50 \\sqrt{2}}{20}=\\frac{5}{\\sqrt{2}}\\end{aligned}\\)",
