  "question": {
    "text": "In a triangle $\\mathrm{ABC}$ if $\\sin \\mathrm{A} \\sin \\mathrm{B}=\\frac{\\mathrm{ab}}{\\mathrm{c}^2}$, then the triangle is",
    "image": null
  },
  "options": [
    {
      "id": "LCNNI",
      "text": "equilateral",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "F7PWg",
      "text": "isosceles",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "U8iRE",
      "text": "right angled",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fwQje",
      "text": "obtuse angled",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints }: \\sin A \\sin B=\\frac{a b}{c^2} \\\\\n& \\Rightarrow c^2=\\frac{a b}{\\sin A \\sin B}=\\left(\\frac{a}{\\sin A}\\right)\\left(\\frac{b}{\\sin B}\\right) \\\\\n& \\Rightarrow c^2=\\left(\\frac{c}{\\sin C}\\right)^2 \\Rightarrow \\sin ^2 C=1 \\Rightarrow \\sin C=1 \\Rightarrow C=90^{\\circ}\n\\end{aligned}\n$$",
    "image": null
  },
