  "question": {
    "text": "If angles $\\mathrm{A}, \\mathrm{B}$ and $\\mathrm{C}$ are in A.P., then $\\frac{\\mathrm{a}+\\mathrm{c}}{\\mathrm{b}}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "KzI8I",
      "text": "$2 \\sin \\frac{A-C}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8O6Uu",
      "text": "$2 \\cos \\frac{A-C}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "uTVJ4",
      "text": "$\\cos \\frac{\\mathrm{A}-\\mathrm{C}}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "V3AKq",
      "text": "$\\sin \\frac{\\mathrm{A}-\\mathrm{C}}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints: $2 \\mathrm{~B}=\\mathrm{A}+\\mathrm{C}$\n$$\n=\\frac{\\sin A+\\sin C}{\\sin B}=\\frac{2 \\sin \\left(\\frac{A+C}{2}\\right) \\cos \\left(\\frac{A-C}{2}\\right)}{\\sin B}=\\frac{2 \\sin B}{\\sin B} \\cos \\left(\\frac{A-C}{2}\\right)=2 \\cos \\left(\\frac{A-C}{2}\\right)\n$$",
    "image": null
  },
