  "question": {
    "text": "In $\\mathrm{a} \\triangle \\mathrm{ABC}, 2 \\operatorname{acsin} \\frac{\\mathrm{A}-\\mathrm{B}+\\mathrm{C}}{2}$ is equal to"
  },
  "options": [
    {
      "text": "$\\mathrm{a}^2+\\mathrm{b}^2-\\mathrm{c}^2$",
      "is_correct": false
    },
    {
      "text": "$c^2+a^2-b^2$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{b}^2-\\mathrm{a}^2-\\mathrm{c}^2$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{c}^2-\\mathrm{a}^2-\\mathrm{b}^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hints : $2 \\mathrm{ac} \\sin \\left(\\frac{\\mathrm{A}+\\mathrm{C}-\\mathrm{B}}{2}\\right) \\quad\\left[\\frac{\\mathrm{A}+\\mathrm{C}}{2}=\\frac{\\pi}{2}-\\frac{\\mathrm{B}}{2}\\right],=2 \\mathrm{ac} \\sin \\left(\\frac{\\pi}{2}-\\mathrm{B}\\right)=2 \\mathrm{ac} \\cos \\mathrm{B} \\quad=\\mathrm{a}^2+\\mathrm{c}^2-\\mathrm{b}^2$"
  }
}