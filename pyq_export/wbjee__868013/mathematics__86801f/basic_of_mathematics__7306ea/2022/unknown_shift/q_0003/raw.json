  "question": {
    "text": "If $x$ satisfies the inequality $\\log _{25} x^2+\\left(\\log _5 x\\right)^2  < 2$, then $x$ belongs to",
    "image": null
  },
  "options": [
    {
      "id": "PqNPc",
      "text": "$\\left(\\frac{1}{5}, 5\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "IHw1W",
      "text": "$\\left(\\frac{1}{25}, 5\\right)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Mz0Vx",
      "text": "$\\left(\\frac{1}{5}, 25\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "W5o5P",
      "text": "$\\left(\\frac{1}{25}, 25\\right)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Domain $=(0, \\infty)$\n$\\begin{aligned}\n&\\log _5 x+\\left(\\log _5 x\\right)^2-2  < 0 \\\\\n&\\Rightarrow\\left(\\log _5 x-1\\right)\\left(\\log _5 x+2\\right) < 0 \\\\\n&\\therefore-2 < \\log _5 x < 1 \\\\\n&\\therefore \\frac{1}{25} < x < 5\n\\end{aligned}$",
    "image": null
  },
