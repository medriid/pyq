  "question": {
    "text": "A particle is projected vertically upwards. If it has to stay above the ground for 12 seconds, then",
    "image": null
  },
  "options": [
    {
      "id": "gmi2I",
      "text": "velocity of projection is $192 \\mathrm{ft} / \\mathrm{sec}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "RdmJt",
      "text": "greatest height attained is $600 \\mathrm{ft}$",
      "isCorrect": false,
