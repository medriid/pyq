  "question": {
    "text": "If $2 \\log (x+1)-\\log \\left(x^{2}-1\\right)=\\log 2$, then $x=$"
  },
  "options": [
    {
      "text": "only 3",
      "is_correct": true
    },
    {
      "text": "$-1$ and 3",
      "is_correct": false
    },
    {
      "text": "only -1",
      "is_correct": false
    },
    {
      "text": "1 and 3",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hint: \r\n$\\log \\left\\{\\frac{(x+1)^{2}}{x^{2}-1}\\right\\}=\\log 2 \\Rightarrow(x+1)^{2}=2\\left(x^{2}-1\\right) \\Rightarrow x^{2}-2 x-3=0 \\Rightarrow(x-3)(x+1)=0$\r\n$x=3 ; x \\neq-1$"
  }
}