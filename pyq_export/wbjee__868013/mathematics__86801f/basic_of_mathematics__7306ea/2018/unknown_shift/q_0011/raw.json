  "question": {
    "text": "The equation $x \\log x=3-x$",
    "image": null
  },
  "options": [
    {
      "id": "Zf7lA",
      "text": "has no root in (1,3)",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "2UxJJ",
      "text": "has exactly one root in (1,3)",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "mus8D",
      "text": "$x \\log x-(3-x)>0$ in [1,3]",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ca7Sj",
      "text": "$x \\log x-(3-x)    < 0$ in [1,3]",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Let $\\quad f(x)=x \\log x+x-3$\r\n$\\Rightarrow \\quad f^{\\prime}(x)=x \\cdot \\frac{1}{x}+\\log x+1$\r\n$\\Rightarrow \\quad f^{\\prime}(x)=\\log x+2>0$\r\n$\\Rightarrow f(1)=-2$ and $f(3)=3 \\log 3, f(1) \\cdot f(3    < 0)$\r\nHence, exactly one root in $x \\in(1,3)$ as $f(x)>0$",
    "image": null
  },
