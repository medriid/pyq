  "question": {
    "text": "Let $P(x)$ be a polynomial, which when $\\begin{array}{llll}\\text { divided by } & (x-3) & \\text { and } & (x-5) & \\text { leaves }\\end{array}$ remainders 10 and 6, respectively. If the polynomial is divided by $(x-3)(x-5),$ thes the remainder is",
    "image": null
  },
  "options": [
    {
      "id": "Y0vEC",
      "text": "$-2 x+16$",
      "isCorrect": true,
      "image": null
