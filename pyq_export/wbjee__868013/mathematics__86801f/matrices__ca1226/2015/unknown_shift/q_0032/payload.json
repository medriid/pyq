  "question": {
    "text": "If $A$ and $B$ are two matrices such that $A B=B$ and $B A=A,$ then $A^{2}+B^{2}$ equals"
  },
  "options": [
    {
      "text": "248",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{BA}$",
      "is_correct": false
    },
    {
      "text": "$A+B$",
      "is_correct": true
    },
    {
      "text": "$A B$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Given, $A B=B$ and $B A=A$ $\\begin{aligned} \\text { Now, } A^{2}+B^{2} &=A \\cdot A+B \\cdot B \\\\ &=A(B A)+B(A B)=(A B) A+(\\ln ) \\\\ &=B A+A B=A+B \\end{aligned}$"
  }
