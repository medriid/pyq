  "question": {
    "text": "If $A$ is a square matrix then,"
  },
  "options": [
    {
      "text": "$\\mathrm{A}+\\mathrm{A}^{\\mathrm{T}}$ is symmetric",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{AA}^{\\mathrm{T}}$ is skew - symmetric",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{A}^{\\mathrm{T}}+\\mathrm{A}$ is skew-symmetric",
      "is_correct": false
    },
    {
      "text": "$\\quad \\mathrm{A}^{\\mathrm{T}} \\mathrm{A}$ is skew symmetric",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: $\\left(\\mathrm{A}+\\mathrm{A}^{\\mathrm{T}}\\right)^{\\mathrm{T}}=\\mathrm{A}^{\\mathrm{T}}+\\left(\\mathrm{A}^{\\mathrm{T}}\\right)^{\\mathrm{T}}=\\mathrm{A}^{\\mathrm{T}}+\\mathrm{A}=\\mathrm{A}+\\mathrm{A}^{\\mathrm{T}}$"
  }
}