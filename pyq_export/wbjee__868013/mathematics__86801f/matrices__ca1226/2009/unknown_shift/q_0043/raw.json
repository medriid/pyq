  "question": {
    "text": "If $A$ is a square matrix then,",
    "image": null
  },
  "options": [
    {
      "id": "qQPmt",
      "text": "$\\mathrm{A}+\\mathrm{A}^{\\mathrm{T}}$ is symmetric",
      "image": null,
