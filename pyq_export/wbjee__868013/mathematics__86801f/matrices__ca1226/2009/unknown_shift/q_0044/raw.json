  "question": {
    "text": "If $A$ and $B$ square matrices of the same order and $A B=3 I$, then $A^{-1}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "1118f",
      "text": "$3 \\mathrm{~B}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "77t51",
      "text": "$\\frac{1}{3} \\mathrm{~B}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "cHMRg",
      "text": "$3 \\mathrm{~B}^{-1}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pZGUN",
      "text": "$\\frac{1}{3} \\mathrm{~B}^{-1}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints: $\\mathrm{AB}=3 \\mathrm{I}, \\mathrm{A}^{-1} \\cdot \\mathrm{AB}=3 \\cdot \\mathrm{A}^{-1} \\mathrm{I} \\Rightarrow \\mathrm{B}=3 \\mathrm{~A}^{-1} \\Rightarrow A^{-1}=\\frac{1}{3} \\mathrm{~B}$",
    "image": null
  },
