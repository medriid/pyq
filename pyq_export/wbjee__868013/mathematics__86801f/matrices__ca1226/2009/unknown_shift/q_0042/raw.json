  "question": {
    "text": "If $A^2-A+I=0$, then the inverse of the matrix $A$ is",
    "image": null
  },
  "options": [
    {
      "id": "9Dmss",
      "text": "$\\mathrm{A}-\\mathrm{I}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VroqM",
      "text": "$\\quad \\mathrm{I}-\\mathrm{A}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mBaUe",
      "text": "$\\mathrm{A}+\\mathrm{I}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "c5CRh",
      "text": "$\\mathrm{A}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints : $\\mathrm{A}^2-\\mathrm{A}+\\mathrm{I}=0 \\Rightarrow \\mathrm{A}^2=\\mathrm{A}-\\mathrm{I} \\Rightarrow \\mathrm{A}^2 \\cdot \\mathrm{A}^{-1}=\\mathrm{A} \\cdot \\mathrm{A}^{-1}-\\mathrm{A}^{-1} \\Rightarrow \\mathrm{A}=\\mathrm{I}-\\mathrm{A}^{-1} \\Rightarrow \\mathrm{A}^{-1}=\\mathrm{I}-\\mathrm{A}$",
    "image": null
  },
