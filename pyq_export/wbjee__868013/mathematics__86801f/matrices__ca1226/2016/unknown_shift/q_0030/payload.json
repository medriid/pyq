  "question": {
    "text": "Let $A$ be a $3 \\times 3$ matrix and $B$ be its adjoint matrix. If $|B|=64,$ then $|A|$ is equal to"
  },
  "options": [
    {
      "text": "±2",
      "is_correct": false
    },
    {
      "text": "$\\pm 4$",
      "is_correct": false
    },
    {
      "text": "$\\pm 8$",
      "is_correct": true
    },
    {
      "text": "±12",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "We have,\r\n$|B|=64$\r\n$\\Rightarrow |\\operatorname{adj} A \\mid=64$\r\n$\\Rightarrow|A|^{2}=64$\r\n$|A|=\\pm 8$"
  }
}