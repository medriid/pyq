  "question": {
    "text": "If P is a non-singular matrix of order $5 \\times 5$ and the sum of the elements of each row is 1 , then the sum of the elements of each row in $\\mathrm{P}^{-1}$ is",
    "image": null
  },
  "options": [
    {
      "id": "fWWER",
      "text": "$0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AiWVr",
      "text": "$1$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "RJ6hh",
      "text": "$\\frac{1}{8}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "R6IJa",
      "text": "$8$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Given, $\\mathrm{P}\\left[\\begin{array}{l}1 \\\\ 1 \\\\ 1 \\\\ 1 \\\\ 1\\end{array}\\right]=\\left[\\begin{array}{l}1 \\\\ 1 \\\\ 1 \\\\ 1 \\\\ 1\\end{array}\\right] \\Rightarrow \\mathrm{P}^{-1} \\mathrm{P}\\left[\\begin{array}{l}1 \\\\ 1 \\\\ 1 \\\\ 1 \\\\ 1\\end{array}\\right]=\\mathrm{P}^{-1}\\left[\\begin{array}{l}1 \\\\ 1 \\\\ 1 \\\\ 1 \\\\ 1\\end{array}\\right] \\Rightarrow \\mathrm{I}_5\\left[\\begin{array}{l}1 \\\\ 1 \\\\ 1 \\\\ 1 \\\\ 1\\end{array}\\right]=\\mathrm{P}^{-1}\\left[\\begin{array}{l}1 \\\\ 1 \\\\ 1 \\\\ 1 \\\\ 1\\end{array}\\right]\\left(\\begin{array}{l}\\mathrm{I}_5 \\text { is } \\\\ \\text { identify } \\\\ \\text { Matrix }\\end{array}\\right)$",
    "image": null
  },
