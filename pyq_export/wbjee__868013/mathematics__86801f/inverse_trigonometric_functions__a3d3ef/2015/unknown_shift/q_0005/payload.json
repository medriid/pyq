  "question": {
    "text": "The value of $2 \\cot ^{-1} \\frac{1}{2}-\\cot ^{-1} \\frac{4}{3}$ is"
  },
  "options": [
    {
      "text": "$-\\frac{\\pi}{8}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3 \\pi}{2}$",
