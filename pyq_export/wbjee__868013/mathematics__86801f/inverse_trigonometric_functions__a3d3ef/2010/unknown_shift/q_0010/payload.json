  "question": {
    "text": "Value of $\\tan ^{-1}\\left(\\frac{\\sin 2-1}{\\cos 2}\\right)$ is"
  },
  "options": [
    {
      "text": "$\\frac{\\pi}{2}-1$",
      "is_correct": false
    },
    {
      "text": "$1-\\frac{\\pi}{4}$",
      "is_correct": true
    },
    {
      "text": "$2-\\frac{\\pi}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{4}-1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hints : $\\tan ^{-1}\\left(\\frac{\\sin 2-1}{\\cos 2}\\right)=\\tan ^{-1}\\left(\\frac{-(\\sin 1-\\cos 1)^2}{(\\cos 1-\\sin 1)(\\cos 1+\\sin 1)}\\right) \\quad=-\\tan ^{-1}\\left(\\frac{\\cos 1-\\sin 1}{\\cos 1+\\sin 1}\\right)=1-\\frac{\\pi}{4}$"
  }
}