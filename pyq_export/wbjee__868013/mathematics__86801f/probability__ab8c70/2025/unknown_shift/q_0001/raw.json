  "question": {
    "text": "The probability that a non-leap year selected at random will have 53 Sundays or 53 Saturdays is",
    "image": null
  },
  "options": [
    {
      "id": "M4Ric",
      "text": "$\\frac{1}{7}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "m1Ge1",
      "text": "$\\frac{2}{7}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "hYpB1",
      "text": "$1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8UwIU",
      "text": "$\\frac{2}{365}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "No. days $=365=52$ weeks +1 extra day\n$\\begin{aligned}\n& \\quad\\{\\mathrm{S}, \\mathrm{M}, \\mathrm{~T}, \\mathrm{~W}, \\text { Th, F, Sat }\\} \\\\\n& \\mathrm{P}((53 \\mathrm{~S}) \\mathrm{U}(53 \\text { Sat }))=\\mathrm{P}(\\text { Sat })+\\mathrm{P}(\\mathrm{~S}) \\\\\n& =\\frac{1}{7}+\\frac{1}{7}=\\frac{2}{7}\n\\end{aligned}$",
    "image": null
  },
