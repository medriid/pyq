  "question": {
    "text": "A determinant is chosen at random from the set of all determinants of order 2 with elements 0 or 1 only. The probability that the determinant chosen is non-zero is",
    "image": null
  },
  "options": [
    {
      "id": "nMgTg",
      "text": "$\\frac{3}{16}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zzHc6",
      "text": "$\\frac{3}{8}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "K7B9S",
      "text": "$\\frac{1}{4}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fMnBd",
      "text": "$\\frac{5}{8}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\left|\\begin{array}{ll}a & b \\\\ c & d\\end{array}\\right|=a d-b c=0$\nCase $1: a d=b c=0 \\rightarrow 3 \\times 3=9$ cases\nCase $2:$ ad $=\\mathrm{bc}=1 \\rightarrow 1$ case only\n$\\therefore$ Probability $=1-\\frac{9+1}{2^4}=\\frac{3}{8}$",
    "image": null
  },
