  "question": {
    "text": "$A, B, C$ are mutually exclusive events such that $P(A)=\\frac{3 x+1}{3}, P(B)=\\frac{1-x}{4}$ and $P(C)=\\frac{1-2 x}{2}$. Then the set of possible values of $\\mathrm{x}$ are in"
  },
  "options": [
    {
      "text": "$[0,1]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\frac{1}{3}, \\frac{1}{2}\\right]$",
      "is_correct": true
    },
    {
      "text": "$\\left[\\frac{1}{3}, \\frac{2}{3}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\frac{1}{3}, \\frac{13}{3}\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$0 \\leq \\mathrm{P}(\\mathrm{A})+\\mathrm{P}(\\mathrm{B})+\\mathrm{P}(\\mathrm{C}) \\leq 1$ and $0 \\leq \\mathrm{P}(\\mathrm{A}) \\leq 1,0 \\leq \\mathrm{P}(\\mathrm{B}) \\leq 1,0 \\leq \\mathrm{P}(\\mathrm{C}) \\leq 1 \\Rightarrow \\frac{1}{3} \\leq \\mathrm{x} \\leq \\frac{1}{2}$"
  }
}