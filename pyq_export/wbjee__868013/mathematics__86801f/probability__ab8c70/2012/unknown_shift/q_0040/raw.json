  "question": {
    "text": "Two decks of playing cards are well shuffled and 26 cards are randomly distributed to a player. Then, the probability that the player gets all distinct cards is",
    "image": null
  },
  "options": [
    {
      "id": "ZUFhU",
      "text": "${ }^{52} C_{26} /{ }^{104} C_{26}$",
      "isCorrect": false,
