  "question": {
    "text": "Ram is visiting a friend. Ram knows that his friend has 2 children and 1 of them is a boy. Assuming that a child is equally likely to be a boy or a girl, then the probability that the other child is a girl, is",
    "image": null
  },
  "options": [
    {
      "id": "N1ed6",
      "text": "$1 / 2$.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "RsRAe",
      "text": "$1 / 3$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "JmMs1",
      "text": "$2 / 3$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "ptBS0",
      "text": "$7 / 10$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Total sample space $=\\left\\{B_{1} B_{2}, B_{1} G_{1}, G_{1} B_{2}\\right\\}$\r\nFavourable ways $=\\left\\{B_{1} G_{1}, G_{1} B_{2}\\right\\}$\r\n$\\therefore$ Required probability $=\\frac{2}{3}$",
    "image": null
