  "question": {
    "text": "The mean and variance of a binomial distribution are 4 and 2 respectively. Then the probability of exactly two succsses is"
  },
  "options": [
    {
      "text": "$\\frac{7}{64}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{21}{128}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{7}{32}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{9}{32}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{np}=4, \\mathrm{npq}=2$\r\n$\\therefore \\mathrm{q}=\\frac{2}{4}=\\frac{1}{2} \\Rightarrow \\mathrm{p}=\\frac{1}{2} \\therefore \\mathrm{n}=8$\r\n$\\mathrm{p}(\\mathrm{x}=2)={ }^{8} \\mathrm{C}_{2}\\left(\\frac{1}{2}\\right)^{8}=\\frac{28}{256}=\\frac{7}{64}$"
  }
}