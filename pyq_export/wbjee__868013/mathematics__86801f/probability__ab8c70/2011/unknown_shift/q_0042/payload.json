  "question": {
    "text": "4 boys and 2 girls occupy seats in a row at random. Then the probability that the two girls occupy seats side by side is"
  },
  "options": [
    {
      "text": "\\(\\frac{1}{2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{4}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{3}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{1}{6}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "\\(\\begin{gathered} \\text {Hints: } \n\\mathrm{n}(\\mathrm{e})=\\lfloor 5 \\cdot\\lfloor 2 \\\\\n\\mathrm{n}(\\mathrm{s})=\\lfloor 6 \\\\\n\\mathrm{p}=\\frac{\\lfloor 5 \\cdot \\lfloor 2}{\\lfloor 6}=\\frac{2}{6}=\\frac{1}{3}\n\\end{gathered}\\)"
  }
