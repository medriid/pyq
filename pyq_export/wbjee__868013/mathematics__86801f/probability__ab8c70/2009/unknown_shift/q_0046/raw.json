  "question": {
    "text": "$A$ and $B$ are two independent events such that $P(A \\cup B)=0.8$ and $P(A)=0.3$. The $P(B)$ is",
    "image": null
  },
  "options": [
    {
      "id": "dDkmz",
      "text": "$\\frac{2}{7}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "wfiX5",
      "text": "$\\frac{2}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XNl4o",
      "text": "$\\frac{3}{8}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jX2Fb",
      "text": "$\\frac{1}{8}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints : Let $\\mathrm{P}(\\mathrm{B})=x$\n$$\n\\mathrm{P}(\\mathrm{A} \\cup \\mathrm{B})=\\mathrm{P}(\\mathrm{A})+\\mathrm{P}(\\mathrm{B})-\\mathrm{P}(\\mathrm{A} \\cap \\mathrm{B})=0.3+(1-x)-0.3(1-x)\n$$\nor $\\quad 0.8=1-x+0.3 x$\nor $\\quad 1-0.7 x=0.8$\nor $\\quad 0.7 x=0.2$\nor $\\quad x=\\frac{2}{7}$",
    "image": null
