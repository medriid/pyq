  "question": {
    "text": "Four persons A, B, C and D throw an unbiased die, turn by turn, in succession till one gets an even number and win the game. What is the probability that A wins if A begins?"
  },
  "options": [
    {
      "text": "$\\frac{1}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{7}{12}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{8}{15}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hint: \r\n$P(A$ win $)=\\left(\\frac{1}{2}\\right)+\\left(\\frac{1}{2}\\right)^{4}\\left(\\frac{1}{2}\\right)+\\left(\\frac{1}{2}\\right)^{8}\\left(\\frac{1}{2}\\right)+\\cdots$\r\n$=\\frac{\\frac{1}{2}}{1-\\left(\\frac{1}{2}\\right)^{4}}=\\frac{\\frac{1}{2}}{\\frac{15}{16}}=\\frac{8}{15}$"
  }
}