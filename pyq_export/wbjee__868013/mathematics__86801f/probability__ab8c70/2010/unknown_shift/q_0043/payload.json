  "question": {
    "text": "The probability that at least one of $A$ and $B$ occurs is 0.6 . If A and $B$ occur simultaneously with probability 0.3 , then $P^{\\prime}\\left(A^{\\prime}\\right)+P_{(}\\left(B^{\\prime}\\right)$ is"
  },
  "options": [
    {
      "text": "0.9",
      "is_correct": false
    },
    {
      "text": "0.15",
      "is_correct": false
    },
    {
      "text": "1.1",
      "is_correct": true
    },
    {
      "text": "1.2",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\begin{array}{cl}\n\\text { Hints: } \\mathrm{P}(\\mathrm{A} \\cup \\mathrm{B})=0.6 & \\mathrm{P}(\\mathrm{A})+\\mathrm{P}(\\mathrm{B})=\\mathrm{P}(\\mathrm{A} \\cup \\mathrm{B})+\\mathrm{P}(\\mathrm{A} \\cap \\mathrm{B})=0.9 \\\\\n\\mathrm{P}(\\mathrm{A} \\cap \\mathrm{B})=0.3 & \\mathrm{P}\\left(\\mathrm{A}^{\\prime}\\right)+\\mathrm{P}\\left(\\mathrm{B}^{\\prime}\\right)=2-0.9=1.1\n\\end{array}\n$$"
