  "question": {
    "text": "Two tangents to the circle $x^{2}+y^{2}=4$ at the points $A$ and $B$ meet at $M(-4,0)$. The area of the quadrilateral MAOB, where $O$ is the origin is",
    "image": null
  },
  "options": [
    {
      "id": "zt4Lb",
      "text": "$4 \\sqrt{3}$ sq. units",
      "isCorrect": true,
      "image": null
