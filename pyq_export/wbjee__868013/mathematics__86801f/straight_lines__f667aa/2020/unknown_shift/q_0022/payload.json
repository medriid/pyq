  "question": {
    "text": "The equation of the straight line passing through the point $(4,3)$ and making intercepts on the co-ordinate axes whose sum is $-1$ is"
  },
  "options": [
    {
      "text": "$\\frac{x}{2}-\\frac{y}{3}=1$",
      "is_correct": true
    },
    {
      "text": "$\\frac{x}{-2}+\\frac{y}{1}=1$",
      "is_correct": true
    },
    {
      "text": "$-\\frac{x}{3}+\\frac{y}{2}=1$",
      "is_correct": false
    },
    {
      "text": "$\\frac{x}{1}-\\frac{y}{2}=1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A",
    "B"
  ],
  "solution": {
    "text": "Hint: \r\nLet line be $\\frac{x}{a}+\\frac{y}{b}=1$, then $a+b=-1$\r\n$\\frac{4}{a}-\\frac{3}{1+a}=1 \\Rightarrow a=\\pm 2$"
  }
}