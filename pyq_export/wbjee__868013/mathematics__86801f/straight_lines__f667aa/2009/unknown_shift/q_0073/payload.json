  "question": {
    "text": "If $\\mathrm{C}$ is the reflecton of $\\mathrm{A}(2,4)$ in $\\mathrm{x}$-axis and $\\mathrm{B}$ is the reflection of $\\mathrm{C}$ in $\\mathrm{y}$-axis, then $|\\mathrm{AB}|$ is"
  },
  "options": [
    {
      "text": "20",
      "is_correct": false
    },
    {
      "text": "$2 \\sqrt{5}$",
      "is_correct": false
    },
    {
      "text": "$4 \\sqrt{5}$",
      "is_correct": true
    },
    {
      "text": "4",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: } \\mathrm{A} \\equiv(2,4) ; \\mathrm{C} \\equiv(2,-4) ; \\mathrm{B} \\equiv(-2,-4) \\\\\n& |A B|=\\sqrt{(2-(-2))^2+(4-(-4))^2}=\\sqrt{4^2+8^2} \\\\\n& =\\sqrt{16+64}=\\sqrt{80}=\\sqrt{16 \\times 5}=4 \\sqrt{5}\n\\end{aligned}\n$$\n<img src=\"assets\\st0073_484d28915ec9.png\"><br>"
  }
