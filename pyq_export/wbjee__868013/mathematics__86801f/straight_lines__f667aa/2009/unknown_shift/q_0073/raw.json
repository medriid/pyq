      "text": "20",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3oC4p",
      "text": "$2 \\sqrt{5}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "56C1u",
      "text": "$4 \\sqrt{5}$",
      "image": null,
      "isCorrect": true
