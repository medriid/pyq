  "question": {
    "text": "If $\\mathrm{C}$ is the reflecton of $\\mathrm{A}(2,4)$ in $\\mathrm{x}$-axis and $\\mathrm{B}$ is the reflection of $\\mathrm{C}$ in $\\mathrm{y}$-axis, then $|\\mathrm{AB}|$ is",
    "image": null
  },
  "options": [
    {
