  "question": {
    "text": "The number of points on the line $x+y=4$ which are unit distance apart from the line $2 x+2 y=5$ is"
  },
  "options": [
    {
      "text": "0",
      "is_correct": true
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "2",
      "is_correct": false
    },
    {
      "text": "Infinity",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints : $x+y=4$\n$$\n\\begin{aligned}\n& x+y=\\frac{5}{2} \\\\\n& \\mathrm{PQ}=\\frac{4-5 / 2}{\\sqrt{2}}=\\frac{3}{2 \\sqrt{2}}=\\frac{3 \\sqrt{2}}{4}\n\\end{aligned}\n$$"
  }
