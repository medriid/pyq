  "question": {
    "text": "The equations of the lines through $(1,1)$ and making angles of $45^{\\circ}$ with the line $x+y=0$ are",
    "image": null
  },
  "options": [
    {
      "id": "AAIZ5",
      "text": "$x-1=0, x-y=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YbqMi",
      "text": "$x-y=0, y-1=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "EXeiL",
      "text": "$x+y-2=0, y-1=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tsyO8",
      "text": "$\\mathrm{x}-1=0, \\mathrm{y}-1=0$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints : $m=1, y-1=\\frac{m \\pm \\tan 45}{1 \\mp m \\tan 45}(x-1), y-1=\\frac{(-1) \\pm 1}{1 \\pm 1}(x-1)$\n$y=1, x=1$",
