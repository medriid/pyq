  "question": {
    "text": "The value of a for which sum of the squares of the roots of the equation $x^2-(a-2) x-a-1=0$ assumes the least value is",
    "image": null
  },
  "options": [
    {
      "id": "nWXwz",
      "text": "0",
      "image": null,
      "isCorrect": false
    },
    {
