  "question": {
    "text": "If $\\alpha, \\beta$ be the roots of the quadratic equation $\\mathrm{x}^2+\\mathrm{x}+1=0$ then the equation whose roots are $\\alpha^{19}, \\beta^7$ is",
    "image": null
  },
  "options": [
