  "question": {
    "text": "For what value of ' $a$ ', the sum of the squares of the roots of the equation $x^2-(a-2) x-a+1=0$ will have the least value?",
    "image": null
  },
  "options": [
    {
      "id": "9lj1c",
      "text": "$2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yDE19",
      "text": "$0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZORkm",
      "text": "$3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "D5qQi",
      "text": "$1$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\alpha^2+\\beta^2=(\\alpha+\\beta)^2-2 \\alpha \\beta \\\\ & =(a-2)^2-2(1-a) \\\\ & =a^2-4 a+4-2+2 a \\\\ & =a^2-2 a+2 \\\\ & =(a-1)^2+1\\end{aligned}$",
    "image": null
  },
