  "question": {
    "text": "The equation $6^{x}+8^{x}=10^{x}$ has"
  },
  "options": [
    {
      "text": "no real root",
      "is_correct": false
    },
    {
      "text": "infinitely many rational roots",
      "is_correct": false
    },
    {
      "text": "exactly one real root",
      "is_correct": true
    },
    {
      "text": "two distinct real roots",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$6^{x}+8^{x}=10^{x}\\left(\\frac{3}{5}\\right)^{x}+\\left(\\frac{4}{5}\\right)^{x}=1 \\Rightarrow\\left(\\frac{3}{5}\\right)^{x}=1-\\left(\\frac{4}{5}\\right)^{x}$\r\n$\\therefore \\quad 6^{x}+8^{x}=10^{x}$ has exactly one real root\r\n<img src=\"assets\\st0011_2a743c29e433.png\">"
  }
}