  "question": {
    "text": "If \\(\\sin \\theta\\) and \\(\\cos \\theta\\) are the roots of the equation \\(a x^2-b x+c=0\\), then \\(\\mathrm{a}, \\mathrm{b}\\) and \\(\\mathrm{c}\\) satisfy the relation",
    "image": null
  },
  "options": [
    {
      "id": "NUQva",
      "text": "\\(a^2+b^2+2 a c=0\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1FODJ",
      "text": "\\(\\mathrm{a}^2-\\mathrm{b}^2+2 \\mathrm{ac}=0\\)",
