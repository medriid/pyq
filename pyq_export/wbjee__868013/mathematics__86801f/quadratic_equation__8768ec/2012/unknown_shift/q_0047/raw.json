  "question": {
    "text": "If $a, b$ and $c$ are in arithmetic progression, then the roots of the equation $a x^{2}-2 h x+c=0$ are",
    "image": null
  },
  "options": [
    {
      "id": "UiRCq",
      "text": "1 and $\\frac{c}{a}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "2mnaL",
      "text": "$-\\frac{1}{a}$ and $-c$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lQ0MK",
      "text": "-1 and $-\\frac{c}{a}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Inbr4",
      "text": "-2 and $-\\frac{c}{2 a}$",
      "isCorrect": false,
      "image": null
