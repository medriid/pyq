  "question": {
    "text": "If  $a, b \\in\\{1,2,3\\}$  and the equation $a x^{2}+b x+1=0$ has real roots, then",
    "image": null
  },
  "options": [
    {
      "id": "emkms",
      "text": "$a>b$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "6H5V3",
      "text": "$a \\leq b$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "oLHrk",
      "text": "number of possible ordered pairs $(a, b)$ is 3",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "2ydJW",
      "text": "$a    < b$",
      "isCorrect": true,
      "image": null
