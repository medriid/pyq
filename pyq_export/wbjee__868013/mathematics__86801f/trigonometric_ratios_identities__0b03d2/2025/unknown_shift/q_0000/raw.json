  "question": {
    "text": "If $0 \\leq a, b \\leq 3$ and the equation $x^2+4+3 \\cos (a x+b)=2 x$ has real solution, then the value of $(a+b)$ is",
    "image": null
  },
  "options": [
    {
      "id": "qKjR0",
      "text": "$\\frac{\\pi}{4}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "G3fmW",
      "text": "$\\frac{\\pi}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l1p69",
      "text": "$\\pi$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "qTZXd",
      "text": "$2 \\pi$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { }\\left(x^2-2 x+1\\right)+3(\\cos (a x+b)+1)=0 \\\\ & \\quad \\text { or, }(x-1)^2+3(\\cos (a x+b)+1)=0 \\\\ & \\quad a+b=\\pi\\end{aligned}$",
    "image": null
  },
