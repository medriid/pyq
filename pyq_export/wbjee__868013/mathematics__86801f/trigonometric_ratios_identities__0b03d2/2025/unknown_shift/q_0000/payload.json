  "question": {
    "text": "If $0 \\leq a, b \\leq 3$ and the equation $x^2+4+3 \\cos (a x+b)=2 x$ has real solution, then the value of $(a+b)$ is"
  },
  "options": [
    {
      "text": "$\\frac{\\pi}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\pi$",
      "is_correct": true
    },
    {
      "text": "$2 \\pi$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { }\\left(x^2-2 x+1\\right)+3(\\cos (a x+b)+1)=0 \\\\ & \\quad \\text { or, }(x-1)^2+3(\\cos (a x+b)+1)=0 \\\\ & \\quad a+b=\\pi\\end{aligned}$"
  }
}