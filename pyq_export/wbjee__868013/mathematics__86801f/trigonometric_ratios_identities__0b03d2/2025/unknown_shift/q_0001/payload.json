  "question": {
    "text": "If $\\cos (\\theta+\\phi)=\\frac{3}{5}$ and $\\sin (\\theta-\\phi)=\\frac{5}{13}, 0 \\lt \\theta, \\phi \\lt \\frac{\\pi}{4}$, then $\\cot (2 \\theta)$ has the value"
  },
  "options": [
    {
      "text": "$\\frac{16}{63}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{63}{16}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3}{13}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{13}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\tan 2 \\theta=\\tan ((\\theta+\\phi)+(\\theta-\\phi))\\left[\\begin{array}{l}\\because \\tan (\\theta+\\phi)=\\frac{4}{3} \\\\ \\tan (\\theta-\\phi)=\\frac{5}{12}\\end{array}\\right] \\\\ & =\\frac{\\tan (\\theta+\\phi)+\\tan (\\theta-\\phi)}{1-\\tan (\\theta+\\phi) \\tan (\\theta-\\phi)} \\\\ & =\\frac{\\frac{4}{3}+\\frac{5}{12}}{1-\\frac{4}{3} \\times \\frac{5}{12}}=\\frac{16+5}{36-20}=\\frac{21 \\times 3}{16}=\\frac{63}{16} \\\\ & \\cot (2 \\theta)=\\frac{16}{63}\\end{aligned}$"
  }
}