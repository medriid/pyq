  "question": {
    "text": "The value of $\\cos ^{2} 75^{\\circ}+\\cos ^{2} 45^{\\circ}+\\cos ^{2} 15^{\\circ}$ $-\\cos ^{2} 30^{\\circ}-\\cos ^{2} 60^{\\circ}$ is"
  },
  "options": [
