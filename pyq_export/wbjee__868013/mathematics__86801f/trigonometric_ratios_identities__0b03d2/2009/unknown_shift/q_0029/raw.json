  "question": {
    "text": "The value of $(1+\\cos \\pi / 6)(1+\\cos \\pi / 3)(1+\\cos 2 \\pi / 3)(1+\\cos 7 \\pi / 6)$ is",
    "image": null
  },
  "options": [
    {
