  "question": {
    "text": "The value of $\\cos 15^{\\circ} \\cos 7 \\frac{1^0}{2} \\sin 7 \\frac{1^0}{2}$ is",
    "image": null
  },
  "options": [
    {
      "id": "Vu8Zp",
      "text": "$\\frac{1}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nqnQ7",
      "text": "$\\frac{1}{8}$",
      "image": null,
      "isCorrect": true
    },
    {
