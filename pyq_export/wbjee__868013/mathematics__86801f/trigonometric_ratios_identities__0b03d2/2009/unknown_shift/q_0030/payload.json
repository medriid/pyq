  "question": {
    "text": "The value of $\\cos 15^{\\circ} \\cos 7 \\frac{1^0}{2} \\sin 7 \\frac{1^0}{2}$ is"
  },
  "options": [
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{8}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{16}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints : } \\cos 15^{\\circ} \\cos 7 \\frac{1}{2}^0 \\sin 7 \\frac{1}{2}^0=\\frac{1}{2}\\left(2 \\sin 7 \\frac{1}{2}^0 \\cos 7 \\frac{1}{2}^0\\right) \\cdot\\left(\\cos 15^{\\circ}\\right) \\\\\n& \\frac{1}{2}\\left(\\sin 15^{\\circ}\\right)\\left(\\cos 15^{\\circ}\\right)=\\frac{1}{4}\\left(2 \\sin 15^{\\circ} \\cos 15^{\\circ}\\right)=\\frac{1}{4} \\times \\sin 30^0=\\frac{1}{8}\n\\end{aligned}\n$$"
