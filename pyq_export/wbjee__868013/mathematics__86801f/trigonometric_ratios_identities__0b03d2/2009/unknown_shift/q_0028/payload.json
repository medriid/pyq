  "question": {
    "text": "Simplest form of $\\frac{2}{\\sqrt{2+\\sqrt{2+\\sqrt{2+2 \\cos 4 x}}}}$ is"
  },
  "options": [
    {
      "text": "$\\sec \\frac{x}{2}$",
      "is_correct": true
    },
    {
      "text": "$\\sec x$",
      "is_correct": false
    },
    {
      "text": "$\\operatorname{cosec} x$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n\\text { Hints : } \\begin{aligned}\n& \\frac{2}{\\sqrt{2+\\sqrt{2+\\sqrt{2.2 \\cos ^2 2 x}}}}=\\frac{2}{\\sqrt{2+\\sqrt{2+2 \\cos 2 x}}}=\\frac{2}{\\sqrt{2+\\sqrt{2.2 \\cos ^2 x}}} \\\\\n& =\\frac{2}{\\sqrt{2+2 \\cos x}}=\\frac{2}{2 \\cos \\frac{x}{2}}=\\sec \\frac{x}{2}\n\\end{aligned}\n$$"
  }
}