  "question": {
    "text": "The equation \\(r^2 \\cos ^2\\left(\\theta-\\frac{\\pi}{3}\\right)=2\\) represents",
    "image": null
  },
  "options": [
    {
      "id": "y2UZy",
      "text": "a parabola",
      "image": null,
      "isCorrect": false
    },
    {
