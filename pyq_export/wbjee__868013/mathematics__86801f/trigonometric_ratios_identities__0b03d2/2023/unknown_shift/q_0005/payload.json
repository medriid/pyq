  "question": {
    "text": "The equation \\(r^2 \\cos ^2\\left(\\theta-\\frac{\\pi}{3}\\right)=2\\) represents"
  },
  "options": [
    {
      "text": "a parabola",
      "is_correct": false
    },
    {
      "text": "a hyperbola",
      "is_correct": false
    },
    {
      "text": "a circle",
      "is_correct": false
    },
    {
      "text": "a pair of straight lines",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text {Hint: } r^2\\left(\\frac{\\cos \\theta}{2}+\\frac{\\sqrt{3}}{2} \\sin \\theta\\right)^2=2 \\\\\n& \\Rightarrow \\quad(r \\cos \\theta+\\sqrt{3} r \\sin \\theta)^2=8 \\\\\n& \\Rightarrow \\quad(x+y \\sqrt{3})^2=8 \\\\\n& \\Rightarrow \\quad(x+y \\sqrt{3}-2 \\sqrt{2})(x+y \\sqrt{3}+2 \\sqrt{2})=0 \\\\\n& \\Rightarrow \\quad \\text { a pair of straight lines }\n\\end{aligned}\\)"
  }
}