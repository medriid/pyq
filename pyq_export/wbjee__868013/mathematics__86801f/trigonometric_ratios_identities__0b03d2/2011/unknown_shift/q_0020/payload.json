  "question": {
    "text": "Let \\(\\tan \\alpha=\\frac{a}{a+1}\\) and \\(\\tan \\beta=\\frac{1}{2 a+1}\\) then \\(\\alpha+\\beta\\) is"
  },
  "options": [
    {
      "text": "\\(\\frac{\\pi}{4}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{\\pi}{3}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{\\pi}{2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\pi\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text { Hints: } \\tan \\alpha=\\frac{a}{a+1}, \\tan \\beta=\\frac{1}{2 a+1} \\\\\n& \\tan (\\alpha+\\beta)=\\frac{\\frac{a}{a+1}+\\frac{1}{2 a+1}}{1-\\frac{a}{(a+1)(2 a+1)}}=\\frac{\\frac{a(2 a+1)+a+1}{(a+1)(2 a+1)}}{\\frac{(a+1)(2 a+1)-a}{(a+1)(2 a+1)}}=\\frac{2 a^2+2 a+1}{2 a^2+2 a+1}=1 \\\\\n& \\alpha+\\beta=\\frac{\\pi}{4}\n\\end{aligned}\\)"
  }
}