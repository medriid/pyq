      "text": "1",
      "is_correct": false
    },
    {
      "text": "2",
      "is_correct": true
    },
    {
      "text": "\\(5 / 2\\)",
      "is_correct": false
    },
    {
      "text": "\\(1 / 3\\)",
      "is_correct": false
