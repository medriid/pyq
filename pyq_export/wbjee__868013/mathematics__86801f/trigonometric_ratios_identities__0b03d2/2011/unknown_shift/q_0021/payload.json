  "question": {
    "text": "If \\(\\sin \\theta=\\frac{2 t}{1+t^2}\\) and \\(\\theta\\) lies in the second quadrant, then \\(\\cos \\theta\\) is equal to"
  },
  "options": [
    {
      "text": "\\(\\frac{1-t^2}{1+t^2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{t^2-1}{1+t^2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{-\\left|1-t^2\\right|}{1+t^2}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{1+t^2}{\\left|1-t^2\\right|}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Hints: \\(\\theta\\) in 2nd quad \\(\\cos \\theta  < 0\\)\n\\(\\begin{aligned}\n& |\\cos \\theta|=\\left|\\frac{1-t^2}{1+t^2}\\right|=\\frac{\\left|1-t^2\\right|}{1+t^2} \\\\\n& \\cos \\theta=-\\frac{\\left|1-t^2\\right|}{1+t^2}\n\\end{aligned}\\)"
  }
