  "question": {
    "text": "The expression $\\cos ^2 \\phi+\\cos ^2(\\theta+\\phi)-2 \\cos \\theta \\cos \\phi \\cos (\\theta+\\phi)$ is"
  },
  "options": [
    {
      "text": "independent of $\\theta$",
