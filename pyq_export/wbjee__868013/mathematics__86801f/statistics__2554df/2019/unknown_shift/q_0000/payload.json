  "question": {
    "text": "If $X$ is a random variable such that $\\sigma(X)=2.6$ then $\\sigma(1-4 x)$ is equal to"
  },
  "options": [
    {
      "text": "7.8",
      "is_correct": false
    },
    {
      "text": "$-10.4$",
      "is_correct": false
    },
    {
      "text": "13",
      "is_correct": false
    },
    {
      "text": "10.4",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Given that,\r\n$$\r\n\\begin{aligned}\r\n\\sigma(X) &=2.6=\\sqrt{\\operatorname{var}(x)} \\\\\r\n\\sigma(1-4 x) &=\\sqrt{\\operatorname{var}(1-4 x)} \\\\\r\n&=\\sqrt{16 \\operatorname{var}(x)} \\\\\r\n&=4 \\times \\sqrt{\\operatorname{var}(x)}=4 \\times 2.6=10.4\r\n\\end{aligned}\r\n$$"
  }
}