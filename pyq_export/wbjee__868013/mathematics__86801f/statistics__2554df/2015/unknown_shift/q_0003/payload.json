  "question": {
    "text": "The variance of first 20 natural numbers is"
  },
  "options": [
    {
      "text": "$133 / 4$",
      "is_correct": true
    },
    {
      "text": "$279 / 12$",
      "is_correct": false
    },
    {
      "text": "133/2",
      "is_correct": false
    },
    {
      "text": "399/4",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Variance of $n$ natural numbers $=\\frac{n^{2}-1}{12}=\\frac{(20)^{2}-1}{12} \\quad$ $[\\because n=20]$,\r\n$=\\frac{400-1}{12}=\\frac{399}{12}=\\frac{133}{4}$"
  }
}