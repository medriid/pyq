  "question": {
    "text": "The equation of the plane through the intersection of the planes $x+y+z=1$ and $2 x+3 y-z+4$ and parallel to the $x$-axis is",
    "image": null
  },
  "options": [
    {
      "id": "9v5iV",
      "text": "$y+3 z+6=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4Y2K5",
      "text": "$y+3 z-6=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9Oz37",
      "text": "$y-3 z+6=0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "xomIt",
      "text": "$y-3 z-6=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\quad(2 x+3 y-z+4)+\\lambda(x + y+z-1)=0$\n$\\overrightarrow{\\mathrm{n}}=(2+\\lambda) \\hat{\\mathrm{i}}+(3+\\lambda) \\hat{\\mathrm{j}}+(-1+\\lambda) \\hat{\\mathrm{k}}$\n$\\overrightarrow{\\mathrm{n}} \\cdot \\overrightarrow{\\mathrm{i}}=0 \\Rightarrow \\lambda=-2$\n$\\Rightarrow \\mathrm{y}-3 z+6=0$",
    "image": null
  },
