  "question": {
    "text": "The value of $\\frac{2}{3 !}+\\frac{4}{5 !}+\\frac{6}{7 !}+\\ldots \\ldots$. is"
  },
  "options": [
    {
      "text": "$\\mathrm{e}^{\\frac{1}{2}}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{e}^{-1}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{e}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{e}^{-\\frac{1}{3}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{gathered}\n\\text { Hints: } t_n=\\frac{2 n}{(2 n+1) !}=\\frac{2 n+1}{(2 n+1) !}-\\frac{1}{(2 n+1) !}=\\frac{1}{(2 n) !}-\\frac{1}{(2 n+1) !} \\\\\n\\sum_{n=1}^{\\infty} t_n=\\frac{1}{2 !}-\\frac{1}{3 !}+\\frac{1}{4 !}-\\frac{1}{5 !}+\\ldots \\ldots \\infty=\\mathrm{e}^{-1}\n\\end{gathered}\n$$"
  }
}