  "question": {
    "text": "If the total number of m-element subsets of the set $\\mathrm{A}=\\left\\{\\mathrm{a}{1}, \\mathrm{a}{2}, \\ldots . \\mathrm{a}{\\mathrm{n}}\\right\\}$ is $\\mathrm{k}$ times the number of $\\mathrm{m}$ element subsets containing $\\mathrm{a}{4}$, then $\\mathrm{n}$ is"
  },
  "options": [
    {
      "text": "$(m-1) k$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{mk}$",
      "is_correct": true
    },
    {
      "text": "$(m+1) k$",
      "is_correct": false
    },
    {
      "text": "$(m+2) k$",
      "is_correct": false
    }
  ],
  "correct_answer": [
