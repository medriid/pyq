  "question": {
    "text": "If ${ }^9 P_5+5 .{ }^9 P_4={ }^{10} P_r$, then the value ' $r$ ' is"
  },
  "options": [
    {
      "text": "$4$",
      "is_correct": false
    },
    {
      "text": "$8$",
      "is_correct": false
    },
    {
      "text": "$5$",
      "is_correct": true
    },
    {
      "text": "$7$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned}{ }^9 P_5+5. ^9P_4 & =\\frac{9!}{4!}+5 \\cdot \\frac{9!}{5!} \\\\ & =\\frac{9!}{4!}+\\frac{9!}{4!}=2 \\cdot \\frac{9!}{4!} \\\\ & =2 \\cdot \\frac{10.9!}{10.4!}=\\frac{10!}{5!}={ }^{10} P_r \\\\ & \\Rightarrow r=5\\end{aligned}$"
  }
}