  "question": {
    "text": "\\(\\mathrm{n}\\) objects are distributed at random among \\(\\mathrm{n}\\) persons. The number of ways in which this can be done so that at least one of them will not get any object is",
    "image": null
  },
  "options": [
    {
      "id": "V1Mbg",
      "text": "\\(n !-n\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BJlIC",
      "text": "\\(n^n-n\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YX6XL",
      "text": "\\(n^n-n^2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qxtzp",
      "text": "\\(n^n-n\\) !",
      "image": null,
      "isCorrect": true
    }
