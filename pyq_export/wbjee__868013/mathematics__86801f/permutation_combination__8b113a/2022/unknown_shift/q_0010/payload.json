  "question": {
    "text": "A is a set containing n elements. $P$ and $Q$ are two subsets of $A$. Then the number of ways of choosing $P$ and $Q$ so that $P \\cap Q=\\varphi$ is"
  },
  "options": [
    {
      "text": "$2^{2 n \\space 2 n} C_n$",
      "is_correct": false
    },
    {
      "text": "$2^n$",
      "is_correct": false
    },
    {
      "text": "$3^n-1$",
      "is_correct": false
    },
    {
      "text": "3^n",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\sum_{r=0}^n{ }^n C_r \\cdot 2^{n-r}=(2+1)^n=3^n$ (Assuming $P$ contains r elements then $Q$ can be formed with $n-r$ elements in $2^{n-r}$ ways)"
  }
}