  "question": {
    "text": "There are $n$ white and $n$ black balls marked $1,2,3, \\ldots . n$. The number of ways in which we can arrange these balls in a row so that neighbouring balls are of different colours is"
  },
  "options": [
    {
      "text": "$(n !)^2$",
      "is_correct": false
    },
    {
      "text": "(2n)!",
      "is_correct": false
    },
    {
      "text": "$2(n !)^2$",
      "is_correct": true
    },
    {
      "text": "$\\frac{(2 n) !}{(n !)^2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "BW BW ..... $=n ! \\times n !$\nor\nWB WB ..... $=2(n !)^2$"
