  "correctValue": null,
  "solution": {
    "text": "Hint : For 0 to \\(\\frac{1}{2}\\)\n\\(\\begin{aligned} & x^2 \\geq x^{2 n} \\\\ & \\Rightarrow-x^2 \\leq-x^{2 n} \\\\ & \\Rightarrow 1-x^2 \\leq 1-x^{2 n} \\\\ & \\Rightarrow \\frac{1}{\\sqrt{1-x^2}} \\geq \\frac{1}{\\sqrt{1-x^{2 n}}} \\\\ & \\Rightarrow \\int_0^{1 / 2} \\frac{1}{\\sqrt{1-x^2}} d x \\geq \\int_0^{1 / 2} \\frac{1}{\\sqrt{1-x^{2 n}}} d x \\\\ & \\Rightarrow\\left[\\sin ^{-1} x\\right]_0^{1 / 2} \\geq \\mathrm{I} \\\\ & \\Rightarrow \\frac{\\pi}{6} \\geq I \\\\ & \\end{aligned}\\)",
    "image": null
  },
