  "question": {
    "text": "$\\int \\frac{d x}{x(x+1)}$ equals\nwhere $c$ is an arbitrary constant."
  },
  "options": [
    {
      "text": "$\\ln \\left|\\frac{x+1}{x}\\right|+c$",
      "is_correct": false
    },
    {
      "text": "$\\ln \\left|\\frac{x}{x+1}\\right|+c$",
      "is_correct": true
    },
    {
      "text": "$\\ln \\left|\\frac{x-1}{x}\\right|+c$",
      "is_correct": false
    },
    {
      "text": "$\\ln \\left|\\frac{x-1}{x+1}\\right|+c$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\text { Hints : } \\int \\frac{d x}{x(x+1)}=\\int\\left(\\frac{1}{x}-\\frac{1}{x+1}\\right) d x=\\int \\frac{d x}{x}-\\int \\frac{d x}{x+1}=\\ln |x|-\\ln |x+1|+C=\\ln \\left|\\frac{x}{x+1}\\right|+C\n$$"
  }
}