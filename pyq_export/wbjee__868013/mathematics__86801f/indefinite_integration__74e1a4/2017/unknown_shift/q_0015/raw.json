  "question": {
    "text": "$\\int \\frac{x^{2}-1}{x^{4}+3 x^{2}+1} d x(x>0)$ is",
    "image": null
  },
  "options": [
    {
      "id": "FB0ip",
      "text": "$\\tan ^{-1}\\left(x+\\frac{1}{x}\\right)+C$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Wxead",
      "text": "$\\tan ^{-1}\\left(x-\\frac{1}{x}\\right)+C$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XTmEL",
      "text": "$\\log _{e}\\left|\\frac{x+\\frac{1}{x}-1}{x+\\frac{1}{x}+1}\\right|+C$",
      "isCorrect": false,
