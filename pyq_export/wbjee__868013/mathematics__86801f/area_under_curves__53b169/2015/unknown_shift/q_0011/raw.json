  "question": {
    "text": "If the point $(2 \\cos \\theta, 2 \\sin \\theta)$ for $0 \\in(0,2 \\pi)$ lies in the region between the lines $x+y=2$ and $x-y=2$ containing the origin, then $\\theta$ lies in",
    "image": null
  },
  "options": [
    {
      "id": "Wvr2c",
      "text": "$\\left(\\theta, \\frac{\\pi}{2}\\right) \\cup\\left(\\frac{3 \\pi}{2}, 2 \\pi\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "cfdfw",
      "text": "$[0, n]$",
      "isCorrect": false,
      "image": null
    },
    {
