  "question": {
    "text": "Area of the figure bounded by the parabola $y^2+8 x=16$ and $y^2-24 x=48$ is",
    "image": null
  },
  "options": [
    {
      "id": "IDx7S",
      "text": "$\\frac{11}{9}$ sq. unit",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iUHAZ",
      "text": "$\\frac{32}{3} \\sqrt{6}$ sq. unit",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8WYex",
      "text": "$\\frac{16}{3}$ sq. unit",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gMdlV",
      "text": "$\\frac{24}{5}$ sq. unit",
