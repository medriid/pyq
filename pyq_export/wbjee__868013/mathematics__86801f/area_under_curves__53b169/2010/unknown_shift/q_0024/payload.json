  "question": {
    "text": "The area of the region bounded by $y^2=x$ and $y=|x|$ is"
  },
  "options": [
    {
      "text": "$\\frac{1}{3}$ sq.unit",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{6}$ sq.unit",
      "is_correct": true
    },
    {
      "text": "$\\frac{2}{3}$ sq. unit",
      "is_correct": false
    },
    {
      "text": "1 sq.unit",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hints: $\\mathrm{y}^2=\\mathrm{x}$\n$$\n\\left.\\int_0^1(\\sqrt{x}-x) d x=\\frac{x^{\\frac{3}{2}}}{\\frac{3}{2}}-\\frac{x^2}{2}\\right]_0^1=\\frac{3}{2}-\\frac{1}{2}=\\frac{4-3}{6}=\\frac{1}{6}\n$$"
  }
}