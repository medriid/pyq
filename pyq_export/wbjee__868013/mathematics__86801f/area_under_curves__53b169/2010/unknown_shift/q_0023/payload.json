  "question": {
    "text": "The area enclosed by $y=3 x-5, y=0, x=3$ and $x=5$ is"
  },
  "options": [
    {
      "text": "12 sq. units",
      "is_correct": false
    },
    {
      "text": "13 sq. units",
      "is_correct": false
    },
    {
      "text": "$13 \\frac{1}{2}$ sq. units",
      "is_correct": false
    },
    {
      "text": "$14 \\mathrm{sq}$. units",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hints: $A=\\int_3^5(3 x-5) d x$\n$=\\frac{3}{2}\\left(x^2\\right)_3^5-5(x)_3^5,=\\frac{3}{2}[25-9]-5(5-3)$\n$\\frac{3}{2} \\cdot 16-5(2)=24-10=14$"
  }
}