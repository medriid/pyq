  "question": {
    "text": "The equation $r \\cos \\theta=2 a \\sin ^2 \\theta$ represents the curve"
  },
  "options": [
    {
      "text": "$\\mathrm{x}^3=\\mathrm{y}^2(2 a+\\mathrm{x})$",
      "is_correct": false
    },
    {
      "text": "$x^2=y^2(2 a+x)$",
      "is_correct": false
    },
    {
      "text": "$x^3=y^2(2 a-x)$",
      "is_correct": true
    },
    {
      "text": "$x^3=y^2(a+x)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { Hint: } \\quad \\mathrm{r} \\cos \\theta=2 \\mathrm{a}^2 \\sin ^2 \\theta \\\\ & \\Rightarrow \\quad \\mathrm{x}\\left(\\mathrm{x}^2+\\mathrm{y}^2\\right)=2 \\mathrm{ay}^2 \\\\ & \\Rightarrow \\quad \\mathrm{x}^3=\\mathrm{y}^2(2 \\mathrm{a}-\\mathrm{x})\\end{aligned}$"
  }
}