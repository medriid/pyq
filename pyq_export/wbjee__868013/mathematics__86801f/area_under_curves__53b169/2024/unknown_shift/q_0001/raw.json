  "question": {
    "text": "The area bounded by the curves $x=4-y^2$ and the $Y$-axis is",
    "image": null
  },
  "options": [
    {
      "id": "pUHtB",
      "text": "16 sq. unit",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Y5EdI",
      "text": "$\\frac{32}{3}$ sq. unit",
