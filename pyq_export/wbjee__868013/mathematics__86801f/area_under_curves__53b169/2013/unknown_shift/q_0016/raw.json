  "question": {
    "text": "If $f(x)=x^{2 / 3}, x \\geq 0 .$ Then, the area of the region enclosed by the curve $y=f(x)$ and the three lines $y=x, x=1$ and $x=8$ is",
    "image": null
  },
  "options": [
    {
      "id": "8pm88",
      "text": "$\\frac{63}{2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "fvaj8",
      "text": "$\\frac{93}{5}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "AWIXK",
      "text": "$\\frac{105}{7}$",
      "isCorrect": false,
