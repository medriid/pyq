  "question": {
    "text": "The area bounded by the parabolas $y=4 x^{2}, y=\\frac{x^{2}}{9}$ and the straight line $y=2$ is"
  },
  "options": [
    {
      "text": "$\\frac{20 \\sqrt{2}}{3}$ sq. unit",
      "is_correct": true
    },
    {
      "text": "$10 \\sqrt{5}$ sq. unit",
      "is_correct": false
    },
    {
      "text": "$\\frac{10 \\sqrt{3}}{7}$ sq. unit",
      "is_correct": false
    },
    {
      "text": "$10 \\sqrt{2}$ sq. unit",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$y=4 x^{2}, y=\\frac{x^{2}}{9}, y=2$\r\n<img src=\"assets\\st0003_0c4baacf809a.png\"><br>$A=2 \\int_{0}^{2}\\left(3 \\sqrt{y}-\\frac{\\sqrt{y}}{2}\\right) d y=2 \\int_{0}^{2} \\frac{5 \\sqrt{y}}{2} d y=\\left.5 \\frac{y^{3 / 2}}{3 / 2}\\right|_{0} ^{2}=\\frac{10}{3}\\left[2^{3 / 2}\\right]=\\frac{20 \\sqrt{2}}{3}$"
  }
