  "question": {
    "text": "The straight line through the origin which divides the area formed by the curves $y=2 x-x^{2}, y=0$ and $x=1$ into two equal halves is",
    "image": null
  },
  "options": [
    {
      "id": "ui2bb",
      "text": "$y=x$",
      "isCorrect": false,
      "image": null
    },
    {
