  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/Tw6uZzx7mp-SmIIeQa_NniuEjWawi3ShYvBLlld3QMQ.original.fullsize.png\"><br>\n\\(\\begin{aligned} & \\text { Hints: } A=\\int_0^4\\left(\\sqrt{4 \\mathrm{x}}-\\frac{\\mathrm{x}^2}{4}\\right) \\mathrm{dx} \\\\ & \\left.=2 \\cdot \\frac{2}{3}\\left(\\mathrm{x}^{3 / 2}\\right)_0^4-\\frac{1}{4.3}\\right)\\left(\\mathrm{x}^3\\right)_0^4 \\\\ & =\\frac{4}{3}\\left[4^{3 / 2}-0\\right]-\\frac{1}{4.3}\\left[4^3-0\\right] \\\\ & =\\frac{4^{5 / 2}}{3}-\\frac{16}{3}=\\frac{32-16}{3}=\\frac{16}{3}\\end{aligned}\\)",
