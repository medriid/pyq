    {
      "text": "\\(\\frac{1}{3}\\) units",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{6}\\) units",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0021_9f275d445c1e.png\"><br>\n\\(\\begin{aligned} & \\text {Hints: } A=\\int_0^1(\\sqrt{x}-x) d x \\\\ & =\\frac{2}{3}\\left(x^{3 / 2}\\right)_0^1-\\frac{1}{2}\\left(x^2\\right)_0^1=\\frac{2}{3}[1-0]-\\frac{1}{2}[1-0] \\\\ & =\\frac{2}{3}-\\frac{1}{2}=\\frac{4-3}{6}=\\frac{1}{6}\\end{aligned}\\)"
  }
