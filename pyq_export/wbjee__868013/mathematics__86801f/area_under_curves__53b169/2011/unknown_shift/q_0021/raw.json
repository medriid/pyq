  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/96pbHyqQFdxA_h3AuaSdf5SbJLyxn5UsSihaQCv5_AU.original.fullsize.png\"><br>\n\\(\\begin{aligned} & \\text {Hints: } A=\\int_0^1(\\sqrt{x}-x) d x \\\\ & =\\frac{2}{3}\\left(x^{3 / 2}\\right)_0^1-\\frac{1}{2}\\left(x^2\\right)_0^1=\\frac{2}{3}[1-0]-\\frac{1}{2}[1-0] \\\\ & =\\frac{2}{3}-\\frac{1}{2}=\\frac{4-3}{6}=\\frac{1}{6}\\end{aligned}\\)",
