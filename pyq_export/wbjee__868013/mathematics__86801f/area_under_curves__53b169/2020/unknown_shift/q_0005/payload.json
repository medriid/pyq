  "question": {
    "text": "The area of the figure bounded by the parabola $x=-2 y^{2}, x=1-3 y^{2}$ is"
  },
  "options": [
    {
      "text": "$\\frac{1}{3}$ square unit",
      "is_correct": false
    },
    {
      "text": "$\\frac{4}{3}$ square unit",
      "is_correct": true
    },
    {
      "text": "1 square unit",
      "is_correct": false
    },
    {
      "text": "2 square unit",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint:\r\n$\\mathrm{A}=\\int_{-1}^{1}\\left(1-3 \\mathrm{y}^{2}\\right)-\\left(-2 \\mathrm{y}^{2}\\right) \\mathrm{d} \\mathrm{y}$\r\n$\\Rightarrow \\mathrm{A}=2 \\int_{0}^{1}\\left(1-\\mathrm{y}^{2}\\right) \\mathrm{d} \\mathrm{y}=\\frac{4}{3}$\r\n<img src=\"assets\\st0005_943b6032e2b4.png\">"
  }
}