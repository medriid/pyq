  "level": 2,
  "question": {
    "text": "The polar coordinate of a point $P$ is $\\left(2,-\\frac{\\pi} {4}\\right)$ The polar coordinate of the point $Q$ which is such that line joining $P Q$ is bisected perpendicularly by the initial line, is",
    "image": null
  },
  "options": [
    {
      "id": "DTJbb",
      "text": "$\\left(2, \\frac{\\pi}{4}\\right)$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "ECfsB",
      "text": "$\\left(2, \\frac{\\pi}{6}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "pvkhU",
      "text": "$\\left(-2, \\frac{\\pi}{4}\\right)$",
      "isCorrect": false,
