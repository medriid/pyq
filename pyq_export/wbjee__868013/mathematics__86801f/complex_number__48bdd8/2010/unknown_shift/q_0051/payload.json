  "question": {
    "text": "If $-\\pi < \\arg (z) < -\\frac{\\pi}{2}$ then $\\arg \\bar{z}-\\arg (-\\bar{z})$ is"
  },
  "options": [
    {
      "text": "$\\pi$",
      "is_correct": true
    },
    {
      "text": "$\\square \\pi$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{2}$",
      "is_correct": false
    },
    {
      "text": "$-\\frac{\\pi}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: <img src=\"assets\\st0051_ebf92af6d275.png\"><br>\n$$\n\\begin{aligned}\n& \\text { if } \\arg (z)=-\\pi+\\theta \\\\\n& \\Rightarrow \\arg (\\bar{z})=\\pi-\\theta \\\\\n& \\arg (-\\bar{z})=-\\theta \\\\\n& \\arg (\\bar{z})-\\arg (-\\bar{z})=\\pi-\\theta-(-\\theta)=\\pi-\\theta+\\theta=\\pi\n\\end{aligned}\n$$"
  }
}