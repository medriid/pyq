  "question": {
    "text": "In the argand plane, the distinct roots of $1+z+z^{3}+z^{4}=0(z$ is a complex number) represent vertices of",
    "image": null
  },
  "options": [
    {
      "id": "wYJmj",
      "text": "a square",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "rAZIq",
      "text": "an equilateral triangle",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "AYbBQ",
      "text": "a thombus",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "zkTDe",
      "text": "a rectangle",
      "isCorrect": false,
      "image": null
