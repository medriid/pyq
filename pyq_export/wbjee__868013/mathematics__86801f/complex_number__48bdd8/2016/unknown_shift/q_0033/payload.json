  "question": {
    "text": "The value of $\\sum_{n=1}^{13}\\left(i^{n}+i^{n+1}\\right), i=\\sqrt{-1}$ is"
  },
  "options": [
    {
      "text": "$i$",
      "is_correct": false
    },
    {
      "text": "$i-1$",
      "is_correct": true
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "0",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "We have. \r\n$\\begin{aligned} & \\sum_{n=1}^{13}\\left(i^{n}+i^{n+1}\\right) \\\\=& \\sum_{n=1}^{13} i^{n}+\\sum_{n=1}^{13} i^{n+1} \\\\=& i \\left(\\frac{1-i^{13}}{1-i}\\right)+i^{2}\\left(\\frac{1-i^{13}}{1-i}\\right) \\\\=& i \\left(\\frac{1-i}{1-i}\\right)-\\left(\\frac{1-i}{1-i}\\right) \\\\=& i-1 \\end{aligned}$"
  }
}