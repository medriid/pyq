  "question": {
    "text": "Let $\\mathrm{C}$ denote the set of all complex numbers.\r\nDefine $A=\\{(z, w) \\mid z, w \\in C$ and $|z|=|w|\\}, B=\\left\\{(z, w) \\mid z, w \\in C\\right.$ and $\\left.z^{2}=w^{2}\\right\\}$. Then"
  },
  "options": [
    {
      "text": "$A=B$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{A} \\subset \\mathrm{B}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{B} \\subset \\mathrm{A}$",
      "is_correct": true
    },
    {
      "text": "$A \\cap B=\\varphi$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$z^{2}=w^{2}$\r\n$(z-w)(z+w)$\r\n$z=w,-w$\r\n$|z|=|w|$"
  }
}