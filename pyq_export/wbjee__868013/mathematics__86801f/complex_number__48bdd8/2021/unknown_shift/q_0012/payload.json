  "question": {
    "text": "If $|z+i|-|z-1|=|z|-2=0$ for a complex number $z$, then $z=$"
  },
  "options": [
    {
      "text": "$\\sqrt{2}(1+i)$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{2}(1-i)$",
      "is_correct": true
    },
    {
      "text": "$\\sqrt{2}(-1+i)$",
      "is_correct": true
    },
    {
      "text": "$\\sqrt{2}(-1-\\mathrm{i})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B",
    "C"
  ],
  "solution": {
    "text": "$|z| =2$ represents circle\r\n<img src=\"assets\\st0012_705353672537.png\"><br>\r\n$|z+i|=|z-1|$ represents<img src=\"assets\\st0012_8a25f3294ea6.png\"><br>\r\nSolving $x^{2}+y^{2}=4$ and $y=-x$<img src=\"assets\\st0012_8a90e3c2a03d.png\"><br>\r\n$z=\\sqrt{2}(1-i), \\quad \\sqrt{2}(-1+i)$"
  }
