  "question": {
    "text": "Let $\\alpha$ and $\\beta$ be the roots of $x^{2}+x+1=0 .$ If $n$ be a positive integer, then $\\alpha^{n}+\\beta^{n}$ is",
    "image": null
  },
  "options": [
    {
      "id": "wyi5P",
      "text": "$2 \\cos \\frac{2 n \\pi}{3}$",
      "isCorrect": true,
      "image": null
    },
