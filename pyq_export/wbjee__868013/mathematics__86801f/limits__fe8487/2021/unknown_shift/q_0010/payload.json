  "question": {
    "text": "If $\\mathrm{I}=\\lim _{\\mathrm{x} \\rightarrow 0} \\sin \\left(\\frac{\\mathrm{e}^{\\mathrm{x}}-\\mathrm{x}-1-\\frac{\\mathrm{x}^{2}}{2}}{\\mathrm{x}^{2}}\\right)$, then limit"
  },
  "options": [
    {
      "text": "does not exist",
      "is_correct": false
    },
    {
      "text": "exists and equals 1",
      "is_correct": false
    },
    {
      "text": "exists and equals 0",
      "is_correct": true
    },
    {
      "text": "exists and equals $\\frac{1}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$I=\\lim _{x \\rightarrow 0} \\sin \\left(\\frac{e^{x}-x-1-\\frac{x^{2}}{2}}{x^{2}}\\right)=\\lim _{x \\rightarrow 0} \\frac{e^{x}-x-1-\\frac{x^{2}}{2}}{x^{2}}=\\lim _{x \\rightarrow 0} \\frac{e^{x}-1-0-x}{2 x}=\\lim _{x \\rightarrow 0} \\frac{e^{x}-1}{2}=0$"
  }
}