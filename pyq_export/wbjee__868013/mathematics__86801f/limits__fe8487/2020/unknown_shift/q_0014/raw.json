  "question": {
    "text": "Let $0    < \\alpha < \\beta < 1$. Then $\\lim {n \\rightarrow \\infty} \\sum_{k=1}^{n} \\int_{1/k+\\beta}^{1 /(k+a)} \\frac{d x}{1+x}$ is",
    "image": null
  },
  "options": [
    {
      "id": "lCms4",
      "text": "$\\log _{e} \\frac{\\beta}{\\alpha}$",
      "isCorrect": false,
      "image": null
    },
    {
