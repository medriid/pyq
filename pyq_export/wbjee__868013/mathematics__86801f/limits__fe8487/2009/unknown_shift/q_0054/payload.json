  "question": {
    "text": "The value of the limit $\\lim _{x \\rightarrow 1} \\frac{\\sin \\left(e^{x-1}-1\\right)}{\\log x}$ is"
  },
  "options": [
    {
      "text": "0",
      "is_correct": false
    },
    {
      "text": "$e$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{e}$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$$\n\\text { Hints } \\begin{aligned}\n&: \\operatorname{Lt}_{h \\rightarrow 0} \\frac{\\sin \\left(e^h-1\\right)}{\\log (1+h)} \\quad \\text { Put } x=1+h \\\\\n&=\\operatorname{Lt}_{h \\rightarrow 0} \\frac{\\sin \\left(e^h-1\\right)}{\\left(e^h-1\\right)} \\cdot \\frac{\\left(e^h-1\\right)}{\\log (1+h)} \\\\\n&=\\operatorname{Lt}_{h \\rightarrow 0} \\frac{\\sin \\left(e^h-1\\right)}{\\left(e^h-1\\right)} \\cdot \\frac{\\left(e^h-1\\right)}{h} \\cdot \\frac{h}{\\log (1+h)} \\\\\n&=1.1 .1 \\\\\n&=1\n\\end{aligned}\n$$"
  }
}