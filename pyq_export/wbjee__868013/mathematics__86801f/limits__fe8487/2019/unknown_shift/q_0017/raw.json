  "question": {
    "text": "The value of $\\lim _{x \\rightarrow 0^{+}} \\frac{x}{p}\\left[\\frac{q}{x}\\right]$ is",
    "image": null
  },
  "options": [
    {
      "id": "wWIlu",
      "text": "$\\frac{[q]}{p}$",
      "isCorrect": true,
