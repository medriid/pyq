  "question": {
    "text": "$\\lim _{x \\rightarrow 0^{+}}\\left(e^{x}+x\\right)^{1 / x}$",
    "image": null
  },
  "options": [
    {
      "id": "X3nwp",
      "text": "Does not exist finitely",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "uvaVX",
      "text": "is 1",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "g4mqS",
      "text": "is $e^{2}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "gWNC0",
      "text": "is 2",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\r\n\\begin{aligned}\r\n&\\text {  Let } L=\\lim _{x \\rightarrow 0^{+}}\\left(e^{x}+x\\right)^{1 / x}\\\\\r\n&\\Rightarrow \\log L=\\lim _{x \\rightarrow 0^{+}} \\frac{\\log \\left(e^{x}+x\\right)}{x}\\\\\r\n&\\Rightarrow \\log L=\\lim _{x \\rightarrow 0^{+}} \\frac{\\frac{1}{\\left(e^{x}+x\\right)} \\cdot e^{x}+1}{1}\\\\\r\n&\\text { [using L' Hospital rule] }\\\\\r\n&\\Rightarrow \\log L=\\lim _{x \\rightarrow 0^{+}} \\frac{e^{x}+1}{e^{x}+x}\\\\\r\n&\\Rightarrow \\log L=2\\\\\r\n&\\Rightarrow \\quad L=e^{2}\r\n\\end{aligned}\r\n$$",
    "image": null
  },
