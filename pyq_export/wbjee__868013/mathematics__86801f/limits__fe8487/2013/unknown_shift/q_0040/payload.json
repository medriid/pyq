  "question": {
    "text": "The limit of $\\left\\{\\frac{1}{x} \\sqrt{1+x}-\\sqrt{1+\\frac{1}{x^{2}}}\\right\\}$ as $x \\rightarrow 0$"
  },
  "options": [
    {
      "text": "does not exist",
      "is_correct": false
    },
    {
      "text": "is equal to $\\frac{1}{2}$",
      "is_correct": true
    },
