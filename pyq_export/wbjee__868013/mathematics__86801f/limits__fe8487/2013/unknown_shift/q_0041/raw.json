  "question": {
    "text": "The limit of $\\left[\\frac{1}{x^{2}}+\\frac{(2013)^{x}}{e^{x}-1}-\\frac{1}{e^{x}-1}\\right]$ as $x \\rightarrow 0$",
    "image": null
  },
  "options": [
    {
      "id": "Kcvx4",
      "text": "approaches $+\\infty$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "5rhFF",
      "text": "approaches $-\\infty$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "JFJ80",
      "text": "is equal to $\\log_{e}$, (2013)",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "TGGPL",
      "text": "does not exist",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\lim _{x \\rightarrow 0}\\left\\{\\frac{1}{x^{2}}+\\frac{(2013)^{x}}{e^{x}-1}-\\frac{1}{e^{x}-1}\\right\\}$\r\n$=\\lim _{x \\rightarrow 0}\\left\\{\\frac{1}{x^{2}}+\\frac{(2013)^{x}-1}{e^{x}-1}\\right\\}$\r\n$=\\lim _{x \\rightarrow 0}\\left\\{\\frac{1}{x^{2}}+\\frac{(2013)^{x}-1}{x} \\cdot \\frac{x}{e^{x}-1}\\right\\}$\r\n$=\\lim _{x \\rightarrow 0} \\frac{1}{x^{2}}+\\lim _{x \\rightarrow 0} \\frac{(2013)^{x}-1}{x} \\cdot \\lim _{x \\rightarrow 0} \\frac{x}{e^{x}-1}$\r\n$=+\\infty+\\log (2013) \\cdot 1$\r\n$=+\\infty$",
    "image": null
  },
