  "question": {
    "text": "The limit of $\\sum_{n=1}^{1000}(-1)^{n} x^{n}$ as $x \\rightarrow \\infty$",
    "image": null
  },
  "options": [
    {
      "id": "nD612",
      "text": "does not exist",
      "isCorrect": false,
      "image": null
    },
