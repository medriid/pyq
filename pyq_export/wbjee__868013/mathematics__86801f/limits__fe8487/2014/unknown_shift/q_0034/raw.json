  "question": {
    "text": "Let $[x]$ denote the greatest integer less than or equal to $x$ for any real number $x$. Then, $\\lim _{n \\rightarrow \\infty} \\frac{[n \\sqrt{2}]}{n}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "R5VXp",
      "text": "0",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "aZwB1",
      "text": "2",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lPLpN",
      "text": "$\\sqrt{2}$",
      "isCorrect": true,
      "image": null
    },
    {
