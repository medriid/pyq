  "question": {
    "text": "$\\lim _{x \\rightarrow \\infty}\\left(\\frac{x^2+1}{x+1}-a x-b\\right),(a, b \\in R)=0$. Then"
  },
  "options": [
    {
      "text": "$a=0, b=1$",
      "is_correct": false
    },
    {
      "text": "$a=1, b=-1$",
      "is_correct": true
    },
    {
      "text": "$a=-1, b-1$",
      "is_correct": false
    },
    {
      "text": "$a=0, b=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\lim _{x \\rightarrow \\infty} \\frac{x^2+1-a x(x+1)-b(x+1)}{x+1}=0$\n$=\\lim _{x \\rightarrow \\infty} \\frac{(1-a) x^2-(a+b) x+1-b}{x+1}=0$\nfor the limit to exist,\n$\\begin{aligned}\n1-\\mathrm{a} &=0 \\text { and }-(\\mathrm{a}+\\mathrm{b})=0 \\\\\n\\therefore \\mathrm{a}=1, \\mathrm{~b} &=-1\n\\end{aligned}$"
  }
}