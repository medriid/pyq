  "question": {
    "text": "$\\lim _{x \\rightarrow \\infty}\\left(\\frac{x^2+1}{x+1}-a x-b\\right),(a, b \\in R)=0$. Then",
    "image": null
  },
  "options": [
    {
      "id": "Y1MuW",
      "text": "$a=0, b=1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MgA7O",
      "text": "$a=1, b=-1$",
      "image": null,
      "isCorrect": true
    },
