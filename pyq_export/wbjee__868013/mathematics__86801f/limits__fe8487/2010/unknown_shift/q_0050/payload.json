  "question": {
    "text": "The value of $\\operatorname{Lt}_{x \\rightarrow 0}\\left(\\frac{1+5 x^2}{1+3 x^2}\\right)^{\\frac{1}{x^2}}$ is"
  },
  "options": [
    {
      "text": "$\\mathrm{e}^2$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{e}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{\\mathrm{e}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{\\mathrm{e}^2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: $\\operatorname{Lim}_{x \\rightarrow 0}\\left(\\frac{1+5 x^2}{1+3 x^2}\\right)^{\\frac{1}{x^2}}=\\mathrm{e}^{\\operatorname{Lim}_{x \\rightarrow 0} \\frac{1}{x^2}\\left(\\frac{1+5 x^2}{1+3 x^2}-1\\right)}=\\mathrm{e}^{\\operatorname{Lim}_{x \\rightarrow 0} \\frac{2 x^2}{x^2\\left(1+3 x^2\\right)}}=\\mathrm{e}^2$"
  }
}