  "question": {
    "text": "The value of\n\\(\\lim _{n \\rightarrow \\infty} \\sum_{r=1}^n \\frac{r^3}{r^4+n^4} \\text { is }\\)"
  },
  "options": [
    {
      "text": "\\(\\frac{1}{2} \\log _{\\mathrm{e}}(1 / 2)\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{4} \\log _e(1 / 2)\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{4} \\log _{\\mathrm{e}} 2\\)",
      "is_correct": true
    },
