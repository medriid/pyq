    },
    {
      "text": "\\(\\frac{\\mathrm{n}+1}{2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{\\mathrm{n}(\\mathrm{n}+1)}{2}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{\\mathrm{n}(\\mathrm{n}-1)}{2}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Hints: \\(\\operatorname{Lt}_{x \\rightarrow 1} \\frac{(x-1)+\\left(x^2-1\\right)+\\left(x^3-1\\right) \\ldots \\ldots \\ldots \\ldots .\\left(x^4-1\\right)}{x-1}\\)\n\\(=1+2+3 \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots+n=\\frac{\\mathrm{n}(\\mathrm{n}+1)}{2}\\)"
  }
