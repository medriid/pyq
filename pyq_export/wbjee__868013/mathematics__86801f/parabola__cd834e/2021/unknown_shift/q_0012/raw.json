  "question": {
    "text": "The locus of the vertices of the family of parabolas $6 y=2 a^{3} x^{2}+3 a^{2} x-12 a$ is",
    "image": null
  },
  "options": [
    {
      "id": "yRFHL",
      "text": "$x y=\\frac{105}{64}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "KotYR",
      "text": "$x y=\\frac{64}{105}$",
      "isCorrect": false,
      "image": null
    },
    {
