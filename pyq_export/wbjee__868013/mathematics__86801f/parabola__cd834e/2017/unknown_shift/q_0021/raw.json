  "question": {
    "text": "The focus of the conic $x^{2}-6 x+4 y+1=0$ is",
    "image": null
  },
  "options": [
    {
      "id": "DHZYP",
      "text": "(2,3)",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "X9rf7",
      "text": "(3,2)",
      "isCorrect": false,
      "image": null
    },
    {
