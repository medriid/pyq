  "question": {
    "text": "The axis of the parabola $x^{2}+2 x y+y^{2}-5 x+5 y-5=0$ is"
  },
  "options": [
    {
      "text": "$x+y=0$",
      "is_correct": true
    },
    {
      "text": "$x+y-1=0$",
      "is_correct": false
    },
    {
      "text": "$x-y+1=0$",
      "is_correct": false
    },
    {
      "text": "$x-y=\\frac{1}{\\sqrt{2}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Given, equation $x^{2}+2 x y+y^{2}-5 x+5 y-5=0$\r\n$\\Rightarrow(x+y)^{2}=5 x-5 y+5$\r\n$\\Rightarrow(x+y)^{2}=5(x-y+1)$\r\n$\\therefore$ Axis of the parabola is $x+y=0$"
  }
}