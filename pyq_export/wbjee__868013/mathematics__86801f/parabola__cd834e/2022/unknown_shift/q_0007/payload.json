  "question": {
    "text": "From the point $(-1,-6)$, two tangents are drawn to $y^2=4 x$. Then the angle between the two tangents is"
  },
  "options": [
    {
      "text": "$\\pi / 3$",
      "is_correct": false
    },
    {
      "text": "$\\pi / 4$",
      "is_correct": false
    },
    {
      "text": "$\\pi / 6$",
      "is_correct": false
