  "question": {
    "text": "If the line $\\mathrm{y}=\\mathrm{x}$ is a tangent to the parabola $\\mathrm{y}=\\mathrm{ax}^{2}+\\mathrm{bx}+\\mathrm{c}$ at the point $(1,1)$ and the curve passes through $(-1,0)$, then",
    "image": null
  },
  "options": [
