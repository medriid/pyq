  "question": {
    "text": "The equation $x^{3}-y x^{2}+x-y=0$ represents"
  },
  "options": [
    {
      "text": "a hyperbola and two straight lines",
      "is_correct": false
    },
    {
      "text": "a straight line",
      "is_correct": true
    },
    {
      "text": "a parabola and two straight lines",
      "is_correct": false
    },
    {
      "text": "a straight line and a circle",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$x^{3}-y x^{2}+x-y=0$\r\n$x^{2}(x-y)+(x-y)=0$\r\n$\\left(x^{2}+1\\right)(x-y)=0$\r\n$x^{2}+1 \\neq 0$\r\n$x-y=0$\r\n$x=y$\r\nSo, the equation represents a straight line."
  }
}