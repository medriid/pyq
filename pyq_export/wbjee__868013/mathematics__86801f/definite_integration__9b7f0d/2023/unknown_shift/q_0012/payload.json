  "question": {
    "text": "The average ordinate of \\(y=\\sin x\\) over \\([0, \\pi]\\) is"
  },
  "options": [
    {
      "text": "\\(\\frac{2}{\\pi}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{3}{\\pi}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{4}{\\pi}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\pi\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hint : As \\(\\sin x\\) is a continuous function in \\([0, \\pi]\\)\nAverage ordinate will be \\(=\\frac{1}{\\pi-0} \\int_0^\\pi \\sin x d x=\\frac{[-\\cos x]_0^\\pi}{\\pi}=\\frac{2}{\\pi}\\)"
  }
}