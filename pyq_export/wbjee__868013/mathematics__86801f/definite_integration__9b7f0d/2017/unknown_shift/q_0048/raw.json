  "level": 1,
  "question": {
    "text": "The value of the integral $\\int_{0}^{1} e^{x^{2}} d x$",
    "image": null
  },
  "options": [
    {
      "id": "VaFid",
      "text": "is less than 1",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "wsfcv",
      "text": "is greater than 1",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "FJONh",
      "text": "is less than or equal to 1",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "NDccv",
      "text": "lies in the closed interval $[1, e]$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "We know that, $0 \\leq x \\leq 1$ $\\Rightarrow \\quad x^{2} \\leq 1$\r\n$\\begin{array}{ll}\\Rightarrow & e^{x^{2}} \\leq e \\\\ \\Rightarrow & \\int_{0}^{1} e^{x^{2}} d x \\leq \\int_{0}^{1} e d x \\\\ \\Rightarrow & \\int_{0}^{1} e^{x^{2}} d x \\leq e \\\\ \\therefore \\quad \\int_{0}^{-} e^{x^{2}} \\in[1, e]\\end{array}$",
    "image": null
  },
