  "question": {
    "text": "$\\int_0^{1.5}\\left[x^2\\right] d x$ is equal to"
  },
  "options": [
    {
      "text": "$2$",
      "is_correct": false
    },
    {
      "text": "$2-\\sqrt{2}$",
      "is_correct": true
    },
    {
      "text": "$2+\\sqrt{2}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\int_0^{1.5}\\left[x^2\\right] d x \\\\ & =\\int_0^1\\left[x^2\\right] d x+\\int_1^{\\sqrt{2}}\\left[x^2\\right] d x+\\int_{\\sqrt{2}}^{3 / 2}\\left[x^2\\right] d x \\\\ & =0+1(\\sqrt{2}-1)+2(1.5-\\sqrt{2}) \\\\ & =2-\\sqrt{2}\\end{aligned}$"
  }
}