  "question": {
    "text": "The value of the integral $\\int_3^6 \\frac{\\sqrt{x}}{\\sqrt{9-x}+\\sqrt{x}} d x$ is",
    "image": null
  },
  "options": [
    {
      "id": "9qEIH",
      "text": "$\\frac{1}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a3J0F",
      "text": "$\\frac{3}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
