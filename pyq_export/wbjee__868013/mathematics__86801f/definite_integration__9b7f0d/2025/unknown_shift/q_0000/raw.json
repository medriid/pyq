  "question": {
    "text": "If $f(x)=\\int_0^{\\sin ^2 x} \\sin ^{-1} \\sqrt{t}$ $dt$ and $g(x)=\\int_0^{\\cos ^2 x} \\cos ^{-1} \\sqrt{t}$ $dt$, then the value of $f(x)+g(x)$ is",
    "image": null
  },
  "options": [
    {
      "id": "Ru7Y2",
      "text": "$\\pi$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FC13M",
      "text": "$\\frac{\\pi}{4}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "DH0ks",
      "text": "$\\frac{\\pi}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lwyXC",
      "text": "$\\sin ^2 x+\\sin x+x$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} \\text f^{\\prime}(x)+g^{\\prime}(x)=0 \\\\ & \\Rightarrow f(x)+g(x)=\\text { constant }(\\text { say } c) \\\\ & \\text { putting } x=\\frac{\\pi}{4} \\\\ \\therefore & c=\\int_0^{1 / 2}\\left(\\sin ^{-1} \\sqrt{t}+\\cos ^{-1} \\sqrt{t}\\right) d t=\\frac{\\pi}{4}\\end{aligned}$",
    "image": null
  },
