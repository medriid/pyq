  "question": {
    "text": "$\\int_{-1}^1 \\frac{x^3+|x|+1}{x^2+2|x|+1} d x$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "WD0B8",
      "text": "$\\log 2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "i1YRa",
      "text": "$2 \\log 2$",
      "image": null,
      "isCorrect": true
    },
    {
