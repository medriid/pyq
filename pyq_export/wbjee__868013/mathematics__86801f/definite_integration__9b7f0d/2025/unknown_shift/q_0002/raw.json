  "question": {
    "text": "Let $f(x)=\\max \\{x+|x|, x-[x]\\}$, where $[x]$ stands for the greatest integer not greater than $x$. Then $\\int_{-3}^3 f(x) d x$ has the value",
    "image": null
  },
  "options": [
    {
      "id": "D5zv2",
      "text": "$\\frac{51}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tDw8G",
      "text": "$\\frac{21}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "atQBx",
      "text": "$1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Ccqcc",
      "text": "$0$",
      "image": null,
      "isCorrect": false
