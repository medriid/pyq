  "question": {
    "text": "$\\int_{1}^{3} \\frac{|x-1|}{|x-2|+|x-3|} d x=$"
  },
  "options": [
    {
      "text": "$1+\\frac{4}{3} \\log _{e} 3$",
      "is_correct": false
    },
    {
      "text": "$1+\\frac{3}{4} \\log _{e} 3$",
