  "question": {
    "text": "If $\\int_{\\log _{e} 2}^{x}\\left(e^{x}-1\\right)^{-1} d x=\\log _{e} \\frac{3}{2}$ then the value of $x$ is"
  },
  "options": [
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{e}^{2}$",
      "is_correct": false
    },
    {
      "text": "$\\log 4$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{\\mathrm{e}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\int_{\\log _{e}{ }^{2}}^{x}\\left(e^{x}-1\\right)^{-1} d x=\\log _{e}^{\\frac{3}{2}} \\int_{\\log _{e}{ }^{2}}^{x} \\frac{e^{-x}}{1-e^{-x}} d x=\\log _{e}^{\\frac{3}{2}}$\r\n$e^{-x}=\\frac{1}{4}$\r\n$x=\\ln 4$"
  }
}