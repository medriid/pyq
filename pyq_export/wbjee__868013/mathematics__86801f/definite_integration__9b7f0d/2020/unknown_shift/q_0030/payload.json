  "question": {
    "text": "If $x^{2}+y^{2}=a^{2}$, then $\\int_{0}^{a} \\sqrt{1+\\left(\\frac{d y}{d x}\\right)^{2}} d x=$"
  },
  "options": [
    {
      "text": "$2 \\pi a$",
      "is_correct": false
    },
    {
      "text": "$\\pi a$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{2} \\pi \\mathrm{a}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{4} \\pi \\mathrm{a}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Hint:\r\n$y_{1}=-\\frac{x}{y}$\r\n$\\int_{0}^{a} \\sqrt{1+\\frac{x^{2}}{y^{2}}} d x=a \\int_{0}^{a} \\frac{1}{y} \\cdot d x=a \\int_{0}^{a} \\frac{d x}{\\sqrt{a^{2}-x^{2}}}$\r\n$=a\\left[\\sin ^{-1}\\left(\\frac{x}{a}\\right)\\right]_{0}^{]}=a \\pi / 2$"
  }
}