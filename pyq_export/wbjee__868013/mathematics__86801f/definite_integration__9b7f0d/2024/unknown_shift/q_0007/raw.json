  "question": {
    "text": "The points of extremum of $\\int_0^{x^2} \\frac{t^2-5 t+4}{2+e^t} d t$ are",
    "image": null
  },
  "options": [
    {
      "id": "PMIaz",
      "text": "$\\pm 1$",
      "image": null,
      "isCorrect": true
    },
    {
