  "question": {
    "text": "If $I=\\int_{0}^{2} e^{x^{4}}(x-a) d x=0$, then $\\alpha$ lies in the interval",
    "image": null
  },
  "options": [
    {
      "id": "42JuS",
      "text": "(0,2)",
      "isCorrect": true,
      "image": null
    },
    {
