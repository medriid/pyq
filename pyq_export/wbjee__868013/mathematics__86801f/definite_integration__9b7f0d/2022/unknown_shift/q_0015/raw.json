  "question": {
    "text": "If $\\mathrm{I}$ is the greatest of $I_1=\\int_0^1 e^{-x} \\cos ^2 x d x, I_2=\\int_0^1 e^{-x^2} \\cos ^2 x d x, I_3=\\int_0^1 e^{-x^2} d x, I_4=\\int_0^1 e^{-x^2 / 2} d x$, then",
    "image": null
  },
  "options": [
    {
      "id": "yzhJF",
      "text": "$\\mathrm{I}=\\mathrm{I}_1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6QXgT",
      "text": "$\\mathrm{I}=\\mathrm{I}_2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jvkrq",
      "text": "$I=I_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kSSZP",
      "text": "$\\mathrm{I}=\\mathrm{I}_4$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{e}^{-\\mathrm{x}} \\cdot \\cos ^2 \\mathrm{x}  < \\mathrm{e}^{-\\mathrm{x}^2} \\cos ^2 \\mathrm{x} < \\mathrm{e}^{-\\mathrm{x}^2} < \\mathrm{e}^{-\\frac{\\mathrm{x}^2}{2}}$ for $0 < \\mathrm{x} < 1$\n$\\therefore$ By domination Law, $\\mathrm{I}_4$ is maximum\n$\\therefore \\mathrm{I}=\\mathrm{I}_4$",
    "image": null
  },
