  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "If $\\int 2^{2^{x}} \\cdot 2^{x} d x=A \\cdot 2^{2^{x}}+C,$ then $A$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "Xs3f5",
      "text": "$\\frac{1}{\\log 2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "bSNmA",
      "text": "$\\log 2$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ogDlz",
      "text": "$(\\log 2)^{2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "NFSP7",
      "text": "$\\frac{1}{(\\log 2)^{2}}$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\r\n\\begin{aligned}\r\n&\\text { (d) Let } I=\\int 2^{2^{x}} \\cdot 2^{x} d x\\\\\r\n&\\begin{array}{l}\r\n\\text { Put } \\quad t=2^{x} \\\\\r\n\\Rightarrow \\quad d t=2^{x} \\log 2 d x \\\\\r\n\\therefore \\quad I=\\int \\frac{2^{t}}{\\log 2} d t \\\\\r\n=\\frac{2^{t}}{(\\log 2)^{2}}+C=\\frac{2^{2^{x}}}{(\\log 2)^{2}}+C \\\\\r\n\\therefore \\quad A=\\frac{1}{(\\log 2)^{2}}\r\n\\end{array}\r\n\\end{aligned}\r\n$$",
    "image": null
  },
