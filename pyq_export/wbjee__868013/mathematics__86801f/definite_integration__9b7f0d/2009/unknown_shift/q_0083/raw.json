  "question": {
    "text": "If $\\int_{-1}^4 f(x) d x=4$ and $\\int_2^4\\{3-f(x)\\} d x=7$ then the value of $\\int_{-1}^2 \\mathrm{f}(\\mathrm{x}) \\mathrm{dx}$",
    "image": null
  },
  "options": [
    {
      "id": "wlHUe",
      "text": "-2",
      "image": null,
      "isCorrect": false
    },
