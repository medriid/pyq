  "question": {
    "text": "Let $\\phi(x)=f(x)+f(2 a-x), x \\in[0,2 a]$ and $f^{\\prime \\prime}(x)\\gt0$ for all $x \\in[0, a]$. Then $\\phi(x)$ is",
    "image": null
  },
  "options": [
    {
      "id": "vH3yP",
      "text": "increasing on $[0, a]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5Pjy1",
      "text": "decreasing on $[0, a]$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Y2vVL",
      "text": "increasing on $[0,2 \\mathrm{a}]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VFS8J",
      "text": "decreasing on $[0,2 \\mathrm{a}]$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\phi^{\\prime}(x)=f^{\\prime}(x)-f^{\\prime}(2 a-x) \\quad \\because f^{\\prime \\prime}(x)\\gt0$\n$\\therefore \\mathrm{f}^{\\prime}(\\mathrm{x})$ is increasing\nSo, $\\phi(x)$ is decreasing in $(0, a)$ as $f^{\\prime}(x) \\lt f^{\\prime}(2 a-x)$ in $(0, a)$",
    "image": null
  },
