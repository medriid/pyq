  "question": {
    "text": "If $x=-1$ and $x=2$ are extreme points of $f(x)=\\alpha \\log |x|+\\beta x^2+x,(x \\neq 0)$, then",
    "image": null
  },
  "options": [
    {
      "id": "y9cBf",
      "text": "$\\alpha=-6, \\beta=\\frac{1}{2}$",
      "image": null,
