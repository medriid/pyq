  "question": {
    "text": "Let $f$ be a function which is differentiable for all real $x$. If $f(2)=-4$ and $f^{\\prime}(x) \\geq 6$ for all $x \\in[2,4]$"
  },
  "options": [
    {
      "text": "$f(4) \\lt 8$",
      "is_correct": false
    },
    {
      "text": "$f(4) \\geq 12$",
      "is_correct": false
    },
    {
      "text": "$f(4) \\geq 8$",
      "is_correct": true
    },
    {
      "text": "$f(4) \\lt 12$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "By LMVT\n$f^{\\prime}(x)=\\frac{f(4)-f(2)}{4-2}$\nas $f^{\\prime}(x) \\geq 6 \\Rightarrow f(4) \\geq 8$"
  }
}