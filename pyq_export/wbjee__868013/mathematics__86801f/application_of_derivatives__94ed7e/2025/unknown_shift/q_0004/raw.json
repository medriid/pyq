  "question": {
    "text": "A function $f$ is defined by $f(x)=2+(x-1)^{2 / 3}$ on $[0,2]$. Which of the following statements is incorrect?",
    "image": null
  },
  "options": [
    {
      "id": "JgWJE",
      "text": "$f$ is not derivable in $(0,2)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a8Ibq",
      "text": "$f$ is continuous in $[0,2]$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9fdJW",
      "text": "$f(0)=f(2)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "l5Ufw",
      "text": "Rolle's theorem is applicable on $[0,2]$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$f(x)=2+(x-1)^{2 / 3}$\n$f(x)$ is not differentiable at $x=1$\nHence Rolle's theorem is not applicable on [0, 2]",
    "image": null
  },
