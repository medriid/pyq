  "question": {
    "text": "Let $f(x)=x^2+x \\sin x-\\cos x$. Then"
  },
  "options": [
    {
      "text": "$f(x)=0$ has at least one real root",
      "is_correct": true
    },
    {
      "text": "$f(x)=0$ has no real root",
      "is_correct": false
    },
    {
      "text": "$f(x)=0$ has at least one positive root",
      "is_correct": true
    },
    {
      "text": "$f(x)=0$ has at least one negative root",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "A",
    "C",
    "D"
  ],
  "solution": {
    "text": "$f^{\\prime}(x)=2 x+x \\cos x+\\sin x+\\sin x=2(x+\\sin x)+x \\cos x$\n$\\Rightarrow f^{\\prime}(x) > 0 \\quad \\forall x > 0, \\quad f^{\\prime}(x)  < 0 \\quad \\forall x < 0 \\Rightarrow f(0)=-1$<img src=\"assets\\st0018_e218aac412f6.png\">"
  }
