  "question": {
    "text": "Twenty metres of wire is available to fence off a flower bed in the form of a circular sector. What must the radius of the circle be, if the area of the flower bed be greatest?",
    "image": null
  },
  "options": [
    {
      "id": "PDr1I",
      "text": "$10 \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    },
