  "question": {
    "text": "Let $f(x)=(x-2)^{17}(x+5)^{24}$. Then",
    "image": null
  },
  "options": [
    {
      "id": "0DEDx",
      "text": "$f$ does not have a critical point at $x=2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jW17L",
      "text": "$f$ has a minimum at $x=2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1PdM3",
      "text": "$f$ has neither a maximum nor a minimum at $x=2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "f0as0",
      "text": "f has a maximum at $x=2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & f(x)=(x-2)^{17}(x+5)^{24} \\\\ \\Rightarrow & f^{\\prime}(x)=17(x-2)^{16}(x+5)^{24}+24(x-2)^{17}(x+5)^{23}=(x-2)^{16}(x+5)^{23}(17 x+85+24 x-48)=(x-2)^{16}(x+5)^{23}(41 x+37) \\end{aligned}$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/FTARjmXMyCr7h61cW37DaJd7sHAFhwU-Vp0t6btf-Oc.original.fullsize.png\">",
