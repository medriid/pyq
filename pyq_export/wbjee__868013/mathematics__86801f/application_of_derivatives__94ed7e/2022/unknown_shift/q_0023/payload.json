  "question": {
    "text": "Let $f(x)=(x-2)^{17}(x+5)^{24}$. Then"
  },
  "options": [
    {
      "text": "$f$ does not have a critical point at $x=2$",
      "is_correct": false
    },
    {
      "text": "$f$ has a minimum at $x=2$",
      "is_correct": false
    },
    {
      "text": "$f$ has neither a maximum nor a minimum at $x=2$",
      "is_correct": true
    },
    {
      "text": "f has a maximum at $x=2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & f(x)=(x-2)^{17}(x+5)^{24} \\\\ \\Rightarrow & f^{\\prime}(x)=17(x-2)^{16}(x+5)^{24}+24(x-2)^{17}(x+5)^{23}=(x-2)^{16}(x+5)^{23}(17 x+85+24 x-48)=(x-2)^{16}(x+5)^{23}(41 x+37) \\end{aligned}$\n<img src=\"assets\\st0023_fa11ff984255.png\">"
