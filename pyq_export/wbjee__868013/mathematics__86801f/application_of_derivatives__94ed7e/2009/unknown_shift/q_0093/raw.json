  "question": {
    "text": "If the rate of increase of the radius of a circle is $5 \\mathrm{~cm} / \\mathrm{sec}$, then the rate of increase of its area, when the radius is $20 \\mathrm{~cm}$, will be",
    "image": null
  },
  "options": [
    {
      "id": "D6ZBy",
      "text": "$10 \\pi$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oV9i5",
      "text": "$20 \\pi$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "okONp",
      "text": "$200 \\pi$",
      "image": null,
      "isCorrect": true
    },
    {
