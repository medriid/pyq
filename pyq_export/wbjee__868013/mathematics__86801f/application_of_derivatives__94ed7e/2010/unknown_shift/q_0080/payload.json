  "question": {
    "text": "The equation of normal of $x^2+y^2-2 x+4 y-5=0$ at $(2,1)$ is"
  },
  "options": [
    {
      "text": "$y=3 x-5$",
      "is_correct": true
    },
    {
      "text": "$2 y=3 x-4$",
      "is_correct": false
    },
    {
      "text": "$y=3 x+4$",
      "is_correct": false
    },
    {
      "text": "$y=x+1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: $0(1,-2) \\mathrm{A}(2,1)$\nSlope $A \\rightarrow \\frac{y-1}{-2-1}=\\frac{x-2}{1-2}, \\quad \\frac{y-1}{-3}=\\frac{x-2}{-1}=1, y-1=3(x-2)$ $y=3 x-5$"
  }
}