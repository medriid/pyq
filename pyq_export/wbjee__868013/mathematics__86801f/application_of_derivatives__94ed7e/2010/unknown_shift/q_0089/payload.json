  "question": {
    "text": "The displacement $\\mathrm{x}$ of a particle at time $\\mathrm{t}$ is given by $\\mathrm{x}=\\mathrm{At}^2+\\mathrm{Bt}+\\mathrm{C}$ where $\\mathrm{A}, \\mathrm{B}, \\mathrm{C}$ are constants and $\\mathrm{v}$ is velocity of a particle, then the value of $4 \\mathrm{Ax}-\\mathrm{v}^2$ is"
  },
  "options": [
    {
      "text": "$4 \\mathrm{AC}+\\mathrm{B}^2$",
      "is_correct": false
    },
    {
      "text": "$4 \\mathrm{AC}-\\mathrm{B}^2$",
      "is_correct": true
    },
    {
      "text": "$2 \\mathrm{AC}-\\mathrm{B}^2$",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{AC}+\\mathrm{B}^2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: } \\mathrm{x}=\\mathrm{At}^2+\\mathrm{Bt}+\\mathrm{c} \\\\\n& \\mathrm{v}=2 \\mathrm{At}+\\mathrm{B} \\Rightarrow \\mathrm{v}^2=4 \\mathrm{~A}^2 \\mathrm{t}^2+4 \\mathrm{AB} \\mathrm{t}+\\mathrm{B}^2 \\\\\n& 4 \\mathrm{Ax}=4 \\mathrm{~A}^2 \\mathrm{t}^2+4 \\mathrm{AB} \\mathrm{t}+4 \\mathrm{AC} \\\\\n& \\Rightarrow \\mathrm{v}^2-4 \\mathrm{ax}=\\mathrm{B}^2-4 \\mathrm{AC} \\\\\n& \\Rightarrow 4 A \\mathrm{Ax}-\\mathrm{v}^2=4 A C-\\mathrm{B}^2\n\\end{aligned}\n$$"
  }
}