  "question": {
    "text": "If the line $a x+b y+c=0$ is a tangent to the curve $x y=4$, then",
    "image": null
  },
  "options": [
    {
      "id": "0kOOx",
      "text": "a $ < 0$, b $>0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "a1MXH",
      "text": "a $\\leq 0$, b $>0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "odMgt",
      "text": "a $ < 0$, b $ < 0$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1wEkz",
      "text": "a $\\leq 0$, b $ < 0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: Slope of line }=-\\frac{a}{b} \\\\\n& y=\\frac{4}{x}=1, \\frac{d y}{d x}=-\\frac{4}{x^2},-\\frac{a}{b}=-\\frac{4}{x^2} \\Rightarrow \\frac{a}{b}=\\frac{4}{x^2}>0 \\\\\n& a < 0, b < 0\n\\end{aligned}\n$$",
    "image": null
  },
