  "question": {
    "text": "If the displacement, velocity and acceleration of a particle at time, $\\mathrm{t}$ be $\\mathrm{x}, \\mathrm{v}$ and $\\mathrm{f}$ respectively, then which one is true?",
    "image": null
  },
  "options": [
    {
      "id": "Rw7Pq",
      "text": "$\\mathrm{f}=\\mathrm{v}^3 \\frac{\\mathrm{d}^2 t}{d \\mathrm{x}^2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VWUls",
      "text": "$f=-v^3 \\frac{d^2 t}{d x^2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "TcoqZ",
      "text": "$\\mathrm{f}=\\mathrm{v}^2 \\frac{\\mathrm{d}^2 \\mathrm{t}}{\\mathrm{dx}^2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "D4z4D",
      "text": "$f=-v^2 \\frac{d^2 t}{d x^2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: } \\frac{d^2 t}{d x^2}=\\frac{d\\left(\\frac{d t}{d x}\\right)}{d x}=\\frac{d\\left(\\frac{1}{v}\\right)}{d x}=-\\frac{1}{v^2} \\frac{d v}{d t} \\times \\frac{1}{v} \\\\\n& \\Rightarrow f=-v^3 f \\frac{d^2 t}{d x^2}\n\\end{aligned}\n$$",
    "image": null
  },
