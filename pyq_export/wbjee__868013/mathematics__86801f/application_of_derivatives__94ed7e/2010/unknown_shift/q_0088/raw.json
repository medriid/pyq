  "question": {
    "text": "For what values of $\\mathrm{x}$, the function $\\mathrm{f}(\\mathrm{x})=\\mathrm{x}^4-4 \\mathrm{x}^3+4 \\mathrm{x}^2+40$ is monotone decreasing?",
    "image": null
  },
