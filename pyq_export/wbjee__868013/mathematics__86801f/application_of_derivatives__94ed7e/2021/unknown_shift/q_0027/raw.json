  "question": {
    "text": "If the tangent at the point $P$ with co-ordinates $(h, k)$ on the curve $y^{2}=2 x^{3}$ is perpendicular to the straight line $4 x=3 y$, then",
    "image": null
  },
  "options": [
    {
      "id": "maxDe",
      "text": "$(\\mathrm{h}, \\mathrm{k})=(0,0)$ only",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "aBJna",
      "text": "$(\\mathrm{h}, \\mathrm{k})=\\left(\\frac{1}{8},-\\frac{1}{16}\\right)$ only",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "r5zvm",
      "text": "$(\\mathrm{h}, \\mathrm{k})=(0,0)$ or $\\left(\\frac{1}{8},-\\frac{1}{16}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1BPsZ",
      "text": "no such point P exists",
      "isCorrect": false,
      "image": null
