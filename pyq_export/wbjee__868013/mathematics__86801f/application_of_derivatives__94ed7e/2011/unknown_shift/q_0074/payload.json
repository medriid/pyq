  "question": {
    "text": "Let \\(\\mathrm{a}, \\mathrm{b}, \\mathrm{c}\\) be three real numbers such that \\(\\mathrm{a}+2 \\mathrm{~b}+4 \\mathrm{c}=0\\). Then the equation \\(\\mathrm{ax}^2+\\mathrm{bx}+\\mathrm{c}=0\\)"
  },
  "options": [
    {
      "text": "has both the roots complex",
      "is_correct": false
    },
    {
      "text": "hat its roots lying within \\(-1  < x < 0\\)",
      "is_correct": false
    },
    {
      "text": "has one of roots equal to \\(\\frac{1}{2}\\)",
      "is_correct": true
    },
    {
      "text": "has its roots lying within \\(2  < x < 6\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Hints: \\(\\frac{1}{4} \\mathrm{a}+\\frac{1}{2} \\mathrm{~b}+\\mathrm{c}=0\\)\n\\(\\begin{aligned}\n& \\left(\\frac{1}{2}\\right)^2 a+\\left(\\frac{1}{2}\\right) b+c=0 \\\\\n& \\therefore x=\\frac{1}{2}\n\\end{aligned}\\)"
  }
}