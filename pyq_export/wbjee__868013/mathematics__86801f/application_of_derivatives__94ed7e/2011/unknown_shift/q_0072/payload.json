  "question": {
    "text": "The acceleration of a particle starting from rest moving in a straight line with uniform acceleration is \\(8 \\mathrm{~m} / \\mathrm{sec}^2\\). The time taken by the particle to move the second metre is"
  },
  "options": [
    {
      "text": "\\(\\frac{\\sqrt{2}-1}{2} \\mathrm{sec}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{\\sqrt{2}+1}{2} \\mathrm{sec}\\)",
      "is_correct": false
    },
    {
      "text": "\\((1+\\sqrt{2}) \\mathrm{sec}\\)",
      "is_correct": false
    },
    {
      "text": "\\((\\sqrt{2}-1) \\mathrm{sec}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hint: <img src=\"assets\\st0072_c1e6059460e9.png\"><br>\n\\(\\begin{array}{l|l}\n\\mathrm{S}=\\mathrm{ut}+\\frac{1}{2} \\mathrm{at}^2 & \\mathrm{~S}=\\mathrm{uT}+\\frac{1}{2} \\mathrm{aT}^2 \\\\\n1=\\frac{1}{2} \\cdot 8 \\cdot \\mathrm{t}^2 & 2=\\frac{1}{2} 8 \\cdot \\mathrm{T}^2 \\\\\n\\frac{1}{4}=\\mathrm{t}^2 & \\mathrm{~T}^2=\\frac{1}{2} \\\\\n\\mathrm{t}=\\frac{1}{2} & \\mathrm{~T}=\\frac{1}{\\sqrt{2}}\n\\end{array}\\)\n\\(\\text {Time }=\\frac{1}{\\sqrt{2}}-\\frac{1}{2}=\\frac{2}{2}=\\frac{\\sqrt{2}-1}{2}\\)"
  }
