  "question": {
    "text": "The acceleration of a particle starting from rest moving in a straight line with uniform acceleration is \\(8 \\mathrm{~m} / \\mathrm{sec}^2\\). The time taken by the particle to move the second metre is",
    "image": null
  },
  "options": [
    {
      "id": "PbIXM",
      "text": "\\(\\frac{\\sqrt{2}-1}{2} \\mathrm{sec}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "uWYp4",
      "text": "\\(\\frac{\\sqrt{2}+1}{2} \\mathrm{sec}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3PGIp",
      "text": "\\((1+\\sqrt{2}) \\mathrm{sec}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZZfah",
      "text": "\\((\\sqrt{2}-1) \\mathrm{sec}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hint: <img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/E5R_ks-SE200Fj3LvzWuwDqUgdhhx4TjPmManXxGM10.original.fullsize.png\"><br>\n\\(\\begin{array}{l|l}\n\\mathrm{S}=\\mathrm{ut}+\\frac{1}{2} \\mathrm{at}^2 & \\mathrm{~S}=\\mathrm{uT}+\\frac{1}{2} \\mathrm{aT}^2 \\\\\n1=\\frac{1}{2} \\cdot 8 \\cdot \\mathrm{t}^2 & 2=\\frac{1}{2} 8 \\cdot \\mathrm{T}^2 \\\\\n\\frac{1}{4}=\\mathrm{t}^2 & \\mathrm{~T}^2=\\frac{1}{2} \\\\\n\\mathrm{t}=\\frac{1}{2} & \\mathrm{~T}=\\frac{1}{\\sqrt{2}}\n\\end{array}\\)\n\\(\\text {Time }=\\frac{1}{\\sqrt{2}}-\\frac{1}{2}=\\frac{2}{2}=\\frac{\\sqrt{2}-1}{2}\\)",
    "image": null
  },
