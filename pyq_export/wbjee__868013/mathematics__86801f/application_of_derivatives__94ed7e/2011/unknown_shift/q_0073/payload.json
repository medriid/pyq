  "question": {
    "text": "Let \\(f(x)=x^3 e^{-3 x}, x > 0\\). Then the maximum value of \\(f(x)\\) is"
  },
  "options": [
    {
      "text": "\\(\\mathrm{e}^{-3}\\)",
      "is_correct": true
    },
    {
      "text": "\\(3 \\mathrm{e}^{-3}\\)",
      "is_correct": false
    },
    {
      "text": "\\(27 \\mathrm{e}^{-9}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\infty\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text { Hints: } f(x)=x^3 \\cdot e^{-3 x} \\\\\n& =f^{\\prime}(x)=3 x^2 e^{-3 x}+x^3 e^{-3 x}(-3) \\\\\n& =x^2 3 e^{-3 x}[1-x]=0, x=1 \\\\\n& \\text { Maximum at } x=1 \\\\\n& f(1)=e^{-3}\n\\end{aligned}\\)"
  }
}