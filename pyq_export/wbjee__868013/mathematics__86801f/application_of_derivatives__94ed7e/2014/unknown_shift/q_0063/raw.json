  "question": {
    "text": "Let $f(x)$ be a differentiable function in $[2,7]$. If $f(2)=3$ and $f^{\\prime}(x) \\leq 5$ for all $x$ in $(2,7),$ then the maximum posaible value of $f(x)$ at $x=7$ is",
    "image": null
  },
  "options": [
    {
      "id": "UV882",
