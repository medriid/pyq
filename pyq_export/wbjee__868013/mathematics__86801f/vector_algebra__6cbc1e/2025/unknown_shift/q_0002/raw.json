  "question": {
    "text": "If $\\vec{\\alpha}=3 \\vec{i}-\\vec{k},|\\vec{\\beta}|=\\sqrt{5}$ and $\\vec{\\alpha} \\cdot \\vec{\\beta}=3$, then the area of the parallelogram for which $\\vec{\\alpha}$ and $\\vec{\\beta}$ are adjacent sides is",
    "image": null
  },
  "options": [
    {
      "id": "bhK26",
      "text": "$\\sqrt{17}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "JErC8",
      "text": "$\\sqrt{14}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ey9b7",
      "text": "$\\sqrt{7}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CQXQG",
      "text": "$\\sqrt{41}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned}|\\vec{\\alpha} \\times \\vec{\\beta}| & =|\\vec{\\alpha} \\| \\vec{\\beta}| \\sin \\theta, \\quad \\cos \\theta=\\frac{3}{\\sqrt{50}} \\\\ & =\\sqrt{50} \\times \\frac{\\sqrt{41}}{\\sqrt{50}}=\\sqrt{41}\\end{aligned}$",
    "image": null
