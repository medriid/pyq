  "question": {
    "text": "If ' $\\theta$ ' is the angle between two vectors $\\vec{a}$ and $\\vec{b}$ such that $|\\vec{a}|=7,|\\vec{b}|=1$ and $|\\vec{a} \\times \\vec{b}|^2=k^2-(\\vec{a} \\cdot \\vec{b})^2$, then the values of $k$ and $\\theta$ are"
  },
  "options": [
    {
      "text": "$\\mathrm{k}=1, \\theta=45^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{k}=7, \\theta=60^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{k}=49, \\theta=90^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{k}=7$ and $\\theta$ is arbitrary",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} & k^2=|\\vec{a} \\times \\vec{b}|^2+(\\vec{\\alpha} \\cdot \\vec{\\beta})^2 \\\\ & =|\\vec{a}|^2|\\vec{b}|^2\\left(\\cos ^2 \\theta+\\sin ^2 \\theta\\right) \\\\ & =49\\end{aligned}$"
  }
}