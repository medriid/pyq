  "question": {
    "text": "On the set $R$ of real numbers we define $x P y$ if and only if $x y \\geq 0$. Then, the relation $P$ is",
    "image": null
  },
  "options": [
    {
      "id": "eD7vI",
      "text": "reflexive but not symmetric",
      "isCorrect": false,
      "image": null
    },
    {
