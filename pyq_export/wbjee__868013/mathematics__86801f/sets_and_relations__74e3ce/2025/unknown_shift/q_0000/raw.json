  "question": {
    "text": "The number of reflexive relations on a set $A$ of $n$ elements is equal to",
    "image": null
  },
  "options": [
    {
      "id": "DN8cP",
      "text": "$2^{n^2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Lz7KU",
      "text": "$\\mathrm{n}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vOdIZ",
      "text": "$2^{n(n-1)}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "eTPPF",
      "text": "$n^2-n$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Total number of ordered pair $=\\mathrm{n}^2$\nNumber of pair that can be included or excluded $=n^2-n$\nEach of the remaining $\\mathrm{n}^2-\\mathrm{n}$ pairs we have two choices\nInclude it in the relation or not include it\nSo total no. of reflexive relation is $2^{n(n-1)}$",
    "image": null
  },
