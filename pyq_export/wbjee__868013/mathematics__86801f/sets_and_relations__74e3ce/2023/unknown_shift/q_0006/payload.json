  "question": {
    "text": "Let \\(A, B, C\\) are subsets of set \\(X\\). Then consider the validity of the following set theoretic statement :"
  },
  "options": [
    {
      "text": "\\(A \\cup(B \\backslash C)=(A \\cup B) \\backslash(A \\cup C)\\)",
      "is_correct": false
    },
    {
      "text": "\\((A \\backslash B) \\backslash C=A \\backslash(B \\cup C)\\)",
      "is_correct": true
    },
    {
      "text": "\\((A \\cup B) \\backslash A=A \\backslash B\\)",
      "is_correct": false
    },
    {
      "text": "\\(A \\backslash C=B \\backslash C\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint:<br />\\(\\begin{aligned}\n:(A \\backslash B) \\backslash C & =\\left(A \\cap B^{\\prime}\\right) \\cap C^{\\prime} \\\\\n& =A \\cap\\left(B^{\\prime} \\cap C^{\\prime}\\right) \\\\\n& =A \\cap(B \\cup C)^{\\prime} \\\\\n& =A \\backslash(B \\cup C)\n\\end{aligned}\\)"
  }
}