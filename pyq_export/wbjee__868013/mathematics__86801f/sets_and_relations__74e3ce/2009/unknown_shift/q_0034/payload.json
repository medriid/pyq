  "question": {
    "text": "For any two sets $\\mathrm{A}$ and $\\mathrm{B}, \\mathrm{A}-(\\mathrm{A}-\\mathrm{B})$ equals"
  },
  "options": [
    {
      "text": "$\\mathrm{B}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{A}-\\mathrm{B}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{A} \\cap \\mathrm{B}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{A}^{\\mathrm{C}} \\cap \\mathrm{B}^{\\mathrm{C}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Hints: $A-(A-B)=A-\\left(A \\cap B^c\\right)=A \\cap\\left(A \\cap B^c\\right)^c=A \\cap\\left(A^c \\cup B\\right)=\\left(A \\cap A^c\\right) \\cup(A \\cap B)=A \\cap B$"
  }
}