  "question": {
    "text": "Let \\(P(n)=3^{2 n+1}+2^{n+2}\\) where \\(n \\in \\mathbb{N}\\). Then"
  },
  "options": [
    {
      "text": "\\(\\mathrm{P}(\\mathrm{n})\\) is not divisible by any prime integer.",
      "is_correct": false
    },
    {
      "text": "there exists prime integer which divides \\(P(n)\\).",
      "is_correct": true
    },
    {
      "text": "\\(P(n)\\) is divisible by 5 for all \\(n \\in \\mathbb{N}\\).",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{P}(\\mathrm{n})\\) is divisible by 3 for all \\(\\mathrm{n} \\in \\mathbb{N}\\).",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint : \\(P(1)=3^3+2^3\\) which is divisible by \\((3+2)=5\\) which is prime\n\\(\\therefore\\) There exists prime integer which divides \\(\\mathrm{P}(\\mathrm{n})\\)"
  }
}