  "question": {
    "text": "Under which of the following condition(s) does(do) the system of equations $\\left(\\begin{array}{ccc}1 & 2 & 4 \\\\ 2 & 1 & 2 \\\\ 1 & 2 & (a-4)\\end{array}\\right)\\left(\\begin{array}{l}x \\\\ y \\\\ z\\end{array}\\right)=\\left(\\begin{array}{l}6 \\\\ 4 \\\\ a\\end{array}\\right)$ possesses (possess) unique solution?"
  },
  "options": [
    {
      "text": "$\\forall \\mathrm{a} \\in \\mathrm{R}$",
      "is_correct": false
    },
    {
      "text": "$a=8$",
      "is_correct": false
    },
    {
      "text": "for all integral values of a",
      "is_correct": false
    },
    {
      "text": "$a \\neq 8$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\Delta \\neq 0$\n$\\Rightarrow\\left|\\begin{array}{ccc}\n1 & 2 & 4 \\\\\n2 & 1 & 2 \\\\\n1 & 2 & \\mathrm{a}-4\n\\end{array}\\right| \\neq 0 \\Rightarrow \\mathrm{a} \\neq 8$"
  }
}