  "question": {
    "text": "If the matrix \\(M_r\\) is given by \\(M_r=\\left(\\begin{array}{cc}r & r-1 \\\\ r-1 & r\\end{array}\\right)\\) for \\(r=1,2,3, \\ldots\\) then \\(\\operatorname{det}\\left(\\mathrm{M}_1\\right)+\\operatorname{det}\\left(\\mathrm{M}_2\\right)+\\ldots . .+\\operatorname{det}\\left(\\mathrm{M}_{2008}\\right)=\\)"
  },
  "options": [
    {
      "text": "2007",
      "is_correct": false
    },
    {
      "text": "2008",
      "is_correct": false
    },
    {
      "text": "\\((2008)^2\\)",
      "is_correct": true
    },
    {
      "text": "\\((2007)^2\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text {Hint : } \\operatorname{det}\\left(M_r\\right)=r^2-(r-1)^2=r^2-\\left(r^2-2 r+1\\right)=2 r-1 \\\\\n& \\begin{aligned}\n\\therefore \\sum_{r=1}^{2008} \\operatorname{det}\\left(M_r\\right)=\\sum_{r=1}^{2008}(2 r-1)= & +3+5+\\cdots+4015 \\\\\n= & (2008)^2\n\\end{aligned}\n\\end{aligned}\\)"
  }
}