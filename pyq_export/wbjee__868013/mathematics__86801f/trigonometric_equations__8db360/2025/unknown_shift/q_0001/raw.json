  "question": {
    "text": "The solution set of the equation $\\left(x \\in\\left(0, \\frac{\\pi}{2}\\right)\\right) \\tan (\\pi \\tan x)=\\cot (\\pi \\cot x)$ is",
    "image": null
  },
  "options": [
    {
      "id": "GqqJP",
      "text": "$\\{0\\}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4JTv6",
      "text": "$\\left\\{\\frac{\\pi}{4}\\right\\}$",
      "image": null,
      "isCorrect": false
    },
    {
