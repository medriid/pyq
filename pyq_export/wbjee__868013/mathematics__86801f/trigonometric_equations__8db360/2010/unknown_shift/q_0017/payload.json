  "question": {
    "text": "If $\\sin 6 \\theta+\\sin 4 \\theta+\\sin 2 \\theta=0$ then the general value of $\\theta$ is"
  },
  "options": [
    {
      "text": "$\\frac{\\mathrm{n} \\pi}{4}, \\mathrm{n} \\pi \\pm \\frac{\\pi}{3}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{\\mathrm{n} \\pi}{4}, \\mathrm{n} \\pi \\pm \\frac{\\pi}{6}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{n} \\pi}{4}, 2 \\mathrm{n} \\pi \\pm \\frac{\\pi}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{n} \\pi}{4}, 2 \\mathrm{n} \\pi \\pm \\frac{\\pi}{6}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints : $2 \\sin 4 \\theta \\cos 2 \\theta+\\sin 4 \\theta=0$\n$\\sin 4 \\theta=0$\n$2 \\cos 2 \\theta=-1$\n$4 \\theta=n \\pi$\n$\\cos 2 \\theta=-\\frac{1}{2}=\\cos \\frac{2 \\pi}{3}$\n$\\theta=\\frac{n \\pi}{4}$\n$2 \\theta=2 \\mathrm{n} \\pi \\pm \\frac{2 \\pi}{3}, \\Rightarrow \\theta=\\mathrm{n} \\pi \\pm \\frac{\\pi}{3}$"
  }
