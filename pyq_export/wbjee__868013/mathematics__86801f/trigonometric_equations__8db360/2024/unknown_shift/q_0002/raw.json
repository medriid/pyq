  "question": {
    "text": "If $A$ and $B$ are acute angles such that $\\sin A=\\sin ^2 B$ and $2 \\cos ^2 A=3 \\cos ^2 B$, then $(A, B)=$",
    "image": null
  },
  "options": [
    {
      "id": "gP1Au",
      "text": "$\\left(\\frac{\\pi}{6}, \\frac{\\pi}{4}\\right)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XFo9V",
      "text": "$\\left(\\frac{\\pi}{6}, \\frac{\\pi}{6}\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7nOFQ",
      "text": "$\\left(\\frac{\\pi}{4}, \\frac{\\pi}{6}\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YTJ52",
      "text": "$\\left(\\frac{\\pi}{4}, \\frac{\\pi}{4}\\right)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Hint : } 2 \\cos ^2 A=3\\left(1-\\sin ^2 B\\right) \\\\ & \\Rightarrow 2-2 \\sin ^2 A=3-3 \\sin A \\quad\\left(\\because \\sin ^2 B=\\sin A\\right)\\end{aligned}$\n$\\begin{aligned} & \\Rightarrow \\sin A=1, \\frac{1}{2} \\\\ & \\Rightarrow \\sin B= \\pm 1, \\pm \\frac{1}{\\sqrt{2}} \\\\ & \\therefore(A, B) \\equiv\\left(\\frac{\\pi}{2}, \\pm \\frac{\\pi}{2}\\right) \\text { or }\\left(\\frac{\\pi}{6}, \\pm \\frac{\\pi}{4}\\right)\\end{aligned}$",
    "image": null
  },
