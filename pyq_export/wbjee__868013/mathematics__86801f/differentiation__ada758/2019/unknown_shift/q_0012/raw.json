  "question": {
    "text": "Consider the function $f(x)=\\frac{x^{3}}{4}-\\sin \\pi x+3$",
    "image": null
  },
  "options": [
    {
      "id": "YV6hP",
      "text": "$f(x)$ does not attain value within the interval [-2,2]",
      "isCorrect": false,
      "image": null
    },
    {
