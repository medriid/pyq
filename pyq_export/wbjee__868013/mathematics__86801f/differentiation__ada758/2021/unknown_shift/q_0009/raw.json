  "question": {
    "text": "The differential of $f(x)=\\log _{e}\\left(1+e^{10 x}\\right)-\\tan ^{-1}\\left(e^{5 x}\\right)$ at $x=0$ and for $d x=0.2$ is",
    "image": null
  },
  "options": [
    {
      "id": "NcpLo",
      "text": "$0.5$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "IAIf8",
      "text": "$0.3$",
      "isCorrect": false,
