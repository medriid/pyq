  "question": {
    "text": "If ' $f$ ' is the inverse function of ' $g$ ' and $g^{\\prime}(x)=\\frac{1}{1+x^n}$, then the value of $f^{\\prime}(x)$ is"
  },
  "options": [
    {
      "text": "$1+\\{f(x)\\}^n$",
      "is_correct": true
    },
    {
      "text": "$1-\\{f(x)\\}^n$",
      "is_correct": false
    },
    {
      "text": "$\\{1+f(x)\\}^n$",
      "is_correct": false
    },
    {
      "text": "$\\{f(x)\\}^n$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & g^{-1}(x)=f(x) \\\\ & g^{\\prime}(x)=\\frac{1}{1+x^n} \\quad \\Rightarrow g^{\\prime}\\left(g^{-1}(x)\\right)=\\frac{1}{1+\\left(g^{-1}(x)\\right)^n}=\\frac{1}{1+(f(x))^n} \\\\ & g\\left(g^{-1}(x)\\right)=x \\\\ & g^{\\prime}\\left(g^{-1}(x) \\cdot\\left(g^{-1}(x)\\right)^{\\prime}=1\\right. \\\\ & \\left(g^{-1}(x)\\right)^{\\prime}=\\frac{1}{g^{\\prime}\\left(g^{-1}(x)\\right)}=1+(f(x))^n\\end{aligned}$"
  }
}