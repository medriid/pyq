  "question": {
    "text": "If $y=e^{\\tan ^{-1} x}$ then"
  },
  "options": [
    {
      "text": "$\\left(1+x^2\\right) y_2+(2 x-1) y_1=0$",
      "is_correct": true
    },
    {
      "text": "$\\left(1+x^2\\right) y_2+2 x y=0$",
      "is_correct": false
    },
    {
      "text": "$\\left(1+x^2\\right) y_2-y_1=0$",
      "is_correct": false
    },
    {
      "text": "$\\left(1+x^2\\right) y_2+3 x y_1+4 y=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\frac{d y}{d x}=e^{\\tan ^{-1} x} \\times \\frac{1}{1+x^2}$\n$\\Rightarrow\\left(1+x^2\\right) y^{\\prime}=y$\nor $2 x y^{\\prime}+\\left(1+x^2\\right) y^{\\prime \\prime}=y^{\\prime}$\nor $\\left(1+x^2\\right) y^{\\prime \\prime}+y^{\\prime}(2 x-1)=0$"
  }
}