  "question": {
    "text": "If $y=\\tan ^{-1} \\sqrt{\\frac{1-\\sin x}{1+\\sin x}}$, then the value of $\\frac{d y}{d x}$ at $x=\\frac{\\pi}{6}$ is",
    "image": null
  },
  "options": [
    {
      "id": "HeyDo",
      "text": "$-\\frac{1}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5oOIR",
      "text": "$\\frac{1}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dvCpk",
      "text": "1",
      "image": null,
      "isCorrect": false
    },
