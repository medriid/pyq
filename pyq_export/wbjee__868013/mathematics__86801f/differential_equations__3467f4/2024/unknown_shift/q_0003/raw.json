  "question": {
    "text": "If $x y^{\\prime}+y-e^x=0, y(a)=b$, then $\\lim _{x \\rightarrow 1} y(x)$ is",
    "image": null
  },
  "options": [
    {
      "id": "q17pV",
      "text": "$e+2 a b-e^a$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "P0bpQ",
      "text": "$e^2+a b-e^{-a}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dnWWa",
      "text": "$e-a b+e^a$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lqqz7",
      "text": "$e+a b-e^a,\\left(y^{\\prime}=\\frac{d y}{d x}\\right)$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text {Hint : } \\quad xy^{\\prime}+y-e^x=0 \\\\ & \\Rightarrow \\quad x \\frac{d y}{d x}+y=e^x \\\\ & \\Rightarrow \\quad x d y+y d x=e^x d x \\\\ & \\Rightarrow \\quad \\int d(x y)=\\int e^x d x \\\\ & \\Rightarrow \\quad x y=e^x+c \\\\ & \\quad y(a)=b \\Rightarrow c=a b-e^a \\\\ & \\therefore \\quad y(x)=\\frac{e^x+a b-e^a}{x} \\\\ & \\therefore \\quad \\lim _{x \\rightarrow 1} y(x)=e+a b-e^a\\end{aligned}$",
    "image": null
  },
