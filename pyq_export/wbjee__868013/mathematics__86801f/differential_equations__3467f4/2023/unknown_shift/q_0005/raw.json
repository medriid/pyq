  "question": {
    "text": "The family of curves \\(y=e^{a \\sin x}\\), where ' \\(a\\) ' is arbitrary constant, is represented by the differential equation",
    "image": null
  },
  "options": [
    {
      "id": "gyn7r",
      "text": "\\(y \\log y=\\tan x \\frac{d y}{d x}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "rkqTO",
      "text": "\\(y \\log x=\\cot x \\frac{d y}{d x}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Bplej",
      "text": "\\(\\log y=\\tan x \\frac{d y}{d x}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WKnqx",
      "text": "\\(\\log y=\\cot x \\frac{d y}{d x}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned} & \\Rightarrow \\log y=a \\sin x \\\\ & \\Rightarrow \\frac{d}{d x}\\left(\\frac{\\log y}{\\sin x}\\right)=\\frac{d}{d x}(a) \\Rightarrow \\frac{\\sin x\\left(\\frac{d y}{d x}\\right)}{y}-\\log y \\times \\cos x=0 \\\\ & \\Rightarrow y \\log y=\\tan x \\times \\frac{d y}{d x}\\end{aligned}\\)",
