  "question": {
    "text": "The equation of one of the curves whose slope at any point is equal to $\\mathrm{y}+2 \\mathrm{x}$ is",
    "image": null
  },
  "options": [
    {
      "id": "Z5N7L",
      "text": "$y=2\\left(e^x+x-1\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kBX5B",
      "text": "$y=2\\left(e^x-x-1\\right)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9UD6S",
      "text": "$y=2\\left(e^x-x+1\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yTtEt",
      "text": "$y=2\\left(e^x+x+1\\right)$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: } \\frac{d y}{d x}=y+2 x \\quad \\text { Put } y+2 x=z \\Rightarrow \\frac{d y}{d x}+z=\\frac{d z}{d x} \\\\\n& \\frac{d z}{d x}-2=z, \\quad \\frac{d z}{d x}=z+2 \\Rightarrow \\int \\frac{d z}{z+2}=\\int d x \\\\\n& \\log (z+2)=x+c, \\log (y+2 x+2)=x+c \\\\\n& y+2 x+2=x+c, y=2\\left(e^x-x-1\\right)\n\\end{aligned}\n$$",
    "image": null
  },
