  "question": {
    "text": "The differential equation of \\(\\mathrm{y}=\\mathrm{ae}^{\\mathrm{bx}}\\) (a & \\(\\mathrm{b}\\) are parameters) is",
    "image": null
  },
  "options": [
    {
      "id": "ptmLv",
      "text": "\\(\\mathrm{yy}_1=\\mathrm{y}_2^2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wNmul",
      "text": "\\(\\mathrm{yy}_2=\\mathrm{y}_1^2\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "E6JcR",
      "text": "\\(\\mathrm{yy}_1^2=\\mathrm{y}_2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FxGUq",
      "text": "\\(\\mathrm{yy}_2^2=\\mathrm{y}_1\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text { Hints: } y=a \\cdot e^{b x} \\ldots \\ldots \\ldots \\ldots \\text { (i) } \\\\\n& y_1=a b e^{b x} \\\\\n& y_1=b y \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots \\text { (ii) }  \\\\\n& y_2=b_1 \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots \\ldots \\text { (iii) } \\\\\n& \\text { Dividing (ii) & (iii) } \\frac{y_1}{\\mathrm{y}_2}=\\frac{\\mathrm{y}}{\\mathrm{y}_1} \\Rightarrow \\mathrm{y}_1{ }^2=\\mathrm{yy}_2\n\\end{aligned}\\)",
    "image": null
  },
