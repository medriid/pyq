  "question": {
    "text": "Integrating Factor (I.F.) of the defferential equation\n\\(\\frac{d y}{d x}-\\frac{3 x^2 y}{1+x^3}=\\frac{\\sin ^2(x)}{1+x} \\text { is }\\)",
    "image": null
  },
  "options": [
    {
      "id": "Iwu7d",
      "text": "\\(\\mathrm{e}^{1+\\mathrm{x}^3}\\)",
      "image": null,
      "isCorrect": false
    },
    {
