  "question": {
    "text": "The solution of $\\cos y \\frac{d y}{d x}=e^{x+\\sin y}+x^2 e^{\\sin y}$ is $f(x)+e^{-\\sin y}=C$ (C is arbitrary real constant) where $f(x)$ is equal to"
  },
  "options": [
    {
      "text": "$e^x+\\frac{1}{2} x^3$",
      "is_correct": false
    },
    {
      "text": "$e^{-x}+\\frac{1}{3} x^3$",
      "is_correct": false
    },
    {
      "text": "$e^{-x}+\\frac{1}{2} x^3$",
      "is_correct": false
    },
    {
      "text": "$e^x+\\frac{1}{3} x^3$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$-e^{-\\sin y} \\cos y \\frac{d y}{d x}=-\\left[e^x+x^2\\right] \\Rightarrow d\\left(e^{-\\sin y}\\right)+\\left(e^x+x^2\\right) d x=0 \\Rightarrow e^{-\\sin y}+e^x+\\frac{x^3}{3}=C$"
  }
}