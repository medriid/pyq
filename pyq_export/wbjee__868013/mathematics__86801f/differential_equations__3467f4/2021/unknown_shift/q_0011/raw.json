  "question": {
    "text": "If $x \\frac{d y}{d x}+y=\\frac{x f(x y)}{f^{\\prime}(x y)}$, then $|f(x y)|$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "wmckZ",
      "text": "$k e^{x^{2} / 2}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "JaSW0",
      "text": "$\\mathrm{ke}^{\\mathrm{y}^{2} / 2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "p1ndI",
      "text": "$\\mathrm{ke}^{\\mathrm{x}^{2}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "E0krN",
      "text": "$\\mathrm{ke}^{\\mathrm{y}^{2}}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$x \\frac{d y}{d x}+y=\\frac{x f(x y)}{f^{\\prime}(x y)} \\Rightarrow \\frac{x d y+y d x}{d x}=\\frac{x f(x y)}{f^{\\prime}(x y)} \\Rightarrow \\frac{f^{\\prime}(x y) d(x y)}{f(x y)}=x d x \\Rightarrow \\ln f(x y)=\\frac{x^{2}}{2}+C \\Rightarrow|f(x y)|=k e^{x^{2} / 2}$",
    "image": null
