  "question": {
    "text": "The coefficient of $x^n$, where $n$ is any positive integer, in the expansion of $\\left(1+2 x+3 x^2+\\ldots \\ldots \\ldots\\right)^{1 / 2}$ is",
    "image": null
  },
  "options": [
