  "question": {
    "text": "The co-efficient of $a^{3} b^{4} c^{5}$ in the expansion of $(b c+c a+a b)^{6}$ is",
    "image": null
  },
  "options": [
    {
      "id": "QqWrV",
      "text": "$\\frac{12 !}{3 ! 4 ! 5 !}$",
      "isCorrect": false,
