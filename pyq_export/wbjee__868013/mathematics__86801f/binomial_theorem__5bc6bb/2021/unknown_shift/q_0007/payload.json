  "question": {
    "text": "The co-efficient of $a^{3} b^{4} c^{5}$ in the expansion of $(b c+c a+a b)^{6}$ is"
  },
  "options": [
    {
      "text": "$\\frac{12 !}{3 ! 4 ! 5 !}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{6 !}{3 !}$",
      "is_correct": false
    },
    {
      "text": "33",
      "is_correct": false
    },
    {
      "text": "3. $\\left(\\frac{6 !}{3 ! 3 !}\\right)$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\left\\{\\frac{6 !}{p ! q ! r !} a^{q+r} b^{p+r} c^{p+q}\\right.$\r\n$q+r=3, p+r=4, p+q=5, p+q+r=6$\r\n$\\Rightarrow p=3, q=2, r=1$\r\nco-efficient $=\\frac{6 !}{3 ! 2 !}$"
  }
}