  "question": {
    "text": "If $\\left(1+x-2 x^2\\right)^6=1+a_1 x+a_2 x^2+\\ldots+a_{12} x^{12}$, then the value of $a_2+a_4+a_6+\\ldots+a_{12}$ is",
    "image": null
  },
  "options": [
    {
      "id": "KpI7W",
      "text": "$21$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xpti0",
      "text": "$31$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "O7dJA",
      "text": "$32$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9F5bi",
      "text": "$64$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\left(1+x-2 x^2\\right)^6=1+a_1 x+a_2 x^2+\\ldots+a_{12} x^{12} \\\\ & x=1 \\Rightarrow 0=1+a_1+a_2+\\ldots+a_{12} \\\\ & x=-1 \\Rightarrow 64=1-a_1+a_2+\\ldots+a_{12} \\\\ & \\text { Adding } 64=2\\left(1+a_2+a_4+\\ldots+a_{12}\\right) \\\\ & a_2+a_4+\\ldots+a_{12}=31\\end{aligned}$",
    "image": null
  },
