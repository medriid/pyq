  "question": {
    "text": "Let $f(n)=2^{n+1}, g(n)=1+(n+1)^{2 n}$ for all $n \\in \\mathbb{N}$. Then"
  },
  "options": [
    {
      "text": "$f(n) > g(n)$",
      "is_correct": false
    },
    {
      "text": "$f(n)  < g(n)$",
      "is_correct": true
    },
    {
      "text": "$f(n)$ and $g(n)$ are not comparable",
      "is_correct": false
    },
    {
      "text": "$f(n) > g(n)$ if $n$ be even and $f(n)  < g(n)$ if $n$ be odd",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$g(n)-f(n)=1+(n+1) 2^n-2 \\cdot 2^n=1+n \\cdot 2^n-2^n=1+(n-1) 2^n > 0$\n$\\because \\mathrm{n} \\geq 1 \\Rightarrow(\\mathrm{n}-1) \\geq 0$"
  }
}