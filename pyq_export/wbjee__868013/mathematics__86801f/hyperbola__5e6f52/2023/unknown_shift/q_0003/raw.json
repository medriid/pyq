  "question": {
    "text": "If a hyperbola passes through the point \\(\\mathrm{P}(\\sqrt{2}, \\sqrt{3})\\) and foci at \\(( \\pm 2,0)\\) then the tangent to this hyperbola at \\(\\mathrm{P}\\) is",
    "image": null
  },
  "options": [
    {
      "id": "Nv54o",
      "text": "\\(\\mathrm{y}=\\mathrm{x} \\sqrt{6}-\\sqrt{3}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "sgKDW",
      "text": "\\(\\mathrm{y}=\\mathrm{x} \\sqrt{3}-\\sqrt{6}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4Lzzp",
      "text": "\\(\\mathrm{y}=\\mathrm{x} \\sqrt{6}+\\sqrt{3}\\)",
