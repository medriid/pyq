  "question": {
    "text": "$P Q$ is a double ordinate of the hyperbola $\\frac{x^2}{a^2}-\\frac{y^2}{b^2}=1$ such that $\\triangle O P Q$ is an equilateral triangle, $O$ being the centre of the hyperbola. Then the eccentricity e of the hyperbola satisfies"
  },
  "options": [
    {
      "text": "$1  < \\mathrm{e} < 2 / \\sqrt{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{e}=2 / \\sqrt{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{e}=2 \\sqrt{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{e} > 2 / \\sqrt{3}$",
      "is_correct": true
    }
