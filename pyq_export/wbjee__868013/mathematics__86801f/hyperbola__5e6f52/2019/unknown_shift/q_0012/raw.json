  "question": {
    "text": "The equation of the directrices of the hyperbola $3 x^{2}-3 y^{2}-18 x+12 y+2=0$ is",
    "image": null
  },
  "options": [
    {
      "id": "ASG6D",
      "text": "$x=3 \\pm \\sqrt{\\frac{13}{6}}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "E335Y",
      "text": "$x=3 \\pm \\sqrt{\\frac{6}{13}}$",
