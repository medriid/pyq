  "question": {
    "text": "The locus of the center of a variable circle which always touches two given circles externally is"
  },
  "options": [
    {
      "text": "an ellipse",
      "is_correct": false
    },
    {
      "text": "a hyperbola",
      "is_correct": true
    },
    {
      "text": "a parabola",
      "is_correct": false
    },
    {
      "text": "a circle",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0007_deb6991cb35b.png\"><br>\r\n$\\begin{array}{l}\r\n\\mathrm{oo}_{1}=\\mathrm{r}+\\mathrm{r}_{1} \\\\\r\n\\mathrm{oo}_{2}=\\mathrm{r}+\\mathrm{r}_{2} \\\\\r\n\\therefore \\mathrm{oo}_{2}-\\mathrm{oo}_{1}=\\mathrm{r}_{2}-\\mathrm{r}_{1}\r\n\\end{array}$\r\nhence, locus is hyperbola"
  }
