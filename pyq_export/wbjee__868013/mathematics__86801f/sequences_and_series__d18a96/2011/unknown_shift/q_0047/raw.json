  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n\\text {Hints : } & s=1+2 \\omega+3 \\omega^2+\\ldots \\ldots \\ldots .+3 n \\omega^{3 n-1} \\\\\n& s \\omega=\\omega+2 \\omega^2+\\ldots \\ldots \\ldots \\ldots .+(3 n-1) \\omega^{3 n}+3 n \\omega^{3 n} \\\\\n& s(1-\\omega)=1+\\omega+\\omega^2+\\ldots \\ldots \\ldots .+\\omega^{3 n-1}-3 n \\omega^{3 \\mathrm{~h}} \\\\\n& =0-3 n \\\\\n& s=\\frac{-3 n}{1-\\omega}=\\frac{3 n}{\\omega-1}\n\\end{aligned}\\)",
    "image": null
  },
