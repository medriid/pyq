  "question": {
    "text": "If \\(\\omega \\neq 1\\) is a cube root of unity, then the sum of the series \\(S=1+2 \\omega+3 \\omega^2+\\ldots \\ldots \\ldots . .+3 n \\omega^{3 n-1}\\) is",
    "image": null
  },
  "options": [
    {
      "id": "OqOSD",
      "text": "\\(\\frac{3 n}{\\omega-1}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "JmNvW",
      "text": "\\(3 n(\\omega-1)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AbQnA",
      "text": "\\(\\frac{\\omega-1}{3 n}\\)",
      "image": null,
      "isCorrect": false
