    {
      "text": "\\(\\frac{3}{16}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n\\text{Hint : } & \\lim _{n \\rightarrow \\infty} \\sum_{x=1}^n\\left(\\frac{1}{2^x \\times 3^x}+\\frac{1}{2^{x+1} \\times 3^x}\\right) \\\\\n& =\\lim _{n \\rightarrow \\infty} \\sum_{x=1}^n \\frac{1}{6^x}\\left(1+\\frac{1}{2}\\right) \\\\\n& =\\frac{3}{2} \\times \\underbrace{\\lim _{n \\rightarrow \\infty}\\left(\\frac{1}{6}+\\frac{1}{6^2}+\\ldots \\cdots \\cdot \\frac{1}{6^n}\\right)}_{\\text {infinite GP }}=\\frac{3}{2} \\times \\frac{\\frac{1}{6}}{1-\\frac{1}{6}}=\\frac{3}{10}\n\\end{aligned}\\)"
  }
