  "question": {
    "text": "If \\(1, \\log _9\\left(3^{1-x}+2\\right), \\log _3\\left(4.3^{\\mathrm{x}}-1\\right)\\) are in A.P, then \\(x\\) equals"
  },
  "options": [
    {
      "text": "\\(\\log _3 4\\)",
      "is_correct": false
    },
    {
      "text": "\\(1-\\log _3 4\\)",
      "is_correct": true
    },
    {
      "text": "\\(1-\\log _4 3\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\log _4 3\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
