  "question": {
    "text": "If $a$ and $b$ are arbitrary positive real numbers, then the least possible value of $\\frac{6 a}{5 b}+\\frac{10 b}{3 a}$ is"
  },
  "options": [
    {
      "text": "4",
      "is_correct": true
    },
    {
      "text": "$\\frac{6}{5}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{10}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{68}{15}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hint: \r\n$\\frac{6 a}{5 b}+\\frac{10 b}{3 a} \\geq 2 \\sqrt{\\frac{6 a}{5 b} \\times \\frac{10 b}{3 a}}, \\quad \\frac{6 a}{5 b}+\\frac{10 b}{3 a} \\geq 2 \\times 2 \\geq 4$"
  }
}