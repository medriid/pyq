  "question": {
    "text": "Let $\\mathrm{I}(\\mathrm{n})=\\mathrm{n}^{\\mathrm{n}}, \\mathrm{J}(\\mathrm{n})=1.3 .5 \\ldots . .(2 \\mathrm{n}-1)$ for all $(\\mathrm{n}>1), \\mathrm{n} \\in \\mathrm{N}$, then"
  },
  "options": [
    {
      "text": "$\\mathrm{I}(\\mathrm{n})>\\mathrm{J}(\\mathrm{n})$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{I}(\\mathrm{n})    < \\mathrm{J}(\\mathrm{n})$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{I}(\\mathrm{n})=\\mathrm{J}(\\mathrm{n})$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{I}(\\mathrm{n})=\\frac{1}{2} \\mathrm{~J}(\\mathrm{n})$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hint: \r\n$\\mathrm{AM} \\geq \\mathrm{GM}$\r\n$\\frac{1+3+5+7+\\ldots+(2 n-1)}{\\mathrm{n}}>(\\mathrm{J}(\\mathrm{n}))^{\\frac{1}{n}}, \\quad \\frac{\\mathrm{n}^{2}}{\\mathrm{n}}>(\\mathrm{J}(\\mathrm{n}))^{\\frac{1}{n}}, \\quad \\mathrm{n}^{\\mathrm{n}}>\\mathrm{J}(\\mathrm{n}), \\mathrm{I}(\\mathrm{n})>\\mathrm{J}(\\mathrm{n})$"
  }
