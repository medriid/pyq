  "question": {
    "text": "Sum of $n$ terms of the following series $1^3+3^3+5^3+7^3+\\ldots \\ldots \\ldots$ is",
    "image": null
  },
  "options": [
    {
      "id": "qOcEK",
      "text": "$n^2\\left(2 n^2-1\\right)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "nyt1R",
      "text": "$\\mathrm{n}^3(\\mathrm{n}-1)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wRrva",
      "text": "$n^3+8 n+4$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zhXgz",
      "text": "$2 n^4+3 n^2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints : $\\sum(2 n-1)^3$\n$$\n\\begin{aligned}\n& \\sum\\left\\{\\left(8 n^3-3.4 n^2+3.2 n-1\\right)\\right\\} \\\\\n= & 2 n^2(n+1)^2-2 n(n+1)(2 n+1)+3 n(n+1)-n \\\\\n= & 2 n^4+4 n^3+2 n^2-2 n\\left[2 n^2+3 n+1\\right]+3 n^2+3 n-n \\\\\n= & 2 n^4+4 n^3+2 n^2-4 n^3-6 n^2-2 n+3 n^2+3 n-n \\\\\n= & 2 n^4-n^2 \\\\\n= & n^2\\left(2 n^2-1\\right)\n\\end{aligned}\n$$",
    "image": null
  },
