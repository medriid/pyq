  "question": {
    "text": "If sum of an infinite geometric series is $\\frac{4}{5}$ and its 1 st term is $\\frac{3}{4}$, then its common ratio is"
  },
  "options": [
    {
      "text": "$\\frac{7}{16}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{9}{16}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{9}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{7}{9}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: $\\frac{\\mathrm{a}}{1-\\mathrm{r}}=\\frac{4}{3} \\quad$ Then $\\frac{\\frac{3}{4}}{1-\\mathrm{r}}=\\frac{4}{3} \\Rightarrow \\mathrm{r}=1-\\frac{9}{16}=\\frac{7}{16}$"
  }
}