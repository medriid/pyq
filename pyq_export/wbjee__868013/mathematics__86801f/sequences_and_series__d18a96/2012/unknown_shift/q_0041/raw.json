  "question": {
    "text": "The sum of the infinite series $1+\\frac{1}{3}+\\frac{1 \\cdot 3}{3 \\cdot 6}+\\frac{1 \\cdot 3 \\cdot 5}{3 \\cdot 6 \\cdot 9}+\\frac{1 \\cdot 3 \\cdot 5 \\cdot 7}{3 \\cdot 6 \\cdot 9 \\cdot 12}+\\ldots$ is equal to",
    "image": null
  },
  "options": [
    {
