  "question": {
    "text": "The sum of the first four terms of an arithmetic progression is 56 . The sum of the last four terms is 112 . If its first term is 11 , then the number of terms is",
    "image": null
  },
  "options": [
    {
      "id": "4eJa3",
      "text": "$10$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2fA4p",
      "text": "$11$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Ijl20",
      "text": "$12$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ALNu0",
      "text": "$13$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & a+a+d+a+2 d+a+3 d=56 \\\\ & 4 a+6 d=56 \\\\ & 6 d=56-44=12 \\\\ & \\Rightarrow d=2 \\\\ & t_1+t_2+t_3+t_4=56 \\\\ & t_{n-3}+t_{n-2}+t_{n-1}+t_n=112 \\\\ & t_1=11 \\\\ & t_1+t_n=t_2+t_{n-1}=t_3+t_{n-2}=t_4+t_{n-3}=k \\\\ & t_1+t_2+t_3+t_4+t_n+t_{n-1}+t_{n-2}+t_{n-3}=4 k \\\\ & \\Rightarrow k_n=42 \\\\ & t_1+t_n=42 \\\\ & \\Rightarrow t_n=42-11=31 \\\\ & t_n=t_1+(n-1) d \\\\ & \\Rightarrow 31-11=(n-1) d \\quad \\Rightarrow(n-1) d=20 \\\\ & \\Rightarrow n=11\\end{aligned}$",
    "image": null
  },
