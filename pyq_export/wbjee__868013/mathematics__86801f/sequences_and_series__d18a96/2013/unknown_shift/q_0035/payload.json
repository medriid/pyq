  "question": {
    "text": "The value of $1000\\left[\\frac{1}{1 \\times 2}+\\frac{1}{2 \\times 3}+\\frac{1}{3 \\times 4}+\\ldots+\\frac{1}{999 \\times 1000}\\right]$ is"
  },
  "options": [
    {
      "text": "1000",
      "is_correct": false
    },
    {
      "text": "999",
      "is_correct": true
    },
    {
      "text": "1001",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{999}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$1000\\left[\\frac{1}{1 \\times 2} \\times \\frac{1}{2 \\times 3}+\\frac{1}{3 \\times 4}+\\ldots+\\frac{1}{999 \\times 1000}\\right]$\r\n$=1000\\left\\{\\left(1-\\frac{1}{2}\\right)+\\left(\\frac{1}{2}-\\frac{1}{3}\\right)+\\left(\\frac{1}{3}-\\frac{1}{4}\\right)\\right.$\r\n$\\left.+\\ldots+\\left(\\frac{1}{999}-\\frac{1}{1000}\\right)\\right]$\r\n$=1000\\left(1-\\frac{1}{1000}\\right)$\r\n$=1000 \\times \\frac{999}{1000}$\r\n$=999$"
  }
