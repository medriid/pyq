  "question": {
    "text": "If three positive real numbers $a, b, c$ are in A.P. and $a b c=4$ then minimum possible value of $b$ is",
    "image": null
  },
  "options": [
    {
      "id": "eFkZg",
      "text": "$2^{3 / 2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "G9unP",
      "text": "$2^{2 / 3}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "TIwyv",
      "text": "$2^{1 / 3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Io1V6",
      "text": "$2^{5 / 2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\text { Hints } \\begin{aligned}\n& (b-d) b(b+d)=4 \\\\\n& \\left(b^2-d^2\\right) b=4 \\\\\n& b^3=4+d^2 b \\\\\n& b^3 \\geq 4 \\Rightarrow b \\geq(2)^{2 / 3}\n\\end{aligned}\n$$",
    "image": null
  },
