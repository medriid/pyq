  "question": {
    "text": "Let $d(n)$ denotes the number of divisors of $n$ including 1 and itself. Then, $d(225), d(1125)$ and $d(640)$ are",
    "image": null
  },
  "options": [
    {
      "id": "ZpSkP",
      "text": "in AP",
      "isCorrect": false,
      "image": null
    },
