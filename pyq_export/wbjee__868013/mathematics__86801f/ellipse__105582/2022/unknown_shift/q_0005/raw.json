  "question": {
    "text": "Chords of an ellipse are drawn through the positive end of the minor axis. Their midpoint lies on",
    "image": null
  },
  "options": [
    {
      "id": "QZGys",
      "text": "a circle",
      "image": null,
      "isCorrect": false
    },
    {
