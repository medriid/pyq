  "question": {
    "text": "A force $\\overrightarrow{\\mathrm{F}}=a \\hat{i}+b \\hat{\\mathrm{j}}+c \\hat{k}$ is acting on a body of mass $m$. The body was initially at rest at the origin. The co-ordinates of the body after time ' t ' will be"
  },
  "options": [
    {
      "text": "$\\frac{\\mathrm{at}^2}{2 \\mathrm{~m}}, \\frac{\\mathrm{bt}^2}{2 \\mathrm{~m}}, \\frac{\\mathrm{ct}^2}{2 \\mathrm{~m}}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{\\mathrm{at}^2}{2 \\mathrm{~m}}, \\frac{\\mathrm{bt}{ }^2}{\\mathrm{~m}}, \\frac{\\mathrm{ct}^2}{2 \\mathrm{~m}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{a t^2}{m}, \\frac{\\mathrm{bt}^2}{2 \\mathrm{~m}}, \\frac{\\mathrm{ct}^2}{2 \\mathrm{~m}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{a t^2}{2 m}, \\frac{\\mathrm{bt}^2}{2 \\mathrm{~m}}, \\frac{\\mathrm{ct}^2}{\\mathrm{~m}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& \\vec{F}=a \\hat{i}+b \\hat{j}+c \\hat{k} \\\\\n& x=\\frac{1}{2}\\left(\\frac{a}{m}\\right) t^2, y=\\frac{1}{2}\\left(\\frac{b}{m}\\right) t^2, z=\\frac{1}{2}\\left(\\frac{c}{m}\\right) t^2\n\\end{aligned}$"
  }
}