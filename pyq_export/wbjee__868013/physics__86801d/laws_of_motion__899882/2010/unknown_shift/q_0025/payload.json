  "question": {
    "text": "Two blocks of $2 \\mathrm{~kg}$ and $1 \\mathrm{~kg}$ are in contact on a frictionless table. If a force of $3 \\mathrm{~N}$ is applied on $2 \\mathrm{~kg}$ block, then the force of contact between the two blocks will be :\n<img src=\"assets\\qt0025_96bf238e694d.png\"><br>"
  },
  "options": [
    {
      "text": "$0 \\mathrm{~N}$",
      "is_correct": false
    },
    {
      "text": "$1 \\mathrm{~N}$",
      "is_correct": true
    },
    {
      "text": "$2 \\mathrm{~N}$",
