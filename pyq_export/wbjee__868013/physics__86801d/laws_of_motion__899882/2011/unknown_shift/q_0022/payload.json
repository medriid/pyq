  "question": {
    "text": "A cricket ball of mass \\(0.25 \\mathrm{~kg}\\) with speed \\(10 \\mathrm{~m} / \\mathrm{s}\\) collides with a bat and returns with same speed within \\(0.01 \\mathrm{~S}\\). The force acted on bat is"
  },
  "options": [
    {
      "text": "\\(25 \\mathrm{~N}\\)",
      "is_correct": false
    },
    {
      "text": "\\(50 \\mathrm{~N}\\)",
      "is_correct": false
    },
    {
      "text": "\\(250 \\mathrm{~N}\\)",
      "is_correct": false
    },
    {
      "text": "\\(500 \\mathrm{~N}\\)",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hints: \\(\\Delta \\mathrm{P}=2 \\mathrm{mV}=2 \\times 0.25 \\times 10=5 \\frac{\\mathrm{kgm}}{\\mathrm{s}}\\)\n\\(\\mathrm{F}=\\frac{\\Delta \\mathrm{P}}{\\Delta \\mathrm{t}}=\\frac{5}{0.01}=500 \\mathrm{~N}\\)"
  }
