  "question": {
    "text": "Two massless springs of force constants $\\mathrm{K}_1$ and $\\mathrm{K}_2$ are joined end to end. The resultant force constant $\\mathrm{K}$ of the system is",
    "image": null
  },
  "options": [
    {
      "id": "dJx8v",
      "text": "$\\mathrm{K}=\\frac{\\mathrm{K}_1+\\mathrm{K}_2}{\\mathrm{~K}_1 \\mathrm{~K}_2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rgdYc",
      "text": "$\\mathrm{K}=\\frac{\\mathrm{K}_1-\\mathrm{K}_2}{\\mathrm{~K}_1 \\mathrm{~K}_2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Nfth7",
      "text": "$\\mathrm{K}=\\frac{\\mathrm{K}_1 \\mathrm{~K}_2}{\\mathrm{~K}_1+\\mathrm{K}_2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "bETlN",
      "text": "$\\mathrm{K}=\\frac{\\mathrm{K}_1 \\mathrm{~K}_2}{\\mathrm{~K}_1-\\mathrm{K}_2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "In series $\\mathrm{K}_{\\text {eff }}=\\frac{K_1 K_2}{K_1+K_2}$",
    "image": null
  },
