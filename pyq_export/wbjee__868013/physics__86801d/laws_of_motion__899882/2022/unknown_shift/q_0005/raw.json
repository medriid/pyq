  "question": {
    "text": "If a string, suspended from the ceilling is given a downward force $F_1$, its length becomes $L_1$, Its length is $L_2$, if the downward force is $\\mathrm{F}_2$. What is its actual length?",
    "image": null
  },
  "options": [
    {
      "id": "XeVaL",
      "text": "$\\frac{L_1+L_2}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Y5tjA",
      "text": "$\\sqrt{L_1 L_2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CGhR7",
      "text": "$\\frac{\\mathrm{F}_2 \\mathrm{~L}_1+\\mathrm{F}_1 \\mathrm{~L}_2}{\\mathrm{~F}_2+\\mathrm{F}_1}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hDDLD",
      "text": "$\\frac{\\mathrm{F}_2 \\mathrm{~L}_1-\\mathrm{F}_1 \\mathrm{~L}_2}{\\mathrm{~F}_2-\\mathrm{F}_1}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} &\\left(L_1-L\\right)=\\frac{F_1 L}{A y} ; L_2-L=\\frac{F_2 L}{A y} \\\\ \\Rightarrow & \\frac{L_1-L}{L_2-L}=\\frac{F_1}{F_2} \\Rightarrow F_2 L_1-F_2 L=F_1 L_2-F_1 L \\Rightarrow L=\\frac{F_2 L_1-F_1 L_2}{F_2-F_1} \\end{aligned}$",
    "image": null
  },
