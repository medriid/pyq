  "question": {
    "text": "A box of mass $2 \\mathrm{kg}$ is placed on the roof of a car. The box would remain stationary until the car attains a maximum acceleration. Coefficient of static friction between the box and the roof of the car is 0.2 and $g=10 \\mathrm{ms}^{-2}$ This maximum acceleration of the car, for the box to remain stationary, is",
    "image": null
  },
  "options": [
    {
      "id": "r4L8t",
      "text": "$8 \\mathrm{ms}^{-2}$",
      "isCorrect": false,
      "image": null
