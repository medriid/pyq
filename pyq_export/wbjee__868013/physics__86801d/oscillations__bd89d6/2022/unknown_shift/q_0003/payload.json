  "question": {
    "text": "A particle is subjected to two simple harmonic motions in the same direction having equal amplitudes and equal frequency. If the resultant amplitude is equal to the amplitude of the individual motion, the phase difference $(\\delta)$ between the two motions is"
  },
  "options": [
    {
      "text": "$\\delta=\\frac{\\pi}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\delta=\\frac{2 \\pi}{3}$",
      "is_correct": true
    },
    {
      "text": "$\\delta=\\pi$",
      "is_correct": false
    },
    {
      "text": "$\\delta=\\frac{\\pi}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$A_{\\text {res }}^2=A_1^2+A_2^2+2 A_1 A_2 \\cos \\delta \\quad A^2=A^2+A^2+2 A^2 \\cos \\delta, \\cos \\delta=-\\frac{1}{2} \\delta=120^{\\circ}$"
  }
}