  "question": {
    "text": "The variation of displacement with time of a simple harmonic motion (SHM) for a particle of mass $m$ is represented by $y=2 \\sin \\left(\\frac{\\pi t}{2}+\\phi\\right) \\mathrm{cm}$. The maximum acceleration of the particle is",
    "image": null
  },
  "options": [
    {
      "id": "ebXuA",
      "text": "$\\frac{\\pi}{2} \\mathrm{~cm} / \\mathrm{sec}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dWe7I",
      "text": "$\\frac{\\pi}{2 \\mathrm{~m}} \\mathrm{~cm} / \\mathrm{sec}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "nrE09",
      "text": "$\\frac{\\pi^2}{2 \\mathrm{~m}} \\mathrm{~cm} / \\mathrm{sec}^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zt4fm",
      "text": "$\\frac{\\pi^2}{2} \\mathrm{~cm} / \\mathrm{sec}^2$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} &  \\text { Given } y=2 \\sin \\left(\\frac{\\pi \\mathrm{t}}{2}+\\phi\\right) \\mathrm{cm} \\\\ & \\mathrm{a}_{\\max }=\\omega^2 \\mathrm{~A} \\\\ & =\\left(\\frac{\\pi}{2}\\right)^2 \\cdot 2=\\frac{\\pi^2}{2} \\mathrm{~cm} / \\mathrm{sec}^2\\end{aligned}$",
    "image": null
