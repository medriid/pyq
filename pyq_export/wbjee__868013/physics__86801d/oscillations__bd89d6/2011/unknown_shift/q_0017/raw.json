  "correctValue": null,
  "solution": {
    "text": "Hints: <img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/MXvNY4ii3w0_0o73_UYY7N7aDcSAlya3M-8_xrU2KrA.original.fullsize.png\"><br>\n\\(\\begin{aligned}\n& \\mathrm{g}_{\\text {eff }}=\\mathrm{g} \\cos \\alpha \\\\\n& \\mathrm{T}=2 \\pi \\sqrt{\\frac{\\ell}{\\mathrm{g}_{\\text {eff }}}}\n\\end{aligned}\\)",
