  "question": {
    "text": "The period of oscillation of a simple pendulum of length \\(l\\) suspended from the roof of a vehicle, which moves without friction down an inclined plane of inclination \\(\\alpha\\), is given by",
    "image": null
  },
  "options": [
    {
      "id": "cRBdA",
      "text": "\\(2 \\pi \\sqrt{\\frac{1}{g \\cos \\alpha}}\\)",
