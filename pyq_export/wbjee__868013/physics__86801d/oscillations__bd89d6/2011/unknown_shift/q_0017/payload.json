  "question": {
    "text": "The period of oscillation of a simple pendulum of length \\(l\\) suspended from the roof of a vehicle, which moves without friction down an inclined plane of inclination \\(\\alpha\\), is given by"
  },
  "options": [
    {
      "text": "\\(2 \\pi \\sqrt{\\frac{1}{g \\cos \\alpha}}\\)",
      "is_correct": true
    },
    {
      "text": "\\(2 \\pi \\sqrt{\\frac{1}{g \\sin \\alpha}}\\)",
      "is_correct": false
    },
    {
      "text": "\\(2 \\pi \\sqrt{\\frac{1}{g}}\\)",
      "is_correct": false
    },
    {
      "text": "\\(2 \\pi \\sqrt{\\frac{1}{\\mathrm{~g} \\tan \\alpha}}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: <img src=\"assets\\st0017_b0b0fabe88a7.png\"><br>\n\\(\\begin{aligned}\n& \\mathrm{g}_{\\text {eff }}=\\mathrm{g} \\cos \\alpha \\\\\n& \\mathrm{T}=2 \\pi \\sqrt{\\frac{\\ell}{\\mathrm{g}_{\\text {eff }}}}\n\\end{aligned}\\)"
  }
