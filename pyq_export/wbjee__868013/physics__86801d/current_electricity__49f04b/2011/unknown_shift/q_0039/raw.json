  "question": {
    "text": "Two cells with the same e.m.f. \\(E\\) and different internal resistances \\(r_1\\) and \\(r_2\\) are connected in series to an external resistance \\(R\\). The value of \\(R\\) so that the potential difference across the first cell be zero is",
    "image": null
  },
  "options": [
    {
      "id": "IbqQh",
      "text": "\\(\\sqrt{r_1 r_2}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "C8sJP",
      "text": "\\(r_1+r_2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PNQzN",
      "text": "\\(\\mathrm{r}_1-\\mathrm{r}_2\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "MlQ1h",
      "text": "\\(\\frac{r_1+r_2}{2}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints: <img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/TodE7DDcwNUogLWejDavnergZeS6AhGJo9h8BFrGFz0.original.fullsize.png\"><br>\n\\(I=\\frac{2 E}{R+r_1+r_2}\\)\nPotential difference across first cell \\(\\mathrm{V}=\\mathrm{E}-\\mathrm{Ir}_1=0\\)\n\\(\\begin{aligned}\n& E-\\frac{2 E r_1}{R+r_1+r_2}=0 \\\\\n& {\\left[\\frac{R+r_1+r_2-2 r_1}{R+r_1+r_2}\\right]=0} \\\\\n& \\Rightarrow R+r_2-r_1=0 \\\\\n& R=r_1-r_2\n\\end{aligned}\\)",
    "image": null
  },
