  "question": {
    "text": "Two metal wires of identical dimensions are connected in series. If $\\sigma_{1}$ and $\\sigma_{2}$ are the electrical conductivities of the metal wires respectively, the effective conductivity of the combination is"
  },
  "options": [
    {
      "text": "$\\sigma_{1}+\\sigma_{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\sigma_{1} \\sigma_{2}}{\\sigma_{1}+\\sigma_{2}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2 \\sigma_{1} \\sigma_{2}}{\\sigma_{1}+\\sigma_{2}}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{\\sigma_{1}+\\sigma_{2}}{2 \\sigma_{1} \\sigma_{2}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$R_{e q}=R_{1}+R_{2}$\r\n$\\frac{1}{\\sigma_{e q}} \\frac{2 l}{A}=\\frac{1}{\\sigma_{1}} \\frac{1}{A}+\\frac{1}{\\sigma_{2}} \\frac{1}{A}\\left[\\sigma_{e q}=\\frac{2 \\sigma_{1} \\sigma_{2}}{\\sigma_{1}+\\sigma_{2}}\\right]$"
  }
