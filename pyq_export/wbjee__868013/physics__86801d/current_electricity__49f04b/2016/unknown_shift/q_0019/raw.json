  "question": {
    "text": "The effective resistance between $A$ and $B$ in the figure is $\\frac{7}{12} \\Omega$ if each side of the cube has $1 \\Omega$ resistance. The effective resistance between the same two points, when the link $A B$ is removed, is <img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/2016_phy_a35.png\">",
    "image": null
  },
  "options": [
    {
      "id": "l85Mz",
      "text": "$\\frac{7}{12} \\Omega$",
      "isCorrect": false,
      "image": null
