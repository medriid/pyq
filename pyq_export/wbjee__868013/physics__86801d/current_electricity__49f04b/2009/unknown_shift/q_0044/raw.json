  "question": {
    "text": "Two identical cells each of emf $\\mathrm{E}$ and internal resistance $\\mathrm{r}$ are connected in parallel with an external resistance $\\mathrm{R}$. To get maximum power developed across $R$, the value of $R$ is",
    "image": null
  },
  "options": [
    {
      "id": "ojbu1",
      "text": "$R=r / 2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "RP4ok",
      "text": "$\\mathrm{R}=\\mathrm{r}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bUVkQ",
      "text": "$R=r / 3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1PKk9",
      "text": "$\\mathrm{R}=2 \\mathrm{r}$",
      "image": null,
      "isCorrect": false
    }
