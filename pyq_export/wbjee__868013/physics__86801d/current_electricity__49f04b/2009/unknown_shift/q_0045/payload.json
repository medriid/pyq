  "question": {
    "text": "A wire of resistance $5 \\Omega$ is drawn out so that its new length is 3 times its original length. What is the reistance of the new wire?"
  },
  "options": [
    {
      "text": "$45 \\Omega$",
      "is_correct": true
    },
    {
      "text": "$15 \\Omega$",
      "is_correct": false
    },
    {
      "text": "$5 / 3 \\Omega$",
      "is_correct": false
    },
    {
      "text": "$5 \\Omega$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\left(\\frac{r_1}{r_2}\\right)^2=\\left(\\frac{\\ell_2}{\\ell_1}\\right)=\\frac{3 \\ell}{\\ell}=3$\n$\\left(\\frac{R_2}{R_1}\\right)=\\frac{\\ell_2}{\\ell_1} \\times \\frac{A_1}{A_2}=3 \\times\\left(\\frac{r_1}{r_2}\\right)^2=3 \\times 3 \\Rightarrow R_2=45$"
  }
