  "question": {
    "text": "An electrical cable having a resistance of $0.2 \\Omega$ delivers $10 \\mathrm{kw}$ at $200 \\mathrm{~V}$ D.C. to a factory. What is the efficiency of transmission?",
    "image": null
  },
  "options": [
    {
      "id": "MGNW8",
      "text": "$65 \\%$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YpTbH",
      "text": "$75 \\%$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "r8d8G",
      "text": "$85 \\%$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "d2TXe",
      "text": "$95 \\%$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$P=V I \\Rightarrow I=\\frac{10 \\times 10^3}{200}=50 A$, Power loss $=(50)^2(0.2)=500 \\mathrm{~W}$\nEfficiency $=\\frac{10000 \\times 100}{10000+500}=95.23 \\%$",
    "image": null
  },
