  "question": {
    "text": "A pair of parallel metal plates are kept with a separation 'd'. One plate is at a potential $+\\mathrm{V}$ and the other is at ground potential. A narrow beam of electrons enters the space between the plates with a velocity $\\mathrm{v}_{0}$ and in a direction parallel to the plates. What will be the angle of the beam with the plates after it travels an axial distance L?",
    "image": null
  },
  "options": [
    {
      "id": "blEYQ",
      "text": "$\\tan ^{-1}\\left(\\frac{\\mathrm{eVL}}{\\mathrm{mdv}_{0}}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "xK7Kr",
      "text": "$\\tan ^{-1}\\left(\\frac{\\mathrm{eVL}}{\\mathrm{mdv}_{0}^{2}}\\right)$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "EqOKN",
      "text": "$\\sin ^{-1}\\left(\\frac{\\mathrm{eVL}}{\\mathrm{mdv}_{0}}\\right)$",
      "isCorrect": false,
