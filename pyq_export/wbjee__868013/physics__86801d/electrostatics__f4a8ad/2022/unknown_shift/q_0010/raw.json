  "question": {
    "text": "Three concentric metallic shells A, B and C of radii $a, b$ and $c(a < b < c)$ have surface charge densities $+\\sigma,-\\sigma$ and $+\\sigma$ respectively. The potential of shell B is<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/OYuD0-ig4j2tGp871QhyUNd5PLDJuwWDM1qJANtet7o.original.fullsize.png\">",
    "image": null
  },
  "options": [
    {
      "id": "pO32s",
      "text": "$\\quad(a+b+c) \\frac{\\sigma}{\\varepsilon_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9kWmX",
      "text": "$\\frac{\\sigma \\mathrm{c}}{\\varepsilon_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KbBOg",
      "text": "$\\left(\\frac{a^2}{c}-\\frac{b^2}{c}+c\\right) \\frac{\\sigma}{e_0}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8mIaH",
      "text": "$\\left(\\frac{a^2}{b}-b+c\\right) \\frac{\\sigma}{e_0}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$V_b=V_{A, b}+V_{B, b}+V_{C, b}$\n$=\\frac{K \\sigma 4 \\pi a^2}{b}-\\frac{K \\sigma 4 \\pi b^2}{b}+\\frac{K \\sigma 4 \\pi c^2}{c}$\n$=\\frac{\\sigma}{\\varepsilon_0}\\left(\\frac{a^2}{b}-b+c\\right)$",
    "image": null
