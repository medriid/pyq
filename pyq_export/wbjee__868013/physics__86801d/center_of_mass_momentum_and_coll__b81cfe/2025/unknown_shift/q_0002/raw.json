  "question": {
    "text": "A ball falls from a height $h$ upon a fixed horizontal floor. The co-efficient of restitution for the collision between the ball and the floor is 'e'. The total distance covered by the ball before coming to rest is [neglect the air resistance]",
    "image": null
  },
  "options": [
    {
      "id": "4cRzg",
      "text": "$\\frac{1-\\mathrm{e}^2}{1+\\mathrm{e}^2} \\mathrm{~h}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "F9cIm",
      "text": "$\\frac{1+e^2}{1-e^2} h$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "C0sIL",
      "text": "$\\frac{1-2 e^2}{1+e^2} h$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "31ETY",
      "text": "$\\frac{1+2 e^2}{1-e^2} h$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Dist $=\\mathrm{h}+2 \\mathrm{e}^2 \\mathrm{~h}+2 \\mathrm{e}^4 \\mathrm{~h}+-----$\n$d=\\left[\\frac{1+\\mathrm{e}^2}{1-\\mathrm{e}^2}\\right] \\mathrm{h}$",
    "image": null
