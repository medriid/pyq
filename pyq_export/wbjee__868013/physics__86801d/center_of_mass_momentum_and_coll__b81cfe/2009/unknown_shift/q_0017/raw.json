  "question": {
    "text": "If the kinetic energy of a body changes by $20 \\%$ then its momentum would change by -",
    "image": null
  },
  "options": [
    {
      "id": "fpJGC",
      "text": "$20 \\%$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bKGPh",
      "text": "$24 \\%$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "umAth",
      "text": "$40 \\%$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "96lJV",
      "text": "None of the above",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\frac{p_f^2}{2 m}-\\frac{p_i^2}{2 m}}{\\frac{p_i^2}{2 m}} \\times 100=20$\n$\\Rightarrow \\frac{p_f}{p_i}=\\sqrt{1.2}=1.095 \\Rightarrow \\frac{p_f-p_i}{p_i}=0.095$\nTherefore $\\%$ increase $=9.5 \\%$",
    "image": null
  },
