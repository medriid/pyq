  "question": {
    "text": "Two particles have masses $\\mathrm{m} \\& 4 \\mathrm{~m}$ and their kinetic energies are in the ratio $2: 1$. What is the ratio of their linear momenta?"
  },
  "options": [
    {
      "text": "$\\frac{1}{\\sqrt{2}}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{16}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\frac{K E_1}{K E_2}=\\frac{\\frac{p_1^2}{2 m}}{\\frac{p_2^2}{2 \\times 4 m}}=\\frac{2}{1} \\Rightarrow \\frac{p_1}{p_2}=\\frac{1}{\\sqrt{2}}$"
  }
}