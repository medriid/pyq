  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "A tennis ball hits the floor with a speed $v$ at an angle $\\theta$ with the normal to the floor. If the collision is inelastic and the co-efficient of restitution is $\\varepsilon$, what will be the angle of reflection?",
    "image": null
  },
  "options": [
    {
      "id": "pPQcn",
      "text": "$\\tan ^{-1}\\left(\\frac{\\tan \\theta}{\\varepsilon}\\right)$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "vM0I6",
      "text": "$\\sin ^{-1}\\left(\\frac{\\sin \\theta}{\\varepsilon}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "UcB4s",
      "text": "$\\theta \\varepsilon$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "wwJpO",
      "text": "$\\theta \\frac{2 \\varepsilon}{\\varepsilon+1}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hint:\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/pOnd9c6nLaNmaZfDKfKxgkIFvSsVCvKSqfsOv43k0dc.original.fullsize.png\"><br>\r\n$\\tan \\theta^{\\prime}=\\frac{\\operatorname{usin} \\theta}{\\operatorname{eucos} \\theta} \\quad \\tan \\theta^{\\prime}=\\frac{1}{\\mathrm{e}} \\tan \\theta$\r\nSince the floor is smooth. Hence tangential component of velocity remains unchanged.",
    "image": null
  },
