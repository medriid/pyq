  "question": {
    "text": "If the charge on a capacitor is increased by 2 coulomb, the energy stored in it increases by $21 \\%$. The original charge on the capacitor is",
    "image": null
  },
  "options": [
    {
      "id": "S5E11",
      "text": "$10 \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TP1m1",
      "text": "$20 \\mathrm{C}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Xsztf",
      "text": "$30 \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FbZ32",
      "text": "$40 \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{\\frac{q_f^2}{2 C}-\\frac{q_i^2}{2 C}}{\\frac{q_i^2}{2 C}} \\times 100=21$ and $q_f-q_i=2$\nsolving we get $q_i=20$ coulomb",
    "image": null
  },
