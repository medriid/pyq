  "question": {
    "text": "Four capacitors of equal capacitance have an equivalent capacitance $\\mathrm{C}_1$ when connected in series and an equivalent capacitance $\\mathrm{C}_2$ when connected in parallel. The ratio $\\frac{\\mathrm{C}_1}{\\mathrm{C}_2}$ is:",
    "image": null
  },
  "options": [
    {
      "id": "hkqUh",
      "text": "$1 / 4$",
      "image": null,
      "isCorrect": false
    },
    {
