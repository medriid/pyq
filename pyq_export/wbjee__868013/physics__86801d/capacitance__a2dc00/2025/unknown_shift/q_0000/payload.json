  "question": {
    "text": "What are the charges stored in the $1 \\mu \\mathrm{~F}$ and $2 \\mu \\mathrm{~F}$ capacitors in the circuit as shown in figure once the current (I) become steady?\n<img width=\"250px\" src=\"assets\\qt0000_3a152462ba37.png\"/><br/>"
  },
  "options": [
    {
      "text": "$8 \\mu \\mathrm{C}$ and $4 \\mu \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$4 \\mu \\mathrm{C}$ and $8 \\mu \\mathrm{C}$",
      "is_correct": true
    },
    {
      "text": "$3 \\mu \\mathrm{C}$ and $6 \\mu \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$6 \\mu \\mathrm{C}$ and $3 \\mu \\mathrm{C}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img width=\"250px\" src=\"assets\\st0000_e0c8c125cdcd.png\"/><br/>\n\n\n$\\begin{aligned} & I=\\frac{6}{(1+2) \\times 10^3}=2 \\times 10^{-3} \\\\ & V=I R=2 \\times 10^{-3} \\times 2 \\times 10^3=4 V \\\\ & q_1=1 \\times 4=4 \\mu C, q_2=2 \\times 4=8 \\mu C\\end{aligned}$"
  }
