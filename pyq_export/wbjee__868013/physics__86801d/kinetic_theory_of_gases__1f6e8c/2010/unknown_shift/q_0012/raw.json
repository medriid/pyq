  "question": {
    "text": "The temperature of anideal gas is increased from $120 \\mathrm{~K}$ to $480 \\mathrm{~K}$. If at $120 \\mathrm{~K}$, the root mean square speed of gas molecules is $v$, then at $480 \\mathrm{~K}$ it will be",
    "image": null
  },
  "options": [
    {
      "id": "XRL1A",
      "text": "$4 v$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ulUG1",
      "text": "$2 v$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GLAIi",
      "text": "$\\frac{v}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YDRpM",
      "text": "$\\frac{v}{4}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: } \\frac{\\mathrm{V}_1}{\\mathrm{~V}_2}=\\sqrt{\\frac{\\mathrm{T}_1}{\\mathrm{~T}_2}} \\\\\n& \\frac{\\mathrm{V}_1}{\\mathrm{~V}_2}=\\sqrt{\\frac{120}{480}}-=\\sqrt{\\frac{1}{4}}=\\frac{1}{2} \\\\\n& \\mathrm{~V}_2=2 v\n\\end{aligned}\n$$",
    "image": null
  },
