  "question": {
    "text": "<img src=\"assets\\qt0006_e3197f50a226.png\"><br>\r\nA block of mass $m$ slides with speed $v$ on a frictionless table towards another stationary block of mass $m$. A massless spring with spring constant $\\mathrm{k}$ is attached to the second block as shown in figure. The maximum distance the spring gets compress through is"
  },
  "options": [
    {
      "text": "$\\sqrt{\\frac{\\mathrm{m}}{\\mathrm{k}}} \\mathrm{v}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{\\frac{m}{2 k}} v$",
      "is_correct": true
    },
    {
      "text": "$\\sqrt{\\frac{\\mathrm{k}}{\\mathrm{m}}} \\mathrm{v}$",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{\\frac{\\mathrm{k}}{2 \\mathrm{~m}}} \\mathrm{v}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\frac{1}{2} \\mathrm{kx}^{2}=\\frac{1}{2} \\times \\frac{\\mathrm{m} \\times \\mathrm{m}}{2 \\mathrm{~m}} \\mathrm{v}^{2} \\Rightarrow \\mathrm{x}=\\sqrt{\\frac{\\mathrm{m}}{2 \\mathrm{k}}} \\mathrm{v}$"
  }
}