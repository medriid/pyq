  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text {Hint : } W=\\frac{\\mathrm{mgL}}{2}=\\frac{0.4}{4} \\times 0.6 \\times 10 \\times \\frac{0.6}{2} \\\\\n& =0.1 \\times 0.6 \\times 10 \\times 0.3 \\\\\n& =0.18 \\mathrm{~J}\n\\end{aligned}\\)",
