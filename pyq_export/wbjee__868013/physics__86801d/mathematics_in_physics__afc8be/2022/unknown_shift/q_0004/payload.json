  "question": {
    "text": "Given : The percentage error in the measurements of $\\mathrm{A}, \\mathrm{B}, \\mathrm{C}$ and $\\mathrm{D}$ are respectively, $4 \\%, 2 \\%, 3 \\%$ and $1 \\%$. The relative error in $Z=\\frac{A^4 B^{\\frac{1}{3}}}{C D^{\\frac{3}{2}}}$ is"
  },
  "options": [
    {
      "text": "$\\frac{127}{2} \\%$",
      "is_correct": false
    },
    {
      "text": "$\\frac{127}{5} \\%$",
      "is_correct": false
    },
    {
      "text": "$\\frac{127}{6} \\%$",
      "is_correct": true
    },
    {
      "text": "$\\frac{127}{7} \\%$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\quad \\mathrm{Z}=\\frac{\\mathrm{A}^4 \\mathrm{~B}^{\\frac{1}{3}}}{\\mathrm{CD}^{\\frac{3}{2}}}=\\frac{\\Delta \\mathrm{Z}}{\\mathrm{Z}}=4 \\frac{\\Delta \\mathrm{A}}{\\mathrm{A}}+\\frac{1}{3} \\frac{\\Delta \\mathrm{B}}{\\mathrm{B}}+\\frac{\\Delta \\mathrm{C}}{\\mathrm{C}}+\\frac{3}{2} \\frac{\\Delta \\mathrm{D}}{\\mathrm{D}}$\n$=4 \\times 4 \\%+\\frac{1}{3} \\times 2 \\%+3 \\%+\\frac{3}{2} \\times 1 \\%=\\left(16+\\frac{2}{3}+3+\\frac{3}{2}\\right) \\%$\n$=\\left(\\frac{127}{6}\\right) \\%$"
  }
}