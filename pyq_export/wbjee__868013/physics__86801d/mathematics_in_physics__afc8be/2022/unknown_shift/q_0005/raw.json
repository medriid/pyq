  "question": {
    "text": "The expression $\\bar{A}(A+B)+(B+A A)(A+\\bar{B})$ simplifies to",
    "image": null
  },
  "options": [
    {
      "id": "2wX1O",
      "text": "$A+B$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "m0IBQ",
      "text": "$A B$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6tITZ",
      "text": "$\\overline{\\mathrm{A}+\\mathrm{B}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "i16x2",
      "text": "$\\bar{A}+\\bar{B}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\bar{A}(A+B)+(B+A A)(A+\\bar{B}) \\\\=& \\bar{A} A+\\bar{A} B+(B+A)(A+\\bar{B}) \\\\=& O+\\bar{A} B+A B+A+B \\bar{B}+A \\bar{B} \\\\=&(\\bar{A}+A) B+A+O+A \\bar{B} \\\\=& 1 . B+A(1+\\bar{B}) \\\\=& A+B \\end{aligned}$",
    "image": null
  },
