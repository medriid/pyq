  "question": {
    "text": "$\\vec{A}$ and $\\vec{B}$ are two vectors given by $\\vec{A}=2 \\hat{i}+3 \\hat{j}$ and $\\vec{B}=\\hat{i}+\\hat{j}$. The magnitude of the component of $\\vec{A}$ along $\\vec{B}$ is",
    "image": null
  },
  "options": [
    {
      "id": "jML3h",
      "text": "$\\frac{5}{\\sqrt{2}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1tDkS",
      "text": "$\\frac{3}{\\sqrt{2}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8kJGc",
      "text": "$\\frac{7}{\\sqrt{2}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UOzQC",
      "text": "$\\frac{1}{\\sqrt{2}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Magnitude of components of $\\vec{A}$ along $\\vec{B}=\\frac{\\vec{A} \\cdot \\vec{B}}{|\\vec{B}|}=\\frac{(2 \\hat{i}+3 \\hat{j})(\\hat{i}+\\hat{j})}{\\sqrt{2}}=\\frac{5}{\\sqrt{2}}$",
    "image": null
  },
