  "question": {
    "text": "Given $\\overrightarrow{\\mathrm{C}}=\\overrightarrow{\\mathrm{A}} \\times \\overrightarrow{\\mathrm{B}}$ and $\\overrightarrow{\\mathrm{D}}=\\overrightarrow{\\mathrm{B}} \\times \\overrightarrow{\\mathrm{A}}$. What is the angle between $\\overrightarrow{\\mathrm{C}}$ and $\\overrightarrow{\\mathrm{D}}$ ?"
  },
  "options": [
    {
      "text": "$30^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$60^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$90^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$180^{\\circ}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\vec{C}$ and $\\vec{D}$ are antiparellel since $\\vec{A} \\times \\vec{B}=-(\\vec{B} \\times \\vec{A})$"
  }
