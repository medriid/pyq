  "question": {
    "text": "If $\\vec{a}+\\vec{b}=\\vec{c}$ and $a+b=c$, then the angle included between $\\vec{a}$ and $\\vec{b}$ is",
    "image": null
  },
  "options": [
    {
      "id": "eWBki",
      "text": "$90^{\\circ}$",
      "image": null,
      "isCorrect": false
    },
