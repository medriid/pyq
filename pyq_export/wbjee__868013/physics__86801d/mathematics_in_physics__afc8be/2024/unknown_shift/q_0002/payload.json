  "question": {
    "text": "Let $\\theta$ be the angle between two vectors $\\vec{A}$ and $\\vec{B}$. If $\\hat{a}_{\\perp}$ is the unit vector perpendicular to $\\vec{A}$, then the direction of $\\vec{B}-B \\sin \\theta \\hat{a}_{\\perp}$ is"
  },
  "options": [
    {
      "text": "along $\\vec{B}$",
      "is_correct": false
    },
    {
      "text": "perpendicular to $\\vec{B}$",
      "is_correct": false
    },
    {
      "text": "along $\\vec{A}$",
      "is_correct": true
    },
    {
      "text": "perpendicular to $\\vec{A}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0002_ec6b16b5ed61.png\"/><br/>\n$\\vec{B}-B \\sin \\theta \\hat{a}_{\\perp}$ is along $\\vec{A}$"
  }
