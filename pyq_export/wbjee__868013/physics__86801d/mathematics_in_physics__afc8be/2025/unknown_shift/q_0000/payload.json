  "question": {
    "text": "The resistance $\\mathrm{R}=\\frac{\\mathrm{V}}{\\mathrm{I}}$ where $\\mathrm{V}=(25 \\pm 0.4)$ Volt and $\\mathrm{I}=(200 \\pm 3)$ Ampere. The percentage error in ' R ' is"
  },
  "options": [
    {
      "text": "$1.5 \\%$",
      "is_correct": false
    },
    {
      "text": "$1.6 \\%$",
      "is_correct": false
    },
    {
      "text": "$3.1 \\%$",
      "is_correct": true
    },
    {
      "text": "$0.1 \\%$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned}\n& \\mathrm{R}=\\frac{\\mathrm{V}}{\\mathrm{I}} \\Rightarrow\\left(\\frac{\\Delta \\mathrm{R}}{\\mathrm{R}}\\right)_{\\max } \\times 100 \\%=\\left(\\frac{\\Delta \\mathrm{V}}{\\mathrm{~V}}+\\frac{\\Delta \\mathrm{I}}{\\mathrm{I}}\\right) \\times 100 \\% \\\\\n& =\\left(\\frac{0.4}{25}+\\frac{3}{200}\\right) \\times 100 \\%=3.1 \\%\n\\end{aligned}$"
  }
}