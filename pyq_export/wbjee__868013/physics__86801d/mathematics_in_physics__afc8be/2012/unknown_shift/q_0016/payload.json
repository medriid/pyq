  "options": [
    {
      "text": "$\\cos ^{-1}(3 / 5)$",
      "is_correct": true
    },
    {
      "text": "$\\cos ^{-1}(4 / 5)$",
      "is_correct": false
    },
    {
      "text": "$\\pi / 2$",
      "is_correct": false
    },
    {
      "text": "$\\sin ^{-1}(3 / 4)$",
      "is_correct": false
    }
