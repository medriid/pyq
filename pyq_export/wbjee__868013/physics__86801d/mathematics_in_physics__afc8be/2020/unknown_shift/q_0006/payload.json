  "question": {
    "text": "Consider the vectors\r\n$\\overrightarrow{\\mathrm{A}}=\\hat{\\mathrm{i}}+\\hat{\\mathrm{j}}-\\hat{\\mathrm{k}}, \\overrightarrow{\\mathrm{B}}=2 \\hat{\\mathrm{i}}-\\hat{\\mathrm{j}}+\\hat{\\mathrm{k}}, \\overrightarrow{\\mathrm{C}}=\\frac{1}{\\sqrt{5}}(\\hat{\\mathrm{i}}-2 \\hat{\\mathrm{j}}+2 \\hat{\\mathrm{k}})$. What is the value of $\\overrightarrow{\\mathrm{C}} .(\\overrightarrow{\\mathrm{A}} \\times \\overrightarrow{\\mathrm{B}}) ?$"
  },
  "options": [
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "0",
      "is_correct": true
    },
    {
      "text": "$3 \\sqrt{2}$",
      "is_correct": false
    },
    {
      "text": "$18 \\sqrt{5}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint: \r\n$\\overrightarrow{\\mathrm{C}}(\\overrightarrow{\\mathrm{A}} \\times \\overrightarrow{\\mathrm{B}})=\\left|\\begin{array}{ccc}1 & 1 & -1 \\\\ 2 & -1 & 1 \\\\ 1 & -2 & 2\\end{array}\\right|=1(-2+2)-1(4-1)-1(-4+1)=-3+3=0$"
  }
}