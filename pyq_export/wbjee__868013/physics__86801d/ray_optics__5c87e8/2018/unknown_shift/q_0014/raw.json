  "question": {
    "text": "There is a small air bubble at the centre of a solid glass sphere of radius $r$ and refractive index $\\mu .$ What will be the apparent distance of the bubble from the centre of the sphere, when viewed from outside?",
    "image": null
  },
  "options": [
    {
      "id": "h21EU",
      "text": "r",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "m5Ud0",
      "text": "$\\frac{r}{\\mu}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "cSwV6",
      "text": "$r\\left(1-\\frac{1}{\\mu}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "HuYPJ",
      "text": "Zero",
      "isCorrect": true,
      "image": null
    }
