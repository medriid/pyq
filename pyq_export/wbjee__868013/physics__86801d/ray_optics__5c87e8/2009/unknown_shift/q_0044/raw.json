  "question": {
    "text": "A $2.0 \\mathrm{~cm}$ object is placed $15 \\mathrm{~cm}$ in front of a concave mirror of focal length $10 \\mathrm{~cm}$. What is the size and nature of the image?",
    "image": null
  },
  "options": [
    {
      "id": "xAILA",
      "text": "$4 \\mathrm{~cm}$. real",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "v1UrQ",
      "text": "$4 \\mathrm{~cm}$, virtual",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MjJLl",
      "text": "$1.0 \\mathrm{~cm}$, real",
      "image": null,
      "isCorrect": false
    },
