  "question": {
    "text": "The distance between an object and a divergent lens is $\\mathrm{m}$ times the focal length of the lens. The linear magnification produced by the lens is",
    "image": null
  },
  "options": [
    {
      "id": "vmQMO",
      "text": "$\\mathrm{m}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hkYCM",
      "text": "$\\frac{1}{\\mathrm{~m}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qkRhw",
      "text": "$m+1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vdwzt",
      "text": "$\\frac{1}{m+1}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{u}=-\\mathrm{mf}$\n$\\frac{1}{\\mathrm{v}}-\\frac{1}{(-m f)}=-\\frac{1}{f} \\Rightarrow \\frac{1}{\\mathrm{v}}=-\\frac{1}{f}\\left(1+\\frac{1}{m}\\right) \\Rightarrow-\\frac{\\mathrm{v}}{\\mathrm{u}}=\\left(\\frac{1}{1+m}\\right)$",
    "image": null
  },
