  "question": {
    "text": "A beam of monochromatic blue light of wavelength $4200 Å$ in air travels in water of refractive index $4 / 3$. Its wavelength in water will be:"
  },
  "options": [
    {
      "text": "$4200 Å$",
      "is_correct": false
    },
    {
      "text": "$5800 Å$",
      "is_correct": false
    },
    {
      "text": "$4150 Å$",
      "is_correct": false
    },
    {
      "text": "$3150 Å$",
      "is_correct": true
