  "options": [
    {
      "id": "sfSjc",
      "text": "$\\left(\\frac{\\mathrm{R}}{\\sqrt{2}}, \\frac{\\mathrm{R}}{\\sqrt{2}}\\right)$",
      "isCorrect": false,
