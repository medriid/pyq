  "question": {
    "text": "If $\\hat{n}_1, \\hat{n}_2$ and $\\hat{t}$ represent, unit vectors along the incident ray, reflected ray and normal to the surface respectively, then\n\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/UyQjRlfas5nEMtCpKcOA-Bh0DmDurfcHusLmgdoRE-s.original.fullsize.png\"/><br/>",
    "image": null
  },
  "options": [
    {
      "id": "rZBp7",
      "text": "$\\quad \\hat{n}_2=\\hat{n}_1-2\\left(\\hat{n}_1 \\cdot \\hat{t}\\right) \\hat{\\mathrm{t}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XRs8z",
      "text": "$\\hat{n}_2=\\hat{n}_1+2\\left(\\hat{n}_1 \\cdot \\hat{t}\\right) \\hat{\\mathrm{t}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dQU0y",
      "text": "$\\hat{n}_2=-\\hat{n}_1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1xtVO",
      "text": "$\\hat{n}_2=2 \\hat{n}_1-\\left(\\hat{n}_1 \\times \\hat{t}\\right) \\cdot \\hat{n}_1$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { Hint: } \\hat{n}_1=-\\cos \\theta \\hat{\\mathrm{t}}+\\sin \\theta \\hat{\\mathrm{i}} \\\\ & \\hat{\\mathrm{n}}_2=\\cos \\theta \\hat{\\mathrm{t}}+\\sin \\theta \\hat{\\mathrm{i}} \\\\ & \\hat{\\mathrm{n}}_2-\\hat{\\mathrm{n}}_1=2 \\cos \\theta \\hat{\\mathrm{t}}=-2(\\hat{\\mathrm{n}} \\cdot \\hat{\\mathrm{t}}) \\hat{\\mathrm{t}} \\\\ & \\hat{\\mathrm{n}}_1 \\cdot \\hat{\\mathrm{t}}=-\\cos \\theta \\\\ & \\hat{n}_2=\\hat{n}_1-2\\left(\\hat{n}_1 \\cdot \\hat{\\mathrm{t}}\\right) \\hat{\\mathrm{t}}\\end{aligned}$",
    "image": null
  },
