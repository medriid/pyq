  "question": {
    "text": "When a convex lens is placed above an empty tank, the image of a mark at the bottom of the tank, which is 45 cm\nfrom the lens is formed 36 cm above the lens. When a liquid is poured in the tank to a depth of 40 cm, the distance\nof the image of the mark above the lens is 48 cm. The refractive index of the liquid is",
    "image": null
  },
  "options": [
    {
      "id": "c0fON",
      "text": "1.358",
      "image": null,
      "isCorrect": false
