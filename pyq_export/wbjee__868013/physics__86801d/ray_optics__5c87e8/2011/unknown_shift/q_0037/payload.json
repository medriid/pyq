    {
      "text": "\\(30 \\mathrm{~cm}\\)",
      "is_correct": false
    },
    {
      "text": "\\(150 \\mathrm{~cm}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Hints: \\(\\frac{1}{5 \\mathrm{u}}-\\left(\\frac{1}{-\\mathrm{u}}\\right)=\\frac{1}{30}\\)\n\\(\\begin{aligned}\n& \\frac{1}{5 \\mathrm{u}}+\\frac{1}{\\mathrm{u}}=\\frac{1}{30}, \\frac{5+1}{5 \\mathrm{u}}=\\frac{1}{30} \\\\\n& \\mathrm{u}=36 \\mathrm{~cm} .\n\\end{aligned}\\)"
  }
