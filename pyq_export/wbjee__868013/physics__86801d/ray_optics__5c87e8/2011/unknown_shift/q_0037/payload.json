  "question": {
    "text": "A convex lens of focal length \\(30 \\mathrm{~cm}\\) produces 5 times magnified real image of an object. What is the object distance ?"
  },
  "options": [
    {
      "text": "\\(36 \\mathrm{~cm}\\)",
      "is_correct": true
    },
    {
      "text": "\\(25 \\mathrm{~cm}\\)",
      "is_correct": false
