      "is_correct": false
    },
    {
      "text": "\\(-0.5 \\mathrm{D}\\)",
      "is_correct": true
    },
    {
      "text": "\\(-2 \\mathrm{D}\\)",
      "is_correct": false
    },
    {
      "text": "\\(+2 \\mathrm{D}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text {Hints: } P=\\frac{1}{f}=(\\mu-1)\\left(\\frac{1}{R_1}-\\frac{1}{R_2}\\right) \\\\\n& =(1.5-1)\\left(\\frac{1}{\\infty}-\\frac{1}{1 \\mathrm{~m}}\\right) \\\\\n& =0.5(-1) \\\\\n& P=-0.5 \\mathrm{D}\n\\end{aligned}\\)"
  }
