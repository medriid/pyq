  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/2MyM7L-E-5CCx_A5fTs5Mf9SCYDhO-ZhXu9uHk8o-uw.original.fullsize.png\"><br>\n$\\theta=\\frac{x}{d}$\n$5.8 \\times 10^{-4}=\\frac{2.54}{300} \\times \\frac{1}{d}$\n$d=14.59 \\mathrm{~cm}$",
