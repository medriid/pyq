      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/qSyQNlA375Bb9yomgju8sm5wW9ZUtB8RflIvACqOJVk.original.fullsize.png\"><br>\n$F_B=i \\times 2 r \\times B$\n$2 F=F_B$\n$F=i r B$",
