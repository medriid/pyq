  "question": {
    "text": "A particle is projected at $60^{\\circ}$ to the horizontal with a kinetic energy $\\mathrm{K}$. The kinetic energy at the highest point is",
    "image": null
  },
  "options": [
    {
      "id": "ZHwlv",
      "text": "K",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vkSpm",
      "text": "zero",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9NcQg",
      "text": "$\\frac{\\mathrm{K}}{4}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "64eIt",
      "text": "$\\frac{\\mathrm{K}}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "At highest point kinetic energy $=1 / 2 \\mathrm{~m}\\left(\\mathrm{v} \\cos 60^{\\circ}\\right)^2=1 / 4 \\times 1 / 2 \\mathrm{~m} \\mathrm{v} v^2=\\mathrm{K} / 4$",
    "image": null
  },
