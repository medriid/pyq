  "question": {
    "text": "A body of mass $m$ is thrown with velocity u from the origin of a co-ordinate axes at an angle $\\theta$ with the horizon. The magnitude of the angular momentum of the particle about the origin at time $\\mathrm{t}$ when it is at the maximum height of the trajectory is proportional to",
    "image": null
  },
  "options": [
    {
      "id": "kAZsa",
      "text": "$\\mathrm{u}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sQcst",
      "text": "$u^2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Mwlsw",
      "text": "$\\mathrm{u}^3$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "D7FQV",
      "text": "independent of $u$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/tEeo08p6qilPBu21NB9VZpSasp39TcyruSUhZeeuuAA.original.fullsize.png\"><br>\n$\\vec{L}=m u \\cos \\theta h_{\\max }=m u \\cos \\theta \\frac{u^2 \\sin ^2 \\theta}{2 g} \\Rightarrow L=\\frac{m u^3 \\sin ^2 \\theta \\cos \\theta}{2 g} \\quad L \\propto u^3$",
    "image": null
  },
