  "question": {
    "text": "If $x=a t+b t^{2},$ where $x$ is in metre $(\\mathrm{m})$ and $t$ is in hour $(\\mathrm{h})$, then unit of $b$ will be"
  },
  "options": [
    {
      "text": "$\\frac{\\mathrm{m}^{2}}{\\mathrm{h}}$",
      "is_correct": false
    },
    {
      "text": "$m$",
      "is_correct": false
    },
    {
      "text": "$\\frac{m}{h}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{m}{h^{2}}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Given, $x=a t+b t^{2}$\r\n$\\begin{array}{l}\r\n{[x]=\\left[b t^{2}\\right]} \\\\\r\n\\text { Unit of } b=\\frac{x}{t^{2}}=\\frac{\\text { metre }}{(h)^{2}}=\\frac{m}{h^{2}}\r\n\\end{array}$"
  }
}