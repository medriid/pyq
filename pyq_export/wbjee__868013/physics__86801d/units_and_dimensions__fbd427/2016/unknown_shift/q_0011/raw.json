  "question": {
    "text": "If $x=a t+b t^{2},$ where $x$ is in metre $(\\mathrm{m})$ and $t$ is in hour $(\\mathrm{h})$, then unit of $b$ will be",
    "image": null
  },
  "options": [
    {
      "id": "KzFNV",
      "text": "$\\frac{\\mathrm{m}^{2}}{\\mathrm{h}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "LDMhL",
      "text": "$m$",
      "isCorrect": false,
      "image": null
    },
    {
