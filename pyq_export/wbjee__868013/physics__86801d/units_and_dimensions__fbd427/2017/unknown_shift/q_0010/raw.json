    "text": "The dimension of the universal constant of gravitation, $G$ is",
    "image": null
  },
  "options": [
    {
      "id": "EgJK4",
      "text": "$\\left[\\mathrm{ML}^{2} \\mathrm{T}^{-1}\\right]$",
      "isCorrect": false,
      "image": null
    },
    {
