  "question": {
    "text": "The apparent coefficient of expansion of a liquid, when heated in a copper vessel is $C$ and when heated in silver vessel is S . If A is linear coefficient of expansion of copper, then linear coefficient of expansion of silver is"
  },
  "options": [
    {
      "text": "$\\frac{\\mathrm{C}-\\mathrm{S}-\\mathrm{3A}}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{C}+\\mathrm{3A}-\\mathrm{S}}{3}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{\\mathrm{S}+\\mathrm{3A}-\\mathrm{C}}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{C}+\\mathrm{S}+\\mathrm{3A}}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text {} \\mathrm{C}=\\gamma_L-\\gamma_C \\Rightarrow \\mathrm{C}=\\gamma_L-\\mathrm{3A} \\Rightarrow \\gamma_L=\\mathrm{C}+\\mathrm{3A} \\\\ & \\mathrm{~S}=\\gamma_L-\\gamma_S \\Rightarrow \\gamma_S=\\mathrm{C}+\\mathrm{3A}-\\mathrm{S} \\\\ & \\Rightarrow \\alpha_{\\mathrm{S}}=\\frac{\\mathrm{C}+\\mathrm{3A}-\\mathrm{S}}{3}\\end{aligned}$"
  }
}