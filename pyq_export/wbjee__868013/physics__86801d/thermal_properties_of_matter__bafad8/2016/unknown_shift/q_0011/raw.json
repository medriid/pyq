  "question": {
    "text": "If the temperature of the Sun gets doubled, the rate of energy received on the Earth will increase by a factor of",
    "image": null
  },
  "options": [
    {
      "id": "phf0Y",
      "text": "2",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "OhF9T",
      "text": "4",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "JQt4g",
      "text": "8",
