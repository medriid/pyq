  "question": {
    "text": "In a mercury thermometer, the ice point (lower fixed point) is marked as $10^{\\circ}$ and the steam point (upper fixed point) is marked as $130^{\\circ}$. At $40^{\\circ} \\mathrm{C}$ temperature, what will this thermometer read?"
  },
  "options": [
    {
      "text": "$78^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$66^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$62^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$58^{\\circ}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{x-10}{130-10}=\\frac{40}{100}$\r\n$$\r\n\\begin{array}{r}\r\n100 x-1000=4800 \\\\\r\n100 x=5800 \\\\\r\nx=58^{\\circ}\r\n\\end{array}\r\n$$"
  }
}