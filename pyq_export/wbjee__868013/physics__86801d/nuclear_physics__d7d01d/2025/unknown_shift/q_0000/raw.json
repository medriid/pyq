      "image": null,
      "isCorrect": false
    },
    {
      "id": "22CAb",
      "text": "$E_{b n A}\\gt E_{\\text {bnB }}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BAKQJ",
      "text": "$\\mathrm{E}_{\\mathrm{bnA}} \\lt \\mathrm{E}_{\\mathrm{bnB}}$",
      "image": null,
      "isCorrect": false
