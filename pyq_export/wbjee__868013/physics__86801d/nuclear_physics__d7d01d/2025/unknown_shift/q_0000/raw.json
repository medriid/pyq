  "question": {
    "text": "Let the binding energy per nucleon of nucleus is denoted by ' $\\mathrm{E}_{\\mathrm{bn}}$ ' and radius of the nucleus is denoted by' r '. If mass number of nuclei $A$ and $B$ are 64 and 125 respectively, then",
    "image": null
  },
  "options": [
    {
      "id": "VVI0y",
      "text": "$r_A \\lt r_B$",
      "image": null,
      "isCorrect": true
    },
    {
