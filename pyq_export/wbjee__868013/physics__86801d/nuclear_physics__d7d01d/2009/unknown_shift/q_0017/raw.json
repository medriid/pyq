  "question": {
    "text": "What is the particle $\\mathrm{x}$ in the following nuclear reaction :\n${ }_4^9 \\mathrm{Be}+{ }_2^4 \\mathrm{He} \\rightarrow{ }_6^{12} \\mathrm{C}+\\mathrm{x}$",
    "image": null
  },
  "options": [
    {
      "id": "Ef5Ex",
      "text": "electron",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FOlYz",
      "text": "proton",
      "image": null,
      "isCorrect": false
    },
    {
