  "correctValue": null,
  "solution": {
    "text": "${ }_4^9 \\mathrm{Be}+{ }_2^4 \\mathrm{He} \\rightarrow{ }_6^{12} \\mathrm{C}+{ }_0^1 \\mathrm{X}$\nHence X represents neutron $\\left({ }_0^1 n\\right)$",
    "image": null
  },
