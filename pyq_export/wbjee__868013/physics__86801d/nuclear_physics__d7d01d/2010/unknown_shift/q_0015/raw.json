  "question": {
    "text": "The energy released by the fission of one uranium atom is $200 \\mathrm{MeV}$. The number of fissions per second required to produce $3.2 \\mathrm{~W}$ of power is (Take $1 \\mathrm{eV}=1.6 \\times 10^{-19} \\mathrm{~J}$ )",
    "image": null
  },
