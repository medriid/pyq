  "question": {
    "text": "The energy released by the fission of one uranium atom is $200 \\mathrm{MeV}$. The number of fissions per second required to produce $3.2 \\mathrm{~W}$ of power is (Take $1 \\mathrm{eV}=1.6 \\times 10^{-19} \\mathrm{~J}$ )"
  },
  "options": [
    {
      "text": "$10^7$",
      "is_correct": false
    },
    {
      "text": "$10^{10}$",
      "is_correct": false
    },
    {
      "text": "$10^{15}$",
      "is_correct": false
    },
    {
      "text": "$10^{11}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hints: $u=200 \\mathrm{MeV}=200 \\times 10^6 \\mathrm{eV}=200 \\times 10^6 \\times 1.6 \\times 10^{-19} \\mathrm{~J}$\n$\\mathrm{E}=3.2 \\mathrm{~J}$\nNo of fissions $=\\frac{3.2}{2 \\times 1.6 \\times 10^{-11}}=10^{11}$"
  }
}