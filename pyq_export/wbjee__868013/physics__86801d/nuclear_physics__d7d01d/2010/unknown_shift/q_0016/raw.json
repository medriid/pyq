  "question": {
    "text": "Half-life of a radioactive substance is 20 minute. The time between $20 \\%$ and $80 \\%$ decay will be :",
    "image": null
  },
  "options": [
    {
      "id": "MuZc2",
      "text": "$20 \\mathrm{~min}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "z6EIb",
      "text": "$30 \\mathrm{~min}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WOxI6",
      "text": "$40 \\mathrm{~min}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "C1xGo",
      "text": "$25 \\mathrm{~min}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints : For $20 \\%$ decay\n$\\frac{80 \\mathrm{~N}_0}{100}=\\mathrm{N}_0 e^{-\\lambda t_1}$\nFor $80 \\%$ decay\n$\\frac{20 N_0}{100}=N_0 e^{-\\lambda t_2}$\nOn dividing\n$\\begin{aligned}\n& 4=e^{\\lambda\\left(t_2-t\\right)} \\\\\n& 2 \\ln 2=\\frac{\\ln 2}{t_{1 / 2}}\\left(t_2-t_1\\right) \\\\\n& \\Rightarrow t_2-t_1=2 \\times 20=40 \\mathrm{~min}\n\\end{aligned}$",
    "image": null
  },
