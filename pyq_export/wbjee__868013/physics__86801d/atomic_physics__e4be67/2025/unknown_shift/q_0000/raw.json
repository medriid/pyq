  "question": {
    "text": "The minimum wavelength of Lyman series lines is $P$, then the maximum wavelength of these lines is",
    "image": null
  },
  "options": [
    {
      "id": "U9V8d",
      "text": "$\\frac{4 \\mathrm{P}}{3}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "4x8so",
      "text": "2 P",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hjSoV",
      "text": "$\\frac{2 P}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oYPAp",
      "text": "$\\quad \\infty$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\lambda_{\\min }=\\mathrm{P} \\\\ & \\frac{\\mathrm{hc}}{\\lambda_{\\min }}=\\mathrm{c}_1\\left(\\frac{1}{1}-\\frac{1}{\\infty}\\right) \\\\ & \\lambda_{\\min }=\\frac{\\mathrm{hc}}{\\mathrm{c}_1} \\\\ & \\frac{\\mathrm{hc}}{\\lambda_{\\max }}=\\mathrm{c}_1\\left(1-\\frac{1}{4}\\right)=\\mathrm{c}_1 \\frac{3}{4} \\\\ & \\lambda_{\\max }=\\frac{4 \\mathrm{hc}}{3 \\mathrm{c}_1}=\\frac{4}{3} \\mathrm{P}\\end{aligned}$",
    "image": null
  },
