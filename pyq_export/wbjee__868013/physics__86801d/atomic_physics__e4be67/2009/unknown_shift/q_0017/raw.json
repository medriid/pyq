  "question": {
    "text": "If the electron in a hydrogen atom jumps from an orbit with level $\\mathrm{n}_1=2$ to an orbit with level $\\mathrm{n}_2=1$ the emitted radiation has a wavelength given by",
    "image": null
  },
  "options": [
    {
      "id": "q7Lta",
      "text": "$\\lambda=5 / 3 \\mathrm{R}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3k3p2",
      "text": "$\\lambda=4 / 3 \\mathrm{R}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "IzfBK",
      "text": "$\\lambda=\\mathrm{R} / 4$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qNnVP",
      "text": "$\\lambda=3 \\mathrm{R} / 4$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{1}{\\lambda}=R\\left(\\frac{1}{n_1^2}-\\frac{1}{n_2^2}\\right)=R\\left(\\frac{1}{1^2}-\\frac{1}{2^2}\\right)=\\frac{3 R}{4}$\n$\\Rightarrow \\lambda=\\frac{4}{3 R}$",
    "image": null
  },
