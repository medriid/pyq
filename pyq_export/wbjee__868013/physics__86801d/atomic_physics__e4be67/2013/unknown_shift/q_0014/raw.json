  "question": {
    "text": "The ionization energy of the hydrogen atom is 13.6 eV. The potential energy of the electron in $n=2$ state of hydrogen atom is",
    "image": null
  },
  "options": [
    {
      "id": "LVNIP",
      "text": "$+3.4 \\mathrm{eV}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "vgarl",
      "text": "$-3.4 \\mathrm{eV}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SADQe",
      "text": "$+6.8 \\mathrm{eV}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "4Yd3x",
      "text": "$-6.8 \\mathrm{eV}$",
      "isCorrect": true,
      "image": null
