  "question": {
    "text": "Let $\\mathrm{r}, \\mathrm{v}, \\mathrm{E}$ be the radius of orbit, speed of electron and total energy of electron respectively in a $\\mathrm{H}$-atom. Which of the following quantities according to Bohr theory, is proportional to the quantum number $\\mathrm{n}$ ?"
  },
  "options": [
    {
      "text": "vr",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{rE}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{r}{E}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{r}{v}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{mvr}=\\frac{\\mathrm{nh}}{2 \\pi} \\quad \\therefore \\mathrm{n}=\\frac{\\mathrm{m} 2 \\pi}{\\mathrm{h}} \\cdot \\mathrm{vr} \\quad \\therefore \\mathrm{n} \\propto \\mathrm{vr}$"
  }
}