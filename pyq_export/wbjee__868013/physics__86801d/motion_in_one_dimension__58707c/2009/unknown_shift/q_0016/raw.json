  "question": {
    "text": "The acceleration ' $a$ ' (in $\\mathrm{ms}^{-2}$ ) of a body, starting from rest varies with time $t$ (in $s$ ) following the equation $a=3 t+4$ The velocity of the body at time $t=2 \\mathrm{~s}$ will be",
    "image": null
  },
  "options": [
    {
      "id": "yOruS",
      "text": "$10 \\mathrm{~ms}^{-1}$",
      "image": null,
      "isCorrect": false
    },
    {
