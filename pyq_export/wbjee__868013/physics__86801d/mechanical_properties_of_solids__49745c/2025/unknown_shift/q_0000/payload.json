  "question": {
    "text": "One end of a steel wire is fixed to the ceiling of an elevator moving up with an acceleration $2 \\mathrm{~m} / \\mathrm{s}^2$ and a load of 10 kg hangs from the other end. If the cross section of the wire is $2 \\mathrm{~cm}^2$ then the longitudinal strain in the wire will be ( $\\mathrm{g}=$ $10 \\mathrm{~m} / \\mathrm{s}^2$ and $\\left.\\mathrm{Y}=2.0 \\times 10^{11} \\mathrm{~N} / \\mathrm{m}^2\\right)$\n\n<img width=\"250px\" src=\"assets\\qt0000_f115c6dc9e87.png\"/><br/>"
  },
  "options": [
    {
      "text": "$4 \\times 10^{11}$",
      "is_correct": false
    },
    {
      "text": "$3 \\times 10^{-6}$",
      "is_correct": true
    },
    {
      "text": "$8 \\times 10^{-6}$",
      "is_correct": false
    },
    {
      "text": "$2 \\times 10^{-6}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\mathrm{T}-\\mathrm{mg}=\\mathrm{ma} \\\\ & \\mathrm{T}=\\mathrm{m}(\\mathrm{g}+\\mathrm{a}) \\\\ & =10(10+2)=120 \\mathrm{~N} \\\\ & \\mathrm{y}=\\frac{\\mathrm{TL}}{\\mathrm{A} \\Delta \\ell} \\\\ & \\frac{\\Delta \\ell}{\\mathrm{L}}=\\frac{\\mathrm{T}}{\\mathrm{YA}}=\\frac{\\not 120 \\times 30}{\\not 2 \\times 10^{11} \\times \\not 2 \\times 10^{-4}} \\\\ & =30 \\times 10^{-7}=3 \\times 10^{-6}\\end{aligned}$"
  }
}