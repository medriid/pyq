  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "In a Frounhofer diffraction experiment, a single slit of width $0.5 \\mathrm{~mm}$ is illuminated by a monochromatic light of wavelength $600 \\mathrm{~nm}$. The diffraction pattern is observed on a screen at a distance of $50 \\mathrm{~cm}$ from the slit. What will be the linear separation of the first order minima?",
    "image": null
  },
  "options": [
    {
      "id": "Bg3lH",
      "text": "$1.0 \\mathrm{~mm}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "yIv7w",
      "text": "$1.1 \\mathrm{~mm}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "3o2ZX",
      "text": "$0.6 \\mathrm{~mm}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "O7Tyg",
      "text": "$1.2 \\mathrm{~mm}$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hint:\r\n$\\mathrm{d}=0.5 \\mathrm{~mm} .$\r\n$\\lambda=600 \\mathrm{~nm} .$ Width of central maxima $=\\frac{2 \\lambda \\mathrm{D}}{\\mathrm{d}}$\r\n$\\mathrm{D}=50 \\mathrm{~cm}$\r\n$\\frac{2 \\lambda \\mathrm{D}}{\\mathrm{d}}=\\frac{2 \\times 600 \\times 50 \\times 10^{-2} \\times 10^{-9}}{0.5 \\times 10^{-3}}=1.2 \\mathrm{~mm}$",
    "image": null
  },
