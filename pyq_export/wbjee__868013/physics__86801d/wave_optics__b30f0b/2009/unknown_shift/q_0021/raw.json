  "question": {
    "text": "Two identical light waves, propagating in the same direction, have a phase difference $\\delta$. After they superpose the intensity of the resulting wave will be proportional to",
    "image": null
  },
  "options": [
    {
      "id": "P49bo",
      "text": "$\\cos \\delta$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SkFXa",
      "text": "$\\cos (\\delta / 2)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zLY9K",
      "text": "$\\cos ^2(\\delta / 2)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "B2skB",
      "text": "$\\cos ^2 \\delta$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$I=4 I_0 \\cos ^2\\left(\\frac{\\delta}{2}\\right) \\Rightarrow I \\propto \\cos ^2\\left(\\frac{\\delta}{2}\\right)$",
    "image": null
  },
