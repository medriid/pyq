  "question": {
    "text": "An earth's satellite nejar the surface of the earth takes about 90 min per revolution. A satellite orbiting the moon also takes about 90 min per revolution. Then which of the following is true?",
    "image": null
  },
  "options": [
    {
      "id": "klaV6",
      "text": "\\(\\rho_m  < \\rho_e\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "r0Rsu",
      "text": "\\(\\rho_m > \\rho_e\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yya2T",
      "text": "\\(\\rho_{\\mathrm{m}}=\\rho_{\\mathrm{e}}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "E1guf",
      "text": "No conclusion can be made about the densities",
      "image": null,
      "isCorrect": false
