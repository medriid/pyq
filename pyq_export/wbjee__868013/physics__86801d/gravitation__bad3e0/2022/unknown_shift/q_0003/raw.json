  "question": {
    "text": "A body of mass $m$ is thrown vertically upward with speed $\\sqrt{3} v_e$, where $v_e$ is the escape velocity of a body from earth surface. The final velocity of the body is",
    "image": null
  },
  "options": [
    {
      "id": "JZJaR",
      "text": "0",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "N4x9k",
      "text": "$2 v_e$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zTnyD",
      "text": "$\\sqrt{3} v_e$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SvaUC",
      "text": "$\\sqrt{2} \\mathrm{v}_{\\mathrm{e}}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$-\\frac{\\mathrm{GMm}}{\\mathrm{R}}+\\frac{1}{2} \\mathrm{~m}\\left(\\sqrt{3} \\mathrm{v}_{\\mathrm{e}}\\right)^2=0+\\frac{1}{2} \\mathrm{mv}^2, \\quad \\mathrm{v}=\\sqrt{2} \\mathrm{v}_{\\mathrm{e}}$",
    "image": null
  },
