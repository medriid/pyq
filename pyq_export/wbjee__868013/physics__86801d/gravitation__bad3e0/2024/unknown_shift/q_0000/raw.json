  "question": {
    "text": "A satellite of mass m rotates round the earth in a circular orbit of radius R. If the angular momentum of the satellite\nis J, then its kinetic energy (K) and the total energy (E) of the satellite are",
    "image": null
  },
  "options": [
    {
      "id": "y7xoz",
      "text": "$\\mathrm{K}=\\frac{\\mathrm{J}^2}{m R^2}, \\mathrm{E}=-\\frac{\\mathrm{J}^2}{2 m R^2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Fs5rP",
      "text": "$\\mathrm{K}=\\frac{\\mathrm{J}^2}{2 m R^2}, \\mathrm{E}=-\\frac{\\mathrm{J}^2}{2 m R^2}$",
      "image": null,
