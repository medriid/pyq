  "question": {
    "text": "The change in the gravitational potential energy when a body of mass $m$ is raised to a height $n \\mathrm{R}$ above the surface of the Earth is (here $R$ is the radius of the Earth)",
    "image": null
  },
  "options": [
    {
      "id": "lJA2O",
      "text": "$\\left(\\frac{n}{n+1}\\right) m g \\mathrm{R}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "qUnqw",
      "text": "$\\left(\\frac{n}{n-1}\\right) m g \\mathrm{R}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vQj9w",
      "text": "$n m g R$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A39lP",
      "text": "$\\frac{m g R}{n}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints: $\\Delta \\mathrm{U}=\\frac{m g h}{1+\\frac{h}{\\mathrm{R}}}=\\frac{m g \\times n \\mathrm{R}}{1+\\frac{n \\mathrm{R}}{\\mathrm{R}}}=\\frac{n m g \\mathrm{R}}{n+1}$",
    "image": null
  },
