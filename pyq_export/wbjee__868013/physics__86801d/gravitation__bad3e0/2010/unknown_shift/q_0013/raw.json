  "question": {
    "text": "The height vertically above the earth's surface at which the acceleration due to gravity becomes $1 \\%$ of its value at the surface is ( $\\mathrm{R}$ is the radius of the Earth)",
    "image": null
  },
  "options": [
    {
      "id": "QB9xf",
      "text": "$8 \\mathrm{R}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PJ3Yx",
      "text": "$9 \\mathrm{R}$",
      "image": null,
      "isCorrect": true
