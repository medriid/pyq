  "question": {
    "text": "A plane progressive wave is given by \\(y=2 \\cos 6.284(330 \\mathrm{t}-\\mathrm{x})\\). What is period of the wave?",
    "image": null
  },
  "options": [
    {
      "id": "Z1QIQ",
      "text": "\\(\\frac{1}{330} \\mathrm{~S}\\)",
      "image": null,
      "isCorrect": true
