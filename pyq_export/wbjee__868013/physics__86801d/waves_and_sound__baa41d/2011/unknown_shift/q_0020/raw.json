  "correctValue": null,
  "solution": {
    "text": "Hints: \\(y=2 \\cos 2 \\pi(330 t-x)\\)\n\\(\\omega=2 \\pi \\times 330\\)\n\\(\\therefore \\mathrm{T}=\\frac{1}{330} \\mathrm{~s}\\)",
    "image": null
