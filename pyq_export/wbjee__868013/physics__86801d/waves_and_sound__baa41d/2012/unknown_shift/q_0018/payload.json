  "question": {
    "text": "The frequency of the first overtone of a closed pipe of length $l_{1}$ is equal to that of the first. overtone of an open pipe of length $l_{2}$. The ratio of their lengths $\\left(l_{1}: l_{2}\\right)$ is"
  },
  "options": [
    {
      "text": "$2: 3$",
      "is_correct": false
    },
    {
      "text": "$4: 5$",
      "is_correct": false
