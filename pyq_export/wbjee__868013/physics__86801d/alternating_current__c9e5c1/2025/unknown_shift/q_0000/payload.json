  "question": {
    "text": "For a domestic AC supply of 220 V at 50 cycles per sec, the potential difference between the terminals of a two-pin electric outlet in a room is given by"
  },
  "options": [
    {
      "text": "$\\quad V(t)=220 \\sqrt{2} \\operatorname{Cos}(100 \\pi t)$",
      "is_correct": true
    },
    {
      "text": "$\\quad V(t)=220 \\operatorname{Sin}(50 t)$",
      "is_correct": false
    },
    {
      "text": "$\\quad \\mathrm{V}(\\mathrm{t})=220 \\operatorname{Cos}(100 \\pi \\mathrm{t})$",
      "is_correct": false
    },
    {
      "text": "$\\quad V(t)=220 \\sqrt{2} \\operatorname{Cos}(50 t)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { } \\mathrm{V}_{\\mathrm{rms}}=220 \\quad \\therefore \\mathrm{~V}_0=220 \\sqrt{2} \\\\ & \\therefore \\mathrm{~V}=220 \\sqrt{2} \\cos 100 \\pi \\mathrm{t} \\quad \\omega=2 \\pi \\mathrm{f}=2 \\pi \\times 50=100 \\pi\\end{aligned}$"
  }
}