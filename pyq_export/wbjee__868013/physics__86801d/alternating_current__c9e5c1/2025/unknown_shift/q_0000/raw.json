  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text { } \\mathrm{V}_{\\mathrm{rms}}=220 \\quad \\therefore \\mathrm{~V}_0=220 \\sqrt{2} \\\\ & \\therefore \\mathrm{~V}=220 \\sqrt{2} \\cos 100 \\pi \\mathrm{t} \\quad \\omega=2 \\pi \\mathrm{f}=2 \\pi \\times 50=100 \\pi\\end{aligned}$",
    "image": null
