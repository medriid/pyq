  "question": {
    "text": "For a domestic AC supply of 220 V at 50 cycles per sec, the potential difference between the terminals of a two-pin electric outlet in a room is given by",
    "image": null
  },
  "options": [
    {
      "id": "OLGfJ",
      "text": "$\\quad V(t)=220 \\sqrt{2} \\operatorname{Cos}(100 \\pi t)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "68W2K",
      "text": "$\\quad V(t)=220 \\operatorname{Sin}(50 t)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "pto8S",
      "text": "$\\quad \\mathrm{V}(\\mathrm{t})=220 \\operatorname{Cos}(100 \\pi \\mathrm{t})$",
      "image": null,
