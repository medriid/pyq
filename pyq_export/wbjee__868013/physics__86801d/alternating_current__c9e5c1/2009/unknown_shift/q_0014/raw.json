  "question": {
    "text": "An alternating current of rms value $10 \\mathrm{~A}$ is passed through a $12 \\Omega$ resistor. The maximum potential difference across the resistor is",
    "image": null
  },
  "options": [
    {
      "id": "xTXvK",
      "text": "$20 \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YastO",
      "text": "$90 \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gCpa9",
      "text": "$1969.68 \\mathrm{~V}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ppyIm",
      "text": "none",
      "image": null,
      "isCorrect": false
    }
