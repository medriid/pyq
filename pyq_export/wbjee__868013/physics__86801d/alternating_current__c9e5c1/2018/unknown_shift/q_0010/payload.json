  "question": {
    "text": "An altermating current is flowing through a series $L-C - R$ circuit. It is found that the current reaches a value of $1 \\mathrm{mA}$ at both $200 \\mathrm{Hz}$ and $800 \\mathrm{Hz}$ frequency. What is the resonance frequency of the circuit?"
  },
  "options": [
    {
      "text": "$600 \\mathrm{Hz}$",
      "is_correct": false
    },
    {
      "text": "$300 \\mathrm{Hz}$",
      "is_correct": false
    },
    {
      "text": "$500 \\mathrm{Hz}$",
      "is_correct": false
    },
    {
      "text": "$400 \\mathrm{Hz}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\because$ Resonance frequency, $f_{0}=\\sqrt{f_{1} f_{2}}$\r\n$$\r\n=\\sqrt{200 \\times 800}=400 \\mathrm{Hz}\r\n$$"
  }
}