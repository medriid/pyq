  "question": {
    "text": "At two different places, the angles of dip are respectively $30^{\\circ}$ and $45^{\\circ} .$ At these two places the ratio of horizontal component of earth's magnetic field is",
    "image": null
  },
  "options": [
    {
      "id": "FnCax",
      "text": "$\\sqrt{3}: \\sqrt{2}$",
      "isCorrect": true,
      "image": null
    },
