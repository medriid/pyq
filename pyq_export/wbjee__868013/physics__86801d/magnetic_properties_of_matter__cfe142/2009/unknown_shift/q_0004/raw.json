  "question": {
    "text": "Magnetic field intensity $\\mathrm{H}$ at the centre of a circular loop of radius $\\mathrm{r}$ carrying current $\\mathrm{I}$ e m.u is",
    "image": null
  },
  "options": [
    {
      "id": "r1SDO",
      "text": "r/I oersted",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YlDdb",
      "text": "$2 \\pi \\mathrm{I} / \\mathrm{r}$ oersted",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GEOBk",
      "text": "$\\mathrm{I} / 2 \\pi \\mathrm{r}$ oersted",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zk0On",
      "text": "$2 \\pi \\mathrm{r} / \\mathrm{I}$ oersted",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$H=\\frac{\\mu_0 I}{2 r}=\\frac{\\mu_0}{4 \\pi} \\times \\frac{2 \\pi I}{r}$\nIn e m.u system $\\frac{\\mu_0}{4 \\pi}=1$. So $H=\\frac{2 \\pi I}{r}$",
    "image": null
  },
