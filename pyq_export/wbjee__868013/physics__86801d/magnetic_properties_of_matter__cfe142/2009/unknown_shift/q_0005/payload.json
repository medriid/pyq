  "question": {
    "text": "At a certain place, the horizontal component of earth's magnetic field is $\\sqrt{3}$ times the vertical component. The angle of dip at that place is"
  },
  "options": [
    {
      "text": "$30^{\\circ}$",
      "is_correct": true
    },
    {
      "text": "$60^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$45^{\\circ}$",
      "is_correct": false
    },
    {
      "text": "$90^{\\circ}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\tan \\theta=\\frac{V}{H}=\\frac{1}{\\sqrt{3}} \\Rightarrow \\theta=30^{\\circ}$"
  }
