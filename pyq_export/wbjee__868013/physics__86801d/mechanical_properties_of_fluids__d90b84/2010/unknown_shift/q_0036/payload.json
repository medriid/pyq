  "question": {
    "text": "A uniform long tube is bent into a circle of radius $\\mathrm{R}$ and it lies in vertical plane. Two liquids of same volume but densities $\\rho$ and $\\delta$ fill half the tube. The angle $\\theta$ is\n<img src=\"assets\\qt0036_a48135d651a3.png\"><br>"
  },
  "options": [
    {
      "text": "$\\tan ^{-1}\\left(\\frac{\\rho-\\delta}{\\rho+\\delta}\\right)$",
      "is_correct": true
    },
    {
      "text": "$\\tan ^{-1} \\frac{\\rho}{\\delta}$",
      "is_correct": false
    },
    {
      "text": "$\\tan ^{-1} \\frac{\\delta}{\\rho}$",
      "is_correct": false
    },
    {
      "text": "$\\tan ^{-1}\\left(\\frac{\\rho+\\delta}{\\rho-\\delta}\\right)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$$\n\\begin{aligned}\n& \\text { Hints: } \\delta g R(\\cos \\theta+\\sin \\theta)=\\rho g R(\\cos \\theta-\\sin \\theta) \\\\\n& \\delta \\cos \\theta+\\delta \\sin \\theta=\\rho \\cos \\theta-\\rho \\sin \\theta \\\\\n& \\sin \\theta(\\delta+\\rho)=\\cos \\theta(\\rho-\\delta) \\\\\n& \\tan \\theta=\\frac{\\rho-\\delta}{\\rho+\\delta}\n\\end{aligned}\n$$"
  }
