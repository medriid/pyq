  "question": {
    "text": "A metal plate of area $10^{-2} \\mathrm{~m}^2$ rests on a lauer of castor oil, $2 \\times 10^{-3} \\mathrm{~m}$ thick whose coefficient of viscosity is $1.55 ~Ns~ m^{-2}$. The approximate horizontal force required to move the plate with a uniform speed of $3 \\times 10^{-2} \\mathrm{~ms}^{-1}$ is"
  },
  "options": [
    {
      "text": "0.6718 N",
      "is_correct": false
    },
    {
      "text": "0.2325 N",
      "is_correct": true
    },
    {
      "text": "0.2022 N",
      "is_correct": false
    },
    {
      "text": "0.6615 N",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint: $\\quad F=\\eta \\mathrm{A} \\frac{\\mathrm{v}}{\\mathrm{h}}=1.55 \\times 10^{-2} \\times \\frac{3 \\times 10^{-2}}{2 \\times 10^{-3}}$"
  }
