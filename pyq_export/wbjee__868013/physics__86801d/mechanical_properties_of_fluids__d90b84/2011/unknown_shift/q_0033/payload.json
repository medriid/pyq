  "question": {
    "text": "An object weighs \\(\\mathrm{m}_1\\) in a liquid of density \\(\\mathrm{d}_1\\) and that in liquid of density \\(\\mathrm{d}_2\\) is \\(\\mathrm{m}_2\\). The density \\(d\\) of the object is"
  },
  "options": [
    {
      "text": "\\(\\mathrm{d}=\\frac{\\mathrm{m}_2 \\mathrm{~d}_2-\\mathrm{m}_1 \\mathrm{~d}_1}{\\mathrm{~m}_2-\\mathrm{m}_1}\\)",
      "is_correct": false
    },
    {
      "text": "\\(d=\\frac{\\mathrm{m}_1 \\mathrm{~d}_1-\\mathrm{m}_2 \\mathrm{~d}_2}{\\mathrm{~m}_2-\\mathrm{m}_1}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{d}=\\frac{\\mathrm{m}_2 \\mathrm{~d}_1-\\mathrm{m}_1 \\mathrm{~d}_2}{\\mathrm{~m}_1-\\mathrm{m}_2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{d}=\\frac{\\mathrm{m}_1 \\mathrm{~d}_2-\\mathrm{m}_2 \\mathrm{~d}_1}{\\mathrm{~m}_1-\\mathrm{m}_2}\\)",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hints: \\(V\\left(d-d_1\\right) g=m_1 g\\)\n\\(\\mathrm{V}\\left(\\mathrm{d}-\\mathrm{d}_2\\right) \\mathrm{g}=\\mathrm{m}_2 \\mathrm{~g}\\)\n\\(\\frac{\\mathrm{d}-\\mathrm{d}_1}{\\mathrm{~d}-\\mathrm{d}_2}=\\frac{\\mathrm{m}_1}{\\mathrm{~m}_2} \\quad \\therefore \\mathrm{d}=\\frac{\\mathrm{m}_1 \\mathrm{~d}_2-\\mathrm{m}_2 \\mathrm{~d}_1}{\\mathrm{~m}_1-\\mathrm{m}_2}\\)"
  }
}