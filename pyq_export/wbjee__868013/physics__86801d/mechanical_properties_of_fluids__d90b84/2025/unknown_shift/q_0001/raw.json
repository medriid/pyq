  "question": {
    "text": "Three different liquids are filled in a U-tube as shown in figure. Their densities are $\\rho_1, \\rho_2$ and $\\rho_3$ respectively. From the figure we may conclude that\n\n<img width=\"250px\" src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/AZVknGV0vr-AVE-_8ZF7NjMoPmECC0PgOQ_0gZ55JYg.original.fullsize.png\"/><br/>",
    "image": null
  },
  "options": [
    {
      "id": "yElRo",
      "text": "$\\rho_3=4\\left(\\rho_2-\\rho_1\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SUuZD",
      "text": "$\\rho_3=4\\left(\\rho_1-\\rho_2\\right)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kGfoq",
      "text": "$\\rho_3=2\\left(\\rho_2-\\rho_1\\right)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "MRoB3",
      "text": "$\\quad \\rho_3=\\frac{\\rho_1+\\rho_2}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$h \\rho_1+\\frac{h}{2} \\rho_3=h \\rho_2, \\rho_1+\\frac{\\rho_3}{2}=\\rho_2 \\quad \\quad \\rho_3=2\\left(\\rho_2-\\rho_1\\right)$",
    "image": null
