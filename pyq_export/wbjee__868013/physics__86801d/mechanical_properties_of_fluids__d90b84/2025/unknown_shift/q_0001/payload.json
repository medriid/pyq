  "question": {
    "text": "Three different liquids are filled in a U-tube as shown in figure. Their densities are $\\rho_1, \\rho_2$ and $\\rho_3$ respectively. From the figure we may conclude that\n\n<img width=\"250px\" src=\"assets\\qt0001_0fd4cb51088d.png\"/><br/>"
  },
  "options": [
    {
      "text": "$\\rho_3=4\\left(\\rho_2-\\rho_1\\right)$",
      "is_correct": false
    },
    {
      "text": "$\\rho_3=4\\left(\\rho_1-\\rho_2\\right)$",
      "is_correct": false
    },
    {
      "text": "$\\rho_3=2\\left(\\rho_2-\\rho_1\\right)$",
      "is_correct": true
    },
    {
      "text": "$\\quad \\rho_3=\\frac{\\rho_1+\\rho_2}{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$h \\rho_1+\\frac{h}{2} \\rho_3=h \\rho_2, \\rho_1+\\frac{\\rho_3}{2}=\\rho_2 \\quad \\quad \\rho_3=2\\left(\\rho_2-\\rho_1\\right)$"
  }
