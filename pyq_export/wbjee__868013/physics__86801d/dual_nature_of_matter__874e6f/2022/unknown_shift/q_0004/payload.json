      "text": "$\\varepsilon_1>\\varepsilon_3>\\varepsilon_2$",
      "is_correct": true
    },
    {
      "text": "$\\varepsilon_1=\\varepsilon_2=\\varepsilon_2$",
      "is_correct": false
    },
    {
      "text": "$\\varepsilon_1 < \\varepsilon_3 < \\varepsilon_2$",
      "is_correct": false
    },
    {
      "text": "$\\varepsilon_1>\\varepsilon_2>\\varepsilon_3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\lambda=\\frac{\\mathrm{h}}{\\sqrt{2 \\mathrm{mk}}}, \\sqrt{\\mathrm{mk}}=\\mathrm{const}$\n$\\mathrm{k} \\propto \\frac{1}{\\mathrm{~m}}, \\varepsilon_1>\\varepsilon_3>\\varepsilon_2$"
  }
