  "question": {
    "text": "$10^{20}$ photons of wavelength 660 nm are emitted per second from a lamp. The wattage of the lamp is (Planck's constant $\\left.=6.6 \\times 10^{-34} \\mathrm{Js}\\right)$"
  },
  "options": [
    {
      "text": "30W",
      "is_correct": true
    },
    {
      "text": "60W",
      "is_correct": false
    },
    {
      "text": "100W",
      "is_correct": false
    },
    {
      "text": "500W",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$P=N\\left(\\frac{h c}{\\lambda}\\right)$\n$\\mathrm{P}=10^{20} \\times \\frac{6.6 \\times 10^{-34} \\times 3 \\times 10^8}{660 \\times 10^{-9}}=30 \\mathrm{~W}$"
  }
