      "text": "photo-electric current will decrease",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "IWs7f",
      "text": "Maximum kinetic energy if photo-electrons will decrease",
      "isCorrect": false,
      "image": null
    },
    {
