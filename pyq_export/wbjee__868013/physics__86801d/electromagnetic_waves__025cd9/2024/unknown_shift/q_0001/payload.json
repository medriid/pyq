  "question": {
    "text": "Longitudinal waves cannot"
  },
  "options": [
    {
      "text": "have a unique wave length",
      "is_correct": false
    },
    {
      "text": "have a unique wave velocity",
      "is_correct": false
    },
    {
      "text": "transmit energy",
      "is_correct": false
    },
