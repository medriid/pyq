  "question": {
    "text": "The electric field of a plane electromagnetic wave of wave number \\(k\\) and angular frequency \\(\\omega\\) is given by \\(\\vec{E}=E_0(\\hat{i}+\\hat{j}) \\sin (k z-\\omega t)\\). Which of the following gives the direction of the associated magnetic field \\(\\vec{B}\\) ?"
  },
  "options": [
    {
      "text": "\\(\\hat{k}\\)",
      "is_correct": false
    },
    {
      "text": "\\(-\\hat{i}+\\hat{j}\\)",
      "is_correct": true
    },
    {
      "text": "\\(-\\hat{i}-\\hat{j}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\hat{\\mathrm{i}}-\\hat{\\mathrm{k}}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint: \\(\\vec{E} \\cdot \\vec{B}=0\\) and in the plane of \\(X Y\\)"
