    },
    {
      "text": "$E_{\\gamma}>E_{y}>E_{x}$",
      "is_correct": false
    },
    {
      "text": "$E_{\\gamma}>E_{x}>E_{v}$",
      "is_correct": true
    },
    {
      "text": "$E_{x}>E_{\\gamma}>E_{y}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
