  "question": {
    "text": "In the circuit shown, inputs $A$ and $B$ are in states 1 and 0 respectively. What is the only possible stable state of the outputs $X$ and $Y ?$\r\n<img src=\"assets\\qt0015_dd7d0b99e4fe.png\">"
  },
  "options": [
    {
      "text": "$X=1, Y=1$",
      "is_correct": false
    },
    {
      "text": "$X=1, Y=0$",
      "is_correct": false
    },
    {
      "text": "$X=0, Y=1$",
      "is_correct": true
    },
    {
      "text": "$X=0, Y=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0015_baa33ba9ba2e.png\">\r\n\r\n$X=\\overline{A Y}=\\bar{Y}=0$\r\n$\\therefore$\r\n$$\r\nY=\\overline{B X}=1\r\n$$"
  }
