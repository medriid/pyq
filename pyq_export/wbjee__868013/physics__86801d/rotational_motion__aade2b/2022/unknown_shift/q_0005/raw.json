    },
    {
      "id": "jCfKs",
      "text": "$\\frac{5}{4} \\mathrm{ma}^2$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/GwLG36TkLPUkUWkYSuhZnrmH2VnSgOGUFPGGvgCpPZk.original.fullsize.png\"><br>\n$\\mathrm{I}=\\mathrm{~ma}^2+\\mathrm{m}\\left(\\mathrm{a} \\cos 60^{\\circ}\\right)^2=m \\mathrm{a}^2+\\frac{\\mathrm{ma}^2}{4}=\\frac{5 \\mathrm{ma}^2}{4}$",
