  "question": {
    "text": "A uniform thin rod of length $L$, mass $m$ is lying on a smooth horizontal table. A horizontal impulse $P$ is suddenly applied perpendicular to the rod at one end. The total energy of the rod after the impulse is",
    "image": null
  },
  "options": [
    {
      "id": "uJfpi",
      "text": "$\\frac{\\mathrm{P}^{2}}{\\mathrm{M}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "vvuSl",
      "text": "$\\frac{7 \\mathrm{P}^{2}}{8 \\mathrm{M}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "B6gwF",
      "text": "$\\frac{13 \\mathrm{P}^{2}}{2 \\mathrm{M}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "2ebrY",
      "text": "$\\frac{2 P^{2}}{M}$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/WS9WFkG-BtGi3MlQoa9YXZHufnsDFUZ1hIq6U4L0JoQ.original.fullsize.png\">\r\n$\\mathrm{P}=(\\mathrm{mv}-0)$\r\nangular impulse $\\mathrm{J}=\\mathrm{P} \\times \\frac{\\mathrm{L}}{2}=\\mathrm{L}_{\\mathrm{f}}-0$\r\n$\\mathrm{LE}_{\\mathrm{f}}=\\frac{\\mathrm{PL}}{2}$\r\n$=\\frac{\\mathrm{K}_{\\mathrm{r}}}{2 \\mathrm{~m}}+\\mathrm{K}_{\\mathrm{t}}=\\frac{\\mathrm{P}^{2}}{2 \\mathrm{~m}}+\\frac{\\mathrm{L}_{\\mathrm{f}}^{2}}{2 \\mathrm{I}}$\r\n$=\\frac{(\\mathrm{PL} / 2)^{2}}{2 \\times \\frac{\\mathrm{mL}^{2}}{12}}$\r\n$=\\frac{\\mathrm{P}^{2}}{2 \\mathrm{~m}}+\\frac{\\mathrm{P}^{2} \\mathrm{~L}^{2}}{4 \\times \\frac{\\mathrm{mL}^{2}}{6}}=\\frac{\\mathrm{P}}{2 \\mathrm{~m}}+\\frac{3 \\mathrm{P}^{2}}{2 \\mathrm{~m}}=\\frac{2 \\mathrm{P}^{2}}{\\mathrm{~m}}$",
    "image": null
  },
