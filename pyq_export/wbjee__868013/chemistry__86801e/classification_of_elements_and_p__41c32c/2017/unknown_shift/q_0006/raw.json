  "question": {
    "text": "Among $\\mathrm{Me}_{3}\\mathrm{N}, \\mathrm{C}_{5} \\mathrm{H}_{5} \\mathrm{N}$ and MeCN\r\n(Me $=$ methyl group) the electronegativity of $\\mathrm{N}$ is in the order",
    "image": null
  },
  "options": [
    {
      "id": "JLcRS",
      "text": "$\\mathrm{MeCN}>\\mathrm{C}_{\\mathrm{g}} \\mathrm{H}_{\\mathrm{s}} \\mathrm{N}>\\mathrm{Me}_{3} \\mathrm{N}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "DgAE4",
      "text": "$\\mathrm{C}_{3} \\mathrm{H}_{5} \\mathrm{N}>\\mathrm{Me}_{3} \\mathrm{N}>\\mathrm{MeCN}$",
