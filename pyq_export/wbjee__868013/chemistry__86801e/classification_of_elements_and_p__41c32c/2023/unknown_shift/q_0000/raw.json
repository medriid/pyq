  "question": {
    "text": "Suppose a gaseous mixture of \\(\\mathrm{He}, \\mathrm{Ne}, \\mathrm{Ar}\\) and \\(\\mathrm{Kr}\\) is treated with photons of the frequency appropriate to ionize Ar. What ion(s) will be present in the mixture?",
    "image": null
  },
  "options": [
    {
      "id": "Hat8l",
      "text": "\\(\\mathrm{Ar}^{+}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wHKWM",
      "text": "\\(\\mathrm{Ar}^{+}+\\mathrm{Kr}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BAkRU",
      "text": "\\(\\mathrm{Ar}^{+}+\\mathrm{He}^{+}+\\mathrm{Ne}^{+}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Pibz4",
      "text": "\\(\\mathrm{He}^{+}+\\mathrm{Ar}^{+}+\\mathrm{Kr}^{+}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hint: \\(\\mathrm{He} > \\mathrm{Ne} > \\mathrm{Ar} > \\mathrm{Kr} > \\mathrm{Xe} > \\mathrm{Rn}\\) (Order of lonization energy)\nEnergy of photon is sufficient to ionize \\(\\mathrm{Ar}\\), hence \\(\\mathrm{Kr}\\) will also ionize.\nTherefore mixture contains \\(\\mathrm{Ar}^{+}\\)and \\(\\mathrm{Kr}^{+}\\)",
    "image": null
  },
