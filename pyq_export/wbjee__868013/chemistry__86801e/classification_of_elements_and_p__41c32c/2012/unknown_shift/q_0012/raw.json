  "question": {
    "text": "The stable bivalency of $\\mathrm{Pb}$ and trivalency of $\\mathrm{Bi}$ is",
    "image": null
  },
  "options": [
    {
      "id": "tSihc",
      "text": "due to $d$ contraction in $\\mathrm{Pb}$ and $\\mathrm{Bi}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "IHuGX",
      "text": "due to relativistic contraction of the $6 s$ orbitals of $\\mathrm{Pb}$ and $\\mathrm{Bi}$, leading to inert pair effect",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "ceVN2",
      "text": "due to screening effect",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ejemC",
      "text": "due to attainment of noble liquid configuration",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$_{82} \\mathrm{Pb}=6 \\mathrm{s}^{2} 6 p^{2}$\r\n$_{83}{\\mathrm{Bi}}=6 s^{2} 6 p^{3}$\r\nDue to inertness of $6 s^{2}$ electrons in $\\mathrm{Pb}$ and $\\mathrm{Bi}$, they show bivalency and trivalency respectively instead of tetra and pentavalency.",
