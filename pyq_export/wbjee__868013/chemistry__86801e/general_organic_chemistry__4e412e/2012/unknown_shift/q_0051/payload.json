  "question": {
    "text": "The basicity of aniline is weaker in comparison to that of methyl amine due to"
  },
  "options": [
    {
      "text": "hyperconjugative effect of Me-group in $\\mathrm{MeNH}_{2}$",
      "is_correct": false
    },
    {
      "text": "resonance effect of phenyl group in aniline",
      "is_correct": true
    },
    {
      "text": "lower molecular weight of methyl amine as compared to that of aniline",
      "is_correct": false
    },
    {
      "text": "resonance effect of $-\\mathrm{NH}_{2}$ group in $\\mathrm{MeNH}_{2}$",
      "is_correct": false
