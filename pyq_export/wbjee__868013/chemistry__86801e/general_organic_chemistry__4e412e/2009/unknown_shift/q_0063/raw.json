  "question": {
    "text": "A compound is formed by substitution of two chlorine for two hydrogens in propane. The number of possible isomeric compounds is",
    "image": null
  },
  "options": [
    {
      "id": "SAS0H",
      "text": "$4$",
      "image": null,
      "isCorrect": false
    },
    {
