  "question": {
    "text": "The compound that would produce a nauseating smell/odour with a hot mixture of chloroform and ethanolic potassium hydroxide is",
    "image": null
  },
  "options": [
    {
      "id": "yzbP3",
      "text": "PhCONH $_{2}$",
      "isCorrect": false,
      "image": null
    },
    {
