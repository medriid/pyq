  "question": {
    "text": "A compound formed by elements $X$ and $Y$ crystallises in the cubic structure, where $X$ atoms are at the corners of a cube and $Y$ atoms are at the centre of the body. The formula of the compounds is",
    "image": null
  },
  "options": [
    {
      "id": "rJBlo",
      "text": "$XY$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "6NXSE",
      "text": "$XY_{2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "KCwEc",
      "text": "$X_{2} Y_{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "rNtCg",
      "text": "$X Y_{3}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Number of $X$ atoms at the corners $=8$ Number of $X$ atoms per unit cell $=8 \\times \\frac{1}{8}=1$ atom Number of $Y$ atoms at the centre of the body $=1$ atom Hence, the formula of the compound is $X Y$.",
    "image": null
