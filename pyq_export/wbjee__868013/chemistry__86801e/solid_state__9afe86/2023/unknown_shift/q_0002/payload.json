  "question": {
    "text": "What is the edge length of the unit cell of a body centred cubic crystal of an element whose atomic radius is \\(75 \\mathrm{pm}\\) ?"
  },
  "options": [
    {
      "text": "\\(170 \\mathrm{pm}\\)",
      "is_correct": false
    },
    {
      "text": "\\(175 \\mathrm{pm}\\)",
      "is_correct": false
    },
    {
      "text": "\\(178 \\mathrm{pm}\\)",
      "is_correct": false
    },
    {
      "text": "\\(173.2 \\mathrm{pm}\\)",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Hint : In BCC, \\(4 r=\\sqrt{3} a\\)\n\\(\\therefore \\mathrm{a}=\\frac{4 \\mathrm{r}}{\\sqrt{3}}=\\frac{4 \\times 75}{\\sqrt{3}}=\\frac{300}{\\sqrt{3}}=\\sqrt{3} \\times 100 \\mathrm{pm}=173.2 \\mathrm{pm}\\)"
  }
