  "question": {
    "text": "If three elements $A, B, C$ crystalise in a cubic solid lattice with $B$ atoms at the cubic centres, $C$ atoms at the centre of edges and $A$ atoms at the corners, then formula of the compound is",
    "image": null
  },
  "options": [
    {
      "id": "ls8kg",
      "text": "$\\mathrm{AB}_3 \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "psFDv",
      "text": "$\\mathrm{A}_3 \\mathrm{BC}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aiFGM",
      "text": "$\\mathrm{ABC}_3$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ueAP8",
      "text": "ABC",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Number of A atoms $=\\frac{1}{8} \\times 8=1$\nNumber of $C$ atoms $=\\frac{1}{4} \\times 12=3$\nNumber of B atom = 1\nHence $\\mathrm{ABC}_3$",
    "image": null
  },
