  "question": {
    "text": "The white precipitate $(Y)$, obtained on passing colourless and odourless gas $(X)$ through an ammoniacal solution of $\\mathrm{NaCl}$, loses about $37 \\%$ of its weight on heating and a white residue $(\\mathrm{Z})$ of basic nature is left. Identify $(\\mathrm{X}),(\\mathrm{Y})$ and $(\\mathrm{Z})$ from following sets."
  },
  "options": [
    {
      "text": "$$\\mathrm{N}_{2} \\left(\\mathrm{NH}_{4}\\right)_{2} \\mathrm{CO}_{3} \\mathrm{NH}_{4} \\mathrm{Cl}\r\n$$",
      "is_correct": false
    },
    {
      "text": "$$\\mathrm{O}_{2} \\mathrm{NaNH}_{4} \\mathrm{CO}_{3} \\mathrm{NaHCO}_{3}\r\n$$",
      "is_correct": false
    },
    {
      "text": "$$\\mathrm{CO}_{2} \\mathrm{NH}_{4} \\mathrm{HCO}_{3} \\left(\\mathrm{NH}_{4}\\right)_{2} \\mathrm{CO}_{3}\r\n$$",
      "is_correct": false
    },
    {
      "text": "$$\\mathrm{CO}_{2} \\mathrm{NaHCO}_{3} \\mathrm{Na}_{2} \\mathrm{CO}_{3}\r\n$$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{array}{c}\r\n\\mathrm{NH}_{3}+\\underset{(\\mathrm{x})}{\\mathrm{CO}_{2}+\\mathrm{H}_{2} \\mathrm{O} \\longrightarrow} \\longrightarrow \\mathrm{NH}_{4} \\mathrm{HCO}_{3} \\\\\r\n\\mathrm{NH}_{4} \\mathrm{HCO}_{3}+\\mathrm{NaCl} \\longrightarrow \\mathrm{NaHCO}_{3} \\downarrow+\\mathrm{NH}_{4} \\mathrm{Cl} \\\\\r\n2 \\mathrm{NaHCO}_{3} \\stackrel{\\Delta}{\\longrightarrow} \\underset{(\\mathrm{y})}{\\mathrm{Na}_{2} \\mathrm{CO}_{3}+\\mathrm{CO}_{2}+\\mathrm{H}_{2} \\mathrm{O}} \\\\\r\n{(\\mathrm{z})}\r\n\\end{array}$"
  }
