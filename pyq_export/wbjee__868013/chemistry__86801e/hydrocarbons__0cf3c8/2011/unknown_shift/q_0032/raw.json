  "question": {
    "text": "The ease of dehydrohalogenation of alkyl halide with alcoholic \\(\\mathrm{KOH}\\) is",
    "image": null
  },
  "options": [
    {
      "id": "h8MFh",
      "text": "\\(3^{\\circ}  < 2^{\\circ} < 1^{\\circ}\\)",
