  "question": {
    "text": "The correct order of boiling point of the given aqueous solution is",
    "image": null
  },
  "options": [
    {
      "id": "nFYIY",
      "text": "\\(1 \\mathrm{~N} \\mathrm{KNO}_3>1 \\mathrm{~N} \\mathrm{NaCl} >1 \\mathrm{~N} \\mathrm{CH}_3 \\mathrm{COOH} >1 \\mathrm{~N} \\text { sucrose }\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2RFpM",
      "text": "\\(1 \\mathrm{~N} \\mathrm{KNO}_3=1 \\mathrm{~N} \\mathrm{NaCl} >1 \\mathrm{~N} \\mathrm{CH}_3 \\mathrm{COOH} >1 \\mathrm{~N} \\text { sucrose }\\)",
      "image": null,
