  "level": 1,
  "question": {
    "text": "When $20 \\mathrm{~g}$ of naphthoic acid $\\left(\\mathrm{C}_{11} \\mathrm{H}_{8} \\mathrm{O}_{2}\\right)$ is dissolved in $50 \\mathrm{~g}$ of benzene, a freezing point depression of $2 \\mathrm{~K}$ is observed. The vant Hoff factor (i) is $\\left[\\mathrm{K}_{\\mathrm{f}}=1.72^{\\circ} \\mathrm{K} \\mathrm{kg} \\mathrm{mol}^{-1}\\right]$",
    "image": null
  },
  "options": [
    {
      "id": "rznjj",
      "text": "$0.5$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "qjOZP",
      "text": "$1.0$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "fYgsp",
      "text": "$2.0$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "VQGfa",
      "text": "$3.0$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{array}{l}\r\n\\Delta \\mathrm{T}_{\\mathrm{f}}=\\mathrm{i} \\mathrm{K}_{\\mathrm{f}} \\mathrm{m} \\\\\r\n2=\\mathrm{i} \\times 1.72 \\times \\frac{20 \\times 1000}{172 \\times 50} \\\\\r\n\\therefore \\mathrm{i}=\\frac{2}{0.01 \\times 2 \\times 200}=\\frac{1}{2}=0.5\r\n\\end{array}$",
    "image": null
  },
