  "question": {
    "text": "The charge carried by 1 millimole of $M^{n+}$ ions is 193 coulombs. The value of $n$ is",
    "image": null
  },
  "options": [
    {
      "id": "qfuZX",
      "text": "1",
      "isCorrect": false,
      "image": null
    },
    {
