  "question": {
    "text": "$1 \\times 10^{-3}$ mole of $\\mathrm{HCl}$ is added to a buffer solution made up of $0.01 \\mathrm{M}$ acetic acid and 0.01 M sodium acetate. The final pH of the buffer will be (given, $\\mathrm{p} K_{a}$ of acetic acid is 4.75 at $\\left.25^{\\circ} \\mathrm{C}\\right)$"
  },
  "options": [
    {
      "text": "4.6",
      "is_correct": false
    },
    {
      "text": "4.66",
      "is_correct": true
    },
    {
      "text": "4.75",
      "is_correct": false
    },
    {
      "text": "4.8",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{CH}_{3} \\mathrm{COO}^{-}+\\mathrm{H}^{+} \\longrightarrow \\mathrm{CH}_{3} \\mathrm{COOH}$\r\n$$\r\n\\begin{aligned}\r\n\\mathrm{pH}=& \\mathrm{pK}_{a}+\\log \\frac{(\\text { salt })}{(\\text { acid })}=4.75+\\log \\frac{0.009}{0.011} \\\\\r\n&=4.66\r\n\\end{aligned}\r\n$$"
  }
}