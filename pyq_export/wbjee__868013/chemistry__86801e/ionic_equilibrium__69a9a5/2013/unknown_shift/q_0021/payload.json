  "question": {
    "text": "At $25^{\\circ} \\mathrm{C}, \\mathrm{pH}$ of a $10^{-8} \\mathrm{M}$ aqueous $\\mathrm{KOH}$\r\nsolution will be"
  },
  "options": [
    {
      "text": "6",
      "is_correct": false
    },
    {
      "text": "7.02",
      "is_correct": true
    },
