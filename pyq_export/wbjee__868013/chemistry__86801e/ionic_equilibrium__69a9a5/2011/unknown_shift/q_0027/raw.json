  "question": {
    "text": "The solubility of \\(\\mathrm{Ca}_3\\left(\\mathrm{PO}_4\\right)_2\\) in water is y moles / litre. Its solubility product is",
    "image": null
  },
  "options": [
    {
      "id": "ZLo0A",
      "text": "\\(6 y^4\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KUOkM",
      "text": "\\(36 y^4\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tAyMP",
      "text": "\\(64 y^5\\)",
      "image": null,
      "isCorrect": false
    },
    {
