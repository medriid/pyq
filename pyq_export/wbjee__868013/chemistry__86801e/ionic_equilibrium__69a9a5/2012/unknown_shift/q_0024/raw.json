  "type": "singleCorrect",
  "level": 3,
  "question": {
    "text": "$20 \\mathrm{mL~} 0 .1$ (N) acetic acid is mixed with $10 \\mathrm{mL}$ $0.1(\\mathrm{N})$ solution of NaOH. The pH of the resulting solution is $\\left(p K_{a}\\right.$ of acetic acid is $\\left.4.74\\right)$",
    "image": null
  },
  "options": [
    {
      "id": "uvEcA",
      "text": "3.74",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "PdtSO",
