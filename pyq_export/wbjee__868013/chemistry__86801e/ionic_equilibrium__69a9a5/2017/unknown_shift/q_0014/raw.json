  "question": {
    "text": "Dissolving NaCN in de-ionised water will result in a solution having",
    "image": null
  },
  "options": [
    {
      "id": "hycEi",
      "text": "$\\mathrm{pH}    < 7$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "550Mp",
      "text": "$\\mathrm{pH}=7$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "E6J2A",
      "text": "$\\mathrm{pOH}=7$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "joy6Q",
      "text": "$\\mathrm{pH}>7$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\because$ On dissolving NaCN in de-ionised water, following reaction takes place.\r\n$\\mathrm{CN}^{-}+\\mathrm{H}_{2} \\mathrm{O} \\rightleftharpoons \\mathrm{HCN}+\\mathrm{OH}^{-}$\r\nCN- ions come from the salt of strong base and weak acid.\r\n$\\therefore$ The solution becomes basic and $\\mathrm{pH}>7$",
    "image": null
  },
