  "question": {
    "text": "If the equilibrium constants of the following equilibria\n\\(\\mathrm{SO}_2+\\frac{1}{2} \\mathrm{O}_2 \\rightleftharpoons \\mathrm{SO}_3 \\text { and } 2 \\mathrm{SO}_3 \\rightleftharpoons 2 \\mathrm{SO}_2+\\mathrm{O}_2\\)\nare given by \\(\\mathrm{K}_1\\) and \\(\\mathrm{K}_2\\) respectively, which of the following relations is correct",
    "image": null
  },
  "options": [
    {
      "id": "2rDcp",
      "text": "\\(\\mathrm{K}_2=\\left(\\frac{1}{\\mathrm{~K}_1}\\right)^2\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "4osmk",
      "text": "\\(K_1=\\left(\\frac{1}{K_2}\\right)^3\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "z8Emm",
      "text": "\\(K_2=\\left(\\frac{1}{K_1}\\right)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bM1o1",
      "text": "\\(K_2=\\left(K_1\\right)^2\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hints: \\(\\mathrm{K}_1=\\frac{\\left[\\mathrm{SO}_3\\right]}{\\left[\\mathrm{SO}_2\\right]\\left[\\mathrm{O}_2\\right]^{1 / 2}}\\)\n\\(\\mathrm{K}_2=\\frac{\\left[\\mathrm{SO}_2\\right]^2\\left[\\mathrm{O}_2\\right]}{\\left[\\mathrm{SO}_3\\right]^2}\\)\nThus \\(\\mathrm{K}_2=\\left(\\frac{1}{\\mathrm{~K}_1}\\right)^2\\)",
    "image": null
  },
