  "question": {
    "text": "For the reaction $S O_2+\\frac{1}{2} O_2=S O_3$, if we write $K_p=K_c(R T)^x$, then $\\mathrm{x}$ becomes"
  },
  "options": [
    {
      "text": "$-1$",
      "is_correct": false
    },
    {
      "text": "$-\\frac{1}{2}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$1$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\text { } \\mathrm{K}_{\\mathrm{p}}=\\mathrm{K}_{\\mathrm{C}}(\\mathrm{RT})^x \\\\ & x=\\left(\\sum \\mathrm{n}_{(\\mathrm{g})}\\right)_{\\mathrm{P}}-\\left(\\sum \\mathrm{n}_{(\\mathrm{g})}\\right)_{\\mathrm{R}} \\\\ & =1-\\frac{3}{2}=-\\frac{1}{2}\\end{aligned}$"
  }
}