  "question": {
    "text": "The reactive species in chlorine bleach is",
    "image": null
  },
  "options": [
    {
      "id": "dja2b",
      "text": "$\\mathrm{Cl}_{2} \\mathrm{O}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Pv3Nj",
      "text": "$\\mathrm{OCl}^{-}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "FBTMv",
      "text": "$\\mathrm{Cl} \\mathrm{O}_{2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "I9hzj",
      "text": "$\\mathrm{HCl}$",
      "isCorrect": false,
      "image": null
