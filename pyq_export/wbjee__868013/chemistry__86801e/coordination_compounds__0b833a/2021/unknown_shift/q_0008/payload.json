      "is_correct": true
    },
    {
      "text": "Zinc",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{array}{l}\r\n\\mathrm{Co}\\left(\\mathrm{NO}_{3}\\right)_{3}+\\mathrm{NaNO}_{2} \\longrightarrow \\mathrm{Na}_{3}\\left[\\mathrm{Co}\\left(\\mathrm{NO}_{2}\\right)_{6}\\right] \\\\\r\n\\mathrm{Na}_{3}\\left[\\mathrm{Co}\\left(\\mathrm{NO}_{3}\\right)_{6}\\right]+\\mathrm{K}^{+} \\longrightarrow \\mathrm{K}_{3}\\left[\\mathrm{Co}\\left(\\mathrm{NO}_{2}\\right)_{6}\\right] \\downarrow \\text { yellow ppt }\r\n\\end{array}$"
  }
