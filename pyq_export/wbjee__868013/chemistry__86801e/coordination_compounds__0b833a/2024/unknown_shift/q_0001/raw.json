  "question": {
    "text": "Which of the following ion/ions is/are diamagnetic?",
    "image": null
  },
  "options": [
    {
      "id": "SnDNx",
      "text": "$\\left[\\mathrm{CoF}_6\\right]^{3-}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wyzSX",
      "text": "$\\left[\\mathrm{Co}\\left(\\mathrm{NH}_3\\right]_6\\right]^{3+}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "3bRHr",
      "text": "$\\left[\\mathrm{Fe}\\left(\\mathrm{OH}_2\\right)_6\\right]^{2+}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2rAq2",
      "text": "$\\left[\\mathrm{Fe}(\\mathrm{CN})_6\\right]^4$",
      "image": null,
      "isCorrect": true
