  "question": {
    "text": "Let $\\left(\\mathrm{C}_{\\mathrm{rms}}\\right)_{\\mathrm{H}_2}$ is the r.m.s speed of $\\mathrm{H}_2$ at $150 \\mathrm{~K}$. At what temperature, the most probable speed of helium $\\left[\\left(\\mathrm{C}_{\\mathrm{mp}}\\right)_{\\mathrm{He}}\\right]$ will be half of $\\left(\\mathrm{C}_{\\mathrm{rms}}\\right)_{\\mathrm{H}_2}$ ?",
    "image": null
  },
  "options": [
    {
      "id": "2USNM",
      "text": "$75 \\mathrm{~K}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bpsj2",
      "text": "$112.5 \\mathrm{~K}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "QUNhE",
      "text": "$225 \\mathrm{~K}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mLdXF",
      "text": "$900 \\mathrm{~K}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$C_{\\mathrm{rms}}=\\sqrt{\\frac{3 R T}{M}} \\quad C_{m p}=\\sqrt{\\frac{2 R T}{M}}$\nAs per question $\\frac{1}{2} \\sqrt{\\frac{3 \\times R \\times 150}{2}}=\\sqrt{\\frac{2 R T}{4}}$ $\\mathrm{T}=112.5 \\mathrm{~K}$",
    "image": null
  },
