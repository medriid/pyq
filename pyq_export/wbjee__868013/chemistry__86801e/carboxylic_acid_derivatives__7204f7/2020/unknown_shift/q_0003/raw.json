  "question": {
    "text": "The correct order of acidity for the following compounds is:\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/1DrY3lejnslvrZAYEUkuGH8nQL-Bo1FeqLTr8Xst7K8.original.fullsize.png\">",
    "image": null
  },
  "options": [
    {
      "id": "adytA",
      "text": "$II    < I V < I < I$",
      "isCorrect": false,
      "image": null
    },
