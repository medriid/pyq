  "question": {
    "text": "The correct basicity order of the following lanthanide ions is",
    "image": null
  },
  "options": [
    {
      "id": "82aCR",
      "text": "$\\mathrm{La}^{3+}>\\mathrm{Lu}^{3 +}>\\mathrm{Ce}^{3+}>\\mathrm{Eu}^{3+}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "azWpY",
      "text": "$\\mathrm{Ce}^{3}>\\mathrm{Lu}^{3+}>\\mathrm{La}^{3+} > \\mathrm{Eu}^{3 \\mathrm{e}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "qg1ik",
      "text": "$\\mathrm{Lu}^{3 \\cdot}>\\mathrm{Ce}^{3}>\\mathrm{Eu}^{3+}>\\mathrm{La}^{3+}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "YxX73",
      "text": "$\\mathrm{La}^{3+}>\\mathrm{Ce}^{3+}>\\mathrm{Eu}^{3+}>\\mathrm{Lu}^{3}$",
      "isCorrect": true,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "As size of cation decreases, ionic character decreases, thus basicity also decreases Hence, correct order is $\\mathrm{La}^{3+}>\\mathrm{Ce}^{3+}>\\mathrm{Eu}^{3+}>\\mathrm{Lu}^{3+}$",
    "image": null
  },
