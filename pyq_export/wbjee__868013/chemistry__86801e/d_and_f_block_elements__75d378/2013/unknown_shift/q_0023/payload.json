  "question": {
    "text": "The orange solid on heating gives a colourless gas and a green solid which can be reduced to metal by aluminium powder. The orange and the green solids are, respectively"
  },
  "options": [
    {
      "text": "$\\mathrm{NH}_{4} \\mathrm{Cr}_{2} \\mathrm{O}_{7}$ and $\\mathrm{Cr}_{2} \\mathrm{O}_{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Na}_{2} \\mathrm{Cr}_{2} \\mathrm{O}_{7}$ and $\\mathrm{Cr}_{2} \\mathrm{O}_{3}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{K}_{2} \\mathrm{Cr}_{2} \\mathrm{O}_{7}$ and $\\mathrm{CrO}_{3}$",
      "is_correct": false
    },
    {
      "text": "$\\left(\\mathrm{NH}_{4}\\right)_{2} \\mathrm{CrO}_{4}$ and $\\mathrm{CrO}_{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Orange solid is ammonium dichromate.\r\n$\\left(\\mathrm{NH}_{4}\\right)_{2} \\mathrm{Cr}_{2} \\mathrm{O}_{7} \\stackrel{\\Delta}{\\longrightarrow} \\mathrm{N}_{2} \\uparrow+\\mathrm{Cr}_{2} \\mathrm{O}_{3}+4 \\mathrm{H}_{2} \\mathrm{O}$\r\n$$\r\n\\mathrm{Cr}_{2} \\mathrm{O}_{3}+2 \\mathrm{Al} \\longrightarrow 2 \\mathrm{Cr}+\\mathrm{Al}_{2} \\mathrm{O}_{3}\r\n$$"
  }
