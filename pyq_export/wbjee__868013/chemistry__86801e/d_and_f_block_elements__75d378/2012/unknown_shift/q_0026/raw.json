  "question": {
    "text": "The equivalent weight of $\\mathrm{K}_{2} \\mathrm{Cr}_{2} \\mathrm{O}_{7}$ in acidic medium is expressed in terms of its molecular weight (M) as",
    "image": null
  },
  "options": [
