  "question": {
    "text": "In the reaction of sodium thiosulphate with $\\mathrm{I}_2$ in aqueous medium the equivalent weight of sodium thiosulphate is equal to"
  },
  "options": [
    {
      "text": "molar mass of sodium thiosulphate",
      "is_correct": true
    },
    {
      "text": "the average of molr masses of $\\mathrm{Na}_2 \\mathrm{~S}_2 \\mathrm{O}_3$ and $\\mathrm{I}_2$",
      "is_correct": false
    },
    {
      "text": "half the molar mass of sodium thiosulphate",
      "is_correct": false
    },
    {
      "text": "molar mass of sodium thiosulphate $\\times 2$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{gathered}\n\\text {Hints : } 2 \\mathrm{Na}_2 \\stackrel{+2}{\\mathrm{~S}_2} \\mathrm{O}_3+\\mathrm{I}_2 \\longrightarrow \\mathrm{Na}_2 \\stackrel{+25}{\\mathrm{~S}_4} \\mathrm{O}_6+2 \\mathrm{NaI} \\\\\n\\text {n-factor }=1 \\\\\n\\mathrm{E}=\\frac{\\mathrm{M}}{1}=\\mathrm{M}\n\\end{gathered}$"
  }
