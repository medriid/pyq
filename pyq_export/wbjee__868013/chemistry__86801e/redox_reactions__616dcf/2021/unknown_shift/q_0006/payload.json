  "question": {
    "text": "Indicate the products $(\\mathrm{X})$ and $(\\mathrm{Y})$ in the following reactions:\r\n$\\begin{array}{lr}\r\n\\mathrm{Na}_{2} \\mathrm{~S}+\\mathrm{nS}(\\mathrm{n}=1-8) & \\rightarrow(\\mathrm{X}) \\\\\r\n\\mathrm{Na}_{2} \\mathrm{SO}_{3}+\\mathrm{S} & \\rightarrow(\\mathrm{Y})\r\n\\end{array}$\r\n$\\begin{array}{ll}(\\mathrm{X}) & (\\mathrm{Y})\\end{array}$"
  },
  "options": [
    {
      "text": "$\\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{3} \\quad \\mathrm{Na}_{2} \\mathrm{~S}_{2}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Na}_{2} \\mathrm{~S}_{(n+1)} \\quad \\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{3}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{Na}_{2} \\mathrm{~S}_{\\mathrm{n}} \\quad \\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Na}_{2} \\mathrm{~S}_{5} \\quad \\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{4}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{array}{l}\r\n\\mathrm{Na}_{2} \\mathrm{~S}+\\mathrm{nS} \\longrightarrow \\mathrm{Na}_{2} \\mathrm{~S}_{(\\mathrm{n}+1)} \\\\\r\n\\mathrm{Na}_{2} \\mathrm{SO}_{3}+\\mathrm{S} \\longrightarrow \\mathrm{Na}_{2} \\mathrm{~S}_{2} \\mathrm{O}_{3}\r\n\\end{array}$"
  }
}