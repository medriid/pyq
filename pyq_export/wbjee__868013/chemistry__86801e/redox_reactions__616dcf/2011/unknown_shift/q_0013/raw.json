  "question": {
    "text": "2 gm of metal carbonate is neutralized completely by \\(100 \\mathrm{ml}\\) of \\(0.1(\\mathrm{~N}) \\mathrm{HCl}\\). The equivalent weight of metal carbonate is",
    "image": null
  },
  "options": [
    {
      "id": "fH4RI",
      "text": "50",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ep6wS",
      "text": "100",
      "image": null,
      "isCorrect": false
    },
    {
