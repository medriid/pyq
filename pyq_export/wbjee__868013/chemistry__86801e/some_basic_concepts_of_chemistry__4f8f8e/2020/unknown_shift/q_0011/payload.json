  "question": {
    "text": "The mole fraction of ethanol in water is $0.08$. Its molality is"
  },
  "options": [
    {
      "text": "$6.32 \\mathrm{~mol} \\mathrm{~kg}^{-1}$",
      "is_correct": false
    },
    {
      "text": "$4.83 \\mathrm{~mol} \\mathrm{~kg}^{-1}$",
      "is_correct": true
    },
    {
      "text": "$3.82 \\mathrm{~mol} \\mathrm{~kg}^{-1}$",
      "is_correct": false
    },
    {
      "text": "$2.84 \\mathrm{~mol} \\mathrm{~kg}^{-1}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint:\r\n$\\begin{aligned} \\text { Molality } &=\\frac{\\mathrm{x}_{\\mathrm{EtOH}}}{\\mathrm{x}_{\\mathrm{H}_{2} \\mathrm{O}}} \\times \\frac{1000}{\\mathrm{MW}_{\\text {solvent }}} \\\\ &=\\frac{0.08}{0.92} \\times \\frac{1000}{18} \\\\ &=4.83 \\mathrm{~mol} \\mathrm{~kg}^{-1} \\end{aligned}$"
  }
