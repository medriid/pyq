      "text": "\\(3: 4\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zB3KL",
      "text": "\\(2: 1\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YlSrU",
      "text": "\\(1: 2\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hint : \\(\\frac{\\lambda_1}{\\lambda_2}=\\frac{m_2 \\mathrm{~V}_2}{m_1 \\mathrm{~V}_1}=\\frac{50 \\times 1.5 \\mathrm{~V}_1}{100 \\times \\mathrm{V}_1}=\\frac{1.5}{2}=\\frac{3}{4}\\)",
    "image": null
