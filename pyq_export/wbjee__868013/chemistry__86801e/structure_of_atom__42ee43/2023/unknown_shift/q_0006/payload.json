  "question": {
    "text": "Two base balls (masses: \\(m_1=100 \\mathrm{~g}\\), and \\(m_2=50 \\mathrm{~g}\\) ) are thrown. Both of them move with uniform velocity, but the velocity of \\(m_2\\) is 1.5 times that of \\(m_1\\). The ratio of de Broglie wavelengths \\(\\lambda\\left(m_1\\right): \\lambda\\left(m_2\\right)\\) is given by"
  },
  "options": [
    {
      "text": "\\(4: 3\\)",
      "is_correct": false
    },
    {
      "text": "\\(3: 4\\)",
      "is_correct": true
    },
    {
      "text": "\\(2: 1\\)",
      "is_correct": false
    },
    {
      "text": "\\(1: 2\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Hint : \\(\\frac{\\lambda_1}{\\lambda_2}=\\frac{m_2 \\mathrm{~V}_2}{m_1 \\mathrm{~V}_1}=\\frac{50 \\times 1.5 \\mathrm{~V}_1}{100 \\times \\mathrm{V}_1}=\\frac{1.5}{2}=\\frac{3}{4}\\)"
  }
}