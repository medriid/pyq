  "question": {
    "text": "In Bohr model of atom, radius of hydrogen atom in ground state is $\\mathrm{r}_1$ and radius of $\\mathrm{He}^{+}$ion in ground state is $\\mathrm{r}_2$. Which of the following is correct?"
  },
  "options": [
    {
      "text": "$\\frac{r_1}{r_2}=4$",
      "is_correct": false
    },
    {
      "text": "$\\frac{r_1}{r_2}=\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{r_2}{r_1}=\\frac{1}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{r_2}{r_1}=\\frac{1}{2}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$r_n=a_0 \\times \\frac{n^2}{z}$\n$\\underline{\\text {For H-atom}}$\n$r_1=a_0$\n$\\underline{\\text {Also, For}}$ $\\underline {\\mathrm{He}^{+}}$ - $\\underline{\\text { ion }}$\n$r_2=a_0 \\times \\frac{1^2}{2}=\\frac{r_1}{2}$\n$\\therefore \\frac{r_2}{r_1}=\\frac{1}{2}$"
  }
}