  "question": {
    "text": "The difference between orbital angular momentum of an electron in a 4 f orbital and another electron in a 4 s orbital is",
    "image": null
  },
  "options": [
    {
      "id": "trttL",
      "text": "$2 \\sqrt{3}$ $\\times \\frac{h}{(2 \\times 3.14)}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "wtLKk",
      "text": "$3 \\sqrt{2}$ $\\times \\frac{h}{(2 \\times 3.14)}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "nzLjK",
      "text": "$\\sqrt{3}$ $\\times \\frac{h}{(2 \\times 3.14)}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "2rDDb",
      "text": "2 $\\times \\frac{h}{(2 \\times 3.14)}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Hint: \r\nOrbital angular momentum $=\\sqrt{\\ell(\\ell+1)} \\frac{\\mathrm{h}}{2 \\pi}$\r\nFor 4 f orbital; $\\ell=3 \\therefore$ Orbital angular momentum $=\\sqrt{3(3+1)} \\frac{\\mathrm{h}}{2 \\pi}=2 \\sqrt{3} \\frac{\\mathrm{h}}{2 \\pi}$\r\nFor 4 s orbital; $\\ell=0 \\therefore$ Orbital angular momentum $=0$\r\n$\\therefore$ Difference $=(2 \\sqrt{3}) \\frac{\\mathrm{h}}{2 \\pi}$",
    "image": null
  },
