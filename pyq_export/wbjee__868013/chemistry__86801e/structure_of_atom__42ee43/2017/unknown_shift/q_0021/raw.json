  "question": {
    "text": "Which of the following sets of quantum numbers represents the $19^{\\text {th }}$ electron of $\\operatorname{Cr}(Z=24) ?$",
    "image": null
  },
  "options": [
    {
      "id": "fjhu5",
      "text": "$\\left(4,1,-1,+\\frac{1}{2}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "mSNO1",
      "text": "$\\left(4,0,0,+\\frac{1}{2}\\right)$",
      "isCorrect": true,
      "image": null
    },
    {
