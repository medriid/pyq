  "solution": {
    "text": "Hints: <img src=\"assets\\st0032_aec12d859fa5.png\"><br>\n\\(\\begin{aligned}\n\\text { Number of neutrons } & =\\text { Mass no. }- \\text { Atomic no. } \\\\\n& =\\mathrm{X}-8-\\mathrm{Y}+3 \\\\\n& =\\mathrm{X}-\\mathrm{Y}-5\n\\end{aligned}\\)"
