  "question": {
    "text": "Blackened oil painting can be restored into original form by the action of :",
    "image": null
  },
  "options": [
    {
      "id": "RrLB1",
      "text": "Chlorine",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7vOFA",
      "text": "$\\mathrm{BaO}_2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SdC1g",
      "text": "$\\mathrm{H}_2 \\mathrm{O}_2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "LVQ0c",
      "text": "$\\mathrm{MnO}_2$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Blackening of oil painting is due to $\\mathrm{PbS}$ which is oxidised by $\\mathrm{H}_2 \\mathrm{O}_2$ to form white $\\mathrm{PbSO}_4$\n$\\underset{\\text { (Black) }}{\\mathrm{PbS}+\\mathrm{H}_2 \\mathrm{O}_2} \\rightarrow \\underset{\\text { (white) }}{\\mathrm{PbSO}_4}+\\mathrm{H}_2 \\mathrm{O}$",
    "image": null
  },
