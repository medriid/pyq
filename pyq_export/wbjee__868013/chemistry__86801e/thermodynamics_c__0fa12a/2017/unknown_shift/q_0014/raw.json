  "question": {
    "text": "Which of the following has the dimension if $\\left[\\mathrm{ML}^{2} \\mathrm{T}^{-2}\\right] ?$",
    "image": null
  },
  "options": [
    {
      "id": "4Kpaf",
      "text": "Coefficient of viscosity",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "lrhGG",
      "text": "Surface tension",
