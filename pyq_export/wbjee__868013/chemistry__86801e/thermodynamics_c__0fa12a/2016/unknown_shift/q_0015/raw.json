  "question": {
    "text": "The condition for a reaction to occur spontaneously is",
    "image": null
  },
  "options": [
    {
      "id": "7dKK1",
      "text": "$\\Delta H$ must be negative",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "jGWgn",
      "text": "$\\Delta S$ must be negative",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "LU2KK",
      "text": "$(\\Delta H-T \\Delta S)$ must be negative",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "5qVfB",
      "text": "$(\\Delta H+T \\Delta S)$ must be negative",
      "isCorrect": false,
