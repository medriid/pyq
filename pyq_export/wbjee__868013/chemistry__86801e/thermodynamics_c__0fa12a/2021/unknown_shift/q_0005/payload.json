  "question": {
    "text": "For a spontaneous reaction at all temperatures which of the following is correct?"
  },
  "options": [
    {
      "text": "Both $\\Delta \\mathrm{H}$ and $\\Delta \\mathrm{S}$ are positive",
      "is_correct": false
    },
    {
      "text": "$\\Delta \\mathrm{H}$ is positive and $\\Delta \\mathrm{S}$ is negative",
      "is_correct": false
    },
    {
      "text": "$\\Delta \\mathrm{H}$ is negative and $\\Delta \\mathrm{S}$ is positive",
      "is_correct": true
    },
    {
      "text": "Both $\\Delta \\mathrm{H}$ and $\\Delta \\mathrm{S}$ are negative",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "For spontancity $\\Delta G$ must be negative $\\because \\Delta \\mathrm{G}=\\Delta \\mathrm{H}-\\mathrm{T} \\Delta \\mathrm{S}$\r\nTo be negative at all Temperature, $\\Delta \\mathrm{H}     < 0, \\Delta \\mathrm{S}>0$"
