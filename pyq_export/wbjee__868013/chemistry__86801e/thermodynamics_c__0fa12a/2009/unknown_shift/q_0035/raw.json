  "question": {
    "text": "Equal volumes of molar hydrochloric acid and sulphuric acid are neutralised by dilute $\\mathrm{NaOH}$ solution and $\\mathrm{x} \\mathrm{kcal}$ and $\\mathrm{y} \\mathrm{kcal}$ of heat are liberated respectively. Which of the following is true?",
    "image": null
  },
  "options": [
    {
      "id": "7XtCi",
      "text": "$x=y$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2MFQ6",
      "text": "$x=\\frac{y}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "bFGjW",
      "text": "$x=2 y$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ORZzd",
      "text": "none of the above",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Enthalpy of $1 \\mathrm{~g}$ equivalent of strong acid and $1 \\mathrm{~g}$ equivalent strong base $=13.7 \\mathrm{kcal}$ Equal volume contains double eq. of $\\mathrm{H}_2 \\mathrm{SO}_4$ than $\\mathrm{HCl}$",
    "image": null
