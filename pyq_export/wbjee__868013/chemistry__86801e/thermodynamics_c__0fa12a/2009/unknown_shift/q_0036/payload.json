  "question": {
    "text": "The equilibrium constant $(\\mathrm{K})$ of a reaction may be written as :"
  },
  "options": [
    {
      "text": "$K=e^{-\\Delta G / R T}$",
      "is_correct": false
    },
    {
      "text": "$K=e^{-\\Delta \\mathrm{G}^0 / R T}$",
      "is_correct": true
    },
    {
      "text": "$K=e^{-\\Delta H / R T}$",
      "is_correct": false
    },
    {
      "text": "$K=e^{-\\Delta H^0 / R T}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\Delta \\mathrm{G}^{\\mathrm{o}}=-\\mathrm{RT} \\ln \\mathrm{K}$\n$\\Rightarrow \\frac{\\Delta \\mathrm{G}^{\\mathrm{o}}}{-\\mathrm{RT}}=\\ln \\mathrm{K}$\n$\\mathrm{K}=e^{-\\Delta \\mathrm{G}^{\\circ} / \\mathrm{RT}}$"
  }
}