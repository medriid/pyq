  "question": {
    "text": "At STP, the dissociation reaction of water is \\(\\mathrm{H}_2 \\mathrm{O} \\rightleftharpoons \\mathrm{H}^{+}\\)(aq.) \\(+\\mathrm{OH}^{-}\\)(aq.), and the \\(\\mathrm{pH}\\) of water is 7.0. The change of standard free energy \\(\\left(\\Delta \\mathrm{G}^{\\circ}\\right)\\) for the above dissociation process is given by",
    "image": null
  },
  "options": [
    {
      "id": "uzEnI",
      "text": "\\(20301 \\mathrm{~cal} / \\mathrm{mol}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ozsHw",
      "text": "\\(19091 \\mathrm{~cal} / \\mathrm{mol}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "JA1WI",
      "text": "\\(20096 \\mathrm{~cal} / \\mathrm{mol}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A4JCQ",
      "text": "\\(21301 \\mathrm{~cal} / \\mathrm{mol}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\text {Hint : } \\Delta G^{\\circ}=-2.303 R T \\log \\mathrm{K}_{\\mathrm{w}} \\\\\n& =-2.303 \\times 1.987 \\times 298 \\log 10^{-14} \\\\\n& =+2.303 \\times 1.987 \\times 298 \\times 14 \\mathrm{~cal} / \\mathrm{mol} \\quad \\quad\\left[\\mathrm{K}_{\\mathrm{w}}=\\left[\\mathrm{H}^{+}\\right][\\mathrm{OH}]=10^{-7} \\times 10^{-7}=10^{-14} \\mathrm{~as~} \\mathrm{pH}=7\\right] \\\\\n& =19091.3 \\mathrm{cal} / \\mathrm{mol}=19091 \\mathrm{cal} / \\mathrm{mol}\n\\end{aligned}\\)",
    "image": null
  },
