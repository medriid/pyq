  "question": {
    "text": "The value of $\\Delta H$ for cooling 2 mole of an ideal monoatomic gas from $225^{\\circ} \\mathrm{C}$ to $125^{\\circ} \\mathrm{C}$ at constant pressure will be [given $\\left.C_{p}=\\frac{5}{2} R\\right]$"
  },
  "options": [
    {
      "text": "$250 \\mathrm{R}$",
      "is_correct": false
    },
    {
      "text": "$-500 R$",
      "is_correct": true
    },
    {
      "text": "$500 \\mathrm{R}$",
      "is_correct": false
    },
    {
      "text": "$-250 R$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\Delta H=-n C_{p} \\Delta T=-2 \\times \\frac{5}{2} R(225-125)$\r\n$$\r\n=-5 R(100)=-500 R\r\n$$"
  }
}