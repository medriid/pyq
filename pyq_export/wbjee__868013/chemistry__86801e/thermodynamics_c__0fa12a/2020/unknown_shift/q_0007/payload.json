  "question": {
    "text": "An ideal gas expands adiabatically against vaccum. Which of the following is correct for the given process?"
  },
  "options": [
    {
      "text": "$\\Delta S=0$",
      "is_correct": false
    },
    {
      "text": "$\\Delta \\mathrm{T}=-\\mathrm{ve}$",
      "is_correct": false
    },
    {
      "text": "$\\Delta \\mathrm{U}=0$",
      "is_correct": true
    },
    {
      "text": "$\\Delta \\mathrm{P}=0$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Hint: \r\nFor adiabatic free expansion of an ideal gas\r\n$\\mathrm{dq}=0$\r\n$\\mathrm{dU}=0$\r\n$\\mathrm{dH}=0$\r\n$\\mathrm{dT}=0$"
  }
}