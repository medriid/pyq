  "correctValue": null,
  "solution": {
    "text": "Hints: \\(\\Delta \\mathrm{G}^{\\circ}=-\\mathrm{RT} \\operatorname{InK}\\)\nor, \\(\\Delta \\mathrm{H}^{\\circ}-\\mathrm{T} \\Delta \\mathrm{S}^{\\circ}=-\\mathrm{RT} \\operatorname{InK}\\)\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/wbjee/zGxcZa5a1eHSd8Tu-FQ_OF9yL_WHunsuW4gNtcGPI0o.original.fullsize.png\"><br>\nor, \\(\\operatorname{InK}=\\frac{-\\Delta \\mathrm{H}^{\\circ}}{\\mathrm{RT}}+\\frac{\\Delta \\mathrm{S}^{\\circ}}{\\mathrm{R}}\\) comparing with \\(\\mathrm{y}=\\mathrm{m} \\cdot \\mathrm{x}+\\mathrm{c}\\)\n\\(\\therefore \\mathrm{y}\\) intercept is \\(\\frac{\\Delta \\mathrm{S}^{\\circ}}{\\mathrm{R}}\\)",
    "image": null
  },
