  "question": {
    "text": "The half-life of a radioactive element is 10 hours. How much will be left after 4 hours in $1 \\mathrm{~g}$ atom sample?",
    "image": null
  },
  "options": [
    {
      "id": "sMmbP",
      "text": "$45.6 \\times 10^{23}$ atoms",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KxoI2",
      "text": "$4.56 \\times 10^{23}$ atoms",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ObKei",
      "text": "$4.56 \\times 10^{21}$ atoms",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "s8iTv",
      "text": "$4.56 \\times 10^{20}$ atoms",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$t_{1 / 2}=10 \\mathrm{hr} . \\quad \\mathrm{K}=\\frac{0.693}{10}$\n$4=\\frac{2.303 \\times 10}{0.693} \\log \\frac{1}{\\mathrm{~N}}$\n$\\log \\frac{1}{\\mathrm{~N}}=\\frac{4 \\times 0.693}{2.303 \\times 10}=0.12036$\n$\\log \\mathrm{N}=-0.12036=\\overline{1} .87964$\n$\\mathrm{N}=7.575 \\times 10^{-1} \\mathrm{~g}$ atoms\n$\\therefore$ No. of atoms $=7.575 \\times 10^{-1} \\times 6.023 \\times 10^{23}$ atoms $=4.56 \\times 10^{23}$ atoms",
    "image": null
  },
