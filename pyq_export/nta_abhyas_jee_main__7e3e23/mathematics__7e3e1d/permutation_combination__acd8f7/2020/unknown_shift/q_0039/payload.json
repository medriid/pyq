  "question": {
    "text": "A person predicts the outcome of <math><mn>20</mn></math> cricket matches of his home team. Each match can result either in a win, loss or tie for the home team. The total number of ways in which he can make the predictions such that exactly <math><mn>10</mn></math> predictions are correct, are equal to"
  },
  "options": [
    {
      "text": "<math><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>10</mn></mrow></msub><mo>⋅</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>10</mn></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>10</mn></mrow></msub><mo>⋅</mo><msup><mrow><mn>3</mn></mrow><mrow><mn>20</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>10</mn></mrow></msub><mo>⋅</mo><msup><mrow><mn>3</mn></mrow><mrow><mn>10</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mn>20</mn></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>10</mn></mrow></msub><mo>⋅</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>20</mn></mrow></msup></math>",
      "is_correct": false
