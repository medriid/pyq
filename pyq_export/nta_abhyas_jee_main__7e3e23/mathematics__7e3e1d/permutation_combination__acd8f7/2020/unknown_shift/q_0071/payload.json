  "question": {
    "text": "<p>A rectangle with sides <math><mn>2</mn><mi>m</mi><mo>-</mo><mn>1</mn><mi>&nbsp;</mi></math>and <math><mn>2</mn><mi>n</mi><mo>-</mo><mn>1</mn></math>&nbsp;is divided into squares of unit length. The number of rectangles that can be formed with both the sides of odd length is</p>\r"
  },
  "options": [
    {
      "text": "<math><msup><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi>m</mi><mi>n</mi><mfenced separators=\"|\"><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>(</mo><mi>n</mi><mo>+</mo><mn>1</mn><mo>)</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mn>4</mn></mrow><mrow><mi>m</mi><mo>+</mo><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
