  "question": {
    "text": "The number of ways of selecting two distinct numbers from the first <math><mn>15</mn></math> natural numbers such that their sum is a multiple of <math><mn>5,</mn></math> is equal to"
  },
  "options": [
    {
      "text": "<math><mn>20</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>36</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>21</mn></math>",
