  "question": {
    "text": "There are fifty persons among whom <math><mn>2</mn></math> are brothers. The number of ways they can be arranged in a circle, if there is exactly one person between the two brothers, is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>&#215;</mo><mn>48</mn><mo>!</mo></math>",
