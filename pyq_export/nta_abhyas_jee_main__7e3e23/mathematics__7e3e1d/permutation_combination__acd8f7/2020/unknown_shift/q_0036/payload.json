    },
    {
      "text": "<math><mn>360</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mo>&#215;</mo><mn>8</mn><mo>!</mo></math>",
      "is_correct": false
