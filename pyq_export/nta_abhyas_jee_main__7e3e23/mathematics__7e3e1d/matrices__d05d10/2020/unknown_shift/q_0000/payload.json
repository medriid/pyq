    {
      "text": "<math><mi mathvariant=\"normal\">Ι</mi><mo>+</mo><mi>A</mi><mo>+</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup></math>",
      "is_correct": true
