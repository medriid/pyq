  "question": {
    "text": "If <math><mi>A</mi></math> and <math><mi>B</mi></math> are matrices with <math><mn>24</mn></math> and <math><mn>40</mn></math> elements respectively, then the number of possible orders of <math><mi>A</mi></math> and <math><mi>B</mi></math> such that <math><mi>A</mi><mi>B</mi></math> is defined is",
    "image": null
  },
  "options": [
