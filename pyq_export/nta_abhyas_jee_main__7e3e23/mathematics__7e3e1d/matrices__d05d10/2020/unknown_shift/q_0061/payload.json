  "solution": {
    "text": "<math><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>=</mo><mi mathvariant=\"normal\">A</mi><mo>,</mo><mi mathvariant=\"normal\"></mi><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">B</mi></math><br /><math><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></math> (Skew symmetric)<br /><math><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></math><br /><math><mo>=</mo><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></math><br /><math><mo>=</mo><mi mathvariant=\"normal\">B</mi><mi mathvariant=\"normal\">A</mi><mo>-</mo><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">B</mi><mo>=</mo><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></math> (Symmetric)<br /><math><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mo>+</mo><mi mathvariant=\"normal\">B</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mo>-</mo><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mo>-</mo><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mo>+</mo><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></math><br /><math><mo>=</mo><mfenced separators=\"|\"><mrow><msup><mrow><mi mathvariant=\"no