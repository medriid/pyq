    "text": "<p><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>A</mi></mrow></mfenced><mo>=</mo><mn>6</mn><mo>&#8800;</mo><mn>0</mn></math> ( <math><mi>A</mi></math> is non sigular)<br />Given,&nbsp;<math><mn>6</mn><msup><mrow><mi>A</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><mi>a</mi><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>b</mi><mi>A</mi><mo>+</mo><mi>c</mi><mi>I</mi></math><br /><math><mo>&#8658;</mo><mn>6</mn><mi>I</mi><mo>=</mo><mi>a</mi><msup><mrow><mi>A</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><mi>b</mi><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>c</mi><mi>A</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>2</mn></msup><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mtable><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mfenced close=\"]\" open=\"[\" separators=\"|\"><mtable><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mspace linebreak=\"newline\"></mspace><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mtable><mtr><mtd><mn>2</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>9</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mn>3</mn></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>3</mn></msup><mo>=</mo><msup><mi>A</mi><mn>2</mn></msup><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mtable><mtr><mtd