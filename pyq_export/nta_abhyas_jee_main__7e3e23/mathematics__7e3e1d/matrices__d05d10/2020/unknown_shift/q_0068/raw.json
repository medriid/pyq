r><mtd><mn>6</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>6</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>6</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8757;</mo><mi>a</mi><msup><mi>A</mi><mn>3</mn></msup><mo>+</mo><mi>b</mi><msup><mi>A</mi><mn>2</mn></msup><mo>+</mo><mi>c</mi><mi>A</mi><mo>=</mo><mn>6</mn><mi>I</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>3</mn></math>,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mi>a</mi><mo>-</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>0</mn></math>,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>0</mn></math>,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mn>9</mn><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi><mo>-</mo><mi>c</mi><mo>=</mo><mn>2</mn></math>,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>6</mn></math><br />On solving, we get,<br /><math><mi>a</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi></mi><mi>b</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi></mi><mi>c</mi><mo>=</mo><mo>-</mo><mn>5</mn></math><br />Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>+</mo><mn>2</mn><mi>b</mi><mo>+</mo><mn>3</mn><mi>c</mi><mo>=</mo><mn>1</mn><mo>+</mo><mn>4</mn><mo>-</mo><mn>15</mn><mo>=</mo><mo>-</mo><mn>10</mn></math></p>",
