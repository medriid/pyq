      "is_correct": false
    },
    {
      "text": "<math><mi>A</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msup></math>",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>A</mi></mrow></mfenced><mo>&#8800;</mo><mn>0</mn><mo>,</mo><mi></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>B</mi></mrow></mfenced><mo>&#8800;</mo><mn>0</mn></math> (given)<br /><math><msup><mrow><mfenced separators=\"|\"><mrow><mi>A</mi><mi>B</mi></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>3</mn></mrow></msup><msup><mrow><mi>B</mi></mrow><mrow><mn>3</mn></mrow></msup><mi></mi><mi></mi><mi></mi><mo>&#8230;</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br />Also,&nbsp;<math><msup><mrow><mfenced separators=\"|\"><mrow><mi>A</mi><mi>B</mi></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi>A</mi><mi>B</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>A</mi><mi>B</mi></mrow></mfenced><mo>=</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>A</mi><mi>B</mi><mi></mi><mi></mi><mi></mi><mo>&#8230;</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br />From <math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><msup><mi>B</mi><mn>2</mn></msup><mo>=</mo><msup><mi>B</mi><mn>2</mn></msup><mi>A</mi></math><br /><math><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>A</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><msup><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>A</mi><msup><mrow><mi>A</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><msup><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msup></math>"
