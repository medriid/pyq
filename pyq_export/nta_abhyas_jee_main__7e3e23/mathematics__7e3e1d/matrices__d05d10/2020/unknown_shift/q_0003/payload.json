  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>B</mi><mn>0</mn><mn>2</mn></msubsup><mo>=</mo><msub><mi>B</mi><mn>0</mn></msub><msub><mi>B</mi><mn>0</mn></msub><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mo>-</mo><mn>4</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd><mtd><mn>4</mn></mtd><mtd><mn>3</mn></mtd></mtr></mtable></mfenced><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mo>-</mo><mn>4</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>4</mn></mtd><mtd><mn>4</mn></mtd><mtd><mn>3</mn></mtd></mtr></mtable></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>B</mi><mn>0</mn></msub><msub><mi>B</mi><mn>0</mn></msub><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mi mathvariant=\"normal\">I</mi><mo>=</mo><msubsup><mi>B</mi><mn>0</mn><mrow><mo>-</mo><mn>1</mn></mrow></msubsup><msub><mi>B</mi><mn>0</mn></msub></math><br />Also,&nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfenced><mo>=</mo><mn>1</mn></math><br /><math><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mi></mi><mi>a</mi><mi>d</mi><mi>j</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>B</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>B</mi></m