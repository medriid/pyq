  "solution": {
    "text": "<p><math><mi>D</mi><mo>=</mo><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>B</mi><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>B</mi><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>B</mi><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>B</mi><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>B</mi><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>B</mi><mi>A</mi><msup><mrow><mi>B</mi></mrow><mrow><mi>T</mi></mrow></msup></mrow></mfenced><mi>B</mi></math><br /><math><mi>D</mi><mo>=</mo><msup><mrow><mi>A</mi></mrow><mrow><mn>6</mn></mrow></msup></math><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>2</mn></msup><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><msqrt><mn>3</mn></msqrt></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><msqrt><mn>3</mn></msqrt></mtd><mtd><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mn>3</mn></mtd><mtd><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>3</mn></msup><mo>=</mo><msup><mi>A</mi><mn>2</mn></msup><mo>&#8901;</mo><mi>A</mi><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mn>3</mn></mtd><mtd><mo>-</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mfenced open=\"[\" close=\"]\"><mtable equalrows=\"true\" equalcolumns=\"true\"><mtr><mtd><msqrt><mn>3</mn></msqrt></mtd><mtd><mo>&#8722;</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced open=\"[\" close=\"]\"><mtable><mtr><mtd><mn>3</mn><msqrt><mn>3</mn></msqrt></mtd><mtd><mo>&#8722;</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>&#8722;</mo><mn>8</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mn>6</mn></msup><mo>=</mo><msup><mi>A</mi><mn>3</mn></msup><mo>&#8901;</mo><msup><mi>A</mi><mn>3</mn></msup><mo>=</mo><mfenced open=\"[\" close=\"]\"><mtable><mtr><mtd><mn>3</mn><msqrt><mn>3</mn></msqrt></mtd><mtd><mo>&#8722;</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>&#8722;</mo><mn>8</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mfenced open=\"[\" close=\"]\"><mtable><mtr><mtd><mn>3</mn><msqrt><mn>3</mn></msqrt></mtd><mtd><mo>&#8722;</mo><mn>2</mn><msqrt><mn>3</mn></msqrt><mo>&#8722;</mo><mn>8</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><mn>27</mn></mtd><mtd><mo>-</mo><mn>26</mn><mo>-</mo><mn>26</mn><msqrt><mn>3</mn></msqrt></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mi>D</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi>d</mi><mn>11</mn></msub><mo>=</mo><mn>27</mn></math></p>"
