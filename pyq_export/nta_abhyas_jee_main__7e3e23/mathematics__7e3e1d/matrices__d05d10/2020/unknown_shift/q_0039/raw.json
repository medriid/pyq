    "text": "Let,&nbsp;<math><mi>A</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>c</mi></mtd><mtd><mi>d</mi></mtd></mtr></mtable></mrow></mfenced></math> then <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>c</mi></mtd><mtd><mi>d</mi></mtd></mtr></mtable></mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>4</mn></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>4</mn></mtd></mtr></mtable></mrow></mfenced><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mi>c</mi></mtd><mtd><mi>d</mi></mtd></mtr></mtable></mrow></mfenced></math><br /><math><mo>⇒</mo><mi>a</mi><mo>+</mo><mn>3</mn><mi>b</mi><mo>=</mo><mi>a</mi><mo>+</mo><mn>2</mn><mi>c</mi><mo>,</mo><mn>2</mn><mi>a</mi><mo>+</mo><mn>4</mn><mi>b</mi><mo>=</mo><mi>b</mi><mo>+</mo><mn>2</mn><mi>d</mi></math><br /><math><mi>c</mi><mo>+</mo><mn>3</mn><mi>d</mi><mo>=</mo><mn>3</mn><mi>a</mi><mo>+</mo><mn>4</mn><mi>c</mi><mo>,</mo><mn>2</mn><mi>c</mi><mo>+</mo><mn>4</mn><mi>d</mi><mo>=</mo><mn>3</mn><mi>b</mi><mo>+</mo><mn>4</mn><mi>d</mi></math><br /><math><mo>⇒</mo><mn>3</mn><mi>b</mi><mo>=</mo><mn>2</mn><mi>c</mi><mo>,</mo><mi>a</mi><mo>+</mo><mi>c</mi><mo>=</mo><mi>d</mi><mo>,</mo></math><br />Hence,&nbsp;<math><mi>B</mi><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mi>a</mi></mtd><mtd><mi>b</mi></mtd></mtr><mtr><mtd><mfrac><mrow><mn>3</mn><mi>