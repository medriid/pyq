  "solution": {
    "text": "Using Cramer’s rule:<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∆</mo><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mtable><mtr><mtd><mn>2</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mn>3</mn></mtd><mtd><mn>1</mn></mtd><mtd><mi mathvariant=\"normal\">p</mi></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mo>-</mo><mn>7</mn></mtd><mtd><mn>8</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mn>8</mn><mo>+</mo><mn>7</mn><mi mathvariant=\"normal\">p</mi></mrow></mfenced><mo>+</mo><mn>3</mn><mfenced separators=\"|\"><mrow><mn>24</mn><mo>-</mo><mi mathvariant=\"normal\">p</mi></mrow></mfenced><mo>+</mo><mn>5</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>21</mn><mo>-</mo><mn>1</mn></mrow></mfenced></math><br /><math><mo>=</mo><mo>-</mo><mn>22</mn><mo>+</mo><mn>11</mn><mi mathvariant=\"normal\">p</mi><mo>=</mo><mo>-</mo><mn>11</mn><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">p</mi><mo>-</mo><mn>2</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mo>∆</mo><mn>1</mn></msub><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mtable><mtr><mtd><mn>12</mn></mtd><mtd><mo>-</mo><mn>3</mn></mtd><mtd><mn>5</mn></mtd></mtr><mtr><mtd><mi mathvariant=\"normal\">q</mi></mtd><mtd><mn>1</mn></mtd><mtd><mi mathvariant=\"normal\">p</mi></mtd></mtr><mtr><mtd><mn>17</mn></mtd><mtd><mo>-</mo><mn>7</mn></mtd><mtd><mn>8</mn></mtd></mtr></mtable></mfenced><mo>=</mo><mn>12</mn><mfenced separators=\"|\"><mrow><mn>8</mn><mo>+</mo><mn>7</mn><mi mathvariant=\"normal\">p</mi></mrow></mfenced><mo>+</mo><mn>3</mn><mfenced separators=\"|\"><mrow><mn>8</mn><mi mathvariant=\"normal\">q</mi><mo>-</mo><mn>17</mn><mi mathvariant=\"normal\">p</mi></mrow></mfenced><mo>+</mo><mn>5</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>7</mn><mi mathvariant=\"normal\">q</mi><mo>-</mo><mn>17</mn></mrow></mfenced></math><br /><math><mo>=</mo><mn