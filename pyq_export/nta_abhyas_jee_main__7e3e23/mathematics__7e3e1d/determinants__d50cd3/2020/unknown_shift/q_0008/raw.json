  "solution": {
    "text": "<math><mo>&#8757;</mo><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced><mi mathvariant=\"normal\">B</mi><mo>=</mo><mi mathvariant=\"normal\">A</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">B</mi></mrow></mfenced><msup><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup></math><br />Taking determinant on both sides, we get,&nbsp;<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><msup><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">T</mi></msup></mfenced><mfenced open=\"|\" close=\"|\"><mi mathvariant=\"normal\">A</mi></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi mathvariant=\"normal\">B</mi></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi mathvariant=\"normal\">A</mi></mfenced><mfenced open=\"|\" close=\"|\"><mi mathvariant=\"normal\">B</mi></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><msup><mi mathvariant=\"normal\">B</mi><mi mathvariant=\"normal\">T</mi></msup></mfenced></math><br /><math><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced><mo>=</mo><mn>2</mn></math><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><msup><mi mathvariant=\"normal\">B</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">j</mi><msup><mfenced separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">T</mi></msup><mi mathvariant=\"normal\">B</mi></mrow></mfenced><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced></math><br /><math><mo>|</mo><mi mathvariant=\"normal\">A</mi><mo>|</mo><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mo>|</mo><mi mathvariant=\"normal\">B</mi><mo>|</mo></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mo>|</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">j</mi><mo>(</mo><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mi mathvariant=\"normal\">B</mi><mo>)</mo><mo>|</mo></mrow></mfrac></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msup><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></msup><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced></mrow><mrow><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msup><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>16</mn></mrow></mfrac></math>",
