  "solution": {
    "text": "For infinite solutions,&nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mi>p</mi></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mi>p</mi></mtd></mtr><mtr><mtd><mi>p</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mn>1</mn><mo>+</mo><msup><mrow><mi>p</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><mn>0</mn></math><br />Hence,&nbsp;<math><mi>p</mi><mo>=</mo><mo>-</mo><mn>1</mn></math>"
  }
