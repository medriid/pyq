  "solution": {
    "text": "<math><msup><mrow><mn>2</mn></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></msup><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mn>2</mn></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></msup><mo>,</mo><msup><mrow><mn>2</mn></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></msup><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mi mathvariant=\"normal\">&nbsp;</mi></math> are in <math><mi mathvariant=\"normal\">G</mi><mo>.</mo><mi mathvariant=\"normal\">P</mi></math><br /><br /><math><mo>⇒</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>-</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>4</mn></mrow></msub><mo>-</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>=</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo></math><br /><br /><math><mo>⇒</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn></mrow></msub><mi mathvariant=\"normal\">&nbsp;</mi><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo></math> are in <math><mi mathvariant=\"normal\">A</mi><mo>.</mo><mi mathvariant=\"normal\">P</mi></math> .<br /><br /><math><mo>⇒</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">&nbsp;</mi><mo>+</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">&nbsp;</mi><mo>+</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>,</mo></math><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn></mrow></msub><mi mathvariant=\"normal\">&nbsp;</mi><mo>+</mo><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>3</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>3</mn></mrow></msub></math><br /><br />So, by operation <math><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>&nbsp;</mi><mo>→</mo><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&nbsp;</mi><mo>(</mo><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>)</mo></math><br /><br /><math><mo>⇒</mo>