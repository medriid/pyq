  "solution": {
    "text": "<p>Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><msub><mi>a</mi><mn>11</mn></msub></mtd><mtd><msub><mi>a</mi><mn>12</mn></msub></mtd><mtd><msub><mi>a</mi><mn>13</mn></msub></mtd></mtr><mtr><mtd><msub><mi>a</mi><mn>21</mn></msub></mtd><mtd><msub><mi>a</mi><mn>22</mn></msub></mtd><mtd><msub><mi>a</mi><mn>23</mn></msub></mtd></mtr><mtr><mtd><msub><mi>a</mi><mn>31</mn></msub></mtd><mtd><msub><mi>a</mi><mn>32</mn></msub></mtd><mtd><msub><mi>a</mi><mn>33</mn></msub></mtd></mtr></mtable></mfenced><mo>,</mo></math>&nbsp;then</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mtable><mtr><mtd><msub><mi>a</mi><mn>11</mn></msub></mtd><mtd><mfrac><msub><mi>a</mi><mn>12</mn></msub><mi>k</mi></mfrac></mtd><mtd><mfrac><msub><mi>a</mi><mn>13</mn></msub><msup><mi>k</mi><mn>2</mn></msup></mfrac></mtd></mtr><mtr><mtd><mi>k</mi><msub><mi>a</mi><mn>21</mn></msub></mtd><mtd><msub><mi>a</mi><mn>22</mn></msub></mtd><mtd><mfrac><msub><mi>a</mi><mn>23</mn></msub><mi>k</mi></mfrac></mtd></mtr><mtr><mtd><msup><mi>k</mi><mn>2</mn></msup><msub><mi>a</mi><mn>31</mn></msub></mtd><mtd><mi>k</mi><msub><mi>a</mi><mn>32</mn></msub></mtd><mtd><msub><mi>a</mi><mn>33</mn></msub></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>B</mi></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mtable><mtr><mtd><msub><mi>a</mi><mn>11</mn></msub></mtd><mtd><mfrac><msub><mi>a</mi><mn>12</mn></msub><mi>k</mi></mfrac></mtd><mtd><mfrac><msub><mi>a</mi><mn>13</mn></msub><msup><mi>k</mi><mn>2</mn></msup></mfrac></mtd></mtr><mtr><mtd><mi>k</mi><msub><mi>a</mi><mn>21</mn></msub></mtd><mtd><msub><mi>a</mi><mn>22</mn></msub></mtd><mtd><mfrac><msub><mi>a</mi><mn>23</mn></msub><mi>k</mi></mfrac></mtd></mtr><mtr><mtd><msup><mi>k</mi><mn>2</mn></msup><msub><mi>a</mi><mn>31</mn></msub></mtd><mtd><mi>k</mi><msub><mi>a</mi><mn>32</mn></msub></mtd><mtd><msub><mi>a</mi><mn>33</mn></msub></mtd></mtr></mtable></mfenced></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>k</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><msup><mrow><mi>k</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>a</mi></mrow><mrow><mn>11</mn></mrow></msub></mtd><mtd><mi>k</mi><msub><mrow><mi>a</mi></mrow><mrow><mn>12</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>13</mn></mrow></msub></mtd></mtr><mtr><mtd><msup><mrow><mi>k</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>a</mi></mrow><mrow><mn>21</mn></mrow></msub></mtd><mtd><mi>k</mi><msub><mrow><mi>a</mi></mrow><mrow><mn>22</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>23</mn></mrow></msub></mtd></mtr><mtr><mtd><msup><mrow><mi>k</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>a</mi></mrow><mrow><mn>31</mn></mrow></msub></mtd><mtd><msub><mrow><mi>k</mi><mi>a</mi></mrow><mrow><mn>32</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>33</mn></mrow></msub></mtd></mtr></mtable></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>11</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>12</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>13</mn></mrow></msub></mtd></mtr><mtr><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>21</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>22</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>23</mn></mrow></msub></mtd></mtr><mtr><mtd><msub><mrow><mi>a</mi></mrow><mrow><mn>31</mn></mrow></msub></mtd><mtd><msub><mrow><mi>a</m