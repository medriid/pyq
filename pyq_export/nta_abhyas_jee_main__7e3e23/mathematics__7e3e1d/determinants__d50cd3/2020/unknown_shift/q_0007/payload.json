      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></msup><msup><mrow><mn>5</mn></mrow><mrow><mn>3</mn></mrow></msup></math>",
