  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>A</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mi>B</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>A</mi><mi>B</mi><mo>=</mo><mi>O</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>A</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>B</mi><mi>B</mi><msup><mi>B</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>A</mi><mi>B</mi><msup><mi>B</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><mi>O</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>A</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>B</mi><mo>+</mo><mn>2</mn><mi>A</mi><mo>=</mo><mi>O</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>A</mi><msup><mi>A</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>B</mi><mo>+</mo><mn>2</mn><mi>A</mi><mi>A</mi><mo>=</mo><mi>O</mi><mspace linebreak=\"newline\"/><mo>&#8658;</mo><mi>B</mi><mo>=</mo><mo>-</mo><mn>2</mn><msup><mi>A</mi><mn>2</mn></msup></math><br />Hence,&nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msup><mrow><mi>A</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>-</mo><mn>2</mn><msup><mrow><mi>A</mi></mrow><mrow><mn>2</mn></mrow></msup><mi></mi><mi>B</mi></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>5</mn><msup><mrow><mi>A</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow></mfenced><mo>=</mo><msup><mrow><mn>5</mn></mrow><mrow><mn>3</mn></mrow></msup><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>A</mi></mrow></mfenced></mrow><mrow><mn>4</mn></mrow></msup><mo>=</mo><msup><mrow><mn>5</mn></mrow><mrow><mn>3</mn></mrow></msup><mo>.</mo><msup><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></msup><mi></mi></math>"
