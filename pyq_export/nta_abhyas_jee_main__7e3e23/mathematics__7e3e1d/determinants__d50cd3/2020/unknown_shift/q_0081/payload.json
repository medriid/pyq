  "solution": {
    "text": "<math><mi>t</mi><mi>r</mi><mfenced separators=\"|\"><mrow><mi>A</mi></mrow></mfenced><mo>=</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>7</mn></math><br />Ordered triplets of <math><mfenced separators=\"|\"><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi></mrow></mfenced></math> are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>1,1</mn><mo>,</mo><mn>5</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>1,2</mn><mo>,</mo><mn>4</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>1,3</mn><mo>,</mo><mn>3</mn></mrow></mfenced><mo>,</mo></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,1</mo><mo>,</mo><mn>4</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,2</mo><mo>,</mo><mn>3</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,3</mo><mo>,</mo><mn>2</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,4</mo><mo>,</mo><mn>1</mn></mrow></mfenced><mo>,</mo></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,1</mo><mo>,</mo><mn>3</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,2</mo><mo>,</mo><mn>2</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,3</mo><mo>,</mo><mn>1</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,1</mo><mo>,</mo><mn>2</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,2</mo><mo>,</mo><mn>1</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>5</mn><mo>,1</mo><mo>,</mo><mn>1</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mi>A</mi></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mtable><mtr><mtd><mi>a</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>3</