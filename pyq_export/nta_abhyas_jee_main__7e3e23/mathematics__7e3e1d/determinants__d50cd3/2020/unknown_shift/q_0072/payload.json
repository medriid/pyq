\"normal\">A</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">B</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>×</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>6</mn></mrow></msup><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>6</mn></mrow></msup></mrow><mrow><mo>-</mo><msup><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></msup></mrow></mfrac><mo>=</mo><mo>-</mo><mn>2</mn></math>"
