  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>f</mi><mo>&#34;</mo></msup><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>2</mn><mi>cos</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi></mrow></mfenced><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mn>2</mn><mi>x</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>,</mo><mo>&#160;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>2</mn></mfrac><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac><mo>,</mo><mo>&#160;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>4</mn></mfrac></math><br />Hence, required area <math><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></munderover><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>2</mn></mrow></msup><mi></mi><mi>x</mi><mi></mi><mi>d</mi><mi>x</mi><mo>=</mo></mrow></mrow><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></munderover><mrow><mfrac><mrow><mn>1</mn><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mn>2</mn><mi>x</mi></mrow></mrow></mrow><mrow><mn>2</mn></mrow></mfrac><mi>d</mi><mi>x</mi></mrow></mrow><mo>=</mo><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi></mrow></mfenced></mrow></mrow></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mfrac><mrow><mi>&#960