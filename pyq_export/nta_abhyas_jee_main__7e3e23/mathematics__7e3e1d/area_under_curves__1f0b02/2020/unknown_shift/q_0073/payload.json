  "solution": {
    "text": "The required area is<br /><math><mi>A</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></msubsup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><math><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></msubsup><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><math> <mrow> <mo>=</mo><msubsup> <mstyle><mo>∫</mo></mstyle> <mn>0</mn> <mrow> <mfrac> <mi>π</mi> <mn>4</mn> </mfrac> </mrow> </msubsup> <mi>tan</mi><mi>x</mi><mo>⋅</mo><msup> <mrow> <mi>sec</mi></mrow> <mn>2</mn> </msup> <mi>x</mi><mi>d</mi><mi>x</mi></mrow> </math><br />Let <math><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mi>t</mi></math><br /><math><mo>⇒</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><math><mo>⇒</mo><mi></mi><mi>I</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><mi>t</mi></mrow></mrow><mi>d</mi><mi>t</mi><mo>=</mo><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math> <mrow>  <mo>&#x2234;</mo><mi>g</mi><mfenced>   <mi>x</mi>  </mfenced><mo>=</mo><mfrac>   <mn>1</mn>   <mn>2</mn>  </mfrac>  <mi>sin</mi><mi>x</mi><mo>&#x2264;</mo><mfrac>   <mn>1</mn>   <mrow>    <mn>2</mn><mo>&#x22C5;</mo><msqrt>     <mn>2</mn>    </msqrt>    </mrow>  </mfrac>  </mrow></math>"
