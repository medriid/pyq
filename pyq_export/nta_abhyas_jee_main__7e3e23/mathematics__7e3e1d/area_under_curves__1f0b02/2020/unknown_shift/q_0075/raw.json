  "question": {
    "text": "The area&nbsp;(in square units) bounded by <math><mi>y</mi><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>x</mi><mo>+</mo><mn>1</mn></math> and <math><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mn>2</mn></math> is&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "cICgt",
      "text": "<math><mn>2</mn><msqrt><mn>2</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xB0fF",
      "text": "<math><mfrac><mrow><mn>4</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
