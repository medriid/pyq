    "text": "<p><img src=\"assets\\st0060_c78163bed157.png\" style=\"max-width:100%; object-fit:contain\" style=\"width:1.78681in;height:1.38681in\" /><br />From the figure, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>λ</mi><mn>1</mn></mfrac><mo>=</mo><mfrac><mrow><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><msqrt><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt><mo>-</mo><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mi>x</mi></mrow></mfenced></mrow></mfenced><mi>d</mi><mi>x</mi></mrow><mrow><msubsup><mo>∫</mo><mrow><mo>-</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><msqrt><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt><mo>-</mo><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mi>x</mi></mrow></mfenced></mrow></mfenced><mi>d</mi><mi>x</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>λ</mi><mo>=</mo><mfrac><msubsup><mfenced close=\"]\" open=\"[\"><mrow><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi><mo>-</mo><mstyle displaystyle=\"true\"><mfrac><msup><mi>x</mi><mn>4</mn></msup><mn>4</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle=\"true\"><mfrac><msup><mi>x</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle></mrow></mfenced><mn>0</mn><mn>1</mn></msubsup><msubsup><mfenced close=\"]\" open=\"[\"><mrow><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi><mo>-</mo><mfrac><msup><mi>x</mi><mn>4</mn></msup><mn>4</mn></mfrac><mo>+</mo><mfrac><msup><mi>x</mi><mn>2</mn></msup><mn>2</mn></mfrac></mrow></mfenced><mrow><mo>-</mo><mn>1</mn></mrow><mn>0</mn></msubsup></mfrac><mo>=</mo><mfrac><mrow><mfrac><mi>π</mi><mn>4</mn></mfrac><mo>-</mo><mfenced separators=\"|\"><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced></mrow><mrow><mfrac>