    "text": "<img alt=\"\" src=\"assets\\st0067_62a77d76ddd6.jpg\" style=\"width: 270px; height: 172px;\" /><br />Required area is<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><munderover><mo>∫</mo><mn>1</mn><mn>2</mn></munderover><mfenced close=\"]\" open=\"[\"><mrow><msup><mn>2</mn><mi>x</mi></msup><mo>-</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced></mrow></mfenced><mi>d</mi><mi>x</mi></math><br /><math><mo>=</mo><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mn>2</mn></mrow><mrow><mi>x</mi></mrow></msup></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></mrow></mfrac><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></math><br /><math><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>4</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></mrow></mfrac><mo>-</mo><mn>4</mn><mo>+</mo><mfrac><mrow><mn>8</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></mrow></mfrac><mo>-</mo><mn>1</mn><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></mrow></mfrac><mo>-</mo><mn>3</mn><mo>+</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mrow><mrow