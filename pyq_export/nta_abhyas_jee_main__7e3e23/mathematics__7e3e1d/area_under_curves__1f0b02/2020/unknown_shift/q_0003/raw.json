  "solution": {
    "text": "As <math><mi>y</mi><mo>=</mo><mn>2</mn><mi>x</mi><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>&#62;</mo><mn>0</mn></mrow></mrow></math><br />and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mo>-</mo><mi>x</mi><mo>&#60;</mo><mn>0</mn><mo>&#160;</mo><mo>&#8704;</mo><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mi>e</mi><mo>,</mo><mn>2</mn><mi>e</mi></mrow></mfenced></math><br />The required area is <math><mi>A</mi><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mi>e</mi></mrow><mrow><mn>2</mn><mi>e</mi></mrow></munderover><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mi>x</mi></mrow></mfenced></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><math><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mi>e</mi></mrow><mrow><mn>2</mn><mi>e</mi></mrow></munderover><mrow><mi>d</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow></mrow></math><br /><math><mo>=</mo><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mi>e</mi></mrow><mrow><mn>2</mn><mi>e</mi></mrow></msubsup></math><br /><math><mo>=</mo><mn>4</mn><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msup><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>e</mi></mrow></mfenced></mrow></mrow><mo>-</mo><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mn