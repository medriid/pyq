  "correctValue": "3",
  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>10</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><mn>5</mn><msup><mi>x</mi><mn>4</mn></msup><mo>+</mo><msup><mi>x</mi><mn>5</mn></msup></mrow></mfenced><mn>20</mn></msup></math><br /><math><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mn>5</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>20</mn></mrow></msup><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mn>100</mn></mrow></msup></math><br />Number of terms <math><mo>=</mo><mn>101</mn><mo>=</mo><mi>&#955;</mi></math><br /><math><msup><mrow><mn>3</mn></mrow><mrow><mn>101</mn></mrow></msup><mo>=</mo><mn>3</mn><mo>&#8901;</mo><msup><mrow><mn>3</mn></mrow><mrow><mn>100</mn></mrow></msup><mo>=</mo><mn>3</mn><mo>&#8901;</mo><msup><mrow><mn>9</mn></mrow><mrow><mn>50</mn></mrow></msup><mo>=</mo><mn>3</mn><msup><mrow><mfenced separators=\"|\"><mrow><mn>10</mn><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>50</mn></mrow></msup></math><br /><math><mo>=</mo><mn>3</mn><mfenced separators=\"|\"><mrow><msub><mrow><mmultiscripts><mrow><mi>C</mi></mrow><mprescripts></mprescripts><mrow><mi></mi></mrow><mrow><mn>50</mn></mrow></mmultiscripts></mrow><mrow><mn>0</mn></mrow></msub><mo>&#8901;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>50</mn></mrow></msup><mo>-</mo><msub><mrow><mmultiscripts><mrow><mi>C</mi></mrow><mprescripts></mprescripts><mrow><mi></mi></mrow><mrow><mn>50</mn></mrow></mmultiscripts></mrow><mrow><mn>1</mn></mrow></msub><mo>&#8901;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>49</mn></mrow></msup><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>.</mo><mo>+</mo><msub><mrow><mmultiscripts><mrow><mi>C</mi></mrow><mprescripts></mprescripts><mrow><mi></mi></mrow><mrow><mn>50</mn></mrow></mmultiscripts></mrow><mrow><mn>48</mn></mrow></msub><mo>&#8901;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msub><mrow><mmultiscripts><mrow><mi>C</mi></mrow><mprescripts></mprescripts><mrow><mi></mi></mrow><mrow><mn>50</mn></mrow></mmultiscripts></mrow><mrow><mn>49</mn></mrow></msub><mo>&#8901;</mo><mn>10</mn><mo>+</mo><msub><mrow><mmultiscripts><mrow><mi>C</mi></mrow><mprescripts></mprescripts><mrow><mi></mi></mrow><mrow><mn>50</mn></mrow></mmultiscripts></mrow><mrow><mn>50</mn></mrow></msub></mrow></mfenced></math><br /><math><mo>=</mo><mn>3</mn><mfenced separators=\"|\"><mrow><mn>100</mn><mi>K</mi><mo>+</mo><mfrac><mrow><mn>50</mn><mo>&#215;</mo><mn>49</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>&#215;</mo><mn>100</mn><mo>-</mo><mn>50</mn><mo>&#215;</mo><mn>10</mn><mo>+</mo><mn>1</mn></mrow></mfenced></math><br /><math><mo>=</mo><mn>3</mn><mi>K</mi><mo>&#215;</mo><mn>100</mn><mo>+</mo><mn>3</mn><mo>&#215;</mo><mn>25</mn><mo>&#215;</mo><mn>49</mn><mo>&#215;</mo><mn>100</mn><mo>-</mo><mn>500</mn><mo>&#215;</mo><mn>3</mn><mo>+</mo><mn>3</mn></math><br /><math><mo>=</mo></math> Multiple of <math><mn>100</mn><mo>+</mo><mn>3</mn></math><br /><math><mo>&#8658;</mo></math> one&rsquo;s place is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math>&nbsp;and ten&rsquo;s place is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn></math><br />Hence,&nbsp;<math><mi>O</mi><mo>+</mo><mi>T</mi><mo>=</mo><mn>3</mn></math>",
