msup><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mrow><mn>7</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>4</mn><mo>+</mo><mn>9</mn><mo>+</mo><mn>9</mn><mo>+</mo><mn>25</mn><mo>+</mo><mn>25</mn><mo>+</mo><mn>25</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>729</mn><mo>-</mo><mn>105</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>624</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>31</mn><mn>2</mn></math><br /><math><mo>&#8658;</mo><mfrac><mrow><mi>K</mi></mrow><mrow><mn>100</mn></mrow></mfrac><mo>=</mo><mn>3.1</mn><mn>2</mn></math>",
