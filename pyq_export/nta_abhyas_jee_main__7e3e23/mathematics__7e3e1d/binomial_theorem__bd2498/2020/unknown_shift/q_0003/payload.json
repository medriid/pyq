      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>3</mn><mi>n</mi><mo>+</mo><mn>4</mn></mrow></mfenced></mrow><mrow><mn>24</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>2</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>3</mn><mi>n</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mn>24</mn></mrow></mfrac></math>",
