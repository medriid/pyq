  "correctValue": null,
  "solution": {
    "text": "Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><msub><mi>&#945;</mi><mn>1</mn></msub></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><msub><mi>&#945;</mi><mn>2</mn></msub></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><msub><mi>&#945;</mi><mn>3</mn></msub></mrow></mfenced><mo>&#8230;</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><msub><mi>&#945;</mi><mi>n</mi></msub></mrow></mfenced></math> where <math><msub><mrow><mi>&#945;</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>1</mn><mo>,</mo><mi></mi><msub><mrow><mi>&#945;</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>2</mn></math> etc.<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>x</mi><mi>n</mi></msup><mo>-</mo><mfenced separators=\"|\"><mrow><mo>&#8721;</mo><msub><mi>&#945;</mi><mn>1</mn></msub></mrow></mfenced><msup><mi>x</mi><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><mfenced separators=\"|\"><mrow><mo>&#8721;</mo><msub><mi>&#945;</mi><mn>1</mn></msub><msub><mi>&#945;</mi><mn>2</mn></msub></mrow></mfenced><msup><mi>x</mi><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></msup><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo></math><br />Hence, the coefficient of <math><msup><mrow><mi>x</mi></mrow><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></msup><mo>=</mo></math>&nbsp;the sum of all the products of the first <math><mi>&#8216;</mi><mi>n</mi><mi>&#8217;</mi></math> natural numbers taken two at a time<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>+</mo><mi>n</mi></mrow></mfenced><mn>2</mn></msup><mo>-</mo><mfenced separators=\"|\"><mrow><msup><mn>1</mn><mn>2</mn></msup><mo>+</mo><msup><mn>2</mn><mn>2</mn></msup><mo>+</mo><msup><mn>3</mn><mn>2</mn></msup><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>+</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mfenced></mrow><mn>2</mn></mfrac></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>3</mn><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mfenced></mrow><mn>24</mn></mfrac></math>",
