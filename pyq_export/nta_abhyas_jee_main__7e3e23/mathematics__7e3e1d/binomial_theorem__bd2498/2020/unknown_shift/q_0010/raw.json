  "solution": {
    "text": "<math><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mi>n</mi></mrow></msup><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mi>r</mi></mrow></msup></mrow></mrow></math><br /><math><mo>&#8658;</mo><mi>x</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mi>n</mi></mrow></msup><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow></math><br />Differentiating w.r.t. <math><mi>x</mi></math> we get<br /><math><mi>x</mi><mi>n</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mi>n</mi></mrow></msup><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><mfenced separators=\"|\"><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mrow><mi mathvariant=\"normal\"></mi><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mi>r</mi></mrow></msup></math><br />Again multiplying both sides by <math><mi>x</mi></math><br /><math><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>n</mi><mi>x</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced><mi>x</mi><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><mfenced separators=\"|\"><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mrow><mi mathvariant=\"normal\"></mi><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msup></math><br />Again differentiating w.r.t. <math><mi>x</mi></math> we get,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>d</mi><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>n</mi><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfenced><msup><mfenced separators=\"|\"><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mfenced><msub><mi>C</mi><mi>r</mi></msub><msup><mi>x</mi><mi>r</mi></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfenced><msup><mfenced separators=\"|\"><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mfenced><msub><mi>C</mi><mi>r</mi></msub><msup><mi>x</mi><mi>r</mi></msup><mo>=</mo><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mi>x</mi><mo>+</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mfenced><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></msup></math><br />Putting <math><mi>x</mi><mo>=</mo><mn>1</mn></math> on both sides, we get,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8721;</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mfenced><msup><mfenced separators=\"|\"><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mn>2</mn></msup></mfenced><msub><mi>C</mi><mi>r</mi></msub><mo>=</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>3</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>&#8901;</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><msup><mn>2</mn><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></msup><mo>=</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi><mo>+</mo><mn>4</mn></mrow></mfenced></math><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>4</mn><mo>=</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>4</mn></mrow></mfenced><mo>&#8658;</mo><mi>&#945;</mi><mo>=</mo><mo>-</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi>&#946;</mi><mo>=</mo><mo>-</mo><mn>4</mn></math><br />Hence,&nbsp;<math><msup><mrow><mi>&#945;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>&#946;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>17</mn></math>",
