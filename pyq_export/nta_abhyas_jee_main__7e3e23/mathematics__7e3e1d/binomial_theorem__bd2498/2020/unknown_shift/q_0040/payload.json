  "question": {
    "text": "The sum of the rational terms in the expansion of <math><msup><mrow><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn></msqrt><mo>+</mo><msup><mrow><mn>3</mn></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></msup></mrow></mfenced></mrow><mrow><mn>10</mn></mrow></msup></math> is equal to"
  },
  "options": [
    {
      "text": "<math><mn>31</mn></math>",
