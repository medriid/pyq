  "solution": {
    "text": "For <math><msub><mrow><mi>T</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><msup><mrow><mi>x</mi></mrow><mrow><mi>r</mi></mrow></msup><mo>,</mo></math> coefficient <math><mo>→</mo><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub></math><br /><br /><math><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi><mo>-</mo><mn>1</mn></mrow></msub><mo>:</mo><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub><mo>:</mo><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>1</mn><mo>:</mo><mn>7</mn><mo>:</mo><mn>42</mn></math><br /><br /><math><mo>⇒</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi><mo>-</mo><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>1</mn></mrow></mfrac></math> and <math><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">&nbsp;</mi></mrow><mrow><mi>n</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mi>r</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>42</mn></mrow><mrow><mn>7</mn></mrow></mfrac></math><br /><br /><math><mo>⇒</mo><mfrac><mrow><mi>n</mi><mo>-</mo><mi>r</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>r</mi></mrow></mfrac><mo>=</mo><mn>7</mn></math> and <math><mfrac><mrow><mi>n</mi><mo>-</mo><mi>r</mi></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mn>6</mn></math><br /><br /><math><mo>⇒</mo><mi>n</mi><mo>-</mo><mi>r</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>7</mn><mi>r</mi></math> and <math><mi>n</mi><mo>-</mo><mi>r</mi><mo>=</mo><mn>6</mn><mi>r</mi><mo>+</mo><mn>6</mn></math><br /><br /><math><mo>⇒</mo><mi>n</mi><mo>=</mo><mn>8</mn><mi>r</mi><mo>-</mo><mn>1</mn></math> and <math><mi mathvariant=\"normal\">&nbsp;</mi><mi>n</mi><mo>=</mo><mn>7</mn><mi>r</mi><mo>+</mo><mn>6</mn></math><br /><br /><math><mo>⇒</mo><mn>8</mn><mi>r</mi><mo>-</mo><mn>1</mn><mo>=</mo><mn>7</mn><mi>r</mi><mo>+</mo><mn>6</mn><mo>⇒</mo><mi>r</mi><mo>=</mo><mn>7</mn></math><br /><br /><math><mo>⇒</mo><mi>n</mi><mo>=</mo><mn>55</mn></math>"
