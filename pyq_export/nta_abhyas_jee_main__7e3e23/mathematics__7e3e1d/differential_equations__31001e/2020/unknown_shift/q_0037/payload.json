      "text": "<math><mi>y</mi><mo>=</mo><mi>c</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
