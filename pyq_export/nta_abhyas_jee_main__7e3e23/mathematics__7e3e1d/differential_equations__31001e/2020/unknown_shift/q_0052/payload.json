  "solution": {
    "text": "<math><mfrac><mrow><mi>d</mi><mfenced separators=\"|\"><mrow><mi>p</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mfenced></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>-</mo><mi>p</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced><mo>=</mo><mo>-</mo><mn>100</mn></math><br />I.F. = <math><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mi>d</mi><mi>t</mi></mrow></mrow></mrow></msup><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mi>t</mi></mrow></msup></math><br /><math><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mi>t</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>p</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>100</mn><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mi>t</mi></mrow></msup><mo>+</mo><mi>C</mi></math><br />Now <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mfenced separators=\"|\"><mn>0</mn></mfenced><mo>=</mo><mn>50</mn><mo>&#8658;</mo><mi>C</mi><mo>=</mo><mo>-</mo><mn>50</mn></math><br /><math><mi>P</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\"></mi><mn>2</mn></mrow></mfenced><mo>=</mo><mn>100</mn><mi></mi><mo>&#8211;</mo><mi></mi><mn>50</mn><mi></mi><msup><mrow><mi>e</mi></mrow><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></msup><mi></mi><mo>=</mo><mi></mi><mn>100</mn><mi></mi><mo>&#8211;</mo><mi></mi><mn>25</mn><mi></mi><mo>=</mo><mi></mi><mn>75</mn><mo>.</mo></math>"
