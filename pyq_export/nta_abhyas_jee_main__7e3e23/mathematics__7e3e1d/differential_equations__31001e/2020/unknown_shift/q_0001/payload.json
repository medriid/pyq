      "is_correct": false
    },
    {
      "text": "<math><mi>y</mi><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac></mrow></msup><mo>-</mo><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>y</mi><mo>=</mo><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi>y</mi><mo>=</mo><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mi>x</mi></mrow></msup></math>",
      "is_correct": false
