  "solution": {
    "text": "Given,&nbsp;<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>x</mi></math><br /><br /><math><mo>&#8658;</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mrow><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mn>2</mn><mi>x</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><br />or <math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>y</mi></mrow></mfrac><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>c</mi></math><br /><br />or <math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>y</mi><mo>+</mo><mi>c</mi><mi>y</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math>",
