  "question": {
    "text": "The solution of the differential equation <math><mfrac><mrow><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>-</mo><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi></mrow><mrow><mi>x</mi><mi>y</mi></mrow></mfrac><mo>=</mo><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>+</mo><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi></math> is (where,&nbsp;<math><mi>C</mi></math> is an arbitrary constant)",
    "image": null
  },
  "options": [
    {
      "id": "pzxcS",
      "text": "<math><mfrac><mrow><mi>x</mi></mrow><mrow><mi>y</mi></mrow></mfrac><mo>=</mo><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mi>C</mi></math>",
