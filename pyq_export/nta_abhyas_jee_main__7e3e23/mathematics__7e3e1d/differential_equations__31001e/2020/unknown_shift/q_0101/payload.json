    },
    {
      "text": "<math><mi>x</mi><mi>y</mi><mo>=</mo><mi>c</mi><msup><mrow><mi>e</mi></mrow><mrow><mi>y</mi></mrow></msup><mo>+</mo><mn>2</mn></math>",
