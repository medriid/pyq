    {
      "text": "<math><mi>x</mi><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>y</mi></mrow></msup><mo>+</mo><mi>y</mi><mo>-</mo><mi>c</mi></math>",
