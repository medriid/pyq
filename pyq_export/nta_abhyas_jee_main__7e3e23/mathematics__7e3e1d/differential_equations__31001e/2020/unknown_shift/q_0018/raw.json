  "question": {
    "text": "The solution of the differential equation <math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mi>y</mi></mrow><mrow><mi>x</mi><mo>-</mo><mn>6</mn><mi>y</mi></mrow></mfrac></math> is (where&nbsp;<math><mi>c</mi></math> is an arbitrary constant)",
    "image": null
  },
  "options": [
    {
      "id": "aVmOv",
      "text": "<math><mn>4</mn><mi>x</mi><mi>y</mi><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>3</mn><mi>y</mi><mo>+</mo><mi>c</mi></math>",
