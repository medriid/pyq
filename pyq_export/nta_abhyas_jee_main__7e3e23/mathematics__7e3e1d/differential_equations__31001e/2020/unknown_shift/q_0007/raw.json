  "solution": {
    "text": "<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>y</mi><mo>+</mo><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac><mi>d</mi><mi>x</mi></math><br /><math><mo>&#8658;</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mi>y</mi><mo>+</mo><mn>3</mn></mrow></mfenced></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>C</mi></mrow></mrow></math><br /><math><mo>&#8658;</mo><mi>y</mi><mo>+</mo><mn>3</mn><mo>=</mo><mi>C</mi><mo>(</mo><mn>2</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>)</mo></math><br />Now, at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mi>y</mi><mo>=</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mn>4</mn><mo>=</mo><mn>3</mn><mi>C</mi><mo>&#8658;</mo><mi>C</mi><mo>=</mo><mfrac><mrow><mn>4</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mi>y</mi><mo>=</mo><mfrac><mrow><mn>4</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>-</mo><mn>3</mn></math><br />Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mfenced><mfrac><mi>&#960;</mi><mn>3</mn></mfrac></mfenced><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mfenced><mrow><mn>2</mn><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced><mo>&#8722;</mo><mn>3</mn><mo>=</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><mo>&#8901;</mo><mn>5</mn><mo>&#8722;</mo><mn>3</mn><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac></math>",
