  "question": {
    "text": "The solution of the differential equation <math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mi>a</mi><mi>x</mi><mo>+</mo><mi>b</mi><mo>,</mo><mtext> </mtext><mi>a</mi><mo>≠</mo><mn>0</mn></math> represents"
  },
  "options": [
    {
      "text": "a parabola",
      "is_correct": true
    },
    {
      "text": "an ellipse",
      "is_correct": false
    },
    {
      "text": "a circle",
      "is_correct": false
