  "question": {
    "text": "Suppose <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>y</mi><mo>&#8901;</mo><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mi>sin</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></mfenced><mo>+</mo><mi>sin</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mi>y</mi></mrow></mfenced><mo>,</mo><mo>&#160;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>x</mi></mfenced><mo>&#8804;</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></math> and <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>y</mi></mrow></mfenced><mo>&#8804;</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>.&nbsp;If <math><mi>y</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mo>-</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>, then <math><mi>y</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math> is"
  },
