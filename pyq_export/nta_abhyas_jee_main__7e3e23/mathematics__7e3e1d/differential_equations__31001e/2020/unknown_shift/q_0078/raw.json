  "solution": {
    "text": "<p>Let,&nbsp;<math><mn>2</mn><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mi>t</mi><mo>&#8658;</mo><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mo>=</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mi>x</mi><mi>t</mi><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup><msup><mi>t</mi><mn>3</mn></msup><mo>&#8658;</mo><mfrac><mn>1</mn><msup><mi>t</mi><mn>3</mn></msup></mfrac><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><msup><mi>t</mi><mn>2</mn></msup></mfrac><mi>x</mi><mo>=</mo><msup><mi>x</mi><mn>3</mn></msup></math><br />Let,&nbsp;<math><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mi>u</mi><mo>&#8658;</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>d</mi><mi>u</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math><br /><math><mfrac><mrow><mi>d</mi><mi>u</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn><mi>x</mi></mrow></mfenced><mi>u</mi><mo>=</mo><mo>-</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></math><br /><math><mi>I.F.</mi><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mo>&#8747;</mo><mn>2</mn><mi>x</mi><mi>d</mi><mi>x</mi></mrow></msup><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mo>&#8658;</mo><mi>u</mi><mo>.</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow>