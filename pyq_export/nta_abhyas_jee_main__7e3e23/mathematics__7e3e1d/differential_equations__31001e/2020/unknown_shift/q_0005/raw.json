    {
      "id": "rNaAW",
      "text": "<math><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi><mo>+</mo><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn></math>",
