  "question": {
    "text": "The differential equation of the curve for which the point of tangency (closer to the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi></math>-axis) divides the segment of the tangent between the coordinate axes in the ratio <math><mn>1</mn><mo>:</mo><mn>2</mn><mo>,</mo></math> is"
  },
  "options": [
    {
      "text": "<math><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi><mo>=</mo><mn>2</mn><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi><mo>=</mo><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi><mo>+</mo><mn>2</mn><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi><mo>+</mo><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    }
  ],
