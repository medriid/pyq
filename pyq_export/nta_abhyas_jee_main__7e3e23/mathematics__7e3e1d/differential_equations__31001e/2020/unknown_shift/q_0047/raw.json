  "correctValue": null,
  "solution": {
    "text": "<math><mfrac><mrow><mi>y</mi><mi>d</mi><mi>y</mi></mrow><mrow><mi>x</mi><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br />Let,&nbsp;<math><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>Y</mi><mo>;</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>X</mi><mo>⇒</mo><mfrac><mrow><mi>y</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>y</mi></mrow><mrow><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>d</mi><mi>Y</mi></mrow><mrow><mi>d</mi><mi>X</mi></mrow></mfrac></math><br />Hence, the equation is <math><mfrac><mrow><mi>d</mi><mi>Y</mi></mrow><mrow><mi>d</mi><mi>X</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>X</mi><mo>+</mo><mi>Y</mi></mrow><mrow><mi>Y</mi><mo>-</mo><mi>X</mi></mrow></mfrac></math><br /><math><mo>⇒</mo><mi>Y</mi><mi>d</mi><mi>Y</mi><mo>-</mo><mi>X</mi><mi>d</mi><mi>X</mi><mo>=</mo><mi>X</mi><mi>d</mi><mi>Y</mi><mo>+</mo><mi>Y</mi><mi>d</mi><mi>X</mi></math><br />On integrating we get <math><mfrac><mrow><msup><mrow><mi>Y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><msup><mrow><mi>X</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mrow><mo stretchy=\"false\">∫</mo><mrow><mi>d</mi><mfenced separators=\"|\"><mrow><mi>X</mi><mi>Y</mi></mrow></mfenced><mo>=</mo><mi>X</mi><mi>Y</mi><mo>+</mo><mi>c</mi></mrow></mrow></math><br />or <math><msup><mrow><mi>Y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>X</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn><mi>X</mi><mi>Y</mi><mo>+</mo><mi>λ</mi></math><br /><math><mo>⇒</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>=</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>λ</mi></math>",
