    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><mn>8</mn><mo>,</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math>",
