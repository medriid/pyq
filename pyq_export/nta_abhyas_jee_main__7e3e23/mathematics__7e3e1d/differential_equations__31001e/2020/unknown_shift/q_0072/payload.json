    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn><mo>,</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": false
