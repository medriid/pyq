    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": true
