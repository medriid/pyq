  "solution": {
    "text": "Given equation can be written as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>d</mi><mi>x</mi><mfenced><msqrt><mi>y</mi></msqrt></mfenced><mo>+</mo><mi>x</mi><mfenced><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><msqrt><mi>y</mi></msqrt></mrow></mfrac><mi>d</mi><mi>y</mi></mrow></mfenced><mo>=</mo><mi>x</mi><mi>d</mi><mi>x</mi></math><br />or <math><mi>d</mi><mfenced separators=\"|\"><mrow><mi>x</mi><msqrt><mi>y</mi></msqrt></mrow></mfenced><mo>=</mo><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi></math><br /><math><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mi>d</mi><mfenced separators=\"|\"><mrow><mi>x</mi><msqrt><mi>y</mi></msqrt></mrow></mfenced><mo>=</mo></mrow></mrow><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>&#8658;</mo><mi>x</mi><msqrt><mi>y</mi></msqrt><mo>=</mo><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mi>C</mi></mrow></mrow></math>"
  }
