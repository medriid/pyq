  ],
  "solution": {
    "text": "<p>Given equation is <math><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mi>y</mi></msqrt></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><msqrt><mi>y</mi></msqrt><mo>=</mo><mi>x</mi></math><br />Let <math><mn>2</mn><msqrt><mi>y</mi></msqrt><mo>=</mo><mi>&#957;</mi></math><br /><math><mo>&#8658;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mi>y</mi></msqrt></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>d</mi><mi>&#957;</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></math><br />Thus, we have <math><mfrac><mrow><mi>d</mi><mi>&#957;</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mi></mi></mrow></mfrac><mo>&#8901;</mo><mi>&#957;</mi><mo>=</mo><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi mathvariant=\"normal\">I</mi><mo>.</mo><mi mathvariant=\"normal\">F</mi><mo>.</mo><mo>=</mo><msup><mi>e</mi><mrow><mo>&#8747;</mo><mfrac><mi>x</mi><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced></mrow></mfrac><mi>d</mi><mi>x</mi></mrow></msup></math><br /><math><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow></mrow></mrow></msup></math><br /><math><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></msup></math><br />Thus, the solution is <math><mi>&#957;</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></msup><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mi>x</mi></mrow></mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></msup><mi></mi><mi>d</mi><mi>x</mi></math><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#957;</mi><mo>&#8901;</mo><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mrow><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></mrow></msup><mo>=</mo><mo>-</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mfrac><mn>3</mn><mn>4</mn></mfrac></msup><mo>+</mo><msup><mi>c</mi><mo>&#34;</mo></msup></math><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msqrt><mi>y</mi></msqrt><mo>=</mo><mo>-</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><msup><mi>c</mi><mo>&#34;</mo></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msqrt><mi>y</mi></msqrt><mo>=</mo><mo>-</mo><mfrac><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mn>3</mn></mfrac><mo>+</mo><msup><mi>c</mi><mi>'</mi></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msqrt><mn>9</mn><mi>y</mi></msqrt><mo>=</mo><mo>-</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mo>+</mo><mi>c</mi><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfenced><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></math><br /><math><mo>&#8658;</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mo>&#8756;</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> is an even function</p>"
  }
