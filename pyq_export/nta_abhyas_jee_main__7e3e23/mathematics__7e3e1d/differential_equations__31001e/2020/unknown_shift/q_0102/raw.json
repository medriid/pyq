    {
      "id": "jjjAL",
      "text": "<math><mi>x</mi><mi>y</mi><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>x</mi><mo>+</mo><mi>C</mi></math>",
