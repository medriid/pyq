    "text": "<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mn>2</mn><mi>x</mi><mfenced separators=\"|\"><mrow><mi>y</mi><mo>-</mo><mn>1</mn></mrow></mfenced></math><br /><math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mn>2</mn><mi>x</mi><mi>y</mi><mo>=</mo><mn>2</mn><mi>x</mi></math><br /><math><mi mathvariant=\"normal\">&#921;</mi><mo>.</mo><mi>F</mi><mo>.</mo><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mn>2</mn><mi>x</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi></mrow></mrow></mrow></msup><mo>=</mo><msup><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow><mrow><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup></math><br /><math><mi>y</mi><mo>&#8901;</mo><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mn>2</mn><mi>x</mi><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><math><mi>y</mi><mo>&#8901;</mo><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mo>+</mo><mi>C</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo mathvariant=\"italic\">&#8757;</mo><mi>y</mi><mfenced separators=\"|\"><mn>0</mn></mfenced><mo>=</mo><mn>1</mn><mo>&#8658;</mo><mn>1</mn><mo>=</mo><mn>1</mn><mo>+</mo><mi>C</mi><mo>&#8658;</mo><mi>C</mi><mo>=</mo><mn>0</mn></math><br />Hence, the solution is&nbsp;<math><mi>y</mi><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mro