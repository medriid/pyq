      "text": "<math><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi>y</mi></mrow><mrow><mn>3</mn></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></math>",
