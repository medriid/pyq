    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>l</mi></mrow><mrow><mi>n</mi></mrow></mfrac><mo>,</mo><mo>-</mo><mfrac><mrow><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>m</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mfenced></math>",
