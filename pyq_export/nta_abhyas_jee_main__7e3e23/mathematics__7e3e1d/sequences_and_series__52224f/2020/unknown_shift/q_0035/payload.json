  "question": {
    "text": "If <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>3</mn><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>,</mo><mn>3</mn><mo>,</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfenced></math> are the first three terms of an arithmetic progression, then&nbsp;the sum of the first five terms can be"
  },
  "options": [
    {
      "text": "<math><mn>5</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>10</mn></math>",
