    "text": "<math><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>25</mn><mo>;</mo></math> <math><mn>2</mn><mi>a</mi><mo>=</mo><mn>2</mn><mo>+</mo><mi>b</mi><mo>;</mo></math> <math><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>18</mn><mi>b</mi></math><br /><math><mo>&#8658;</mo><mn>2</mn><mi>a</mi><mo>+</mo><mn>2</mn><mi>b</mi><mo>+</mo><mn>2</mn><mi>c</mi><mo>=</mo><mn>5</mn><mn>0</mn></math><br /><math><mo>&#8658;</mo><mn>2</mn><mo>+</mo><mi>b</mi><mo>+</mo><mn>2</mn><mi>b</mi><mo>+</mo><mn>2</mn><mi>c</mi><mo>=</mo><mn>5</mn><mn>0</mn></math><br /><math><mo>&#8658;</mo><mn>3</mn><mi>b</mi><mo>+</mo><mn>2</mn><mi>c</mi><mo>=</mo><mn>48</mn><mo>&#8658;</mo><mfrac><mrow><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>6</mn></mrow></mfrac><mo>+</mo><mn>2</mn><mi>c</mi><mo>=</mo><mn>4</mn><mn>8</mn></math><br /><math><mo>&#8658;</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>12</mn><mi>c</mi><mo>-</mo><mn>48</mn><mo>&#215;</mo><mn>6</mn><mo>=</mo><mn>0</mn><mo>&#8658;</mo><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>12</mn><mi>c</mi><mo>-</mo><mn>24</mn><mo>&#215;</mo><mn>12</mn><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mi>c</mi><mo>+</mo><mn>24</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>c</mi><mo>-</mo><mn>12</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mi>c</mi><mo>=</mo><mn>12</mn><mo>,</mo><mo>-</mo><mn>24</mn><mo>&#8658;</mo><mi>c</mi><mo>=</mo><mn>1</mn><mn>2</mn></math>&nbsp;(between <math><mn>2</mn></math> and <math><mn>18</mn></math> )<br /><math><mo>&#8658;</mo><mi>b</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>18</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>144</mn></mrow><mrow><mn>18</mn></mrow></mfrac><mo>=</mo><mn>8</mn></math><br /><math><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mfr