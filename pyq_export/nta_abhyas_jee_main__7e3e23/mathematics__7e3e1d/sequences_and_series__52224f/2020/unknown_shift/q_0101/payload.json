  "solution": {
    "text": "We have, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>a</mi></mfenced><mo>&#60;</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>b</mi></mfenced><mo>&#60;</mo><mn>1</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>a</mi><mi>b</mi></mrow></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>a</mi></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>b</mi></mfenced><mo>&#60;</mo><mn>1</mn></math><br /><br />Now, <math><mi>a</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfenced><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><msup><mrow><mi>b</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfenced><mo>+</mo><mo>&#8230;</mo></math><br /><br /><math><mi>&#160;</mi><mo>=</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>6</mn></mrow></msup><mo>+</mo><mo>&#8230;</mo></mrow></mfenced></mrow></mfenced><mo>+</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mi>a</mi><mi>b</mi><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi>a</mi><mi>b</mi></mrow></mfenced></mrow><mrow><