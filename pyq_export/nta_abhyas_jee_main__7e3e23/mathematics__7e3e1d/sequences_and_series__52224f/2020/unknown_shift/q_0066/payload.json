  "question": {
    "text": "The arithmetic mean of two numbers is <math><mn>18</mn><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac></math> and the positive square root of their product is <math><mn>15</mn><mo>.</mo></math> The larger of the two numbers is"
  },
  "options": [
    {
      "text": "<math><mn>24</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>25</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>20</mn></math>",
      "is_correct": false
