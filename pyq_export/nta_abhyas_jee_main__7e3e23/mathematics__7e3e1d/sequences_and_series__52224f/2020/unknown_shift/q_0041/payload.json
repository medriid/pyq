  "solution": {
    "text": "<math><msub><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>r</mi><mo>,</mo><mi></mi><msub><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>=</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><msub><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>&gt;</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>2</mn><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br /><math><mo>⇒</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&gt;</mo><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>r</mi><mo>+</mo><mn>2</mn><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br /><math><mo>⇒</mo><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mi>r</mi><mo>-</mo><mn>2</mn><mo>&gt;</mo><mn>0</mn></math><br /><math><mo>⇒</mo><mfenced separators=\"|\"><mrow><mi>r</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>&gt;</mo><mn>0</mn></math><br /><math><mo>⇒</mo><mi>r</mi><mo>&lt;</mo><mo>-</mo><mn>1</mn></math> or <math><mi>r</mi><mo>&gt;</mo><mn>2</mn></math>"
