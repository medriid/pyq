  "correct_answer": "3.54",
  "solution": {
    "text": "Let,&nbsp;<math><mi>S</mi><mo>=</mo><mn>3</mn><mo>+</mo><mn>7</mn><mo>+</mo><mn>13</mn><mo>+</mo><mn>21</mn><mo>+</mo><mn>31</mn><mo>+</mo><mn>43</mn><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>n</mi></mrow></msub></math><br />&nbsp; &nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>S</mi><mo>=</mo><mo>&#160;</mo><mo>&#160;</mo><mo>&#160;</mo><mn>3</mn><mo>+</mo><mn>7</mn><mo>+</mo><mn>13</mn><mo>+</mo><mn>21</mn><mo>+</mo><mn>31</mn><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>T</mi><mi>n</mi></msub></math><br /><br />Subtracting both the equations, we get,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>=</mo><mn>3</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mo>+</mo><mn>6</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>10</mn><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><mfenced separators=\"|\"><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>-</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msub></mrow></mfenced></mrow></mfenced><mo>-</mo><msub><mi>T</mi><mi>n</mi></msub></math><br /><br /><math><mo>&#8658;</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><mn>3</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mo>+</mo><mn>6</mn><mo>+</mo><mn>8</mn><mo>+</mo><mn>10</mn><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></mfenced><mo>=</mo><mn>3</mn><mo>+</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>8</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mn>2</mn></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>3</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>4</mn><mo>+</mo><mi>n</mi><mo>-</mo><mn>2</mn></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>3</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>3</mn><mo>+</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>n</mi><mo>-</mo><mn>2</mn></math><br /><br /><math><mo>=</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi>n</mi><mo>+</mo><mn>1</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mi>n</mi></msub><mo>=</mo><mi mathvariant=\"normal\">&#931;</mi><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><mi mathvariant=\"normal\">&#931;</mi><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mi mathvariant=\"normal\">&#931;</mi><mi>n</mi><mo>+</mo><mi mathvariant=\"normal\">&#931;</mi><mn>1</mn></math><br /><br /><math><mo>=</mo><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>6</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>n</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mi>n</mi></math><br /><br />If <math><mi>n</mi><mo>=</mo><mn>50</mn><mo>,</mo></math> <math><msub><mrow><mi>S</mi></mrow><mrow><mn>50</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>50</mn><mo>&#215;</mo><mn>51</mn><mo>&#215;</mo><mn>10