  "solution": {
    "text": "<p><math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi></mi><mo>⇒</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced></math><br /><math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math>, <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfenced></math><br />Given <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>3</mn></mrow></mfenced><mo>,</mo><mi></mi><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>,</mo><mi></mi><mi>f</mi><mo>(</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo>)</mo></math> are in A.P.<br /><math><mo>⇒</mo><mn>2</mn><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfenced></math><br /><img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/5d0f0b5f-44d3-476a-93b8-cde64eef7276.png\" style=\"max-width:100%; object-fit:contain\" style=\"width:2.08681in;height:0.58681in\" /><br />Case <math><mn>1</mn></math>: <math><mi>x</mi><mo>&lt;</mo><mo>-</mo><mn>2</mn></math><br /><math><mo>-</mo><mi>x</mi><mo>+</mo><mn>2</mn><mo>-</mo><mi>x</mi><mo>-</mo><mn>2</mn><mo>=</mo><mo>-</mo><mn>2</mn><mi>x</mi><mi></mi><mo>⇒</mo><mn>0</mn><mo>=</mo><mn>0</mn></math>