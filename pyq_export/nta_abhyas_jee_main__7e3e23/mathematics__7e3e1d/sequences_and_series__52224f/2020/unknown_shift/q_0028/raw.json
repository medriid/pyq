  "solution": {
    "text": "Let,&nbsp;<math><mi mathvariant=\"normal\">x</mi><mo>=</mo><msqrt><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>1</mn></msqrt><mi mathvariant=\"normal\"></mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">y</mi><mo>=</mo><msqrt><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>-</mo><mn>1</mn></msqrt><mo>⇒</mo><msup><mi mathvariant=\"normal\">x</mi><mn>2</mn></msup><mo>+</mo><msup><mi mathvariant=\"normal\">y</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mi mathvariant=\"normal\">x</mi></math><br /><math><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn></math><br />Also, <math><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">y</mi><mo>=</mo><msqrt><mn>4</mn><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn></msqrt></math><br />So,<br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">n</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">y</mi></mrow><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mi mathvariant=\"normal\">y</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><msup><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi mathvariant=\"normal\">n</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfenced></math><br />Substituting <math><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>1</mn></math> to <math><mn>40,</mn></math> we get<br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mrow><mn>3</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><mo>-</mo><msup><mrow><mn>1</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfenced></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mrow><mn>5</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><mo>-</mo><msup><mrow><mn>3</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfenced></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mrow><mn>7</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><mo>-</mo><msup><mrow><mn>5</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfenced></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>40</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mrow><mn>81</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><mo>-</mo><msup><mrow><mn>79</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfenced></math><br /><math><mo>⇒</mo><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>40</mn></mrow></munderover><mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msup><mrow><mn>81</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup><mo>-</mo><msup><mrow><mn>1</mn></mrow><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfenced></mrow></mrow><mo>=</mo><mfrac><mrow><mn>729</mn><mo>-</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>364</mn></math>",
