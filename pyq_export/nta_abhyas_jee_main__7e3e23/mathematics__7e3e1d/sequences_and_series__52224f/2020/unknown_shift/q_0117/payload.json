th><mi>r</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>16</mn></mrow><mrow><mn>1</mn><mo>-</mo><msqrt><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></msqrt></mrow></mfrac><mo>=</mo><mn>32</mn></math><br />"
