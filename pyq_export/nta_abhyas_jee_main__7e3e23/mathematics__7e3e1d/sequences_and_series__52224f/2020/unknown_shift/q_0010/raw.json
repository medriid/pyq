  "solution": {
    "text": "<p>Let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>-</mo><mi>d</mi><mo>,</mo><mo>&#160;</mo><mi>a</mi><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi>a</mi><mo>+</mo><mi>d</mi></math>&nbsp;are three numbers in A.P.</p><p>Given,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>d</mi></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mi>a</mi></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>d</mi></mrow></mfenced><mo>=</mo><mn>9</mn><mo>&#8658;</mo><mi>a</mi><mo>=</mo><mn>3</mn></math><br />and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>d</mi></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>d</mi></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mn>35</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><mn>35</mn><mo>&#8658;</mo><mi>d</mi><mo>=</mo><mo>&#177;</mo><mn>2</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>3</mn><mo>,</mo><mo>&#160;</mo><mi>d</mi><mo>=</mo><mn>2</mn><mo>&#8658;</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>.</mo></math><br /><math><msub><mrow><mi>S</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>2</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mn>2</mn></mrow></mfenced><mo>=</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>3</mn><mo>,</mo><mo>&#160;</mo><mi>d</mi><mo>=</mo><mo>-</mo><mn>2</mn><mo>&#8658;</mo><mn>5</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>1</mn><mo>,</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>.</mo></math><br /><math><msub><mrow><mi>S</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>10</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn></mrow></mfenced></mrow></mfenced><mo>=</mo><mi>n</mi><mfenced separators=\"|\"><mrow><mn>5</mn><mo>-</mo><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></math><br /><math><mo>=</mo><mi>n</mi><mfenced separators=\"|\"><mrow><mn>6</mn><mo>-</mo><mi>n</mi></mrow></mfenced></math></p>",
