  ],
  "solution": {
    "text": "We have,<br /><math><mn>2</mn><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>x</mi><mo>+</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>+</mo><mn>2</mn><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math><br /><math><mo>&#8658;</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac><mo>.</mo></math><br />Now, <math><mn>0</mn><mo>&#8804;</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>&#60;</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mn>0</mn><mo>&#8804;</mo><mfrac><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac><mo>&#60;</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mn>0</mn><mo>&#8804;</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>&#60;</mo><mn>2</mn><mo>&#8658;</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn></math><br />for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\" separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mfenced open=\"{\" close=\"}\" separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>0</mn></math><br />for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\" separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mfenced open=\"{\" close=\"}\" separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math><br />Thus,&nbsp;<math><mi>x</mi><mo>=</mo><mn>0</mn></math> and <math><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mn>.</mn></math>"
  }
