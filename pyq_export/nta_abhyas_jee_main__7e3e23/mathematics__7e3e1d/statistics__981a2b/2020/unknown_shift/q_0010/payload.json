  "question": {
    "text": "Coefficient of variation of two distributions are <math><mn>60</mn><mi>%</mi></math> and <math><mn>75</mn><mi>%</mi><mo>,</mo></math> and their standard deviation are <math><mn>18</mn></math> and <math><mn>15</mn></math> respectively, then their arithmetic means respectively are"
  },
  "options": [
    {
      "text": "<math><mn>30</mn><mo>,</mo><mi></mi><mn>30</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>30</mn><mo>,</mo><mi></mi><mn>20</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>20</mn><mo>,</mo><mi></mi><mn>30</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>20</mn><mo>,</mo><mi></mi><mn>20</mn></math>",
      "is_correct": false
