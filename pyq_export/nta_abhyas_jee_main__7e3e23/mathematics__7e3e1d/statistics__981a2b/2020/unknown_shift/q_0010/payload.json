  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Given, <math><mi mathvariant=\"normal\">C</mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>60</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><msub><mrow><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>75</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><msub><mrow><mi mathvariant=\"normal\">σ</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>18</mn></math> and <math><msub><mrow><mi>σ</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>15</mn></math>  <br/>Let <math><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>1</mn></mrow></msub></math> and <math><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>2</mn></mrow></msub></math> be the means of <math><msup><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">t</mi></mrow></msup></math> and <math><msup><mrow><mn>2</mn></mrow><mrow><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi></mrow></msup></math> distribution respectively. <br/>Then, <math><mi mathvariant=\"normal\">C</mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">σ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>×</mo><mn>100</mn><mi></mi><mo>⇒</mo><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>18</mn><mo>×</mo><mn>100</mn></mrow><mrow><mn>60</mn></mrow></mfrac><mo>=</mo><mn>30</mn></math>  <br/><math><mi mathvariant=\"normal\">C</mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>σ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>×</mo><mn>100</mn><mo>⇒</mo><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>15</mn><mo>×</mo><mn>100</mn></mrow><mrow><mn>75</mn></mrow></mfrac><mo>=</mo><mn>20</mn></math>  <br/>Hence, <math><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>30</mn></math> and <math><mi></mi><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>20</mn></math>"
  }
