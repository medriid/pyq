  "solution": {
    "text": "Given,&nbsp;<math><mi>n</mi><mover accent=\"false\"><mrow><mi>x</mi></mrow><mo>¯</mo></mover><mo>=</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msub></math><br />Now, new observations are <math><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>2</mn><mo>,</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>2.2</mn><mo>,</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><msub><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>+</mo><mn>2</mn><mo>.</mo><mi>n</mi></math><br /><math><mo>∴</mo></math> new mean<br /><math><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>2.2</mn></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><mn>2.3</mn></mrow></mfenced><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>+</mo><mn>2</mn><mo>.</mo><mi>n</mi></mrow></mfenced></mrow><mrow><mi>n</mi></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msub></mrow><mrow><mi>n</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><mi>n</mi></mrow></mfenced></mrow><mrow><mi>n</mi></mrow></mfrac></math><br /><math><mo>=</mo><mover accent=\"false\"><mrow><mi>x</mi></mrow><mo>¯</mo></mover><mo>+</mo><mfrac><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></mfrac></math>"
