  "solution": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn></math> observations are <math><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>&#8230;</mo><mo>&#8230;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>15</mn></mrow></msub></math><br /><br /><math><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>&#8230;</mo><mo>&#8230;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>15</mn></mrow></msub></mrow><mrow><mn>15</mn></mrow></mfrac><mo>=</mo><mn>15</mn></math><br /><br />If <math><msub><mrow><mi>x</mi></mrow><mrow><mn>15</mn></mrow></msub><mo>=</mo><mn>15</mn></math><br /><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>&#772;</mo></mover></mrow><mrow><mi>n</mi><mi>e</mi><mi>w</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>&#8230;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>15</mn></mrow></msub><mo>-</mo><mn>15</mn><mo>+</mo><mn>6</mn><mo>+</mo><mn>8</mn></mrow><mrow><mn>16</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>224</mn></mrow><mrow><mn>16</mn></mrow></mfrac><mo>=</mo><mn>14</mn></math><br /><br /><math><mfrac><mrow><mrow><mo stretchy=\"false\">&#8721;</mo><mrow><msubsup><mrow><mi>x</mi></mrow><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mrow></mrow><mrow><mn>15</mn></mrow></mfrac><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>&#772;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>5</mn></math> <math><mo>&#8658;</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>&#8230;</mo><mo>&#8230;</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>14</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><mo>(</mo><mn>15</mn><msup><mrow><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>230</mn><mo>&#215;</mo><mn>15</mn></math><br /><br /><math><mo>&#8658;</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>&#8230;</mo><mo>&#8230;</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>14</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>=</mo><mn>3225</mn></math><br /><br />New variance = <math><mfrac><mrow><msubsup><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>&#8230;</mo><mo>&#8230;</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>14</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><msup><mrow><mn>6</mn></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mn>8</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>16</mn></mrow></mfrac><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>&#772;</mo></mover></mrow><mrow><mi>n</mi><mi>e</mi><mi>w</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>3325</mn></mrow><mrow><mn>16</mn></mrow></mfrac><mo>-</mo><mn>196</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>&#160;</mo><mn>11</mn><mo>.</mo><mn>8125</mn></math>"
