    "text": "<math><mfrac><mrow><mrow><munderover><mo stretchy=\"true\">&#8721;</mo><mrow><mi mathvariant=\"normal\">i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">n</mi></mrow></munderover><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mrow></mrow><mrow><mi mathvariant=\"normal\">n</mi></mrow></mfrac><mo>=</mo><mn>7</mn></math>(given)<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#8721;</mo><msubsup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><mo>&#8721;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi></msub><mo>+</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>7</mn><mi mathvariant=\"normal\">n</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#8721;</mo><msubsup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>+</mo><mn>2</mn><mo>&#8721;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi></msub><mo>=</mo><mn>6</mn><mi mathvariant=\"normal\">n</mi></math> &hellip; (1)<br />Also,&nbsp;<math><mfrac><mrow><mrow><mo stretchy=\"false\">&#8721;</mo><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mrow></mrow><mrow><mi mathvariant=\"normal\">n</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math> (given)<br /><math><mo>&#8658;</mo><mo>&#8721;</mo><msubsup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow><mrow><mn>2</mn></mrow></msubsup><mo>-</mo><mn>2</mn><mo>&#8721;</mo><msub><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub><mo>+</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>3</mn><mi mathvariant=\"normal\">n</mi></math><br /><math><mo>&#8658;</mo><mo>&#8721;</mo><msubsup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow><mrow><mn>2</mn></mrow></msubsup><mo>-</mo><mn>2</mn><mo>&#8721;</mo><msub><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi></mrow></msub><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">n</mi></math> &hellip; (2)<br />From <math><mo>(</mo><mn>1</mn><mo>)</mo></math> and <math><mo>(</mo><mn>2</mn><mo>)</mo></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8721;</mo><msubsup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup><mo>=</mo><mn>4</mn><mi mathvariant=\"normal\">n</mi><mo>,</mo><mo>&#160;</mo><mo>&#8721;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi></msub><mo>=</mo><mi mathvariant=\"normal\">n</mi></math><br />Standard deviation<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mfrac><mrow><mo>&#8721;</mo><msubsup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi><mn>2</mn></msubsup></mrow><mi mathvariant=\"normal\">n</mi></mfrac><mo>-</mo><msup><mfenced separators=\"|\"><mfrac><mrow><mo>&#8721;</mo><msubsup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">i</mi><mrow/></msubsup></mrow><mi mathvariant=\"normal\">n</mi></mfrac></mfenced><mn>2</mn></msup></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">n</mi></mrow><mi mathvariant=\"normal\">n</mi></mfrac><mo>-</mo><mn>1</mn></msqrt><mo>=</mo><msqrt><mn>3</mn></msqrt></math>",
