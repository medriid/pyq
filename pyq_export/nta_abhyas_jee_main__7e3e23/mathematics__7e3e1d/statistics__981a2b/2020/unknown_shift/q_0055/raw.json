  "solution": {
    "text": "Let,&nbsp;<math><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\"></mi><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>…</mo><mo>…</mo><mo>.</mo><mo>.</mo><msub><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msub></math> be <math><mi>n</mi></math> items.<br />Then,&nbsp;<math><mover accent=\"true\"><mrow><mi>x</mi></mrow><mo>-</mo></mover><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mrow><mo stretchy=\"false\">∑</mo><mrow><msub><mrow><mi>x</mi></mrow><mrow><mi>i</mi></mrow></msub></mrow></mrow></math> .<br />Let,&nbsp;<math><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mi>n</mi><mo>,</mo><mi mathvariant=\"normal\"></mi><msub><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mi>n</mi><mo>-</mo><mn>1</mn></math><br /><math><msub><mrow><mi>y</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>=</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><mi>n</mi><mo>-</mo><mn>2</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>…</mo><mo>…</mo><mo>.</mo><mo>,</mo><mi mathvariant=\"normal\"></mi><msub><mrow><mi>y</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>=</mo><msub><mrow><mi>x</mi></mrow><mrow><mi>n</mi></mrow></msub><mo>+</mo><mn>1</mn></math><br />Then, the mean of the new series is<br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mrow><mo stretchy=\"false\">∑</mo><mrow><msub><mrow><mi>y</mi></mrow><mrow><mi>i</mi></mrow></msub></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mrow><mo stretchy=\"false\">∑</mo><mrow><msub><mrow><mi>x</mi></mrow><mrow><mi>i</mi></mrow></msub></mrow></mrow><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mfenced separators=\"|\"><mrow><mi>n</mi><mo>+</mo><mi>n</mi><mo>-</mo><mn>1</mn><mo>+</mo><mi>n</mi><mo>-</mo><mn>2</mn><mo>+</mo><mo>.</mo><mo>…</mo><mo>…</mo><mo>.</mo><mn>1</mn></mrow></mfenced></math><br /><math> <mrow> <mo>=</mo><mover accent=\"true\"> <mi>x</mi> <mo>¯</mo> </mover> <mo>+</mo><mfrac> <mn>1</mn> <mi>n</mi> </mfrac> <mo>⋅</mo><mfrac> <mrow> <mi>n</mi><mfenced> <mrow> <mi>n</mi><mo>+</mo><mn>1</mn></mrow> </mfenced></mrow> <mn>2</mn> </mfrac> <mo>=</mo><mover accent=\"true\"> <mi>x</mi> <mo>¯</mo> </mover> <mo>+</mo><mfrac> <mrow> <mfenced> <mrow> <mi>n</mi><mo>+</mo><mn>1</mn></mrow> </mfenced></mrow> <mn>2</mn> </mfrac> </mrow> </math>",
