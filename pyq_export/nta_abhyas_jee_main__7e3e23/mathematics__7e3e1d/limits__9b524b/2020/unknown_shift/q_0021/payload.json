  "solution": {
    "text": "<p>Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">&#8734;</mi></mrow></munder><msup><mfenced open=\"[\" close=\"]\" separators=\"|\"><mfrac><msup><mi>e</mi><mn>2</mn></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mn>2</mn><mi>x</mi></mfrac></mrow></mfenced><mi>x</mi></msup></mfrac></mfenced><mfrac><mi mathvariant=\"normal\">x</mi><mn>2</mn></mfrac></msup></math></p><p>Put&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mi>x</mi></mfrac><mo>=</mo><mi>y</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><munder><mi>lim</mi><mrow><mi>y</mi><mo>&#8594;</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><msup><mfenced open=\"[\" close=\"]\" separators=\"|\"><mfrac><msup><mi>e</mi><mn>2</mn></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mi>y</mi></mrow></mfenced><mfrac><mn>1</mn><mi>y</mi></mfrac></msup></mfrac></mfenced><mfrac><mn>1</mn><mrow><mn>2</mn><mi>y</mi></mrow></mfrac></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><msup><mi>e</mi><mrow><munder><mi>lim</mi><mrow><mi>y</mi><mo>&#8594;</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mfrac><mn>1</mn><mrow><mn>2</mn><mi>y</mi></mrow></mfrac><mi>ln</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mfrac><msup><mi>e</mi><mn>2</mn></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mi>y</mi></mrow></mfenced><mfrac><mn>1</mn><mi>y</mi></mfrac></msup></mfrac></mfenced></mrow></msup><mo>=</mo><msup><mi>e</mi><mi>M</mi></msup></math>&nbsp;(let)<br />Now, we have,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi><mo>=</mo><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>y</mi><mo>&#8594;</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mfrac><mn>1</mn><mrow><mn>2</mn><mi>y</mi></mrow></mfrac><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mfrac><msup><mi>e</mi><mn>2</mn></msup><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mi>y</mi></mrow></mfenced><mfrac><mn>1</mn><mi>y</mi></mfrac></msup></mfrac></mfenced><mspace linebreak=\"newline\"/><mo>=</mo><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>y</mi><mo>&#8594;</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mfrac><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><msup><mi>e</mi><mn>2</mn></msup><mo>-</mo><mfrac><mn>1</mn><mi>y</mi></mfrac><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mi>y</mi></mrow></mfenced></mrow><mrow><mn>2</mn><mi>y</mi></mrow></mfrac></math><br /><math><mo>=</mo><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>y</mi><mo>&#8594;</mo><msup><mrow><mn>0</mn></mrow><mrow><mo>+</mo></mrow></msup></mrow></munder><mfrac><mrow><mn>2</mn><mi>y</mi><mo>-</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mi>y</mi></mrow></mfenced></mrow><mrow><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><math><mo>=</mo><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>y</mi><mo>&#8594;</mo><msup><mrow><mn>0</mn></mrow><mrow><mo>+</mo></mrow></msup></mrow></munder><mfrac><mrow><mn>2</mn><mi>y</mi><mo>-</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>y</mi><mo