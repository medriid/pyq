  "correct_answer": "10",
  "solution": {
    "text": "<p>Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow></munder><mo>&#8289;</mo><msup><mfenced separators=\"|\"><mrow><msup><mn>1</mn><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup><mo>+</mo><msup><mn>2</mn><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>+</mo><msup><mn>10</mn><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup></mrow></mfenced><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></msup></math></p><p>Putting&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac><mo>=</mo><mi>y</mi></math>, we get,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><munder><mi>lim</mi><mrow><mi>y</mi><mo>&#8594;</mo><mi>&#8734;</mi></mrow></munder><mo>&#8289;</mo><msup><mfenced separators=\"|\"><mrow><msup><mn>1</mn><mi>y</mi></msup><mo>+</mo><msup><mn>2</mn><mi>y</mi></msup><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>+</mo><msup><mn>10</mn><mi>y</mi></msup></mrow></mfenced><mfrac><mn>1</mn><mi>y</mi></mfrac></msup></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"/><br /><math><mo>=</mo><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>y</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">&#8734;</mi></mrow></munder><mi mathvariant=\"normal\"></mi><mn>10</mn><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>10</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mi>y</mi></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn></mrow><mrow><mn>10</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mi>y</mi></mrow></msup><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>10</mn></mrow><mrow><mn>10</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mi>y</mi></mrow></msup></mrow></mfenced></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>y</mi></mrow></mfrac></mrow></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>10</mn><msup><mfenced separators=\"|\"><mrow><mn>0</mn><mo>+</mo><mn>0</mn><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>+</mo><mn>1</mn></mrow></mfenced><mn>0</mn></msup><mo>=</mo><mn>10</mn></math></p>"
  }
