  "question": {
    "text": "The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow></munder><mo>&#8289;</mo><msup><mfenced separators=\"|\"><mrow><msup><mn>1</mn><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup><mo>+</mo><msup><mn>2</mn><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup><mo>+</mo><mo>.</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>+</mo><msup><mn>10</mn><mfrac><mn>1</mn><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup></mrow></mfenced><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow></msup></math> is equal to"
  },
