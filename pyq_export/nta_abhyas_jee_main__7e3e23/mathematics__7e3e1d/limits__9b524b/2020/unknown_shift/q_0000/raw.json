  "solution": {
    "text": "Let,&nbsp;<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac></math><br />and <math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac></math><br />Clearly,&nbsp;<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>&#8594;</mo><mn>1</mn></math> and <math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>&#8594;</mo><mi mathvariant=\"normal\">&#8734;</mi></math> as <math><mi>x</mi><mo>&#8594;</mo><mn>0</mn><mo>.</mo></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mo>&#8289;</mo><msup><mfenced separators=\"|\"><mfrac><mrow><mn>1</mn><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></mfenced><mfrac><mn>2</mn><mrow><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></msup><mo>=</mo><msup><mi>e</mi><mrow><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mn>2</mn><mrow><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac><mo>&#8289;</mo><msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac><mo>-</mo><mn>1</mn></mrow></mfenced><mrow/></msup></mrow></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mi>using</mi><mo>&#160;</mo><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mi>a</mi></mrow></munder><mo>&#8289;</mo><msup><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mrow><mi>g</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mi>a</mi></mrow></munder><mi>g</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>&#8289;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>-</mo><mn>1</mn></mrow></mfenced></mrow></msup><mi>for</mi><mo>&#160;</mo><msup><mn>1</mn><mi mathvariant=\"normal\">&#8734;</mi></msup><mo>&#160;</mo><mi>form</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>e</mi><mrow><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mo>&#8289;</mo><mfrac><mn>2</mn><mrow><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac><mfenced separators=\"|\"><mfrac><mrow><mi>tan</mi><mo>&#8289;</mo><mi>x</mi><mo>-</mo><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></mfenced></mrow></msup><mo>=</mo><msup><mi>e</mi><mrow><munder><mi>lim</mi><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mo>&#8289;</mo><mfrac><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>cos</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfenced></mrow><mrow><mi>cos</mi><mo>&#8289;</mo><mi>x</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfenced></mrow></mfrac></mrow></msup><mspace linebreak=\"newline\"/><mo>=</mo><msup><mi>e</mi><mn>0</mn></msup><mo>=</mo><mn>1</mn></math>",
