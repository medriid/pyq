  "solution": {
    "text": "<p>Let,&nbsp;<math><mi>x</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac><mo>-</mo><mi>t</mi></math>, then<br /><math><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>t</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mi>t</mi></mrow></mfenced></mrow><mrow><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msqrt><mn>3</mn></msqrt><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac><mo>-</mo><mi>t</mi></mrow></mfenced></mrow></mfenced></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>t</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mrow><mi>sin</mi><mo>&#8289;</mo><mi>t</mi></mrow><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msqrt><mn>3</mn></msqrt><mfenced separators=\"|\"><mfrac><mrow><mn>1</mn><mo>-</mo><msqrt><mn>3</mn></msqrt><mi>tan</mi><mo>&#8289;</mo><mi>t</mi></mrow><mrow><msqrt><mn>3</mn></msqrt><mo>+</mo><mi>tan</mi><mo>&#8289;</mo><mi>t</mi></mrow></mfrac></mfenced></mrow></mfenced></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><munder><mi>lim</mi><mrow><mi>t</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mrow><mi>sin</mi><mo>&#8289;</mo><mi>t</mi><mfenced separators=\"|\"><mrow><msqrt><mn>3</mn></msqrt><mo>+</mo><mi>tan</mi><mi>t</mi></mrow></mfenced></mrow><mrow><mn>4</mn><mi>tan</mi><mo>&#8289;</mo><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>4</mn></mfrac><mo>=</mo><mi>&#955;</mi></math></p><p>Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>120</mn><msup><mi>&#955;</mi><mn>2</mn></msup><mo>=</mo><mn>120</mn><mo>&#215;</mo><mfrac><mn>3</mn><mn>16</mn></mfrac><mo>=</mo><mn>22</mn><mo>.</mo><mn>5</mn></math></p>"
  }
