    {
      "text": "<math><mfenced separators=\"|\"><mrow><msqrt><mn>5</mn></msqrt><mo>,</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac></mrow></mfenced></math>",
