  "solution": {
    "text": "Let,&nbsp;<math><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi><mo>,</mo></mrow></mrow><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfenced></math><br />and <math><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow><mo>,</mo><mn>4</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfenced></math><br />Now, equation of <math><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">Q</mi></math> is <math><mfrac><mrow><mn>4</mn><mi mathvariant=\"normal\">x</mi></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">y</mi></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mn>7</mn></math><br />Equation of <math><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">Q</mi></math> is <math><mfrac><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfrac></math><br /><math><mi mathvariant=\"normal\">Q</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>7</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi><mo>,</mo></mrow></mrow><mn>7</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow></mrow></mfenced></math><br /><math><mo>⇒</mo><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">Q</mi><mo>=</mo><mn>7</mn></math>",
