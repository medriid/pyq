  "question": {
    "text": "The tangent to the ellipse <math><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>25</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>16</mn></mrow></mfrac><mo>=</mo><mn>1</mn></math>&nbsp;at point <math><mi>P</mi></math> lying in the first quadrant meets <math><mi>x</mi></math>-axis at <math><mi>Q</mi></math> and <math><mi>y</mi></math>-axis at <math><mi>R</mi></math>. If the length&nbsp;<math><mi>Q</mi><mi>R</mi></math> is minimum, then the equation of this tangent is",
    "image": null
  },
  "options": [
    {
      "id": "EGMsM",
      "text": "<math><mn>2</mn><mi>x</mi><mo>+</mo><msqrt><mn>5</mn></msqrt><mi>y</mi><mo>=</mo><mn>6</mn><msqrt><mn>5</mn></msqrt></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "pHEFr",
      "text": "<math><msqrt><mn>5</mn></msqrt><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>=</mo><mn>6</mn><msqrt><mn>5</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XA30x",
      "text": "<math><mn>2</mn><mi>x</mi><mo>-</mo><msqrt><mn>5</mn></msqrt><mo>=</mo><mn>6</mn><msqrt><mn>5</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3SVcc",
      "text": "<math><mn>2</mn><msqrt><mn>5</mn></msqrt><mo></mo><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mn>6</mn><msqrt><mn>5</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
