  "question": {
    "text": "Which of the following statement is converse of the statement “If it rains then we will party”?"
  },
  "options": [
    {
      "text": "We will party or it rains",
      "is_correct": false
    },
    {
      "text": "It rains or we will party",
      "is_correct": false
    },
    {
      "text": "We will not party or it rains",
      "is_correct": true
    },
    {
      "text": "We will not party or it does not rain",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Converse of <math><mi>p</mi><mo>→</mo><mi>q</mi></math> is <math><mi>q</mi><mo>→</mo><mi>p</mi><mo>≡</mo><mo>∼</mo><mi>q</mi><mo>∨</mo><mi>p</mi></math>"
  }
