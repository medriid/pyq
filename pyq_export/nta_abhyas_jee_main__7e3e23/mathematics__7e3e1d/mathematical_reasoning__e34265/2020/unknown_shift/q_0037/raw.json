  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi></math> are two statements, then <math><mi>p</mi><mo>&#8744;</mo><mo>&#8764;</mo><mfenced separators=\"|\"><mrow><mi>p</mi><mo>&#8658;</mo><mi>&#160;</mi><mo>&#8764;</mo><mi>q</mi></mrow></mfenced></math> is equivalent to",
    "image": null
  },
  "options": [
    {
      "id": "B9vvn",
      "text": "<math><mi>p</mi><mo>∧</mo><mi>q</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
