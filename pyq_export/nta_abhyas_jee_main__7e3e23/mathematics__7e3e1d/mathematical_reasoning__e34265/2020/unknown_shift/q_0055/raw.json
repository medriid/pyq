  "question": {
    "text": "If <math><mi>p</mi></math>&nbsp;and&nbsp;<math><mi>q</mi></math> are two statements, then which of the following statements is not equivalent to <math><mi>p</mi><mo>⇔</mo><mfenced separators=\"|\"><mrow><mi>p</mi><mo>⇒</mo><mi>q</mi></mrow></mfenced></math>?",
    "image": null
  },
  "options": [
    {
      "id": "72ZM7",
      "text": "<math><mi>p</mi><mo>∧</mo><mi>q</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VKInO",
      "text": "<math><mfenced separators=\"|\"><mrow><mi>p</mi><mo>⇔</mo><mi>q</mi></mrow></mfenced><mo>∧</mo><mfenced separators=\"|\"><mrow><mi>p</mi><mo>∨</mo><mi>q</mi></mrow></mfenced></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "K6hYq",
      "text": "<math><mfenced separators=\"|\"><mrow><mi>q</mi><mo>&#8658;</mo><mi>p</mi></mrow></mfenced><mo>⇔</mo><mi>q</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rA8NG",
      "text": "<math><mfenced separators=\"|\"><mrow><mo>~</mo><mi>q</mi><mo>⇒</mo><mi>p</mi></mrow></mfenced><mo>∧</mo><mfenced separators=\"|\"><mrow><mi>p</mi><mo>⇒</mo><mi mathvariant=\"normal\"></mi><mo>~</mo><mi>q</mi></mrow></mfenced></math>",
      "image": null,
      "isCorrect": true
    }
