  "question": {
    "text": "If <math><mi mathvariant=\"normal\">p</mi></math> and <math><mi mathvariant=\"normal\">q</mi></math> are two logical statements, then <math><mi mathvariant=\"normal\">p</mi><mo>⇒</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">q</mi><mo>⇒</mo><mi mathvariant=\"normal\">p</mi></mrow></mfenced></math> is equivalent to"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">p</mi><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">p</mi><mo>&#8658;</mo><mi mathvariant=\"normal\">q</mi></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">p</mi><mo>⇒</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">p</mi><mo>∨</mo><mi mathvariant=\"normal\">q</mi></mrow></mfenced></math>",
      "is_correct": true
