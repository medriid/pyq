    {
      "text": "<math><mi mathvariant=\"normal\">p</mi><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">p</mi><mo>∧</mo><mi mathvariant=\"normal\">q</mi></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">p</mi><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">p</mi><mo>⇔</mo><mi mathvariant=\"normal\">q</mi></mrow></mfenced></math>",
