      "isCorrect": false
    },
    {
      "id": "jqcR9",
      "text": "<math><mi>T</mi><mo>,</mo><mi>&nbsp;</mi><mi>F</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cONgB",
      "text": "<math><mi>F</mi><mo>,</mo><mi> </mi><mi>T</mi></math>",
      "image": null,
