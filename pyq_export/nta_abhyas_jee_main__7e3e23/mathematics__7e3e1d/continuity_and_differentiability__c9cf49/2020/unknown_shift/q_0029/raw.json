    "text": "Given, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mfenced open=\"{\" close=\"\" separators=\"|\"><mtable><mtr><mtd><mo>-</mo><mn>2</mn><mo>,</mo></mtd><mtd><mo>-</mo><mn>2</mn><mo>&#8804;</mo><mi>x</mi><mo>&#60;</mo><mn>0</mn></mtd></mtr><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mo>,</mo></mtd><mtd><mn>0</mn><mo>&#8804;</mo><mi>x</mi><mo>&#8804;</mo><mn>2</mn></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced></mrow></mfenced><mo>=</mo><mfenced open=\"{\" close=\"\" separators=\"|\"><mtable><mtr><mtd><mn>2</mn><mo>,</mo></mtd><mtd><mo>-</mo><mn>2</mn><mo>&#8804;</mo><mi>x</mi><mo>&#60;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mn>2</mn><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup><mo>,</mo><mo>&#160;</mo><mo>&#160;</mo></mtd><mtd><mn>0</mn><mo>&#8804;</mo><mi>x</mi><mo>&#60;</mo><msqrt><mn>2</mn></msqrt></mtd></mtr><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mo>,</mo></mtd><mtd><msqrt><mn>2</mn></msqrt><mo>&#8804;</mo><mi>x</mi><mo>&#8804;</mo><mn>2</mn></mtd></mtr></mtable></mfenced></math><br />And <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>x</mi></mfenced></mfenced><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi>x</mi><mo>&#8712;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mo>-</mo><mn>2,2</mn></mrow></mfenced></math><br /><math><mo>&#8756;</mo><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>,</mo></mtd><mtd><mo>-</mo><mn>2</mn><mo>&#8804;</mo><mi>x</mi><mo>