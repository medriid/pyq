  "solution": {
    "text": "Continuity at<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mi>x</mi><mo>=</mo><mn>2</mn><mo>&#8658;</mo><mi>p</mi><mfenced separators=\"|\"><mn>2</mn></mfenced><mo>+</mo><mi>q</mi><mo>=</mo><msup><mn>2</mn><mn>2</mn></msup><mo>-</mo><mn>5</mn><mfenced separators=\"|\"><mn>2</mn></mfenced><mo>+</mo><mn>6</mn><mo>&#8658;</mo><mi>q</mi><mo>=</mo><mo>-</mo><mn>2</mn><mi>p</mi></math><br />Continuity at&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>3</mn><mo>&#8658;</mo><mi>a</mi><mfenced separators=\"|\"><mn>9</mn></mfenced><mo>+</mo><mi>b</mi><mfenced separators=\"|\"><mn>3</mn></mfenced><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math><br />Differentiable at <math><mi>x</mi><mo>=</mo><mn>2</mn><mi></mi><mo>&#8658;</mo><mi>p</mi><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>-</mo><mn>5</mn><mo>&#8658;</mo><mi>p</mi><mo>=</mo><mo>-</mo><mn>1</mn></math><br />Differentiable at <math><mi>x</mi><mo>=</mo><mn>3</mn></math> <math><mo>&#8658;</mo><mn>2</mn><mi>a</mi><mfenced separators=\"|\"><mrow><mn>3</mn></mrow></mfenced><mo>+</mo><mi>b</mi><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mn>3</mn></mrow></mfenced><mo>-</mo><mn>5</mn><mo>&#8658;</mo><mn>6</mn><mi>a</mi><mo>+</mo><mi>b</mi><mo>=</mo><mn>1</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>p</mi><mo>=</mo><mo>-</mo><mn>1</mn><mo>,</mo><mo>&#160;</mo><mi>q</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mi>a</mi><mo>=</mo><mfrac><mn>4</mn><mn>9</mn></mfrac><mo>,</mo><mo>&#160;</mo><mi>b</mi><mo>=</mo><mo>-</mo><mfrac><mn>5</mn><mn>3</mn></mfrac></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>p</mi></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>q</mi></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi></mrow></mfrac></mrow><