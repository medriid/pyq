  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>x</mi></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\" separators=\"|\"><mtable><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>:</mo><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">e</mi><mi>n&nbsp;</mi><mi>x&nbsp;</mi><mi mathvariant=\"normal\">i</mi><mi>s&nbsp;</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">a</mi><mi>l&nbsp;</mi></mtd></mtr><mtr><mtd><mn>2</mn><mo>-</mo><mi>x</mi><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>:</mo><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">e</mi><mi>n&nbsp;</mi><mi>x&nbsp;</mi><mi mathvariant=\"normal\">i</mi><mi>s&nbsp;</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">l</mi></mtd></mtr></mtable></mfenced><mo>,</mo></math> then",
