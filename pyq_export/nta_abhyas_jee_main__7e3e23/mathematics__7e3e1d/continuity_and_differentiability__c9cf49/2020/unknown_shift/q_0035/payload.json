mrow></mfenced></mtd></mtr></mtable></mfenced></math><br />Now, check differentiability<br />At <math> <mrow> <mi>x</mi><mo>=</mo><mn>1</mn></mrow></math><br /><math><msup> <mi>f</mi> <mo>&#8242;</mo> </msup> <mfenced> <mrow> <msup> <mn>1</mn> <mo>&#8722;</mo> </msup> </mrow> </mfenced><mo>=</mo><mfenced> <mrow> <msup> <mn>1</mn> <mn>3</mn> </msup> <mo>&#8722;</mo><mn>1</mn></mrow> </mfenced><mfenced> <mrow> <mn>2</mn><mo>&#8722;</mo><mn>6</mn></mrow> </mfenced><mo>+</mo><mfenced> <mrow> <mn>1</mn><mo>&#8722;</mo><mn>6</mn><mo>+</mo><mn>5</mn></mrow> </mfenced><mfenced> <mrow> <mn>3</mn><mo>&#8722;</mo><mn>1</mn></mrow> </mfenced><mo>=</mo><mn>0</mn> </math><br /><math> <mrow> <msup> <mi>f</mi> <mo>&#8242;</mo> </msup> <mfenced> <mrow> <msup> <mn>1</mn> <mo>+</mo> </msup> </mrow> </mfenced><mo>=</mo><mo>&#8722;</mo><mfenced> <mrow> <mn>1</mn><mo>&#8722;</mo><mn>1</mn></mrow> </mfenced><mfenced> <mrow> <mn>2</mn><mo>&#8722;</mo><mn>6</mn></mrow> </mfenced><mo>&#8722;</mo><mfenced> <mrow> <mn>1</mn><mo>&#8722;</mo><mn>6</mn><mo>+</mo><mn>5</mn></mrow> </mfenced><mfenced> <mrow> <mn>3</mn><mo>&#8722;</mo><mn>1</mn></mrow> </mfenced><mo>=</mo><mn>0</mn></mrow> </math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8757;</mo><msup><mi>f</mi><mo>'</mo></msup><mfenced><msup><mn>1</mn><mo>&#8722;</mo></msup></mfenced><mo>=</mo><mi>f</mi><mfenced><msup><mn>1</mn><mo>+</mo></msup></mfenced><mo>&#160;</mo><mo>&#8756;</mo><mo>&#160;</mo><mi>at</mi><mo>&#160;</mo><mi>x</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi>differentiable</mi></math>&nbsp;<br />At <math><mi>x</mi><mo>=</mo><mn>5</mn></math><br /><math> <mrow> <msup> <mi>f</mi> <mo>&#8242;</mo> </msup> <mfenced> <mrow> <msup> <mn>5</mn> <mo>&#8722;</mo> </msup> </mrow> </mfenced><mo>=</mo><mfenced> <mrow> <mn>125</mn><mo>&#8722;</mo><mn>5</mn></mrow> </mfenced><mfenced> <mrow> <mn>10</mn><mo>&#8722;</mo><mn>6</mn></mrow> </mfenced><mo>+</mo><mn>0</mn></mrow> </math><br /><math> <mrow> <msup> <mi>f</mi> <mo>&#82