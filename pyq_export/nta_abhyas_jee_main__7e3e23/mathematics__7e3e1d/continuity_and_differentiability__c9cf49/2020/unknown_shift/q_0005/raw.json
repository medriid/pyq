    "text": "<math><mo>&#8757;</mo><mi mathvariant=\"normal\"></mi><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> is continuous at <math><mi>x</mi><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8756;</mo><mi mathvariant=\"normal\"></mi><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced></math><br /><math><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>2</mn><mi>x</mi></mrow></mrow></mrow><mrow><mi>c</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mn>4</mn><mfenced separators=\"|\"><mrow><msqrt><mi>x</mi><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mo>-</mo><mi>a</mi></mrow></mfenced></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><msqrt><mi>x</mi><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mo>+</mo><mi>a</mi></mrow><mrow><msqrt><mi>x</mi><mo>+</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mo>+</mo><mi>a</mi></mrow></mfrac></mrow></mfenced><mo>=</mo><mi>b</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi>x</mi><mo>&#8594;</mo><mn>0</mn></mrow></munder><mfrac><mn>2</mn><mi>c</mi></mfrac><mo>+</mo><mfrac><mrow><mi>x</mi><mfenced separators=\"|\"><mrow><msqrt><mi>x</mi><mo>+</mo><msup><mi>a</mi><mn>2</mn></msup></msqrt><mo>+</mo><mi>a</mi></mrow></mfenced></mrow><mrow><mn>4</mn>