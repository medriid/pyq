    "text": "Continuity at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>x</mtext><mo>=</mo><mn>0</mn><mo>,</mo></math><br /><math><mtext mathvariant=\"normal\">L</mtext><mo>.</mo><mtext mathvariant=\"normal\">H</mtext><mo>.</mo><mtext mathvariant=\"normal\">L</mtext><mo>.</mo><mtext mathvariant=\"normal\"></mtext><mo>=</mo><munder><mrow><mtext mathvariant=\"normal\">l</mtext><mtext mathvariant=\"normal\">i</mtext><mtext mathvariant=\"normal\">m</mtext></mrow><mrow><mtext mathvariant=\"normal\">h</mtext><mo>&#8594;</mo><msup><mrow><mn>0</mn></mrow><mrow><mo>+</mo></mrow></msup></mrow></munder><mtext mathvariant=\"normal\">f</mtext><mfenced separators=\"|\"><mrow><mn>0</mn><mo>-</mo><mtext mathvariant=\"normal\">h</mtext></mrow></mfenced><mo>=</mo><munder><mrow><mtext mathvariant=\"normal\">l</mtext><mtext mathvariant=\"normal\">i</mtext><mtext mathvariant=\"normal\">m</mtext></mrow><mrow><mtext mathvariant=\"normal\">h</mtext><mo>&#8594;</mo><msup><mrow><mn>0</mn></mrow><mrow><mo>+</mo></mrow></msup></mrow></munder><msup><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mtext mathvariant=\"normal\">h</mtext></mrow></mfenced></mrow><mrow><mtext mathvariant=\"normal\">p</mtext><mo>+</mo><mn>1</mn></mrow></msup><mrow><mrow><msup><mrow><mtext mathvariant=\"normal\">cos</mtext></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mtext mathvariant=\"normal\">h</mtext></mrow></mfrac></mrow></mrow></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>0</mn><mo>&#160;</mo><mtext>i</mtext><mtext>f&#160;p</mtext><mo>&#62;</mo><mo>-</mo><mn>1</mn></math><br /><math><mtext mathvariant=\"normal\">R</mtext><mo>.</mo><mtext mathvariant=\"normal\">H</mtext><mo>.</mo><mtext mathvariant=\"normal\">L</mtext><mo>.</mo><mtext mathvariant=\"normal\"></mtext><mo>=</mo><mtext mathvariant=\"normal\"></mtext><munder><mrow><mtext mathvariant=\"normal\">l</mtext><mtext mathvariant=\"normal\">i</mtext>