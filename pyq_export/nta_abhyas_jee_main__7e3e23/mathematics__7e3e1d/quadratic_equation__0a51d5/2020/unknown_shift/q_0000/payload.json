  "question": {
    "text": "The product of the roots of the equation whose roots are greater by unity than the roots of the equation&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><mi>x</mi><mo>-</mo><mn>3</mn><mo>=</mo><mn>0</mn></math> is equal to"
  },
  "options": [
    {
      "text": "<math><mn>3</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>12</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>15</mn></math>",
      "is_correct": true
