    {
      "text": "<math><mi>x</mi><mo>∈</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn></mrow><mrow><mn>11</mn></mrow></mfrac><mo>,</mo><mi>∞</mi></mrow></mfenced></math>",
