    },
    {
      "id": "hwOXG",
      "text": "<math><mi>k</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "cpkTm",
      "text": "<math><mi>k</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
