  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>β</mi></math> are the roots of the equation <math><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><mi>x</mi><mo>-</mo><mn>5</mn><mo>=</mo><mn>0</mn><mo>,</mo></math> then the equation whose roots are <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>α</mi><mo>-</mo><mn>3</mn></mrow></mfrac></math> and <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>β</mi><mo>-</mo><mn>3</mn></mrow></mfrac></math> is",
    "image": null
  },
  "options": [
    {
      "id": "MLYAN",
      "text": "<math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>10</mn><mi>x</mi><mo>-</mo><mn>11</mn><mo>=</mo><mn>0</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6CML3",
      "text": "<math><mn>11</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "9mLYK",
      "text": "<math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>11</mn><mo>=</mo><mn>0</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DPlio",
      "text": "<math><mn>11</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math>",
      "image": null,
      "isCorrect": false
