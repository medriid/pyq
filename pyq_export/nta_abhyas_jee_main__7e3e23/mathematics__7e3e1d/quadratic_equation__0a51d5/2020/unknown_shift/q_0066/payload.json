    {
      "text": "<math><mn>45</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>14</mn><mi>x</mi><mo>-</mo><mn>45</mn><mo>=</mo><mn>0</mn></math>",
