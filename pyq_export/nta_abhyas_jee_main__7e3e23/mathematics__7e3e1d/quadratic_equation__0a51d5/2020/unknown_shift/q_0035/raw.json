  "solution": {
    "text": "<math><mi>D</mi><mo>=</mo><msup><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><mi>A</mi><mi>C</mi></math><br /><math><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>-</mo><mn>2</mn><mi>c</mi></mrow></mfenced></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><msup><mrow><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mo>=</mo><mn>4</mn><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>-</mo><mn>2</mn><mi>c</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></math><br /><math><mo>=</mo><mn>4</mn><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>-</mo><mn>2</mn><mi>c</mi><mo>-</mo><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>-</mo><mn>2</mn><mi>c</mi><mo>+</mo><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced></math><br /><math><mo>=</mo><mn>4</mn><mfenced separators=\"|\"><mrow><mn>2</mn><mi>b</mi><mo>-</mo><mn>2</mn><mi>c</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>2</mn><mi>a</mi><mo>-</mo><mn>2</mn><mi>c</mi></mrow></mfenced></math><br /><math><mo>=</mo><mn>16</mn><mfenced separators=\"|\"><mrow><mi>b</mi><mo>-</mo><mi>c</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>c</mi></mrow></mfenced></math><br /><math><mo>=</mo><mn>16</mn><mfenced separators=\"|\"><mrow><mi>c</mi><mo>-</mo><mi>b</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>c</mi><mo>-</mo><mi>a</mi></mrow></mfenced></math><br />If <math><mi>c</mi></math> lies between <math><mi>a</mi></math> and <math><mi>