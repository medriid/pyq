  "question": {
    "text": "If both the roots of the equation <math><mn>4</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>2</mn><mi>x</mi><mo>+</mo><mi>m</mi><mo>=</mo><mn>0</mn></math> lie in the interval <math><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1,1</mn></mrow></mfenced></math>, then"
  },
  "options": [
    {
      "text": "<math><mo>-</mo><mn>3</mn><mo>&lt;</mo><mi>m</mi><mo>&lt;</mo><mo>-</mo><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>0</mn><mo>&lt;</mo><mi>m</mi><mo>&lt;</mo><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>2</mn><mo>&lt;</mo><mi>m</mi><mo>&lt;</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
