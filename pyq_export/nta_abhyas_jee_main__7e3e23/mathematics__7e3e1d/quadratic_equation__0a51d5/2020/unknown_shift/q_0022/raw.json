  "question": {
    "text": "The least integral value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> for which the graphs <math><mi>y</mi><mo>=</mo><mn>2</mn><mi>a</mi><mi>x</mi><mo>+</mo><mn>1</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mn>6</mn></mrow></mfenced><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn></math> do not intersect is",
    "image": null
  },
