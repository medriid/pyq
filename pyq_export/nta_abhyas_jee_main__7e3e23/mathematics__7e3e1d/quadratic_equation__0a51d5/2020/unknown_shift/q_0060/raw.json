  "question": {
    "text": "If both the roots of the equation <math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>x</mi><mo>+</mo><mi>a</mi><mo>=</mo><mn>0</mn></math> are positive, then the complete solution set of real values of <math><mi>a</mi></math>&nbsp;is",
    "image": null
  },
  "options": [
    {
      "id": "SOiJa",
      "text": "<math><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>∞</mi></mrow></mfenced></math>",
