    {
      "text": "<math><mn>11</mn><mi>x</mi><mo>-</mo><mn>5</mn><mi>y</mi><mo>+</mo><mn>7</mn><mi>z</mi><mo>-</mo><mn>13</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
