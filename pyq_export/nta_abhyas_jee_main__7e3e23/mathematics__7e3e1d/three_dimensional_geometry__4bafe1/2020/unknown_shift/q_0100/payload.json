      "is_correct": true
    },
    {
      "text": "<math><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>+</mo><mi>z</mi><mo>-</mo><mn>4</mn><mo>=</mo><mn>0</mn></math>",
