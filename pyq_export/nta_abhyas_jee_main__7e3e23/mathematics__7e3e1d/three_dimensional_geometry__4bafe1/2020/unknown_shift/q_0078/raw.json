    },
    {
      "id": "MBpau",
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>4</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mo>-</mo><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced></math>",
