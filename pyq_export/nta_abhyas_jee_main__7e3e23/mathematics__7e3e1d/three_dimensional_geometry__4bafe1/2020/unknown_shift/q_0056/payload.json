    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mi>&nbsp;</mi><mn>0</mn><mo>,</mo><mi>&nbsp;</mi><mn>1</mn></mrow></mfenced></math>",
