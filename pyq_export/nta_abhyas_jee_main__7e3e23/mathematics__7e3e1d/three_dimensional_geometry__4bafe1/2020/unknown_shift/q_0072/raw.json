  "question": {
    "text": "A line is drawn from the point <math><mi>P</mi><mfenced separators=\"|\"><mrow><mn>1,1</mn><mo>,</mo><mn>1</mn></mrow></mfenced></math> and perpendicular to a line whose direction ratios are&nbsp;<math><mn>1,1</mn><mo>,</mo><mn>1</mn></math> to intersect the plane <math><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>+</mo><mn>3</mn><mi>z</mi><mo>=</mo><mn>4</mn></math> at the point&nbsp;<math><mi>Q</mi><mo>.</mo></math> The locus of <math><mi>Q</mi></math> is",
    "image": null
  },
  "options": [
    {
      "id": "GT9vd",
      "text": "<math><mfrac><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>-</mo><mn>5</mn></mrow><mrow><mo>-</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi><mo>+</mo><mn>2</mn></mrow><mrow><mn>1</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "FF7ly",
      "text": "<math><mfrac><mrow><mi>x</mi></mrow><mrow><mo>-</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi><mo>-</mo><mn>5</mn></mrow><mrow><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>z</mi><mo>+</mo><mn>2</mn></mrow><mrow><mn>1</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UfS6h",
      "text": "<math><mi>x</mi><mo>=</mo><mi>y</mi><mo>=</mo><mi>z</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "95Xbf",
      "text": "<math><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>y</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac></math>",
      "image": null,
