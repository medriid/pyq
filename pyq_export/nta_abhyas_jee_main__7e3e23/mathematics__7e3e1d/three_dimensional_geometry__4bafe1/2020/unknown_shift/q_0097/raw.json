  "solution": {
    "text": "<p>Let,&nbsp;<math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math><br /><math><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mn>4</mn><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>7</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>5</mn><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mn>6</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>4</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>5</mn><mover><mi>k</mi><mo>^</mo></mover></math><br /><math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"/><br /><math><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>8</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>4</mn><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>d</mi><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mn>9</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>18</mn><mover><mi>k</mi><mo>^</mo></mover></math><br />Hence, shortest distance <math><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>-</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8901;</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfrac></mrow></mfenced></math><br /><math><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mo>-</mo><mn>36</mn><mo>+</mo><mn>90</mn></mrow><mrow><mn>9</mn><msqrt><mn>5</mn></msqrt></mrow></mfrac></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>6</mn></mrow><mrow><msqrt><mn>5</mn></msqrt></mrow></mfrac><mo>&#8712;</mo><mfenced close=\"]\" separators=\"|\"><mrow><mn>2,3</mn></mrow></mfenced></math></p>",
