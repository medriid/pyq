  ],
  "solution": {
    "text": "<p>Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>t</mi><mn>1</mn><mn>2</mn></msubsup></mrow></mfenced><mo>,</mo><mo>&#160;</mo><mi>Q</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>,</mo><msubsup><mi>t</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mfenced><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi>R</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>,</mo><msubsup><mi>t</mi><mn>3</mn><mn>2</mn></msubsup></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>T</mi><mi>A</mi></mrow><mrow><mi>T</mi><mi>P</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mfrac><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><msub><mi>t</mi><mn>3</mn></msub></mrow><mn>2</mn></mfrac></mfenced><mo>-</mo><mfenced separators=\"|\"><mfrac><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mn>2</mn></mfrac></mfenced></mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>+</mo><msub><mi>t</mi><mn>3</mn></msub></mrow><mn>2</mn></mfrac><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mfenced></mfrac><mo>=</mo><mfrac><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mfrac></math>&nbsp;and</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>T</mi><mi>B</mi></mrow><mrow><mi>T</mi><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mrow><msub><mi>t</mi><mn>1</mn></msub><mo>-</mo><msub><mi>t</mi><mn>3</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mrow><mi>T</mi><mi>A</mi></mrow><mrow><mi>T</mi><mi>P</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>T</mi><mi>B</mi></mrow><mrow><mi>T</mi><mi>R</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub></mrow><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mfrac><mo>+</mo><mfrac><mrow><msub><mi>t</mi><mn>2</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow><mrow><msub><mi>t</mi><mn>3</mn></msub><mo>-</mo><msub><mi>t</mi><mn>1</mn></msub></mrow></mfrac><mo>=</mo><mn>1</mn><mspace linebreak=\"newline\"/></math></p>"
