  "question": {
    "text": "The length of intercept cut by the line <math><mn>4</mn><mi>x</mi><mo>+</mo><mn>4</mn><msqrt><mn>3</mn></msqrt><mi>y</mi><mo>-</mo><mn>1</mn><mo>=</mo><mn>0</mn></math> on the curve <math><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>4</mn><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></math>&nbsp;is equal to",
    "image": null
  },
  "options": [
    {
      "id": "Q6f9A",
      "text": "<math><mn>4</mn></math> units",
      "image": null,
      "isCorrect": false
    },
    {
