  "question": {
    "text": "The focus of the conic represented parametrically by the equation <math><mi>y</mi><mo>=</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn><mo>,</mo><mi></mi><mi>x</mi><mo>=</mo><mn>2</mn><mi>t</mi><mo>-</mo><mn>1</mn></math> is"
  },
  "options": [
    {
