    {
      "text": "<math><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn><mi>a</mi></mrow></mfenced><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn><mi>a</mi></mrow></mfenced><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>2</mn><mi>a</mi></mrow></mfenced><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>2</mn><mi>a</mi></mrow></mfenced><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><mn>0</mn></math>",
