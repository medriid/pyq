  "solution": {
    "text": "Let <math><msub><mrow><mi>Q</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>,</mo><mn>2</mn><mi>a</mi><msub><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math> &amp; <math><msub><mrow><mi>Q</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>,</mo><mn>2</mn><mi>a</mi><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math> are points of contact of the tangents passing through <math><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub></math> &amp; <math><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub></math> respectively.<br /><math><mo>&#8658;</mo><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>,</mo><mn>0</mn></mrow></mfenced></math> &amp; <math><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>,</mo><mn>0</mn></mrow></mfenced></math><br /><math><mo>&#8658;</mo><msub><mrow><mi>P</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>S</mi><mo>=</mo><mi>a</mi><mo>+</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></math> &amp; <math><msub><mrow><mi>P</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>S</mi><mo>=</mo><mi>a</mi><mo>+</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></math><br /><math><mo>&#8658;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>P</mi><msub><mrow><mi>S</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>P</mi><msub><mrow><mi>S</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi><mo>+</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi><mo>+</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi><mo>+</mo><mi>a</mi><msubsup><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi><mo>+</mo><mi>a</mi><msup><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi></mrow></mfrac></math>",
