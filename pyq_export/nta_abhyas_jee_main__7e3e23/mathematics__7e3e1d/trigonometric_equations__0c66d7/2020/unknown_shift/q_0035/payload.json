    "text": "<math><mn>12</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mn>5</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>8</mn><mi>y</mi><mo>+</mo><mn>2</mn><mn>1</mn></math><br /><math><mn>12</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mn>5</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></math> lies between <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><mn>13,13</mn></mrow></mfenced></math><br />Also, <math><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>8</mn><mi>y</mi><mo>+</mo><mn>21</mn><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>4</mn></mrow></mfenced><mo>+</mo><mn>13</mn><mo>=</mo><mn>2</mn><msup><mrow><mfenced separators=\"|\"><mrow><mi>y</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>13</mn></math><br />So, possibility of equality is when <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>LHS</mi><mo>=</mo><mi>RHS</mi><mo>=</mo><mn>13</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>RHS</mi><mo>=</mo><mn>13</mn></math>, when <math><mi>y</mi><mo>=</mo><mn>2</mn><mo>&#8658;</mo><mi>r</mi><mo>=</mo><mn>2</mn><mo>.</mo></math><br /><math><mn>12</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mn>5</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mn>13</mn><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mfrac><mrow><mn>12</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mo>+</mo><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mfrac><mrow><mn>5</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mo>=</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfrac><mrow><mn>12</mn></mrow><mrow><mn>13</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mn>1</mn><mo>&#8658;</mo><mi>x</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfrac><mrow><mn>12</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mn>4</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>2</mn><mi>n</mi><mi>&#960;</mi><mo>+</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfrac><mrow><mn>12</mn></mrow><mrow><mn>13</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mn>2</mn><mi>n</mi><mi>&#960;</mi><mo>+</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfrac><mrow><mn>12</mn></mrow><mrow><mn>13</mn></mrow></mfrac></math><br /><math><mi>x</mi><mo>=</mo>