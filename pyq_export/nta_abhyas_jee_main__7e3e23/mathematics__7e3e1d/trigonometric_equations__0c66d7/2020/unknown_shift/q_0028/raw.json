  "solution": {
    "text": "<p>For domain,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>&#62;</mo><mn>0</mn><mo>&#8658;</mo><mi>&#952;</mi><mo>&#8712;</mo><mfenced open=\"[\" separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac></mrow></mfenced><mo>&#8746;</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>2</mn></mfrac><mo>,</mo><mn>2</mn><mi>&#960;</mi></mrow></mfenced></math><br />Also, if <math><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>&#62;</mo><mn>0</mn><mo>&#8658;</mo><mfrac><mrow><mn>4</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfrac><mo>&#8800;</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>2</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfrac><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mn>16</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>4</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfrac></mrow></mfenced></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><math><mo>&#8658;</mo><msup>