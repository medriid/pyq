  "solution": {
    "text": "<math><mn>3</mn><mo>+</mo><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi><mo>=</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>θ</mi><mo>=</mo><mn>2</mn><mo>-</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow></mrow></mrow></mrow></math>.<br /><br /><math><mo>⇒</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>θ</mi><mo>+</mo><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></mrow></mrow></mrow></mrow></math><br /><br /><math><mo>⇒</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi><mo>=</mo><mo>-</mo><mn>1</mn><mo>,</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow></math><br /><br /><math><mo>⇒</mo><mi>θ</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mi>π</mi></math>&nbsp;or&nbsp;<math><mn>2</mn><mi>n</mi><mi>π</mi><mo>±</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><br /><math><mo>⇒</mo><mi>θ</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mi>π</mi><mo>,</mo><mfrac><mrow><mn>4</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>8</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mn>3</mn><mi>π</mi><mo>,</mo><mfrac><mrow><mn>10</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>14</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mn>5</mn><mi>π</mi></math><br /><br />i.e. <math><msub><mrow><mi>θ</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><msub><mrow><mi>θ</mi></mrow><mrow><mn>7</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>14</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>18</mn><mi>π</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mn>6</mn><mi>π</mi></math><br /><br /><math><mo>⇒</mo><mi>a</mi><mo>=</mo><mn>6</mn></math>"
