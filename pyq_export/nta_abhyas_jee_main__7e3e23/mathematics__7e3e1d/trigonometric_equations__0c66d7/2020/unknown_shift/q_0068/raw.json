      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The given equation can be written as<br /><math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow></mrow></mrow></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mi>x</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow></mrow></mrow></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></mrow></mrow></math><br /><math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi><mi></mi><mn>3</mn><mi>x</mi></mrow><mo>&#8289;</mo><mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mi>x</mi><mo>=</mo><mn>0</mn></mrow></mrow></mrow></mrow></mrow></mrow></math><br />So, <math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mn>3</mn><mi>x</mi></mrow></mfenced></mrow></mrow><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>x</mi></mrow></mrow><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><mi>n</mi><mi>&#960;</mi></mrow><mn>4</mn></mfrac><mo>,</mo><mo>&#160;</mo><mi>n</mi><mo>&#8712;</mo><mi>Z</mi><mo>.</mo></math><br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>0</mn><mo>,</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>,</mo><mi></mi><mi>&#960;</mi></math><br /><math><mo>&#8658;</mo><mn>5</mn></math> solutions",
