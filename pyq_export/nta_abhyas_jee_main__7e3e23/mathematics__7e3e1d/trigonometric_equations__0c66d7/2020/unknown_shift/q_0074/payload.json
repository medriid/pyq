    "text": "<math><msub><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi></mrow><mrow><msqrt><mn>2</mn></msqrt><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></msub><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>=</mo><mn>2</mn></math><br /><math><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn></msqrt><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mrow></math><br /><math><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>=</mo><mn>2</mn><mo>-</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mrow></math><br /><math><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>-</mo><mn>1</mn><mo>=</mo><mn>0</mn></mrow></mrow></mrow></mrow></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mi>cos</mi><mo>&#8289;</mo><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>2</mn><mi>cos</mi><mo>&#8289;</mo><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>&nbsp;or&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mi>x</mi><mo>=</mo><mo>-</mo><mn>1</mn></math>&nbsp;(rejected)<br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math> in <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>0,2</mn><mi>&#960;</mi></mrow></mfenced></math><br />But at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>3</mn></mfrac><mo>,</mo><mo>&#160;</mo><msqrt><mn>2</mn></msqrt><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></math> is negative<br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math>&nbsp;in <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>0,2</mn><mi>&#960;</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac><mo>,</mo><mo>&#160;</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac><mo>+</mo><mn>2</mn><mi>&#960;</mi><mo>,</mo><mo>&#160;</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac><mo>+</mo><mn>4</mn><mi>&#960;</mi></math><br /><math><mo>&#8658;</mo><mn>3</mn></math> solutions in&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\"><mrow><mn>0</mn><mo>,</mo><mn>5</mn><mi>&#960;</mi></mrow></mfenced></math>"
