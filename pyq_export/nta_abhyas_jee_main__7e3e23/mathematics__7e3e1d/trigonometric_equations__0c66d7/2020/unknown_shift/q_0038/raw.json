    "text": "<p><math><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mo>-</mo><msqrt><mn>3</mn></msqrt></math><br /><br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>11</mn><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac></math> and</p><p><math><mrow><mrow><mi mathvariant=\"normal\">cosec</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mo>-</mo><mn>2</mn></math><br /><br /><math><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><mn>7</mn><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>11</mn><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac></math><br /><br />So, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mo>=</mo><mfrac><mrow><mn>11</mn><mi>&#960;</mi></mrow><mn>6</mn></mfrac><mo>,</mo><mo>&#160;</mo><mi>&#946;</mi><mo>=</mo><mfrac><mrow><mn>5</mn><mi>&#960;</mi></mrow><mn>6</mn></mfrac><mo>,</mo><mo>&#160;</mo><mi>&#947;</mi><mo>=</mo><mfrac><mrow><mn>7</mn><mi>&#960;</mi></mrow><mn>6</mn></mfrac></math><br /><br /><math><mo>&#8658;</mo><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi><mo>=</mo><mi>&#960;</mi></math> and <math><mi>&#946;</mi><mo>+</mo><mi>&#947;</mi><mo>=</mo><mn>2</mn><mi>&#960;</mi></math><br /><br /><math><mo>&#8658;</mo><mfrac><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>&#945;</mi><mo>-</mo><mi>&#946;</mi></mrow></mfenced></mrow><mrow><mi>&#946;</mi><mo>+</mo><mi>&#947;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn><mi>&#960;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math></p>",
