  "question": {
    "text": "The number of solutions of the equation <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>sin</mi><mn>3</mn></msup><mo>⁡</mo><mi>x</mi><mi>cos</mi><mo>⁡</mo><mi>x</mi><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mo>⁡</mo><mi>x</mi><msup><mi>cos</mi><mn>2</mn></msup><mo>⁡</mo><mi>x</mi><mo>+</mo><msup><mi>cos</mi><mn>3</mn></msup><mo>⁡</mo><mi>x</mi><mi>sin</mi><mo>⁡</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math> in the interval <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mn>2</mn><mi>π</mi></mrow></mfenced></math> is equal to"
  },
  "options": [
    {
      "text": "<math><mn>0</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn></math>",
      "is_correct": false
