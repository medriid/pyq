    "text": "<math><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>2</mn><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>4</mn><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>5</mn><mi>x</mi></mrow></mrow><mo>=</mo><mn>0</mn></math><br /><math><mo>⇒</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>5</mn><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow><mo>=</mo><mn>0</mn></math><br /><math><mo>⇒</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>5</mn><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow><mo>=</mo><mn>0</mn></math> or <math><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow><mo>=</mo><mn>0</mn></math><br />but <math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow><mo>≠</mo><mn>0</mn></math><br />If <math><mi>x</mi><mo>∈</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi></mi><mi>π</mi></mrow></mfenced><mo>⇒</mo><mfrac><mrow><mn>5</mn><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>∈</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mfrac><mrow><mn>5</mn><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mo>