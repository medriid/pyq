  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><msubsup><mi>z</mi><mn>1</mn><mn>2</mn></msubsup><mo>-</mo><msubsup><mi>z</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><msup><msub><mover><mi>z</mi><mo>-</mo></mover><mn>1</mn></msub><mn>2</mn></msup><mo>+</mo><msup><msub><mover><mi>z</mi><mo>-</mo></mover><mn>2</mn></msub><mn>2</mn></msup><mo>-</mo><mn>2</mn><msub><mover><mi>z</mi><mo>-</mo></mover><mn>1</mn></msub><msub><mover><mi>z</mi><mo>-</mo></mover><mn>2</mn></msub></mrow></mfenced></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msubsup><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>-</mo><msubsup><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msubsup><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>+</mo><msubsup><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mo>-</mo><mn>2</mn><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math><br /><math><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><msub><mi>z</mi><mn>1</mn></msub><mo>&#175;</mo></mover><mo>&#160;</mo><mo>&#8869;</mo><mo>&#160;</mo><mover><msub><mi>z</mi><mn>2</mn></msub><mo>&#175;</mo></mover><mo>&#160;</mo></math><br /><math><mo>&#8658;</mo><mrow><mrow><mi mathvariant=\"normal\">arg</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mn>2</mn><mi>n</mi><mi>&#960;</mi><mo>&#177;</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math><br />i.e.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>,</mo><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>,</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>2</mn></mfrac><mo>,</mo><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mo>.</mo></math><br />The minimum value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow></mfenced><mo>=</mo><mn>1</mn></math>&nbsp;(when&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mn>1</mn><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi>b</mi><mo>=</mo><mn>2</mn></math>)</p>"
