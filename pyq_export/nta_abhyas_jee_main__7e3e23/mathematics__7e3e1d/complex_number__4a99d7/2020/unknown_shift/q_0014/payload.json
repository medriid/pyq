  "solution": {
    "text": "Given, <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced><mo>=</mo><mn>1</mn></math><br />Now, <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>Z</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>Z</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced><mo>≤</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced></math><br /><math><mo>⇒</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mo>-</mo><mi>a</mi></mrow></mfenced><mo>≤</mo><mn>1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>1</mn></math><br /><math><mo>⇒</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>a</mi></mrow></mfenced><mo>≤</mo><mn>3</mn></math><br />Also, <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>Z</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>Z</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>×</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>×</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mi>Z</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced></math><br /><math><mo>⇒</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mo>-</mo><mi>c</mi></mrow></mfenced><mo>=</mo><mn>1</mn><mo>×</mo><mn>1</mn><mo>×</mo><mn>1</mn></math><br /><math><mo>⇒</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>=</mo><mn>1</mn></math>"
