  "correctValue": null,
  "solution": {
    "text": "<p><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>B</mi></mrow></mfrac><mo>=</mo><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover><mo>-</mo><mi>A</mi></math> and <math><mo>&#8658;</mo><mi>B</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover><mo>-</mo><mi>A</mi></mrow></mfrac><mo>&#8658;</mo><mover accent=\"false\"><mrow><mi>B</mi></mrow><mo>&#175;</mo></mover><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>A</mi><mo>-</mo><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover></mrow></mfrac></math><br />And <math><mover accent=\"false\"><mrow><mi>B</mi></mrow><mo>&#175;</mo></mover><mo>-</mo><mi>B</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>A</mi></mrow></mfrac><mo>&#8658;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>A</mi><mo>-</mo><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover><mo>-</mo><mi>A</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>A</mi></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mi>A</mi><mo>-</mo><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>A</mi></mrow></mfrac><mo>&#8658;</mo><mn>2</mn><mi>A</mi><mo>=</mo><mi>A</mi><mo>-</mo><mover accent=\"false\"><mrow><mi>A</mi></mrow><mo>&#175;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover><mi>A</mi><mo>&#175;</mo></mover><mo>=</mo><mo>-</mo><mi>A</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>A</mi><mi>B</mi><mo>=</mo><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\"><mrow><mi>A</mi><mi>B</mi></mrow></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfr