  "solution": {
    "text": "Let,&nbsp;<math><mrow><mi>z</mi><mo>=</mo><mi>r</mi><mo stretchy=\"false\">(</mo><mtext>cos</mtext><mi>θ</mi><mo>+</mo><mi>i</mi><mtext>sin</mtext><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow> </math><br /><br /><math> <mrow> <msup> <mi>z</mi> <mn>5</mn> </msup> <mo>=</mo><msup> <mi>r</mi> <mn>5</mn> </msup> <mo stretchy=\"false\">(</mo><mtext>cos</mtext><mn>5</mn><mi>θ</mi><mo>+</mo><mi>i</mi><mtext>sin</mtext><mn>5</mn><mi>θ</mi><mo stretchy=\"false\">)</mo></mrow> </math><br /><br /><math><mi>I</mi><mi>m</mi><mo>&nbsp;</mo><msup><mrow><mo>(</mo><mi>z</mi></mrow><mn>5</mn></msup><mo>)</mo><mo>=</mo><msup><mi>r</mi><mn>5</mn></msup><mi>sin</mi><mo>⁡</mo><mn>5</mn><mi>θ</mi></math><br /><br />and <math><msup><mrow><mfenced separators=\"|\"><mrow><mi>I</mi><mi>m</mi><mi>&nbsp;</mi><mi>z</mi></mrow></mfenced></mrow><mrow><mn>5</mn></mrow></msup><mo>=</mo><msup><mrow><mi>r</mi></mrow><mrow><mn>5</mn></mrow></msup><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>5</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></math><br /><br /><math><mfrac><mrow><mi>I</mi><mi>m</mi><mi>&nbsp;</mi><mo>(</mo><msup><mrow><mi>z</mi></mrow><mrow><mn>5</mn></mrow></msup><mo>)</mo></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>I</mi><mi>m</mi><mi>&nbsp;</mi><mi>z</mi></mrow></mfenced></mrow><mrow><mn>5</mn></mrow></msup></mrow></mfrac><mo>=</mo><mi>&nbsp;</mi><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>5</mn><mi>θ</mi></mrow></mrow></mrow><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>5</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mi> A&nbsp;</mi></math>(Let)<br /><br /><math><mo>⇒</mo><mfrac><mrow><mi>d</mi><mi>A</mi></mrow><mrow><mi>d</mi><mi>θ</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5</mn><msup><mi>sin</mi><mn>5</mn></msup><mo>⁡</mo><mi>θ</mi><mi>cos</mi><mo>⁡</mo><mn>5</mn><mi>θ</mi><mo>-