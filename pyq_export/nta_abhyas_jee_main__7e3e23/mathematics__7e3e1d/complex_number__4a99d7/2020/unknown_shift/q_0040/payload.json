    "A"
  ],
  "solution": {
    "text": "<p>Given <math><mover accent=\"true\"><mrow><mi>z</mi></mrow><mo>-</mo></mover><mo>+</mo><mi>i</mi><mover accent=\"true\"><mrow><mi>w</mi></mrow><mo>-</mo></mover><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mover accent=\"true\"><mrow><mi>z</mi></mrow><mo>-</mo></mover><mo>=</mo><mo>-</mo><mi>i</mi><mover accent=\"true\"><mrow><mi>w</mi></mrow><mo>-</mo></mover><mi mathvariant=\"normal\"></mi></math> or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mi>i</mi><mi>w</mi></math>&nbsp;or&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>z</mi><mi>w</mi></mfrac><mo>=</mo><mi>i</mi></math><br /><math><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>z</mi></mrow></mfenced><mo>-</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>w</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mtext>&#8201;</mtext><mi>i</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br />also <math><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\"></mi><mfenced separators=\"|\"><mrow><mi>z</mi><mi>w</mi></mrow></mfenced><mo>=</mo><mi>&#960;</mi></math><br /><math><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>z</mi></mrow></mfenced><mo>+</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>w</mi></mrow></mfenced><mo>=</mo><mi>&#960;</mi><mo>&#8230;</mo><mo>.</mo><mo>.</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br />Adding&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mi mathvariant=\"normal\">i</mi></mfenced><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">i</mi></mrow></mfenced><mo>,</mo></math>&nbsp;we get,</p><p><math><mn>2</mn><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>z</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>z</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math><br />Also,&nbsp;<math><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">p</mi><mfenced separators=\"|\"><mrow><mi>w</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math></p>"
  }
