    "text": "<math><msup><mrow><mn>1</mn></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></msup><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>2</mn><mi>r</mi><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mrow><mo>+</mo><mi>i</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>2</mn><mi>r</mi><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mrow><mi>,&nbsp;&nbsp;</mi><mi>r</mi><mo>=</mo><mn>0</mn><mo>,&nbsp;</mo><mi></mi><mn>1</mn><mo>,&nbsp;</mo><mi></mi><mo>…</mo><mo>…</mo><mo>,&nbsp;</mo><mi mathvariant=\"italic\"> n</mi><mo>-</mo><mn>1</mn></math><br /><br />Let,&nbsp;<math><msub><mrow><mi>z</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mrow><mo>+</mo><mi>&nbsp;</mi><mi>i</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mrow></math><br /><br />And,&nbsp;<math><msub><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mrow><mo>+</mo><mi>i</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac></mrow></mrow></math> .<br /><br />Then,&nbsp;<math> <mrow> <mo>∠</mo><msub> <mi>z</mi> <mn>1</mn> </msub> <mi>O</mi><msub> <mi>z</mi> <mn>2</mn> </msub> <mo>=</mo><mi>a</mi><mi>m</mi><mi>p</mi><mo>&nbsp;</mo><mfenced> <mrow> <mfrac> <mrow> <msub> <mi>z</mi> <mn>1</mn> </msub> </mrow> <mrow> <msub> <mi>z</mi> <mn>2</mn> </msub> </mrow> </mfrac> </mrow> </mfenced><mo>=</mo><mi>a</mi><mi>m</mi><mi>p</mi><mo>&nbsp;</mo><mfenced> <mrow> <msub> <mi>z</mi> <mn>1</mn> </msub> </mrow> </mfenced><mo>−</mo><mi>a</mi><mi>m</mi><mi>p</mi><mo>&nbsp;</mo><mfenced> <mrow> <msub> <mi>z</mi> <mn>2</mn> </msub> </mrow> </mfenced></mrow> </math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn><mfenced separators=\"|\"><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mi>π</mi></mrow><mrow><mi>n</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math> (Given)<br /><br /><math><mo>∴</mo></math> <math><mi>n</mi><mo>=</mo><mn>4</mn><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>=</mo><mn>4</mn><mo>×</mo></math> integer, so <math><mi>n</mi></math> is of the form <math><mn>4</mn><mi>k</mi></math>.",
