    "text": "Let <math><mi>z</mi><mi></mi><mo>=</mo><mi></mi><mi>x</mi><mi></mi><mo>+</mo><mi></mi><mi>i</mi><mi>y</mi></math><br /><math> <mrow> <mi>E</mi><mo>=</mo><mi>z</mi><mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> <mo>+</mo><mfenced> <mrow> <mi>z</mi><mo>−</mo><mn>3</mn></mrow> </mfenced><mfenced> <mrow> <mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> <mo>−</mo><mn>3</mn></mrow> </mfenced><mo>+</mo><mfenced> <mrow> <mi>z</mi><mo>−</mo><mn>6</mn><mi>i</mi></mrow> </mfenced><mfenced> <mrow> <mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> <mo>+</mo><mn>6</mn><mi>i</mi></mrow> </mfenced></mrow> </math><br /><math> <mrow> <mo>=</mo><mn>3</mn><mi>z</mi><mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> <mo>−</mo><mn>3</mn><mfenced> <mrow> <mi>z</mi><mo>+</mo><mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> </mrow> </mfenced><mo>+</mo><mn>9</mn><mo>+</mo><mn>6</mn><mfenced> <mrow> <mi>z</mi><mo>−</mo><mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> </mrow> </mfenced><mi>i</mi><mo>+</mo><mn>36</mn></mrow> </math><br /><math> <mrow> <mfenced> <mrow> <mi>z</mi><mo>+</mo><mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> <mo>=</mo><mn>2</mn><mi>x</mi><mo>;</mo><mi>z</mi><mo>−</mo><mover accent=\"true\"> <mi>z</mi> <mo>¯</mo> </mover> <mo>=</mo><mn>2</mn><mi>i</mi><mi>y</mi></mrow> </mfenced></mrow> </math><br /><math><mo>=</mo><mn>3</mn><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mo>-</mo><mn>6</mn><mi>x</mi><mo>-</mo><mn>12</mn><mi>y</mi><mo>+</mo><mn>45</mn></math><br /><math><mo>=</mo><mn>3</mn><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>2</mn><mi>x</mi><mo>-</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>15</mn></mrow></mfenced></math><br /><math><mi>E</mi><mo>=</mo><mn>3</mn><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi>y</mi><mo>-</mo><mn>2</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>10</mn></mrow></mfenced></math><br />Hence,&nbsp;<math><msub><mrow><mi>E</mi></mrow><mrow><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi></mrow></msub><mo>=</mo><mn>30</mn></math> when <math><mi>x</mi><mo>=</mo><mn>1</mn><mi></mi></math> and <math><mi>y</mi><mi></mi><mo>=</mo><mn>2</mn></math> i.e., <math><mi>z</mi><mi></mi><mo>=</mo><mn>1</mn><mi></mi><mo>+</mo><mn>2</mn><mi>i</mi></math>",
