  "solution": {
    "text": "Let,&nbsp;<math><msup><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>t</mi><mo>&#8658;</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>2</mn><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mi>t</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>t</mi><mo>+</mo><mn>2</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mi>t</mi><mo>=</mo><mn>1</mn></math> or <math><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>t</mi><mo>+</mo><mn>2</mn><mo>=</mo><mn>0</mn></math><br /><math><mo>&#8658;</mo><mi>t</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo>-</mo><mn>1</mn><mo>&#177;</mo><mi>i</mi></math><br /><math><mo>&#8658;</mo><mi>z</mi><mo>=</mo><mo>&#177;</mo><mn>1</mn></math> or <math><msup><mrow><mi>z</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mo>-</mo><mn>1</mn><mo>&#177;</mo><mi>i</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>z</mi></mfenced><mn>2</mn></msup><mo>=</mo><mn>1</mn><mo>,</mo><msqrt><mn>2</mn></msqrt><mspace linebreak=\"newline\"/><mo>&#8658;</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>z</mi></mfenced><mn>4</mn></msup><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msubsup><mo>&#8721;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>6</mn></msubsup><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><msub><mi>z</mi><mi>i</mi></msub></mfenced><mn>4</mn></msup><mo>=</mo><mn>1</mn><mo>+</mo><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>2</mn><mo>=</mo><mn>10</mn></math>"
