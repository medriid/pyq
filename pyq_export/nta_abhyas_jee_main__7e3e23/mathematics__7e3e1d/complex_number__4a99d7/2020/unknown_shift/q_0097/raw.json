  "correctValue": null,
  "solution": {
    "text": "Let,&nbsp;<math><mi>Z</mi><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>i</mi><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></math><br />Now,&nbsp;<math><mfrac><mrow><mi>Z</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>Z</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>i</mi><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfenced><mo>-</mo><mrow><mrow><mi>i</mi><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mfrac><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi>i</mi><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><msup><mrow><mi>i</mi></mrow><mrow><mn>2</mn></mrow></msup><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mi>i</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>i</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mi>i</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#952;</mi><mo>+</mo><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mi>i</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#952;</mi><mo>+</mo><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mi>&#952;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac></math><br />Which lies in second quadrant,&nbsp;<br />if <math><mi>&#952;</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi>&#960;</mi></mrow></mfenced><mo>&#8658;</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi>&#952;</mi><mo>&#62;</mo><mn>0</mn><mo>&#8658;</mo><mi>y</mi><mo>&#62;</mo><mn>0</mn></math>",
