    "text": "<math> <mrow> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <msub> <mtext>z</mtext> <mn>1</mn> </msub> </mrow> </mfenced> <mo>=</mo> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <msub> <mtext>z</mtext> <mn>2</mn> </msub> </mrow> </mfenced> <mo>=</mo> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <msub> <mtext>z</mtext> <mn>3</mn> </msub> </mrow> </mfenced> <mo>=</mo> <mn>1</mn> </mrow> </math>&nbsp;(given)<br /><br />Now <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><msub><mtext>z</mtext><mn>1</mn></msub></mfenced><mo>=</mo><mn>1</mn><mo>&#8658;</mo><msup><mfenced close=\"|\" open=\"|\"><msub><mtext>z</mtext><mn>1</mn></msub></mfenced><mn>2</mn></msup><mo>=</mo><mn>1</mn><mo>&#8658;</mo><msub><mtext>z</mtext><mn>1</mn></msub><mover><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>&#175;</mo></mover><mo>=</mo><mn>1</mn></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mn>1</mn><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub></mfrac><mo>=</mo><mover><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>&#175;</mo></mover></math><br /><br />Similarly, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msub><mi mathvariant=\"normal\">z</mi><mn>2</mn></msub></mfrac><mo>=</mo><mover><msub><mi mathvariant=\"normal\">z</mi><mn>2</mn></msub><mo>&#175;</mo></mover><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mfrac><mn>1</mn><msub><mi mathvariant=\"normal\">z</mi><mn>3</mn></msub></mfrac><mo>=</mo><mover><msub><mi mathvariant=\"normal\">z</mi><mn>3</mn></msub><mo>&#175;</mo></mover></math><br /><br />Now <math> <mrow> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msub> <mtext>z</mtext> <mn>1</mn> </msub> </mrow> </mfrac> <mo>+</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msub> <mtext>z</mtext> <mn>2</mn> </msub> </mrow> </mfrac> <mo>+</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msub> <mtext>z</mtext> <mn>3</mn> </msub> </mrow> </mfrac> </mrow> </mfenced> <mo>=</mo> <mn>1</mn> </mrow> </math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\"><mover><mrow><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">z</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">z</mi><mn>3</mn></msub></mrow><mo>&#175;</mo></mover></mfenced><mo>=</mo><mn>1</mn></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mo>&#8757;</mo><mover><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>&#175;</mo></mover><mo>+</mo><mover><msub><mi mathvariant=\"normal\">z</mi><mn>2</mn></msub><mo>&#175;</mo></mover><mo>=</mo><mover><mrow><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">z</mi><mn>2</mn></msub></mrow><mo>&#175;</mo></mover><mo>)</mo></math><br /><br />and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>|</mo><mover><mrow><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">z</mi><mn>2</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">z</mi><mn>3</mn></msub></mrow><mo>&#175;</mo></mover><mo>|</mo></mrow><mo>=</mo><mn>1</mn><mtext>&#8201;</mtext><mtext>&#8201;</mtext><mrow><mo>(</mo><mo>&#8757;</mo><mrow><mo>|</mo><mover><msub><mi mathvariant=\"normal\">z</mi><mn>1</mn></msub><mo>&#175;</mo></mover><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mi mathvariant=\"normal\">z</mi><mo>|</mo></mrow><mo>)</mo></mrow></math><br /><br /><math> <mrow> <mo>&#8658;</mo> <mfenced close=\"|\" open=\"|\" separators=\",\"> <mrow> <msub> <mtext>z</mtext> <mn>1</mn> </msub> <mo>+</mo> <msub> <mtext>z</mtext> <mn>2</mn> </msub> <mo>+</mo> <msub> <mtext>z</mtext> <mn>3</mn> </msub> </mrow> </mfenced> <mo>=</mo> <mn>1</mn> </mrow> </math>"
