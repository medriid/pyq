    "text": "<p>Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi><mo>=</mo><mn>1</mn><mo>+</mo><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>6</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mo>+</mo><mi>i</mi><mi>sin</mi><mo>&#8289;</mo><mfrac><mrow><mn>6</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mo>=</mo><mn>2</mn><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mo>+</mo><mi>i</mi><mi>sin</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><mn>2</mn><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mo>-</mo><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mo>-</mo><mi>i</mi><mi>sin</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>-</mo><mn>2</mn><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mi>cos</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mo>-</mo><mi>&#960;</mi></mrow></mfenced><mo>+</mo><mi>i</mi><mi>sin</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mo>-</mo><mi>&#960;</mi></mrow></mfenced></mrow></mfenced></math></p><p>i.e.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#969;</mi><mo>=</mo><mo>-</mo><mn>2</mn><mi>cos</mi><mo>&#8289;</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mn>5</mn></mfrac><mfenced 