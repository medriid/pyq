  "question": {
    "text": "A nine-digit number is formed using the digits <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1,</mn><mo>&#160;</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mn>3,</mn><mo>&#160;</mo><mn>5</mn></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn></math>. The probability that the product of all digits is always <math><mn>1920</mn></math> is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mn>5</mn></mrow><mrow><mn>9</mn></mrow></msup></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>7</mn></mrow><mrow><msup><mrow><mn>5</mn></mrow><mrow><mn>8</mn></mrow></msup></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>72</mn></mrow><mrow><msup><mrow><mn>5</mn></mrow><mrow><mn>9</mn></mrow></msup></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>7</mn><mo>!</mo></mrow></mfrac></math>",
      "is_correct": false
