  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Probability of choosing <math><mn>3</mn></math> red balls&nbsp;<math><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mi>x</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow><mrow><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mn>10</mn><mo>+</mo><mi>x</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfrac></math><br />Probability of choosing <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math> red balls and one black ball <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><msup><mrow/><mi>x</mi></msup><msub><mi>C</mi><mn>2</mn></msub><msup><mo>&#160;</mo><mn>10</mn></msup><msub><mi>C</mi><mn>1</mn></msub></mrow><mrow><msup><mrow/><mrow><mn>10</mn><mo>+</mo><mi>x</mi></mrow></msup><msub><mi>C</mi><mn>3</mn></msub></mrow></mfrac></math><br />So,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mrow/><mi>x</mi></msup><msub><mi>C</mi><mn>3</mn></msub></mrow><mrow><msup><mrow/><mrow><mn>10</mn><mo>+</mo><mi>x</mi></mrow></msup><msub><mi>C</mi><mn>3</mn></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow/><mi>x</mi></msup><msub><mi>C</mi><mn>2</mn></msub><msup><mo>&#160;</mo><mn>10</mn></msup><msub><mi>C</mi><mn>1</mn></msub></mrow><mrow><msup><mrow/><mrow><mn>10</mn><mo>+</mo><mi>x</mi></mrow></msup><msub><mi>C</mi><mn>3</mn></msub></mrow></mfrac><msup><mo>&#8658;</mo><mi>x</mi></msup><msub><mi>C</mi><mn>3</mn></msub><msup><mo>=</mo><mi>x</mi></msup><msub><mi>C</mi><mn>2</mn></msub><msup><mo>&#160;</mo><mn>10</mn></msup><msub><mi>C</mi><mn>1</mn></msub></math><br /><math><mo>&#8658;</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mi>x</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow><mrow><msup><mrow><mi mathvariant=\"normal\"></mi></mrow><mrow><mi>x</mi></mrow></msup><msub><mrow><mi>C</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mn>10</mn><mo>&#8658;</mo><mfrac><mrow><mi>x</mi><mo>-</mo><mn>3</mn><mo>+</mo><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mn>10</mn><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>3</mn><mn>2</mn></math>"
  }
