  "question": {
    "text": "A bag contains <math><mn>5</mn></math> white, <math><mn>4</mn></math> black and <math><mn>2</mn></math> red balls. Balls are drawn one by one without replacement. The probability that the&nbsp;<math><msup><mrow><mn>5</mn></mrow><mrow><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">h</mi></mrow></msup></math> ball is a red ball, is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>2</mn></mrow><mrow><mn>11</mn></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>4</mn></mrow><mrow><mn>11</mn></mrow></mfrac></math>",
