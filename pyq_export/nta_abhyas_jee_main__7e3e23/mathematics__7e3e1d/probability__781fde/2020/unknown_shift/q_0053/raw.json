mi mathvariant=\"normal\">s</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">P</mi><mfenced separators=\"|\"><mi mathvariant=\"normal\">H</mi></mfenced></mrow><mrow><mn>1</mn><mo>-</mo><mi>P</mi><mfenced separators=\"|\"><mi>H</mi></mfenced><mi>P</mi><mo>(</mo><mi>T</mi><mo>)</mo></mrow></mfrac><mo>=</mo><mfrac><mi>p</mi><mrow><mn>1</mn><mo>-</mo><mi>p</mi><mo>(</mo><mn>1</mn><mo>-</mo><mi>p</mi><mo>)</mo></mrow></mfrac><mo>=</mo><mfrac><mi>p</mi><mrow><mn>1</mn><mo>-</mo><mi>p</mi><mo>+</mo><msup><mi>p</mi><mn>2</mn></msup></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mi>p</mi><mrow><mn>1</mn><mo>-</mo><mi>p</mi><mo>+</mo><msup><mi>p</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#160;</mo><mfenced separators=\"|\"><mi>given</mi></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>2</mn><mi>p</mi><mo>=</mo><mn>1</mn><mo>-</mo><mi>p</mi><mo>+</mo><msup><mi>p</mi><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>p</mi><mn>2</mn></msup><mo>-</mo><mn>3</mn><mi>p</mi><mo>+</mo><mn>1</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>p</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mo>&#177;</mo><msqrt><mn>5</mn></msqrt></mrow><mn>2</mn></mfrac><mtext>&#8201;</mtext><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mo>&#8756;</mo><mi>p</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mo>+</mo><msqrt><mn>5</mn></msqrt></mrow><mn>2</mn></mfrac><mo>&#62;</mo><mn>1</mn></mrow></mfenced></math><br /><math><mo>&#8658;</mo><mi>p</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mo>-</mo><msqrt><mn>5</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msqrt><mn>5</mn></msqrt><mo>-</mo><mn>1</mn></mrow><mrow