  "question": {
    "text": "Given two independent events, if the probability that both the events occur is <math><mfrac><mrow><mn>8</mn></mrow><mrow><mn>49</mn></mrow></mfrac></math>, the probability that exactly one of them occurs is <math><mfrac><mrow><mn>26</mn></mrow><mrow><mn>49</mn></mrow></mfrac></math>&nbsp;and&nbsp;the probability of more probable of the two events is <math><mi>λ</mi></math>, then <math><mn>14</mn><mi>λ</mi></math> is equal to"
  },
  "options": [
    {
      "text": "<math><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn></math>",
