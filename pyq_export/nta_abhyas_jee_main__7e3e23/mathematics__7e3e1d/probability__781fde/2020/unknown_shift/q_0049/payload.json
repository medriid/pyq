    {
      "text": "<math><mfrac><mrow><mn>21</mn></mrow><mrow><mn>64</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>17</mn></mrow><mrow><mn>632</mn></mrow></mfrac></math>",
