  "question": {
    "text": "A fair coin is tossed once. If it shows head, then <math><mn>2</mn></math> fair dice are thrown simultaneously otherwise <math><mn>3</mn></math> fair dice are thrown simultaneously. The probability that all the dice show different numbers is <math><mi mathvariant=\"normal\">k</mi></math>, then <math><mn>180</mn><mi mathvariant=\"normal\">k</mi></math> is equal to",
    "image": null
  },
  "options": [],
  "correctValue": "125",
  "solution": {
