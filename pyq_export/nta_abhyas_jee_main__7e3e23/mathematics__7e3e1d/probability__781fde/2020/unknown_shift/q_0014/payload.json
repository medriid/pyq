  "question": {
    "text": "If <math><mn>4</mn></math> letter words are formed using letters of the word ‘MORADABAD’, then the probability that D comes exactly once in the&nbsp;<math><mn>4</mn></math> letter word is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>146</mn></mrow><mrow><mn>313</mn></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>213</mn></mrow><mrow><mn>313</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>167</mn></mrow><mrow><mn>313</mn></mrow></mfrac></math>",
      "is_correct": false
    },
