      "text": "<math><mfrac><mrow><mn>164</mn></mrow><mrow><mn>25</mn></mrow></mfrac><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>48</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>316</mn></mrow><mrow><mn>25</mn></mrow></mfrac><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>4</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>48</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>54</mn></mrow><mrow><mn>5</mn></mrow></mfrac><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>4</mn></mrow><mrow><mn>5</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>49</mn></mrow></msup></math>",
