    {
      "text": "<math> <mrow> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>5</mn> </mrow> </mfrac> </mrow> </mfenced> </mrow> <mn>7</mn> </msup> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>8</mn> </mrow> <mrow> <mn>1</mn> <mn>5</mn> </mrow> </mfrac> </mrow> </mfenced> </mrow> <mn>7</mn> </msup> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>2</mn> </mrow> <mrow> <mn>5</mn> </mrow> </mfrac> </mrow> </mfenced> </mrow> <mn>7</mn> </msup> </mrow> </math>",
      "is_correct": false
