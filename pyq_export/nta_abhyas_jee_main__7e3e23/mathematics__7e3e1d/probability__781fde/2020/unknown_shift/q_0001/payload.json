    },
    {
      "text": "<math><mfrac><mrow><mn>36</mn></mrow><mrow><mn>73</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>64</mn></mrow><mrow><mn>73</mn></mrow></mfrac></math>",
      "is_correct": true
    }
