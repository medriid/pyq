  "question": {
    "text": "Bag <math><mi>A</mi></math> contains <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> green and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> red balls and bag <math><mi>B</mi></math> contains <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math> red and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn></math> green balls. One bag is taken at random and a ball is drawn and noted to be green. The probability that it comes from bag <math><mi>B</mi></math>, is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mn>2</mn></mrow><mrow><mn>7</mn></mrow></mfrac></math>",
      "is_correct": false
