  "question": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mi>a</mi><mi>x</mi><mo>+</mo><mi>cos</mi><mi>a</mi><mi>x</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>|</mo><mi>sin</mi><mi>x</mi><mo>|</mo><mo>+</mo><mo>|</mo><mi>cos</mi><mi>x</mi><mo>|</mo></math> are periodic with the same fundamental period, if <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> equals to</p>\r"
  },
  "options": [
    {
      "text": "<math><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>1</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>2</mn></math>",
