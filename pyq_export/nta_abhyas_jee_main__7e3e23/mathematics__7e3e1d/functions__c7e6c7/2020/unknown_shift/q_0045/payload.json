    {
      "text": "<math><mfenced open=\"[\" separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced></math>",
