    "text": "Given, <math> <mrow> <mi>f</mi><mrow><mo>(</mo> <mi>x</mi> <mo>)</mo></mrow><mo>=</mo><mi>cos</mi><mrow><mo>(</mo> <mrow> <mi>ln</mi><mi>x</mi> </mrow> <mo>)</mo></mrow> </mrow> </math><br /><br />Hence,&nbsp;<math> <mrow> <mi>f</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi>f</mi><mrow><mo>(</mo> <mi>y</mi> <mo>)</mo></mrow><mo>−</mo><mfrac> <mn>1</mn> <mn>2</mn> </mfrac> <mrow><mo>[</mo> <mrow> <mi>f</mi><mrow><mo>(</mo> <mrow> <mfrac> <mi>x</mi> <mi>y</mi> </mfrac> </mrow> <mo>)</mo></mrow><mo>+</mo><mi>f</mi><mrow><mo>(</mo> <mrow> <mi>x</mi><mi>y</mi> </mrow> <mo>)</mo></mrow> </mrow> <mo>]</mo></mrow> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>x</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>y</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mfrac> <mn>1</mn> <mn>2</mn> </mfrac> <mo stretchy=\"false\">[</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>x</mi><mo>−</mo><mi>ln</mi><mi>y</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>x</mi><mo>+</mo><mi>ln</mi><mi>y</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">]</mo> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>x</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>y</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mfrac> <mn>1</mn> <mn>2</mn> </mfrac> <mo stretchy=\"false\">[</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>x</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi>cos</mi><mo stretchy=\"false\">(</mo><mi>ln</mi><mi>y</mi><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">]</mo> </mrow> </math>&nbsp; &nbsp;<br /><br /><math><mo>=</mo> <mrow> <mi>cos</mi><mrow><mo>(</mo> <mrow> <mi>ln</mi><mi>x</mi> </mrow> <mo>)</mo></mrow