    "text": "<math><mo>&#8757;</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>10</mn></mrow></mfenced><mo>=</mo><mn>10</mn></math> &hellip; <math><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math><br />Replacing&nbsp;<math><mi mathvariant=\"normal\">x</mi><mo>&#8594;</mo><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>3</mn></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>3</mn></mrow></mfenced><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>3</mn></mrow></mfenced><mo>+</mo><mn>10</mn></mrow></mfenced><mo>=</mo><mn>10</mn></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>10</mn></mrow></mfenced><mo>+</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>19</mn></mrow></mfenced><mo>=</mo><mn>10</mn></math> &hellip; <math><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></math><br />equation <math><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>19</mn></mrow></mfenced><mo>-</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>19</mn></mrow></mfenced></math><br />Now, replace <math><mi mathvariant=\"normal\">x</mi><mo>&#8594;</mo><mfrac><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mn>3</mn><mfenced separators=\"|\"><mrow><mfrac><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mn>19</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mi mathvariant=\"normal\">x</mi></mfenced><mo>=</mo><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>18&#160;&#160;</mn></mrow></mfenced><mo>&#160;</mo><mo>&#8704;</mo><mi mathvariant=\"normal\">x</mi><mo>&#8712;</mo><mi mathvariant=\"normal\">R</mi></math><br />Hence, period of <math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi></mrow></mfenced></math> is <math><mn>18</mn></math>"
