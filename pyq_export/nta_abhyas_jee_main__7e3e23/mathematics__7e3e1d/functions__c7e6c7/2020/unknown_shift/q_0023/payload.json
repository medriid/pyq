    {
      "text": "<math><mfenced open=\"[\" separators=\"|\"><mrow><mn>6</mn><mo>,</mo><mi></mi><mi>∞</mi></mrow></mfenced><mo>∪</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mn>2,4</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced open=\"[\" separators=\"|\"><mrow><mn>6</mn><mo>,</mo><mi>∞</mi></mrow></mfenced><mo>∪</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mn>4</mn></mrow></mfenced></math>",
