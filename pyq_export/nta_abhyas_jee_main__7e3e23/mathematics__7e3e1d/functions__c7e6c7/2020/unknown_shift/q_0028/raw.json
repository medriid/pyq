  "correctValue": "1.5",
  "solution": {
    "text": "Range of <math><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo><mtext>&#8712;</mtext><mfenced open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>,</mo><mi>&#960;</mi></mrow></mfenced></math><br /><math><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac><mo>&#8804;</mo><msup><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#955;</mi><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>&#60;</mo><mi>&#960;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#8805;</mo><mfrac><mrow><mi>&#955;</mi><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfrac><mo>&#62;</mo><mo>-</mo><mn>1</mn><mspace linebreak=\"newline\"/><mo>&#8658;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#8805;</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mi>&#955;</mi><mo>+</mo><mn>3</mn></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfenced></mrow><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfenced></mfrac><mo>&#62;</mo><mo>-</mo><mn>1</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&#8805;</mo><mfrac><mrow><mi>&#955;</mi><mo>+</mo><mn>3</mn></mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfrac><mo>-</mo><mn>1</mn><mo>&#62;</mo><mo>-</mo><mn>1</mn><mspace linebreak=\"newline\"/><mo>&#8658;</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>&#8805;</mo><mfrac><mrow><mi>&#955;</mi><mo>+</mo><mn>3</mn></mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfrac><mo>&#62;</mo><mn>0</mn><mtext>&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;</mtext><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mfenced separators=\"|\"><mi mathvariant=\"normal\">i</mi></mfenced></math><br />Now, <math><mn>3</mn><mo>&#8804;</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn><mo>&#60;</mo><mi mathvariant=\"normal\">&#8734;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>&#8805;</mo><mfrac><mn>1</mn><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mfrac><mo>&#62;</mo><mn>0</mn><mo>&#8230;</mo><mo>&#8230;</mo><mo>.</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br />On comparing <math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math>, we get,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#955;</mi><mo>+</mo><mn>3</mn><mo>=</mo><mfrac><mn>9</mn><mn>2</mn></mfrac><mo>&#8658;</mo><mi>&#955;</mi><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math>",
