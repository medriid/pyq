  "question": {
    "text": "If <math> <mrow> <mtext>f</mtext><mfenced> <mtext>x</mtext> </mfenced><mo>=</mo><mn>2</mn><mtext>x</mtext><mo>−</mo><mi>sin</mi><mtext>x</mtext><mo>,</mo></mrow> </math> <math> <mrow> <mtext>f : R</mtext> <mo>&nbsp;→</mo> <mtext>R</mtext> </mrow> </math> and <math> <mrow> <mtext>g</mtext><mfenced> <mtext>x</mtext> </mfenced><mo>=</mo><msup> <mtext>x</mtext> <mrow> <mfrac> <mn>1</mn> <mn>3</mn> </mfrac> </mrow> </msup> <mo>,</mo></mrow> </math> <math> <mrow> <mtext>g : R</mtext> <mo>&nbsp;→</mo> <mtext>R</mtext> </mrow> </math>, then",
    "image": null
  },
  "options": [
    {
      "id": "TxVtS",
      "text": "both <math> <mtext>f</mtext></math> and <math> <mtext>g</mtext></math> are onto",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1iUTr",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>gof</mi></math> is one-one",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yAX18",
      "text": "both <math> <mtext>f</mtext></math> and <math> <mtext>g</mtext></math> are one - one",
      "image": null,
      "isCorrect": false
    },
