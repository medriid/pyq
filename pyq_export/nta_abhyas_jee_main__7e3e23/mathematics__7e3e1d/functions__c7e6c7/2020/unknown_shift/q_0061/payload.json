  "question": {
    "text": "If <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>1</mn></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">x</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfenced><mo>&lt;</mo><mn>3</mn></math> for all real <math><mi mathvariant=\"normal\">x</mi><mo>,</mo></math> then"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">m</mi><mo>&lt;</mo><mo>-</mo><mn>1</mn></math>",
      "is_correct": false
