  "solution": {
    "text": "<math><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow><msub><mrow><mi>p</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>x</mi></math><br /><math><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow><msub><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>x</mi></math><br /><math><msub><mrow><mi>f</mi></mrow><mrow><mn>3</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow><msub><mrow><mi>p</mi></mrow><mrow><mn>3</mn></mrow></msub><mi>x</mi></math><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>π</mi><mo>=</mo><mi>L</mi><mi>C</mi><mi>M</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>1</mn></msub></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>2</mn></msub></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>3</mn></msub></mrow></mfrac></mrow></mfenced></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>H</mi><mi>C</mi><mi>F</mi><mfenced separators=\"|\"><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><msub><mi>p</mi><mn>2</mn></msub><mo>,</mo><msub><mi>p</mi><mn>3</mn></msub></mrow></mfenced><mo>=</mo><mn>1</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>π</mi><mn>2</mn></mfrac><mo>=</mo><mi>L</mi><mi>C</mi><mi>M</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>1</mn></msub></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>2</mn></msub></mrow></mfrac></mrow></mfenced></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>H</mi><mi>C</mi><mi>F</mi><mfenced separators=\"|\"><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><msub><mi>p</mi><mn>2</mn></msub></mrow></mfenced><mo>=</mo><mn>2</mn><mo>⇒</mo><mfenced close=\"\" open=\"[\" separators=\"|\"><mtable columnalign=\"left\"><mtr><mtd><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mn>2</mn><mi>a</mi></mtd></mtr><mtr><mtd><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn><mi>b</mi></mtd></mtr></mtable></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>π</mi><mn>3</mn></mfrac><mo>=</mo><mi>L</mi><mi>C</mi><mi>M</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>1</mn></msub></mrow></mfrac><mo>,</mo><mfrac><mrow><mn>2</mn><mi>π</mi></mrow><mrow><mn>2</mn><msub><mi>p</mi><mn>3</mn></msub></mrow></mfrac></mrow></mfenced></math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>H</mi><mi>C</mi><mi>F</mi><mfenced separators=\"|\"><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><msub><mi>p</mi><mn>3</mn></msub></mrow></mfenced><mo>=</mo><mn>3</mn><mo>⇒</mo><mtable columnalign=\"left\"><mtr><mtd><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mn>3</mn><mi>x</mi></mtd></mtr><mtr><mtd><msub><mi>p</mi><mn>3</mn></msub><mo>=</mo><mn>3</mn><mi>y</mi></mtd></mtr></mtable></math><br />Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>p</mi><mn>1</mn></msub><mo>=</mo><mn>6</mn><mo>,</mo><mo>&nbsp;</mo><msub><mi>p</mi><mn>2</mn></msub><mo>=</mo><mn>2</mn><mo>,</mo><mo>&nbsp;</mo><msub><mi>p</mi><mn>3</mn></msub><mo>=</mo><mn>3</mn></math>&nbsp;(for minimum value)",
