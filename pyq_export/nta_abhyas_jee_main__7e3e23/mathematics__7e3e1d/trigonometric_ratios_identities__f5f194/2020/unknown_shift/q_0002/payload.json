  "solution": {
    "text": "<p><math><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow><mo>=</mo><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></math><br /><math><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">&#952;</mi><mo>-</mo><mi>&#981;</mi></mrow></mfenced></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mn>3</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow><mo>+</mo><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow></mfrac></math><br />Using <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AM</mi><mo>&#8805;</mo><mi>GM</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>cot</mi><mo>&#8289;</mo><mi>&#981;</mi><mo>+</mo><mn>3</mn><mi>tan</mi><mo>&#8289;</mo><mi>&#981;</mi></mro