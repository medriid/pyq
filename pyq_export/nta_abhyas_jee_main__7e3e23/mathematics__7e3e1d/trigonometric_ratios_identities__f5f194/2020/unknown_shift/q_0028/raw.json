    "text": "<math><mi>A</mi><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>7</mn></math><br />where&nbsp;<math><mi>x</mi><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mn>11</mn><mi>&#960;</mi></mrow><mrow><mn>8</mn></mrow></mfrac></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mi>&#960;</mi><mo>+</mo><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>8</mn></mrow></mfrac></mrow></mfenced><mi></mi></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mn>3</mn><mi>&#960;</mi></mrow><mrow><mn>8</mn></mrow></mfrac></mrow></mrow></math><br /><math><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>8</mn></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>8</mn></mrow></mfrac></mrow></mrow><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>-</mo><mn>1</mn></math><br />i.e.&nbsp;<math><mi>x</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>-</mo><mn>1</mn><mo>&#8658;</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn><mo>+</mo><mn>1</mn><mo>-</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>=</mo><mn>1</mn><mo>-</mo><mn>2</mn><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn></msqrt><mo>-</mo><mn>1</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>x</mi><mn>2</mn></msup><mo>=</mo><mn>1</mn><mo>-</mo><mn>2</mn><mi>x</mi><mspace linebreak=\"newline\"/><mo>&#8658;</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>x</mi><mo>-</mo><mn>1</mn><mo>=</mo><mn>0</mn></math><br />So, <math><mi>A</mi><mo>=</mo><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>6</mn><mo>=</mo><mn>6</mn></math><br /><math><mi>B</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>&#952;</mi></mrow></mrow></mrow><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>&#952;</mi></mrow></mrow></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>&#952;</mi></mrow></mrow></mrow><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>&#952;</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>&#952;</mi></mrow></mrow><mo>+</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mn>4</mn><mi>&#952;</mi></mrow></mrow></mrow></mfenced><mo>=</mo><mn>2</mn></math><br /><math><mo>&#8658;</mo><mi>A</mi><mi>B</mi><mo>=</mo><mn>12</mn><mo>&#8658;</mo><mfrac><mrow><mi>A</mi><mi>B</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>6</mn></math>",
