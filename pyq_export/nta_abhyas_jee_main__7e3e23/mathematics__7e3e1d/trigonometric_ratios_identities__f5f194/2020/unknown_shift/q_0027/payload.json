  "solution": {
    "text": "<math><msqrt><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mn>2</mn></mrow></msup><mi></mi><mi>α</mi></mrow></mfrac></msqrt></math><br /><math><mo>=</mo><msqrt><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow><mo>+</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">e</mi><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup><mi></mi><mi>α</mi></msqrt><mo>=</mo><msqrt><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow><mo>+</mo><mn>1</mn><mo>+</mo><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\"></mi></mrow></msup><mi>α</mi></msqrt></math><br /><math><mo>=</mo><msqrt><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></msqrt><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow></mrow></mfenced></math><br />Since,&nbsp;<math><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow><mo>&lt;</mo><mo>-</mo><mn>1</mn></math> when <math><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>&lt;</mo><mi>α</mi><mo>&lt;</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><math><mo>⇒</mo><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow><mo>&lt;</mo><mn>0</