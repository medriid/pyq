    },
    {
      "text": "<math><msup><mrow><mn>75</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math><msup><mrow><mn>60</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math>",
      "is_correct": false
