  "question": {
    "text": "The angle between the minute hand and the hour hand of a clock at “half past <math><mn>3</mn></math>” is equal to"
  },
  "options": [
    {
      "text": "<math><msup><mrow><mn>90</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mn>80</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math>",
