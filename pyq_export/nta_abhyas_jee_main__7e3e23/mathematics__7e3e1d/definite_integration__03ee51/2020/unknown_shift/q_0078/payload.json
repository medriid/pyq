  "question": {
    "text": "The value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mo>∫</mo><mn>0</mn><mfrac><mi>π</mi><mn>2</mn></mfrac></msubsup><mfenced separators=\"|\"><mrow><mi>cos</mi><mo>⁡</mo><mn>2</mn><mi>x</mi><mi>cos</mi><msup><mn>2</mn><mn>2</mn></msup><mo>⁡</mo><mi>x</mi><mi>cos</mi><msup><mn>2</mn><mn>3</mn></msup><mo>⁡</mo><mi>x</mi><mi>cos</mi><mo>⁡</mo><msup><mn>2</mn><mn>4</mn></msup><mi>x</mi></mrow></mfenced><mi>d</mi><mi>x</mi></math> is equal to"
  },
  "options": [
    {
      "text": "<math><mn>0</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
