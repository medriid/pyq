  "question": {
    "text": "The value of the integral <math><mi mathvariant=\"normal\">Ι</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>100</mn><mi>π</mi></mrow></msubsup><mrow><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></msup></mrow></mfrac></mrow></mrow></math>&nbsp;is equal to"
  },
  "options": [
    {
      "text": "<math><mn>100</mn><mi mathvariant=\"normal\"></mi><mi>π</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>50</mn><mi mathvariant=\"normal\"></mi><mi>π</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>25</mn><mi mathvariant=\"normal\"></mi><mi>π</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>10</mn><mi mathvariant=\"normal\"></mi><mi>π</mi></math>",
