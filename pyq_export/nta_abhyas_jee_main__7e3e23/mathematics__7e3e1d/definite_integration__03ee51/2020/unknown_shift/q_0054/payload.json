  "solution": {
    "text": "Let,&nbsp;<math><mi>I</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>π</mi></mrow></msubsup><mrow><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mn>3</mn></mrow></munderover><mrow><msub><mrow><mi>a</mi></mrow><mrow><mi>r</mi></mrow></msub><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>3</mn><mo>-</mo><mi>r</mi></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mi>r</mi></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi><mi>&nbsp;</mi></mrow></mrow><mi>d</mi><mi>x</mi></mrow></mrow></mrow></mrow></mrow></mrow></math><br /><br /><math><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>π</mi></mrow></msubsup><mrow><msub><mrow><mi>a</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi><mi>&nbsp;</mi><mi>d</mi><mi>x</mi><mo>+</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>π</mi></mrow></msubsup><mrow><msub><mrow><mi>a</mi></mrow><mrow><mn>1</mn></mrow></msub><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>x</mi><mi>d</mi><mi>x</mi></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow></math><br /><br /><math><mo>+</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>π</mi></mrow></msubsup><mrow><msub><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>x</mi><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi><mi>&nbsp;</mi><mi>d</mi><mi>x</mi><mo>+</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>π</mi></mrow></msubsup><mrow><msub><mrow><mi>a</mi></mrow><mrow><mn>3</mn></mrow></msub><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi>x</mi><mi>&nbsp;</mi><mi>d</mi><mi>x</mi></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow></mrow></math><br /><br />Since, <math><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>2</mn><mi>a</mi></mrow></msubsup><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><br /><math><mo>=</mo><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>2</mn><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>a</mi></mrow></msubsup><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mi>d</mi><mi>x</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mo>,</mo><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">f</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>a</mi><mo>-</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mn>0</mn><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mo>,</mo><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">f</mi><mi>&nbsp;</mi><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>a</mi><mo>-</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mo>-</mo><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo></mtd></mtr></mtable></mrow></mfenced></math><br /><br /><math><mo>∴</mo></math> Integral Ist and IIIrd b