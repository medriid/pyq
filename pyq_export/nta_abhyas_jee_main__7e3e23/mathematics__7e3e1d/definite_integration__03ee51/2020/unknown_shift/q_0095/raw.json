    "text": "<math><mi>x</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>y</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced><mi>d</mi><mi>t</mi></mrow></mrow><mo>=</mo><mi>x</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mi>d</mi><mi>t</mi><mo>+</mo><mi>&nbsp;</mi><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mfenced separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mi>d</mi><mi>t</mi></math><br /><br />Differentiate w.r.t. <math><mi>x</mi></math><br /><br /><math><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi><mo>+</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi><mo>+</mo><mi>x</mi><mo>[</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>]</mo><mo>+</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo></mrow></mrow></math><br /><br /><math><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi></mrow></mrow><mo>=</mo><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></munderover><mrow><mi>t</mi><mi>y</mi><mo>(</mo><mi>t</mi><mo>)</mo><mi>d</mi><mi>t</mi><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mi>&nbsp;</mi></mrow></mrow></math><br /><br />Differentiate again w.r.t. <math><mi>x</mi></math><br /><br /><math><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo><mi>x</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>+</mo><mn>2</mn><mi>x</mi><mi>&nbsp;</mi><mi>y</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>y</mi><mi>'</mi><mo>(</mo><mi>x</mi><mo>)</mo><mi>&nbsp;</mi></math><br /><br /><math><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mi>x</mi></mrow></mfenced><mi>y</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>y</mi><mi>'</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math><br /><br /><math><mfrac><mrow><msup><mrow><mi>y</mi><mi>'</mi></mrow></msup><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow><mrow><mi>y</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mi>x</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>y</mi></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>-</mo><mn>3</mn><mi>x</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />Integrating on both sides<br /><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>l</mi><mi>o</mi><mi>g</mi><mi>&nbsp;</mi><mi>y</mi><mi>&nbsp;</mi><mo>=</mo><mi>&nbsp;</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>-</mo><mn>3</mn><mi>l</mi><mi>o</mi><mi>g</mi><mi>&nbsp;</mi><mi>x</mi><mo>+</mo><mi>c</mi></math><br /><br /><math><mo>⇒</mo><mi>l</mi><mi>o</mi><mi>g</mi><mi>&nbsp;</mi><mo>(</mo><msup><mrow><mi>y</mi><mi>&nbsp;</mi><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>)</mo><mi>&nbsp;</mi><mo>=</mo><mi>&nbsp;