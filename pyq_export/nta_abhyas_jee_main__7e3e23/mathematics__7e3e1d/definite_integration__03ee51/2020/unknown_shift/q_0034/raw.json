  "solution": {
    "text": "Given integral is <math><mi>I</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></msubsup><mrow><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfenced></mrow></mfrac></mrow></mrow></math><br />Let,&nbsp;<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mi>&#952;</mi></math><br /><math><mo>&#8658;</mo><mi>d</mi><mi>x</mi><mo>=</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mi></mi><mi>d</mi><mi>&#952;</mi></math><br /><math><mo>&#8756;</mo><mi>I</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msubsup><mrow><mfrac><mrow><mi>d</mi><mi>&#952;</mi></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfrac></mrow></mrow></math><br /><math><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>6</mn></mrow></mfrac></mrow><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></msubsup><mrow><mfrac><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow>