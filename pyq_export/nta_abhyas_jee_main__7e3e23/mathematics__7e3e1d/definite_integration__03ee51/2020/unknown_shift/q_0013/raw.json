    "text": "Consider <math><msub><mrow><mi>I</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>10</mn></mrow><mrow><mn>20</mn></mrow></msubsup><mrow><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>30</mn><mo>-</mo><mi>x</mi></mrow></mfenced></mrow></mrow></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi></math> and <math><msub><mrow><mi>I</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>20</mn></mrow><mrow><mn>30</mn></mrow></msubsup><mrow><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mn>50</mn><mo>-</mo><mi>x</mi></mrow></mfenced></mrow></mrow></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi></math>.&nbsp;Then, the value of&nbsp;<math><mfrac><mrow><msub><mrow><mi>I</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>I</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math>&nbsp;is",
