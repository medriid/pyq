    "text": "Let,&nbsp;<math><mi>y</mi><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></math><br /><math><mo>&#8658;</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>1</mn><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi></mrow></mfenced></mrow></mfenced><mo>&#8712;</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>1,2</mn></mrow></mfenced></math><br /><math><mo>&#8658;</mo><mi>y</mi><mo>&#8712;</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>1</mn><mo>,</mo><msqrt><mn>2</mn></msqrt></mrow></mfenced></math><br /><math><mo>&#8658;</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>1</mn></math><br />Thus, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><munderover><mo>&#8747;</mo><mn>0</mn><mi>&#960;</mi></munderover><mn>1</mn><mo>&#183;</mo><mi>d</mi><mi>x</mi><mo>=</mo><mi>&#960;</mi><mo>-</mo><mn>0</mn></math><br /><math><mo>=</mo><mi>&#960;</mi></math>",
