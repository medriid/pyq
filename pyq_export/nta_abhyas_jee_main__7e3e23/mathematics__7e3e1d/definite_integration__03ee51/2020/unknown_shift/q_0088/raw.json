  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/de492214-3ddc-4cb4-9848-466c44ee7d9e.png\" style=\"max-width:100%; object-fit:contain\" style=\"width:2.7in;height:1.72708in\" /><br />As,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>e</mi><mi>x</mi></msup><mo>-</mo><mn>1</mn><mo>&#62;</mo><mi>x</mi><mo>&#160;</mo><mo>&#8704;</mo><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\">&#8734;</mi></mrow></mfenced></math><br /><math><mo>&#8756;</mo><mfrac><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>-</mo><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>&#62;</mo><mn>1</mn></math><br />Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mfrac><mrow><msup><mi>e</mi><mi>x</mi></msup><mo>-</mo><mn>1</mn></mrow><mi>x</mi></mfrac><mi>d</mi><mi>x</mi><mo>&#62;</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><mn>1</mn><mi>d</mi><mi>x</mi></math><br /><math><mo>&#8658;</mo><mi>A</mi><mo>&#62;</mo><mn>1</mn></math><br />And,&nbsp;<math><mi>B</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi><mo>&#60;</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><mn>1</mn></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>B</mi><mo>&#60;</mo><mn>1</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mo>&#160;</mo><mi>B</mi><mo>&#60;</mo><mn>1</mn><mo>&#60;</mo><mi>A</mi></math>",
