  "solution": {
    "text": "In <math><msub><mrow><mi mathvariant=\"normal\">&#921;</mi></mrow><mrow><mn>2</mn></mrow></msub></math> substitute <math><mi>x</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>t</mi></mrow></mfrac><mo>&#8658;</mo><mi>d</mi><mi>x</mi><mo>=</mo><mo>-</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br />So,&nbsp;<math><msub><mrow><mi mathvariant=\"normal\">&#921;</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mo>-</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn></mrow><mrow><mn>0</mn></mrow></munderover><mrow><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>t</mi></mrow></mrow></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>&#8901;</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mo>-</mo><mi>d</mi><mi>t</mi></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>t</mi></mrow></mrow></mrow></mfenced></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mi>d</mi><mi>t</mi></mrow></mrow><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">&#921;</mi></mrow><mrow><mn>1</mn></mrow></msub></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"{\" close=\"}\" separators=\"|\"><mrow><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">s</mi><mo>&#160;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>ln</mi><mo>&#8289;