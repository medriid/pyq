  "solution": {
    "text": "We know that, <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>+</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable columnalign=\"left\"><mtr><mtd><mo>-</mo><mn>1</mn></mtd><mtd><mo>,</mo></mtd><mtd><mi>x</mi><mo>∉</mo><mi>Z</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mo>,</mo></mtd><mtd><mi>x</mi><mo>∈</mo><mi>Z</mi></mtd></mtr></mtable></mrow></mfenced></math><br />So, <math><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>12</mn><mi>π</mi></mrow></msubsup><mrow><mfenced separators=\"|\"><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow></mrow></mfenced><mo>+</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow></mrow></mfenced></mrow></mfenced><mi>d</mi><mi>t</mi></mrow></mrow></math><br /><math><mo>=</mo><mn>6</mn><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>2</mn><mi>π</mi></mrow></msubsup><mrow><mfenced separators=\"|\"><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow></mrow></mfenced><mo>+</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>t</mi></mrow></mrow></mrow></mfenced></mrow></mfenced><mi>d</mi><mi>t</mi></mrow></mrow></math><br /><math><mo>=</mo><mn>6</mn><mfenced separators=\"|\"><mrow><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msubsup><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn></mrow></mfenced><mi>