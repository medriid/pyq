    "text": "Let&nbsp;<math><mi>I</mi><mo>=</mo><mi>&#160;</mi><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>4</mn></mrow><mrow><mn>10</mn></mrow></munderover><mrow><mfrac><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>28</mn><mi>x</mi><mo>+</mo><mn>196</mn></mrow></mfenced><mo>+</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi></math> ........(i)<br /><br />Use <math><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mi>a</mi></mrow><mrow><mi>b</mi></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mi>d</mi><mi>x</mi></mrow></mrow><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mi>a</mi></mrow><mrow><mi>b</mi></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>-</mo><mi>x</mi></mrow></mfenced></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mi>&#160;</mi><munderover><mo>&#8747;</mo><mn>4</mn><mn>10</mn></munderover><mfrac><mfenced open=\"[\" close=\"]\" separators=\"|\"><msup><mfenced separators=\"|\"><mrow><mn>14</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mn>2</mn></msup></mfenced><mrow><mfenced open=\"[\" close=\"]\" separators=\"|\"><msup><mi>x</mi><mn>2</mn></msup></mfenced><mo>+</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><msup><mfenced separators=\"|\"><mrow><mn>14</mn><mo>-</mo><mi>x</mi></mrow></mfenced><mn>2</mn></msup></mfenced></mrow></mfrac><mi>&#160;</mi><mi>d</mi><mi>x</mi></math> ......(ii)<br /><br />(i) + (ii)<br /><br />we get&nbsp;<math xmlns=\"http://www.w3.org/19