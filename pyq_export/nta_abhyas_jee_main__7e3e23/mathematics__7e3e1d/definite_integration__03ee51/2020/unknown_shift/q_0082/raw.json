  "correctValue": null,
  "solution": {
    "text": "Since, <math><mi>I</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><msqrt><mi>x</mi></msqrt></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi><mo>&#60;</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><msqrt><mi>x</mi></msqrt></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><br />as in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mn>0,1</mn></mfenced><mo>,</mo><mo>&#160;</mo><mi>x</mi><mo>&#62;</mo><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></math><br /><br /><math><mi>I</mi><mo>&#60;</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><msqrt><mi>x</mi></msqrt></mrow></mrow><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mrow><mrow><mn>3</mn></mrow><mo>/</mo><mrow><mn>2</mn></mrow></mrow></mrow></msup></mrow></mfenced></mrow><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mo>&#8658;</mo><mi>I</mi><mo>&#60;</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><br />For,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mn>0,1</mn></mfenced><mo>,</mo><mo>&#160;</mo><mfrac><mrow><mi>cos</mi><mo>&#8289;</mo><mi>x</mi></mrow><msqrt><mi>x</mi></msqrt></mfrac><mo>&#60;</mo><mfrac><mn>1</mn><msqrt><mi>x</mi></msqrt></mfrac></math><br /><br />Hence,&nbsp;<math><mi>J</mi><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><msqrt><mi>x</mi></msqrt></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi><mo>&#60;</mo><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><msup><mrow><mi>x</mi></mrow><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mrow><mi>d</mi><mi>x</mi><mo>=</mo><mn>2</mn><mo>&#8658;</mo><mi>J</mi><mo>&#60;</mo><mn>2</mn></math>",
