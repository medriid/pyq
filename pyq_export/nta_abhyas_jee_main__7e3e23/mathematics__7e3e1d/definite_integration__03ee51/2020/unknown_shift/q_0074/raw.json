    "text": "Given,&nbsp;<math><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup></mrow></mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mi>a</mi></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mo>&#8901;</mo><mi>x</mi><mi>d</mi><mi>x</mi><mo>=</mo><mi>a</mi><msubsup><mo>&#8747;</mo><mn>0</mn><mn>1</mn></msubsup><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mi>d</mi><mi>x</mi></math><br />Put <math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>t</mi></math> (in LHS)<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mn>2</mn></mfrac></math><br />So,&nbsp;<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>t</mi></mrow></msup><mi>d</mi><mi>t</mi></mrow></mrow><mo>=</mo><mi>a</mi><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>e</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mi>a</mi><mrow><msubsup><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mrow><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi>