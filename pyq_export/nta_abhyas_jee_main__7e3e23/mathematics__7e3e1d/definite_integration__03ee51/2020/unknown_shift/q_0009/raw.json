    "text": "<math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>3</mn><mi>x</mi></mrow></mrow><mo>=</mo><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>-</mo><mn>4</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><msup><mo>&#8289;</mo><mn>3</mn></msup><mi>x</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac><mi>sin</mi><mo>&#8289;</mo><mi>x</mi><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mi>sin</mi><mo>&#8289;</mo><mn>3</mn><mi>x</mi></math><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munderover><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">&#8734;</mi></munderover><mfrac><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mi mathvariant=\"normal\">n</mi><mn>3</mn></msup><mi>x</mi></mrow><mi>x</mi></mfrac><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac><munderover><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">&#8734;</mi></munderover><mfrac><mrow><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow><mi>x</mi></mfrac><mi>d</mi><mi>x</mi><mo>-</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><munderover><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">&#8734;</mi></munderover><mfrac><mrow><mi>sin</mi><mo>&#8289;</mo><mn>3</mn><mi>x</mi></mrow><mi>x</mi></mfrac><mi>d</mi><mi>x</mi></math><br /><math><mo>=</mo><mfrac><mrow><mn>3</mn><mi>k</mi></mrow><mrow><mn>4</mn></mrow></mfrac><mo>-</mo><mfrac><mrow><mi mathvariant=\"normal\">&#921;</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math> (let)<br /><math><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mi mathvariant=\"normal\">&#8734;</mi></mrow></munderover><mrow><mfrac><mrow><mrow><mrow><m