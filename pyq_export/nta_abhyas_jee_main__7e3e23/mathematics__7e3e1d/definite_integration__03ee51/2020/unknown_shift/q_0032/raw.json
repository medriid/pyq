  "solution": {
    "text": "As,&nbsp;<math><mi>x</mi><mo>∈</mo><mfenced separators=\"|\"><mrow><mn>0,1</mn></mrow></mfenced><mo>⇒</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&gt;</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></math><br /><math><mo>⇒</mo><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&gt;</mo><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></math> or <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>&lt;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></math><br />Thus,&nbsp;<math><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mrow><mo>&lt;</mo><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></mrow></mrow></math><br />i.e., <math><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mi>x</mi></mrow></mfenced></mrow><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></msubsup><mo>&lt;</mo><mi>A</mi></math><br /><math><mo>⇒</mo><mi>A</mi><mo>&gt;</mo><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvar