  "solution": {
    "text": "Let,&nbsp;<math><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mo>-</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></mrow><mrow><mn>2</mn><mo>+</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math><br />Then,&nbsp;<math><mi>f</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mo>+</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></mrow><mrow><mn>2</mn><mo>-</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow></mrow></math><br /><math><mo>=</mo><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mo>-</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></mrow><mrow><mn>2</mn><mo>+</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow></mrow></math><br /><math><mo>=</mo><mo>-</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math><br />Hence,&n