  "solution": {
    "text": "In <math><mi>A</mi><mo>,</mo></math> let <math><msup><mrow><mi>x</mi></mrow><mrow><mn>12</mn></mrow></msup><mo>=</mo><mi>t</mi></math><br /><math><mo>⇒</mo><mn>12</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>11</mn></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><math><mo>⇒</mo><mi>A</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>12</mn></mrow></mfrac><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup></mrow></mrow><mi>d</mi><mi>t</mi></math><br />In <math><mi>B</mi><mo>,</mo></math> let <math><msup><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>=</mo><mi>u</mi></math><br /><math><mo>⇒</mo><mn>4</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>u</mi></math><br /><math><mo>⇒</mo><mi>B</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><msup><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mrow><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mn>1</mn></mrow></munderover><mrow><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mi>d</mi><mi>t</mi></mrow></mrow></math><br /><math><mo>⇒</mo><mi>B</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>12</mn><mi>A</mi></mrow></mfenced><mo>⇒</mo><mi>B</mi><mo>=</mo><mn>3</mn><mi>A</mi></math><br />"
