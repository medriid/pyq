  "question": {
    "text": "Let <math><mi>S</mi></math> be the set of all real numbers. Then, the relation <math><mi>R</mi><mo>=</mo><mo>{</mo><mfenced separators=\"|\"><mrow><mi>a</mi><mo>,</mo><mi>&nbsp;</mi><mi>b</mi></mrow></mfenced><mo>:</mo><mn>1</mn><mo>+</mo><mi>a</mi><mi>b</mi><mo>&gt;</mo><mn>0</mn><mo>}</mo></math> on <math><mi>S</mi></math> is",
    "image": null
  },
  "options": [
    {
      "id": "iWGWk",
      "text": "reflexive and symmetric but not transitive",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "QHDD5",
      "text": "reflexive and transitive but not symmetric",
      "image": null,
      "isCorrect": false
    },
    {
