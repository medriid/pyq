  "solution": {
    "text": "<math><mo>∵</mo></math> <math><mi>R</mi><mo>=</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mi>x</mi><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mi>y</mi></mrow></mfenced></mrow><mrow><mi>x</mi><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mi>y</mi><mo>∈</mo><mi>Z</mi><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>≤</mo><mn>4</mn></mrow></mfenced></math><br /><br />&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mn>2</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>0</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>0</mn></mrow></mfenced><mo>,</mo><mo>(</mo><mn>0</mn><mo>,</mo><mo>&nbsp;</mo><mo>-</mo><mn>1</mn><mo>)</mo><mo>,</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>1</mn></mrow></mfenced><mo>,</mo><mo>(</mo><mn>1</mn><mo>,</mo><mo>&nbsp;</mo><mo>-</mo><mn>1</mn><mo>)</mo><mo>,</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>1</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>2</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mo>-</mo><mn>2</mn></mrow></mfenced><mo>,</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>0</mn></mrow></mfenced><mo>,</mo><mo>(</mo><mn>0</mn><mo>,</mo><mo>&nbsp;</mo><mn>1</mn><mo>)</mo><mo>,</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>1</mn></mrow></mfenced><mo>,</mo><mo>(</mo><mo>-</mo><mn>1</mn><mo>,</mo><mo>&nbsp;</mo><mo>-</mo><mn>1</mn><mo>)</mo><mo>,</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>0</mn></mrow></mfenced><mo>,</mo><mo>(</mo><mn>0</mn><mo>,</mo><mo>&nbsp;</mo><mn>0</mn><mo>)</mo></mrow></mfenced></math><br /><br />Hence, Domain of <math><mi>R</mi><mo>=</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mo>-</mo><mn>2</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mo>-</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>0</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>2</mn></mrow></mfenced></math>"
