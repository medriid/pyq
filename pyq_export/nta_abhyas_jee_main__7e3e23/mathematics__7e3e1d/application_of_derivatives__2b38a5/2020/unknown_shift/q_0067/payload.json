  "solution": {
    "text": "Area of triangle&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mi>C</mi><mo>,</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#9651;</mo><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mfenced close=\"|\" open=\"|\" separators=\"|\"><mtable columnalign=\"left\"><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mi>&#952;</mi></mtd><mtd><mi>cos</mi><mo>&#8289;</mo><mi>&#952;</mi></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><msup><mi>sin</mi><mn>3</mn></msup><mo>&#8289;</mo><mi>&#952;</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable></mfenced></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#9651;</mo><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>sin</mi><mn>3</mn></msup><mo>&#8289;</mo><mi>&#952;</mi><mi>cos</mi><mo>&#8289;</mo><mi>&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mo>&#9651;</mo></mrow><mrow><mi>d</mi><mi>&#952;</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn><msup><mi>sin</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>&#952;</mi><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>&#952;</mi><mo>-</mo><msup><mi>sin</mi><mn>4</mn></msup><mo>&#8289;</mo><mi>&#952;</mi></mrow><mn>2</mn></mfrac><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mi>sin</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>&#952;</mi><mfenced separators=\"|\"><mrow><mn>3</mn><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>&#952;</mi><mo>-</mo><msup><mi>sin</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>&#952;</mi></mrow></mfenced><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>sin</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>=</mo><mn>0</mn></math> or <math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>=</mo><mn>3</mn></math><br /><math><mi>&#952;</mi><mo>=</mo><mn>0</mn></math>&nbsp;or&nbsp; <math><mi>&#952;</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>&#9651;</mo></mrow><mrow><mi>d</mi><msup><mi>&#952;</mi><mn>2</mn></msup></mrow></mfrac></mfenced><mo>&#60;</mo><mn>0</mn><mo>&#160;</mo><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">r</mi><mo>&#160;</mo><mi>&#952;</mi><mo>=</mo><mfrac><mi>&#960;</mi><mn>3</mn></mfrac></math>"
