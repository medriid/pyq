  "question": {
    "text": "<p>The function <math><msup><mrow><mi>x</mi></mrow><mrow><mn>5</mn></mrow></msup><mo>-</mo><mn>5</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><mn>5</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><mn>1</mn></math> is</p>\r",
    "image": null
  },
  "options": [
    {
      "id": "j16aX",
