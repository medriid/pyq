  "solution": {
    "text": "<p>Given,&nbsp;<math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mn>3</mn><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>-</mo><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow><mrow><msqrt><mn>10</mn></msqrt></mrow></mfrac></math> and <math><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></mrow><mrow><msqrt><mn>11</mn></msqrt></mrow></mfrac></math></p><p>So,&nbsp;<math><mo>|</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>|</mo><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mo>|</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>|</mo><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>2</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8901;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#215;</mo><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>3</mn><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mfenced><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>3</mn><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfenced><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>-</mo><mfenced><mrow><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>3</mn><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced></mrow></mfenced><mover><mi>a</mi><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#183;</mo><mfenced separators=\"|\"><mrow><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>+</mo><mn>3</mn><mover><mi>a</mi><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>7</mn></math></p>"
