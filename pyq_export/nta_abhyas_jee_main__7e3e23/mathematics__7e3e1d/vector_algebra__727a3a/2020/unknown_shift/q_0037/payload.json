    "text": "<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>1</mn><mo>,</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>4</mn><mo>,</mo><mi></mi><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>^</mo></mover><mo>=</mo><mn>2</mn></math><br /><math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>×</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>^</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover></math><br />Taking dot with <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></math><br /><math><mn>0</mn><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></math><br /><math><mfrac><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><math><mo>⇒</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>=</mo><mn>2</mn></math>&nbsp;...(i)<br /><math><mo>⇒</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow><mo>=</mo><mn>2</mn></math><br /><math><mo>⇒</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">θ</mi></mrow></mrow><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>⇒</mo><mi mathvariant=\"normal\">θ</mi><mo>=</mo><msup><mrow><mn>60</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math> (angle between <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></math> and <math><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></math> )<br />Taking dot with <math><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>→</mo></mover><mo>×</mo><mover><mi>r</mi><mo>→</mo></mover></mrow></mfenced><mo>⋅</mo><mover><mi>b</mi><mo>→</mo></mover><mo>+</mo><mover><mi>b</mi><mo>→</mo></mover><mo>⋅</mo><mover><mi>b</mi><mo>→</mo></mover><mo>=</mo><mover><mi>r</mi><mo>→</mo></mover><mo>⋅</mo><mover><mi>b</mi><mo>→</mo></mover></math>&nbsp;<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mover><mi>r</mi><mo>→</mo></mover><mover><mi>a</mi><mo>→</mo></mover><mover><mi>b</mi><mo>→</mo></mover></mrow></mfenced><mo>+</mo><mn>16</mn><mo>=</mo><mover><mi>r</mi><mo>→</mo></mover><mo>⋅</mo><mover><mi>b</mi><mo>→</mo></mover></math>&nbsp;...(ii)<b