    "text": "<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>1</mn><mo>,</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>4</mn><mo>,</mo><mi></mi><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>^</mo></mover><mo>=</mo><mn>2</mn></math><br /><math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>×</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>^</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover></math><br />Taking dot with <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></math><br /><math><mn>0</mn><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></math><br /><math><mfrac><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><math><mo>⇒</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow