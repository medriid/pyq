  "solution": {
    "text": "<p><math><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover><mo>-</mo><mn>2</mn><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi mathvariant=\"normal\">&#955;</mi><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">a</mi></mrow><mo>&#8594;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mover><mi mathvariant=\"normal\">b</mi><mo>&#8594;</mo></mover><mo>-</mo><mn>2</mn><mover><mi mathvariant=\"normal\">c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mi mathvariant=\"normal\">&#955;</mi><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi mathvariant=\"normal\">a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi mathvariant=\"normal\">b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>+</mo><mn>4</mn><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi mathvariant=\"normal\">c</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>4</mn><mover><mi mathvariant=\"normal\">b</mi><mo>&#8594;</mo></mover><mo>.</mo><mover><mi mathvariant=\"normal\">c</mi><mo>&#8594;</mo></mover><mo>=</mo><msup><mi mathvariant=\"normal\">&#955;</mi><mn>2</mn></msup><mn>2</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>16</mn><mo>+</mo><mn>4</mn><mo>-</mo><mn>4</mn><mover><mi mathvariant=\"normal\">b</mi><mo>&#8594;</mo></mover><mo>.</mo><mover><mi mathvariant=\"normal\">c</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>2</mn><msup><mi mathvariant=\"normal\">&#955;</mi><mn>2</mn></msup><mspace linebreak=\"newline\"/><mo>&#8658;</mo><msup><mi mathvariant=\"normal\">&#955;</mi><mn>2</mn></msup><mo>=</mo><mn>10</mn><mo>-</mo><mn>2</mn><mover><mi mathvariant=\"normal\">b</mi><mo>&#8594;</mo></mover><mo>.</mo><mover><mi mathvariant=\"normal\">c</mi><mo>&#8594;</mo></mover><mo>&#160;</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>&#160;</mo><mfenced><mn>1</mn></mfenced></math><br />Now,&nbsp;<math><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mn>15</mn><mo>+</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>16</mn></math><br /><math><mo>&#8658;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mo>&#177;</mo><mn>1</mn></math><br />The angle between <math><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover></math> and <math><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover></math> is acute<br />Hence,&nbsp;<math><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">b</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi mathvariant=\"normal\">c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>1</mn></math><br />from <math><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math></p><p><math><msup><mrow><mi mathvariant=\"normal\">&#955;</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>8</mn><mo>&#8658;</mo><mi mathvariant=\"normal\">&#955;</mi><mo>=</mo><mo>&#177;</mo><mn>2</mn><msqrt><mn>2</mn></msqrt></math></p>"
