    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mn>3</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>-</mo><mn>4</mn><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mspace linebreak=\"newline\"/><mo>=</mo><mn>9</mn><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>+</mo><mn>16</mn><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>24</mn><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8901;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></math><br /><math><mo>&#8757;</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>b</m