  "solution": {
    "text": "<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\"></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mi>sin</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>=</mo><mn>3</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mi>sin</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>=</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>a</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mn>2</mn></msup><mo>-</mo><mn>2</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></math><br /><math><mo>=</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><mo>-</mo><mn>2</mn><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></math><br /><math><mo>=</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><mo>-</mo><mn>4</mn><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></math><br /><math><mo>=</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">e</mi><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&#952;</mi><mo>+</mo><mn>4</mn><mo>-</mo><mn>6</mn><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></math><br /><math><mo>=</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">t</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&#952;</mi><mo>-</mo><mn>6</mn><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>+</mo><mn>4</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mi>c</mi><mo>-</mo><mi>a</mi></mrow></mfenced><mn>2</mn></msup><mo>=</mo><mfrac><mn>9</mn><mn