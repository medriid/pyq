    "text": "Given,&nbsp;<math><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br />Taking right cross product with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>c</mi><mo>&#8594;</mo></mover></math>, we get,&nbsp;<br /><math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>-</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mover><mi>r</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#8658;</mo><mover><mi>r</mi><mo>&#8594;</mo></mover><mo>=</mo><mn>3</mn><m