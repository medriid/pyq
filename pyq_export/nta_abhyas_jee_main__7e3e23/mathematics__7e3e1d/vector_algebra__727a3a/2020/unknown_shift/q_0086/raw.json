  "solution": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi></math> <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>3</mn></mrow></mfenced></mrow></mfenced></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Q</mi></math> <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>3</mn></mrow></mfenced></mrow></mfenced></math><br /><math><mo>&#8757;</mo></math> <math><mover accent=\"true\"><mrow><mi>O</mi><mi>P</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>=</mo><mn>1</mn><mo>&#8658;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>1</mn><mo>&#8658;</mo><mi>P</mi><mo>(</mo><mn>1,2</mn><mo>)</mo></math><br /><math><mo>&#8757;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>O</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover><mi>j</mi><mo>^</mo></mover><mo>=</mo><mn>3</mn><mo>&#8658;</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mi mathvariant=\"normal\">g</mi><mn>2</mn></msub><mfenced separators=\"|\"><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>+</mo><mn>3</mn></mrow></mfenced><mo>=</mo><mn>3</mn><mo>&#8658;</mo><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><mn>5</mn><mo>&#8658;</mo><mi>Q</mi><mfenced separators=\"|\"><mn>5,3</mn></mfenced></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>O</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover><mo>-</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>O</mi><mi>P</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>5</mn><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mfenced></mrow></mfenced></math><br /><math><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>3</mn><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>-</mo><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mi mathvariant=\"normal\"></mi></mrow></mfenced><mo>=</mo><msqrt><mn>10</mn></msqrt></math>",
