    "text": "Given,&nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced><mi mathvariant=\"normal\"></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mi mathvariant=\"normal\"></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>3</mn><mo>·</mo><mn>4</mn><mo>·</mo><mn>5</mn><mo>=</mo><mn>60</mn></math><br />Also,&nbsp;<math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>60</mn><mi mathvariant=\"normal\"></mi><mo>⇒</mo><mi mathvariant=\"normal\"></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover></mrow></mfenced><mi mathvariant=\"normal\"></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mi mathvariant=\"normal\"></mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfenced></math><br /><math><mo>⇒</mo><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>,</mo><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>,</mo><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></math> are mutually perpendicular vectors<br />Also, <math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>×</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>×</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mi mathvariant=\"normal\"></mi><mo>·</mo><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover><mo>-</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover><mi mathvariant=\"normal\"></mi><mo>·</mo><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></math><br /><math><mo>=</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></math><br />Hence,&nbsp;<math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>+</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>+</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced><mi mathvariant=\"normal\"></mi><mo>·</mo><mi mathvariant=\"normal\"></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>=</mo><mn>2</mn><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>32</mn></math>",
