  "solution": {
    "text": "Let <math><mi>P</mi></math> and <math><mi>Q</mi></math> be <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi></mi><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>,</mo><mi></mi><msub><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math><br /><math><mover accent=\"true\"><mrow><mi>O</mi><mi>P</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>=</mo><mn>5</mn><mo>&#8658;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>5</mn></math><br /><math><mover accent=\"true\"><mrow><mi>O</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>=</mo><mo>-</mo><mn>5</mn><mo>&#8658;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mo>-</mo><mn>5</mn></math><br />Let <math><mi>y</mi><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>11</mn></mrow></msup><mo>-</mo><mn>2</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>7</mn></mrow></msup><mo>+</mo><mn>7</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><mn>11</mn><mi>x</mi><mo>+</mo><mn>6</mn></math><br />&there4; <math><msub><mrow><mi>y</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mn>5</mn></mrow></mfenced></math><br /><math><msub><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mn>5</mn></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>O</mi><mi>P</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover><mrow><mi>O</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>+</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mfenced><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mfenced separators=\"|\"><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>+</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mfenced><mover><mi>j</mi><mo>^</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced separators=\"|\"><mrow><mi>f</mi><mfenced separators=\"|\"><mn>5</mn></mfenced><mo>+</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mo>-</mo><mn>5</mn></mrow></mfenced></mrow></mfenced><mover><mi>j</mi><mo>^</mo></mover><mo>=</mo><mn>12</mn><mover><mi>j</mi><mo>^</mo></mover></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>O</mi><mi>P</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>O</mi><mi>Q</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>1</mn><mn>2</mn></math>"
