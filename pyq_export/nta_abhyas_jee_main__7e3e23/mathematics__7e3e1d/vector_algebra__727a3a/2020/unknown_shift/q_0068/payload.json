    "text": "<math><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>2</mn><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>-</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>4</mn><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>9</mn><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>12</mn><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>⋅</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></math><br /><math><mo>=</mo><mn>36</mn><mo>+</mo><mn>144</mn><mo>-</mo><mn>12</mn><mo>×</mo><mn>3</mn><mo>×</mo><mn>4</mn><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><math><mo>=</mo><mn>10</mn><mn>8</mn></math><br /><math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>2</mn><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>-</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced><mo>=</mo><mn>6</mn><msqrt><mn>3</mn></msqrt></math><br />As we know that,<br /><math><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>×</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>→</mo></mover><mo>-</mo><mn>3</mn><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>→</mo></mover></mrow></mfenced></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>→</mo></mover><mo>⋅</mo><