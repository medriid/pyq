&#160;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mover><mi>r</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>S</mi><mo>&#8594;</mo></mover><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#160;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#160;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>r</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\"><mover><mi>S</mi><mo>&#8594;</mo></mover></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#160;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#160;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced></mfenced></math><br /><math><mo>=</mo><mn>1</mn><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mtable><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>4</mn></mtd><mtd><mo>-</mo><mn>1</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd><mtd><mn>1</mn></mtd><mtd><mn>2</mn></mtd></mtr></mtable></mrow></mfenced></mrow></mfenced></math><br /><math><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>1</mn><mfenced separators=\"|\"><mrow><mn>9</mn></mrow></mfenced><mo>-</mo><mn>1</mn><mfenced separators=\"|\"><mrow><mn>3</mn></mrow></mfenced><mo>+</mo><mn>1</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mn>3</mn></mrow></mfenced></mrow></mfenced></math><br /><math><mo>=</mo><mn>3</mn></math></p>",
