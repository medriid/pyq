  "solution": {
    "text": "<p>Let <math><mover accent=\"true\"><mrow><mi>r</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>S</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>S</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>S</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><math><mover accent=\"true\"><mrow><mi>S</mi></mrow><mo>&#8594;</mo></mover></math> can be written as a linear combination of <math><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>,</mo><mi></mi><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>,</mo><mi></mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br /><math><mover accent=\"true\"><mrow><mi>S</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>x</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mi>y</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mi>z</mi><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></math><br />Taking dot with <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>S</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>x</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mover><mi>b</mi><mo>&#8594;</mo></mover><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mfrac><mrow><mover><mi>S</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover></mrow><mrow><mo>[</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mover><mi>b</mi><mo>&#8594;</mo></mover><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>]</mo></mrow></mfrac></math><br />Taking dot with <math><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>S</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>=</mo><mi>y</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mover><mi>b</mi><mo>&#8594;</mo></mover><mover><mi>c</m