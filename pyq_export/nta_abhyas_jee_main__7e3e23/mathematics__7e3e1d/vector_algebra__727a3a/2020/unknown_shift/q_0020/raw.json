    "text": "<p><math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn></math> (Given)<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>c</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>d</mi><mo>&#8594;</mo></mover></mfenced><mo>=</mo><mn>1</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mspace linebreak=\"newline\"/><mi mathvariant=\"normal\">&#160;</mi><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#8901;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></math><br /><math><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#215;</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>26</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mn>6</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8901;</mo><mover><mi>d</mi><mo>&#8594;</mo></mover></mrow></mfenced><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>-</mo><mfenced separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8901;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></mrow></mfenced><mover><mi>d</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mn>3</mn><mn>26</mn></mfrac><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mfrac><mn>2</mn><mn>13</mn></mfrac><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mfrac><mn>6</mn><mn>13</mn></mfrac><mover><mi>k</mi><mo>^</mo></mover></math>&nbsp; &nbsp;...<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8757;</mo><mo>&#160;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>,</mo><mo>&#160;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>,</mo><mo>&#160;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></math> are coplanar <math><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>&#8901;</mo><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>0</mn></math><br /><br /><math><mo>&#8757;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></math> is perpendicular to <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>,</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>&#8658;</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></math> must be parallel to <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br /><br />So, the angle between <math><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></math> and <math><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math> is either <math><msup><mrow><mn>0</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math> or <math><mn>18</mn><msup><mrow><mn>0</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math><br /><br />From <math><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math>, we get,<br /><br /><math><mo>&#177;</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>26</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mn>6</mn></mrow><mrow><mn>13</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>k</mi></mrow><mo>^</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#177;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>a</mi><mo>&#8594;</mo></mover></mfenced><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>b</mi><mo>&#8594;</mo></mover></mfenced><mi>sin</mi><mo>&#8289;</mo><msup><mn>30</mn><mi mathvariant=\"normal\">o</mi></msup><mfenced open=\"|\" close=\"|\" separators=\"|\"><mover><mi>d</mi><mo>&#8594;</mo></mover></mfenced><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mfrac><mn>3</mn><mn>26</mn></mfrac><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mfrac><mn>2</mn><mn>13</mn></mfrac><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mfrac><mn>6</mn><mn>13</mn></mfrac><mover><mi>k</mi><mo>^</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mo>&#177;</mo><mfrac><mover><mi>c</mi><mo>&#8594;</mo></mover><mn>2</mn></mfrac><mo>=</mo><mfrac><mn>3</mn><mn>26</mn></mfrac><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mfrac><mn>2</mn><mn>13</mn></mfrac><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mfrac><mn>6</mn><mn>13</mn></mfrac><mover><mi>k</mi><mo>^</mo></mover><mspace linebreak=\"newline\"/><mo>&#8658;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mo>&#177;</mo><mfrac><mfenced separators=\"|\"><mrow><mn>3</mn><mover><mi>i</mi><mo>^</mo></mover><mo>-</mo><mn>4</mn><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mn>12</mn><mover><mi>k</mi><mo>^</mo></mover></mrow></mfenced><mn>13</mn></mfrac></math></p>",
