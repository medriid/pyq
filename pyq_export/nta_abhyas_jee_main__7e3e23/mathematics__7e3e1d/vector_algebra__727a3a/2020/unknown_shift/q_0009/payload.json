  "solution": {
    "text": "<p><img src=\"assets\\st0009_71cd4cca86ca.png\" style=\"max-width:100%; object-fit:contain\" style=\"width:2.08681in;height:1.05347in\" /></p><p>We have <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>A</mi><mi>B</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><mn>8</mn><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mn>8</mn><mover><mi>j</mi><mo>^</mo></mover><mo>=</mo><mn>8</mn><mfenced separators=\"|\"><mrow><mo>-</mo><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mover><mi>j</mi><mo>^</mo></mover></mrow></mfenced></math>,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><mi>A</mi><mi>C</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><mfrac><mn>11</mn><mn>5</mn></mfrac><mo>-</mo><mn>1</mn></mrow></mfenced><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mfenced separators=\"|\"><mrow><mfrac><mn>2</mn><mn>5</mn></mfrac><mo>+</mo><mn>2</mn></mrow></mfenced><mover><mi>j</mi><mo>^</mo></mover></math><br /><math><mo>=</mo><mfrac><mrow><mn>6</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mn>12</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>=</mo><mfrac><mrow><mn>6</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mfenced></math><br /><math><mo>&#8756;</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>=</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mfenced><mo>&#8901;</mo><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>2</mn><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></mrow></mfenced></mrow><mrow><mfenced separators=\"|\"><mrow><msqrt><mn>2</mn></msqrt></mrow></mfenced><mfenced separators=\"|\"><mrow><msqrt><mn>5</mn></msqrt></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mn>1</mn><mo>+</mo><mn>2</mn></mrow><mrow><msqrt><mn>10</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>10</mn></msqrt></mrow></mfrac><mi mathvariant=\"normal\"></mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>tan</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>=</mo><mn>3</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>tan</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>&#8712;</mo><mfenced><mrow><msqrt><mn>3</mn></msqrt><mo>,</mo><mn>2</mn><mo>+</mo><msqrt><mn>3</mn></msqrt></mrow></mfenced></math></p><p>Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#952;</mi><mo>&#8712;</mo><mfenced><mrow><mn>60</mn><mo>&#176;</mo><mo>,</mo><mn>75</mn><mo>&#176;</mo></mrow></mfenced></math></p>"
