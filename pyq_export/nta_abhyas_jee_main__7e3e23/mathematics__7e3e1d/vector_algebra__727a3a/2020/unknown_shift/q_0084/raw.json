  "solution": {
    "text": "<math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>x</mi><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mi>y</mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br /><br /><math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>x</mi><mi>&#160;</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi>&#160;</mi><mi>x</mi><mo>=</mo><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#945;</mi></mrow></mrow></math><br /><br /><math><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>.</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mi>y</mi><mi>&#160;</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi>&#160;</mi><mi>y</mi><mo>=</mo><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#945;</mi></mrow></mrow></math><br /><br />Also, <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>=</mo><mn>1</mn></math><br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>c</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi> <mi>&#945;</mi> </mrow><mo>&#8289;</mo><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced><mo>+</mo><mover accent=\"true\"><mrow><mi>a</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>&#160;</mi></mrow></msup></mrow></mrow><mo>&#215;</mo><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mover><mi>c</mi><mo>&#8594;</mo></mover><mn>2</mn></msup><mo>=</mo><mn>4</mn><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>&#945;</mi><msup><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>cos</mi><mo>&#8289;</mo><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>+</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced><mo>.</mo><mfenced separators=\"|\"><mrow><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><br /><math><mn>4</mn><mo>=</mo><mn>8</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#945;</mi></mrow></mrow><mo>+</mo><mn>1</mn></math><br /><br /><math><mn>8</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>&#945;</mi></mrow></mrow><mo>=</mo><mn>3</mn></math>",
