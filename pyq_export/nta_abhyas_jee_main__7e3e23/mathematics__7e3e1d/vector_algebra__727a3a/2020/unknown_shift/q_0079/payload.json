  "solution": {
    "text": "Let position vector of <math><mi>A</mi><mo>,</mo><mi></mi><mi>B</mi><mo>,</mo><mi></mi><mi>D</mi></math> are <math><mover accent=\"true\"><mrow><mi>o</mi></mrow><mo>&#8594;</mo></mover><mo>,</mo><mi></mi><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>,</mo><mi></mi><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></math> respectively<br /><img src=\"assets\\st0079_48026c600ba9.png\" style=\"max-width:100%; object-fit:contain\" style=\"width:3.00694in;height:1.39375in\" /><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>A</mi><mi>B</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn></mrow></msub><mover accent=\"true\"><mrow><mi>A</mi><mi>B</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn></mrow></msub><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover></math><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>A</mi><mi>D</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msub><mover accent=\"true\"><mrow><mi>A</mi><mi>D</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msub><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></math><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>A</mi><mi>C</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msub><mover accent=\"true\"><mrow><mi>A</mi><mi>C</mi></mrow><mo>&#8594;</mo></mover><mo>=</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msub><mfenced separators=\"|\"><mrow><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></mrow></mfenced></math><br /><math><mo>&#8757;</mo><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi></mi><msub><mrow><mi>C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi></mi><msub><mrow><mi>D</mi></mrow><mrow><mn>1</mn></mrow></msub></math> are collinear<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mrow><msub><mi>B</mi><mn>1</mn></msub><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>&#8594;</mo></mover><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mi>&#955;</mi><mn>3</mn></msub><mo>-</mo><msub><mi>&#955;</mi><mn>1</mn></msub></mrow></mfenced><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>+</mo><msub><mi>&#955;</mi><mn>3</mn></msub><mover><mi>d</mi><mo>&#8594;</mo></mover></math><br /><math><mover accent=\"true\"><mrow><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>D</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mo>&#8594;</mo></mover><mo>=</mo><mo>-</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn></mrow></msub><mover accent=\"true\"><mrow><mi>b</mi></mrow><mo>&#8594;</mo></mover><mo>+</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msub><mover accent=\"true\"><mrow><mi>d</mi></mrow><mo>&#8594;</mo></mover></math><br /><math><mo>&#8658;</mo><mfrac><mrow><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>-</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mo>-</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow><mrow><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>&#8658;</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>3</mn></mrow></msub><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>&#955;</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mo>-</mo><msub><mrow><mi>&#955;</mi