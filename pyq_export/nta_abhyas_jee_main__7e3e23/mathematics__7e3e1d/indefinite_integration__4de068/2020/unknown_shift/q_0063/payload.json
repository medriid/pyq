  "solution": {
    "text": "Let,<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><msqrt><mi>x</mi></msqrt><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><msqrt><mi>x</mi></msqrt></mrow></mfenced><msqrt><mn>1</mn><mo>-</mo><mi>x</mi></msqrt></mrow></mfrac></math><br />Put,&nbsp;<math><mi>x</mi><mo>=</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>&#952;</mi></math>&nbsp;and&nbsp;<br /><math><mi>d</mi><mi>x</mi><mo>=</mo><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mi>d</mi><mi>&#952;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mn>2</mn><mi>sin</mi><mo>&#8289;</mo><mi>&#952;</mi><mi>cos</mi><mo>&#8289;</mo><mi>&#952;</mi><mi>d</mi><mi>&#952;</mi></mrow><mrow><mi>sin</mi><mo>&#8289;</mo><mi>&#952;</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>sin</mi><mo>&#8289;</mo><mi>&#952;</mi></mrow></mfenced><mi>cos</mi><mo>&#8289;</mo><mi>&#952;</mi></mrow></mfrac></math><br /><math><mo>=</mo><mn>2</mn><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>d</mi><mi>&#952;</mi></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mn>2</mn></mrow></mrow><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mn>1</mn><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow></mrow><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mn>2</mn></mrow></msup><mi></mi><mi>&#95