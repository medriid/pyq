  "solution": {
    "text": "<math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>,</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi>n</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mi>x</mi></mrow></mfenced></mrow><mrow><mi>n</mi></mrow></mfrac><mo>+</mo><mi>C</mi></math><br />As <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>,</mo><mn>0</mn></mrow></mfenced><mo>=</mo><mi>C</mi><mo>=</mo><mn>0</mn></math><br /><math><mo>⇒</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mo>,</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mi>n</mi><mi>x</mi></mrow></mfenced></math><br />Thus,&nbsp;<math><mrow><munderover><mo stretchy=\"false\">∑</mo><mrow><mi>x</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>89</mn></mrow></munderover><mrow><mi>f</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>1</mn></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow><mo>+</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mn>89</mn></mrow></mrow></mrow></mrow></math><br /><math><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mn>89</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mn>89</mn><mo>×</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfrac></math><br /><math><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mn>45</mn></mrow></mfenced><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>89</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfrac></math>"
