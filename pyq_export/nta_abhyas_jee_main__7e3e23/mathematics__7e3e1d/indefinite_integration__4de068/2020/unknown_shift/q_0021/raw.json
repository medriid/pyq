    "text": "Given integral is <math><mi>I</mi><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></msup><mo>&#8901;</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>&#8901;</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mfrac><mrow><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></msup></mrow><mrow><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow></mrow><mi>d</mi><mi>x</mi></math><br />Let,&nbsp;<math><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></msup><mo>=</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math> and <math><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfenced separators=\"|\"><mrow><msup><mi>f</mi><mo>'</mo></msup><mfenced><mi>x</mi></mfenced><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>+</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><msup><mi>g</mi><mo>'</mo></msup><mfenced><mi>x</mi></mfenced></mrow></mfenced><mi>d</mi><mi>x</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>&#183;</mo><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>+</mo><mi>c</mi></math><br /><math><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></msup><mo>&#8901;</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mi>c</mi></math>",
