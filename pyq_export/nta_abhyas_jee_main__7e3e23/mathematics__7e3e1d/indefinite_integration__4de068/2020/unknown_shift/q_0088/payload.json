  "solution": {
    "text": "Given integral <math><mo>=</mo><mrow><mo stretchy=\"false\">∫</mo><mrow><mfrac><mrow><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></mfenced></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn><mi>x</mi></mrow></msup></mrow></mfrac><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mi>d</mi><mi>x</mi></mrow></mrow></math><br />Let,&nbsp;<math><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></mfenced><mo>=</mo><mi>t</mi></math><br /><math><mo>⇒</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn><mi>x</mi></mrow></msup></mrow></mfrac><mo>⋅</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><math><mo>⇒</mo><mi mathvariant=\"normal\">Ι</mi><mo>=</mo><mrow><mo stretchy=\"false\">∫</mo><mrow><mi>t</mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>t</mi><mo>=</mo></mrow></mrow><mfrac><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mi>C</mi></math><br /><math><mo>=</mo><mfrac><mrow><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mfenced separators=\"|\"><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup></mrow></mfenced></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mi>C</mi></math>