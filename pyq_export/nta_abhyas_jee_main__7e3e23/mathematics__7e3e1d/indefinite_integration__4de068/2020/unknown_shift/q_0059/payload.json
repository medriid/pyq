  "solution": {
    "text": "The given integral <math><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mn>2</mn></mrow></msup><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><math><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>x</mi></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">e</mi><msup><mrow><mi mathvariant=\"normal\">c</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfenced><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msup><mi>e</mi><mi>x</mi></msup><mo>&#8901;</mo><mtext>tan</mtext><mfenced><mfrac><mi>x</mi><mn>2</mn></mfrac></mfenced><mo>+</mo><mi>C</mi><mo>&#160;</mo><mfenced open=\"{\" close=\"}\"><mrow><mo>&#8757;</mo><mo>&#160;</mo><mo>&#8747;</mo><msup><mi>e</mi><mi>x</mi></msup><mfenced><m