  "solution": {
    "text": "<p><math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi><mo>-</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mrow><mo>&#8901;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mi>d</mi><mi>x</mi></math><br /><math><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>-</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac></mrow></mfenced><mo>+</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mi>d</mi><mi>x</mi></mrow></mrow></mrow></mfenced></math><br /><math><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mi>c</mi><mo>=</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mi>c</mi></math><br />Now, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mi>e</mi></mfenced><mo>=</mo><mfrac><mn>1</mn><mi>e</mi></mfrac><mo>&#8658;</mo><mi>c</mi><mo>=</mo><mn>0</mn></math></p><p>Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi><mfenced separators=\"|\"><mn>2</mn></mfenced><mo>+</mo><mi>f</mi><mfenced separators=\"|\"><mn>4</mn></mfenced><mo>=</mo><mfrac><mrow><mi>ln</mi><mo>&#8289;</mo><mn>2</mn></mrow><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>ln</mi><mo>&#8289;</mo><mn>4</mn></mrow><mn>4</mn></mfrac><mo>=</mo><mi>ln</mi><mn>2</mn></math></p>"
