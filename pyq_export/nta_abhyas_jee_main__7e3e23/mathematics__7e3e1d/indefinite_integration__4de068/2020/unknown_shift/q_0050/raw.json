  "solution": {
    "text": "Let <math><mi>x</mi><mo>=</mo><msup><mrow><mi>u</mi></mrow><mrow><mn>6</mn></mrow></msup><mo>,</mo><mi mathvariant=\"normal\"></mi><mo> </mo><mi>d</mi><mi>x</mi><mo>=</mo><mn>6</mn><msup><mrow><mi>u</mi></mrow><mrow><mn>5</mn></mrow></msup><mi>d</mi><mi>u</mi></math><br /><math><mo>∫</mo><mfrac><mrow><mi>d</mi><mi>x</mi></mrow><mrow><msqrt><mi>x</mi></msqrt><mo>+</mo><mroot><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></mroot></mrow></mfrac><mo>=</mo><mo>∫</mo><mfrac><mrow><mn>6</mn><msup><mrow><mi>u</mi></mrow><mrow><mn>5</mn></mrow></msup><mi>d</mi><mi>u</mi></mrow><mrow><msup><mrow><mi>u</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>+</mo><msup><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mn>6</mn><mo>∫</mo><mfrac><mrow><msup><mrow><mi>u</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mi>u</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mi>d</mi><mi>u</mi></math><br /><math><mo>=</mo><mn>6</mn><mo>∫</mo><mfenced separators=\"|\"><mrow><msup><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mi>u</mi><mo>+</mo><mn>1</mn><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>u</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>u</mi></math><br /><math><mo>=</mo><mn>2</mn><msup><mrow><mi>u</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>-</mo><mn>3</mn><msup><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>6</mn><mi>u</mi><mo>-</mo><mn>6</mn><mi mathvariant=\"script\">ln</mi><mfenced separators=\"|\"><mrow><mi>u</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+e</mo></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2</mn><msqrt><mi>x</mi></msqrt><mo>-</mo><mn>3</mn><mfenced separators=\"|\"><mroot><mi>x</mi><mn>3</mn></mroot></mfenced><mo>+</mo><mn>6</mn><mfenced separators=\"|\"><mroot><mi>x</mi><mn>6</mn></mroot></mfenced><mo>-</mo><mn>6</mn><mi mathvariant=\"script\">ln</mi><mfenced separators=\"|\"><mrow><mroot><mi>x</mi><mn>6</mn></mroot><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+e</mo></math><br /><math><mo>∴</mo><mo> </mo><mi>a</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi></mi><mo> </mo><mi>b</mi><mo>=</mo><mo>-</mo><mn>3</mn><mo>,</mo><mi></mi><mo> </mo><mi>c</mi><mo>=</mo><mn>6</mn><mo>,</mo><mi></mi><mo> </mo><mi>d</mi><mo>=</mo><mo>-</mo><mn>6</mn></math><br /><math><mo>∴</mo><mo> </mo><mn>20</mn><mi>a</mi><mo>+</mo><mo> </mo><mi>b</mi><mo>+</mo><mo> </mo><mi>c</mi><mo>+</mo><mo> </mo><mi>d</mi><mo>=</mo><mn>37</mn></math>",
