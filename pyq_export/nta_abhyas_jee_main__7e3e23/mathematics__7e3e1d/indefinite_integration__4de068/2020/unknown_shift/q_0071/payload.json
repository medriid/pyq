    "C"
  ],
  "solution": {
    "text": "Let,&nbsp;<math><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>t</mi><mo>&#8658;</mo><mn>2</mn><mi>x</mi><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\"></mi><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><math><mo>&#8756;</mo><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><msup><mrow><mi>e</mi></mrow><mrow><mi>t</mi></mrow></msup><mo>&#8901;</mo><mfrac><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mi>d</mi><mi>t</mi></mrow></mrow></math><br />Using integration by parts, we get,<br /><math><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mi>t</mi><msup><mrow><mi>e</mi></mrow><mrow><mi>t</mi></mrow></msup><mo>-</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mn>1</mn><mo>&#8901;</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>t</mi></mrow></msup><mi>d</mi><mi>t</mi></mrow></mrow></mrow></mfenced></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mi>t</mi><msup><mrow><mi>e</mi></mrow><mrow><mi>t</mi></mrow></msup><mo>-</mo><msup><mrow><mi>e</mi></mrow><mrow><mi>t</mi></mrow></msup></mrow></mfenced><mo>+</mo><mi>c</mi></math><br /><math><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></msup><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>+</mo><mi>c</mi></math><br /><math><mo>&#8756;</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>&#8658;</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>"
