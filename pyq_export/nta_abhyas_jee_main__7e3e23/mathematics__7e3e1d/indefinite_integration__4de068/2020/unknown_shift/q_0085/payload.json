  "solution": {
    "text": "<p>Put,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>=</mo><mo>∫</mo><mfenced separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><msup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">m</mi></msup></mrow></mfenced><mfenced separators=\"|\"><mfrac><msup><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">m</mi></msup></mrow></mfenced><mrow><mn>1</mn><mo>/</mo><mi mathvariant=\"normal\">m</mi></mrow></msup><mi mathvariant=\"normal\">x</mi></mfrac></mfenced><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>∫</mo><mfenced separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>+</mo><msup><mi mathvariant=\"normal\">x</mi><mrow><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced><msup><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">&nbsp;</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">&nbsp;</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">m</mi></msup></mrow></mfenced><mrow><mn>1</mn><mo>/</mo><mi mathvariant=\"normal\">m</mi></mrow></msup><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>1</mn><mrow><mn>6</mn><mi mathvariant=\"normal\">m</mi></mrow></mfrac><mo>∫</mo><msup><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">m</mi></msup></mrow></mfenced><mrow><mn>1</mn><mo>/</mo><mi mathvariant=\"normal\">m</mi></mrow></msup><mfenced separators=\"|\"><mrow><mn>6</mn><msup><mi>mx</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn><mi mathvariant=\"normal\">&nbsp;</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi>mx</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn><mi mathvariant=\"normal\">&nbsp;</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi>mx</mi><mrow><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced><mi>dx</mi></math><br /><br />Now, let&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">m</mi></msup></mrow></mfenced><mo>=</mo><mi mathvariant=\"normal\">t</mi><mo>⇒</mo><mfenced separators=\"|\"><mrow><mn>6</mn><msup><mi>mx</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn><mi mathvariant=\"normal\">&nbsp;</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi>mx</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn><mi mathvariant=\"normal\">&nbsp;</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi>mx</mi><mrow><mi mathvariant=\"normal\">m</mi><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced><mi>dx</mi><mo>=</mo><mi>dt</mi></math>&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi mathvariant=\"normal\">I</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>6</mn><mi mathvariant=\"normal\">m</mi></mrow></mfrac><mo>∫</mo><msup><mi mathvariant=\"normal\">t</mi><mrow><mn>1</mn><mo>/</mo><mi mathvariant=\"normal\">m</mi></mrow></msup><mi>dt</mi><mo>&nbsp;</mo><mo>=</mo><mfrac><mn>1</mn><mrow><mn>6</mn><mi mathvariant=\"normal\">m</mi></mrow></mfrac><mfenced><mfrac><msup><mi mathvariant=\"normal\">t</mi><mrow><mfenced><mrow><mn>1</mn><mo>/</mo><mi mathvariant=\"normal\">m</mi></mrow></mfenced><mo>+</mo><mn>1</mn></mrow></msup><mrow><mfenced><mrow><mn>1</mn><mo>/</mo><mi mathvariant=\"normal\">m</mi></mrow></mfenced><mo>+</mo><mn>1</mn></mrow></mfrac></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>1</mn><mrow><mn>6</mn><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">m</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mfrac><msup><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>3</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi mathvariant=\"normal\">x</mi><mrow><mn>2</mn><mi mathvariant=\"normal\">m</mi></mrow></msup><mo>+</mo><mn>6</mn><msup><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">m</mi></msup></mrow></mfenced><mrow><mn>(1</mn><mo>/</mo><mi>m)</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>+</mo><mi mathvariant=\"normal\">C</mi></math></p>"
