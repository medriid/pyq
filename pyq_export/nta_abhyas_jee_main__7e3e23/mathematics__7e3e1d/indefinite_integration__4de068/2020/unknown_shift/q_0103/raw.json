    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><mo>&#8747;</mo><munder><munder><msup><mi>e</mi><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mi>x</mi></mfrac></mrow></msup><mo>&#9183;</mo></munder><mi mathvariant=\"normal\">&#921;</mi></munder><mo>&#8901;</mo><munder><munder><mn>1</mn><mo>&#9183;</mo></munder><mrow><mi mathvariant=\"normal\">&#921;</mi><mi mathvariant=\"normal\">&#921;</mi></mrow></munder><mi>d</mi><mi>x</mi><mo>+</mo><mo>&#8747;</mo><msup><mi>e</mi><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mi>x</mi></mfrac></mrow></mfenced></msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mrow></mfenced><mo>&#8901;</mo><mi>x</mi><mi>d</mi><mi>x</mi></math><br />Using integration by parts, we get,&nbsp;<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#921;</mi><mo>=</mo><msup><mi>e</mi><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mi>x</mi></mfrac></mrow></msup><mo>&#183;</mo><mi>x</mi><mo>-</mo><menclose notation=\"updiagonalstrike\"><mo>&#8747;</mo><msup><mi>e</mi><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mi>x</mi></mfrac></mrow></mfenced></msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mrow></mfenced><mo>&#8901;</mo><mi>x</mi><mi>d</mi><mi>x</mi></menclose><mo>+</mo><menclose notation=\"updiagonalstrike\"><mo>&#8747;</mo><msup><mi>e</mi><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mi>x</mi></mfrac></mrow></mfenced></msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mrow></mfenced><mo>&#8901;</mo><mi>x</mi><mi>d</mi><mi>x</mi></menclose></math><