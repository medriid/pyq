  "solution": {
    "text": "<math><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>x</mi><mo>-</mo><mn>4</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><msqrt><mi>x</mi><mo>-</mo><mn>2</mn></msqrt></mrow></mfrac><mi>d</mi><mi>x</mi></mrow></mrow></math><br /><math><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>4</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></mrow></mfenced></mrow><mrow><msqrt><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></msqrt></mrow></mfrac><mi>d</mi><mi>x</mi></mrow></mrow></math><br />Let <math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mi>t</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mfrac><mn>1</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8747;</mo><mfrac><mrow><mo>-</mo><mi>d</mi><mi>t</mi></mrow><msqrt><mi>t</mi></msqrt></mfrac><mo>=</mo><mo>-</mo><mn>2</mn><msqrt><mi>t</mi></msqrt><mo>+</mo><mi>C</mi></math><br /><math><mo>=</mo><mo>-</mo><mn>2</mn><msqrt><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></msqrt><mo>+</mo><mi>C</mi></math><br /><math><mo>=</mo><mo>-</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mi>x</mi></mrow></mfrac><msqrt><mi>x</mi><mo>-</mo><mn>2</mn></msqrt><mo>+</mo><mi>C</mi></math>"
