    "text": "Let <math><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>3</mn></mrow></msup><mo>=</mo><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><math><mo>&#8658;</mo><mn>3</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><mn>2</mn><mi>t</mi><mi>d</mi><mi>t</mi></math><br /><math><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfenced><mn>2</mn><mi>t&#160;</mi><mi>d</mi><mi>t</mi></mrow><mrow><mn>3</mn><mi>t</mi></mrow></mfrac></mrow></mrow></math><br /><math><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>1</mn></mrow></mfenced></mrow></mrow><mi>d</mi><mi>t</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mi>t</mi><mn>3</mn></msup></mrow><mn>9</mn></mfrac><mo>-</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><mi>t</mi><mo>+</mo><mi>C</mi></math><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>9</mn></mrow></mfrac><mi>t</mi><mfenced separators=\"|\"><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mn>3</mn></mrow></mfenced><mo>+</mo><mi>C</mi><mi mathvariant=\"normal\"></mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>2</mn><mn>9</mn></mfrac><msqrt><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup></msqrt><mfenced separators=\"|\"><mrow><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>2</mn></mrow></mfenced><mo>+</mo><mi>C</mi></math><br /><math><mo>&#8756;</mo><mi>K</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>9</mn></mrow></mfrac><mo>&#8658;</mo><mn>9</mn><mi>K</mi><mo>=</mo><mn>2</m