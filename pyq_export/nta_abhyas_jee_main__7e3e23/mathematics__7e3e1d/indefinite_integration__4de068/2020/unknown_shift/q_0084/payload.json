  "solution": {
    "text": "Let, <math><mi>I</mi><mo>=</mo><mi>&#160;</mi><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow></mfrac></mrow></mrow><mi>d</mi><mi>x</mi></math><br /><br />On dividing numerator and denominator by <math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>,</mo></math>&nbsp;and substituting&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>x</mi><mo>=</mo><mi>t</mi><mo>,</mo><mo>&#160;</mo><msup><mi>sec</mi><mn>2</mn></msup><mi>x</mi><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math>, we get,<br /><br /><math><mi>I</mi><mo>=</mo><mi>&#160;</mi><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow></mfenced></mrow></mfrac></mrow></mrow></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>t</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow></mfrac></mrow></mfenced><mi>d</mi><mi>t</mi></mrow></mrow></math> (using partial fraction)<br /><br /><math> <mrow> <mo>&#8658;</mo><mi>I</mi><mo>=</mo><mo>&#8722;</mo><mstyle displaystyle=\"true\"> <mrow><mo>&#8747;</mo> <mrow> <mfrac> <mn>1</mn> <mi>t</mi> </mfrac> <mi>d</mi><mi>t</mi> </mrow> </mrow> </mstyle><mo>+</mo><mstyle displaystyle=\"true\"> <mrow><mo>&#8747;</mo> <mrow> <msup> <mi>t</mi> <mrow> <mo>&#8722;</mo><mn>2</mn> </mrow> </msup> <mi>d</mi><mi>t</mi><mo>+</mo><mstyle displaystyle=\"true\"> <mrow><mo>&#8747;</mo> <mrow> <mfrac> <mn>1</mn> <mrow> <mn>1</mn><mo>+</mo><mi>t</mi> </mrow> </mfrac> <mi>d</mi><mi>t</mi> </mrow> </mrow> </mstyle> </mrow> </mrow> </mstyle> </mrow> </math><br /><br /><math><mo>=</mo><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>&#8289;</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>t</mi></mrow></mfenced></mrow></mrow><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>t</mi></mrow></mfrac><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>&#8289;</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow></mfenced><mo>+</mo><mi>C</mi></mrow></mrow></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>&#8289;</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>+</mo><mi>C</mi></math><br /><br /><math><mo>=</mo><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>&#8289;</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>+</mo><mi>C</mi></math>"
