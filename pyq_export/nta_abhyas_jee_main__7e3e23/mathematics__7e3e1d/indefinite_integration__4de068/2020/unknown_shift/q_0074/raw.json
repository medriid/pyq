  "solution": {
    "text": "Given integral is<br /><math><mi mathvariant=\"normal\">I</mi><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mn>2</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow></mrow></mrow><mi mathvariant=\"normal\"></mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mo>&#8289;</mo><mo>(</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">x</mi><mo>)</mo><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi></mrow></mrow></mrow></mrow></math><br />Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">x</mi><mo>=</mo><mi mathvariant=\"normal\">t</mi></math><br /><math><mo>&#8658;</mo><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">x</mi><mo>=</mo><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">t</mi></math><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">I</mi><mo>=</mo><mo>-</mo><mn>2</mn><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mi mathvariant=\"normal\">t</mi></mrow></mrow><mi mathvariant=\"normal\"></mi><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">t</mi></mrow></mrow><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">t</mi></math><br />Using Integration by parts<br /><math><mi mathvariant=\"normal\">I</mi><mo>=</mo><mo>-</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">t</mi><mo>-</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">t</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mfrac><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">t</mi></mrow></mfrac><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">t</mi></mrow></mrow></mrow></mrow></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>=</mo><mo>-</mo><msup><mi mathvariant=\"normal\">t</mi><mn>2</mn></msup><mi>ln</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">t</mi><mo>+</mo><mfrac><msup><mi mathvariant=\"normal\">t</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>+</mo><mi mathvariant=\"normal\">C</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>=</mo><msup><mi>cos</mi><mn>2</mn></msup><mo>&#8289;</mo><mi mathvariant=\"normal\">x</mi><mfenced separators=\"|\"><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>-</mo><mi>ln</mi><mo>&#8289;</mo><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">x</mi></mrow></mfenced><mo>+</mo><mi mathvariant=\"normal\">C</mi></math><br /><math><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\"></mi></mrow></mrow></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\"></mi><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow></mrow></mfenced></mrow></mrow></math><br /><math><mi mathvariant=\"normal\">f</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mrow></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">ln</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\"></mi><mn>2</mn></mrow></mrow></math><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">a</mi><mo>=</mo><mi mathvariant=\"normal\">b</mi><mo>=</mo><mn>2</mn></math><br /><math><mo>&#8756;</mo><mi mathvariant=\"normal\">a</mi><mo>+</mo><mi mathvariant=\"normal\">b</mi><mo>=</mo><mn>4</mn></math>",
