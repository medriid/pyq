    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><msup><mi>sec</mi><mn>2</mn></msup><mo>&#8289;</mo><mi>x</mi></mrow><msup><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>tan</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfenced><mn>2</mn></msup></mfrac><mi>d</mi><mi>x</mi></math><br />Let <math><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>=</mo><mi>t</mi></math><br /><math><mo>&#8658;</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sec</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br /><math><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>t</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mrow><mo>=</mo><mrow><mo stretchy=\"false\">&#8747;</mo><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi>t</mi></mrow></mfenced></mrow><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow></mrow><mi>d</mi><mi>t</mi></math><br /><math><mo>&#8658;</mo><mi>I</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn><mo>-</mo><mi>t</mi></mrow></mfrac><mo>+</mo><mi>C</mi></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1</mn><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfrac><mo>+</mo><mi>C</mi></math><br /><math><mo>&#8756;</mo><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mn>1</mn><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></math><br />If <math><mi>f</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mn>2020</mn><mo>&#8658;</mo><mn>1</mn>