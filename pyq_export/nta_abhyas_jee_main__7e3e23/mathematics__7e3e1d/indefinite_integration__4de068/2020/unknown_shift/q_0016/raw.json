    "text": "<p><math><mn>3</mn><mi>J</mi><mo>-</mo><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi><mo>-</mo><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi>x</mi></mrow><mrow><mn>3</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi>x</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfrac><mi>d</mi><mi>x</mi></math><br />Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi>x</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>x</mi><mo>+</mo><mn>2</mn><mo>=</mo><mi>t</mi></math><br /><math><mo>&#8658;</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mrow></mrow></mfenced><mi>d</mi><mi>x</mi><mo>=</mo><mi>d</mi><mi>t</mi></math><br />So,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>J</mi><mo>-</mo><mi>I</mi><mo>=</mo><mo>&#8747;</mo><mfrac><mrow><mi>d</mi><mi>t</mi></mrow><mi>t</mi></mfrac><mo>=</mo><mi>ln</mi><mo>&#8289;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mi>t</mi></mfenced><mo>+</mo><mi>C</mi></math></p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"/>Hence,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>J</mi><mo>-</mo><mi>I</mi><mo>=</mo><mi>ln</mi><mo>&#8289;</mo><mfenced open=\"|\" close=\"|\" separators=\"|\"><mrow><mn>3</mn><mi>sin</mi><mo>&#8289;</mo><mi>x</mi><mo>+</mo><mi>cos</mi><mo>