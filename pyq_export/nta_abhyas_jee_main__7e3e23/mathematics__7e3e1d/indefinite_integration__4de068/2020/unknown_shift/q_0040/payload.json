mi><mi mathvariant=\"normal\">I</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mi mathvariant=\"normal\"> </mi><mrow><mo stretchy=\"false\">∫</mo><mrow><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">t</mi></mrow><mrow><msqrt><mn>1</mn><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">t</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt></mrow></mfrac></mrow></mrow><mo>=</mo><msqrt><mn>2</mn></msqrt><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">t</mi></mrow></mfenced></mrow></mrow><mo>+</mo><mi mathvariant=\"normal\">C</mi></math> <br/><br/> <math><mo>=</mo><msqrt><mn>2</mn></msqrt><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow></mrow></mfenced></mrow></mrow><mo>+</mo><mi mathvariant=\"normal\">C</mi></math>"
