      "id": "UcqO8",
      "text": "<math><mi>x</mi><mo>=</mo><mn>2</mn><mo>,</mo><mi> </mi><mi>y</mi><mo>=</mo><mn>4</mn><mo>,</mo><mi> </mi><mi>z</mi><mo>=</mo><mn>6</mn></math>",
