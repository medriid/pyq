  "solution": {
    "text": "Let,&nbsp;<math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mn>1</mn></mrow></mfenced><mo>=</mo><mi>α</mi><mo>∈</mo><mi>I</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></mfenced><mo>-</mo><mn>1</mn><mo>=</mo><mi>α</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∴</mo><mi>y</mi><mo>=</mo><mn>2</mn><msup><mi>sin</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mfenced separators=\"|\"><mrow><mi>α</mi><mo>+</mo><mn>1</mn></mrow></mfenced><mo>+</mo><msup><mi>cos</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mi>α</mi><mo>,</mo><mo>&nbsp;</mo><mi>α</mi><mo>=</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mo>-</mo><mn>1,0</mn></mrow></mfenced></math><br />At <math><mi>α</mi><mo>=</mo><mo>-</mo><mn>1</mn></math><br /><math><mi>y</mi><mo>=</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mn>0</mn></mrow></mfenced></mrow></mrow><mo>+</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn></mrow></mfenced></mrow></mrow><mo>=</mo><mi>π</mi></math><br />At <math><mi>α</mi><mo>=</mo><mn>0</mn></math><br /><math><mi>y</mi><mo>=</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow>