      "is_correct": false
    },
    {
      "text": "<math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mn>1</mn><mo>,</mo><mi>&nbsp;</mi><mn>3</mn></mrow></mfenced></math>",
