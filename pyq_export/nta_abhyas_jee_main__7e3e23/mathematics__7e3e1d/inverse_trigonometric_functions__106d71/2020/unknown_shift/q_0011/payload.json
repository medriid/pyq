  "solution": {
    "text": "<p><math><mo>&#8756;</mo></math> Let <math><mi>y</mi><mo>=</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>+</mo><mn>2</mn><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced></mrow></mrow></math><br />Putting&nbsp;<math><mi>x</mi><mo>=</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi mathvariant=\"normal\">&#952;</mi></mrow></mrow></math>&nbsp;</p><p>As,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mn>0,1</mn></mfenced><mo>,</mo><mo>&#160;</mo><mi mathvariant=\"normal\">&#952;</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mfrac><mi>&#960;</mi><mn>4</mn></mfrac></mrow></mfenced></math> and <math><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mfrac><mrow><mi mathvariant=\"normal\">&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>y</mi><mo>=</mo><mn>2</mn><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>cot</mi><mo>&#8289;</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced><mo>+</mo><mn>2</mn><msup><mi>cos</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>cos</mi><mo>&#8289;</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2</mn><msup><mi>tan</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>tan</mi><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>-</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced></mrow></mfenced><mo>+</mo><mn>2</mn><msup><mi>cos</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>&#8289;</mo><mfenced separators=\"|\"><mrow><mi>cos</mi><mo>&#8289;</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced><mspace linebreak=\"newline\"/><mo>=</mo><mn>2</mn><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><mfrac><mi>&#960;</mi><mn>2</mn></mfrac><mo>-</mo><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced><mo>+</mo><mn>4</mn><mi mathvariant=\"normal\">&#952;</mi><mo>=</mo><mi>&#960;</mi></math></p>"
