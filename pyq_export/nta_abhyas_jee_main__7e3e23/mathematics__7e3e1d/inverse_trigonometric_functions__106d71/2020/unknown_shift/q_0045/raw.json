    "text": "Since,&nbsp;<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">x</mi></mrow></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math> for <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"normal\">x</mi></mrow></mfenced><mo>≤</mo><mn>1</mn><mo>.</mo></math><br /><math><mo>∴</mo><mi mathvariant=\"normal\">x</mi><mo>-</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>4</mn></mrow></mfrac><mo>-</mo><mo>…</mo><mo>=</mo><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>6</mn></mrow></msup></mrow><mrow><mn>4</mn></mrow></mfrac><mo>-</mo><mo>…</mo></math><br /><math><mo>⇒</mo><mfrac><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>0</mn><mo>&lt;</mo><mfenced close=\"|\" open=\"|\" separators=\"|