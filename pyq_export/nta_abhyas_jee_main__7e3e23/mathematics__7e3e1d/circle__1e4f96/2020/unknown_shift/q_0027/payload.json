  "question": {
    "text": "The equation of the circle which passes through the points <math><mi>A</mi><mfenced separators=\"|\"><mrow><mn>0,5</mn></mrow></mfenced></math> and <math><mi>B</mi><mfenced separators=\"|\"><mrow><mn>6,1</mn></mrow></mfenced></math>&nbsp; and whose centre lies on the line <math><mn>12</mn><mi>x</mi><mo>+</mo><mn>5</mn><mi>y</mi><mo>=</mo><mn>25</mn></math> is"
  },
  "options": [
    {
      "text": "<math><mn>3</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>3</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>6</mn><mi>y</mi><mo>+</mo><mn>15</mn><mo>=</mo><mn>0</mn></math>",
