      "is_correct": true
    },
    {
      "text": "<math><mi>y</mi><mo>-</mo><mn>2</mn><mo>=</mo><msqrt><mn>3</mn></msqrt><mi> </mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced></math>",
      "is_correct": false
    },
