  "question": {
    "text": "The coordinates of a point <math><mi>P</mi></math> on the line <math><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mn>13</mn><mo>=</mo><mn>0</mn><mo>,</mo></math> nearest to the circle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>6</mn><mi>y</mi><mo>-</mo><mn>5</mn><mo>=</mo><mn>0</mn><mo>,</mo></math>&nbsp;are"
  },
  "options": [
    {
