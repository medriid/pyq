  "question": {
    "text": "The extremities of a diagonal of a rectangle are <math><mfenced separators=\"|\"><mrow><mn>0,0</mn></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><mn>4,3</mn></mrow></mfenced><mo>.</mo></math> The equations of the tangents to the circumcircle of the rectangle which are parallel to the diagonal are",
    "image": null
  },
  "options": [
    {
      "id": "siHeE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi><mo>-</mo><mn>4</mn><mi>y</mi><mo>=</mo><mo>&#177;</mo><mn>5</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "emMJS",
      "text": "<math><mn>3</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>=</mo><mo>±</mo><mn>10</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Rctpw",
      "text": "<math><mn>3</mn><mi>x</mi><mo>+</mo><mn>4</mn><mi>y</mi><mo>=</mo><mo>±</mo><mn>25</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "g7gVZ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mi>x</mi><mo>-</mo><mn>8</mn><mi>y</mi><mo>=</mo><mo>&#177;</mo><mn>25</mn></math>",
