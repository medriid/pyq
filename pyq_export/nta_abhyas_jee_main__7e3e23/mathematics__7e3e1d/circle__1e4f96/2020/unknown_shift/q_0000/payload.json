    {
      "text": "<math> <mrow>  <msup>   <mi>x</mi>   <mn>2</mn>  </msup>  <mo>+</mo><msup>   <mi>y</mi>   <mn>2</mn>  </msup>  <mo>&#x2212;</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>2</mn><mo>=</mo><mn>0</mn></mrow></math>",
