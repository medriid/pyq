  "question": {
    "text": "The rate of change of <math><msqrt><mo>(</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>16</mn><mo>)</mo></msqrt></math> with respect to <math><mfrac><mrow><mi>x</mi></mrow><mrow><mi>x</mi><mo>-</mo><mn>1</mn></mrow></mfrac></math> at <math><mi>x</mi><mo>=</mo><mn>3</mn></math> is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>11</mn></mrow><mrow><mn>5</mn></mrow></mfrac></math>",
