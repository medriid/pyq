    "text": "<p><math><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mi>&#160;</mi><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><mi>x</mi><mo>-</mo><mn>2</mn><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#62;</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>2</mn><mo>-</mo><mi>x</mi><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#60;</mo><mn>2</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><br /><math><mi>h</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>-</mo><mn>2</mn><mo>,</mo></mtd><mtd><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>&#62;</mo><mn>2</mn></mtd></mtr><mtr><mtd><mn>2</mn><mo>-</mo><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>,</mo></mtd><mtd><mi>g</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>&#60;</mo><mn>2</mn></mtd></mtr></mtable></mrow></mfenced></math><br /><br /><math><mi>h</mi><mfenced separators=\"|\"><mrow><mi>x</mi></mrow></mfenced><mo>=</mo><mfenced close=\"\" open=\"{\" separators=\"|\"><mrow><mtable><mtr><mtd><mi>x</mi><mo>-</mo><mn>4</mn><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#8805;</mo><mn>4</mn></mtd></mtr><mtr><mtd><mo>-</mo><mi>x</mi><mo>,</mo></mtd><mtd><mi>x</mi><mo>&#8804;</mo><mn>0</mn></mtd></mtr><mtr><mtd><mtable><mtr><mtd><mn>4</mn><mo>-</mo><mi>x</mi><mo>,</mo></mtd></mtr><mtr><mtd><mi>x</mi><mo>,</mo></mtd></mtr></mtable></mtd><mtd><mtable><mtr><mtd><mi>x</mi><mo>&#8712;</mo><mfenced open=\"[\" separators=\"|\"><mrow><mn>2,4</mn></mrow></mfenced></mtd></mtr><mtr><mtd><mi>x</mi><mo>&#8712;</mo><mfenced separators=\"|\"><mrow><mn>0,2</mn></mrow></mfenced></mtd></mtr></mtable></mtd></mtr></mtable></mrow></mfenced></math></p><p>Then,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>h</mi><mo>'</mo></msup><mfenced separators=\"|\"><mrow