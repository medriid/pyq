  ],
  "solution": {
    "text": "Since, <math><msup><mrow><mi>x</mi></mrow><mrow><mi>y</mi></mrow></msup><mo>.</mo><msup><mrow><mi>y</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>=</mo><mn>16</mn></math><br/><br/><math><mo>∴</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><msup><mrow><mi>x</mi></mrow><mrow><mi>y</mi></mrow></msup><mo>+</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><msup><mrow><mi>y</mi></mrow><mrow><mi>x</mi></mrow></msup><mo>=</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>16</mn></mrow></mrow></mrow></mrow></mrow></mrow></math><br/><br/><math><mo>⇒</mo><mi>y</mi><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi><mo>+</mo><mi>x</mi><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>y</mi><mo>=</mo><mn>4</mn><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn></mrow></mrow></mrow></mrow></mrow></mrow></math><br/><br/>Now, on differentiating both sides w.r.t. <math><mi>x</mi><mo>,</mo></math> we get<br/><br/><math><mfrac><mrow><mi>y</mi></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mi>y</mi></mrow></mfrac><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>y</mi><mo>.</mo><mn>1</mn><mo>=</mo><mn>0</mn></mrow></mrow></math><br/><br/><math><mo>⇒</mo><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>y</mi><mo>+</mo></mrow></mrow><mfrac><mrow><mi>y</mi></mrow><mrow><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow><mo>+</mo><mfrac><mrow><mi>x</mi></mrow><mrow><mi>y</mi></mrow></mfrac></mrow></mfenced></mrow></mfrac></math><br/><br/><math><mo>∴</mo><msub><mrow><mfenced close=\"|\" open=\"\" separators=\"|\"><mrow><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mo>(</mo><mn>2,2</mn><mo>)</mo></mrow></msub><mo>=</mo><mo>-</mo><mfrac><mrow><mo>(</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn><mo>+</mo><mn>1</mn><mo>)</mo></mrow></mrow></mrow><mrow><mo>(</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>2</mn><mo>+</mo><mn>1</mn><mo>)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mo>-</mo><mn>1</mn></math>"
