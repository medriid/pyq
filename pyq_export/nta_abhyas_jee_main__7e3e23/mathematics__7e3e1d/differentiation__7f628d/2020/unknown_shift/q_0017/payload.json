  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mfrac><mrow><mi>sin</mi><mo>&#8289;</mo><mn>16</mn><mi>x</mi></mrow><mrow><mn>16</mn><mi>sin</mi><mo>&#8289;</mo><mi>x</mi></mrow></mfrac></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;</mo><mfenced><mrow><mo>&#8757;</mo><mo>&#160;</mo><mi>cos</mi><mo>&#8289;</mo><mi>A</mi><mi>cos</mi><mo>&#8289;</mo><mn>2</mn><mi>A</mi><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mo>.</mo><mi>cos</mi><mo>&#8289;</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>-</mo><mn>1</mn></mrow></msup><mi>A</mi><mo>=</mo><mfrac><mrow><mi>sin</mi><mfenced separators=\"|\"><mrow><msup><mn>2</mn><mi>n</mi></msup><mi>A</mi></mrow></mfenced></mrow><mrow><msup><mn>2</mn><mi>n</mi></msup><mi>sin</mi><mo>&#8289;</mo><mi>A</mi></mrow></mfrac></mrow></mfenced></math><br />So,&nbsp;<math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>16</mn></mrow></mfrac><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow><mo>&#8901;</mo><mn>16</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mn>16</mn><mi>x</mi></mrow></mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>16</mn><mi>x</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br />Putting&nbsp;<math><mi>x</mi><mo>=</mo><mfrac><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>, we get,&nbsp;<br /><math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>16</mn></mrow></mfrac><mo>&#8901;</mo><mfenced close=\"}\" open=\"{\" separators=\"|\"><mrow><mfrac><mrow><mn>1.16</mn><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced><mo>-</mo><mn>0</mn></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced><mo>=</mo><mn>1</mn></math>"
  }
