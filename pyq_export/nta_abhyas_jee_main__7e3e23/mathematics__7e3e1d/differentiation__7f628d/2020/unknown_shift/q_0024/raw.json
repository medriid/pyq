  "correctValue": "13.5",
  "solution": {
    "text": "<p><math><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msqrt><mi>x</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>x</mi></msqrt></mrow></mfrac><mfrac><mrow><mi>d</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>x</mi></mrow></mfenced></math><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msqrt><mi>x</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>x</mi></msqrt></mrow></mfrac><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mi>x</mi><mo>&#215;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi></mrow></mfrac><mo>+</mo><mn>1</mn><mo>&#215;</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mi>e</mi></mrow></msub><mi>x</mi></mrow></mfenced></math><br /><math><mo>&#8658;</mo><msub><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mi>d</mi><mi>y</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mi>x</mi><mo>=</mo><msup><mrow><mi>e</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msqrt><msup><mrow><mi>e</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>&#215;</mo><mn>4</mn></msqrt></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>4</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>4</mn><msup><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mfenced separators=\"|