  "solution": {
    "text": "Let,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi><mo>=</mo><msub><mi>log</mi><mn>10</mn></msub><mo>⁡</mo><mi>x</mi></math> and <math><mi>v</mi><mo>=</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>x</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>10</mn></mrow></mrow></math><br /><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>u</mi><mo>=</mo><mfrac><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>1</mn></mrow></mrow><mn>0</mn></mrow></mfrac></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><mfrac><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>⁡</mo><mn>1</mn><mn>0</mn></mrow><mrow><msub><mi>log</mi><mi>e</mi></msub><mo>⁡</mo><mi>x</mi></mrow></mfrac></math><br /><br />Now, <math><mfrac><mrow><mi>d</mi><mi>u</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>1</mn></mrow></mrow><mn>0</mn></mrow></mfrac></math><br /><br />and <math><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>d</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>10</mn></mrow></mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mo>-</mo><mn>1</mn></mrow><mrow><mi>x</mi><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></mrow></mfenced></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><mi>d</mi><mi>u</mi></mrow><mrow><mi>d</mi><mi>v</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mrow><mi>d</mi><mi>u</mi></mrow><mo>/</mo><mrow><mi>d</mi><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><mi>d</mi><mi>v</mi></mrow><mo>/</mo><mrow><mi>d</mi><mi>x</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>10</mn></mrow></mrow></mrow></mfrac><mo>÷</mo><mfrac><mrow><mo>-</mo><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>1</mn></mrow></mrow><mn>0</mn></mrow><mrow><mi>x</mi><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>10</mn></mrow></mrow></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mo>-</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mi>x</mi></mrow></mrow></mrow><mrow><mrow><mrow><msub><mrow><mi mathvariant=\"normal\">log</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow><mo>⁡</mo><mrow><mn>10</mn></mrow></mrow></mrow></mfrac></mrow></mfenced><