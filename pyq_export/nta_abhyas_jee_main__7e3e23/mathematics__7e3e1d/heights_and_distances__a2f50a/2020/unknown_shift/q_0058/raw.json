  "question": {
    "text": "Each side of a square subtends an angle of <math><msup><mrow><mn>60</mn></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msup></math> at the top of a tower <math><mn>5</mn></math> meters high standing in the center of the square. If <math><mi>a</mi></math>&nbsp;meters is the length of each side of the square, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> is equal to",
    "image": null
  },
  "options": [
    {
      "id": "phPKi",
      "text": "<math><mn>3</mn><msqrt><mn>2</mn></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "crJDs",
