  "question": {
    "text": "Two vertical poles of height <math><mn>10&#160;</mn><mi></mi><mi>m</mi></math> and&nbsp;<math><mn>40&#160;</mn><mi></mi><mi>m</mi></math> stand apart on a horizontal plane. The height (in meters) of the point of intersection of the lines joining the top of each pole to the foot of the other, from this horizontal plane is"
  },
  "options": [
    {
      "text": "<math><mn>8</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>10</mn></math>",
