    },
    {
      "text": "<math><mn>6</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>4</mn></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mfenced separators=\"|\"><mn>0,0</mn></mfenced><mo>,</mo><mo>&#160;</mo><mi>D</mi><mfenced separators=\"|\"><mn>0,10</mn></mfenced><mo>,</mo></math>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mfenced separators=\"|\"><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mn>0</mn></mrow></mfenced><mo>,</mo><mo>&#160;</mo><mi>C</mi><mfenced separators=\"|\"><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,40</mo></mrow></mfenced></math><br /><img src=\"assets\\st0024_0f5c01de6988.png\" style=\"width:2.07361in;height:1.15347in\" /><br />Equation of <math><mi>A</mi><mi>C</mi><mo>&#8658;</mo><mi>y</mi><mo>=</mo><mfrac><mrow><mn>40</mn></mrow><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi>x</mi></math> &hellip; <math><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math><br />Equation <math><mi>B</mi><mi>D</mi><mo>&#8658;</mo><mi>y</mi><mo>-</mo><mn>10</mn><mo>=</mo><mfrac><mrow><mo>-</mo><mn>10</mn></mrow><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi>x</mi></math> &hellip; <math><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></math><br />From <math><mfenced separators=\"|\"><mrow><mn>1</mn></mrow></mfenced></math>&nbsp;and&nbsp;<math><mfenced separators=\"|\"><mrow><mn>2</mn></mrow></mfenced></math>, we get,&nbsp;<br /><math><mfrac><mrow><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>&#8901;</mo><mi>y</mi></mrow><mrow><mn>40</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>-</mo><mfenced separators=\"|\"><mrow><mi>y</mi><mo>-</mo><mn>10</mn></mrow></mfenced><mo>&#8901;</mo><msub><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mn>10</mn></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mo>-</mo><mn>4</mn><mi>y</mi><mo>+</mo><mn>40</mn><mo>&#8658;</mo><mi>y</mi><mo>=</mo><mn>8</mn></math>"
  }
