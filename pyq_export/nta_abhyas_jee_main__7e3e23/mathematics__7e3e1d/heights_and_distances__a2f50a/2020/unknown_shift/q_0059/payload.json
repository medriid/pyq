      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">tan&nbsp;</mi></mrow><mo>⁡</mo><mrow><mi>&alpha;</mi></mrow></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi>n</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>2</mn><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn></mrow></mfenced><mrow><mrow><mi mathvariant=\"normal\">tan&nbsp;</mi></mrow><mo>⁡</mo><mrow><mi>α</mi></mrow></mrow></math>",
