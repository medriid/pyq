    {
      "text": "<math><mn>150</mn><mfenced separators=\"|\"><mrow><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>1</mn></mrow></mfenced><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">t</mi></math>",
