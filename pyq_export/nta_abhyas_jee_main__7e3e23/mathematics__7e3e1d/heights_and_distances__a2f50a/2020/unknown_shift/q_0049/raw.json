  "question": {
    "text": "The length of the shadows of a vertical pole of height <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math>, thrown by the sun's rays at three different moments are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>,</mo><mo>&nbsp;</mo><mn>2</mn><mi>h</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>h</mi></math>. The sum of the angles of elevation of the rays at these three moments is equal to",
    "image": null
  },
  "options": [
    {
      "id": "xoI8J",
      "text": "<math><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
