  "question": {
    "text": "Consider a cubical hall <math><mi>A</mi><mi>B</mi><mi>C</mi><mi>D</mi><mi>P</mi><mi>Q</mi><mi>R</mi><mi>S</mi></math> with each side <math><mn>20&nbsp;</mn><mi></mi><mi mathvariant=\"normal\">m</mi></math> and base as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mi>C</mi><mi>D</mi><mo>.</mo></math>&nbsp;If&nbsp;<math><mi>G</mi></math> is the center of the wall <math><mi>B</mi><mi>C</mi><mi>R</mi><mi>Q</mi></math> and <math><mi>T</mi></math> is the midpoint of the side <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>,</mo></math>&nbsp;then the angle of elevation of <math><mi>G</mi></math> at the point <math><mi>T</mi></math> is"
  },
  "options": [
    {
      "text": "<math><msup><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><mo>⁡</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></mrow></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></mrow></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></mrow></mrow></math>",
