  "solution": {
    "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/bc9087e1-d2ce-407a-94fc-741d9b7388f0.png\" style=\"max-width:100%; object-fit:contain\" style=\"width:2.68056in;height:1.44653in\" /><br />Given <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mi>x</mi><mo>,</mo><mo>&#160;</mo><mi>C</mi><mi>D</mi><mo>=</mo><mn>40</mn></math>&nbsp;and&nbsp;<math> <mrow> <mo>&#8736;</mo><mi>D</mi><mi>B</mi><mi>E</mi><mo>=</mo><msup> <mrow> <mn>30</mn></mrow> <mtext>o</mtext> </msup> </mrow> </math><br />In <math><mo>&#8710;</mo><mi>B</mi><mi>D</mi><mi>E</mi></math>,<br /><math> <mrow> <mfrac> <mrow> <mi>D</mi><mi>E</mi></mrow> <mrow> <mi>B</mi><mi>E</mi></mrow> </mfrac> <mo>=</mo><mi>tan</mi><msup> <mrow> <mn>30</mn></mrow> <mtext>o</mtext> </msup> </mrow> </math><br /><math> <mrow> <mi>D</mi><mi>E</mi><mo>=</mo><mi>B</mi><mi>E</mi><mi>tan</mi><msup> <mrow> <mn>30</mn></mrow> <mtext>o</mtext> </msup> </mrow> </math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"|\" close=\"|\"><mrow><mn>40</mn><mo>&#8722;</mo><mi>x</mi></mrow></mfenced><mo>=</mo><mn>30</mn><msqrt><mn>3</mn></msqrt><mo>&#8901;</mo><mfrac><mn>1</mn><msqrt><mn>3</mn></msqrt></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>x</mi><mo>=</mo><mn>10</mn></math> or <math><mn>70</mn></math></p>",
