  "question": {
    "text": "A line with gradient <math><mn>2</mn></math> intersects a line with gradient <math><mn>6</mn></math> at the point <math><mfenced separators=\"|\"><mrow><mn>40,30</mn></mrow></mfenced><mo>.</mo></math> The distance between <math><mi>y</mi></math>-intercepts of these lines is"
  },
  "options": [
    {
      "text": "<math><mn>160</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mn>180</mn></math>",
