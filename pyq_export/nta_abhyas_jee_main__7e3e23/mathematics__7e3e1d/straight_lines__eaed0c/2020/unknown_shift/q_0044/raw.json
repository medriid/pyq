  "question": {
    "text": "The number of distinct possible lines passing through the point <math><mfenced separators=\"|\"><mrow><mn>2</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mn>3</mn></mrow></mfenced></math> and forming a triangle with the coordinate axes whose area is <math><mn>12</mn><mi mathvariant=\"normal\"></mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">q</mi><mo>.</mo></math> units, is/are",
    "image": null
  },
  "options": [
    {
      "id": "q6Lsj",
      "text": "<math><mn>1</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6XUKV",
      "text": "<math><mn>2</mn></math>",
