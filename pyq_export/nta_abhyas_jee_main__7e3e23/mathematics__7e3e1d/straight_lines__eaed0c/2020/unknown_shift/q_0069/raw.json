    },
    {
      "id": "jqGkx",
      "text": "<math><mn>5</mn><mi>x</mi><mi>y</mi><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>+</mo><mi>y</mi></mrow></mfenced></math>",
