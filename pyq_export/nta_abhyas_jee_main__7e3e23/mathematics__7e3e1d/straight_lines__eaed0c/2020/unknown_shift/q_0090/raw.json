    },
    {
      "id": "uRETs",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "kAgoE",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn><msqrt><mn>5</mn></msqrt></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sX3rp",
      "text": "<math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msqrt><mn>15</mn></msqrt></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    }
