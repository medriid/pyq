    },
    {
      "text": "<math><mi>x</mi><mo>+</mo><mn>2</mn><mi>y</mi><mo>-</mo><mn>12</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>2</mn><mi>x</mi><mo>+</mo><mi>y</mi><mo>-</mo><mn>12</mn><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
