  "question": {
    "text": "The maximum negative integral value of <math><mi>b</mi></math> for which the point <math><mfenced separators=\"|\"><mrow><mn>2</mn><mi>b</mi><mo>+</mo><mn>3</mn><mo>,</mo><mi></mi><msup><mrow><mi>b</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfenced></math> lies above the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>x</mi><mo>-</mo><mn>4</mn><mi>y</mi><mo>-</mo><mi>a</mi><mfenced separators=\"|\"><mrow><mi>a</mi><mo>-</mo><mn>2</mn></mrow></mfenced><mo>=</mo><mn>0</mn><mo>,</mo><mo>&#160;</mo><mo>&#8704;</mo><mi>a</mi><mo>&#8712;</mo><mi>R</mi></math>&nbsp;is",
    "image": null
  },
  "options": [
    {
      "id": "j0xjR",
      "text": "<math><mo>-</mo><mn>1</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GXvcs",
      "text": "<math><mo>-</mo><mn>3</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0dzfj",
      "text": "<math><mo>-</mo><mn>2</mn></math>",
      "image": null,
      "isCorrect": true
    },
