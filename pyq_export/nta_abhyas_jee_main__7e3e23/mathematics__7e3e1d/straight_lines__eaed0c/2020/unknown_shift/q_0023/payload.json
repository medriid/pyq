    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": true
