  "question": {
    "text": "The orthocentre of the triangle whose vertices are <math><mfenced separators=\"|\"><mrow><mn>1,1</mn></mrow></mfenced><mo>,</mo><mi></mi><mfenced separators=\"|\"><mrow><mn>5,1</mn></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><mn>4,5</mn></mrow></mfenced></math> is",
    "image": null
  },
  "options": [
    {
      "id": "H1GFW",
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>9</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>,</mo><mi></mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></mfrac></mrow></mfenced></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "woRXK",
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4,13</mn></mrow></mfenced></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BPbjs",
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mfrac><mrow><mn>9</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GXmTT",
      "text": "<math><mfenced separators=\"|\"><mrow><mn>4</mn><mo>,</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></math>",
      "image": null,
      "isCorrect": true
