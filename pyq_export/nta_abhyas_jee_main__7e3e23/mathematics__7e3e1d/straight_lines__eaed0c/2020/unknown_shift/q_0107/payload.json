  "question": {
    "text": "The coordinates of the orthocenter of the triangle that has the coordinates of midpoints of its sides as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mn>0,0</mn></mfenced><mo>,</mo><mo>&nbsp;</mo><mfenced separators=\"|\"><mn>1,2</mn></mfenced></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mo>-</mo><mn>6</mn><mo>,3</mo></mrow></mfenced></math> is"
  },
  "options": [
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mn>0</mn><mo>,</mo><mi></mi><mn>0</mn></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mo>-</mo><mn>4</mn><mo>,</mo><mi></mi><mn>5</mn></mrow></mfenced></math>",
