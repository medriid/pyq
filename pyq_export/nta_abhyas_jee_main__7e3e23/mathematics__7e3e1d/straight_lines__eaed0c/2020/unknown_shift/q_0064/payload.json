    "text": "<img src=\"assets\\st0064_3600788fc0ea.png\" style=\"width:2.84722in;height:1.42708in\" /><br />Let,&nbsp;<math><mi mathvariant=\"normal\">&#8736;</mi><mi>R</mi><mi>P</mi><mi>Q</mi><mo>=</mo><mi>&#952;</mi></math> &amp; <math><mi mathvariant=\"normal\">&#8736;</mi><mi>R</mi><mi>Q</mi><mi>P</mi><mo>=</mo><mi>&#981;</mi></math>, where <math><mi>&#952;</mi><mo>-</mo><mi>&#981;</mi><mo>=</mo><mn>4</mn><msup><mrow><mn>5</mn></mrow><mrow><mo>&#8728;</mo></mrow></msup></math><br />Now,&nbsp;<math><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mfenced separators=\"|\"><mrow><mi>&#952;</mi><mo>-</mo><mi>&#981;</mi></mrow></mfenced><mo>=</mo><mn>1</mn></math><br /><math><mo>&#8658;</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#952;</mi></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>&#8289;</mo><mrow><mi>&#981;</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mn>1</mn></math>, where <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mo>&#8289;</mo><mi>&#952;</mi><mo>=</mo><mfrac><mi>y</mi><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfrac><mo>&#160;</mo><mo>&#38;</mo><mo>&#160;</mo><mi>tan</mi><mo>&#8289;</mo><mi>&#981;</mi><mo>=</mo><mfrac><mi>y</mi><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfrac></math><br /><math><mo>&#8658;</mo><mfrac><mrow><mi>y</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mi>y</mi></mrow><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mn>1</mn><mo>+</mo><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>y</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>x</mi></mrow></mfrac></mrow></mfenced><mfenced separators