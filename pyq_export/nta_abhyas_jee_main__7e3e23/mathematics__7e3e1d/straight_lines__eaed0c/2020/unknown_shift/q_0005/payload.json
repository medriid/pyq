    "text": "<img src=\"assets\\st0005_ddf5f9914b48.png\" style=\"width:2.14028in;height:2.23333in\" /><br /><math><mi mathvariant=\"normal\">P</mi><mi mathvariant=\"normal\">Q</mi><mo>=</mo><mn>3</mn><msqrt><mn>2</mn></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">Q</mi></msub><mo>=</mo><mn>2</mn><mo>+</mo><mn>3</mn><msqrt><mn>2</mn></msqrt><mo>&#8901;</mo><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>=</mo><mn>5</mn></math><br />and <math><msub><mrow><mi mathvariant=\"normal\">y</mi></mrow><mrow><mi mathvariant=\"normal\">Q</mi></mrow></msub><mo>=</mo><mn>1</mn><mo>-</mo><mn>3</mn><msqrt><mn>2</mn></msqrt><mo>&#8901;</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>=</mo><mo>-</mo><mn>2</mn></math><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">Q</mi><mo>&#8801;</mo><mfenced separators=\"|\"><mrow><mn>5</mn><mo>,</mo><mi mathvariant=\"normal\"></mi><mo>-</mo><mn>2</mn></mrow></mfenced></math><br />Distance of <math><mi mathvariant=\"normal\">Q</mi></math> from the line <math><mi mathvariant=\"normal\">x</mi><mo>+</mo><mi mathvariant=\"normal\">y</mi><mo>=</mo><mn>1</mn></math> is<br /><math><mfrac><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>5</mn><mo>-</mo><mn>2</mn><mo>-</mo><mn>1</mn></mrow></mfenced></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>&#8658;</mo><mi mathvariant=\"normal\">Q</mi><mi mathvariant=\"normal\">R</mi><mo>=</mo><mn>2</mn><msqrt><mn>2</mn></msqrt></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><msub><mi mathvariant=\"normal\">x</mi><mi mathvariant=\"normal\">R</mi></msub><mo>=</mo><mn>5</mn><mo>-</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>&#8901;</mo><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>=</mo><mn>3</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">y</mi><mi mathvariant=\"normal\">R</mi></msub><mo>=</mo><mo>-</mo><mn>2</mn><mo>-</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>&#8901;</mo><mfrac><mn>1</mn><msqrt><mn>2</mn></msqrt></mfrac><mo>=</mo><mo>-</mo><mn>4</mn></math><br />Thus,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi><mo>&#8801;</mo><mfenced separators=\"|\"><mrow><mn>3</mn><mo>,</mo><mo>-</mo><mn>4</mn></mrow></mfenced></math>"
