  "correct_answer": "25",
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><msub><mi>v</mi><mn>1</mn></msub><mo>&#8594;</mo></mover><mo>=</mo><mn>5</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mi>g</mi><mi>t</mi><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>&#160;</mo><mo>&#8658;</mo><msub><mi>u</mi><mn>1</mn></msub><mo>=</mo><mn>5</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><msub><mi>v</mi><mn>2</mn></msub><mo>&#8594;</mo></mover><mo>=</mo><mn>20</mn><mover><mi mathvariant=\"normal\">i</mi><mo>^</mo></mover><mo>-</mo><mi>g</mi><mi>t</mi><mover><mi mathvariant=\"normal\">j</mi><mo>^</mo></mover><mo>&#160;</mo><mo>&#8658;</mo><msub><mi>u</mi><mn>2</mn></msub><mo>=</mo><mn>20</mn></math></p><p>As&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><msub><mi>v</mi><mn>1</mn></msub><mo>&#8594;</mo></mover></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><msub><mi>v</mi><mn>2</mn></msub><mo>&#8594;</mo></mover></math>&nbsp;are perpendicular,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>1</mn></msub><mo>&#183;</mo><msub><mover><mi>v</mi><mo>&#8594;</mo></mover><mn>2</mn></msub><mo>=</mo><mn>0</mn></math><br /><math><mi>t</mi><mo>=</mo><mfrac><mrow><msqrt><msub><mrow><mi>u</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>&#8196;</mo><msub><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msub></msqrt></mrow><mrow><mi>g</mi></mrow></mfrac></math><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>s</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mtext>rel</mtext></mrow></msub><mo>=</mo><msub><mrow><mover accent=\"true\"><mrow><mi>u</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mtext>rel</mtext></mrow></msub><mo>&#215;</mo><mi>t</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>&#160;</mo><mo>(</mo><msub><mi>u</mi><mn>1</mn></msub><mo>+</mo><msub><mi>u</mi><mn>2</mn></msub><mo>)</mo><mo>&#160;</mo><mi>t</mi></math><br /><math><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>u</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mfrac><mrow><msqrt><msub><mrow><mi>u</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>&#8196;</mo><msub><mrow><mi>u</mi></mrow><mrow><mn>2</mn></mrow></msub></msqrt></mrow><mrow><mi>g</mi></mrow></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>25</mn><mo>&#215;</mo><mfrac><mn>10</mn><mn>10</mn></mfrac><mo>=</mo><mn>25</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math></p><div id=\"gtx-trans\" style=\"position: absolute; left: 81px; top: 225.16px;\"><div class=\"gtx-trans-icon\">&nbsp;</div></div>"
