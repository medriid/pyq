  "correctValue": null,
  "solution": {
    "text": "Let <math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>c</mi></mrow></msub></math> = actual velocity of cyclist along <math><mi>x</mi><mo>-</mo><mi>a</mi><mi>x</mi><mi>i</mi><mi>s</mi></math><br /><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi></mrow></msub></math> = the velocity of racer along tangent of circular path (shown in figure)<br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi></math> <math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi><mi>c</mi></mrow></msub><mo>=</mo><mi>&#160;</mi><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi></mrow></msub><mo>-</mo><mi>&#160;</mi><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>c</mi></mrow></msub></math><br /><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/ci/image12-2bf0e6df-6c10-449f-be33-9a0666d87b75.jpg\" style=\"max-width:100%; object-fit:contain\" /><br /><br />Hence <math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>c</mi></mrow></msub><mo>=</mo><mn>20</mn><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover></math><br /><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi><mi>c</mi></mrow></msub><mo>=</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>r</mi></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><msup><mrow><mn>30</mn></mrow><mrow><mi>o</mi></mrow></msup></mrow></mrow><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>r</mi></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><msup><mrow><mn>30</mn></mrow><mrow><mi>o</mi></mrow></msup></mrow></mrow><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover></math><br /><br />Or <math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi></mrow></msub><mo>=</mo><mn>15</mn><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>&#8289;</mo><mrow><mn>30</mn></mrow></mrow><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mn>15</mn><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>&#8289;</mo><mrow><mn>30</mn></mrow></mrow><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>15</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mn>15</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover></math><br /><br /><math><mo>&#8756;</mo></math> <math><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi><mi>c</mi></mrow></msub><mo>=</mo><mi>&#160;</mi><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi></mrow></msub><mo>-</mo><mi>&#160;</mi><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>c</mi></mrow></msub></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>15</mn><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mn>15</mn><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math><br /><br /><math><mo>=</mo><mi>&#160;</mi><mo>-</mo><mn>12.5</mn><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>i</mi></mrow><mo>^</mo></mover><mo>+</mo><mfrac><mrow><mn>15</mn><mi>&#160;</mi><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&#160;</mi><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover></math><br /><br /><math><mo>&#8756;</mo></math> <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><msub><mrow><mover accent=\"true\"><mrow><mi>v</mi></mrow><mo>&#8594;</mo></mover></mrow><mrow><mi>r</mi><mi>c</mi></mrow></msub></mrow></mfenced><mo>=</mo><mi>&#160;</mi><msqrt><msup><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mn>12.5</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>15</mn><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>18</mn><mo>.03</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
