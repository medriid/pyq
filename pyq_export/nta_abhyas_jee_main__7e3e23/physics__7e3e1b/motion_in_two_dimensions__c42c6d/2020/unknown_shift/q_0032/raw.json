    {
      "id": "IP3Ax",
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mi>u</mi> <mn>2</mn> </msup><mi>sin&nbsp;</mi><mn></mn><mn>2</mn><mi>α</mi> </mrow> <mrow> <mi></mi><mi></mi><mi></mi><mi>g</mi><mi>cos</mi><mi>&nbsp;</mi><mi>θ</mi> </mrow> </mfrac> </mrow> </math>",
