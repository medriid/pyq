  "solution": {
    "text": "Given that<br /><br /><math> <mrow> <mfrac> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>x</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>y</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> <mo>=</mo> <mi>c</mi> </mrow> </math><br /><br /><math> <mrow> <mo>&there4;</mo> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mfrac> <mrow> <msup> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>x</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <msup> <mi>t</mi> <mn>2</mn> </msup> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <msup> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>y</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <msup> <mi>t</mi> <mn>2</mn> </msup> </mrow> </mfrac> <mo>=</mo> <mn>0</mn> </mrow> </math><br /><br />Further z = ax<sup>3</sup> + by<sup>2</sup><br /><br /><math> <mrow> <mo>&there4;</mo> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mfrac> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>z</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> <mo>=</mo> <mn>3</mn> <mi>a</mi> <msup> <mi>x</mi> <mn>2</mn> </msup> <mfrac> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>x</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> <mo>+</mo> <mn>2</mn> <mi>b</mi> <mi>y</mi> <mfrac> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>y</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> </mrow> </math><br /><br />&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp; <math><mrow> <mo>=</mo> <mn>3</mn> <mi>a</mi> <msup> <mrow> <mi>c</mi> <mi>x</mi> </mrow> <mn>2</mn> </msup> <mo>+</mo> <mn>2</mn> <mi>b</mi> <mi>c</mi> <mi>y</mi> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>x</mi> </mrow> <mrow> <mi></mi><mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> <mo>=</mo> <mi>c</mi> <mo>=</mo> <mfrac> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <mi>y</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> </mrow> </mfenced> </mrow> </math><br /><br /><math> <mrow> <mo>&there4;</mo> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mspace width=\"0.5em\"></mspace> <mfrac> <mrow> <msup> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>z</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <msup> <mi>t</mi> <mn>2</mn> </msup> </mrow> </mfrac> <mo>=</mo> <mn>6</mn> <mi>a</mi> <mi>c</mi> <mi>x</mi> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <mi>x</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> </mrow> </mfenced> <mo>+</mo> <mn>2</mn> <mi>b</mi> <mi>c</mi> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <mi>y</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <mi>t</mi> </mrow> </mfrac> </mrow> </mfenced> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; = 6ac<sup>2</sup>x + 2bc<sup>2</sup><br /><br />Now acceleration of particle is<br /><br /><math> <mrow> <mover accent=\"true\"> <mi>a</mi> <mo>&rarr;</mo> </mover> <mo>=</mo> <mfrac> <mrow> <msup> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>x</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <msup> <mi>t</mi> <mn>2</mn> </msup> </mrow> </mfrac> <mover accent=\"true\"> <mtext>i</mtext> <mo>^</mo> </mover> <mo>+</mo> <mfrac> <mrow> <msup> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>y</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <msup> <mi>t</mi> <mn>2</mn> </msup> </mrow> </mfrac> <mover accent=\"true\"> <mtext>j</mtext> <mo>^</mo> </mover> <mo>+</mo> <mfrac> <mrow> <msup> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>z</mi> </mrow> <mrow> <mi></mi><mi>d</mi><mo>⁡</mo> <msup> <mi>t</mi> <mn>2</mn> </msup> </mrow> </mfrac> <mover accent=\"true\"> <mi>k</mi> <mo>^</mo> </mover> </mrow> </math><br /><br />&nbsp; &nbsp;<math> <mrow><mo>=</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mn>6</mn> <mi>a</mi> <msup> <mi>c</mi> <mn>2</mn> </msup> <mi>x</mi> <mo>+</mo> <mn>2</mn> <mi>b</mi> <msup> <mi>c</mi> <mn>2</mn> </msup> </mrow> </mfenced> <mover accent=\"true\"> <mi>k</mi> <mo>^</mo> </mover> </mrow> </math>"
