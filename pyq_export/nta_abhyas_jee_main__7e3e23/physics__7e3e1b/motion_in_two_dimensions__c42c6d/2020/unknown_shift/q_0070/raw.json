  "solution": {
    "text": "Let <math><mi>t</mi></math> be the time interval. Then,<br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/44175.png\" style=\"width: 235px; height: 174px;\" /><br /><br /><math><mn>2</mn><mi>h</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi>u</mi></mrow><mrow><mi>x</mi></mrow></msub></mrow></mfenced><mo>(</mo><mi>t</mi><mo>)</mo></math><br /><br />or <math><msub><mrow><mi>u</mi></mrow><mrow><mi>x</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mi>h</mi></mrow><mrow><mi>t</mi></mrow></mfrac></math> ...(i)<br /><br />Further, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mo>=</mo><msub><mi>u</mi><mi>y</mi></msub><mi>t</mi><mo>-</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>g</mi><msup><mi>t</mi><mn>2</mn></msup></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi><msup><mi>t</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn><msub><mi>u</mi><mi>y</mi></msub><mi>t</mi><mo>+</mo><mn>2</mn><mi>h</mi><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#160;</mi><msub><mi>t</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><mn>2</mn><msub><mi>u</mi><mi>y</mi></msub><mo>+</mo><msqrt><mn>4</mn><msubsup><mi>u</mi><mi>y</mi><mn>2</mn></msubsup><mo>-</mo><mn>8</mn><mi>g</mi><mi>h</mi></msqrt></mrow><mrow><mn>2</mn><mi>g</mi></mrow></mfrac></math><br /><br />and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><mfrac><mrow><mn>2</mn><msub><mi>u</mi><mi>y</mi></msub><mo>-</mo><msqrt><mn>4</mn><msubsup><mi>u</mi><mi>y</mi><mn>2</mn></msubsup><mo>-</mo><mn>8</mn><mi>g</mi><mi>h</mi></msqrt></mrow><mrow><mn>2</mn><mi>g</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><msub><mi>t</mi><mn>1</mn></msub><mo>-</mo><msub><mi>t</mi><mn>2</mn></msub><mo>=</mo><mfrac><msqrt><mn>4</mn><msubsup><mi>u</mi><mi>y</mi><mn>2</mn></msubsup><mo>-</mo><mn>8</mn><mi>g</mi><mi>h</mi></msqrt><mi>g</mi></mfrac></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>u</mi><mi>y</mi><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><msup><mi>g</mi><mn>2</mn></msup><msup><mfenced separators=\"|\"><mi>t</mi></mfenced><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mo>+</mo><mn>2</mn><mi>g</mi><mi>h</mi></math>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;...(ii)<br /><br />Given, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>u</mi><mi>x</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>u</mi><mi>y</mi><mn>2</mn></msubsup><mo>=</mo><msup><mfenced separators=\"|\"><mrow><mn>2</mn><msqrt><mi>g</mi><mi>h</mi></msqrt></mrow></mfenced><mn>2</mn></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#160;</mi><mfrac><mrow><mn>4</mn><msup><mi>h</mi><mn>2</mn></msup></mrow><msup><mfenced separators=\"|\"><mi>t</mi></mfenced><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mrow><msup><mi>g</mi><mn>2</mn></msup><msup><mfenced separators=\"|\"><mi>t</mi></mfenced><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mo>+</mo><mn>2</mn><mi>g</mi><mi>h</mi><mo>=</mo><mn>4</mn><mi>g</mi><mi>h</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>g</mi><mn>2</mn></msup><mn>4</mn></mfrac><msup><mfenced separators=\"|\"><mi>t</mi></mfenced><mn>4</mn></msup><mo>-</mo><mn>2</mn><mi>g</mi><mi>h</mi><msup><mfenced separators=\"|\"><mi>t</mi></mfenced><mn>2</mn></msup><mo>+</mo><mn>4</mn><msup><mi>h</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mi>t</mi></mfenced><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mn>2</mn><mi>g</mi><mi>h</mi><mo>&#177;</mo><msqrt><mn>4</mn><msup><mi>g</mi><mn>2</mn></msup><msup><mi>h</mi><mn>2</mn></msup><mo>-</mo><mn>4</mn><msup><mi>g</mi><mn>2</mn></msup><msup><mi>h</mi><mn>2</mn></msup></msqrt></mrow><mrow><msup><mi>g</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><mi>h</mi></mrow><mi>g</mi></mfrac></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>2</mn><msqrt><mfrac><mi>h</mi><mi>g</mi></mfrac></msqrt></math>",
