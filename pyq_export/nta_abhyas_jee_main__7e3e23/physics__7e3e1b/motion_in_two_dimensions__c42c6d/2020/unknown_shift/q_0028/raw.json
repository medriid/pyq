  "correctValue": null,
  "solution": {
    "text": "Time, <math><mi>T</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>u</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow><mrow><mi>g</mi></mrow></mfrac></math><br /><br /><math><mi>T</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mo>×</mo><mn>50</mn><mo>×</mo><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msup><mrow><mn>30</mn></mrow><mrow><mi>o</mi></mrow></msup></mrow></mrow></mrow><mrow><mn>10</mn></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn><mo>×</mo><mn>50</mn><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow><mrow><mn>10</mn></mrow></mfrac><mo>=</mo><mn>5</mn><mi>&nbsp;</mi><mn>s</mn></math><br /><br />Time spent after crossing the wall, <math><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>5</mn><mo>-</mo><mn>3</mn><mo>=</mo><mn>2</mn><mn>&nbsp;s</mn></math><br /><br /><math><mo>∴</mo></math> Distance, <math><msub><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mi>u</mi><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow><mo>×</mo><msub><mrow><mn>t</mn></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mo>=</mo><mn>50</mn><mo>×</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><msup><mrow><mn>30</mn></mrow><mrow><mi>o</mi></mrow></msup></mrow></mrow><mo>×</mo><mn>2</mn></math><br /><br /><math><mo>=</mo><mn>50</mn><mo>×</mo><mfrac><mrow><msqrt><mn>3</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mo>×</mo><mn>2</mn></math><br /><br /><math><mo>=</mo><mn>50</mn><msqrt><mn>3</mn></msqrt></math><br /><br /><math><mo>=</mo><mn>50</mn><mo>×</mo><mn>1.73</mn></math><br /><br /><math><mo>=</mo><mn>86.5</mn><mi>&nbsp;</mi><mi mathvariant=\"normal\">m</mi></math>",
