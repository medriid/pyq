  "solution": {
    "text": "<math><mo>(</mo><mn>i</mn><mo>)</mo></math> Average speed along <math> <mrow>  <mtext>x</mtext><mo>&#x2212;</mo><mtext>axis</mtext></mrow></math><br /><br /><img src=\"assets\\st0080_3eff03a5f2be.jpeg\" /><br /><br /><math><mfenced close=\"〉\" open=\"〈\" separators=\"|\"><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>x</mi></mrow></msub></mrow></mfenced><mo>=</mo><mfrac><mrow><mrow><mo stretchy=\"false\">∫</mo><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mover accent=\"true\"><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>x</mi></mrow></msub></mrow><mo>→</mo></mover></mrow></mfenced><mn>d</mn><mi>t</mi></mrow></mrow></mrow><mrow><mrow><mo stretchy=\"false\">∫</mo><mrow><mn>d</mn><mi>t</mi></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>d</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>d</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>(</mo><mi>ii</mi><mo>)</mo></math> We have,<br /><br /><math><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi>m</mi><mi>v</mi></mrow><mrow><mi>q</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>,</mo><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi>m</mi><mi>v</mi></mrow><mrow><mi>q</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math><br /><br />Since, <math><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>4</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br />Time in <math><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>⇒</mo><mfrac><mrow><mi>π</mi><mi>m</mi></mrow><mrow><mi>q</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><msub><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow></msub></math><br /><br />Time in <math><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>⇒</mo><mfrac><mrow><mi>π</mi><mi>m</mi></mrow><mrow><mi>q</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br />Total distance along x - axis <math><msub><mrow><mi>d</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>d</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mn>5</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math><br /><br />Total time <math><mi>T</mi><mo>=</mo><msub><mrow><mi>t</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>5</mn><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi></math> Average speed <math><mo>=</mo><mfrac><mrow><mn>10</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mn>5</mn><msub><mrow><mi>t</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>m</mi><mi>v</mi></mrow><mrow><mi>q</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>×</mo><mfrac><mrow><mi>q</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi>π</mi><mi>m</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math>"
  }
