  "question": {
    "text": "<p>A block of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">m</mi></math> and charge <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">q</mi></math> is released on a long smooth inclined plane. Magnetic field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math> is constant, uniform and out of the plane of the paper as shown. Find the time from the start when blocking lose contact with the surface.<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/11891qq.png\" style=\"width: 154px; height: 161px;\" /></p>\r",
    "image": null
  },
  "options": [
    {
      "id": "hY9tD",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">m</mi><mtext> </mtext><mi>cosθ</mi></mrow><mi>qB</mi></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZeAhH",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">m</mi><mtext> cosec&nbsp;</mtext><mi mathvariant=\"normal\">θ</mi></mrow><mi>qB</mi></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RaYjh",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">m</mi><mtext> </mtext><mi>cotθ</mi></mrow><mi>qB</mi></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "wfKwv",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">m</mi><mtext> </mtext><mi>tanθ</mi></mrow><mi>qB</mi></mfrac></math>",
      "image": null,
