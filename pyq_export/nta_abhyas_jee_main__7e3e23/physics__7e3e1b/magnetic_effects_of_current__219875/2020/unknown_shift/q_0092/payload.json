    "text": "<math><mi>L</mi><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">π</mi><mi>R</mi></math><br /><br /><math><mi>&nbsp;</mi><mi>R</mi><mo>=</mo><mfrac><mrow><mi>L</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">π</mi></mrow></mfrac></math><br /><br /><math><mn>2</mn><mi>T</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mfenced separators=\"|\"><mrow><mi>d</mi><mi mathvariant=\"normal\">θ</mi></mrow></mfenced><mo>=</mo><msub><mrow><mi>F</mi></mrow><mrow><mi>m</mi></mrow></msub></mrow></mrow></math><br /><br /><br /><img alt=\"\" src=\"assets\\st0092_e32097030587.jpg\" style=\"width: 230px; height: 144px;\" /><br /><br />For small angles, <math><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>(</mo><mi>d</mi><mi mathvariant=\"normal\">θ</mi><mo>)</mo><mo>&#x2248;</mo><mi>d</mi><mi mathvariant=\"normal\">θ</mi></mrow></mrow></math><br /><br /><math><mi>&nbsp;</mi><mn>2</mn><mi>T</mi><mfenced separators=\"|\"><mrow><mi>d</mi><mi mathvariant=\"normal\">θ</mi></mrow></mfenced><mo>=</mo><mi>I</mi><mfenced separators=\"|\"><mrow><mi>d</mi><mi>L</mi></mrow></mfenced><mi>B</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mn>90</mn><mo>°</mo></mrow></mrow></math><br /><br /><math><mi>&nbsp;</mi><mo>=</mo><mi>I</mi><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mi>R</mi><mi>&nbsp;</mi><mo>.</mo><mi>d</mi><mi mathvariant=\"normal\">θ</mi></mrow></mfenced><mo>.</mo><mi>B</mi></math><br /><br /><math><mi>&nbsp;</mi><mi>T</mi><mo>=</mo><mi>I</mi><mi>R</mi><mi>B</mi><mo>=</mo><mfrac><mrow><mi>I</mi><mi>L</mi><mi>B</mi></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">π</mi></mrow></mfrac></math>"
