    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mo>=</mo><mtext>0.05</mtext><mo>&#160;</mo><mi mathvariant=\"normal\">T</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>1</mn></msub><mo>=</mo><mn>101</mn><mtext>&#8201;</mtext><mtext>&#8201;</mtext><msup><mtext>cm</mtext><mn>2</mn></msup><mo>=</mo><mn>101</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>&#8722;</mo><mn>4</mn></mrow></msup><mtext>&#8201;</mtext><mtext>&#8201;</mtext><msup><mtext>m</mtext><mn>2</mn></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>A</mi><mn>2</mn></msub><mo>=</mo><mn>100</mn><mtext>&#8201;</mtext><mtext>&#8201;</mtext><msup><mtext>cm</mtext><mn>2</mn></msup><mo>=</mo><mn>100</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>&#8722;</mo><mn>4</mn></mrow></msup><mtext>&#8201;</mtext><mtext>&#8201;</mtext><msup><mtext>m</mtext><mn>2</mn></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mn>2</mn><mtext>&#8201;&#8201;</mtext><mi mathvariant=\"normal\">&#937;</mi></math><br /><br />Amount of charge flown is given by,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>q</mi><mo>=</mo><mfrac><mrow><mi>B</mi><mrow><mo>(</mo><mi mathvariant=\"normal\">&#916;</mi><mi>A</mi><mo>)</mo></mrow></mrow><mi>R</mi></mfrac></math><br /><br />&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mtext>0.05</mtext><mo>&#215;</mo><mfenced><mrow><mn>1</mn><mn>0</mn><mn>1</mn><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup><mo>-</mo><mn>1</mn><mn>0</mn><mn>0</mn><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup></mrow></mfenced></mrow><mn>2</mn></mfrac></math><br /><br />&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mtext>0.05</mtext><mo>&#215;</mo><mn>1</mn><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mrow><mo>-</m