    "text": "<p>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img alt=\"\" src=\"assets\\st0019_bc7341faeeb9.jpg\" style=\"width: 278px; height: 184px;\" /><br /><br />Magnetic field due to wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AC</mi></math>,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mi>AC</mi></msub><mo>=</mo><mfrac><mrow><msub><mi mathvariant=\"normal\">&#956;</mi><mn>0</mn></msub><mtext>I</mtext></mrow><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi><mfenced><mrow><mn>2</mn><mo>R</mo><mo>sin</mo><mn>30</mn></mrow></mfenced></mrow></mfrac><mfenced><mrow><mo>cos</mo><mn>30</mn><mo>-</mo><mo>cos</mo><mn>90</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><msqrt><mn>3</mn></msqrt><msub><mi mathvariant=\"normal\">&#956;</mi><mn>0</mn></msub><mtext>I</mtext></mrow><mrow><mn>8</mn><mi mathvariant=\"normal\">&#960;</mi><mtext>R</mtext></mrow></mfrac></math></p><p><br />Magnetic field due to wire <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>BC</mi></math>,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">B</mi><mi>BC</mi></msub><mo>=</mo><mfrac><mrow><msub><mi mathvariant=\"normal\">&#956;</mi><mn>0</mn></msub><mtext>I</mtext></mrow><mrow><mn>4</mn><mi mathvariant=\"normal\">&#960;</mi><mfenced><mrow><mn>2</mn><mo>R</mo><mo>sin</mo><mn>60</mn></mrow></mfenced></mrow></mfrac><mfenced><mrow><mo>cos</mo><mn>60</mn><mo>-</mo><mo>cos</mo><mn>90</mn></mrow></mfenced><mo>=</mo><mfrac><mrow><msub><mi mathvariant=\"normal\">&#956;</mi><mn>0</mn></msub><mtext>I</mtext></mrow><mrow><mn>8</mn><msqrt><mn>3</mn></msqrt><mi mathvariant=\"normal\">&#960;</mi><mtext>R</mtext></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mn>3</mn></msqrt><msub><mi mathvariant=\"normal\">&#956;</mi><mn>0</mn></msub><mtext>I</mtext></mrow><mrow><mn>24</mn><mi mathvariant=\"normal\">&#960;</mi><mtext>R</mtext></mrow></mfrac></math><br /><br /><math> <mrow> <msub> <mro