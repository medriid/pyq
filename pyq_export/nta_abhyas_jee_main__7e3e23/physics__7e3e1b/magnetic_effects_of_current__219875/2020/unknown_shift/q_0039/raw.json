    {
      "id": "epdfZ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>l</mi><mn>0</mn></msub><mo>+</mo><mfrac><mrow><mi>m</mi><mi>g</mi><mo>-</mo><mi>i</mi><mi>l</mi><mi>B</mi></mrow><mrow><mn>2</mn><mi>K</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
