      "image": null,
      "isCorrect": false
    },
    {
      "id": "xKuZA",
      "text": "<math><mn>2</mn><mi>π</mi><msqrt><mfrac><mrow><mn>3</mn><mi>m</mi><mi>L</mi></mrow><mrow><mi>q</mi><mi>E</mi></mrow></mfrac></msqrt></math>",
