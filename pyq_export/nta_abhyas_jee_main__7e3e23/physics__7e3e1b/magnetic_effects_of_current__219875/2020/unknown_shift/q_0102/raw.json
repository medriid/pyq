    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>B</mi><mi mathvariant=\"italic\">A</mi></msub><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>B</mi><mi>B</mi></msub><mo>=</mo><mfrac><msub><mi>μ</mi><mn>0</mn></msub><mrow><mn>4</mn><mi>π</mi></mrow></mfrac><mfrac><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>π</mi><mo>-</mo><mi>π</mi><mo>/</mo><mn>2</mn></mrow></mfenced><mi>I</mi></mrow><mi>R</mi></mfrac></math><br /><br /><math><msub><mrow><mi>B</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>I</mi></mrow><mrow><mn>4</mn><mi>π</mi><mi>R</mi></mrow></mfrac></math><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/D-10_solu.png\" style=\"width: 220px; height: 108px;\" /><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>B</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><msub><mrow><mi>B</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>+</mo><msub><mrow><mi>B</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>+</mo><msub><mrow><mi>B</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mi>o</mi></mrow></msub><mi>I</mi></mrow><mrow><mn>4</mn><mi>π</mi><mi>R</mi></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mn>1</mn></mrow></mfenced></math><br /><br /><math><mi>B</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mi>o</mi></mrow></msub><mi>I</mi></mrow><mrow><mi>π</mi><mi>R</mi></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>3</mn></mrow><mrow><mn>8</mn></mrow></mfrac><mi>π</mi><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></math><br /><br /><math><mi>B</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mi>o</mi></mrow></msub><mi>I</mi></mrow