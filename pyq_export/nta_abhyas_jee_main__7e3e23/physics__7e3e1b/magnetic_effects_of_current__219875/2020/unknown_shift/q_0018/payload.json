      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>λ</mi><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>λ</mi><mi>ω</mi></mrow><mrow><mi>π</mi></mrow></mfrac></math>",
      "is_correct": false
