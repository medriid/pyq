  "question": {
    "text": "The magnetic field at the point of intersection of diagonals of a square loop of side <math><mi>L</mi></math> carrying a current <math><mi>I</mi></math> is",
    "image": null
  },
  "options": [
    {
      "id": "ZTX3c",
      "text": "<math><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>I</mi></mrow><mrow><mi mathvariant=\"normal\">π</mi><mi>L</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dSlLg",
      "text": "<math><mfrac><mrow><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>I</mi></mrow><mrow><mi mathvariant=\"normal\">π</mi><mi>L</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jcaRS",
      "text": "<math><mfrac><mrow><msub><mrow><msqrt><mn>2</mn></msqrt><mi mathvariant=\"normal\">μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>I</mi></mrow><mrow><mi mathvariant=\"normal\">π</mi><mi>L</mi></mrow></mfrac></math>",
      "image": null,
