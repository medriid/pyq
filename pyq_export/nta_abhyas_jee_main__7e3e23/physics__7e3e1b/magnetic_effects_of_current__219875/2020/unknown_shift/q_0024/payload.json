  "question": {
    "text": "A charged particle enters a uniform magnetic field with a velocity vector at an angle of <math><mn>45</mn><mo>°</mo></math> with the magnetic field. The pitch of the helical path followed by the particle is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi></math>. The radius of the helix will be -"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>p</mi><mrow><msqrt><mn>2</mn></msqrt><mi mathvariant=\"normal\">&#960;</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
