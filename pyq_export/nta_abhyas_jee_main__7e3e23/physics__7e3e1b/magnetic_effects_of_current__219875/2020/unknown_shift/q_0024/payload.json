      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msqrt><mn>2</mn></msqrt><mi mathvariant=\"normal\">&#160;</mi><mi>p</mi></mrow><mi mathvariant=\"normal\">&#960;</mi></mfrac></math>",
