  "question": {
    "text": "A symmetric star shaped conducting wire loop is carrying a steady state current <math> <mi>I</mi> </math> as shown in the figure. The distance between the diametrically opposite vertices of the star is <math><mn>4</mn><mi>a</mi></math> .<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/190774q.png\" style=\"max-width:100%; object-fit:contain\" style=\"width: 196px; height: 169px;\" />",
    "image": null
  },
  "options": [
    {
      "id": "1twdS",
      "text": "<math><mfrac><mrow><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>I</mi></mrow><mrow><mn>4</mn><mi>π</mi><mi>a</mi></mrow></mfrac><mi> </mi><mn>3</mn><mi> </mi><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><msqrt><mn>3</mn></msqrt><mo>-</mo><mn>1</mn></mrow></mfenced></math>",
