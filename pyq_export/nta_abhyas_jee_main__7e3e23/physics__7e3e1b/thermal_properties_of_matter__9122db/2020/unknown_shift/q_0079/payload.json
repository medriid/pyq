      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>Y</mi><mn>1</mn></msub><msubsup><mi>&#x3B1;</mi><mn>1</mn><mn>2</mn></msubsup><mo>=</mo><msub><mi>Y</mi><mn>2</mn></msub><msubsup><mi>&#x3B1;</mi><mn>2</mn><mn>2</mn></msubsup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>Y</mi><mn>1</mn><mn>2</mn></msubsup><msub><mi>&#x3B1;</mi><mn>1</mn></msub><mo>=</mo><msubsup><mi>Y</mi><mn>2</mn><mn>2</mn></msubsup><msub><mi>&#x3B1;</mi><mn>2</mn></msub></math>",
