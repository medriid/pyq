  "correctValue": null,
  "solution": {
    "text": "As; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">d</mi><mi>l</mi><mo>=</mo><mi>α</mi><mi>l</mi><mi>d</mi><mi mathvariant=\"normal\">T</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∴</mo><munderover><mo>∫</mo><mi>l</mi><mrow><mn>2</mn><mi>l</mi></mrow></munderover><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi>l</mi></mrow><mi>l</mi></mfrac><mo>=</mo><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">&nbsp;</mi><munderover><mo>∫</mo><mn>0</mn><mi mathvariant=\"normal\">T</mi></munderover><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">T</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ln</mi><mn>2</mn><mo>=</mo><mi mathvariant=\"normal\">a</mi><mfrac><msup><mi mathvariant=\"normal\">T</mi><mn>2</mn></msup><mn>2</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∴</mo><mi mathvariant=\"normal\">T</mi><mo>=</mo><msup><mfenced close=\"]\" open=\"[\" separators=\"|\"><mfrac><mrow><mi>ln</mi><mn>4</mn></mrow><mi mathvariant=\"normal\">a</mi></mfrac></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>=</mo><msup><mfenced close=\"]\" open=\"[\" separators=\"|\"><mfrac><mrow><mn>2</mn><mo>×</mo><mn>0.693</mn></mrow><mrow><mn>3.465</mn><mo>×</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup></mrow></mfrac></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>=</mo><msqrt><mfrac><mn>2</mn><mn>5</mn></mfrac><mo>×</mo><msup><mn>10</mn><mn>5</mn></msup></msqrt><mo>=</mo><msup><mn>200&nbsp;</mn><mi mathvariant=\"normal\">o</mi></msup><mi mathvariant=\"normal\">C</mi></math>",
