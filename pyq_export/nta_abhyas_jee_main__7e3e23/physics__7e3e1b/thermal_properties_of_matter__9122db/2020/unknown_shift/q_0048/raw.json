  "correctValue": null,
  "solution": {
    "text": "Given, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#916;</mo><msub><mi mathvariant=\"normal\">l</mi><mn>1</mn></msub><mo>=</mo><mo>&#916;</mo><msub><mi mathvariant=\"normal\">l</mi><mn>2</mn></msub></math><br /><br />or,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">l</mi><mn>1</mn></msub><msub><mi mathvariant=\"normal\">&#945;</mi><mi mathvariant=\"normal\">a</mi></msub><mi mathvariant=\"normal\">t</mi><mo>=</mo><msub><mi mathvariant=\"normal\">l</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">&#945;</mi><mtext>s</mtext></msub><mi mathvariant=\"normal\">t</mi></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mfrac><msub><mi mathvariant=\"normal\">l</mi><mn>1</mn></msub><msub><mi mathvariant=\"normal\">l</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><msub><mi mathvariant=\"normal\">&#945;</mi><mtext>s</mtext></msub><msub><mi mathvariant=\"normal\">&#945;</mi><mi mathvariant=\"normal\">a</mi></msub></mfrac></math><br /><br />or, &nbsp; &nbsp;&nbsp; &nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">l</mi><mn>1</mn></msub><mrow><msub><mi mathvariant=\"normal\">l</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">l</mi><mn>2</mn></msub></mrow></mfrac><mo>=</mo><mfrac><msub><mi mathvariant=\"normal\">&#945;</mi><mtext>s</mtext></msub><mrow><msub><mi mathvariant=\"normal\">&#945;</mi><mi mathvariant=\"normal\">a</mi></msub><mo>+</mo><msub><mi mathvariant=\"normal\">&#945;</mi><mtext>s</mtext></msub></mrow></mfrac></math>",
