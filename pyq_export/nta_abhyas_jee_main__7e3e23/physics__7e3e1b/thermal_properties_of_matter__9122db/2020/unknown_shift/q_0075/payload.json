    },
    {
      "text": "<math><mn>2</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>4</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><mn>3.5</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup></math>",
      "is_correct": false
    },
