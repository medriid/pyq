  "solution": {
    "text": "<img src=\"assets\\st0006_06f925c7d94d.jpeg\" /><br /><br />Let <math><mi>T</mi></math> be the junction temperature<br /><br />Here, <math><msub><mrow><mi>K</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>K</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>,</mo><mi>&nbsp;</mi><mi>T</mi><mo>-</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><mn>50</mn><mi>K</mi></math><br /><br />At the steady state <math><msub><mrow><mi>H</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>=</mo><msub><mrow><mi>H</mi></mrow><mrow><mi>B</mi></mrow></msub></math><br /><br /><math> <mrow>  <mo>&#x21D2;</mo><mo>&#x00A0;</mo><mo>&#x00A0;</mo><mo>&#x00A0;</mo><mo>&#x00A0;</mo><mo>&#x00A0;</mo><mfrac>   <mrow>    <msub>     <mi>K</mi>     <mi>A</mi>    </msub>    <mi>A</mi><mfenced>     <mrow>      <msub>       <mi>T</mi>       <mi>A</mi>      </msub>      <mo>&#x2212;</mo><mi>T</mi></mrow>    </mfenced></mrow>   <mrow>    <mfrac>     <mi>L</mi>     <mn>2</mn>    </mfrac>    </mrow>  </mfrac>  <mo>=</mo><mfrac>   <mrow>    <msub>     <mi>K</mi>     <mi>B</mi>    </msub>    <mi>A</mi><mo>&#x00A0;</mo><mfenced>     <mrow>      <mi>T</mi><mo>&#x2212;</mo><msub>       <mi>T</mi>       <mi>B</mi>      </msub>      </mrow>    </mfenced></mrow>   <mrow>    <mfrac>     <mi>L</mi>     <mn>2</mn>    </mfrac>    </mrow>  </mfrac>  </mrow></math><br /><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mn>2</mn><msub><mrow><mi>K</mi></mrow><mrow><mi>B</mi></mrow></msub><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>T</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>-</mo><mi>T</mi></mrow></mfenced><mo>=</mo><msub><mrow><mi>K</mi></mrow><mrow><mi>B</mi></mrow></msub><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mi>T</mi><mo>-</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfenced></math><br /><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>T</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>-</mo><mi>T</mi><mo>=</mo><mfrac><mrow><mi>T</mi><mo>-</mo><msub><mrow><mi>T</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>50</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mo>=</mo><mn>25</mn><mi>&nbsp;</mi><mi>K</mi></math>"
  }
