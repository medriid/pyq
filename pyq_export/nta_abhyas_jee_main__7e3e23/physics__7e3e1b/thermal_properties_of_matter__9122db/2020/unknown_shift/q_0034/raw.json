  "question": {
    "text": "Assuming the sun to be a spherical body of radius <math><mi>R</mi><mi>&nbsp;</mi></math>at a temperature of <math><mi>T</mi><mi>&nbsp;</mi><mn>K</mn></math>, evaluate the total radiant power, incident on earth, at a distance <math><mi>r</mi></math> from the sun. (<math><msub><mrow><mi>r</mi></mrow><mrow><mn>0</mn></mrow></msub></math> is the radius of the earth and <math><mi>σ</mi></math> is Stefan's constant)",
    "image": null
  },
  "options": [
    {
      "id": "u25p6",
      "text": "<math><mrow><mrow><mn>4</mn><mi>π</mi><msubsup><mrow><mi>r</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>σ</mi><msup><mrow><mi>T</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow><mo>/</mo><mrow><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mrow></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "P5ZGP",
      "text": "<math><mrow><mrow><mi>π</mi><msubsup><mrow><mi>r</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>σ</mi><msup><mrow><mi>T</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow><mo>/</mo><mrow><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mrow></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "37dIz",
      "text": "<math><mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>σ</mi><msup><mrow><mi>T</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow><mo>/</mo><mrow><mn>4</mn><mi>π</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mrow></math>",
