    {
      "id": "nqpRs",
      "text": "<math><mrow><mrow><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>σ</mi><msup><mrow><mi>T</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow><mo>/</mo><mrow><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mrow></math>",
