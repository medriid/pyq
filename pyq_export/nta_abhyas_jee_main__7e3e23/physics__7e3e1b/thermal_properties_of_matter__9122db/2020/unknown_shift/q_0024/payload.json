  "solution": {
    "text": "Here, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">l</mi></mrow></mfenced><mo>=</mo><mi>&#160;</mi><mn>1.1</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">&#8451;</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi></mrow></mfenced><mo>=</mo><mn>1.7</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup><mo>&#160;</mo><msup><mi mathvariant=\"normal\">&#8451;</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><br /><math><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>s</mi></mrow></mfenced></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced></mrow><mrow><mi>&#945;</mi><mfenced separators=\"|\"><mrow><mi>s</mi></mrow></mfenced></mrow></mfrac><mo>=</mo><mi>&#160;</mi><mfrac><mrow><mn>1.7</mn><mi>&#160;</mi><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>5</mn></mrow></msup></mrow><mrow><mn>1.1</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>5</mn></mrow></msup></mrow></mfrac><mo>=</mo><mn>1.545</mn></math><br /><br /><math><mo>&#8756;</mo><mi>&#160;</mi><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>s</mi></mrow></mfenced><mo>=</mo><mn>1.545</mn><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced></math><br /><br />Also, <math><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>s</mi></mrow></mfenced><mo>-</mo><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>=</mo><mn>5</mn></math><br /><br />0.545<math><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>=</mo><mn>5</mn><mi>&#160;</mi></math><br /><br /><math><msub><mrow><mi>l</mi></mrow><mrow><mn>0</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi>c</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>0.545</mn></mrow></mfrac><mo>=</mo><mn>9.17</mn><mi>&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math><br /><br />And <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>l</mi><mn>0</mn></msub><mfenced separators=\"|\"><mi>s</mi></mfenced><mo>=</mo><mn>1.545</mn><mo>&#215;</mo><mn>9.17</mn><mi>&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">&#160;</mi><mo>=</mo><mn>14.17</mn><mi>&#160;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></math>"
