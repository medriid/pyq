mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi mathvariant=\"normal\">θ</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mrow></mrow><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>⇒</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><mn>8</mn><mo>×</mo><mn>1</mn></mrow><mrow><mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mn>2</mn> </mrow> </mfenced><msqrt><mn>3</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>16</mn><msqrt> <mn>3</mn> </msqrt></mrow><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>N</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><mn>12</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">s</mi></math>",
