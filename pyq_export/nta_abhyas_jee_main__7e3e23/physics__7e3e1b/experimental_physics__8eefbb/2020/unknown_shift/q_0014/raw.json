  "question": {
    "text": "A student measures the distance covered and time taken by a body under free fall which was initially at rest. He uses this data for estimating <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">g</mi></math>, the acceleration due to gravity. If the maximum percentage errors in measurement of the distance and the time are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">e</mi><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">e</mi><mn>2</mn></msub></math> respectively, then the maximum possible percentage error in the estimation of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">g</mi></math>&nbsp;is",
    "image": null
  },
  "options": [
    {
      "id": "lozPv",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">e</mi><mn>2</mn></msub><mo>&#8722;</mo><msub><mi mathvariant=\"normal\">e</mi><mn>1</mn></msub></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MPnGG",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">e</mi><mn>1</mn></msub><mo>+</mo><mo>&nbsp;</mo><mn>2</mn><msub><mi mathvariant=\"normal\">e</mi><mn>2</mn></msub></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "A53nE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">e</mi><mn>1</mn></msub><mo>+</mo><msub><mi mathvariant=\"normal\">e</mi><mn>2</mn></msub></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dUnle",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">e</mi><mn>1</mn></msub><mo>&#8722;</mo><mn>2</mn><msub><mi mathvariant=\"normal\">e</mi><mn>2</mn></msub></math>",
