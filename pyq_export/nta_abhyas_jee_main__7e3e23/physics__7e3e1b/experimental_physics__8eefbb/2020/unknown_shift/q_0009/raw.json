  "correctValue": null,
  "solution": {
    "text": "Current in tangent galvanometer<br /><br /><math><mi>I</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>r</mi><msub><mrow><mi>B</mi></mrow><mrow><mi>H</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">&mu;</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>N</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">&theta;</mi></mrow></mrow><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mo>.</mo><mo>.</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">i</mi></mrow></mfenced></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0032124.png\" style=\"max-width:100%; object-fit:contain\" style=\"width: 166px; height: 150px;\" /><br /><br />From Eq. (i), we get<br /><br /><math><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><mi>r</mi><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><mi mathvariant=\"normal\">&theta;</mi></mrow></mrow></mrow><mrow><mi>N</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">&mu;</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>I</mi></mrow><mrow><mn>2</mn><msub><mrow><mi>B</mi></mrow><mrow><mi>H</mi></mrow></msub></mrow></mfrac><mo>=</mo> <mtext>&nbsp;same for both</mtext></math><br /><br /><math><mo>&there4;</mo><mi>&nbsp;</mi><mfrac><mrow><msub><mrow><mi>r</mi></mrow><mrow><mi>A</mi></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi mathvariant=\"normal\">&theta;</mi></mrow><mrow><mi>A</mi></mrow></msub></mrow></mrow></mrow><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>A</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>r</mi></mrow><mrow><mi>B</mi></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">tan</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi mathvariant=\"normal\">&theta;</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mrow></mrow><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>&rArr;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><mn>8</mn><mo>&times;</mo><mn>1</mn></mrow><mrow><mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mn>2</mn> </mrow> </mfenced><msqrt><mn>3</mn></msqrt></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>16</mn><msqrt> <mn>3</mn> </msqrt></mrow><mrow><msub><mrow><mi>N</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>&there4;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>N</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><mn>12</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">s</mi></math>",
