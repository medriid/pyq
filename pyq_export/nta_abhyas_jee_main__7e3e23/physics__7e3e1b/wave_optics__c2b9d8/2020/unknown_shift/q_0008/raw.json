  "solution": {
    "text": "Path difference,<br /><math><mo>&#8710;</mo><mi>x</mi><mo>=</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>&#160;</mi><mi>S</mi><msub><mrow><mi>S</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>S</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>P</mi><mo>-</mo><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>n</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>S</mi><msub><mrow><mi>S</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>S</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>P</mi></mrow></mfenced><mo>-</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mi>t</mi></mrow></munderover><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>n</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>-</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mi>d</mi><mi>x</mi></mrow></mrow></mrow></mfenced><mi>&#160;</mi></math><br /><br /><math><mo>=</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mi>S</mi><msub><mrow><mi>S</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mi>S</mi><msub><mrow><mi>S</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mo>+</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>&#160;</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>S</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>P</mi><mo>-</mo><msub><mrow><mi>S</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>P</mi></mrow></mfenced><mo>-</mo><mrow><munderover><mo stretchy=\"false\">&#8747;</mo><mrow><mn>0</mn></mrow><mrow><mi>t</mi></mrow></munderover><mrow><msub><mrow><mi>n</mi></mrow><mrow><mn>3</mn></mrow></msub><mi>d</mi><mi>x</mi><mo>-</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow></mrow></ma