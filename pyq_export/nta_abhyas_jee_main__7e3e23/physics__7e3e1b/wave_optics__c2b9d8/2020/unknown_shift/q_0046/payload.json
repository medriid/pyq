  "correct_answer": "36",
  "solution": {
    "text": "<img alt=\"Picture 297\" src=\"assets\\st0046_f4cd20538de9.png\" style=\"width: 200px; height: 186px;\" /><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">P</mi><mo>–</mo><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\">P</mi><mo>=</mo><mi mathvariant=\"normal\">d</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi mathvariant=\"normal\">θ</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant=\"normal\">d</mi><mo>.</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">d</mi></mrow><mo>/</mo><mrow><mn>2</mn></mrow></mrow></mrow><mrow><mi mathvariant=\"normal\">D</mi></mrow></mfrac></mrow></mrow><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">D</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">λ</mi></mrow><mrow><mn>3</mn></mrow></mfrac></math><br /><math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>3</mn></mrow></msub><mi mathvariant=\"normal\">P</mi><mo>–</mo><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">P</mi><mo>=</mo><mi mathvariant=\"normal\">d</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi mathvariant=\"normal\">θ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mrow><mo>=</mo><mi mathvariant=\"normal\">d</mi><mfrac><mrow><mn>3</mn><mi mathvariant=\"normal\">d</mi><mo>/</mo><mn>2</mn></mrow><mrow><mi mathvariant=\"normal\">D</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn><msup><mrow><mi mathvariant=\"normal\">d</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">D</mi></mrow></mfrac><mo>=</mo><mi mathvariant=\"normal\">λ</mi></math><br /><img alt=\"Picture 290\" src=\"assets\\st0046_811c58e503c0.png\" style=\"width: 168px; height: 110px;\" /><br />I<sub>Resultant</sub> = <math><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mn>4</mn><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mn>2</mn><msqrt><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>0</mn></mrow></msub></msqrt><msqrt><mn>4</mn><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>0</mn></mrow></msub></msqrt><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><msup><mrow><mn>120</mn></mrow><mrow><mn>0</mn></mrow></msup></math><br /><math><mo>=</mo><mn>3</mn><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>0</mn></mrow></msub></math>&nbsp;"
  }
