  "solution": {
    "text": "&nbsp; &nbsp; &nbsp; &nbsp;<math> <mrow> <mtext>I</mtext> <mo>=</mo> <msub> <mtext>I</mtext> <mtext>max</mtext> </msub> <msup> <mtext>cos</mtext> <mn>2</mn> </msup> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi>&#981;</mi> </mrow> <mrow> <mn>2</mn> </mrow> </mfrac> </mrow> </mfenced> </mrow> </math><br /><br /><math> <mrow> <mo>&#160;&#8756; &#160;&#160;</mo> <mfrac> <mrow> <msub> <mtext>3I</mtext> <mtext>max</mtext> </msub> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> <mo>=</mo> <msub> <mtext>I</mtext> <mtext>max</mtext> </msub> <msup> <mtext>&#160;cos&#160;</mtext> <mn>2</mn> </msup> <mfrac> <mrow> <mi>&#981;</mi> </mrow> <mrow> <mn>2</mn> </mrow> </mfrac> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>cos</mtext><mfrac><mi>&#981;</mi><mn>2</mn></mfrac><mo>=</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></math><br /><br />or,&nbsp;&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>&#981;</mi><mn>2</mn></mfrac><mo>=</mo><mfrac><mi>&#960;</mi><mn>6</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;&#8756; &#160; &#160;</mo><mi mathvariant=\"normal\">&#981;</mi><mo>=</mo><mfrac><mi mathvariant=\"normal\">&#960;</mi><mn>3</mn></mfrac><mo>=</mo><mfenced><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mi mathvariant=\"normal\">&#955;</mi></mfrac></mfenced><mo>&#916;</mo><mi mathvariant=\"normal\">x</mi><mtext>&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; .....(i)&#160;</mtext></math><br /><br />where, &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#916;</mo><mi mathvariant=\"normal\">x</mi><mo>=</mo><mtext>d sin</mtext><mi mathvariant=\"normal\">&#952;</mi></math><br /><br />Substituting in Eq.(i) we get<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>sin</mtext><mi>&#952;</mi><mo>=</mo><mfrac><mi>&#955;</mi><mtext>6d</mtext></mfrac></math><br /><br />or,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#952;</mi><mo>=</mo><msup><mtext>sin</mtext><mn>-1</mn></msup><mfenced><mfrac><mi>&#955;</mi><mtext>6d</mtext></mfrac></mfenced></math><br /><br /><math>&#160; <mrow> <mo></mo></mrow></math>"
  }
