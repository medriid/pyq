  "solution": {
    "text": "Net path difference&nbsp;<math><mrow><mo>=</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mi>μ</mi> <mo>-</mo> <mn>1</mn> </mrow> </mfenced> <mtext>t</mtext> <mo>-</mo> <mfrac> <mrow> <mtext>yd</mtext> </mrow> <mrow> <mtext>D</mtext> </mrow> </mfrac> </mrow> </math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>-</mo><mn>1</mn></mrow></mfenced><mn>6</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">μ</mi><mtext>m</mtext><mo>-</mo><mfrac><mrow><mfenced><mrow><mtext>d</mtext><mo>/</mo><mn>2</mn></mrow></mfenced><mtext>d</mtext></mrow><mtext>D</mtext></mfrac><mo>=</mo><mn>1</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">μ</mi><mtext>m</mtext></math><br /><br />For Destructive interference<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>Δ</mo><mtext>x</mtext><mo>=</mo><mn>1</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">μ</mi><mtext>m</mtext><mo>=</mo><mfenced><mrow><mn>2</mn><mtext>n</mtext><mo>+</mo><mn>1</mn></mrow></mfenced><mfrac><mi mathvariant=\"normal\">λ</mi><mn>2</mn></mfrac><mo>⇒</mo><mi mathvariant=\"normal\">λ</mi><mo>=</mo><mfrac><mn>2</mn><mfenced><mrow><mn>2</mn><mtext>n</mtext><mo>+</mo><mn>1</mn></mrow></mfenced></mfrac><mo>&nbsp;</mo><mi mathvariant=\"normal\">μ</mi><mtext>m</mtext></math><br /><br /><math> <mrow> <mi>λ</mi> <mo>=</mo> <mfrac> <mrow> <mtext>2000 nm</mtext> </mrow> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mn>2</mn> <mo>+</mo> <mn>1</mn> </mrow> </mfenced> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mtext>2000</mtext> </mrow> <mrow> <mn>3</mn> </mrow> </mfrac> </mrow> </math>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mo>&nbsp;</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>1</mn><mo>&nbsp;</mo><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">λ</mi><mo>=</mo><mfrac><mtext>200