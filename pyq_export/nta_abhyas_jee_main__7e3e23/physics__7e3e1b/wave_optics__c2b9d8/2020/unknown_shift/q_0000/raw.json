  "solution": {
    "text": "Resolution limit<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mtext>1.22</mtext><mi mathvariant=\"normal\">&#955;</mi></mrow><mtext>d</mtext></mfrac></math><br />&nbsp;Again resolution limit <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mtext>sin</mtext><mi mathvariant=\"normal\">&#952;</mi><mo>=</mo><mi mathvariant=\"normal\">&#952;</mi><mo>=</mo><mfrac><mi mathvariant=\"normal\">y</mi><mtext>D</mtext></mfrac></math><br /><math> <mrow> <mo>&#8756;</mo> </mrow> </math>&nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi mathvariant=\"normal\">y</mi><mtext>D</mtext></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>&#183;</mo><mn>22</mn><mi mathvariant=\"normal\">&#955;</mi></mrow><mtext>d</mtext></mfrac></math><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/2975.png\" style=\"width: 334px; height: 143px;\" /><br /><style type=\"text/css\"><!--{cke_protected}{C}%3C!%2D%2D%0A%09%09%40page%20%7B%20margin%3A%202cm%20%7D%0A%09%09P%20%7B%20margin-bottom%3A%200.21cm%20%7D%0A%09%2D%2D%3E-<img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/2975.png\" data-cke-saved-src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/2975.png\" alt=\"\"></style><p style=\"margin-bottom: 0cm\">&nbsp;</p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>D</mtext><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">y</mi><mtext>d</mtext></mrow><mrow><mtext>1.22</mtext><mi mathvariant=\"normal\">&#955;</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>D</mtext><mo>=</mo><mfrac><mrow><mfenced><msup><mtext>10</mtext><mrow><mo>-</mo><mn>3</mn></mrow></msup></mfenced><mo>&#215;</mo><mfenced><mrow><mn>3</mn><mo>&#215;</mo><msup><mtext>10</mtext><mrow><mo>-</mo><mn>3</mn></mrow></msup></mrow></mfenced></mrow><mrow><mfenced><mtext>1.22</mtext></mfenced><mo>&#215;</mo><mfenced><mro