  "solution": {
    "text": "<p><math><mfrac><mrow><mn>3</mn><msub><mrow><mi>I</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>32</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>I</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><msup><mrow><mi mathvariant=\"normal\">s</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>θ</mi><mi>&nbsp;</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">n</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>θ</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><msup><mi>cos</mi><mn>2</mn></msup><mi>θ</mi><msup><mi>sin</mi><mn>2</mn></msup><mi>θ</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></math></p><p>or&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>sin</mi><mn>2</mn><mi>θ</mi><mo>=</mo><msqrt><mfrac><mn>3</mn><mn>4</mn></mfrac></msqrt><mo>=</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>θ</mi><mo>=</mo><mn>30</mn><mo>°</mo></math></p>",
