    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>λ</mi></mrow><mrow><mn>2</mn><mi>d</mi></mrow></mfrac></mrow></mfenced></mrow></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>λ</mi></mrow><mrow><mn>3</mn><mi>d</mi></mrow></mfrac></mrow></mfenced></mrow></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>λ</mi></mrow><mrow><mn>4</mn><mi>d</mi></mrow></mfrac></mrow></mfenced></mrow></mrow></math>",
