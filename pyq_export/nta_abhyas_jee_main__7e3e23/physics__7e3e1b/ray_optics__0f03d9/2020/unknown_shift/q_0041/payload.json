  ],
  "solution": {
    "text": "For a compound microscope,<br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>=</mo><mfrac><mi>L</mi><msub><mi>f</mi><mn>0</mn></msub></mfrac><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mi>D</mi><msub><mi>f</mi><mi>e</mi></msub></mfrac></mrow></mfenced></math><br />(Where length of tube <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi><mo>=</mo><mn>30</mn><mo>&nbsp;</mo><mi>cm</mi></math>, focal length of objective lens <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mn>0</mn></msub><mo>=</mo><mn>1</mn><mi>&nbsp;</mi><mi>cm</mi></math>, focal length of eye-piece <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>f</mi><mi>e</mi></msub><mo>=</mo><mn>6</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi>cm</mi><mo>,</mo><mi>&nbsp;</mi><mi>D</mi><mo>=</mo><mn>25</mn><mi>&nbsp;</mi><mi>cm</mi></math>)<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>m</mi><mo>=</mo><mfrac><mn>30</mn><mn>1</mn></mfrac><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mfrac><mn>25</mn><mn>6</mn></mfrac></mrow></mfenced><mo>=</mo><mn>30</mn><mo>×</mo><mfrac><mfenced separators=\"|\"><mrow><mn>6</mn><mo>+</mo><mn>25</mn></mrow></mfenced><mn>6</mn></mfrac></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>m</mi><mo>=</mo><mn>5</mn><mo>×</mo><mn>31</mn></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>⇒</mo><mi>m</mi><mo>=</mo><mn>155</mn></math>"
  }
