  "question": {
    "text": "A ray of light is incident at the glass-water interface at an angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">i</mi></math>. If it finally&nbsp;emerges&nbsp;parallel to the surface of the water, then the value of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">μ</mi><mtext>g</mtext></msub></math>&nbsp;would be<br />\r&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/6721q.png\" style=\"width: 200px; height: 153px;\" />",
    "image": null
  },
