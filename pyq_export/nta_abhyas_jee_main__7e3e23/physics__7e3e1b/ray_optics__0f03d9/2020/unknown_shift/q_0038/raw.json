    "text": "From lens maker’s formula,<br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mi>f</mi></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">μ</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">R</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced></math><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">μ</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">∞</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mi mathvariant=\"normal\">R</mi></mrow></mfenced></mrow></mfrac></mrow></mfenced><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">μ</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">R</mi></mrow></mfrac></math><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">μ</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mn>1</mn></mrow></mfenced><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mfenced separators=\"|\"><mrow><mo>-</mo><mi mathvariant=\"normal\">R</mi></mrow></mfenced></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">∞</mi></mrow></mfrac></mrow></mfenced><mo>=</mo><mo>-</mo><mfrac><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">μ</mi></m