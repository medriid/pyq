  "question": {
    "text": "<div>\r<p align=\"left\" style=\"text-align:left;\"><span style=\"color:black\">A ray of light is incident normally on one of the faces of a prism of apex angle&nbsp;<math> <mrow> <mn>30</mn><mo>°</mo> </mrow> </math>&nbsp;and refractive index&nbsp;<math> <mrow> <msqrt> <mn>2</mn> </msqrt> <mo>.</mo> </mrow> </math> </span><span>&nbsp;The angle of deviation of the ray is</span></p>\r</div>\r",
    "image": null
  },
  "options": [
    {
      "id": "KfPmG",
      "text": "<div><p align=\"left\" style=\"text-align:left;\"><span style=\"position:relative;top:0.0pt\">&nbsp;<math>  <mrow>   <mn>30</mn><mo>&deg;</mo>  </mrow> </math>  </span></p></div>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Bxiso",
      "text": "<div><p align=\"left\" style=\"text-align:left;\"><span style=\"position:relative;top:0.0pt\">&nbsp;<math>  <mrow>   <mn>45</mn><mo>&deg;</mo>  </mrow> </math>  </span></p></div>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NC3Rv",
      "text": "<div><p align=\"left\" style=\"text-align:left;\"><span style=\"position:relative;top:0.0pt\">&nbsp;<math> <mrow> <mn>15</mn><mo>°</mo> </mrow> </math> </span></p></div>",
