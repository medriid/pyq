    "text": "&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>PQ</mtext><mo>=</mo><mtext mathvariant=\"italic\">QR</mtext><mo>=</mo><mn>2</mn><mtext mathvariant=\"italic\">h</mtext><mo>&#160; &#160;&#160; &#8756; &#160;</mo><mo>&#8736;</mo><mi>i</mi><mo>=</mo><mn>4</mn><msup><mn>5</mn><mn>0</mn></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;&#8756;&#160;</mo><mtext>ST</mtext><mo>=</mo><mtext>RT,</mtext><mtext>&#160;</mtext><mtext mathvariant=\"italic\">h</mtext><mo>=</mo><mtext>KM</mtext><mo>=</mo><mtext>MN</mtext></math><br /><br />So,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>KS</mtext><mo>=</mo><msqrt><msup><mtext mathvariant=\"italic\">h</mtext><mn>2</mn></msup><mo>+</mo><msup><mfenced><mrow><mn>2</mn><mtext mathvariant=\"italic\">h</mtext></mrow></mfenced><mn>2</mn></msup></msqrt></math><br /><br />&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mtext mathvariant=\"italic\">h</mtext><msqrt><mn>5</mn></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;&#8756; &#160;</mo><mtext>sin&#160;</mtext><mtext mathvariant=\"italic\">r</mtext><mo>=</mo><mfrac><mtext mathvariant=\"italic\">h</mtext><mrow><mtext mathvariant=\"italic\">h</mtext><msqrt><mn>5</mn></msqrt></mrow></mfrac></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math><mrow> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msqrt> <mn>5</mn> </msqrt> </mrow> </mfrac> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0006708_AnsExp1_1.jpg\" style=\"width: 231px; height: 330px;\" /><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#160;&#8756; &#160;</mo><mi>&#956;</mi><mo>=</mo><mfrac><m