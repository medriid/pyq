    "text": "<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0006981_AnsExp3_1.jpg\" style=\"height: 143px; width: 250px;\" /><br /><br />According to the thin lens formula<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math> <mrow> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>f</mi><mo>⁡</mo> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>v</mi><mo>⁡</mo> </mrow> </mfrac> <mo>-</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>u</mi><mo>⁡</mo> </mrow> </mfrac> </mrow> </math><br /><br />Here, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">u</mi><mo>&nbsp;</mo><mo>=</mo><mo>&nbsp;</mo><mo>-</mo><mn>2</mn><mo>.</mo><mn>4</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi><mo>&nbsp;</mo><mo>=</mo><mo>&nbsp;</mo><mo>-</mo><mo>&nbsp;</mo><mn>240</mn><mo>&nbsp;</mo><mi>cm</mi><mo>,</mo><mo>&nbsp;</mo><mi mathvariant=\"normal\">v</mi><mo>&nbsp;</mo><mo>=</mo><mo>&nbsp;</mo><mn>12</mn><mo>&nbsp;</mo><mi>cm</mi></math><br /><br /><math> <mrow> <mo>∴</mo> </mrow> </math>&nbsp; <math> <mrow> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>f</mi><mo>⁡</mo> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mn>1</mn> <mn>2</mn> </mrow> </mfrac> <mo>-</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mo>-</mo> <mn>2</mn> <mn>4</mn> <mn>0</mn> </mrow> </mfenced> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mn>1</mn> <mn>2</mn> </mrow> </mfrac> <mo>+</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mn>2</mn> <mn>4</mn> <mn>0</mn> </mrow> </mfrac> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mi>f</mi><mo>⁡</mo></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mn>1</mn></mrow><mrow><mn>2</mn><mn>4</mn><mn>0</mn></mrow></mfrac><mtext>&nbsp;or&nbsp;</mtext><mi>f</mi><mo>⁡</mo><mo>=</mo><mfrac><mrow><mn>2</mn><mn>4</mn><mn>0</mn></mrow><mrow><mn>2</mn><mn>1</mn></mrow></mfrac><mo>&nbsp;</mo><mtext>cm</mtext></math><br /><br />When a glass plate is interposed between lens and film, so shift produced by it will be<br /><br />Shift <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mtext>t&nbsp;</mtext><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mn>1</mn><mi>μ</mi></mfrac></mrow></mfenced><mo>=</mo><mn>1</mn><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mtext>.</mtext><mn>5</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mn>1</mn><mfenced><mrow><mn>1</mn><mo>-</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></mfenced><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>&nbsp;</mo><mtext>cm</mtext></math><br /><br />To get an image at the film, the lens should form an image at a distance<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><msup><mo>⁡</mo><mo>'</mo></msup><mo>=</mo><mn>1</mn><mn>2</mn><mo>-</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn><mn>5</mn></mrow><mn>3</mn></mfrac><mo>&nbsp;</mo><mtext>cm</mtext></math><br /><br />Again using lens formula<br /><br /><math> <mrow> <mo>∴</mo> </mrow> </math>&nbsp;&nbsp;<math> <mrow> <mfrac> <mrow> <mn>2</mn> <mn>1</mn> </mrow> <mrow> <mn>2</mn> <mn>4</mn> <mn>0</mn> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>3</mn> <mn>5</mn> </mrow> </mfrac> <mo>-</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msup> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>u</mi><mo>⁡</mo> </mrow> <mo>′</mo> </msup> </mrow> </mfrac> <mtext>&nbsp;or&nbsp;</mtext> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msup> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>u</mi><mo>⁡</mo> </mrow> <mo>′</mo> </msup> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>3</mn> <mn>5</mn> </mrow> </mfrac> <mo>-</mo> <mfrac> <mrow> <mn>2</mn> <mn>1</mn> </mrow> <mrow> <mn>2</mn> <mn>4</mn> <mn>0</mn> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mn>5</mn> </mrow> </mfrac> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>7</mn> </mrow> </mfrac> <mo>-</mo> <mfrac> <mrow> <mn>2</mn> <mn>1</mn> </mrow> <mrow> <mn>4</mn> <mn>8</mn> </mrow> </mfrac> </mrow> </mfenced> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math> <mrow> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msup> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>u</mi><mo>⁡</mo> </mrow> <mo>′</mo> </msup> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <mn>5</mn> </mrow> </mfrac> <mfenced close=\"]\" open=\"[\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>1</mn> <mn>4</mn> <mn>4</mn> <mo>-</mo> <mn>1</mn> <mn>4</mn> <mn>7</mn> </mrow> <mrow> <mn>3</mn> <mn>3</mn> <mn>6</mn> </mrow> </mfrac> </mrow> </mfenced> <mtext>&nbsp;or&nbsp;</mtext> <mfrac> <mrow> <mn>1</mn> </mrow> <mrow> <msup> <mrow> <mi></mi><mi></mi><mi></mi><mi></mi><mi></mi><mi>u</mi><mo>⁡</mo> </mrow> <mo>′</mo> </msup> </mrow> </mfrac> <mo>=</mo> <mo>-</mo> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>1</mn> <mn>6</mn> <mn>8</mn> <mn>0</mn> </mrow> </mfrac> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi><msup><mo>⁡</mo><mo>'</mo></msup><mo>=</mo><mo>-</mo><mn>5</mn><mn>6</mn><mn>0&nbsp;</mn><mtext>cm</mtext><mo>=</mo><mo>-</mo><mn>5</mn><mtext>.</mtext><mn>6</mn><mo>&nbsp;</mo><mtext>m</mtext></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp; <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"|\" open=\"|\"><mrow><mi>u</mi><msup><mo>⁡</mo><mo>'</mo></msup></mrow></mfenced><mo>=</mo><mn>5</mn><mtext>.</mtext><mn>6</mn><mo>&nbsp;</mo><mtext>m</mtext></math>",
