  "question": {
    "text": "A linear object is placed along the axis of a mirror as shown in the figure. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">f</mi></math> is the focal length of the mirror, then the length of the image is<br />\r<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0093_2541b453fc8d.png\" />"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi mathvariant=\"normal\">f</mi></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
