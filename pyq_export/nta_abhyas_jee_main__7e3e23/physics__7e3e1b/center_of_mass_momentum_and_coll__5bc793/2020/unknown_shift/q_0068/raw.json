  "question": {
    "text": "<p>A ball is dropped from a height <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math> on a floor. The coefficient of restitution for the collision between the ball and the floor is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>e</mi></math>. The total distance covered by the ball before it comes to the rest.</p>\r",
    "image": null
  },
  "options": [
    {
      "id": "69Vm1",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mn>2</mn><msup><mi>e</mi><mn>2</mn></msup></mrow></mfenced></math>",
      "image": null,
      "isCorrect": false
