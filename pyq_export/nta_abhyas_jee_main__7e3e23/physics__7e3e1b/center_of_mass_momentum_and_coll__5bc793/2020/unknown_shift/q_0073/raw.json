    },
    {
      "id": "1JP4B",
      "text": "<math> <mrow> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> <mi>g</mi> <mtext>,</mtext> </mrow> </math> downwards",
