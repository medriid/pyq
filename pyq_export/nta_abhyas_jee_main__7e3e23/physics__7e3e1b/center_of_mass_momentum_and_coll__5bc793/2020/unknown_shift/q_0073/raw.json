  "question": {
    "text": "Two blocks&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math> of equal mass are released on two sides of a fixed wedge&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi></math> as shown in the figure. Find the acceleration of the centre of mass of blocks&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">B</mi></math>. Neglect friction.<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/jeephys.JPG\" style=\"width: 200px; height: 139px;\" />",
    "image": null
  },
  "options": [
    {
      "id": "ea8nE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>g</mi><mn>2</mn></mfrac></math>, downwards",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "V4pWz",
