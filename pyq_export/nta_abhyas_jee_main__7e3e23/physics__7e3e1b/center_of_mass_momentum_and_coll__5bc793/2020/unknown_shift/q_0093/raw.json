  "question": {
    "text": "A neutron collides elastically with the stationary nucleus of an atom of mass number <math><mi>A</mi></math>.&nbsp;If the collision is perfectly elastic, then after the collision the fraction of the initial kinetic energy retained by the neutron, is",
    "image": null
  },
  "options": [
    {
      "id": "SACIE",
      "text": "<math><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn><mo>-</mo><mi>A</mi></mrow><mrow><mi>A</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "8uPkR",
      "text": "<math><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>A</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>A</mi><mo>-</mo><mn>1</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math>",
