    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msubsup><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">L</mi></msubsup><mrow><mo stretchy=\"true\">(</mo><msup><mi>ax</mi><mn>2</mn></msup><mo>+</mo><mi>bx</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mo stretchy=\"true\">)</mo></mrow><mtext>x dx</mtext></mrow><mrow><msubsup><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">L</mi></msubsup><mrow><mo stretchy=\"true\">(</mo><msup><mi>ax</mi><mn>2</mn></msup><mo>+</mo><mi>bx</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mo stretchy=\"true\">)</mo></mrow><mtext>dx</mtext></mrow></mfrac></math></p>&nbsp;<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msubsup><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">L</mi></msubsup><mrow><mo stretchy=\"true\">(</mo><msup><mi>ax</mi><mn>3</mn></msup><mo>+</mo><msup><mi>bx</mi><mn>2</mn></msup><mo>+</mo><mi>cx</mi><mo stretchy=\"true\">)</mo></mrow><mtext>dx</mtext></mrow><mrow><msubsup><mo>&#8747;</mo><mn>0</mn><mi mathvariant=\"normal\">L</mi></msubsup><mrow><mo stretchy=\"true\">(</mo><msup><mi>ax</mi><mn>2</mn></msup><mo>+</mo><mi>bx</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi><mo stretchy=\"true\">)</mo></mrow><mtext>dx</mtext></mrow></mfrac></math></p><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><msubsup><mfenced open=\"\" close=\"|\" separators=\"|\"><mrow><mfrac><msup><mi>ax</mi><mn>4</mn></msup><mn>4</mn></mfrac><mo>+</mo><mfrac><msup><mi>bx</mi><mn>3</mn></msup><mn>3</mn></mfrac><mo>+</mo><mfrac><msup><mi>cx</mi><mn>2</mn></msup><mn>2</mn></mfrac></mrow></mfenced><mn>0</mn><mi mathvariant=\"normal\">L</mi></msubsup><msubsup><mfenced open=\"\" close=\"|\" separators=\"|\"><mrow><mfrac><msup><mi>ax</mi><mn>3</mn></msup><mn>3</mn></mfrac><mo>+</mo><mfrac><msup><mi>bx</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>+</mo><mi>cx</mi></mrow></mfenced><mn>0</mn><mi mathvariant=\"normal\">L</mi></msubsup></mfrac></math><br /><br /><math