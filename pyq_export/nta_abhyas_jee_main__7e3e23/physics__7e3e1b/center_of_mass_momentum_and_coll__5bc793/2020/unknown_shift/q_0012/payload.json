    "text": "<img alt=\"Picture 73\" src=\"assets\\st0012_bd04fd043f60.png\" style=\"max-width:100%; object-fit:contain\" style=\"width: 248px; height: 126px;\" /><br />Let velocity of third fragment be <math><munder><mrow><mo>&#8594;</mo></mrow><mrow><mi>V</mi></mrow></munder></math><br /><math><mover><mrow><msub><mrow><mi>P</mi></mrow><mrow><mi>i</mi></mrow></msub></mrow><mrow><mo>&#8594;</mo></mrow></mover><mo>=</mo><mover><mrow><msub><mrow><mi>P</mi></mrow><mrow><mi>f</mi></mrow></msub></mrow><mrow><mo>&#8594;</mo></mrow></mover></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mn>3</mn><mi>m</mi><mfrac><msub><mi>v</mi><mn>0</mn></msub><mn>2</mn></mfrac><mover><mi>i</mi><mo>^</mo></mover><mo>=</mo><mo>&#8722;</mo><mi>m</mi><mfrac><msub><mi>v</mi><mn>0</mn></msub><mn>2</mn></mfrac><mover><mi>i</mi><mo>^</mo></mover><mo>+</mo><mi>m</mi><mfrac><mrow><mn>3</mn><msub><mi>v</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac><mover><mi>j</mi><mo>^</mo></mover><mo>+</mo><mi>m</mi><mover><mi>v</mi><mo>&#8594;</mo></mover></math><br /><math> <mrow> <mover accent=\"true\"> <mi>v</mi> <mo>&#8594;</mo> </mover> <mo>=</mo><mn>4</mn><mfrac> <mrow> <msub> <mi>v</mi> <mn>0</mn> </msub> </mrow> <mn>2</mn> </mfrac> <mover accent=\"true\"> <mi>i</mi> <mo>^</mo> </mover> <mo>&#8722;</mo><mfrac> <mrow> <mn>3</mn><msub> <mi>v</mi> <mn>0</mn> </msub> </mrow> <mn>2</mn> </mfrac> <mover accent=\"true\"> <mi>j</mi> <mo>^</mo> </mover> </mrow> </math><br /><math><mo>&#8658;</mo><mi>v</mi><mo>=</mo><mfrac><mrow><mn>5</mn><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>2</mn></mrow></mfrac></math>&nbsp;"
