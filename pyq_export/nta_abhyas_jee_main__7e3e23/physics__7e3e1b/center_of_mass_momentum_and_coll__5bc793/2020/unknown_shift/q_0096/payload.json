  ],
  "solution": {
    "text": "<math><mn>3</mn><msub><mrow><mi>m</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>v</mi><mo>=</mo><msub><mrow><mi>m</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>v</mi><mo>+</mo><msub><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>v</mi></math><br /><br /><math><mn>3</mn><msub><mrow><mi>m</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>v</mi><mo>-</mo><msub><mrow><mi>m</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>v</mi><mo>=</mo><msub><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>v</mi></math><br /><br /><math><mn>2</mn><msub><mrow><mi>m</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>v</mi><mo>=</mo><msub><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>v</mi></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mfrac><mrow><msub><mrow><mi>m</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>m</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mn>2</mn></math>"
