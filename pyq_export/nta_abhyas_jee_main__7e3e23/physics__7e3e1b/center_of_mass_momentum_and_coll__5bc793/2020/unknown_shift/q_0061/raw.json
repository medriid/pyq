  "question": {
    "text": "<p>Two identical spheres, each of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math>&nbsp;are suspended by vertical strings such&nbsp;that they are in contact with&nbsp;their centres at the same level. A third identical&nbsp;sphere strikes the other two spheres&nbsp;simultaneously with a velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi></math>&nbsp;such that&nbsp;the centres of the spheres at the instant of impact form an equilateral triangle in a vertical plane. If the collision is perfectly elastic, then the combined impulse due to the strings is<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0013872_Ques1_1.jpg\" style=\"width: 200px; height: 208px;\" /></p>\r",
    "image": null
  },
  "options": [
    {
      "id": "PntFP",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>12</mn><mn>7</mn></mfrac><mi>m</mi><mi>u</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "YhL8x",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>6</mn><mn>7</mn></mfrac><mi>m</mi><mi>u</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zWMNJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msqrt><mn>3</mn></msqrt></mrow><mn>7</mn></mfrac><mi>m</mi><mi>u</mi></math>",
      "image": null,
