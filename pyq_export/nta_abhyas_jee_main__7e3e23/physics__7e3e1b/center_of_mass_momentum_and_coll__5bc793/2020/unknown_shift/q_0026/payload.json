    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mrow><mi>m</mi><msup><mi>g</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mi>k</mi></mrow></mfrac></msqrt></math>",
