  "question": {
    "text": "Three identical balls are connected by light inextensible strings with each other as shown and placed over a smooth horizontal table. Length of each string is <math><mi>l</mi></math> .<br />\rAt moment <math><mi>t</mi><mo>=</mo><mn>0</mn></math> , ball B is imparted a velocity <math><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></math> perpendicular to the string and then the system is left on its own. The speed of A at the instant just before it collides with C is\r\r<p>&nbsp;</p>\r<img alt=\"\" height=\"68\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/ci/image33-312648e4-2e80-44d9-8dfc-3d5cf6d9648b.jpg\" style=\"max-width:100%; object-fit:contain\" width=\"152\" />",
    "image": null
  },
  "options": [
    {
      "id": "9wL7V",
      "text": "<math><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Zjla3",
      "text": "<math><mfrac><mrow><mn>2</mn><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>3</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "rPdca",
      "text": "<math><mfrac><mrow><mn>2</mn><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>5</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FHeV3",
      "text": "<math><mfrac><mrow><mn>2</mn><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>9</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    }
