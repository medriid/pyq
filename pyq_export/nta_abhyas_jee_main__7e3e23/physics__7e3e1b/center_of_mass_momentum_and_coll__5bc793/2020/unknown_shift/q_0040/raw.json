      "image": null,
      "isCorrect": false
    },
    {
      "id": "AhKHA",
      "text": "Coefficient of restitution between two blocks is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac bevelled=\"true\"><mn>1</mn><mn>3</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "K2wKv",
      "text": "Coefficient of restitution between two blocks is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac bevelled=\"true\"><mn>1</mn><mn>4</mn></mfrac></math>",
