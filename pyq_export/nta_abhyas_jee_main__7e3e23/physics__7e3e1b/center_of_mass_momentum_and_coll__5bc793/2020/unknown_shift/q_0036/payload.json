    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2.5</mn><mo>&#xA0;</mo><mi mathvariant=\"normal\">m</mi><mo>&#xA0;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
