  "question": {
    "text": "The moment of inertia of a rigid body in terms of its angular momentum <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>L</mi></math> and kinetic energy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>K</mi></math>&nbsp;is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><msup><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>K</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><msup><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mn>2</mn><mi>K</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mi>L</mi></mrow><mrow><msup><mrow><mn>2</mn><mi>K</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>",
      "is_correct": false
