    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#969;</mi><mo>=</mo><mn>2100</mn><mo>&#215;</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi></mrow><mn>60</mn></mfrac><mo>=</mo><mn>70</mn><mi mathvariant=\"normal\">&#960;</mi><mo>&#160;</mo><mi>rad</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>P</mi><mo>=</mo><mi>&#964;</mi><mi>&#969;</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#964;</mi><mo>=</mo><mfrac><mi mathvariant=\"italic\">P</mi><mi mathvariant=\"italic\">&#969;</mi></mfrac><mo>=</mo><mfrac><mrow><mn>220</mn><mo>&#215;</mo><mn>7</mn></mrow><mrow><mn>70</mn><mo>&#215;</mo><mn>22</mn></mrow></mfrac><mo>=</mo><mn>1</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>"
