      "text": "<math><mrow>  <mfrac>    <mrow>      <mn>4</mn>    </mrow>    <mrow>      <mn>7</mn>    </mrow>  </mfrac>  <mfrac>    <mrow>      <mtext>r</mtext>      <msub>              <mtext>&omega;</mtext>            <mn>0</mn>      </msub>    </mrow>    <mrow>      <mtext>&mu;</mtext>      <mtext>g</mtext>    </mrow>  </mfrac></mrow></math>",
