      "text": "<math><mrow>  <mfrac>    <mrow>      <mtext>r</mtext>      <msub>              <mtext>&omega;</mtext>            <mn>0</mn>      </msub>    </mrow>    <mrow>      <mtext>&mu;</mtext>      <mtext>g</mtext>    </mrow>  </mfrac></mrow></math>",
