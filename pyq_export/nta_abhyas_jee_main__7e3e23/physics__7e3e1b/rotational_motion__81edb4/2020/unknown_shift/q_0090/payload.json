  "question": {
    "text": "When a ceiling fan is switched off, its angular velocity falls to half while it makes&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>36</mn></math> rotations. How many rotations will it make before coming to rest?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>24</mn></math>",
      "is_correct": false
    },
