  "question": {
    "text": "A pendulum is oscillating with an angular amplitude of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>90</mn><mo>°</mo></math> as shown in the figure. The value of angle&nbsp;<math><mi mathvariant=\"normal\">α</mi></math>, made by the string with the vertical, at which the acceleration is directed horizontally is<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0003_9fa79d5a46b4.jpg\" style=\"width: 150px; height: 162px;\" />"
  },
  "options": [
    {
      "text": "0",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>90</mn><mo>&#176;</mo></math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></mrow></mfenced></mrow></mrow></math>",
      "is_correct": true
    },
    {
      "text": "<math><mrow><mrow><msup><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></mrow></mfenced></mrow></mrow></math>",
