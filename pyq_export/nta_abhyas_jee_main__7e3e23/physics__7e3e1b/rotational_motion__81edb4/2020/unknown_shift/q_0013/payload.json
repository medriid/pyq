      "text": "<math><mrow>  <mfenced open=\"(\" close=\")\" separators=\",\">    <mrow>      <mi>R</mi><mo>&ApplyFunction;</mo>      <msup>              <mi>&omega;</mi>            <mn>2</mn>      </msup>      <mo>+</mo>      <mtext>g</mtext>      <mspace width=\"0.5em\" />      <mtext>cot</mtext>      <mspace width=\"0.5em\" />      <mi>&theta;</mi>    </mrow>  </mfenced>  <mfrac>    <mrow>      <mi>m</mi><mo>&ApplyFunction;</mo>    </mrow>    <mrow>      <mn></mn>      <mi>&pi;</mi>    </mrow>  </mfrac></mrow></math>",
