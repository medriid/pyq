  "question": {
    "text": "<p>A chain of mass <math> <mi>m</mi> </math> forming a circle of radius <math> <mtext>R</mtext> </math> is slipped on a smooth round cone with half-angle <math> <mtext>θ</mtext> </math>. Find the tension in the chain if it rotates with a constant angular velocity <math> <mtext>ω</mtext> </math> about a vertical axis coinciding with the symmetry axis of the cone.</p>\r"
  },
  "options": [
    {
      "text": "<math> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mi></mi><mi></mi><mi></mi><mi>R</mi><mo>⁡</mo> <msup> <mi>ω</mi> <mn>2</mn> </msup> <mo>+</mo> <mtext>g</mtext> <mspace width=\"0.5em\"></mspace> <mtext>cot</mtext> <mspace width=\"0.5em\"></mspace> <mi>θ</mi> </mrow> </mfenced> <mfrac> <mrow> <mi>m</mi><mo>⁡</mo> </mrow> <mrow> <mn>2</mn> <mi>π</mi> </mrow> </mfrac> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math><mrow>  <mfenced open=\"(\" close=\")\" separators=\",\">    <mrow>      <mi>R</mi><mo>&ApplyFunction;</mo>      <msup>              <mi>&omega;</mi>            <mn>2</mn>      </msup>      <mo>-</mo>      <mtext>g</mtext>      <mspace width=\"0.5em\" />      <mtext>cot</mtext>      <mspace width=\"0.5em\" />      <mi>&theta;</mi>    </mrow>  </mfenced>  <mfrac>    <mrow>      <mi>m</mi><mo>&ApplyFunction;</mo>    </mrow>    <mrow>      <mn>2</mn>      <mi>&pi;</mi>    </mrow>  </mfrac></mrow></math>",
      "is_correct": false
    },
