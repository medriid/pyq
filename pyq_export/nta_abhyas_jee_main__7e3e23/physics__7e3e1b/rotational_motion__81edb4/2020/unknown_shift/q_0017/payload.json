    {
      "text": "<math><mfrac><mrow><mi>μ</mi><mi>m</mi><mi>g</mi></mrow><mrow><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>μ</mi><mi>m</mi><mi>g</mi></mrow><mrow><mn>4</mn></mrow></mfrac></math>",
