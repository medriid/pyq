  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mrow><mi>A</mi><mi>B</mi></mrow></msub><mo>=</mo><mo>∫</mo><msup><mi>y</mi><mn>2</mn></msup><mi>d</mi><mi>m</mi><mo>=</mo><mfrac><msub><mi>λ</mi><mn>0</mn></msub><msup><mi>ℓ</mi><mn>3</mn></msup></mfrac><msubsup><mo>∫</mo><mrow><mo>-</mo><mi>x</mi></mrow><mrow><mi>l</mi><mo>-</mo><mi>x</mi></mrow></msubsup><mo>(</mo><mi>y</mi><mo>+</mo><mi>x</mi><msup><mo>)</mo><mn>3</mn></msup><msup><mi>y</mi><mn>2</mn></msup><mi>d</mi><mi>y</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∫</mo><mo>(</mo><mi>y</mi><mo>+</mo><mi>x</mi><msup><mo>)</mo><mn>3</mn></msup><msup><mi>y</mi><mn>2</mn></msup><mi>d</mi><mi>y</mi><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup><mfrac><mrow><mo>(</mo><mi>y</mi><mo>+</mo><mi>x</mi><msup><mo>)</mo><mn>4</mn></msup></mrow><mn>4</mn></mfrac><mo>-</mo><mo>∫</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>y</mi><mo>(</mo><mi>y</mi><mo>+</mo><mi>x</mi><msup><mo>)</mo><mn>4</mn></msup><mi>d</mi><mi>y</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><msup><mi mathvariant=\"normal\">y</mi><mn>2</mn></msup><mo>(</mo><mi mathvariant=\"normal\">y</mi><mo>+</mo><mi mathvariant=\"normal\">x</mi><msup><mo>)</mo><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mo>-</mo><mfrac><mi mathvariant=\"normal\">y</mi><mn>10</mn></mfrac><mo>(</mo><mi mathvariant=\"normal\">y</mi><mo>+</mo><mi mathvariant=\"normal\">x</mi><msup><mo>)</mo><mn>5</mn></msup><mo>+</mo><mfrac><mn>1</mn><mn>10</mn></mfrac><mo>(</mo><mi mathvariant=\"normal\">y</mi><mo>+</mo><mi mathvariant=\"normal\">x</mi><msup><mo>)</mo><mn>5</mn></msup><mi>dy</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><msup><mi>y</mi><mn>2</mn></msup><mo>(</mo><mi>y</mi><mo>+</mo><mi>x</mi><msup><mo>)</mo><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mo>-</mo><mfrac><mrow><mi>y</mi><mo>(</mo><mi>y</mi><mo>+</mo><mi>x</mi><msup><mo>)</mo><mn>5</mn