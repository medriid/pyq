    "text": "<math><mi>I</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mi>M</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></math>  and  <math><mi mathvariant=\"normal\">ρ</mi><mo>=</mo><mfrac><mrow><mn>3</mn><mi>M</mi></mrow><mrow><mn>4</mn><mi>π</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></math> <br/><br/>For circular disc  <math><mi mathvariant=\"normal\">π</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>×</mo><mi>t</mi><mi mathvariant=\"normal\">ρ</mi><mo>=</mo><mi>M</mi><mo>⇒</mo><mfrac><mrow><mi>π</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>⋅</mo><mi>t</mi><mo>⋅</mo><mn>3</mn><mi>M</mi></mrow><mrow><mn>4</mn><mi>π</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mo>=</mo><mi>M</mi></math>  <br/><br/> <math><mo>⇒</mo><mi> </mi><mi> </mi><mi>t</mi><mo>=</mo><mfrac><mrow><mn>4</mn><mi>π</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>3</mn><mi>π</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>3</mn><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mi> </mi><mo>⇒</mo><mi> </mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>4</mn><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow><mrow><mn>3</mn><mi>t</mi></mrow></mfrac></math> <br/><br/> <math><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mi>M</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>M</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></math> <br/><br/> <math><mo>⇒</mo><mi mathvariant=\"normal\"> </mi><mfrac><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></mfrac><msup><mrow><mi>R</mi></mrow><mrow