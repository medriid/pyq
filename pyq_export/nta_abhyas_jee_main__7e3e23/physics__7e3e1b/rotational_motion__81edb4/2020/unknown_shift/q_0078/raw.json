      "text": "<math> <mrow> <mfrac> <mrow> <mn>2</mn> <mtext>g</mtext> </mrow> <mrow> <mn>3</mn> <mi>l</mi> </mrow> </mfrac> </mrow> </math>",
      "image": null,
