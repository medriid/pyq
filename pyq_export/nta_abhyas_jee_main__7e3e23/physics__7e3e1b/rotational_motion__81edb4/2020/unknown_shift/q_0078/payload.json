  "question": {
    "text": "A uniform rod&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>AB</mi></math> of length&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math> and mass&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> is free to rotate about point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math>. The rod is released from rest in the horizontal position. The initial angular acceleration of the rod will be<br />\r<img alt=\"\" src=\"assets\\qt0078_fb27011cc422.jpeg\" style=\"width: 200px; height: 132px;\" />"
  },
  "options": [
    {
      "text": "<math> <mrow> <mfrac> <mrow> <mn>2</mn> <mtext>g</mtext> </mrow> <mrow> <mn>3</mn> <mi>l</mi> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mtext>g</mtext> <mfrac> <mrow> <mi>l</mi> </mrow> <mrow> <mn>2</mn> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow>  <mfrac>    <mrow>      <mn>3</mn>    </mrow>    <mrow>      <mn>2</mn>    </mrow>  </mfrac>  <mtext>g</mtext><mi>l</mi></mrow></math>",
      "is_correct": false
