  "question": {
    "text": "<p>A uniform rod of length <math> <mi>L</mi> </math> is free to rotate in a vertical plane about a fixed horizontal axis through <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>. The rod begins rotating from rest from its unstable equilibrium position. When it has turned through an angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>θ</mi></math>,&nbsp;its angular velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">ω</mi></math>&nbsp;is given by</p>\r\r<p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/Image_1.jpg\" style=\"width: 157px; height: 169px;\" /></p>\r",
    "image": null
  },
