      "text": "<math> <mrow> <msqrt> <mrow> <mfrac> <mrow> <mn>6</mn><mi>g</mi></mrow> <mi>L</mi> </mfrac> </mrow> </msqrt> <mi>sin</mi><mfrac> <mtext>θ</mtext> <mn>2</mn> </mfrac> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow>  <msqrt>   <mrow>    <mfrac>     <mrow>      <mn>6</mn><mi>g</mi></mrow>     <mi>L</mi>    </mfrac>    </mrow>  </msqrt>  <mi>cos</mi><mfrac>   <mi>&#x03B8;</mi>   <mn>2</mn>  </mfrac>  </mrow></math>",
