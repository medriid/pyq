    },
    {
      "id": "gAzfJ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">x</mi><mo>=</mo><mfrac><mrow><mn>2</mn><mi>L</mi></mrow><mn>3</mn></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
