  "question": {
    "text": "In&nbsp;a new system of units, the unit of force is <math> <mrow> <mtext>100&nbsp;N</mtext></mrow></math>, unit of length is <math> <mrow> <mtext>10&nbsp;m</mtext></mrow> </math> and unit of time is <math> <mrow> <mtext>100&nbsp;s</mtext></mrow></math>. Unit of mass in this system can be expressed as"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"> <mrow> <msup> <mrow> <mn>10</mn></mrow> <mn>5</mn> </msup> <mtext>&nbsp;k</mtext><mtext>g</mtext></mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math  xmlns='http://www.w3.org/1998/Math/MathML'> <mrow>  <msup>   <mrow>    <mn>10</mn></mrow>   <mn>6</mn>  </msup>  <mtext>&nbsp;k</mtext><mtext>g</mtext></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math  xmlns='http://www.w3.org/1998/Math/MathML'> <mrow>  <msup>   <mrow>    <mn>10</mn></mrow>   <mn>2</mn>  </msup>  <mtext>&nbsp;k</mtext><mtext>g</mtext></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math  xmlns='http://www.w3.org/1998/Math/MathML'> <mrow>  <msup>   <mrow>    <mn>10</mn></mrow>   <mn>3</mn>  </msup>  <mtext>&nbsp;k</mtext><mtext>g</mtext></mrow></math>",
      "is_correct": false
