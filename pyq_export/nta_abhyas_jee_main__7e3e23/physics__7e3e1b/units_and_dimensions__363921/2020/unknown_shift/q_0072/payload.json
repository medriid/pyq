  "question": {
    "text": "If&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math> and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> denote electric and magnetic fields respectively, which of the following is dimensionless?"
  },
  "options": [
    {
      "text": "<math><msqrt><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>&nbsp;</mi><msub><mrow><mi>ε</mi></mrow><mrow><mn>0</mn></mrow></msub></msqrt><mfrac><mrow><mi>E</mi></mrow><mrow><mi>B</mi></mrow></mfrac></math>",
      "is_correct": true
