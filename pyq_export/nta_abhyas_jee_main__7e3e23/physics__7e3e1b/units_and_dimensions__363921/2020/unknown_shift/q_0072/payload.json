    {
      "text": "<math><msub><mrow><mi>μ</mi></mrow><mrow><mn>0</mn></mrow></msub><msub><mrow><mi>ε</mi></mrow><mrow><mn>0</mn></mrow></msub><mi> </mi><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mi>B</mi></mrow><mrow><mi>E</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math>",
