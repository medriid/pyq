  "question": {
    "text": "The lengths of sides of a cuboid are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">a</mi></math>,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi mathvariant=\"normal\">a</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi mathvariant=\"normal\">a</mi></math>. If the relative percentage error in the measurement of a is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>%</mo></math>, then what is the relative percentage error in the measurement of the volume of the cube.",
    "image": null
  },
  "options": [],
  "correctValue": "3",
