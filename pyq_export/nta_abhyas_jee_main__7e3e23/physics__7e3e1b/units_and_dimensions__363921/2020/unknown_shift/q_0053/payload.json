  "solution": {
    "text": "<math><mi>f</mi><mo>=</mo><mi>c</mi><mi>&#160;</mi><msup><mrow><mi>m</mi></mrow><mrow><mi>x</mi></mrow></msup><mi>&#160;</mi><msup><mrow><mi>k</mi></mrow><mrow><mi>y</mi></mrow></msup><mo>;</mo></math><br /><br />Spring constant <math><mi>k</mi><mo>=</mo><mi>&#160;</mi><mrow><mrow><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">e</mi></mrow><mo>/</mo><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">h</mi><mo>.</mo></mrow></mrow></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mn>0</mn></msup><mi mathvariant=\"normal\">&#160;</mi><msup><mi mathvariant=\"normal\">L</mi><mn>0</mn></msup><mi mathvariant=\"normal\">&#160;</mi><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></mrow></mfenced><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">x</mi></msup><msup><mfenced separators=\"|\"><msup><mi>MT</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mfenced><mi mathvariant=\"normal\">y</mi></msup></mrow></mfenced><mo>=</mo><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi mathvariant=\"normal\">M</mi><mrow><mi mathvariant=\"normal\">x</mi><mo>+</mo><mi mathvariant=\"normal\">y</mi></mrow></msup><mi mathvariant=\"normal\">&#160;</mi><msup><mi mathvariant=\"normal\">T</mi><mrow><mo>-</mo><mn>2</mn><mi mathvariant=\"normal\">y</mi></mrow></msup></mrow></mfenced></math><br /><br /><math><mo>&#8658;</mo></math> <math><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi>&#160;</mi><mo>-</mo><mn>2</mn><mi>y</mi><mo>=</mo><mi>&#160;</mi><mo>-</mo><mn>1</mn><mi>&#160;</mi></math> or <math><mi>y</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br />Therefore, <math><mi>x</mi><mo>=</mo><mi>&#160;</mi><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math>"
