  "question": {
    "text": "The velocity of water waves <math> <mi>v</mi> </math> may depend upon their wavelength <math> <mi>λ</mi> </math> , the density of water <math> <mi>ρ</mi> </math> and the acceleration due to gravity <math> <mi>g</mi> </math> . The method of dimensions gives the relation between these quantities as",
    "image": null
  },
  "options": [
    {
      "id": "qcG5G",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>v</mi><mn>2</mn></msup><mo>&#8733;</mo><mi>&#961;</mi><mi>g</mi></math>",
