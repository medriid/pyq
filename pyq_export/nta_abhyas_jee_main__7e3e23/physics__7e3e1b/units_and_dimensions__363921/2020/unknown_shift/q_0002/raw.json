      "text": " <math> <mrow> <msup> <mi>v</mi> <mn>2</mn> </msup> <mo>∝</mo><mi>g</mi><mi>λ</mi></mrow>  </math> ",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UrmPD",
      "text": " <math> <mrow> <msup> <mi>v</mi> <mn>2</mn> </msup> <mo>∝</mo><msup> <mi>g</mi> <mrow> <mo>−</mo><mn>1</mn></mrow> </msup> <msup> <mi>λ</mi> <mrow> <mo>−</mo><mn>3</mn></mrow> </msup> </mrow>  </math> ",
