  "question": {
    "text": "If <math><mi>x</mi><mo>,</mo><mi>&nbsp;</mi><mi>v</mi></math> and <math><mi>a</mi></math> denote the displacement, the velocity and the acceleration of a particle executing simple harmonic motion of time period <math><mi>T</mi></math> , then which of the following do not change with time?",
    "image": null
  },
  "options": [
    {
      "id": "NCgeN",
      "text": "<math><mfrac><mrow><mi>a</mi><mi>T</mi></mrow><mrow><mi>v</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "N3RQw",
      "text": "<math><mi>a</mi><mi>T</mi><mo>+</mo><mn>2</mn><mi>π</mi><mi>v</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Imped",
      "text": "<math><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></math>",
      "image": null,
