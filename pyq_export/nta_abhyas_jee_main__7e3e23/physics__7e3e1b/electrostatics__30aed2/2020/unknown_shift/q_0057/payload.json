  "solution": {
    "text": "&nbsp; &nbsp; (<math><mo>-</mo><mn>10</mn><mo>&#176;</mo><mi mathvariant=\"normal\">C</mi></math> ice)&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;(<math><mn>0</mn><mo>&#176;</mo><mi mathvariant=\"normal\">C</mi></math> water)<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">q</mi><mn>1</mn></msub><mfrac><mrow><mtext>&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;</mtext><msub><mi mathvariant=\"normal\">k</mi><mn>1</mn></msub><mtext>&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;</mtext></mrow><mrow><msub><mi mathvariant=\"normal\">r</mi><mn>1</mn></msub><mo>=</mo><mn>25</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">m</mi></mrow></mfrac><msub><mi mathvariant=\"normal\">q</mi><mn>2</mn></msub></math>&nbsp; &nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8201;&#8201;&#8201;</mo><msub><mi mathvariant=\"normal\">q</mi><mn>1</mn></msub><mfrac><mrow><mtext>&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;</mtext><msub><mi mathvariant=\"normal\">k</mi><mn>2</mn></msub><mo>=</mo><mn>80</mn><mtext>&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;&#8201;</mtext></mrow><mrow><msub><mi mathvariant=\"normal\">r</mi><mn>2</mn></msub><mo>=</mo><mn>5</mn><mi>cm</mi></mrow></mfrac><msub><mi mathvariant=\"normal\">q</mi><mn>2</mn></msub></math><br /><br />Given <math><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">e</mi></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">r</mi></mrow></msub></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><msub><mrow><mte