    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac><msup><mtext mathvariant=\"italic\">CV</mtext><mn>2</mn></msup></math>",
