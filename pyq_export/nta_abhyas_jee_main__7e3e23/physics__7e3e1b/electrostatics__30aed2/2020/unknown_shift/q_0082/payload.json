    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mfenced><mrow><mi>K</mi><mo>-</mo><mn>1</mn></mrow></mfenced><mi>V</mi></mrow><mi>K</mi></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>V</mi></mrow><mrow><mi>K</mi><mfenced separators=\"|\"><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></mfenced></mrow></mfrac></math>",
