C</mi></math> as a function of <math><mi mathvariant=\"normal\">h</mi></math><br /><br /><br /><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/ci/image55-43fc1c2f-5e98-4460-9355-2a188cb474d6.jpg\" /><br /><br /><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">q</mi></mrow></msub><mi mathvariant=\"normal\">&#160;</mi><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">r</mi></mrow></msub><mi mathvariant=\"normal\">&#160;</mi><mo>+</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mi mathvariant=\"normal\">K</mi></mrow></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi><msub><mi mathvariant=\"normal\">&#949;</mi><mn>0</mn></msub><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">L</mi><mo>-</mo><mi mathvariant=\"normal\">h</mi></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mfenced><mfrac><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">a</mi></mfrac></mfenced></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">&#960;</mi><msub><mi mathvariant=\"normal\">&#949;</mi><mn>0</mn></msub><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">h</mi></mrow><mrow><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">n</mi><mfenced><mfrac><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">a</mi></mfrac></mfenced></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">&#160;</mi><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mn>2</mn><mi mathva