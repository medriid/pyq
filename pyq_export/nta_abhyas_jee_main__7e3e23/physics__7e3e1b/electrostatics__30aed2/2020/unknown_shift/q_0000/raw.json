  "question": {
    "text": "A point charge <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">q</mi></math> is kept inside an uncharged conducting spherical shell. The radius of the shell is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi></math> and the charge is kept inside the shell at a distance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">x</mi></math> from the centre. Identify the correct statement.<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/26554_sol_new12.png\" style=\"width: 180px; height: 161px;\" />",
    "image": null
  },
  "options": [
    {
      "id": "NTToL",
      "text": "Net force acting on the shell is zero",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BGHgy",
      "text": "Net force on the shell is towards right side",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BFYjp",
      "text": "Net force on the shell is towards left side",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "e1nCu",
      "text": "Nothing can be said about the net direction of the net force on the shell.",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/26554_sol_new.PNG\" style=\"width: 173px; height: 155px;\" /><br />Charge induced near the surface closer to the charged particle will be more and hence sphere will be attracted to the charge <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">q</mi></math>. Hence net force is towards left.",
    "image": null
  },
