  "question": {
    "text": "A non-conducting disc of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>&nbsp;is uniformly charged with surface charge density <math><mi>σ</mi></math>. A disc of radius <math><mfrac><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math> is cut from the disc, as shown in the figure. The electric potential at centre&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi></math>&nbsp;of large disc will be<br />\r<br />\r<img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/337b4f18-65ad-499b-b7dd-dabf39a000fe-image2.jpeg\" style=\"height: 140px; width: 140px;\" />",
    "image": null
  },
  "options": [
    {
