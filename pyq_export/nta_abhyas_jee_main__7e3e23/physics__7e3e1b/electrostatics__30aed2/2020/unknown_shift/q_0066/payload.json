  "question": {
    "text": "A non-conducting disc of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>&nbsp;is uniformly charged with surface charge density <math><mi>σ</mi></math>. A disc of radius <math><mfrac><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math> is cut from the disc, as shown in the figure. The electric potential at centre&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">C</mi></math>&nbsp;of large disc will be<br />\r<br />\r<img src=\"assets\\qt0066_a9ff4f0138f6.jpeg\" style=\"height: 140px; width: 140px;\" />"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mi>π</mi><mi>σ</mi><mi>R</mi></mrow><mrow><mn>2</mn><msub><mrow><mi>ε</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
