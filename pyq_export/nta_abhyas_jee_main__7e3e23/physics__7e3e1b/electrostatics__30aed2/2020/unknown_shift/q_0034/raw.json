    },
    {
      "id": "MaHqb",
      "text": "<math><mfrac><mrow><msub><mrow><mi>Q</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>Q</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi>C</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "p2Wkr",
      "text": "<math><mfrac><mrow><msub><mrow><mi>Q</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>Q</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi>C</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0gSiw",
      "text": "<math><mfrac><mrow><msub><mrow><mi>Q</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>Q</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mn>2</mn><mi>C</mi></mrow></mfrac></math>",
