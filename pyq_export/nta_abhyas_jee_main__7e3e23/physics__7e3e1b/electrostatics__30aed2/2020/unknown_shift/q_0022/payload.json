  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><msub><mi>&#949;</mi><mn>0</mn></msub><mi>A</mi></mrow><mrow><mn>3</mn><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><mfrac><mi>d</mi><mn>2</mn></mfrac></mrow></mfrac><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mi>K</mi><mn>1</mn></msub><mo>=</mo><mn>2</mn><msub><mi>C</mi><mn>0</mn></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><mfrac><mrow><msub><mi>&#949;</mi><mn>0</mn></msub><mi>A</mi></mrow><mrow><mn>3</mn><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><mfrac><mi>d</mi><mn>2</mn></mfrac></mrow></mfrac><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mi>K</mi><mn>2</mn></msub><mo>=</mo><mn>4</mn><msub><mi>C</mi><mn>0</mn></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>3</mn></msub><mo>=</mo><mfrac><mrow><msub><mi>&#949;</mi><mn>0</mn></msub><mi>A</mi></mrow><mrow><mn>3</mn><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><mfrac><mi>d</mi><mn>2</mn></mfrac></mrow></mfrac><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mi>K</mi><mn>3</mn></msub><mo>=</mo><mn>6</mn><msub><mi>C</mi><mn>0</mn></msub></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mn>4</mn></msub><mo>=</mo><mfrac><mrow><msub><mi>&#949;</mi><mn>0</mn></msub><mi>A</mi></mrow><mfrac><mi>d</mi><mn>2</mn></mfrac></mfrac><mi mathvariant=\"normal\">&#160;</mi><mo>&#215;</mo><mi mathvariant=\"normal\">&#160;</mi><msub><mi>K</mi><mn>4</mn></msub><mo>=</mo><mn>4</mn><msub><mi>C</mi><mn>0</mn></msub></math><br /><br /><img alt=\"\" src=\"assets\\st0022_9ace463a86ce.jpg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 177px; height: 186px;\" />&nbsp; &nbsp; &nbsp; <img alt=\"\" src=\"assets\\st0022_44e84a946d35.png\" style=\"max-width:100%; object-fit:contain\" style=\"width: 205px; height: 205px;\" /><br /><br /><img alt=\"\" src=\"assets\\st0022_6f6d3c1f4ec8.png\" style=\"max-width:100%; object-fit:contain\" style=\"width: 240px; height: 205px;\" /><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>C</mi><mrow><mi>e</mi><mi>q</mi></mrow></msub><mo>=</mo><mfrac><mn>159</mn><mn>55</mn></mfrac><msub><mi>C</mi><mn>0</mn></msub><mo>=</mo><mfrac><mrow><mn>159</mn><mtext>&#8201;</mtext><mi>A</mi><msub><mi>&#949;</mi><mn>0</mn></msub></mrow><mrow><mn>55</mn><mi>d</mi></mrow></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>+</mo><mi>n</mi><mo>=</mo><mn>159</mn><mo>+</mo><mn>55</mn><mo>=</mo><mn>214</mn></math></p>"
