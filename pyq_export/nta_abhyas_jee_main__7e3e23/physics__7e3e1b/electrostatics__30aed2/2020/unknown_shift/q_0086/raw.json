    "text": "<math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mi mathvariant=\"normal\"> </mi><mo>=</mo><mi mathvariant=\"normal\"> </mi><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi mathvariant=\"normal\"> </mi><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></mrow></mfenced><mi mathvariant=\"normal\"> </mi><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\"> </mi><mo>–</mo><mi mathvariant=\"normal\"> </mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br/><br/> <math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mi mathvariant=\"normal\"> </mi><mo>=</mo><mi mathvariant=\"normal\"> </mi><mn>0</mn></math>, If <math><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>1</mn></mrow></msub><mi mathvariant=\"normal\"> </mi><mo>=</mo><mi mathvariant=\"normal\"> </mi><msub><mrow><mi mathvariant=\"normal\">V</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br/><br/> or <math><mfrac><mrow><mi mathvariant=\"normal\">k</mi><msub><mrow><mi mathvariant=\"normal\">q</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">R</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi mathvariant=\"normal\"> </mi><mo>=</mo><mi mathvariant=\"normal\"> </mi><mfrac><mrow><mi mathvariant=\"normal\">k</mi><msub><mrow><mi mathvariant=\"normal\">q</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"