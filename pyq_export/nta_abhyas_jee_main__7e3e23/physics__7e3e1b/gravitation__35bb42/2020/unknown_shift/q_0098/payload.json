  "question": {
    "text": "If a satellite is revolving around a planet of mass <math><mi>M</mi></math> in an elliptical orbit of semi-major axis <math><mi>a</mi></math>, find the orbital speed of the satellite when it is at a distance <math><mi>r</mi></math> from the focus"
  },
  "options": [
    {
      "text": "<math><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mi>G</mi><mi>M</mi><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mn>2</mn></mrow><mrow><mi>r</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>a</mi></mrow></mfrac></mrow></mfenced></math>",
      "is_correct": true
