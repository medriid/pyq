      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><msqrt><mn>3</mn></msqrt></mfrac><mo>&#xA0;</mo><mi mathvariant=\"normal\">s</mi></math>",
