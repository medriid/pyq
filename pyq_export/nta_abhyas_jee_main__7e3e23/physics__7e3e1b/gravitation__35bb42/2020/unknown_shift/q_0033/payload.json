    },
    {
      "text": "<math><mn>2</mn><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><mi>m</mi></mrow><mrow><mn>3</mn><mi>a</mi></mrow></mfrac></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math><msqrt><mfrac><mrow><mn>6</mn><mi>G</mi><mi>m</mi></mrow><mrow><mi>a</mi></mrow></mfrac></msqrt></math>",
