  "question": {
    "text": "Two particles of masses <math><mi>m</mi></math> and <math><mn>2</mn><mi>m</mi></math> are kept at a distance <math><mi>a</mi><mo>.</mo></math> Find the speed of particles and their relative velocity of approach when separation becomes <math><mrow><mrow><mi>a</mi></mrow><mo>/</mo><mrow><mn>2</mn></mrow></mrow><mo>.</mo></math>"
  },
  "options": [
    {
