  "solution": {
    "text": "By Kepler&#39;s third law <math><msup><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>&#8733;</mo><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></math> or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msup><mi>T</mi><mn>2</mn></msup><msup><mi>R</mi><mn>3</mn></msup></mfrac><mo>=</mo><mi>constant</mi></math><br /><br /><math><mo>&#8756;</mo></math> <math><mfrac><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>=</mo><mfrac><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac></math><br /><br /><math><mo>&#8756;</mo></math> <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>64</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac></math><br /><br /><math><mo>&#8756;</mo></math> <math><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></math><br /><br /><math><mo>&#8756;</mo></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>2</mn></msub><mo>=</mo><mn>4</mn><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mn>4</mn><mo>&#215;</mo><msup><mn>10</mn><mn>4</mn></msup><mo>&#160;</mo><mi>km</mi></math><br /><br />Distance travelled by A in one revolution is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>S</mi><mn>1</mn></msub><mo>=</mo><mn>2</mn><mi>&#960;</mi><msub><mi>R</mi><mn>1</mn></msub><mo>=</mo><mn>2</mn><mi>&#960;</mi><mo>&#215;</mo><msup><mn>10</mn><mn>4</mn></msup><mo>&#160;</mo><mi>km</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi>v</mi><mn>1</mn></msub><mo>=</mo><mfrac><msub><mi>S</mi><mn>1</mn></msub><msub><mi>T</mi><mn>1</mn></msub></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#960;</mi><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mn>4</mn></msup></mrow><mn>1</mn></mfrac><mo>=</mo><mn>2</mn><mi>&#960;</mi><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mn>4</mn></msup><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">h</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><br /><math><mo>&#8756;</mo></math> Similarly, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mn>2</mn></msub><mo>=</mo><mfrac><msub><mi>S</mi><mn>2</mn></msub><msub><mi>T</mi><mn>2</mn></msub></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mi>&#960;</mi><mo>&#215;</mo><mn>4</mn><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mn>4</mn></msup></mrow><mn>8</mn></mfrac><mo>=</mo><mi>&#960;</mi><mo>&#215;</mo><mn>1</mn><msup><mn>0</mn><mn>4</mn></msup><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">h</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>V</mi><mn>12</mn></msub><mo>=</mo><msub><mi>V</mi><mn>1</mn></msub><mo>&#8722;</mo><msub><mi>V</mi><mn>2</mn></msub><mo>=</mo><mi>&#960;</mi><mo>&#215;</mo><msup><mn>10</mn><mn>4</mn></msup><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">h</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>"
