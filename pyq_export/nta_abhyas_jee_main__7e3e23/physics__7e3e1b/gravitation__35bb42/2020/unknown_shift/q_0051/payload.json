  "question": {
    "text": "A body hanging from a massless spring stretches it by <math><mn>3</mn><mi>&nbsp;</mi><mi>cm</mi></math> on earth's surface. At a place <math><mn>800</mn><mi>&nbsp;</mi><mi>km</mi></math> above the earth's surface, the same body will stretch the spring by (Radius of Earth <math><mo>=</mo><mn>6400</mn><mi>&nbsp;</mi><mi>km</mi></math>)"
  },
  "options": [
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>34</mn></mrow><mrow><mn>27</mn></mrow></mfrac></mrow></mfenced><mi>&nbsp;cm</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>64</mn></mrow><mrow><mn>27</mn></mrow></mfrac></mrow></mfenced><mi>&nbsp;cm</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>27</mn></mrow><mrow><mn>64</mn></mrow></mfrac></mrow></mfenced><mi>&nbsp;cm</mi></math>",
