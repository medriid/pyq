  "solution": {
    "text": "<math><mi>g</mi><mo>=</mo><mfrac><mrow><mi>G</mi><mi>M</mi></mrow><mrow><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>G</mi></mrow><mrow><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mfrac><mrow><mn>4</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mi>&#960;</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup><mi>&#961;</mi><mo>=</mo><mfrac><mrow><mn>4</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mi>&#960;</mi><mi>G</mi><mi>R</mi><mi>&#961;</mi></math> i.e. <math><mi>g</mi><mo>&#8733;</mo><mi>R</mi><mi>&#961;</mi></math><br /><br /><math><mfrac><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mn>6</mn></msqrt><msub><mrow><mi>g</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow><mrow><mn>11</mn><msub><mrow><mi>g</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mn>6</mn></msqrt></mrow><mrow><mn>11</mn></mrow></mfrac></math> and <math><mfrac><mrow><msub><mrow><mi>&#961;</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow><mrow><msub><mrow><mi>&#961;</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math> and <math><mfrac><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>P</mi></mrow></msub><msub><mrow><mi>&#961;</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>E</mi></mrow></msub><msub><mrow><mi>&#961;</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>&#8756;</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>P</mi></mrow></msub><msub><mrow><mi>&#961;</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>E</mi></mrow></msub><msub><mrow><mi>&#961;</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mn>6</mn></msqrt></mrow><mrow><mn>11</mn></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br /><math><mo>&#8756;</mo></math> Escape velocity <math><mi>v</mi><mo>=</mo><msqrt><mn>2</mn><mi>g</mi><mi>R</mi></msqrt></math><br /><br /><math><mo>&#8756;</mo><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac><mo>=</mo><msqrt><mfrac><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>g</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>P</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>E</mi></mrow></msub></mrow></mfrac></msqrt><mo>=</mo><msqrt><mfrac><mrow><msqrt><mn>6</mn></msqrt></mrow><mrow><mn>11</mn></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><msqrt><mn>6</mn></msqrt></mrow><mrow><mn>11</mn></mrow></mfrac><mo>&#215;</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac></msqrt></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>3</mn><mn>11</mn></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi>v</mi><mi>P</mi></msub><mo>=</mo><mfrac><mn>3</mn><mn>11</mn></mfrac><mo>&#215;</mo><msub><mi>v</mi><mi>E</mi></msub><mo>=</mo><mfrac><mn>3</mn><mn>11</mn></mfrac><mo>&#215;</mo><mn>11</mn><mo>=</mo><mn>3</mn><mo>&#160;</mo><mi>km</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>"
