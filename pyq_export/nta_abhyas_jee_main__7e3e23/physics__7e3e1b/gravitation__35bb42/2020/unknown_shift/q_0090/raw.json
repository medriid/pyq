    "text": "<math><mfrac><mrow><mo>-</mo><mi>G</mi><mi>M</mi><mi>m</mi></mrow><mrow><mi>R</mi></mrow></mfrac><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mo>+</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><mi>x</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>2</mn><mi>G</mi><mi>M</mi></mrow><mrow><mi>R</mi></mrow></mfrac></mrow></mfenced><mo>=</mo><mfrac><mrow><mo>-</mo><mi>G</mi><mi>M</mi><mi>m</mi></mrow><mrow><mn>3</mn><mi>R</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msubsup><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></math><br /><br /><math><mo>&#8658;</mo><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">&#160;</mi><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><mi>M</mi></mrow><mrow><mn>3</mn><mi>R</mi></mrow></mfrac></msqrt></math><br /><br />By conservation of angular momentum:<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mo>&#215;</mo><msqrt><mfrac><mrow><mn>2</mn><mi>G</mi><mi>M</mi></mrow><mi>R</mi></mfrac></msqrt><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mn>30</mn><mo>&#176;</mo><mo>&#215;</mo><mi>R</mi><mo>=</mo><mi>m</mi><mo>&#215;</mo><msub><mi>v</mi><mn>1</mn></msub><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#952;</mi><mo>&#215;</mo><mn>3</mn><mi>R</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mi>&#952;</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi mathvariant=\"normal\">&#160;</mi><mo>&#8658;</mo><mi mathvariant=\"normal\">&#160;</mi><mi>&#952;</mi>