      "text": "Zero",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "C6iaR",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mtext mathvariant=\"italic\">GM</mtext><mrow><mn>8</mn><msup><mtext mathvariant=\"italic\">R</mtext><mn>2</mn></msup></mrow></mfrac></math>",
