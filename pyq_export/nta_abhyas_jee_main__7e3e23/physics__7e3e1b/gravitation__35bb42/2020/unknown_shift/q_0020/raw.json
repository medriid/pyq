    {
      "id": "QUiii",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mtext mathvariant=\"italic\">GM</mtext><msup><mtext mathvariant=\"italic\">R</mtext><mn>2</mn></msup></mfrac></math>",
