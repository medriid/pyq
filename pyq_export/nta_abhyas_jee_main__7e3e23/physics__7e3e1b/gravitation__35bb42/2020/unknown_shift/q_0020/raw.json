    },
    {
      "id": "oGbnx",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mtext mathvariant=\"italic\">GM</mtext><mrow><mn>2</mn><msup><mtext mathvariant=\"italic\">R</mtext><mn>2</mn></msup></mrow></mfrac></math>",
      "image": null,
