  "question": {
    "text": "A spherical hole is made in a solid sphere of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>. The mass of the sphere before hollowing was <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math>. The gravitational field at the centre of the hole due to the remaining mass is<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0027280_Question._.xyz.jpg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 173px; height: 170px;\" />",
    "image": null
  },
  "options": [
