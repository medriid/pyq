  "question": {
    "text": "A spherical hole is made in a solid sphere of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>. The mass of the sphere before hollowing was <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math>. The gravitational field at the centre of the hole due to the remaining mass is<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0020_e33c34b89941.jpg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 173px; height: 170px;\" />"
  },
  "options": [
    {
      "text": "Zero",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mtext mathvariant=\"italic\">GM</mtext><mrow><mn>8</mn><msup><mtext mathvariant=\"italic\">R</mtext><mn>2</mn></msup></mrow></mfrac></math>",
      "is_correct": false
