      "text": "<math><msup><mrow><mn>2</mn><mo>×</mo><mn>11.2</mn><mi>&nbsp;</mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">m&nbsp;</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math><msup><mrow><mn>3</mn><mo>×</mo><mn>11.2</mn><mi>&nbsp;</mi><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">m&nbsp;</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>",
