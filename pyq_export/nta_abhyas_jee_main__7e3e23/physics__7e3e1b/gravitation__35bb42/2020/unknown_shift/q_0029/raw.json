  "correctValue": "1032",
  "solution": {
    "text": "From Kepler's third law of planetary motion<br /><br /><math><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msup><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>∝</mo><msup><mrow><mi>R</mi></mrow><mrow><mn>3</mn></mrow></msup></math><br /><br /><math><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">v</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">n</mi><mo>,</mo><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>=</mo><mfrac><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow><mrow><mn>3</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfrac></math><br /><br /><math><mo>⟹</mo><mi>&nbsp;</mi><mfrac><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mi>e</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>=</mo><mfrac><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow><mrow><mn>3</mn></mrow></msubsup></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><msub><mrow><mi>R</mi></mrow><mrow><mi>e</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac></math><br /><math><mo>⟹</mo><mi>&nbsp;</mi><msub><mrow><mi>T</mi></mrow><mrow><mi>p</mi></m