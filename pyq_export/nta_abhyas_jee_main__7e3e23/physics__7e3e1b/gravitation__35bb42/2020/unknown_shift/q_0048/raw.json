  "question": {
    "text": "A satellite of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> orbits around the Earth of mass&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>M</mi></math> in an elliptical orbit of semi-major and semi-minor axes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math>&nbsp;respectively. The angular momentum of the satellite about the centre of the Earth is",
    "image": null
  },
  "options": [
    {
      "id": "TpSY0",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#x3C0;</mi><mi>m</mi><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi><mi>a</mi></mrow><mn>2</mn></mfrac></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Z15oU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#x3C0;</mi><mi>m</mi><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi><mi>a</mi></mrow><mn>4</mn></mfrac></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gDu0O",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi><mi>a</mi></mrow><mn>8</mn></mfrac></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UhNLp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><msqrt><mfrac><mrow><mi>G</mi><mi>M</mi><mi>a</mi></mrow><mn>2</mn></mfrac></msqrt></math>",
      "image": null,
