  "question": {
    "text": "If <math><mi>R</mi></math> is the radius of the Earth then the height above the Earth's surface at which the acceleration due to gravity decreases by <math><mn>20</mn><mi>%</mi></math> is"
  },
  "options": [
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><msqrt><mn>5</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mo>-</mo><mn>1</mn></mrow></mfenced><mi>R</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfenced separators=\"|\"><mrow><mfrac><mrow><msqrt><mn>5</mn></msqrt></mrow><mrow><mn>2</mn></mrow></mfrac><mo>+</mo><mn>1</mn></mrow></mfenced><mi>R</mi></math>",
      "is_correct": false
