  "question": {
    "text": "<p>A uniform rod of length&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math> is acted upon by a force&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math>&nbsp;in a gravity-free region, as shown in the figure. If the area of cross-section of the rod is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math>&nbsp;and it's Young's modulus is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math>, then the elastic potential energy stored in the rod due to&nbsp;elongation is<br />\r<img alt=\"\" src=\"assets\\qt0005_3db5ea9de335.jpg\" style=\"width: 250px; height: 70px;\" /></p>\r"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>U</mi><mo>=</mo><mfrac><mrow><msup><mi>F</mi><mn>2</mn></msup><mi>l</mi></mrow><mrow><mn>6</mn><msup><mi>A</mi><mn>2</mn></msup><mi>Y</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>U</mi><mo>=</mo><mfrac><mrow><msup><mi>F</mi><mn>2</mn></msup><mi>l</mi></mrow><mrow><mn>3</mn><msup><mi>A</mi><mn>2</mn></msup><mi>Y</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>U</mi><mo>=</mo><mfrac><mrow><msup><mi>F</mi><mn>2</mn></msup><msup><mi>l</mi><mn>2</mn></msup></mrow><mrow><mn>4</mn><msup><mi>A</mi><mn>2</mn></msup><mi>Y</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>U</mi><mo>=</mo><mfrac><mrow><msup><mi>F</mi><mn>2</mn></msup><msup><mi>l</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><msup><mi>A</mi><mn>2</mn></msup><mi>Y</mi></mrow></mfrac></math>",
      "is_correct": false
