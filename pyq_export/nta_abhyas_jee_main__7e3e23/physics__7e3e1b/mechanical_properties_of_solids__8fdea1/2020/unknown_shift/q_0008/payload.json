  "question": {
    "text": "A solid sphere of radius <math><mi>R</mi></math> made up of a material of bulk modulus <math><mi>K</mi></math> is surrounded by a liquid in a cylindrical container. A massless piston of area <math><mi>A</mi></math> floats on the surface of the liquid. When a mass <math><mi>M</mi></math> is placed on the piston to compress the liquid, the fractional change in the radius of the sphere is"
  },
  "options": [
    {
      "text": "<math><mfrac><mrow><mi>M</mi><mi>g</mi></mrow><mrow><mi>A</mi><mi>K</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>M</mi><mi>g</mi></mrow><mrow><mn>3</mn><mi>A</mi><mi>K</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mn>3</mn><mi>M</mi><mi>g</mi></mrow><mrow><mi>A</mi><mi>K</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>M</mi><mi>g</mi></mrow><mrow><mn>2</mn><mi>A</mi><mi>K</mi></mrow></mfrac></math>",
