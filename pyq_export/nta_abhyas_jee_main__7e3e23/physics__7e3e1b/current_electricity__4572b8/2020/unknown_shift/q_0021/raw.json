  "question": {
    "text": "A resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> whose value is varied from&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&nbsp;</mo><mtext>Ω</mtext><mo>&nbsp;</mo></math> to <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&nbsp;</mo><mtext>Ω</mtext></math> is connected to a cell of internal resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">Ω</mi></math>. The power consumed by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>",
    "image": null
  },
