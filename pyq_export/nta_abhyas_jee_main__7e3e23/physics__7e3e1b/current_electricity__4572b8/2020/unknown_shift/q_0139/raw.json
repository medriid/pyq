  "question": {
    "text": "Two cylindrical conductors with equal cross-sections and different resistivities <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>ρ</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>ρ</mi><mn>2</mn></msub></math>&nbsp;are put end to end. Find the charge at the boundary of the conductors if a current&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi></math> flows from conductor&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn></math> to conductor <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>.<sub>​</sub>",
    "image": null
  },
