    {
      "id": "xS2l3",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mtext mathvariant=\"italic\">&#949;</mtext><mn>0</mn></msub><mfenced><mrow><msub><mtext mathvariant=\"italic\">&#961;</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext mathvariant=\"italic\">&#961;</mtext><mn>2</mn></msub></mrow></mfenced><mtext mathvariant=\"italic\">I</mtext></math>",
