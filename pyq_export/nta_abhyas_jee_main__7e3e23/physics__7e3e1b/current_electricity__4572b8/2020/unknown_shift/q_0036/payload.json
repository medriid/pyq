  "solution": {
    "text": "The slope of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">V</mi><mo>-</mo><mi mathvariant=\"normal\">I</mi></math>&nbsp;graph gives resistance,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">R</mi><mn>1</mn></msub><mo>=</mo><mi>tan&#952;</mi><mo>,</mo><mo>&#160;</mo><msub><mi mathvariant=\"normal\">R</mi><mn>2</mn></msub><mo>=</mo><mi>tan</mi><mo>(</mo><mn>90</mn><mo>-</mo><mi mathvariant=\"normal\">&#952;</mi><mo>)</mo><mo>=</mo><mi>cot&#952;</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">R</mi><mn>1</mn></msub><mo>=</mo><msub><mi mathvariant=\"normal\">R</mi><mn>0</mn></msub><mo>(</mo><mn>1</mn><mo>+</mo><msub><mi>&#945;T</mi><mn>1</mn></msub><mo>)</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">R</mi><mn>2</mn></msub><mo>=</mo><msub><mi mathvariant=\"normal\">R</mi><mn>0</mn></msub><mo>(</mo><mn>1</mn><mo>+</mo><msub><mi>&#945;T</mi><mn>2</mn></msub><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi mathvariant=\"normal\">R</mi><mn>2</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">R</mi><mn>1</mn></msub><mo>=</mo><msub><mi mathvariant=\"normal\">R</mi><mn>0</mn></msub><mi mathvariant=\"normal\">&#945;</mi><mo>(</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>cot&#952;</mi><mo>-</mo><mi>tan&#952;</mi><mo>=</mo><msub><mi mathvariant=\"normal\">R</mi><mn>0</mn></msub><mi mathvariant=\"normal\">&#945;</mi><mo>(</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub><mo>&#8733;</mo><mfrac><mi>cos&#952;</mi><mi>sin&#952;</mi></mfrac><mo>-</mo><mfrac><mi>sin&#952;</mi><mi>cos&#952;</mi></mfrac></math><br /><br />&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8733;</mo><mfrac><mrow><mn>2</mn><mo>(</mo><msup><mi>cos</mi><mn>2</mn></msup><mi mathvariant=\"normal\">&#952;</mi><mo>-</mo><msup><mi>sin</mi><mn>2</mn></msup><mi mathvariant=\"normal\">&#952;</mi><mo>)</mo></mrow><mrow><mn>2</mn><mi>sin&#952;</mi><mo>&#8901;</mo><mi>cos&#952;</mi></mrow></mfrac></math><br /><br />&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8733;</mo><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">s</mi><mn>2</mn><mi>&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mn>2</mn><mi>&#952;</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><msub><mi mathvariant=\"normal\">T</mi><mn>2</mn></msub><mo>-</mo><msub><mi mathvariant=\"normal\">T</mi><mn>1</mn></msub><mo>&#8733;</mo><mi>cot</mi><mn>2</mn><mi mathvariant=\"normal\">&#952;</mi></math>"
