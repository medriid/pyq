    "text": "<p><img alt=\"\" src=\"assets\\st0022_3c1b53dc1e1d.png\" style=\"width: 400px; height: 242px;\" /><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>V</mi><mo>-</mo><mn>20</mn></mrow><mn>2</mn></mfrac><mo>+</mo><mfrac><mi>V</mi><mn>2</mn></mfrac><mo>+</mo><mi>V</mi><mo>-</mo><mn>5</mn><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi><mo>-</mo><mn>20</mn><mo>+</mo><mi>V</mi><mo>+</mo><mn>2</mn><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><mi>V</mi><mo>-</mo><mn>5</mn></mrow></mfenced><mo>=</mo><mn>0</mn><mspace linebreak=\"newline\"></mspace><mo>⇒</mo><mn>4</mn><mi>V</mi><mo>-</mo><mn>20</mn><mo>-</mo><mn>10</mn><mo>=</mo><mn>0</mn></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi><mo>=</mo><mfrac><mn>30</mn><mn>4</mn></mfrac><mo>=</mo><mfrac><mn>15</mn><mn>2</mn></mfrac><mo>&nbsp;</mo><mi mathvariant=\"normal\">V</mi></math><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>I</mi><mo>=</mo><mfrac><mrow><mn>15</mn><mo>-</mo><mn>10</mn></mrow><mn>2</mn></mfrac><mo>=</mo><mfrac><mn>5</mn><mn>2</mn></mfrac><mo>&nbsp;</mo><mi mathvariant=\"normal\">A</mi><mspace linebreak=\"newline\"></mspace><mo>⇒</mo><mn>2</mn><mi>I</mi><mo>=</mo><mn>5</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">A</mi></math></p>"
