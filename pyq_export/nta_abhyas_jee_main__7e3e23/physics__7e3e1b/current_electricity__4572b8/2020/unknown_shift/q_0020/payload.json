  "question": {
    "text": "Three resistors of equal resistance are arranged in four different combinations, as shown below. Arrange the combinations in increasing order of power dissipation if it is known that each combination carries the same current.<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0020_bd74d75dfb74.jpg\" style=\"width: 280px; height: 78px;\" /><br />\r<img alt=\"\" src=\"assets\\qt0020_302a2cc43b8e.jpg\" style=\"width: 280px; height: 79px;\" />"
  },
  "options": [
    {
      "text": "​<math><mi>III</mi><mo>&lt;</mo><mi>II</mi><mo>&lt;</mo><mi>IV</mi><mo>&lt;</mo><mi mathvariant=\"normal\">I</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi>II</mi><mo>&lt;</mo><mi>III</mi><mo>&lt;</mo><mi>IV</mi><mo>&lt;</mo><mi mathvariant=\"normal\">I</mi></math>",
