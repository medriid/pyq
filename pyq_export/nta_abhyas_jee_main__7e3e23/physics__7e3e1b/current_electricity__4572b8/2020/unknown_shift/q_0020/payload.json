    },
    {
      "text": "<math><mi mathvariant=\"normal\">I</mi><mo>&lt;</mo><mi>IV</mi><mo>&lt;</mo><mi>III</mi><mo>&lt;</mo><mi>II</mi></math>",
      "is_correct": false
    },
    {
      "text": "​<math><mi mathvariant=\"normal\">I</mi><mo>&lt;</mo><mi>III</mi><mo>&lt;</mo><mi>II</mi><mo>&lt;</mo><mi>IV</mi></math>",
