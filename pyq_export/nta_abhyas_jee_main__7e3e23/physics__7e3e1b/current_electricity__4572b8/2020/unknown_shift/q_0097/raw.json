  "solution": {
    "text": "Given, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mn>3</mn><mo>×</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup><mo>&nbsp;</mo><msup><mn>m</mn><mn>2</mn></msup><mo>,</mo><mo>&nbsp;</mo><mi>I</mi><mo>=</mo><mn>5</mn><mn>&nbsp;A</mn><mo>,</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>M</mi><mi>Cu</mi></msub><mo>=</mo><mn>63</mn><mo>.5</mo><mo>&nbsp;</mo><mi>kg</mi><mo>&nbsp;</mo><msup><mi>mol</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>ρ</mi><mrow><mi>C</mi><mi>u</mi></mrow></msub><mo>=</mo><mn>8920</mn><mo>&nbsp;</mo><mi>kg</mi><mo>&nbsp;</mo><msup><mn>m</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup></math><br /><br />Electron density <math><mo>=</mo><mfrac><mrow><mn>6.023</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>23</mn></mrow></msup><mo>×</mo><mn>8920</mn></mrow><mrow><mn>63.5</mn></mrow></mfrac></math><br /><br /><math><mo>=</mo><mn>8.46</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>25</mn></mrow></msup><msup><mrow><mi>&nbsp;m</mi></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup></math><br /><br /><math><mo>∴</mo></math> Drift velocity, <math><msub><mrow><mi>v</mi></mrow><mrow><mi>d</mi></mrow></msub><mo>=</mo><mfrac><mrow><mi>I</mi></mrow><mrow><mi>e</mi><mi>n</mi><mi>A</mi></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>1.6</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>19</mn></mrow></msup><mo>×</mo><mn>8.46</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>25</mn></mrow></msup><mo>×</mo><mn>3</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>40.608</mn></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>0</mn><mo>.12</mo><mo>&nbsp;</mo><mi math