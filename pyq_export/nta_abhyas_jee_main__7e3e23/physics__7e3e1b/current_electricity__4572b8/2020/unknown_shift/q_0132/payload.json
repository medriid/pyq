    "C"
  ],
  "solution": {
    "text": "Current drawn from the cell in resistance <math><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub></math> will be <math><mi>I</mi><mo>=</mo><mi>E</mi></math>/<math><mo>(</mo><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mi>r</mi><mo>)</mo></math><br /><br />Therefore, the heat produced in <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>R</mi><mn>1</mn></msub></math>&nbsp;i.e.<br /><br /><math><msub><mrow><mi>H</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><msup><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>t</mi></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mi>r</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />Heat produced in <math><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>&nbsp;</mi><mo>,</mo><mi>&nbsp;</mi><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><msup><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mi>r</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />As per question <math><msub><mrow><mi>H</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>H</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br />or <math><mfrac><mrow><msup><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>t</mi></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><mi>r</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo></math> <math><mfrac><mrow><msup><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mi>r</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math><br /><br />On solving we get;<br /><br /><math><mi>r</mi><mo>=</mo><msqrt><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></msqrt></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msqrt><mn>100</mn><mo>×</mo><mn>40</mn></msqrt><mo>=</mo><mtext>63.25&nbsp;</mtext><mi mathvariant=\"normal\">Ω</mi></math>"
  }
