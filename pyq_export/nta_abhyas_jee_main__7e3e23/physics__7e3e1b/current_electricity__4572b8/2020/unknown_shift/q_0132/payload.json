    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>63.3</mn></math<math><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">&Omega;</mi></math>",
