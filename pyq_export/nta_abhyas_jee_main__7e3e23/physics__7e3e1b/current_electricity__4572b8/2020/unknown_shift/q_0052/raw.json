  "correctValue": null,
  "solution": {
    "text": "Current in the circuit<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mrow><mtext>E</mtext><mo>+</mo><mtext>E</mtext></mrow><mrow><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub><mo>+</mo><mtext>R</mtext></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn><mtext>E</mtext></mrow><mrow><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub><mo>+</mo><mtext>R</mtext></mrow></mfrac></math>&nbsp;<br /><br />Potential difference across first cell = <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>E</mtext><mo>-</mo><msub><mtext>ir</mtext><mn>1</mn></msub></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mtext>E</mtext><mo>-</mo><mfrac><mrow><mn>2</mn><mtext>E</mtext><mo>&#215;</mo><msub><mtext>r</mtext><mn>1</mn></msub></mrow><mrow><mfenced><mrow><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub></mrow></mfenced><mo>+</mo><mtext>R</mtext></mrow></mfrac></math><br /><br />Now,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>E</mtext><mo>-</mo><mfrac><mrow><mn>2</mn><msub><mtext>Er</mtext><mn>1</mn></msub></mrow><mrow><mfenced><mrow><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub></mrow></mfenced><mo>+</mo><mtext>R</mtext></mrow></mfrac><mo>=</mo><mn>0</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mtext>E</mtext><mo>=</mo><mfrac><mrow><mn>2</mn><msub><mtext>Er</mtext><mn>1</mn></msub></mrow><mrow><mfenced><mrow><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub></mrow></mfenced><mo>+</mo><mtext>R</mtext></mrow></mfrac><mo>&#8658;</mo><mn>2</mn><msub><mtext>r</mtext><mn>1</mn></msub><mo>=</mo><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub><mo>+</mo><mtext>R</mtext></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>R</mtext><mo>=</mo><msub><mtext>r</mtext><mn>1</mn></msub><mo>-</mo><msub><mtext>r</mtext><mn>2</mn></msub></math><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0002005.png\" />",
