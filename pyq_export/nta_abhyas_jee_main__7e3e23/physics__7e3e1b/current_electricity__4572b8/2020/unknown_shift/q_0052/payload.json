      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mtext>r</mtext><mn>1</mn></msub><mo>-</mo><msub><mtext>r</mtext><mn>2</mn></msub></mrow><mn>2</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mtext>r</mtext><mn>1</mn></msub><mo>+</mo><msub><mtext>r</mtext><mn>2</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mtext>r</mtext><mn>1</mn></msub><mo>-</mo><msub><mtext>r</mtext><mn>2</mn></msub></math>",
      "is_correct": true
