  "question": {
    "text": "A coil takes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn></math>&nbsp;minutes to boil a certain amount of water. Another coil takes <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>20</mn></math>&nbsp;minutes for the same process. Time taken to boil the same amount of water when both coils are connected in series is",
    "image": null
  },
