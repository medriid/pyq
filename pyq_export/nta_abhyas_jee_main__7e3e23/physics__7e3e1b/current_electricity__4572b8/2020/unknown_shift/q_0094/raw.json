  "solution": {
    "text": "In parallel,<br /><br /><math><msub><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math><math><mo>&nbsp; &nbsp;=</mo><mfrac><mrow><mn>5.0</mn><mo>×</mo><mn>10.0</mn></mrow><mrow><mn>5.0</mn><mo>+</mo><mn>10.0</mn></mrow></mfrac></math><math><mo>&nbsp; =</mo><mfrac><mrow><mn>50</mn></mrow><mrow><mn>15</mn></mrow></mfrac><mo>=</mo><mn>3.3</mn><mi mathvariant=\"normal\">Ω</mi></math><br /><br />Also,<br /><math><msub><mrow><mi>R</mi></mrow><mrow><mi>P</mi></mrow></msub><mo>=</mo><mn>3.3</mn><mi mathvariant=\"normal\">Ω</mi></math><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math><br /><br />Differentiating<br /><br /><math><mo>⟹</mo></math><math><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><msub><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><msub><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>+</mo><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msubsup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac></math><br /><br /><math><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><msub><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mi>p</mi></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>50</mn></mrow><mrow><mn>15</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>0.2</mn></mrow><mrow><mn>25</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>0.1</mn></mrow><mrow><mn>100</mn></mrow></mfrac></mrow></mfenced></math><br /><br />%error = <math><mfrac><mrow><mn>50</mn></mrow><mrow><mn>15</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>0.8</mn><mo>+</mo><mn>0.1</mn></mrow><mrow><mn>100</mn></mrow></mfrac></mrow></mfenced><mo>×</mo><mn>100</mn><mo>=</mo><mn>3</mn><mi>%</mi></math>",
