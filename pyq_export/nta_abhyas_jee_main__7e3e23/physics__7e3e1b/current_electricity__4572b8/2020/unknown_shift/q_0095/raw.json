    {
      "id": "3E1R4",
      "text": "<math><mn>1</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">Ω</mi><mo>,</mo><mi mathvariant=\"normal\"> </mi><mn>4</mn><mi mathvariant=\"normal\"> </mi><mi mathvariant=\"normal\">Ω</mi></math>",
