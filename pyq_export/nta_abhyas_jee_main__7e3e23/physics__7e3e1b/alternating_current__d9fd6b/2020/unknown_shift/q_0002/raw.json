  "question": {
    "text": "In the circuit shown, current measured by ammeter is <math><mi>x</mi></math> ampere. Find <math><mi>x</mi></math>.<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/gaw.JPG\" style=\"width: 250px; height: 154px;\" />",
    "image": null
  },
  "options": [],
  "correctValue": "03.00",
  "solution": {
