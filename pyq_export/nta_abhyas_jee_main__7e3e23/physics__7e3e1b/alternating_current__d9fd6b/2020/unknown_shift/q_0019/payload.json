    },
    {
      "text": "<math><mrow>  <mfrac>    <mrow>      <mn>1</mn>      <mn>2</mn>      <mn>5</mn>    </mrow>    <mrow>      <mn>3</mn>      <mn>3</mn>    </mrow>  </mfrac>  <mtext>A</mtext></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math><mrow>  <mfrac>    <mrow>      <mn>1</mn>      <mn>2</mn>      <mn>5</mn>    </mrow>    <mrow>      <mn>9</mn>      <mn>9</mn>    </mrow>  </mfrac>  <mtext>A</mtext></mrow></math>",
      "is_correct": false
