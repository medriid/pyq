  "correctValue": null,
  "solution": {
    "text": "Capacitance of wire<br /><br /><math><mi>C</mi><mo>=</mo><mn>0.014</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>6</mn></mrow></msup><mo>&#215;</mo><mn>200</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>2.8</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>6</mn></mrow></msup><mn>&#160;F</mn><mo>=</mo><mn>2.8&#160;</mn><mi>&#956;F</mi></math><br /><br />For impedance of the circuit to be minimum<br /><br /><math><msub><mrow><mi>X</mi></mrow><mrow><mi>L</mi></mrow></msub><mo>=</mo><msub><mrow><mi>X</mi></mrow><mrow><mi>C</mi></mrow></msub></math><br /><br /><math><mo>&#8658;</mo><mn>2</mn><mi>&#960;</mi><mi>f</mi><mi>L</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>&#960;</mi><mi>f</mi><mi>C</mi></mrow></mfrac></math><br /><br /><math><mi>L</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><msup><mrow><mi>&#960;</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>C</mi></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><msup><mrow><mfenced separators=\"|\"><mrow><mn>3.14</mn></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>&#215;</mo><msup><mrow><mfenced separators=\"|\"><mrow><mn>5</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup><mo>&#215;</mo><mn>2.8</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>6</mn></mrow></msup></mrow></mfrac></math><br /><br /><math><mo>=</mo><mn>0.35</mn><mo>&#215;</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>3&#160;</mn></mrow></msup><mi mathvariant=\"normal\">H</mi><mo>=</mo><mn>0.35</mn><mi>&#160;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">H</mi></math>",
