    "text": "In the branch containing L and <math><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mi>i</mi><mo>=</mo><mfrac><mrow><mi>E</mi></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow><mrow><mi>L</mi></mrow></mfrac></mrow></msup></mrow></mfenced></math><br /><br /><math><mfrac><mrow><mi>d</mi><mi>i</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>E</mi></mrow><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow><mrow><mi>L</mi></mrow></mfrac></mrow></msup><mo>.</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi>L</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>E</mi></mrow><mrow><mi>L</mi></mrow></mfrac><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow><mrow><mi>L</mi></mrow></mfrac></mrow></msup></math><br /><br /><math><mo>&#8756;</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>L</mi></mrow></msub><mo>=</mo><mi>L</mi><mfrac><mrow><mi>d</mi><mi>i</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mi>E</mi><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mfrac><mrow><msub><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>t</mi></mrow><mrow><mi>L</mi></mrow></mfrac></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mn>12</mn><msup><mi>e</mi><mrow><mo>-</mo><mfrac><mrow><mn>2</mn><mi>t</mi></mrow><mrow><mn>400</mn><mo>&#215;</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup></mrow></mfrac></mrow></msup><mo>=</mo><mn>12</mn><mtext>&#8