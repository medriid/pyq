  "question": {
    "text": "The steady-state current through <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>L</mi><mn>1</mn></msub></math>&nbsp;after the switch has been closed for a very long time is<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/ci/image84-db7c57d8-5d2c-48b7-8d3a-409fd06ee88a.jpg\" />",
    "image": null
  },
  "options": [
    {
