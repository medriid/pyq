  "question": {
    "text": "The steady-state current through <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>L</mi><mn>1</mn></msub></math>&nbsp;after the switch has been closed for a very long time is<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0023_e14932b69745.jpg\" />"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>V</mi><mn>0</mn></msub><mi>R</mi></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>V</mi><mn>0</mn></msub><msub><mi>L</mi><mn>1</mn></msub></mrow><mrow><mi>R</mi><mfenced separators=\"|\"><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>+</mo><msub><mi>L</mi><mn>2</mn></msub></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>V</mi><mn>0</mn></msub><msub><mi>L</mi><mn>2</mn></msub></mrow><mrow><mi>R</mi><mfenced separators=\"|\"><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>+</mo><msub><mi>L</mi><mn>2</mn></msub></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": true
    },
