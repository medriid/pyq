</math>  <br/><math><mn>4</mn><mi mathvariant=\"normal\">λ</mi><mi mathvariant=\"normal\">t</mi><mo>=</mo><mn>2</mn></math>  <br/><math><mi mathvariant=\"normal\">t</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi mathvariant=\"normal\">λ</mi></mrow></mfrac></math>"
