  "question": {
    "text": "Which among the following has a Hydrogen-like spectrum and whose lines have wavelengths four times shorter than those of atomic Hydrogen?",
    "image": null
  },
  "options": [
    {
      "id": "V4IF6",
      "text": "Helium ion",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "UfHu3",
      "text": "Beryllium ion",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8EkhD",
      "text": "Lithium ion",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sokOz",
      "text": "None of these ",
      "image": null,
      "isCorrect": false
    }
