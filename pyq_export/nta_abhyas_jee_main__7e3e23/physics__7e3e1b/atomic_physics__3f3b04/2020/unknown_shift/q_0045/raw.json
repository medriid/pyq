  "question": {
    "text": "<p>A&nbsp;sample of atomic hydrogen gas is irradiated by a beam of ultraviolet radiation having a wavelength between <math> <mrow> <mtext>100&nbsp;nm</mtext></mrow> </math> and <math> <mrow> <mtext>200&nbsp;nm</mtext></mrow></math>. Assuming that the atoms are in the ground state, the wavelength which will have low intensity in the transmitted beam is</p>\r",
    "image": null
  },
  "options": [
    {
      "id": "YXGUl",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>104&#xA0;nm</mtext></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9PPg4",
      "text": "<math> <mrow> <mtext>103&nbsp;nm</mtext></mrow> </math>",
      "image": null,
      "isCorrect": true
    },
