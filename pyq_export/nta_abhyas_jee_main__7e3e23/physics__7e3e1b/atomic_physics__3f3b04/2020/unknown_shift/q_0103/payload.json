  "question": {
    "text": "In a hydrogen-like species, the net force acting on a revolving electron in an orbit as given by the Bohr model is proportional to [<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi><mo>→</mo></math>principal quantum number,&nbsp;<math> <mrow> <mi>Z</mi><mo>→</mo></mrow> </math>atomic number]"
  },
  "options": [
    {
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mi>Z</mi> <mn>3</mn> </msup> </mrow> <mrow> <msup> <mi>n</mi> <mn>4</mn> </msup> </mrow> </mfrac> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mi>n</mi> <mn>3</mn> </msup> </mrow> <mrow> <msup> <mi>Z</mi> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mi>Z</mi> <mn>2</mn> </msup> </mrow> <mrow> <msup> <mi>n</mi> <mn>3</mn> </msup> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mi>n</mi> <mn>4</mn> </msup> </mrow> <mrow> <msup> <mi>Z</mi> <mn>3</mn> </msup> </mrow> </mfrac> </mrow> </math>",
