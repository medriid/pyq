  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtable columnalign=\"left\"><mtr><mtd><mi>A</mi><mo>→</mo><mi>u</mi></mtd><mtd><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><msup><mo>←</mo><mrow><mi mathvariant=\"normal\">v</mi><mo>/</mo><mn>2</mn></mrow></msup><mi mathvariant=\"normal\">C</mi></mtd><mtd><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mi mathvariant=\"normal\">B</mi><mo>→</mo><mi mathvariant=\"normal\">v</mi></mtd></mtr><mtr><mtd><mn>2</mn><mi mathvariant=\"normal\">m</mi></mtd><mtd><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi></mtd><mtd><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi></mtd></mtr></mtable></math></p><p>Applying conservation of linear momentum</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>m</mi><mi>u</mi><mo>&nbsp;</mo><mo>=</mo><mo>&nbsp;</mo><mi>m</mi><mi>v</mi><mo>&nbsp;</mo><mo>-</mo><mo>&nbsp;</mo><mfrac><mrow><mi>m</mi><mi>v</mi></mrow><mn>2</mn></mfrac></math></p><p>So,</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>λ</mi><mi mathvariant=\"normal\">A</mi></msub><mo>=</mo><mfrac><mi mathvariant=\"normal\">h</mi><mrow><mn>2</mn><mi>mu</mi></mrow></mfrac><mo>&nbsp;&nbsp;</mo><msub><mi>λ</mi><mi mathvariant=\"normal\">B</mi></msub><mo>=</mo><mfrac><mi mathvariant=\"normal\">h</mi><mi>mv</mi></mfrac><mo>=</mo><mfrac><msub><mi>λ</mi><mi mathvariant=\"normal\">A</mi></msub><mn>2</mn></mfrac><mo>&nbsp;&nbsp;</mo><msub><mi>λ</mi><mi mathvariant=\"normal\">C</mi></msub><mo>=</mo><mfrac><mi mathvariant=\"normal\">h</mi><mrow><mi mathvariant=\"normal\">m</mi><mfrac><mi mathvariant=\"normal\">v</mi><mn>2</mn></mfrac></mrow></mfrac><mo>=</mo><msub><mi>λ</mi><mi mathvariant=\"normal\">A</mi></msub></math></p>"
