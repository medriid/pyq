  "question": {
    "text": "Which among the following expressions is the correct for the magnetic field at the site of the nucleus in a hydrogen atom due to the circular motion of the electron? Assume that the atom is in its ground state and the expressions are given in terms of the fundamental constants.<br />\rwhere&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math>&nbsp;= mass of an electron,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>e</mi></math>&nbsp;= charge of an electron,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math>&nbsp;= planck's constant)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#956;</mi><mn>0</mn></msub><msup><mtext mathvariant=\"italic\">e</mtext><mn>7</mn></msup><mi>&#960;</mi><msup><mtext mathvariant=\"italic\">m</mtext><mn>2</mn></msup></mrow><mrow><mn>8</mn><msubsup><mi>&#949;</mi><mn>0</mn><mn>3</mn></msubsup><msup><mtext mathvariant=\"italic\">h</mtext><mn>5</mn></msup></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>&#956;</mi><mn>0</mn></msub><msup><mtext mathvariant=\"italic\">e</mtext><mn>5</mn></msup><mi>&#960;</mi><msup><mtext mathvariant=\"italic\">m</mtext><mn>2</mn></msup></mrow><mrow><mn>8</mn><msubsup><mi>&#949;</mi><mn>0</mn><mn>3</mn></msubsup><msup><mtext mathvariant=\"italic\">h</mtext><mn>5</mn></msup></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>μ</mi><mn>0</mn></msub><msup><mtext mathvariant=\"italic\">e</mtext><mn>5</mn></msup><mi>π</mi><msup><mtext mathvariant=\"italic\">m</mtext><mn>2</mn></msup></mrow><mrow><mn>8</mn><msubsup><mi>ε</mi><mn>0</mn><mn>3</mn></msubsup><msup><mtext mathvariant=\"italic\">h</mtext><mn>4</mn></msup></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>μ</mi><mn>0</mn></msub><msup><mtext mathvariant=\"italic\">e</mtext><mn>7</mn></msup><mi>π</mi><msup><mtext mathvariant=\"italic\">m</mtext><mn>2</mn></msup></mrow><mrow><mn>8</mn><msubsup><mi>ε</mi><mn>0</mn><mn>3</mn></msubsup><msup><mtext mathvariant=\"italic\">h</mtext><mn>4</mn></msup></mrow></mfrac></math>",
