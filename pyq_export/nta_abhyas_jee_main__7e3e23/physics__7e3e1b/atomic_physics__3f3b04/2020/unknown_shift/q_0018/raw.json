  "question": {
    "text": "<p>Which of the following wavelengths lying in the range <math> <mrow> <mtext>500&nbsp;nm&nbsp;</mtext></mrow></math>to <math> <mrow> <mtext>700&nbsp;nm&nbsp;</mtext></mrow></math>is in hydrogen spectrum?</p>\r",
    "image": null
  },
  "options": [
    {
      "id": "ALRu2",
      "text": "<math> <mrow> <mtext>654&nbsp;nm</mtext></mrow> </math>",
      "image": null,
