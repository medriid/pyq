    {
      "text": "<math><mn>2</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup><mi>&nbsp;</mi><mtext>e</mtext><mtext>V</mtext></math>",
