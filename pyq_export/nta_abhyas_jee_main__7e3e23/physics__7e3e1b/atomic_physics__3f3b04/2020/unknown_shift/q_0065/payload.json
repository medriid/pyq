    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><mi>E</mi></mrow><mrow><mn>4</mn><mi>m</mi><mi>c</mi></mrow></mfrac></math>",
