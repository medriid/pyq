      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>18</mn><mrow><mn>5</mn><mi>R</mi></mrow></mfrac></math><div id=\"gtx-trans\" style=\"position: absolute; left: 67px; top: 37.6667px;\"><div class=\"gtx-trans-icon\">&nbsp;</div></div><div id=\"gtx-trans\" style=\"position: absolute; left: 67px; top: 37.6667px;\"><div class=\"gtx-trans-icon\">&nbsp;</div></div>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>4</mn><mi>R</mi></mfrac></math>",
