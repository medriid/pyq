      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>B</mi></msub><mo>=</mo><mn>5</mn><mn>&#160;&#956;</mn><mn>A</mn><mo>,</mo><mo>&#160;</mo><msub><mi>I</mi><mi>C</mi></msub><mo>=</mo><mn>1</mn><mn>&#160;m</mn><mn>A</mn></math>",
