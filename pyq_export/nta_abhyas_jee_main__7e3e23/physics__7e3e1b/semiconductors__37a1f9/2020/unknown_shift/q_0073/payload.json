  "solution": {
    "text": "Given, <math><mi>β</mi><mo>=</mo><mn>50</mn><mo>,</mo><mi>&nbsp;</mi><msub><mrow><mi>V</mi></mrow><mrow><mi>C</mi><mi>E</mi></mrow></msub><mo>=</mo><mn>2&nbsp;</mn><mi>V</mi><mo>,</mo><mi>&nbsp;</mi><msub><mrow><mi>R</mi></mrow><mrow><mi>c</mi></mrow></msub><mo>=</mo><mn>4</mn><mi>&nbsp;</mi><mi>k</mi><mi mathvariant=\"normal\">Ω</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>C</mi></msub><mo>=</mo><mfrac><msub><mi>V</mi><mrow><mi>C</mi><mi>E</mi></mrow></msub><msub><mi>R</mi><mi>C</mi></msub></mfrac><mo>=</mo><mfrac><mn>2</mn><mrow><mn>4</mn><mo>×</mo><msup><mn>10</mn><mn>3</mn></msup></mrow></mfrac><mo>=</mo><mn>5</mn><mo>×</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>4</mn></mrow></msup><mo>&nbsp;</mo><mi mathvariant=\"normal\">A</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>C</mi></msub><mo>=</mo><mn>0.5</mn><mi>&nbsp;</mi><mi>mA</mi></math><br /><br />DC current gain, <math><mi>β</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>I</mi></mrow><mrow><mi>C</mi></mrow></msub></mrow><mrow><msub><mrow><mi>I</mi></mrow><mrow><mi>B</mi></mrow></msub></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>B</mi></msub><mo>=</mo><mfrac><msub><mi>I</mi><mi>C</mi></msub><mi>β</mi></mfrac><mo>=</mo><mfrac><mrow><mn>0.5</mn><mo>×</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>3</mn></mrow></msup></mrow><mn>50</mn></mfrac><mo>=</mo><msup><mn>10</mn><mrow><mo>-</mo><mn>5</mn></mrow></msup><mo>&nbsp;</mo><mi mathvariant=\"normal\">A</mi></math><br /><br />Hence, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>I</mi><mi>B</mi></msub><mo>=</mo><mn>10</mn><mo>&nbsp;</mo><mi>μA</mi></math>"
  }
