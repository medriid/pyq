  "question": {
    "text": "A common emitter amplifier has a voltage gain of 50, an input impedance of 100 <math><mi mathvariant=\"normal\">Ω</mi></math> and an output impedance of 200 <math><mi mathvariant=\"normal\">Ω</mi><mo>.</mo></math> The power gain of the amplifier is"
  },
  "options": [
    {
      "text": "500",
      "is_correct": false
    },
    {
      "text": "1000",
      "is_correct": false
    },
    {
