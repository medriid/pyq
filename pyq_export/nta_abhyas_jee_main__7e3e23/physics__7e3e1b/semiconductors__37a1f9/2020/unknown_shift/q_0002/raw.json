  "solution": {
    "text": "Here,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">β</mi><mo>=</mo><mn>69</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">E</mi></msub><mo>=</mo><mn>7</mn><mo>&nbsp;</mo><mi>mA</mi></math><br /><br />Since, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">β</mi><mo>=</mo><mfrac><mi mathvariant=\"normal\">α</mi><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">α</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>69</mn><mo>=</mo><mfrac><mi mathvariant=\"normal\">α</mi><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">α</mi></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>69</mn><mo>-</mo><mn>69</mn><mi mathvariant=\"normal\">α</mi><mo>=</mo><mi mathvariant=\"normal\">α</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>69</mn><mo>=</mo><mn>70</mn><mi mathvariant=\"normal\">α</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">α</mi><mo>=</mo><mfrac><mn>69</mn><mn>70</mn></mfrac><mo>=</mo><mn>0</mn><mo>.986</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">C</mi></msub><msub><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">E</mi></msub></mfrac><mo>=</mo><mn>0</mn><mo>.986</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>∴</mo><msub><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">C</mi></msub><mo>=</mo><mn>0</mn><mo>.986</mo><mo>&nbsp;&nbsp;</mo><msub><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">E</mi></msub><mo>=</mo><mn>0</mn><mo>.986</mo><mo>×</mo><mn>7</mn><mo>=</mo><mn>6</mn><mo>.9</mo><mi mathvariant=\"normal\">&nbsp;</mi><mi>mA</mi></math><br /><br /><math xmlns=\"h