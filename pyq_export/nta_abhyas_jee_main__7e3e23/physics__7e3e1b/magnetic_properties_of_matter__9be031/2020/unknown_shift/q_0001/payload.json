    "text": "<img alt=\"\" height=\"170\" src=\"assets\\st0001_54e2c7f4114d.jpg\" width=\"231\" /><br /><br /><math><mi>L</mi><mo>=</mo><mi>π</mi><mi>R</mi></math><br /><br /><math> <mrow> <mo>⇒</mo><mi>R</mi><mo>=</mo><mfrac> <mi>L</mi> <mi>π</mi> </mfrac> <mo>=</mo><mfrac> <mrow> <mn>20</mn></mrow> <mrow> <mn>100</mn><mi>π</mi></mrow> </mfrac> <mtext> </mtext><mtext> </mtext><mtext>m</mtext><mo>=</mo><mfrac> <mn>1</mn> <mrow> <mn>5</mn><mi>π</mi></mrow> </mfrac> <mo>&nbsp;</mo><mtext> </mtext><mtext>m</mtext></mrow> </math><br /><br /><math><mo>⇒</mo></math> due to a charge arc, electric field at centre is given by<br /><br /><math><mrow><mi>E</mi><mo>=</mo><mfrac> <mrow> <mn>2</mn><mi>K</mi><mi>λ</mi></mrow> <mi>R</mi> </mfrac> <mi>sin</mi><mfrac> <mi>θ</mi> <mn>2</mn> </mfrac> </mrow> </math><br /><br /><img alt=\"\" src=\"assets\\st0001_f6194e1018cf.jpg\" style=\"width: 123px; height: 173px;\" /><br /><br /><math><msub><mrow><mi>E</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>E</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mi>k</mi><mo>⋋</mo></mrow><mrow><mi>R</mi></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>90</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mo>{</mo><mo>⋋</mo><mo>=</mo><mfrac><mrow><mi>Q</mi></mrow><mrow><mi>π</mi><mi>R</mi><mo>/</mo><mn>2</mn></mrow></mfrac><mo>}</mo></mrow></mrow></math><br /><br /><br /><math> <mrow> <msub> <mi>E</mi> <mn>1</mn> </msub> <mo>=</mo><mi>E</mi><msub> <malignmark></malignmark> <mn>2</mn> </msub> <mo>=</mo><mfrac> <mrow> <mn>2</mn><msqrt> <mn>2</mn> </msqrt> <mtext> </mtext><mi>K</mi><mi>Q</mi></mrow> <mrow> <mi>π</mi><msup> <mi>R</mi> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </math><br /><br />Component along <math><mover accent=\"true\"><mrow><mi>j</mi></mrow><mo>^</mo></mover><mi>&nbsp;</mi></math> gets cancelled and&nbsp;<br /><br /><math> <mrow> <msub> <mi>E</mi> <mrow> <mi>n</mi><mi>e</mi><mi>t</mi></mrow> </msub> <mo>=</mo><msqrt> <mn>2</mn> </msqrt> <msub> <mi>E</mi> <mn>1</mn> </msub> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo><mfrac> <mrow> <mn>4</mn><mi>K</mi><mi>Q</mi></mrow> <mrow> <mi>π</mi><msup> <mi>R</mi> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>4</mn><mo>×</mo><mn>1</mn><mfenced separators=\"|\"><mrow><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><msub><mrow><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfenced></mrow><mrow><mn>4</mn><mi>π</mi><msub><mrow><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>&nbsp;</mi><mi>π</mi><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>4</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><msub><mrow><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>4</mn><msup><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>ϵ</mi></mrow><mrow><mn>0</mn></mrow></msub><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><msup><mrow><mn>10</mn></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>100</mn></mrow><mrow><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>5</mn><mi>π</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mn>25</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup></math><br /><br /><math><msub><mrow><mover accent=\"true\"><mrow><mi>E</mi></mrow><mo>→</mo></mover></mrow><mrow><mi>n</mi><mi>e</mi><mi>t</mi></mrow></msub><mo>=</mo><mn>25</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>3</mn></mrow></msup><mfrac><mrow><mi>N</mi></mrow><mrow><mi>