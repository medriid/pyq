  "question": {
    "text": "A thin spherical shell of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>&nbsp;is cut into two equal halves and then each of its halves is charged to the same uniform surface charge density&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>σ</mi></math>. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math>&nbsp;is the force exerted on each half to keep them at equilibrium, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi></math>&nbsp;is&nbsp;proportional to<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/M0001826_1111.PNG\" style=\"width: 300px; height: 137px;\" />",
    "image": null
  },
