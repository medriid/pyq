  "question": {
    "text": "A ferromagnetic material is heated above its curie temperature. Which one of the following is the correct statement?"
  },
  "options": [
    {
      "text": "Ferromagnetic domains are perfectly arranged",
      "is_correct": false
    },
    {
      "text": "Ferromagnetic domains become random",
      "is_correct": true
    },
    {
      "text": "Ferromagnetic domains are not influenced",
      "is_correct": false
    },
    {
      "text": "Ferromagnetic material changes into diamagnetic material",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Beyond curie temperature, ferromagnetic material turns into paramagnetic material, as if ferromagnetic domains become random."
