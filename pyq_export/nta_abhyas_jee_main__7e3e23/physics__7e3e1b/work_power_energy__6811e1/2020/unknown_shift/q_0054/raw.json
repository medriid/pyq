    {
      "id": "9sIU2",
      "text": "<math><mfrac><mrow><msubsup><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow><mrow><mn>8</mn><mi>g</mi></mrow></mfrac></math>",
