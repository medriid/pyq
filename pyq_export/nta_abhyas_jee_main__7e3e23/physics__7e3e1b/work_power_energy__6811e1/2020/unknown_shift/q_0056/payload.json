    "text": "<math> <mrow> <mi>P</mi><mo>⁡</mo> <mo>=</mo> <mo mathvariant=\"italic\">F</mo> <mi>v</mi><mo>⁡</mo> <mo>=</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext mathvariant=\"italic\">ma</mtext> </mrow> </mfenced> <mi>v</mi><mo>⁡</mo> <mo>=</mo> <mi>m</mi><mo>⁡</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <msup> <mrow> <mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <msup> <mrow> <mi>t</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </mfenced> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> </mrow> </mfenced> </mrow> </math><br /><br />Since, power is constant<br /><br /><math> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <msup> <mrow> <mi>d</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <msup> <mrow> <mi>t</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </mfenced> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> </mrow> </mfenced> <mo>=</mo> <mi>k</mi><mo>⁡</mo> </mrow> </math><br /><br />or&nbsp;<math> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> </mrow> </mfenced> </mrow> <mn>2</mn> </msup> <mo>=</mo> <mi>k</mi><mo>⁡</mo> </mrow> </math><br /><br /><math> <mrow> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> </mrow> </mfenced> </mrow> <mn>2</mn> </msup> <mo>=</mo> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>1</mn> </msub> <mi>t</mi><mo>⁡</mo> </mrow> </math><br /><br /><math> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> <mo>=</mo> <msqrt> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>1</mn> </msub> <mi>t</mi><mo>⁡</mo> </msqrt> </mrow> </math><br /><br /><math> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> <mo>=</mo> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> <msup> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mi>t</mi><mo>⁡</mo> </mrow> </mfenced> </mrow> <mrow> <mn>1</mn> <mo>/</mo> <mn>2</mn> </mrow> </msup> </mrow> </math>&nbsp;&nbsp;<math> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mo>∵</mo> <msubsup> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>1</mn> <mrow> <mn>1</mn> <mo>/</mo> <mn>2</mn> </mrow> </msubsup> <mo>=</mo> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> </mrow> </mfenced> </mrow> </math><br /><br /><math> <mrow> <mi>x</mi><mo>⁡</mo> <mo>=</mo> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>3</mn> </msub> <msup> <mrow> <mi>t</mi><mo>⁡</mo> </mrow> <mrow> <mn>3</mn> <mo>/</mo> <mn>2</mn> </mrow> </msup> </mrow> </math>&nbsp;&nbsp;<math> <mrow> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mo>∵</mo> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>3</mn> </msub> <mo>=</mo> <mfrac> <mrow> <mn>2</mn> </mrow> <mrow> <mn>3</mn> </mrow> </mfrac> <msub> <mrow> <mi>k</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> </mrow> </mfenced> </mrow> </math><br /><br />Hence&nbsp;<math> <mrow> <mfrac> <mrow> <mi>d</mi><mo>⁡</mo> <mi>x</mi><mo>⁡</mo> </mrow> <mrow> <mi>d</mi><mo>⁡</mo> <mi>t</mi><mo>⁡</mo> </mrow> </mfrac> <mo>&prop;</m