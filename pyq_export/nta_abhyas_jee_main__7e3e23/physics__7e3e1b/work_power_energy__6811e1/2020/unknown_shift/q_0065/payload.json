    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mi>g</mi><mo>&#160;</mo><mo>(</mo><mn>3</mn><mi>cos</mi><mi>&#952;</mi><mo>&#160;</mo><mo>&#8211;</mo><mn>2</mn><mo>&#160;</mo><mo>)</mo></math>",
