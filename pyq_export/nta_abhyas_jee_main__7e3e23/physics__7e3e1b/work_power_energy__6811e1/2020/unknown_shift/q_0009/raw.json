  "question": {
    "text": "&nbsp;A block of mass&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> is connected rigidly with a smooth wedge (plank) by a light spring of stiffness <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi></math>. If the wedge is moved with constant velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>v</mi><mn>0</mn></msub></math>, then find the work done by the external agent until the maximum compression of the spring.<br />\r<br />\r<img alt=\"\" height=\"128\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0014759_Question_1.jpg\" style=\"max-width:100%; object-fit:contain\" width=\"196\" />",
    "image": null
  },
  "options": [
    {
      "id": "yd1Si",
      "text": "<math> <mrow> <mi>m</mi><mo>⁡</mo><msubsup><mrow><mi>v</mi><mo>⁡</mo> </mrow> <mn>0</mn> <mn>2</mn> </msubsup> </mrow> </math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "7f7KF",
      "text": "<math><mrow><mn>2</mn>  <mi>m</mi><mo>&ApplyFunction;</mo>  <msubsup>        <mrow>          <mi>v</mi><mo>&ApplyFunction;</mo>        </mrow>        <mn>0</mn>        <mn>2</mn>  </msubsup></mrow></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "btYxe",
      "text": "<math> <mrow><mn>3</mn> <mi>m</mi><mo>⁡</mo> <msubsup> <mrow> <mi>v</mi><mo>⁡</mo> </mrow> <mn>0</mn> <mn>2</mn> </msubsup> </mrow> </math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tFV1a",
      "text": "<math> <mrow><mn>2</mn> <mi>m</mi><mo>⁡</mo> <msubsup> <mrow> <mi>v</mi><mo>⁡</mo> </mrow> <mn>0</mn> <mn>3</mn> </msubsup> </mrow> </math>",
      "image": null,
