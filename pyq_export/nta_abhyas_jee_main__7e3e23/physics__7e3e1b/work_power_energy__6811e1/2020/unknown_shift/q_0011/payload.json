    {
      "text": "<math><mo>–</mo><mi mathvariant=\"normal\"> </mi><mfrac><mrow><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">v</mi><mi mathvariant=\"normal\">t</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
