      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mfrac> <mi>S</mi> <mn>4</mn> </mfrac> <mo>,</mo><mtext> </mtext><mfrac> <mrow> <msqrt> <mrow> <mn>3</mn><mi>g</mi><mi>S</mi></mrow> </msqrt> </mrow> <mn>2</mn> </mfrac> </mrow> </math>",
      "is_correct": false
    },
