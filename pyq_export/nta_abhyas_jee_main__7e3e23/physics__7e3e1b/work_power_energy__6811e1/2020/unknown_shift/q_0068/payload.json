  "question": {
    "text": "A ball whose kinetic energy is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math>, is thrown at an angle of&nbsp;<math> <mrow> <mn>45</mn><mo>°</mo> </mrow> </math> &nbsp;with the horizontal. Its kinetic energy at the highest point of its flight will be:"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math>",
      "is_correct": false
