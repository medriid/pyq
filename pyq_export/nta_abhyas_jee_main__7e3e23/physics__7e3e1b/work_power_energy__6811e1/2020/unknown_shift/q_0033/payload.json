  "question": {
    "text": "Initially, a block of mass&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> is at rest on a frictionless floor and the spring is in a relaxed condition. One end of the spring is rigidly attached to the block and the other end is fixed to a wall. A constant force is applied on the block as shown in the figure. The maximum velocity of the block is<br />\r<br />\r<img src=\"assets\\qt0033_bc7a80c71bcc.png\" />"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>F</mi><msqrt><mi>m</mi><mi>K</mi></msqrt></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>F</mi><mrow><mn>2</mn><msqrt><mi>m</mi><mi>K</mi></msqrt></mrow></mfrac></math>",
