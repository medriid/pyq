    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mi>F</mi><msqrt><mn>2</mn><mi>m</mi><mi>K</mi></msqrt></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><mi>F</mi></mrow><msqrt><mi>m</mi><mi>K</mi></msqrt></mfrac></math>",
