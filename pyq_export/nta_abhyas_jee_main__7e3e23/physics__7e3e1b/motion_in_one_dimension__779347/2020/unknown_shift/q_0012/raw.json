  "question": {
    "text": "A body starts from rest and moves with a constant acceleration. The ratio of distance covered in the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>n</mi><mi>th</mi></msup></math>&nbsp;second to the distance covered in <math><mi>n</mi></math> second is",
    "image": null
  },
  "options": [
    {
      "id": "HAnkz",
      "text": "<math><mfrac><mrow><mn>2</mn></mrow><mrow><mi>n</mi></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
