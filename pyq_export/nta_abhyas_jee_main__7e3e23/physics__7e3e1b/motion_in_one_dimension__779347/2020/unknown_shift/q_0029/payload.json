row><msubsup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mi>π</mi><mi>r</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mi>t</mi></mrow></mrow></mrow><mrow><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></msubsup></mrow></mfenced></math><br /><br /><math><mo>=</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>r</mi><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>π</mi></mrow></mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mn>0</mn></mrow></mrow></mrow></mfenced></mrow></mfenced><mo>+</mo><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi>r</mi><mfenced separators=\"|\"><mrow><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mrow><mo>-</mo><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mi>π</mi></mrow></mrow></mrow></mfenced></mrow></mfenced></math><br /><br /><math><mo>=</mo><mi>r</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mo>-</mo><mn>1</mn><mo>-</mo><mn>1</mn></mrow></mfenced><mo>+</mo><mi>r</mi><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mn>0</mn><mo>-</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>1</mn></mrow></mfenced></mrow></mfenced><mo>=</mo><mn>2</mn><mi>r</mi><mo>+</mo><mi>r</mi><mo>=</mo><mn>3</mn><mi>r</mi></math>"
