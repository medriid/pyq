    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mi>k</mi><msup><mi>v</mi><mn>3</mn></msup><mo></mo></math><br /><br /><math><mrow><mo>⇒&nbsp;-</mo><msubsup><mo stretchy=\"false\">∫</mo><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi>v</mi></mrow></msubsup><mrow><mfrac><mrow><mi>d</mi><mi>v</mi></mrow><mrow><mi>k</mi><msup><mrow><mi>v</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></mfrac><mo>=</mo><mrow><msubsup><mo stretchy=\"false\">∫</mo><mrow><mn>0</mn></mrow><mrow><mi>t</mi></mrow></msubsup><mrow><mi>d</mi><mi>t</mi></mrow></mrow></mrow></mrow></math><br /><br /><math><mo>⇒</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>k</mi></mrow></mfrac><mrow><munderover><mo stretchy=\"false\">∫</mo><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi>v</mi></mrow></munderover><mo>-</mo><mrow><msup><mrow><mi>v</mi></mrow><mrow><mo>-</mo><mn>3</mn></mrow></msup><mi>d</mi><mi>v</mi><mo>=</mo><mi>t</mi></mrow></mrow></math> or <math><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi>k</mi></mrow></mfrac><msubsup><mrow><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mfrac><mrow><msup><mrow><mi>v</mi></mrow><mrow><mo>-</mo><mn>3</mn><mo>+</mo><mn>1</mn></mrow></msup></mrow><mrow><mo>-</mo><mn>3</mn><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mi>v</mi></mrow></msubsup><mo>=</mo><mi>t</mi></math><br /><br />or <math><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>k</mi></mrow></mfrac><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msubsup><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac></mrow></mfe