      "is_correct": false
    },
    {
      "text": "<math><mi>c</mi><msqrt><mfrac><mrow><mn>2</mn><mi mathvariant=\"normal\">Δ</mi><mi>m</mi></mrow><mrow><mi>M</mi></mrow></mfrac></msqrt></math>",
      "is_correct": true
