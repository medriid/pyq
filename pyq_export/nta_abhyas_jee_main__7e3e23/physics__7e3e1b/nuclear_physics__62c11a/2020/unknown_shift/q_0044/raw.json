  "question": {
    "text": "The activity of a radioactive element decreases in&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn></math> years to <math><mrow><mrow><mn>1</mn></mrow><mo>/</mo><mrow><mn>5</mn></mrow></mrow></math> of initial activity <math><msub><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msub></math>. After further next 10 years, its activity will be",
    "image": null
  },
  "options": [
    {
      "id": "87nxD",
      "text": "<math><mfrac><mrow><msub><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>4</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YTtF0",
      "text": "<math><mfrac><mrow><msub><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>10</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PBaU6",
      "text": "<math><mfrac><mrow><msub><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>15</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7dZ3d",
      "text": "<math><mfrac><mrow><msub><mrow><mi>A</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mn>25</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
