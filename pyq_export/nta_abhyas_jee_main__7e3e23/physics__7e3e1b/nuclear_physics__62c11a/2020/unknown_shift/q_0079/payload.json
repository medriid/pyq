  "question": {
    "text": "A radioactive material decays by simultaneous emission of two particles with half-lives <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1620</mn></math>&nbsp;years and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>810</mn></math> years respectively. The time in years after which one - fourth of material remains, is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1080</mn></math> years",
      "is_correct": true
    },
