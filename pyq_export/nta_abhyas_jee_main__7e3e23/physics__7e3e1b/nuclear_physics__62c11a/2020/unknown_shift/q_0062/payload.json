<mrow><msub><mrow><mtext>N</mtext></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mtext>N</mtext></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mrow><mtext>T</mtext></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msub></mrow><mrow><mn>0.693</mn></mrow></mfrac><mrow><mrow><mtext mathvariant=\"normal\">ln</mtext></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mtext>N</mtext></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mtext>N</mtext></mrow></mfrac></mrow></mfenced></mrow></mrow></math> <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>∵</mo><mtext>&nbsp;</mtext><mtext>&nbsp;</mtext><mtext>λ</mtext><mo>=</mo><mfrac><mrow><mn>0.693</mn></mrow><mrow><msub><mrow><mtext>T</mtext></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msub></mrow></mfrac></mrow></mfenced></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>15</mn></mrow><mrow><mn>0.693</mn></mrow></mfrac><mo>×</mo><mrow><mrow><mtext mathvariant=\"normal\">ln</mtext></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>12</mn></mrow><mrow><mn>1.5</mn></mrow></mfrac></mrow></mfenced></mrow></mrow></math><math></math><br /><br /><math><mrow> <mo>=</mo><mfrac> <mrow> <mn>15</mn> </mrow> <mrow> <mn>0.693</mn> </mrow> </mfrac> <mtext> </mtext><mtext>ℓ</mtext><mtext>n</mtext><mo stretchy=\"false\">(</mo><mn>8</mn><mo stretchy=\"false\">)</mo></mrow></math><br /><br /><math><mo>=</mo><mfrac> <mrow> <mn>15</mn> </mrow> <mrow> <mn>0.693</mn> </mrow> </mfrac> <mo>×</mo><mn>3</mn><mo>×</mo><mtext>ℓ</mtext><msup> <mtext>n</mtext> <mn>2</mn> </msup> </math><br /><br /><math> <mrow> <mo>=</mo><mn>15</mn><mo>×</mo><mn>3</mn> </mrow></math><br /><br /><math><mo>=</mo><mn>45</mn><mtext>&nbsp;</mtext><mtext mathvariant=\"normal\">y</mtext><mtext mathvariant=\"normal\">e</mtext><mtext mathvariant=\"normal\">a</mtext><mtext mathvariant=\"normal\">r</mtext></math>"
