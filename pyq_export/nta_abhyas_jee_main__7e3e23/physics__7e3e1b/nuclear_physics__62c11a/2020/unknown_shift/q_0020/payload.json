#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mtext>N</mtext></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mtext>N</mtext></mrow></mfrac></mrow></mfenced></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mrow><mtext>T</mtext></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msub></mrow><mrow><mn>0.693</mn></mrow></mfrac><mrow><mrow><mtext mathvariant=\"normal\">ln</mtext></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mtext>N</mtext></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><mtext>N</mtext></mrow></mfrac></mrow></mfenced></mrow></mrow></math> <math><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mo>&#8757;</mo><mtext>&#160;</mtext><mtext>&#160;</mtext><mtext>&#955;</mtext><mo>=</mo><mfrac><mrow><mn>0.693</mn></mrow><mrow><msub><mrow><mtext>T</mtext></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msub></mrow></mfrac></mrow></mfenced></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>15</mn></mrow><mrow><mn>0.693</mn></mrow></mfrac><mo>&#215;</mo><mrow><mrow><mtext mathvariant=\"normal\">ln</mtext></mrow><mo>&#8289;</mo><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>12</mn></mrow><mrow><mn>1.5</mn></mrow></mfrac></mrow></mfenced></mrow></mrow></math><math></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>15</mn><mn>0.693</mn></mfrac><mi>ln</mi><mo>(</mo><mn>8</mn><mo>)</mo></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfrac><mn>15</mn><mn>0.693</mn></mfrac><mo>&#215;</mo><mn>3</mn><mo>&#215;</mo><mi>ln</mi><mfenced><mn>2</mn></mfenced></math><br /><br /><math> <mrow> <mo>=</mo><mn>15</mn><mo>&#215;</mo><mn>3</mn> </mrow></math><br /><br /><math><mo>=</mo><mn>45</mn><mtext>&#160;</mtext><mtext mathvariant=\"normal\">y</mtext><mtext mathvariant=\"normal\">e</mtext><mtext mathvariant=\"normal\">a</mtext><mtext mathvariant=\"normal\">r</mte