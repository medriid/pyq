      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>23</mn><mo>.</mo><mn>6</mn><mo>&#xA0;</mo><mi>MeV</mi></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "D8LzL",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>28</mn><mo>.</mo><mn>0</mn><mo>&#xA0;</mo><mi>MeV</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PqajB",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>.</mo><mn>2</mn><mo>&#xA0;</mo><mi>MeV</mi></math>",
      "image": null,
      "isCorrect": false
    }
