  "correctValue": null,
  "solution": {
    "text": "The number of radioactive nuclei left after n half lives is<br /><br /><math><mi>N</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi>N</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mi>n</mi></mrow></msup></mrow></mfrac></math><br /><br /><br /><math><mi>for 5 days n</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br />So, <math><mi>N</mi><mo>=</mo><mfrac><mrow><mn>1000</mn><mi>x</mi></mrow><mrow><msup><mrow><mn>2</mn></mrow><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1000</mn><mi>x</mi></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>1000</mn><mi>x</mi></mrow><mrow><mn>1.414</mn></mrow></mfrac><mo>=</mo><mfenced separators=\"|\"><mrow><mn>0.707</mn></mrow></mfenced><mn>1000</mn><mi>x</mi></math><br /><br /><math><mo>=</mo><mn>707</mn><mi>x</mi></math>",
    "image": null
  },
