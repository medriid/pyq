  "question": {
    "text": "Some amount of a radioactive substance (half-life = 10 days) is spread inside a room and consequently, the level of radiation becomes 50 times the permissible level for normal occupancy of the room. After how many days will the room be safe for occupation?",
    "image": null
  },
  "options": [
    {
      "id": "8VPG1",
      "text": "<math><mn>20</mn></math>  days",
      "image": null,
