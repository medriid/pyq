  "question": {
    "text": "How much <math><msup><mrow><mi>U</mi></mrow><mrow><mn>235</mn></mrow></msup></math> is consumed in a day in an atomic power house operating at <math><mn>400</mn><mi>&nbsp;</mi><mi>M</mi><mi>W</mi><mo>,</mo><mi>&nbsp;</mi></math> provided the whole of the mass of <math><msup><mrow><mi>U</mi></mrow><mrow><mn>235</mn></mrow></msup></math> is converted into energy?"
  },
  "options": [
    {
      "text": "0.384g",
      "is_correct": true
    },
    {
      "text": "0.386g",
      "is_correct": false
    },
