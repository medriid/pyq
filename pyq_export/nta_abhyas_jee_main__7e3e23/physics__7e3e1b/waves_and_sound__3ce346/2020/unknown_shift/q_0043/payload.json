  "question": {
    "text": "An open pipe is in resonance in 2<sup>nd</sup> harmonic with frequency f<sub>1</sub>. Now one end of the tube is closed and frequency is increased to <em>f</em><sub>2</sub> such that the resonance again occurs in n<sup>th</sup> harmonic. Choose the correct option."
  },
  "options": [
    {
      "text": "<math> <mrow> <mtext>n</mtext> <mo>=</mo> <mn>3</mn> <mtext>,&nbsp;</mtext> <msub> <mrow> <mi>f</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> <mo>=</mo> <mfrac> <mrow> <mn>3</mn> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> <msub> <mrow> <mi>f</mi><mo>⁡</mo> </mrow> <mn>1</mn> </msub> </mrow> </math>",
      "is_correct": false
