    {
      "text": "<math> <mrow> <mtext>n</mtext> <mo>=</mo> <mn>3</mn> <mtext>,&nbsp;</mtext> <msub> <mrow> <mi></mi><mi>f</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> <mo>=</mo> <mfrac> <mrow> <mn>5</mn> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> <msub> <mrow> <mi></mi><mi>f</mi><mo>⁡</mo> </mrow> <mn>1</mn> </msub> </mrow> </math>",
      "is_correct": false
