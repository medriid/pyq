mtext> </msubsup> <mn>2</mn> <msup> <mtext>π</mtext> <mn>2</mn> </msup> <msup> <mrow> <mtext>μ</mtext> <mtext>f</mtext> </mrow> <mn>2</mn> </msup> <msup> <mi>a</mi> <mn>2</mn> </msup> <mspace width=\"0.5em\"></mspace> <msup> <mtext>sin</mtext> <mn>2</mn> </msup> <mi></mi><mi></mi><mi>k</mi><mo>⁡</mo> <mi>x</mi> <mspace width=\"0.5em\"></mspace> <mtext>d</mtext> <mi>x</mi> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo> <msup> <mtext>π</mtext> <mn>2</mn> </msup> <msup> <mrow> <mtext>μ</mtext> <mtext>f</mtext> </mrow> <mn>2</mn> </msup> <msup> <mi>a</mi> <mn>2</mn> </msup> <mo>[</mo> <mi>x</mi> <mo>-</mo> <mfrac> <mrow> <mtext>sin</mtext> <mn>2</mn> <mi></mi><mi>k</mi><mo>⁡</mo> <mi>x</mi> </mrow> <mrow> <mn>2</mn> </mrow> </mfrac> <msubsup> <mo>]</mo> <mn>0</mn> <mn>L</mn> </msubsup> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo> <msup> <mtext>π</mtext> <mn>2</mn> </msup> <msup> <mrow> <mtext>μ</mtext> <mtext>f</mtext> </mrow> <mn>2</mn> </msup> <msup> <mi>a</mi> <mn>2</mn> </msup> <mtext>L</mtext> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo> <msup> <mtext>π</mtext> <mn>2</mn> </msup> <mtext>μ</mtext> <mfrac> <mrow> <msup> <mtext>V</mtext> <mn>2</mn> </msup> </mrow> <mrow> <msup> <mtext>λ</mtext> <mn>2</mn> </msup> </mrow> </mfrac> <msup> <mi>a</mi> <mn>2</mn> </msup> <mtext>L</mtext> <mo>=</mo> <mfrac> <mrow> <msup> <mtext>π</mtext> <mn>2</mn> </msup> </mrow> <mrow> <mn>4</mn> <msup> <mtext>L</mtext> <mn>2</mn> </msup> </mrow> </mfrac> <mspace></mspace> <mtext>T</mtext> <msup> <mi>a</mi> <mn>2</mn> </msup> <mtext>L</mtext> <mo>=</mo> <mfrac> <mrow> <msup> <mtext>π</mtext> <mn>2</mn> </msup> <msup> <mi>a</mi> <mn>2</mn> </msup> <mtext>T</mtext> </mrow> <mrow> <mn>4</mn> <mtext>L</mtext> </mrow> </mfrac> </mrow> </math>"
