  ],
  "solution": {
    "text": "Frequency of sonometer wire is given by<br /><br /><math><mi>v</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>l</mi></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>m</mi></mrow></mfrac></msqrt><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><mi>l</mi></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><mi>p</mi></mrow></mfrac></msqrt></math><br /><br /><math><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><mi>π</mi><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><msub><mrow><mi>ρ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></msqrt></math><br /><br /><math><msub><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi>π</mi><msubsup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup><msub><mrow><mi>ρ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></msqrt></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>l</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>×</mo><mfrac><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow><mrow><msubsup><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup></mrow></mfrac><mo>×</mo><mfrac><mrow><msub><mrow><mi>ρ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>ρ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></msqrt></math><br /><br /><math><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>35</mn></mrow><mrow><mn>36</mn></mrow></mfrac><msqrt><mfrac><mrow><mn>8</mn></mrow><mrow><mn>1</mn></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>16</mn></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>1</mn></mrow></mfrac></msqrt></math><br /><br /><math><mo>∵</mo><msub><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>&lt;</mo><msub><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>360&nbsp;</mn><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">z</mi></math><br /><br />Therefore,<br /><br /><math><mi>v</mi><mo>=</mo><mn>360</mn><mo>×</mo><mfrac><mrow><mn>35</mn></mrow><mrow><mn>36</mn></mrow></mfrac></math><br /><br /><math><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub></math>=350 Hz<br /><br />So, number of beats produced =<math><msub><mrow><mi>v</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br />=360-350=10"
  }
