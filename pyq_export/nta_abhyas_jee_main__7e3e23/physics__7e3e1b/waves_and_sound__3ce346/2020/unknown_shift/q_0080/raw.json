    },
    {
      "id": "CbSOe",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>/</mo><mn>2</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YNPNu",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>/</mo><mn>9</mn><mo>&#160;</mo><mi>cm</mi></math>",
      "image": null,
      "isCorrect": false
