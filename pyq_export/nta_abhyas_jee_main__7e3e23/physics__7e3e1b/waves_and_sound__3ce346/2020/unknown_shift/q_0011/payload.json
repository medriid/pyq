  "question": {
    "text": "Sound waves of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ν</mi><mo>=</mo><mn>600</mn><mo>&nbsp;</mo><mi>Hz</mi></math> fall normally on a perfectly reflecting wall. The shortest distance from the wall at which all particles will have a maximum amplitude of vibration will be (speed of sound=<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>300</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi><mo>&nbsp;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>1</mn></mrow></msup></math>)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>7</mn><mn>8</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi></math>",
