  "question": {
    "text": "When a train approaches a stationary observer, the apparent frequency of the whistle is <math><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup></math> and when the same train recedes away from the observer, the apparent frequency is&nbsp;<math><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></math>. The apparent frequency&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>, when the observer moves with the train is",
    "image": null
  },
  "options": [
    {
      "id": "hBlYp",
      "text": "<math><mi>n</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><mo>+</mo><mi>n</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "buKQ2",
      "text": "<math><mi>n</mi><mo>=</mo><msqrt><msup><mrow><mi>n</mi></mrow><mrow><mi>&prime;</mi></mrow></msup><msup><mrow><mi>n</mi></mrow><mrow><mi>&prime;</mi><mi>&prime;</mi></mrow></msup></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4SFTh",
      "text": "<math><mi>n</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><mo>+</mo><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "SnL5Z",
      "text": "<math><mi>n</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><mo>-</mo><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    }
