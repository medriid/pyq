  "correctValue": null,
  "solution": {
    "text": "<math><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><mo>=</mo><mfrac><mrow><mi>v</mi><mi>n</mi></mrow><mrow><mi>v</mi><mo>-</mo><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow></mfrac><mo>,</mo><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup><mo>=</mo><mfrac><mrow><mi>v</mi><mi>n</mi></mrow><mrow><mi>v</mi><mo>+</mo><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>∴</mo><mfrac><mrow><mi>n</mi></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup></mrow></mfrac><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow><mrow><mi>v</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>n</mi></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow></mfrac><mo>=</mo><mn>1</mn><mo>+</mo><mfrac><mrow><msub><mrow><mi>v</mi></mrow><mrow><mi>s</mi></mrow></msub></mrow><mrow><mi>v</mi></mrow></mfrac></math><br /><br />Adding the two, we get<br /><br /><math><mfrac><mrow><mi>n</mi></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>n</mi></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow></mfrac><mo>=</mo><mn>2</mn><mi>&nbsp;</mi><mi>&nbsp;</mi><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>n</mi><mo>=</mo><mfrac><mrow><mn>2</mn><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi></mrow></msup><mo>+</mo><msup><mrow><mi>n</mi></mrow><mrow><mi>′</mi><mi>′</mi></mrow></msup></mrow></mfrac></math>",
