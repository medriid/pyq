  "question": {
    "text": "<p>A sound wave of frequency <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>f</mi></math>&nbsp;propagating through the air at a speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>c</mi></math>&nbsp;is reflected from a surface which is moving away from the source with a constant speed <math> <mi>v</mi> </math>.&nbsp;The frequency of the reflected wave as perceived by the observer at the position of the source will be</p>\r",
    "image": null
  },
  "options": [
    {
      "id": "3YLun",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>f</mi><mo>(</mo><mi>c</mi><mo>+</mo><mn>2</mn><mi>v</mi><mo>)</mo></mrow><mrow><mi>c</mi><mo>+</mo><mi>v</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ojadb",
      "text": "<math><mfrac><mrow><mi>f</mi><mo>(</mo><mi>c</mi><mo>+</mo><mi>v</mi><mo>)</mo></mrow><mrow><mi>c</mi><mo>-</mo><mi>v</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Vb78Z",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>f</mi><mo>(</mo><mi>c</mi><mo>-</mo><mi>v</mi><mo>)</mo></mrow><mrow><mi>c</mi><mo>+</mo><mi>v</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5QfWX",
      "text": "<math><mfrac><mrow><mi>f</mi><mo>(</mo><mi>c</mi><mo>-</mo><mi>v</mi><mo>)</mo></mrow><mrow><mi>c</mi><mo>-</mo><mn>2</mn><mi>v</mi></mrow></mfrac></math>",
      "image": null,
