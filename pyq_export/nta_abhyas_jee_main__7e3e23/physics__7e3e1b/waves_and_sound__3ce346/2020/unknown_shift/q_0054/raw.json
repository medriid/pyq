      "isCorrect": false
    },
    {
      "id": "oGREj",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>85</mn><mo>&#xA0;</mo><mi>Hz</mi></math>",
      "image": null,
