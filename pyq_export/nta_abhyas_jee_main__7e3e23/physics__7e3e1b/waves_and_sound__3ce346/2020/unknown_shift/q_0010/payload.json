  "question": {
    "text": "A pipe of length&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>.</mo><mn>5</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi></math> closed at one end is filled with gas and resonates in its fundamental mode with a tuning fork. Another open organ pipe of same dimensions filled with air resonates in its fundamental mode with the same tuning fork. If this experiment is performed at&nbsp;&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>°</mo><mo>&nbsp;</mo><mi mathvariant=\"normal\">C</mi></math>, then the&nbsp;speed of sound at&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>&nbsp;</mo><mo>°</mo><mi mathvariant=\"normal\">C</mi></math>&nbsp;in the same gas is (Speed of sound in air is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>360</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi><mo>/</mo><mi mathvariant=\"normal\">s</mi></math>)"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>580</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi><mo>/</mo><mi mathvariant=\"normal\">s</mi></math>",
      "is_correct": false
