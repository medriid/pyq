    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>683</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>/</mo><mi mathvariant=\"normal\">s</mi></math>",
