  "solution": {
    "text": "Fundamental frequency of the first wire<br /><br /><math><mi>f</mi><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mi>&nbsp;</mi><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>m</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><msubsup><mrow><mi>π</mi><mi>r</mi></mrow><mrow><mn>1</mn><mi>&nbsp;</mi></mrow><mrow><mn>2</mn></mrow></msubsup><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt></math><br /><br />The first overtone <math><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>2</mn><mi>f</mi><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt></math><br /><br />The second overtone of the second wire<br /><br /><math><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt></math><br /><br /><math><msub><mrow><mi>f</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>f</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mfrac><mrow><mn>1</mn></mrow><mrow><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>&nbsp;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mi>&nbsp;</mi><msqrt><mfrac><mrow><mi>T</mi></mrow><mrow><mi>π</mi><mi>ρ</mi></mrow></mfrac><mi>&nbsp;</mi></msqrt></math><br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mn>3</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mfrac><mrow><msub><mrow><mi>L</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>L</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>.</mo><mfrac><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></math><br /><br /><math><mo>=</mo><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>.</mo><mfrac><mrow><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mn>2</mn><msub><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac></math> <math><mo>[</mo><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>r</mi></mrow><mrow><mn>1<