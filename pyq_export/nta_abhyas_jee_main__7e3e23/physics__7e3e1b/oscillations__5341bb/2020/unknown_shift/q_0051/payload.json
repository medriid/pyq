      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mn>1</mn></msub><mo>=</mo><mo>-</mo><msub><mi>k</mi><mn>1</mn></msub><mi>x</mi><mo>;</mo><mo>&#160;</mo><msub><mi>F</mi><mn>2</mn></msub><mo>=</mo><mo>-</mo><msub><mi>k</mi><mn>2</mn></msub><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mo>-</mo><mfenced><mfrac><msub><mi>k</mi><mn>1</mn></msub><mi>m</mi></mfrac></mfenced><mi>x</mi><mo>;</mo><mo>&#160;</mo><msub><mi>a</mi><mn>2</mn></msub><mo>=</mo><mo>-</mo><mfenced><mfrac><msub><mi>k</mi><mn>2</mn></msub><mi>m</mi></mfrac></mfenced><mi>x</mi></math></p><p>Also,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>a</mi><mn>1</mn></msub><mo>=</mo><mo>-</mo><msubsup><mi>&#969;</mi><mn>1</mn><mn>2</mn></msubsup><mi>x</mi><mo>;</mo><mo>&#160;</mo><msub><mi>a</mi><mn>2</mn></msub><mo>=</mo><mo>-</mo><msubsup><mi>&#969;</mi><mn>2</mn><mn>2</mn></msubsup><mi>x</mi></math></p><p>Now, resultant force <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi><mo>=</mo><msub><mi>F</mi><mn>1</mn></msub><mo>+</mo><msub><mi>F</mi><mn>2</mn></msub><mo>=</mo><mo>-</mo><msub><mi>k</mi><mn>1</mn></msub><mi>x</mi><mo>-</mo><msub><mi>k</mi><mn>2</mn></msub><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>-</mo><mi>k</mi><mi>x</mi><mo>=</mo><mo>-</mo><msub><mi>k</mi><mn>1</mn></msub><mi>x</mi><mo>-</mo><msub><mi>k</mi><mn>2</mn></msub><mi>x</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>k</mi><mo>=</mo><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>k</mi><mn>2</mn></msub></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><msup><mi>&#969;</mi><mn>2</mn></msup><mo>=</mo><mi>m</mi><msubsup><mi>&#969;</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mi>m</mi><msubsup><mi>&#969;</mi><mn>2</mn><mn>2</mn></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>&#969;</mi><mn>2</mn></msup><mo>=</mo><msubsup><mi>&#969;</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>&#969;</mi><mn>2</mn><mn>2</mn></msubsup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><mi>T</mi></mfrac></mfenced><mn>2</mn></msup><mo>=</mo><msup><mfenced><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><msub><mi>T</mi><mn>1</mn></msub></mfrac></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mfrac><mrow><mn>2</mn><mi>&#960;</mi></mrow><msub><mi>T</mi><mn>2</mn></msub></mfrac></mfenced><mn>2</mn></msup></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msup><mi>T</mi><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mn>1</mn><msubsup><mi>T</mi><mn>1</mn><mn>2</mn></msubsup></mfrac><mo>+</mo><mfrac><mn>1</mn><msubsup><mi>T</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi>T</mi><mo>=</mo><mfrac><mrow><msub><mi>T</mi><mn>1</mn></msub><msub><mi>T</mi><mn>2</mn></msub></mrow><msqrt><msubsup><mi>T</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>T</mi><mn>2</mn><mn>2</mn></msubsup></msqrt></mfrac></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mi>T</mi><mo>=</mo><mfrac><mrow><mfrac><mn>4</mn><mn>5</mn></mfrac><mo>&#215;</mo><mfrac><mn>3</mn><mn>5</mn></mfrac></mrow><msqrt><msup><mfenced><mfrac><mn>4</mn><mn>5</mn></mfrac></mfenced><mn>2</mn></msup><mo>+</mo><msup><mfenced><mfrac><mn>3</mn><mn>5</mn></mfrac></mfenced><mn>2</mn></msup></msqrt></mfrac><mo>=</mo><mfrac><mn>12</mn><mn>25</mn></mfrac><mo>&#160;</mo><mi mathvariant=\"normal\">s</mi></math></p>"
  }
