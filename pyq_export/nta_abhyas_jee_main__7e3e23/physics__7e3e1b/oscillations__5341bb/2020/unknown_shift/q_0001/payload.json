    "text": "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<img alt=\"\" src=\"assets\\st0001_ff1963526fdf.jpg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 181px; height: 210px;\" /><br /><br /><br />Given <math> <mrow> <mi>&#969;</mi> <mo>=</mo> <mn>2</mn> <mn>5</mn> <mo>rad/s</mo> </mrow> </math> and A = 1.6 cm<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;&#160;&#160;&#160;</mo><mi>&#969;</mi><mo>=</mo><msqrt><mfrac><mtext mathvariant=\"italic\">k</mtext><mtext mathvariant=\"italic\">m</mtext></mfrac></msqrt><mo>=</mo><mn>2</mn><mn>5</mn></math> <math> <mrow> <mo>&#8658;</mo><mi>k</mi><mo>=</mo><msup> <mrow> <mn>25</mn></mrow> <mn>2</mn> </msup> </mrow> </math><br /><br />Maximum compression in the spring<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><msub><mi>x</mi><mtext>o</mtext></msub><mo>+</mo><mi>A</mi></math><br /><br /><math> <mrow> <mo>=</mo> <mfrac> <mrow> <mtext>mg</mtext> </mrow> <mrow> <mtext>k</mtext> </mrow> </mfrac> <mo>+</mo> <mtext>A</mtext> </mrow> </math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mfenced><mrow><mfrac><mrow><mn>1</mn><mo>&#215;</mo><mn>1</mn><mn>0</mn><mo>&#215;</mo><mn>1</mn><mn>0</mn><mn>0</mn></mrow><mrow><mn>2</mn><mn>5</mn><mo>&#215;</mo><mn>2</mn><mn>5</mn></mrow></mfrac><mo>+</mo><mtext>1.6</mtext></mrow></mfenced><mo>&#160;</mo><mtext>cm</mtext></math><br /><br /><math> <mrow> <mo>=</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mfrac> <mrow> <mn>8</mn> </mrow> <mrow> <mn>5</mn> </mrow> </mfrac> <mo>+</mo> <mtext>1.6</mtext> </mrow> </mfenced> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo> <mtext>1.6</mtext> <mo>+</mo> <mtext>1.6</mtext> </mrow> </math><br /><br /><math> <mrow> <mo>=</mo> <mtext>&#160;3.2 cm</mtext> </mrow> </math><br /><br /><math> <mrow> <mo>&#8756;</mo>&#160; </mrow> </math><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>F</mi><mrow><mi>m</mi><mi>a