  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi><mo>=</mo><msub><mi>E</mi><mi>c</mi></msub><mo>(</mo><mn>1</mn><mo>+</mo><mi>K</mi><mi>sin</mi><mo>⁡</mo><mrow><msub><mi>ω</mi><mn>2</mn></msub><mi>t</mi><mo>)</mo><mi>sin</mi></mrow><mi>&nbsp;</mi><msub><mi>ω</mi><mn>1</mn></msub><mi>t</mi></math><br /><br /><math><mi>Y</mi><mo>=</mo><msub><mrow><mi>E</mi></mrow><mrow><mi>c</mi></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mrow><mi>t</mi><mo>+</mo><msub><mrow><mi>E</mi></mrow><mrow><mi>c</mi></mrow></msub><mi>&nbsp;</mi><mi>k</mi><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>t</mi></mrow></mrow></math><br /><br /><math><mi>Y</mi><mo>=</mo><msub><mrow><mi>E</mi></mrow><mrow><mi>c</mi></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>t</mi></mrow></mrow><mo>+</mo><mfrac><mrow><msub><mrow><mi>E</mi></mrow><mrow><mi>c</mi></mrow></msub><mi>K</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mrow><mrow><mi mathvariant=\"normal\">cos</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mi>t</mi></mrow></mrow><mfrac><mrow><msub><mrow><mi>E</mi></mrow><mrow><mi>c</mi></mrow></msub><mi>K</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mfenced separators=\"|\"><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfenced><mi>t</mi></math><br />Thus there are three simple harmonic waves of frequency <math><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>,</mo><mi>&nbsp;</mi><mfenced separators=\"|\"><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math> and <math><mfenced separators=\"|\"><mrow><msub><mrow><mi>ω</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mi>ω</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced></math>"
