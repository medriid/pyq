    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><mfrac><mrow><mi>q</mi><mi>&#x3C3;</mi></mrow><msub><mi>&#x3B5;</mi><mn>0</mn></msub></mfrac><msqrt><mfrac><mrow><mn>2</mn><mi>k</mi></mrow><mi>m</mi></mfrac></msqrt></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><mfrac><mrow><mi>q</mi><mi>&#x3C3;</mi></mrow><mrow><mn>2</mn><msub><mi>&#x3B5;</mi><mn>0</mn></msub></mrow></mfrac><msqrt><mfrac><mi>k</mi><mi>m</mi></mfrac></msqrt></math>",
