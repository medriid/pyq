  "question": {
    "text": "A mass <math><mi>M</mi></math> is suspended from a spring of negligible mass. The spring is pulled a little and then released so that the mass executes SHM of time period <math><mi>T</mi></math>. If the mass is increased by <math><mi>m</mi></math>, the time period become <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>5</mn><mi>T</mi></mrow><mn>3</mn></mfrac></math>. Then the ratio of <math><mfrac><mrow><mi>m</mi></mrow><mrow><mi>M</mi></mrow></mfrac></math> is",
    "image": null
  },
  "options": [
    {
      "id": "MTjUJ",
      "text": "<math><mrow><mrow><mn>3</mn></mrow><mo>/</mo><mrow><mn>5</mn></mrow></mrow></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "bKkEX",
      "text": "<math><mrow><mrow><mn>25</mn></mrow><mo>/</mo><mrow><mn>9</mn></mrow></mrow></math>",
