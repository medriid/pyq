    {
      "text": "<math><mn>2</mn><mi>a</mi><mfrac><mrow><msup><mrow><mi>R</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>s</mi></mrow></mfrac></math>",
