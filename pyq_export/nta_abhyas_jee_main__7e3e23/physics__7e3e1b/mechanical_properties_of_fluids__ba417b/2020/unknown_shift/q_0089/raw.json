  "question": {
    "text": "A cone of radius R and height H, is hanging inside a liquid of density&nbsp;<math><mrow><mtext>ρ</mtext> </mrow> </math> by means of a string as shown in the figure. The force, due to the liquid acting on the slant surface of the cone is<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/KT0000225_Ques1_1.jpg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 168px; height: 222px;\" />",
    "image": null
  },
  "options": [
    {
      "id": "VcntP",
      "text": "<math><mrow>  <mtext>&rho;</mtext>  <mtext>&pi;</mtext>  <mtext>g</mtext>  <mtext>H</mtext>  <msup>          <mtext>R</mtext>        <mn>2</mn>  </msup></mrow></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "luxXz",
      "text": "<math><mrow>  <mtext>&pi;</mtext>  <mtext>&rho;</mtext>  <mtext>H</mtext>  <msup>          <mtext>R</mtext>        <mn>2</mn>  </msup></mrow></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mS0yG",
      "text": "<math><mrow>  <mfrac>    <mrow>      <mn>4</mn>    </mrow>    <mrow>      <mn>3</mn>    </mrow>  </mfrac>  <mtext>&pi;</mtext>  <mtext>&rho;</mtext>  <mtext>g</mtext>  <mtext>H</mtext>  <msup>          <mtext>R</mtext>        <mn>2</mn>  </msup></mrow></math>",
      "image": null,
      "isCorrect": false
