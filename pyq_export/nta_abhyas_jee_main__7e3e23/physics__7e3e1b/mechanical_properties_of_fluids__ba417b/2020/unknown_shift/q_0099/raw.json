  "question": {
    "text": "<p>Two chemically non-reactive liquids are placed in a U-shaped tube as shown in the figure. The height of any liquid above a common reference line is</p>\r\r<p><br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/WhatsApp_Image_2020-06-02_at_5.18.19_PM.jpeg\" style=\"width: 200px; height: 171px;\" /></p>\r",
    "image": null
  },
  "options": [
    {
      "id": "uvDaa",
      "text": "directly proportional to their densities",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PzP16",
      "text": "inversely proportional to their densities",
      "image": null,
      "isCorrect": true
    },
    {
