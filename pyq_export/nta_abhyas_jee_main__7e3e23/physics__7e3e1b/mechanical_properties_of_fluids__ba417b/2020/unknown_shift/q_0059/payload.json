  "solution": {
    "text": "<br /><img alt=\"\" src=\"assets\\st0059_225f118f7b90.png\" style=\"width: 280px; height: 94px;\" /><br /><br />If the level in narrow tube goes down by h<sub>1</sub> then in wider tube goes up to h<sub>2</sub>,<br /><br />Now, <math><mi mathvariant=\"normal\">&pi;</mi><msup><mrow><mi>r</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>h</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mi mathvariant=\"normal\">&pi;</mi><mo>(</mo><mi>n</mi><mi>r</mi><msup><mrow><mo>)</mo></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mo>&rArr;</mo><msub><mrow><mi>h</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br />Now, pressure at <math><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">t</mi><mi>&nbsp;</mi><mi>A</mi><mi>&nbsp;</mi><mo>=</mo><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi>B</mi></math><br /><br /><math><mi>h</mi><mi mathvariant=\"normal\">&rho;</mi><mi>g</mi><mo>=</mo><mo>(</mo><msub><mrow><mi>h</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>)</mo><mi mathvariant=\"normal\">&rho;</mi><mi mathvariant=\"normal\">&prime;</mi><mi>g</mi></math><br /><br /><math><mo>&rArr;</mo><mi>h</mi><mi mathvariant=\"normal\">&nbsp;</mi><mo>=</mo><mfenced separators=\"|\"><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><msub><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><msub><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfenced><mi>s</mi><mi>g</mi><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi>s</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">&rho;</mi></mrow><mrow><mi mathvariant=\"normal\">&prime;</mi></mrow></msup></mrow><mrow><mi mathvariant=\"normal\">&rho;</mi></mrow></mfrac></mrow></mfenced></math><br /><br /><math><mo>&rArr;</mo><msub><mrow><mi>h</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi>h</mi></mrow><mrow><mo>(</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn><mo>)</mo><mi>s</mi></mrow></mfrac></math>"
