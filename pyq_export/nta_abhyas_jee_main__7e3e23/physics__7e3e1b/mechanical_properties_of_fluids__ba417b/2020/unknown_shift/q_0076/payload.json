    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mn>0</mn></msub><mo>+</mo><mi>&#x3C1;</mi><mi mathvariant=\"normal\">g</mi><mi>h</mi></math>",
      "is_correct": false
