      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mn>0</mn></msub><mo>+</mo><mi>&#x3C1;</mi><mi mathvariant=\"normal\">g</mi><mi>h</mi><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>&#x3C1;</mi><msup><mi>v</mi><mn>2</mn></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mn>0</mn></msub><mo>+</mo><mi>&#961;</mi><mi mathvariant=\"normal\">g</mi><mi>h</mi><mi mathvariant=\"normal\">&#160;</mi><mo>&#8211;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>&#961;</mi><msup><mi mathvariant=\"normal\">v</mi><mn>2</mn></msup></math>",
