  "question": {
    "text": "If the work done in blowing a soap bubble of volume&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">V</mi></math>&nbsp;is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">W</mi></math>, then the work done in blowing a soap bubble of volume&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi mathvariant=\"normal\">V</mi></math>&nbsp;under the same conditions will be",
    "image": null
  },
  "options": [
    {
      "id": "IX4X9",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "H20NM",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7IMgY",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>2</mn><mi mathvariant=\"normal\">&nbsp;</mi></msqrt><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "fkxvT",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>4</mn><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup><mi mathvariant=\"normal\">W</mi></math>",
      "image": null,
