      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>9</mn><mrow><mn>2</mn><mn>2</mn></mrow></mfrac><mi>R</mi><mi>b</mi></math>",
      "image": null,
      "isCorrect": true
    },
