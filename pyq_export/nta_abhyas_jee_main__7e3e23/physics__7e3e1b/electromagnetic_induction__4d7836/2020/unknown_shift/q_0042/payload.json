    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mi>a</mi></mrow></mfenced><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>+</mo><mi>a</mi></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": true
