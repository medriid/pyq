    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>-</mo><mi>a</mi></mrow></mfenced><mn>2</mn></msup></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msup><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>+</mo><mi>a</mi></mrow></mfenced><mn>2</mn></msup></mfrac></math>",
      "is_correct": false
