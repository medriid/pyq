  ],
  "solution": {
    "text": "<p><img alt=\"\" src=\"assets\\st0042_a8033174d6bf.png\" /><br /><br />The potential difference across AB is<br /><br /><math><msub><mrow><mi>V</mi></mrow><mrow><mi>A</mi></mrow></msub><mo>-</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>B</mi></mrow></msub><mo>=</mo><msub><mrow><mi>B</mi></mrow><mrow><mn>1</mn></mrow></msub><mi>&#160;</mi><mi>a</mi><mo>.</mo><mi>V</mi><mo>.</mo></math><br /><br /><math><mo>&#8658;</mo><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>&#956;</mi></mrow><mrow><mi>i</mi></mrow></msub></mrow><mrow><mn>2</mn><mi>&#960;</mi><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mfrac><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfrac><mi>&#160;</mi><mi>a</mi><mi>V</mi></math><br /><br />The potential difference across CD is<br /><br /><math><msub><mrow><mi>V</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>-</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>D</mi></mrow></msub><mo>=</mo><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub><mi>&#160;</mi><mi>a</mi><mo>.</mo><mi>V</mi></math><br /><br /><math><msub><mrow><mi>B</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi>&#956;</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>i</mi></mrow><mrow><mn>2</mn><mi>&#960;</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mfrac><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfrac></math><br /><br /><math><msub><mrow><mi>V</mi></mrow><mrow><mi>C</mi></mrow></msub><mo>-</mo><msub><mrow><mi>V</mi></mrow><mrow><mi>D</mi></mrow></msub><mo>=</mo><mi>&#160;</mi><mfrac><mrow><msub><mrow><mi>&#956;</mi></mrow><mrow><mn>0</mn></mrow></msub><mi>i</mi></mrow><mrow><mn>2</mn><mi>&#960;</mi><mfenced separators=\"|\"><mrow><mi>x</mi><mo>+</mo><mfrac><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfenced></mrow></mfrac><mi>&#160;</mi><mi>a</mi><mi>V</mi></math><br /><br />Net Potential difference&nbsp;<math><mo>=</mo><mfrac><mrow><msub><mrow><mi>&#956;</mi></mrow><mrow><mi>i</mi></mrow></msub><mi>&#160;</mi><mi>a</mi><mi>V</mi></mrow><mrow><mn>2</mn><mi>&#160;</mi><mi>&#960;</mi></mrow></mfrac><mi>&#160;</mi><mfenced separators=\"|\"><mrow><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi><mi>&#160;</mi><mo>-</mo><mi>&#160;</mi><mfrac><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac><mo>-</mo><mi>&#160;</mi><mfrac><mrow><mn>1</mn></mrow><mrow><mi>x</mi><mi>&#160;</mi><mo>+</mo><mi>&#160;</mi><mfrac><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></mfrac></mrow></mfrac></mrow></mfenced></math><br /><br /><math> <mrow> <mrow><mo>(</mo> <mrow> <msub> <mi>V</mi> <mi>A</mi> </msub> <mo>&#8722;</mo><msub> <mi>V</mi> <mi>B</mi> </msub> </mrow> <mo>)</mo></mrow><mo>&#8722;</mo><mrow><mo>(</mo> <mrow> <msub> <mi>V</mi> <mi>C</mi> </msub> <mo>&#8722;</mo><msub> <mi>V</mi> <mi>D</mi> </msub> </mrow> <mo>)</mo></mrow><mo>=</mo><mfrac> <mrow> <mi>&#956;</mi><mi>i</mi><mi>a</mi> </mrow> <mrow> <mn>2</mn><mi>&#960;</mi> </mrow> </mfrac> <mrow><mo>(</mo> <mrow> <mfrac> <mrow> <mn>2</mn><mi>a</mi> </mrow> <mrow> <msup> <mi>x</mi> <mn>2</mn> </msup> <mo>&#8722;</mo><mfrac> <mrow> <msup> <mi>a</mi> <mn>2</mn> </msup> </mrow> <mn>4</mn> </mfrac> </mrow> </mfrac> </mrow> <mo>)</mo></mrow> </mrow> </math><br /><br /><math><mo>&#8733;</mo><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>-</mo><msup><mrow><mi>a</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mo>&#8733;</mo><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mfrac><mrow><mn>1</mn></mrow><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>x</mi><mo>+</mo><mi>a</mi></mrow></mfenced><mo>(</mo><mn>2</mn><mi>x</mi><mo>-</mo><mi>a</mi><mo>)</mo></mrow></mfrac><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi><mi>&#160;</mi></math></p>"
  }
