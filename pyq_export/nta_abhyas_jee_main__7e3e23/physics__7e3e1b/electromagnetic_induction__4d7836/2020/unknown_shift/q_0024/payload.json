    {
      "text": "<math> <mrow> <mtext>Q</mtext> <mo>=</mo> <mtext>R</mtext> <mfrac> <mrow> <mo>&Delta;</mo> <mi>ϕ</mi> </mrow> <mrow> <mo>&Delta;</mo> <mtext>t</mtext> </mrow> </mfrac> </mrow> </math>",
