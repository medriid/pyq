    "text": "<img alt=\"\" src=\"assets\\st0001_c26bfeafff7f.jpeg\" style=\"width: 250px; height: 159px;\" /><br /><br /><math><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">ϕ</mi><mo>=</mo><mi mathvariant=\"italic\">B</mi><mo>.</mo><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">A</mi><mo>=</mo><mn>2</mn><mi mathvariant=\"italic\">B</mi><mi mathvariant=\"italic\">&nbsp;</mi><mi mathvariant=\"italic\">x</mi><mi mathvariant=\"italic\">&nbsp;</mi><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">y</mi></math> and <math><mi mathvariant=\"italic\">y</mi><mo>=</mo><msup><mrow><mi mathvariant=\"italic\">k</mi><mi mathvariant=\"italic\">x</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mo>∴</mo><mi mathvariant=\"italic\">x</mi><mo>=</mo><msqrt><mfrac><mrow><mi mathvariant=\"italic\">y</mi></mrow><mrow><mi mathvariant=\"italic\">k</mi></mrow></mfrac></msqrt></math><br /><br /><math><mo>∴</mo><mi mathvariant=\"italic\">&nbsp;Emf E</mi><mo>=</mo><mfrac><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">ϕ</mi></mrow><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">t</mi></mrow></mfrac><mo>=</mo><mn>2</mn><mi mathvariant=\"italic\">B</mi><msqrt><mfrac><mrow><mi mathvariant=\"italic\">y</mi></mrow><mrow><mi mathvariant=\"italic\">k</mi></mrow></mfrac></msqrt><mfrac><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">y</mi></mrow><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">t</mi></mrow></mfrac></math><br /><br />using <math><msup><mrow><mi mathvariant=\"italic\">v</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><mn>2</mn><mi mathvariant=\"italic\">a</mi><mi mathvariant=\"italic\">s</mi></math><br /><br /><math><mfrac><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">y</mi></mrow><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">t</mi></mrow></mfrac><mo>=</mo><mi mathvariant=\"italic\">v</mi><mo>=</mo><msqrt><mn>2</mn><mi mathvariant=\"italic\">a</mi><mi mathvariant=\"italic\">y</mi></msqrt></math><br /><br />or   <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"italic\">ε</mi></mrow></mfenced><mo>=</mo><mfrac><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">ϕ</mi></mrow><mrow><mi mathvariant=\"italic\">d</mi><mi mathvariant=\"italic\">t</mi></mrow></mfrac><mo>=</mo><mn>2</mn><mi mathvariant=\"italic\">B</mi><msqrt><mfrac><mrow><mi mathvariant=\"italic\">y</mi></mrow><mrow><mi mathvariant=\"italic\">k</mi></mrow></mfrac></msqrt><msqrt><mn>2</mn><mi mathvariant=\"italic\">a</mi><mi mathvariant=\"italic\">y</mi></msqrt></math><br /><br />or   <math><mfenced close=\"|\" open=\"|\" separators=\"|\"><mrow><mi mathvariant=\"italic\">ε</mi></mrow></mfenced><mo>=</mo></math><math> <mrow> <mi>B</mi><mi>y</mi><msqrt> <mrow> <mfrac> <mrow> <mn>8</mn><mi>a</mi> </mrow> <mi>k</mi> </mfrac> </mrow> </msqrt> </mrow> </math>"
