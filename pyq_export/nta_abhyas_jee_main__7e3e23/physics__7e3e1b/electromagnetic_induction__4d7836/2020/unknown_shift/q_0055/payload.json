  "question": {
    "text": "In the circuit shown below, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mn>2</mn></msub></math>&nbsp;are the steady-state values of the current through <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>L</mi><mn>1</mn></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>L</mi><mn>2</mn></msub></math>&nbsp;respectively,&nbsp;then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mn>1</mn></msub></math>&nbsp;is<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0055_f4574da3e437.jpg\" style=\"width: 250px; height: 200px;\" />"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mrow><mn>1</mn><mo>=</mo></mrow></msub><mfrac><mrow><mi>E</mi><msub><mi>L</mi><mn>2</mn></msub></mrow><mrow><mi>R</mi><mfenced><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>+</mo><msub><mi>L</mi><mn>2</mn></msub></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": true
