    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>i</mi><mrow><mn>1</mn><mo>=</mo></mrow></msub><mfrac><mrow><mi>E</mi><msub><mi>L</mi><mn>1</mn></msub></mrow><mrow><mi>R</mi><mfenced><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>+</mo><msub><mi>L</mi><mn>2</mn></msub></mrow></mfenced></mrow></mfrac></math>",
      "is_correct": false
