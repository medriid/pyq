    },
    {
      "id": "HoRvX",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>g</mi><mi>r</mi></mrow><mrow><mi>B</mi><msup><mi>l</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "image": null,
