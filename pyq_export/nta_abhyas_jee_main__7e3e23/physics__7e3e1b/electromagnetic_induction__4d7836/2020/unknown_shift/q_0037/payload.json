  "question": {
    "text": "<p>A uniform but time-varying magnetic field is present in a circular region of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">R</mi></math>. The magnetic field is perpendicular and into the plane of the paper and the magnitude of the field is increasing at a constant rate <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">α</mi></math>. There is a straight conducting rod of length <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi mathvariant=\"normal\">R</mi></math> placed as shown in the diagram. The magnitude of induced E.M.F. across the rod is<br />\r<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0037_affa0f44bba5.jpg\" style=\"width: 200px; height: 161px;\" /></p>\r"
  },
  "options": [
    {
      "text": "<math> <mrow> <mi>&pi;</mi> <msup> <mtext>R</mtext> <mn>2</mn> </msup> <mi>&alpha;</mi> </mrow> </math>",
