    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <mi>π</mi> <msup> <mtext>R</mtext> <mn>2</mn> </msup> <mi>α</mi> </mrow> <mrow> <mn>4</mn> </mrow> </mfrac> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mtext>R</mtext> <mn>2</mn> </msup> <mi>&alpha;</mi> </mrow> <mrow> <msqrt> <mn>2</mn> </msqrt> </mrow> </mfrac> </mrow> </math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mfrac> <mrow> <msup> <mrow> <mi>&pi;</mi> <mtext>R</mtext> </mrow> <mn>2</mn> </msup> <mi>&alpha;</mi> </mrow> <mrow> <mn>2</mn> </mrow> </mfrac> </mrow> </math>",
