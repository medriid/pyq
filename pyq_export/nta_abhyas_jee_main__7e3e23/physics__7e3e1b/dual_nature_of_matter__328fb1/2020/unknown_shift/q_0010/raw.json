  "question": {
    "text": "Light of two different frequencies whose photons have energies <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi>eV</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2.5</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi>eV</mi></math>, respectively, successively illuminate a metallic surface whose work function is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0.5</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi>eV</mi></math>. The ratio of maximum speeds of the emitted electrons will be",
    "image": null
  },
  "options": [
    {
      "id": "1ZUIu",
      "text": "<math><mn>1</mn><mo>:</mo><mn>4</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
