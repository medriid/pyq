</msub> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math> <mrow> <mo>=</mo> <mn>4</mn> <msub> <mtext>E</mtext> <mn>1</mn> </msub> <mo>-</mo> <msub> <mtext>E</mtext> <mn>1</mn> </msub> <mo>=</mo> <mn>3</mn> <msub> <mtext>E</mtext> <mn>1</mn> </msub> </mrow> </math>"
