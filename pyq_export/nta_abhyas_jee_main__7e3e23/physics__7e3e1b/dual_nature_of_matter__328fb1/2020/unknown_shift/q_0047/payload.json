      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mi>λ</mi></mrow><mrow><mn>3</mn></mrow></mfrac><msqrt><mfrac><mrow><mi>m</mi></mrow><mrow><mi>M</mi></mrow></mfrac></msqrt></math>",
