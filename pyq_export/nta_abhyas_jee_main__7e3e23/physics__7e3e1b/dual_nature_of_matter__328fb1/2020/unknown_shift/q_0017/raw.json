  "question": {
    "text": "A photocell is illuminated by a small bright source placed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi></math> away. When the same source of light is placed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mfrac bevelled=\"true\"><mn>1</mn><mn>2</mn></mfrac></mfenced></math> <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">m</mi></math> away, the number of electrons emitted by photocathode would",
    "image": null
  },
  "options": [
    {
      "id": "ksi07",
      "text": "decrease by a factor of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "afAk6",
      "text": "increase by a factor of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4qFjJ",
      "text": "decrease by a factor of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "dAnPk",
      "text": "increase by a factor of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn></math>",
      "image": null,
      "isCorrect": true
    }
