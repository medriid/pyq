  "solution": {
    "text": "<math><msub><mrow><mi>λ</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>350</mn><mn>&nbsp;n</mn><mn>m</mn><mo>,</mo><mtext>  </mtext><msub><mrow><mi>λ</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>540</mn><mtext> </mtext><mn>n</mn><mn>m</mn><mo>,</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mfrac><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mn>2</mn><mo>⇒</mo><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>2</mn><mi>V</mi><mi>&nbsp;</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&nbsp;</mi><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mi>V</mi></math><br /><br /><math><mfrac><mrow><mi>h</mi><mi>c</mi></mrow><mrow><msub><mrow><mi>λ</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mi>ϕ</mi><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mi>V</mi></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math><mfrac><mrow><mi>h</mi><mi>c</mi></mrow><mrow><msub><mrow><mi>λ</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mi>ϕ</mi><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac><mi>m</mi><msup><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msup></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>h</mi><mi>c</mi></mrow><msub><mi>λ</mi><mn>1</mn></msub></mfrac><mo>-</mo><mn>4</mn><mfrac><mrow><mi>h</mi><mi>c</mi></mrow><msub><mi>λ</mi><mn>2</mn></msub></mfrac><mo>=</mo><mi>ϕ</mi><mo>-</mo><mn>4</mn><mi>ϕ</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi><mi>c</mi><mfenced separators=\"|\"><mrow><mfrac><mn>4</mn><mn>540</mn></mfrac><mo>-</mo><mfrac><mn>1</mn><mn>340</mn></mfrac></mr