      "text": "<math><mn>2.4</mn><mi> </mi><mn>e</mn><mn>V</mn></math>",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Given, <math><mi>E</mi><mo>=</mo><msub><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfenced separators=\"|\"><mrow><mn>1.57</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>7</mn></mrow></msup></mrow></mfenced><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mi>c</mi><mi>t</mi></mrow></mfenced></mrow></mrow></math> ...(i)<br /><br /><math><mo>∴</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>E</mi><mo>=</mo><msub><mrow><mi>E</mi></mrow><mrow><mn>0</mn></mrow></msub><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mfrac><mrow><mi>ω</mi></mrow><mrow><mi>c</mi></mrow></mfrac><mfenced separators=\"|\"><mrow><mi>x</mi><mo>-</mo><mi>c</mi><mi>t</mi></mrow></mfenced></mrow></mrow></math> ...(ii)<br /><br />On comparing Equations (i) and (ii), we get<br /><br /><math><mfrac><mrow><mi>ω</mi></mrow><mrow><mi>c</mi></mrow></mfrac><mo>=</mo><mn>1.57</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>7</mn></mrow></msup></math><br /><br /><math><mo>=</mo><mfrac><mrow><mi>π</mi></mrow><mrow><mn>2</mn></mrow></mfrac><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>7</mn></mrow></msup></math><br /><br /><math><mi>λ</mi><mo>=</mo><mn>4</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mo>-</mo><mn>7</mn></mrow></msup><mn>&nbsp;m</mn></math><br /><br /><math><mo>=</mo><mn>400</mn><mi>&nbsp;</mi><mn>n</mn><mn>m</mn></math><br /><br />As, <math><msub><mrow><mi>ϕ</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><mfrac><mrow><mi>h</mi><mi>c</mi></mrow><mrow><mi>λ</mi></mrow></mfrac><mo>-</mo><msub><mrow><mi>E</mi></mrow><mrow><mi>K</mi></mrow></msub></math><br /><br /><math><mn>1.9</mn><mo>=</mo><mfrac><mrow><mn>1242</mn></mrow><mrow><mn>400</mn></mrow></mfrac><mo>-</mo><msub><mrow><mi>E</mi></mrow><mrow><mi>K</mi></mrow></msub></math><br /><br /><math><msub><mrow><mi>E</mi></mrow><mrow><mi>K</mi></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>3.1</mn><mo>-</mo><mn>1.9</mn></mrow></mfenced><mi>&nbsp;</mi><mi>e</mi><mi>V</mi><mo>=</mo><mn>1.2</mn><mi>&nbsp;</mi><mn>e</mn><mn>V</mn></math>"
  }
