  "question": {
    "text": "An electron of mass <math><mi>m</mi></math> and magnitude of charge <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>e</mi></math>&nbsp;at rest, gets accelerated by a constant electric field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>E</mi></math>.&nbsp;The rate of change of de-Broglie wavelength of this electron at a time <math><mi>t</mi></math>&nbsp;is (ignore relativistic effects)",
    "image": null
  },
  "options": [
    {
      "id": "fcLlg",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>d</mi><mi>&#x3BB;</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mo>-</mo><mfrac><mi>h</mi><mrow><mi>e</mi><mi>E</mi><mi>t</mi></mrow></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QMkyn",
