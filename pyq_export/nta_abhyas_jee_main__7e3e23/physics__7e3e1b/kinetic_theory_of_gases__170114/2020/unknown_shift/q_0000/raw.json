    "text": "<math><mo>∵</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></math> speed of molecule <math><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub><mo>∝</mo><msqrt><mi>T</mi></msqrt></math><br /><br />for <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mn>100</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">K</mi></math><br /><br /><math><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>1</mn></mrow></msub><mo>∝</mo><msqrt><mn>100</mn></msqrt></math><br /><br />For <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>=</mo><mn>400</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">K</mi></math><br /><br /><math><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub><mo>∝</mo><msqrt><mn>400</mn></msqrt></math><br /><br />therefore, <math><mfrac><mrow><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mn>100</mn></msqrt></mrow><mrow><msqrt><mn>400</mn></msqrt></mrow></mfrac></math><br /><br />or <math><mfrac><mrow><mi>V</mi></mrow><mrow><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></mfrac></math><br /><br />or <math><msub><mrow><mfenced separators=\"|\"><mrow><msub><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">s</mi></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>2</mn><mi>V</mi></math>",
