  "solution": {
    "text": "<img alt=\"\" src=\"assets\\st0089_fdfb4031b748.jpg\" style=\"max-width:100%; object-fit:contain\" /><br /><br /><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi><mi>g</mi><mi mathvariant=\"normal\">&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi><mo>-</mo><mi>N</mi><mo>=</mo><mfrac><mrow><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></mrow><mi>R</mi></mfrac><mo>;</mo><mi mathvariant=\"normal\">&#160;</mi><mi>N</mi><mo>=</mo><mi>m</mi><mi>g</mi><mi>&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi><mo>-</mo><mfrac><mrow><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></mrow><mi>R</mi></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>N</mi><mo>=</mo><mn>0</mn><mo>&#8658;</mo><mi>m</mi><mi>g</mi><mi mathvariant=\"normal\">&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi><mo>=</mo><mfrac><mrow><mi>m</mi><msup><mi>v</mi><mn>2</mn></msup></mrow><mi>R</mi></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi><mo>=</mo><msqrt><mi>g</mi><mi>R</mi><mi mathvariant=\"normal\">&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi></msqrt><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi><mo>=</mo><mfrac><msup><mi>v</mi><mn>2</mn></msup><mrow><mi>g</mi><mi>R</mi></mrow></mfrac><mi mathvariant=\"normal\">&#160;</mi></math> .....(i)<br /><br />From energy conservation<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mi>m</mi><mfenced open=\"[\" close=\"]\" separators=\"|\"><mrow><msup><mi>v</mi><mn>2</mn></msup><mo>-</mo><mfrac><mrow><mi>g</mi><mi>R</mi></mrow><mn>4</mn></mfrac></mrow></mfenced><mo>=</mo><mi>m</mi><mi>g</mi><mi>R</mi><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8658;</mo><mfrac><msup><mi>v</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>-</mo><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi>g</mi><mi>R</mi></mrow><mn>8</mn></mfrac><mo>=</mo><mi>g</mi><mi>R</mi><mo>-</mo><mi>g</mi><mi>R</mi><mi mathvariant=\"normal\">&#160;</mi><mi>cos</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi></math> ...(ii)<br /><br />From (i) and (ii) <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>cos&#952;</mi><mo>=</mo><mfenced separators=\"|\"><mfrac><mn>3</mn><mn>5</mn></mfrac></mfenced><mo>=</mo><mn>0</mn><mo>.</mo><mn>6</mn></math>"
