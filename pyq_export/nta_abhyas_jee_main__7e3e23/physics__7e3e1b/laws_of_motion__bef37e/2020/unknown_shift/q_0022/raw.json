    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><mn>2</mn><mi>t</mi><mi mathvariant=\"normal\">&#160;</mi><mo>&#8658;</mo><msub><mi>v</mi><mi mathvariant=\"normal\">x</mi></msub><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi>x</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><mn>2</mn><msup><mi>t</mi><mn>2</mn></msup><mi mathvariant=\"normal\">&#160;</mi><mo>&#8658;</mo><msub><mi>v</mi><mi mathvariant=\"normal\">y</mi></msub><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi>y</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>4</mn><mi>t</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#8756;</mo><mi mathvariant=\"normal\">&#160;</mi><mi>tan</mi><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi><mo>=</mo><mfrac><msub><mi>v</mi><mi mathvariant=\"normal\">y</mi></msub><msub><mi>v</mi><mi mathvariant=\"normal\">x</mi></msub></mfrac><mo>=</mo><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mn>4</mn><mi>t</mi></mrow><mn>2</mn></mfrac><mo>=</mo><mn>2</mn><mi>t</mi></math><br /><br />Differentiating with respect to time we get,<br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><msup><mi>sec</mi><mn>2</mn></msup><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mi mathvariant=\"normal\">&#160;</mi><msup><mi>tan</mi><mn>2</mn></msup><mo>&#8289;</mo><mi mathvariant=\"normal\">&#952;</mi></mrow></mfenced><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>4</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfenced><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mrow><mn>1</mn><mo>+</mo><mn>4</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">&#160;</mi><mi>t</mi><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mrow><mn>1</mn><mo>+</mo><mn>4</mn><msup><mfenced separators=\"|\"><mn>2</mn></mfenced><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>17</mn></mfrac><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">a</m