riant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><mrow><mn>1</mn><mo>+</mo><mn>4</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfenced><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mn>2</mn></math><br /><br />or <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mrow><mn>1</mn><mo>+</mo><mn>4</mn><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">&#160;</mi><mi>t</mi><mo>=</mo><mn>2</mn><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">&#160;</mi><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&#952;</mi></mrow><mrow><mi mathvariant=\"normal\">d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mrow><mn>1</mn><mo>+</mo><mn>4</mn><msup><mfenced separators=\"|\"><mn>2</mn></mfenced><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mfrac><mn>2</mn><mn>17</mn></mfrac><mi mathvariant=\"normal\">&#160;</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">a</m