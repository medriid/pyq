  "question": {
    "text": "A block of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math>&nbsp;is placed on a vertical fixed circular track and then it is given velocity&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math>&nbsp;along the track&nbsp;at position&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">A</mi></math> on track. The coefficient of friction between the block and the track varies with the angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>θ</mi></math>.&nbsp;If the block moves on track with constant speed then the coefficient of friction is<br />\r<br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/640321_que.JPG\" style=\"width: 200px; height: 114px;\" />",
    "image": null
  },
  "options": [
    {
      "id": "uk5cw",
      "text": "<math><mi>μ</mi><mo>=</mo><mfrac><mrow><mrow><mrow><mi mathvariant=\"normal\">sin</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow></mrow><mrow><mrow><mrow><mi mathvariant=\"normal\">cot</mi></mrow><mo>⁡</mo><mrow><mi>θ</mi></mrow></mrow><mo>+</mo><mfrac><mrow><msup><mrow><mi>v</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mrow><mi>R</mi><mi>g</mi></mrow></mfrac></mrow></mfrac></math>",
      "image": null,
