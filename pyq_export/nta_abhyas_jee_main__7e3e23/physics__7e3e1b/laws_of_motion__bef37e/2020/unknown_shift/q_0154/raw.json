      "image": null,
      "isCorrect": true
    },
    {
      "id": "qqAgA",
      "text": "<math><msqrt><mfrac><mrow><mn>2</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>+</mo><mn>1</mn></msqrt></math>",
