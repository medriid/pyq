  "question": {
    "text": "<p>A block of mass&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> is placed at the lowest point of a smooth vertical track of radius <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math>. In this position, the block is&nbsp;given a&nbsp;horizontal velocity&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi></math> such&nbsp;that the block is&nbsp;just able to perform a complete vertical circular motion. The&nbsp;acceleration of block,&nbsp;when its velocity is vertical is</p>\r\r<p><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/bbbbb.JPG\" style=\"width: 200px; height: 187px;\" /></p>\r",
    "image": null
  },
  "options": [
    {
      "id": "xC5wM",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "J3BzL",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>3g</mi></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "iQp4n",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>g</mi><msqrt><mn>10</mn></msqrt></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ROVCy",
      "text": "<math><mn>2</mn><msqrt><mn>2</mn></msqrt><mi>g</mi></math>",
      "image": null,
      "isCorrect": false
