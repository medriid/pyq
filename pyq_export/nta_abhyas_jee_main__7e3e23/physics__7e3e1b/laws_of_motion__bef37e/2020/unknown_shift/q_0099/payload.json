      "is_correct": false
    },
    {
      "text": "<math><mfrac><mrow><mn>7</mn><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>13</mn></mrow></mfrac><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">s</mi></math>",
