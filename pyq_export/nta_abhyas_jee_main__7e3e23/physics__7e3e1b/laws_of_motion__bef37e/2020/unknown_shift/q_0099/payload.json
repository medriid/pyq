  "question": {
    "text": "Three blocks are suspended as shown in the figure. The acceleration of the <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>500</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">g</mi></math> block is<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0099_8ebd36ce3f9c.jpg\" style=\"width: 300px; height: 160px;\" />"
  },
  "options": [
