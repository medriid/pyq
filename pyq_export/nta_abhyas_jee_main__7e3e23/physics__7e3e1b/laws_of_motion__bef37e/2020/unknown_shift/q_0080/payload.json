      "text": "<math><mfrac><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mn>2</mn></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math><mfrac><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><msqrt><mn>2</mn></msqrt></mrow></mfrac></math>",
