  "question": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/599394A.JPG\" style=\"width: 160px; height: 150px;\" /><br />\rAs shown in the figure, a bob of mass <math><mi mathvariant=\"normal\">m</mi></math> is tied to a massless string whose other end portion is wound on a fly wheel (disc) of radius <math><mi mathvariant=\"normal\">r</mi></math> and mass <math><mi mathvariant=\"normal\">m</mi><mo>.</mo></math> When released from rest the bob starts falling vertically. When it has covered a distance of <math><mi mathvariant=\"normal\">h</mi><mo>,</mo><mi mathvariant=\"normal\"></mi></math> the angular speed of the wheel will be:",
    "image": null
  },
  "options": [
    {
      "id": "RgE4n",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mi mathvariant=\"normal\">r</mi></mfrac><msqrt><mfrac><mrow><mn>4</mn><mi>gh</mi></mrow><mn>3</mn></mfrac></msqrt></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GG6Up",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">r</mi><msqrt><mfrac><mn>3</mn><mrow><mn>2</mn><mi>gh</mi></mrow></mfrac></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xvr2s",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mi mathvariant=\"normal\">r</mi></mfrac><msqrt><mfrac><mrow><mn>2</mn><mi>gh</mi></mrow><mn>3</mn></mfrac></msqrt></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "eyHIU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">r</mi><msqrt><mfrac><mn>3</mn><mrow><mn>4</mn><mi>gh</mi></mrow></mfrac></msqrt></math>",
      "image": null,
