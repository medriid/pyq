  "question": {
    "text": "What is the maximum value of the force <math><mtext>F</mtext></math> such that the block shown in the arrangement, does not move?<br /><br />\r<img alt=\"\" src=\"assets\\qt0157_c8e2894197c9.png\" style=\"max-width:100%; object-fit:contain\" style=\"width: 220px; height: 91px;\" />\r"
  },
  "options": [
    {
