      "text": "<math><mfrac><mrow><mi>R</mi></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac><msup><mrow><mi>e</mi></mrow><mrow><mo>-</mo><mn>2</mn><mi>π</mi></mrow></msup></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "O5Jp7",
      "text": "<math><mfrac><mrow><mn>2</mn><mi>π</mi><mi>R</mi></mrow><mrow><msub><mrow><mi>v</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac></math>",
      "image": null,
