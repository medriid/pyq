  "question": {
    "text": "The bob of a pendulum of mass <math><mi>m</mi></math> and length <math><mi>L</mi></math> is displaced&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>90</mn><mo>°</mo></math> from the vertical and gently released. In order that the string may not break upon passing through the lowest point, its minimum strength must be"
  },
  "options": [
    {
      "text": "<math><mi>m</mi><mi mathvariant=\"normal\">g</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>&#160;</mi><mi>m</mi><mi mathvariant=\"normal\">g</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mi>&#160;</mi><mi>m</mi><mi mathvariant=\"normal\">g</mi></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mi>&#160;</mi><mi>m</mi><mi mathvariant=\"normal\">g</mi></math>",
