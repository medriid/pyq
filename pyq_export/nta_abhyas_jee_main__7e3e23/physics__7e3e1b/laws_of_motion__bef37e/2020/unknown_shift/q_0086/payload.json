    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mi mathvariant=\"normal\">&#969;</mi><mn>2</mn></msup><mi>l</mi></mrow><mn>2</mn></mfrac></math>",
