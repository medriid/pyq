  "solution": {
    "text": "The efficiency of cycle is<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math><mi mathvariant=\"normal\">η</mi><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></math><br /><br />For adiabatic process<br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math><mi>T</mi><msup><mrow><mi>V</mi></mrow><mrow><mi mathvariant=\"normal\">γ</mi><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">t</mi></math><br /><br />For diatomic gas <math><mi mathvariant=\"normal\">γ</mi><mo>=</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>5</mn></mrow></mfrac></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><msubsup><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">γ</mi><mo>-</mo><mn>1</mn><mi>&nbsp;</mi></mrow></msubsup><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><msubsup><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow><mrow><mi mathvariant=\"normal\">γ</mi><mo>-</mo><mn>1</mn></mrow></msubsup></math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><msup><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">γ</mi><mo>-</mo><mn>1</mn><mi>&nbsp;</mi></mrow></msup></math><br /><br /><math><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><msup><mrow><mfenced separators=\"|\"><mrow><mn>32</mn></mrow></mfenced></mrow><mrow><mfrac><mrow><mn>7</mn></mrow><mrow><mn>5</mn></mrow></mfrac><mo>-</mo><mn>1</mn></mrow></msup><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><msup><mrow><mfenced separators=\"|\"><mrow><msup><mrow><mn>2</mn></mrow><mrow><mn>5</mn></mrow></msup></mrow></mfenced></mrow><mrow><mn>2</mn><mo>/</mo><mn>5</mn></mrow></msup><mo>=</mo><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>×</mo><mn>4</mn></math><br /><br /><math><msub><mrow><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>4</mn><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi mathvariant=\"normal\">η</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>=</mo><mn>0.75</mn></math>"
