  "solution": {
    "text": "<math><mi>n</mi><mo>=</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mi>p</mi><mi>V</mi><mo>=</mo><msub><mrow><mi>p</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0029179_Ans.jpg\" style=\"max-width:100%; object-fit:contain\" style=\"opacity: 0.9; width: 200px; height: 62px;\" /><br /><br /><math><msub><mrow><mi>p</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi>p</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mfrac><mrow><mn>4</mn><mi>T</mi></mrow><mrow><mi>x</mi></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><msub><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mi>p</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mfrac><mrow><mn>4</mn><mi>T</mi></mrow><mrow><mi>y</mi></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mi>p</mi><mo>=</mo><msub><mrow><mi>p</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>+</mo><mfrac><mrow><mn>4</mn><mi>T</mi></mrow><mrow><mi>z</mi></mrow></mfrac></math><br /><br />If the process takes place is vacuum then <math><msub><mrow><mi>p</mi></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><mn>0</mn></math><br /><br /><math><msub><mrow><mi>p</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>T</mi></mrow><mrow><mi>x</mi></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><msub><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mi>T</mi></mrow><mrow><mi>y</mi></mrow></mfrac><mo>,</mo><mi>&nbsp;</mi><mi>p</mi><mo>=</mo><mfrac><mrow><mn>4</mn><mi>T</mi></mrow><mrow><mi>z</mi></mrow></mfrac></math><br /><br />If process is isothermal<br /><br /><math><mo>&there4;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><msub><mrow><mi>p</mi></mrow><mrow><mn>1</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>+</mo><msub><mrow><mi>p</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi>V</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mi>p</mi><mi>V</mi></math><br /><br /><math><mo>&there4;</mo><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>&nbsp;</mi><mi>z</mi><mo>=</mo><msqrt><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></msqrt></math>",
