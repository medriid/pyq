    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><mn>200</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">℃</mi><mo>=</mo><mn>200</mn><mo>+</mo><mn>273</mn><mo>=</mo><mn>473</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">K</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><mn>0</mn><mo>&nbsp;</mo><mi mathvariant=\"normal\">℃</mi><mo>=</mo><mn>0</mn><mo>+</mo><mn>273</mn><mo>=</mo><mn>27</mn><mn>3</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">K</mi></math><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">η</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><mn>273</mn></mrow><mrow><mn>473</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>200</mn></mrow><mrow><mn>473</mn></mrow></mfrac></math><br /><br />Again, <math><msubsup><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow><mrow><mi>′</mi></mrow></msubsup><mo>=</mo><mn>0</mn><mi>℃</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mn>0</mn><mo>+</mo><mn>273</mn></mrow></mfenced><mi mathvariant=\"normal\">K</mi><mo>=</mo><mn>273</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">K</mi></math><br /><br /><math><msubsup><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow><mrow><mi>′</mi></mrow></msubsup><mo>=</mo><mo>-</mo><mn>200</mn><mi>℃</mi><mo>=</mo><mfenced separators=\"|\"><mrow><mo>-</mo><mn>200</mn><mo>+</mo><mn>273</mn></mrow></mfenced><mi mathvariant=\"normal\">K</mi><mo>=</mo><mn>73</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">K</mi></math><br /><br /><math><msub><mrow><mi mathvariant=\"normal\">η</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><msub><mrow><mi>T</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msubsup><mrow><mi>T</mi></mrow><mrow><mn>1</mn></mrow><mrow><mi>′</mi></mrow></msubsup></mrow></mfrac><mo>=</mo><mn>1</mn><mo>-</mo><mfrac><mrow><mn>73</mn></mrow><mrow><mn>273</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>200</mn></mrow><mrow><mn>273</mn></mrow></mfrac></math><br /><br /><math><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">η</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">η</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>200</mn></mrow><mrow><mn>473</mn></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>273</mn></mrow><mrow><mn>200</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>273</mn></mrow><mrow><mn>473</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>1.732</mn></mrow></mfrac></math>",
