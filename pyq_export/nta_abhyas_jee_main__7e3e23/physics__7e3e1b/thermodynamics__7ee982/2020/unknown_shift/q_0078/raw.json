  "question": {
    "text": "Find the minimum attainable pressure of an ideal gas in process <math> <mrow> <mi>T</mi><mo>=</mo><msub> <mi>T</mi> <mn>0</mn> </msub> <mo>+</mo><mi>α</mi><msup> <mi>V</mi> <mn>2</mn></msup></mrow></math>, where <math> <mrow> <msub> <mi>T</mi> <mn>0</mn> </msub> </mrow> </math> and <math> <mi>α</mi> </math> are positive constants and <math> <mi>V</mi> </math> is the volume of one mole of gas.&nbsp;",
    "image": null
  },
