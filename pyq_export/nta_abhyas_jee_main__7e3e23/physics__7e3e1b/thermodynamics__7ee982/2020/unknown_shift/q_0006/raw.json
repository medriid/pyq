      "text": "<math><msub><mrow><mi>T</mi></mrow><mrow><mi>f</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>7</mn></mrow><mrow><mn>3</mn></mrow></mfrac><msub><mrow><mi>T</mi></mrow><mrow><mn>0</mn></mrow></msub></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HxCll",
      "text": "<math><msub><mrow><mi>T</mi></mrow><mrow><mi>f</mi></mrow></msub><mo>=</mo><mfrac><mrow><mn>3</mn></mrow><mrow><mn>2</mn></mrow></mfrac><msub><mrow><mi>T</mi></mrow><mrow><mn>0</mn></mrow></msub></math>",
      "image": null,
      "isCorrect": true
