  "question": {
    "text": "In a given process of an ideal gas, <math>&nbsp;&nbsp;<mrow><mtext mathvariant=\"italic\">dW</mtext> <mo>=</mo> <mn>0&nbsp;</mn> <mtext>and&nbsp;</mtext><mtext mathvariant=\"italic\">dQ</mtext> <mo>&lt;</mo> <mn>0</mn> </mrow> </math>. Then for the gas",
    "image": null
  },
  "options": [
    {
      "id": "tQFoR",
      "text": "The temperature will decrease",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "oIXPj",
