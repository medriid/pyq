  "question": {
    "text": "A system undergoes a reversible adiabatic process. The entropy of the system",
    "image": null
  },
  "options": [
    {
      "id": "knCIF",
      "text": "Remains constant",
      "image": null,
      "isCorrect": true
    },
    {
