      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mn>3</mn></msub><mo>&#60;</mo><msub><mi>P</mi><mn>1</mn></msub><mo>,</mo><mo>&#160;</mo><mi>W</mi><mo>&#60;</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>P</mi><mn>3</mn></msub><mo>&#62;</mo><msub><mi>P</mi><mn>1</mn></msub><mo>,</mo><mo>&#160;</mo><mi>W</mi><mo>&#60;</mo><mn>0</mn></math>",
      "is_correct": true
