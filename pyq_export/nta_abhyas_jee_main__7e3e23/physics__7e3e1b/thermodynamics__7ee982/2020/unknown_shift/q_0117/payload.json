    {
      "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced><mrow><mn>0</mn><mo>.</mo><mn>5</mn></mrow></mfenced><mrow><mn>2</mn><mo>.</mo><mn>4</mn></mrow></msup><mo>×</mo><msup><mn>10</mn><mn>5</mn></msup><mo>&nbsp;</mo><mi mathvariant=\"normal\">N</mi><mo>&nbsp;</mo><msup><mi mathvariant=\"normal\">m</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></math></p>",
      "is_correct": true
