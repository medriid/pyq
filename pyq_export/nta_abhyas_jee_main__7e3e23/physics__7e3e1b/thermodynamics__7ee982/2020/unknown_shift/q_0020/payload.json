    {
      "text": "<math> <mrow>  <msub>   <mtext>O</mtext>   <mtext>2</mtext>  </msub>  </mrow></math>and <math> <mrow>  <msub>   <mtext>N</mtext>   <mtext>2</mtext>  </msub>  </mrow></math>",
