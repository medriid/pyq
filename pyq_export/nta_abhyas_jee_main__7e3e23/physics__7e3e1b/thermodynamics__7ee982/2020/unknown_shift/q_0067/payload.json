  "question": {
    "text": "<p>A monoatomic gas of molar mass&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>M</mi><mn>0</mn></msub></math>&nbsp;is filled into an insulated container which is moving along a horizontal surface with velocity a&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math>. If the container is stopped&nbsp;suddenly, then the change in temperature of the gas is</p>\r"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>M</mi><mn>0</mn></msub><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mi>R</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msub><mi>M</mi><mn>0</mn></msub><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mn>3</mn><mi>R</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>2</mn><msub><mi>M</mi><mn>0</mn></msub><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mn>3</mn><mi>R</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msub><mi>M</mi><mn>0</mn></msub><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mi>R</mi></mrow></mfrac></math>",
      "is_correct": false
