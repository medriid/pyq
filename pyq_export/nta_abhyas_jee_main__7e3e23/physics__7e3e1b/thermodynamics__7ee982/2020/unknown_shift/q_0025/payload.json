  "question": {
    "text": "Find the minimum attainable pressure of an ideal gas in process <math> <mrow> <mi>T</mi><mo>=</mo><msub> <mi>T</mi> <mn>0</mn> </msub> <mo>+</mo><mi>α</mi><msup> <mi>V</mi> <mn>2</mn></msup></mrow></math>, where <math> <mrow> <msub> <mi>T</mi> <mn>0</mn> </msub> </mrow> </math> and <math> <mi>α</mi> </math> are positive constants and <math> <mi>V</mi> </math> is the volume of one mole of gas.&nbsp;"
  },
  "options": [
    {
      "text": "<math> <mrow> <mn>2</mn><mi>R</mi><msqrt> <mrow> <mi>α</mi><msub> <mi>T</mi> <mn>0</mn> </msub> </mrow> </msqrt> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow>  <mn>3</mn><mi>R</mi><msqrt>   <mrow>    <mi>&#x03B1;</mi><msub>     <mi>T</mi>     <mn>0</mn>    </msub>    </mrow>  </msqrt>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <mn>3</mn><mi>R</mi></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow> <mn>3</mn><mi>R</mi><msqrt> <mrow> <mfrac> <mrow> <mi>α</mi><msub> <mi>T</mi> <mn>0</mn> </msub> </mrow> <mn>2</mn> </mfrac> </mrow> </msqrt> </mrow> </math>",
      "is_correct": false
