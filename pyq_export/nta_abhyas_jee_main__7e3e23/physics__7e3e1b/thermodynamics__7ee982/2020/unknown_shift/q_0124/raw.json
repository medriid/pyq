      "image": null,
      "isCorrect": false
    },
    {
      "id": "LnAvy",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>5</mn><msub><mtext mathvariant=\"italic\">RT</mtext><mn>0</mn></msub></mrow><mn>2</mn></mfrac></math>",
      "image": null,
