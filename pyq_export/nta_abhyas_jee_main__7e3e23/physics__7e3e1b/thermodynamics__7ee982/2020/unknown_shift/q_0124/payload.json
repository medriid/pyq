      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>5</mn><msub><mtext mathvariant=\"italic\">RT</mtext><mn>0</mn></msub></mrow><mn>2</mn></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>13</mn><msub><mtext mathvariant=\"italic\">RT</mtext><mn>0</mn></msub></mrow><mn>2</mn></mfrac></math>",
