  "question": {
    "text": "<p>What is the modulation index of an FM signal having a carrier swing of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>100</mn><mo>&nbsp;</mo><mi>kHz</mi></math> when the modulating signal has a frequency of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>&nbsp;</mo><mi>kHz</mi></math>?</p>\r"
  },
  "options": [
    {
      "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>.</mo><mn>25</mn></math></p>",
      "is_correct": true
    },
    {
      "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>.</mo><mn>23</mn></math></p>",
      "is_correct": false
