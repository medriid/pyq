  "question": {
    "text": "In optical communication systems operating at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1200</mn><mo>&nbsp;</mo><mi>nm</mi></math>, only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>%</mo></math> of the source frequency is available for TV transmission having a bandwidth of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>5</mn><mo>&nbsp;</mo><mi>MHz</mi></math>. The number of TV channels that can be transmitted is&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>10</mn><mi mathvariant=\"normal\">n</mi></msup></math>. The value of&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">n</mi></math> is",
    "image": null
  },
