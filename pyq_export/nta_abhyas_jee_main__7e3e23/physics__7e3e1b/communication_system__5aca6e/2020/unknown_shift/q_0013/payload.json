rmal\">o</mi><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">s</mi><mo>=</mo><mfrac><mrow><msup><mrow><mi mathvariant=\"normal\">v</mi></mrow><mrow><mi mathvariant=\"normal\">&prime;</mi></mrow></msup></mrow><mrow><mi mathvariant=\"normal\">b</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">w</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">h</mi></mrow></mfrac></math><br /><br />Or <math><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">o.</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">f</mi><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">c</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">s</mi><mo>=</mo><mfrac><mrow><msup><mrow><mn>5</mn><mo>&times;</mo><mn>10</mn></mrow><mrow><mn>12</mn></mrow></msup></mrow><mrow><msup><mrow><mn>5</mn><mo>&times;</mo><mn>10</mn></mrow><mrow><mn>6</mn></mrow></msup></mrow></mfrac><mo>=</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>6</mn></mrow></msup><mo>=</mo><mn>1</mn><mi>&nbsp;</mi><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">n</mi></math>"
