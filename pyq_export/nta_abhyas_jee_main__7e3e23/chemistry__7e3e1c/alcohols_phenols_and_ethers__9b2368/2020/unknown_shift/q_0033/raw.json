  "question": {
    "text": "Mark the correct order of decreasing acid strength of the following compounds. <br/><img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/b4eb313b-a805-4ee3-ae9d-0847e2a4042b.png\" style=\"width:4.68333in;height:1.225in\">",
    "image": null
  },
  "options": [
    {
      "id": "4fqED",
      "text": "(V) &gt; (IV) &gt; (II) &gt; (I) &gt; (III)",
      "image": null,
