  "question": {
    "text": "Dehydration of the following in increasing order is <br/>(I) <img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/b086e00e-cfcc-42ee-860a-fed8ffa513d5.png\" style=\"width:1.05347in;height:0.61319in\"> <br/>(II) <img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/db01b326-e0fe-461c-ac13-b87243ef6e1b.png\" style=\"width:1.12708in;height:0.65347in\"> <br/>(III) <img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/1f3980d7-e516-40d4-8565-c018cfbd9607.png\" style=\"width:1.2in;height:0.66667in\"> <br/>(IV) <img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/f9213bff-9800-4357-b823-624206a2a8a5.png\" style=\"width:1.13333in;height:0.64653in\">",
    "image": null
  },
