  "question": {
    "text": "An unknown alcohol is treated with the Lucas reagent to determine whether the alcohol is primary, secondary or tertiary. Which alcohol reacts fastest and by what mechansim?",
    "image": null
  },
  "options": [
    {
      "id": "5l6PB",
      "text": "Tertiary alcohol by  <math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">N</mi></mrow></msub><mn>2</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6PW6H",
      "text": "Tertiary alcohol by  <math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">N</mi></mrow></msub><mn>1</mn></math>",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "1oLwm",
      "text": "Secondary alcohol by  <math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">N</mi></mrow></msub><mn>2</mn></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "M5dBg",
      "text": "Secondary alcohol by  <math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">N</mi></mrow></msub><mn>1</mn></math>",
      "image": null,
      "isCorrect": false
