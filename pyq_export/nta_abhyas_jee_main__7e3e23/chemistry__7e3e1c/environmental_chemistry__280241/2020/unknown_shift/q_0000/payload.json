  "question": {
    "text": "Which of the following are common components of photochemical smog?<br />\r<math><mn>1</mn><mo>.</mo></math> Chlorofluorocarbons<br />\r<math><mn>2</mn><mo>.</mo></math> Acrolein<br />\r<math><mn>3</mn><mo>.</mo></math> Ozone<br />\r<math><mn>4</mn><mo>.</mo></math> Peroxyacetyl nitrate"
  },
  "options": [
    {
      "text": "2, 3",
      "is_correct": false
    },
    {
      "text": "3, 4",
      "is_correct": false
    },
    {
      "text": "1, 2",
      "is_correct": false
    },
    {
      "text": "2, 3, 4",
      "is_correct": true
