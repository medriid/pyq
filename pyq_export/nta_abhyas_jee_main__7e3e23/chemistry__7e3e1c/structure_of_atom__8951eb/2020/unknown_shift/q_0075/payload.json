    "text": "<math><msub><mrow><mfenced separators=\"|\"><mrow><mtext>K</mtext><mtext>E</mtext></mrow></mfenced></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>0</mn></mrow></msub></math><br /><br /><math><msub><mrow><mfenced separators=\"|\"><mrow><mtext>K</mtext><mtext>E</mtext></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>0</mn></mrow></msub></math><br /><br />As, <math><msub><mrow><mfenced separators=\"|\"><mrow><mtext>K</mtext><mtext>E</mtext></mrow></mfenced></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><mn>2</mn><mo>×</mo><msub><mrow><mfenced separators=\"|\"><mrow><mtext>K</mtext><mtext>E</mtext></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub></math><br /><br /><math><mo>∴</mo><mtext>&nbsp;</mtext><mtext>&nbsp;</mtext><mtext>&nbsp;</mtext><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><mn>2</mn><mfenced separators=\"|\"><mrow><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfenced></math><br /><br />Or, <math><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><mn>2</mn><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>-</mo><mtext>h</mtext><msub><mrow><mtext>v</mtext></mrow><mrow><mn>1</mn></mrow></msub></math><br /><br />Or , <math><msub><mrow><mtext>v</mtext></mrow><mrow><mn>0</mn></mrow></msub><mo>=</mo><mn>2</mn><msub><mrow><mtext>v</mtext></mrow><mrow><mn>1</mn></mrow></msub><mo>-</mo><msub><mrow><mtext>v</mtext></mrow><mrow><mn>1</mn></mrow></msub></math><br /><br /><math><mo>=</mo><mn>2</mn><mo>×</mo><mfenced separators=\"|\"><mrow><mn>2</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>16</mn></mrow></msup></mrow></mfenced><mo>-</mo><mfenced separators=\"|\"><mrow><mn>3.2</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>16</mn></mrow></msup></mrow></mfenced></math><br /><br /><math><mo>=</mo><mn>0.8</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>16</mn></mrow></msup><mtext>H</mtext><mtext>z</mtext><mo>=</mo><mn>8</mn><mo>×</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>15</mn></mrow></msup><mtext>&nbsp;</mtext><mtext>H</mtext><mtext>z</mtext></math>"
