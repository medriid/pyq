  "question": {
    "text": "The distillation technique most suited for separating glycerol from spent-lye in the soap industry is"
  },
  "options": [
    {
      "text": "Distillation under reduced pressure",
      "is_correct": true
    },
    {
      "text": "Simple distillation",
      "is_correct": false
    },
