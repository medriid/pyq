    "text": "<math><mi mathvariant=\"normal\">k</mi><mo>=</mo><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mfrac><mrow><msub><mrow><mo>-</mo><mi mathvariant=\"normal\">E</mi></mrow><mrow><mi mathvariant=\"normal\">a</mi></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">R</mi><mi mathvariant=\"normal\">T</mi></mrow></mfrac></mrow></msup></math><br /><br />For methyl nitrite <math><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>13</mn></mrow></msup><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mrow><mrow><mo>-</mo><mn>152300</mn></mrow><mo>/</mo><mrow><mfenced separators=\"|\"><mrow><mn>8.314</mn><mo>×</mo><mi mathvariant=\"normal\">T</mi></mrow></mfenced></mrow></mrow></mrow></mfenced></mrow></msup></math><br /><br />For ethyl nitrite <math><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>=</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>14</mn></mrow></msup><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mrow><mrow><mo>-</mo><mn>157700</mn></mrow><mo>/</mo><mrow><mfenced separators=\"|\"><mrow><mn>8.314</mn><mo>×</mo><mi mathvariant=\"normal\">T</mi></mrow></mfenced></mrow></mrow></mrow></mfenced></mrow></msup></math><br /><br />If <math><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mn>2</mn></mrow></msub></math> then<br /><br /><math><msup><mrow><mn>10</mn></mrow><mrow><mn>13</mn></mrow></msup><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mrow><mrow><mo>-</mo><mn>152300</mn></mrow><mo>/</mo><mrow><mfenced separators=\"|\"><mrow><mn>8.314</mn><mo>×</mo><mi mathvariant=\"normal\">T</mi></mrow></mfenced></mrow></mrow></mrow></mfenced></mrow></msup><mo>=</mo><msup><mrow><mn>10</mn></mrow><mrow><mn>14</mn></mrow></msup><mi mathvariant=\"normal\">&nbsp;</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mrow><mrow><mo>-</mo><mn>157700</mn></mrow><mo>/</mo><mrow><mfenced separators=\"|\"><mrow><mn>8.314</mn><mo>×</mo><mi mathvariant=\"normal\">T</mi></mrow></mfenced></mrow></mrow></mrow></mfenced></mrow></msup></math><br /><br />Or <math><mn>2.303</mn><mrow><mrow><mi mathvariant=\"normal\">log</mi></mrow><mo>⁡</mo><mrow><mn>10</mn></mrow></mrow><mo>=</mo><mfrac><mrow><mn>157700</mn><mi mathvariant=\"normal\">&nbsp;</mi><mo>-</mo><mi mathvariant=\"normal\">&nbsp;</mi><mn>152300</mn></mrow><mrow><mn>8.314</mn><mi mathvariant=\"normal\">&nbsp;</mi><mo>×</mo><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">T</mi></mrow></mfrac></math><br /><br /><math><mi mathvariant=\"normal\">T</mi><mo>=</mo><mn>282</mn><mi mathvariant=\"normal\">&nbsp;</mi><mi mathvariant=\"normal\">K</mi></math>",
