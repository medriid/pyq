    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For a reaction <math><msub><mrow><mi mathvariant=\"normal\">t</mi></mrow><mrow><mn>12</mn></mrow></msub><mo>∝</mo><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">a</mi></mrow></mfenced></mrow><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">n</mi></mrow></msup></math><br /><math><mo>=</mo><mi mathvariant=\"normal\">K</mi><msup><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">a</mi></mrow></mfenced></mrow><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">n</mi></mrow></msup></math><br />or <math><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi><msub><mrow><mi mathvariant=\"normal\">t</mi></mrow><mrow><mrow><mrow><mn>1</mn></mrow><mo>/</mo><mrow><mn>2</mn></mrow></mrow></mrow></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">n</mi></mrow></mfenced><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">a</mi><mo>+</mo><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">K</mi></math><br /><math><mi mathvariant=\"normal\">y</mi><mo>=</mo><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">x</mi><mo>+</mo><mi mathvariant=\"normal\">c</mi></math><br /><math><mo>∴</mo><mn>1</mn><mo>-</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mi mathvariant=\"normal\">t</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">n</mi><msup><mrow><mn>45</mn></mrow><mrow><mn>0</mn></mrow></msup><mo>=</mo><mn>1</mn></math><br /><math><mo>∴</mo><mi mathvariant=\"normal\">n</mi><mo>=</mo><mn>0</mn></math>",
