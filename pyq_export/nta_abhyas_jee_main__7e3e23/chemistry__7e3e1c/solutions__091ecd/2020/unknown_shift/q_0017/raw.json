  "correctValue": null,
  "solution": {
    "text": "<math> <mrow> <msub> <mtext>p</mtext> <mtext>T</mtext> </msub> <mo>=</mo> <mtext>0.983 atm</mtext> </mrow> </math><br /><br /><math> <mrow> <msubsup> <mtext>p</mtext> <mtext>water</mtext> <mo>∘</mo> </msubsup> <mo>=</mo> <mtext>0.84 atm</mtext> </mrow> </math><br /><br /><math> <mo>∴</mo> </math> <math> <mrow> <msubsup> <mtext>p</mtext> <mtext>liquid</mtext> <mo>∘</mo> </msubsup> <mo>=</mo> <mtext>0.143 atm</mtext> </mrow> </math><br /><br />Apply Dalton's law of vapour phase&nbsp;<br /><br /><math> <mrow> <mfrac> <mrow> <msup> <mtext>p</mtext> <mtext>o</mtext> </msup> <mtext>water</mtext> </mrow> <mrow> <msup> <mtext>p</mtext> <mtext>o</mtext> </msup> <mtext>liquid</mtext> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mtext>0.84</mtext> </mrow> <mrow> <mtext>0.143</mtext> </mrow> </mfrac> <mo>=</mo> <mrow> <mfrac> <mrow> <msub> <mi>n</mi> <mrow> <msub> <mi>H</mi> <mn>2</mn> </msub> <mi>O</mi></mrow> </msub> </mrow> <mrow> <msub> <mi>n</mi> <mrow> <mi>L</mi><mi>i</mi><mi>q</mi><mi>u</mi><mi>i</mi><mi>d</mi></mrow> </msub> </mrow> </mfrac> </mrow> </mo></mrow></math><br /><br /><math> <mrow> <mfrac> <mrow> <mtext>0.84</mtext> </mrow> <mrow> <mtext>0.143</mtext> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mfrac> <mrow> <mtext>1</mtext> </mrow> <mrow> <mtext>18</mtext> </mrow> </mfrac> </mrow> <mrow> <mfrac> <mrow> <msub> <mtext>w</mtext> <mtext>e</mtext> </msub> </mrow> <mrow> <mtext>134.3</mtext> </mrow> </mfrac> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mtext>134.3</mtext> </mrow> <mrow> <mtext>18</mtext> <mo>×</mo> <msub> <mtext>w</mtext> <mtext>e</mtext> </msub> </mrow> </mfrac> </mrow> </math><br /><br /><math> <mrow> <msub> <mtext>w</mtext> <mtext>e</mtext> </msub> <mo>=</mo> <mfrac> <mrow> <mtext>134.3</mtext> </mrow> <mrow> <mtext>18</mtext> </mrow> </mfrac> <mo>×</mo> <mfrac> <mrow> <mtext>0.143</mtext> </mrow> <mrow> <mtext>0.84</mtext> </mrow> </mfrac> <mo>=</mo> <mtext>1.27 g</mtext> </mrow> </math>",
