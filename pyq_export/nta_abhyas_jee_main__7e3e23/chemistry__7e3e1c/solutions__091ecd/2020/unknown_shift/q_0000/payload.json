    {
      "text": "<math><mfrac><mrow><msubsup><mrow><mi mathvariant=\"normal\">p</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow><mrow><mi mathvariant=\"normal\">o</mi></mrow></msubsup><msub><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">x</mi></mrow><mrow><mn>1</mn></mrow></msub></mrow></mfrac></math>",
