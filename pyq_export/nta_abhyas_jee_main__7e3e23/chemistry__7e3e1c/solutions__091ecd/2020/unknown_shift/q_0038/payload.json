  "solution": {
    "text": "Boiling point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><msub><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">b</mi></msub></mfenced><mo>=</mo><mn>100</mn><mo>+</mo><mo>∆</mo><msub><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">b</mi></msub><mo>=</mo><mn>100</mn><mo>+</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">b</mi></msub><mi mathvariant=\"normal\">m</mi></math><br /><br />Freezing point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced separators=\"|\"><msub><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">f</mi></msub></mfenced><mo>=</mo><mn>0</mn><mo>-</mo><mo>∆</mo><msub><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">f</mi></msub><mo>=</mo><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">f</mi></msub><mi mathvariant=\"normal\">m</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">b</mi></msub><mo>-</mo><msub><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">f</mi></msub><mo>=</mo><mfenced separators=\"|\"><mrow><mn>100</mn><mo>+</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">b</mi></msub><mi mathvariant=\"normal\">m</mi></mrow></mfenced><mo>-</mo><mo>(</mo><mo>-</mo><msub><mi mathvariant=\"normal\">k</mi><mi mathvariant=\"normal\">f</mi></msub><mi mathvariant=\"normal\">m</mi><mo>)</mo></math><br /><br /><math><mn> 105</mn><mo>=</mo><mn>100</mn><mo>+</mo><mn>0</mn><mo>.</mo><mn>51&nbsp;</mn><mi mathvariant=\"normal\">m</mi><mo>+</mo><mn>1.86&nbsp;</mn><mi mathvariant=\"normal\">m</mi></math><br /><br /><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>.37</mo><mi mathvariant=\"normal\">m</mi><mo>=</mo><mn>5</mn><mi mathvariant=\"normal\">&nbsp;</mi><mo>&nbsp;</mo><mi>or</mi><mo>&nbsp;</mo><mi mathvariant=\"normal\">m</mi><mo>=</mo><mfrac><mn>5</mn><mrow><mn>2</mn><mo>.3