  "question": {
    "text": "Which one of the following statements regarding Henry's law is not correct?",
    "image": null
  },
  "options": [
    {
      "id": "f9046",
      "text": "The value of <math><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">H</mi></mrow></msub></math> changes with the nature of the gas.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "UiLh6",
      "text": "Higher the value of <math><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">H</mi></mrow></msub></math> at a given pressure, higher is the solubility of the gas in the liquids",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "lSYiv",
      "text": "The partial pressure of the gas in vapour phase is proportional to the mole fraction of the gas in the solution.",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ofEOU",
      "text": "Different gases have different  <math><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">H</mi></mrow></msub></math>  (Henry's law constant) value at the same temperature.",
      "image": null,
      "isCorrect": false
    }
