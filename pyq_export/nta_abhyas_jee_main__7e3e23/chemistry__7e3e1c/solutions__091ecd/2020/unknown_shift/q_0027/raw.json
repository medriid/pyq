ub><mrow><mi mathvariant=\"normal\">W</mi></mrow><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">v</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">t</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">M</mi></mrow><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">o</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">v</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">t</mi></mrow></msub></mrow></mfrac></mrow></mfrac></math><br /><br /><math><mfrac><mrow><msub><mrow><msup><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>0</mn></mrow></msup><mo>-</mo><mi mathvariant=\"normal\">P</mi></mrow><mrow><mi mathvariant=\"normal\">S</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">P</mi></mrow><mrow><mn>0</mn></mrow></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">w</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi></mrow></msub></mrow></mfrac><mo>×</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">m</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">W</mi></mrow><mrow><mi mathvariant=\"normal\">B</mi></mrow></msub></mrow></mfrac></math> (A stands for solute and B for solvent)<br /><br /><math><mfrac><mrow><mi mathvariant=\"normal\">x</mi><mo>-</mo><mi mathvariant=\"normal\">x</mi><mo>×</mo><mfrac><mrow><mn>75</mn></mrow><mrow><mn>100</mn></mrow></mfrac></mrow><mrow><mi mathvariant=\"normal\">x</mi><mo>×</mo><mfrac><mrow><mn>75</mn></mrow><mrow><mn>100</mn></mrow></mfrac></mrow></mfrac><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">w</mi></mrow><mrow><mn>60</mn></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>18