    {
      "id": "Wbv5r",
      "text": "<math> <mrow>  <mtext>1</mtext><mtext>&#x2004;</mtext><mtext>molar</mtext><mtext>&#x2004;</mtext><msub>   <mtext>H</mtext>   <mn>2</mn>  </msub>  <msub>   <mrow>    <mtext>SO</mtext></mrow>   <mn>4</mn>  </msub>  <mtext>&#x00A0;</mtext><mfenced>   <mrow>    <mtext>aq</mtext></mrow>  </mfenced></mrow></math>",
