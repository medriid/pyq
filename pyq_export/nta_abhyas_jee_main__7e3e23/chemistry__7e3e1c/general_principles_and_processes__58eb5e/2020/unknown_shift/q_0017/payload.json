    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>Cu</mtext></mrow>   <mtext>2</mtext>  </msub>  <mtext>S</mtext><mtext>&#x2004;</mtext><mtext>+</mtext><mtext>&#x2004;</mtext><mtext>FeO</mtext></mrow></math>",
