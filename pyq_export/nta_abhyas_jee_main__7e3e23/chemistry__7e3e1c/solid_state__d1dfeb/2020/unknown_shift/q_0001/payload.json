    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">X</mi></mrow><mrow><mn>8</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">Y</mi></mrow><mrow><mn>4</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">Z</mi></mrow><mrow><mn>5</mn></mrow></msub></math>",
