      "is_correct": false
    },
    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">X</mi></mrow><mrow><mn>4</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">Y</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">Z</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">X</mi><msub><mrow><mi mathvariant=\"normal\">Y</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">Z</mi></mrow><mrow><mn>4</mn></mrow></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">X</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">Y</mi></mrow><mrow><mn>4</mn></mrow></msub><mi mathvariant=\"normal\">Z</mi></math>",
      "is_correct": true
