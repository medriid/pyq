  "question": {
    "text": "A body centre cubic lattice is made up of two different types of atoms <math> <mtext>A</mtext> </math> and <math> <mrow> <mtext>B</mtext><mtext>.</mtext></mrow> </math> Atom <math> <mtext>A</mtext> </math> occupies the body centre and <math> <mtext>B</mtext> </math> occupying the corner positions. One of the corners is left unoccupied per unit cell. Empirical formula of such a solid is"
  },
  "options": [
    {
      "text": "<math> <mrow>  <mtext>AB</mtext></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mtext>A</mtext>   <mtext>2</mtext>  </msub>  <msub>   <mtext>B</mtext>   <mtext>2</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mtext>A</mtext>   <mtext>5</mtext>  </msub>  <msub>   <mtext>B</mtext>   <mtext>7</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mtext>A</mtext>   <mtext>8</mtext>  </msub>  <msub>   <mtext>B</mtext>   <mtext>7</mtext>  </msub>  </mrow></math>",
      "is_correct": true
