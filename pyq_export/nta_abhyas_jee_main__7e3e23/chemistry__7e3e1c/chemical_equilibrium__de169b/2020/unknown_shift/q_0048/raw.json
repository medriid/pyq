  "solution": {
    "text": "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp; <mrow> <mn>2</mn> <msub> <mrow> <mi>AB</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>g</mtext> </mrow> </mfenced> <mo>⇌</mo> <mi>2AB</mi><mo>⁡</mo> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>g</mtext> </mrow> </mfenced> <mo>+</mo> <msub> <mrow> <mi>B</mi><mo>⁡</mo> </mrow> <mn>2</mn> </msub> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mi>g</mi><mo>⁡</mo> </mrow> </mfenced> </mrow> </math><br />At equilibrium&nbsp;&nbsp; <math> <mrow> <mtext>2(1</mtext><mo>−</mo><mtext>x)</mtext></mrow> </math> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math> <mrow> <mtext>2x</mtext></mrow> </math> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <math> <mtext>x</mtext> </math><br />Total moles = <math> <mrow> <mtext>(2</mtext><mtext> </mtext><mtext>+</mtext><mtext> </mtext><mtext>x)</mtext></mrow> </math><br />Partial pressures<br /><math> <mrow> <msub> <mtext>P</mtext> <mrow> <msub> <mrow> <mtext>AB</mtext></mrow> <mtext>2</mtext> </msub> </mrow> </msub> <mtext>=</mtext><mfrac> <mrow> <mtext>2(1</mtext><mo>−</mo><mtext>x)</mtext></mrow> <mrow> <mtext>2</mtext><mtext> </mtext><mtext>+</mtext><mtext> </mtext><mtext>x</mtext></mrow> </mfrac> <mtext>p,</mtext><mtext> </mtext><msub> <mtext>P</mtext> <mrow> <mtext>AB</mtext></mrow> </msub> <mtext> </mtext><mtext>=</mtext><mtext> </mtext><mfenced> <mrow> <mfrac> <mrow> <mtext>2x</mtext></mrow> <mrow> <mtext>2</mtext><mtext> </mtext><mtext>+</mtext><mtext> </mtext><mtext>x</mtext></mrow> </mfrac> </mrow> </mfenced><mtext>p,</mtext><mtext> </mtext><msub> <mtext>P</mtext> <mrow> <msub> <mtext>B</mtext> <mtext>2</mtext> </msub> </mrow> </msub> <mtext>=</mtext><mfenced> <mrow> <mfrac> <mtext>x</mtext> <mrow> <mtext>2+x</mtext></mrow> </mfrac> </mrow> </mfenced><mtext>p</mtext></mrow> </math><br /><math> <mrow> <msub> <mtext>K</mtext> <mtext>p</mtext> </msub> <mo>=</mo> <mfrac> <mrow> <mtext>p</mtext> <msup> <mtext>AB</mtext> <mn>2</mn> </msup> <msub> <mtext>pB</mtext> <mn>2</mn> </msub> </mrow> <mrow> <mo>(</mo> <msub> <mtext>pAB</mtext> <mn>2</mn> </msub> <msup> <mo>)</mo> <mn>2</mn> </msup> </mrow> </mfrac> <mo>=</mo> <mfrac> <mrow> <mo>[</mo> <mo>(</mo> <mfrac> <mrow> <mn>2</mn> <mi>x</mi> </mrow> <mrow> <mn>2</mn> <mo>+</mo> <mi>x</mi> </mrow> </mfrac> <mo>)</mo> <mtext>p</mtext> <msup> <mo>]</mo> <mn>2</mn> </msup> <mo>[</mo> <mfrac> <mrow> <mi>x</mi> <mtext>p</mtext> </mrow> <mrow> <mn>2</mn> <mo>+</mo> <mi>x</mi> </mrow> </mfrac> <mo>]</mo> </mrow> <mrow> <mo>[</mo> <mfrac> <mrow> <mn>2</mn> <mo>(</mo> <mn>1</mn> <mo>-</mo> <mi>x</mi> <mo>)</mo> </mrow> <mrow> <mn>2</mn> <mo>+</mo> <mi>x</mi> </mrow> </mfrac> <mtext>p</mtext> <msup> <mo>]</mo> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </math><br /><math> <mrow> <msub> <mtext>K</mtext> <mtext>p</mtext> </msub> <mo>=</mo><mfrac> <mrow> <mn>4</mn><msup> <mtext>x</mtext> <mtext>3</mtext> </msup> <mtext>P</mtext></mrow> <mrow> <mn>4</mn><mfenced> <mrow> <mn>2</mn><mo>+</mo><mtext>x</mtext></mrow> </mfenced><msup> <mrow> <mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><mtext>x</mtext><mo stretchy=\"false\">)</mo></mrow> <mn>2</mn> </msup> </mrow> </mfrac> </mrow> </math><br /><math> <mrow> <mfenced> <mrow> <mn>2</mn><mo>+</mo><mtext>x</mtext></mrow> </mfenced><mo>→</mo><mn>2</mn></mrow> </math> (<math> <mtext>x</mtext> </math> is small)<br /><math> <mrow> <mfenced> <mrow> <mn>1</mn><mo>−</mo><mtext>x</mtext></mrow> </mfenced><mo>→</mo><mn>1</mn></mrow> </math><br /><math> <mrow>  <msub>   <mtext>K</mtext>   <mtext>P</mtext>  </msub>  <mo>=</mo><mfrac>   <mrow>    <mn>4</mn><msup>     <mtext>x</mtext>     <mtext>3</mtext>    </m