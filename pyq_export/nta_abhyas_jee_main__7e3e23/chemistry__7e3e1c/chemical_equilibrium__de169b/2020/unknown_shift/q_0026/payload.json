\"normal\">H</mi><mo>⇌</mo><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></math><br />From equation<br /><math><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub><mo>=</mo><mn>3.4</mn><mo>×</mo><mn>1</mn><msup><mrow><mn>0</mn></mrow><mrow><mn>10</mn></mrow></msup><mo>/</mo><mi mathvariant=\"normal\">m</mi><mi mathvariant=\"normal\">i</mi><msup><mrow><mi mathvariant=\"normal\">l</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup><msup><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mo>-</mo><mn>1</mn></mrow></msup></math><br /><math><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi><mo>⇌</mo><mi mathvariant=\"normal\">N</mi><msubsup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>4</mn></mrow><mrow><mo>+</mo></mrow></msubsup><mo>+</mo><mi mathvariant=\"normal\">O</mi><msup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mo>-</mo></mrow></msup></math><br /><math><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi></mrow></msub><mo>=</mo><mo>?</mo></math><br /><math><mi mathvariant=\"normal\">K</mi><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mi mathvariant=\"normal\">f</mi></mrow></msub></mrow><mrow><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi></mrow></msub></mrow></mfrac></math><br />So <math><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mi mathvariant=\"normal\">r</mi></mrow></msub><mo>=</mo><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">k</mi></mrow><mrow><mi mathvariant=\"normal\