  "solution": {
    "text": "<math> <mrow> <mtable> <mtr> <mtd> <mn>2</mn> <msub> <mtext>NH</mtext> <mn>3</mn> </msub> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>g</mtext> </mrow> </mfenced> </mtd> <mtd> <mo>⟶</mo> </mtd> <mtd> <msub> <mtext>N</mtext> <mn>2</mn> </msub> <mfenced close=\")\" open=\"(\" separators=\",\"> <mrow> <mtext>g</mtext> </mrow> </mfenced> </mtd> <mtd> <mo>+</mo> </mtd> <mtd> <mn>3</mn> <msub> <mtext>H</mtext> <mn>2</mn> </msub> </mtd> </mtr> <mtr> <mtd> <mn>7</mn> <mn>6</mn> <mo>-</mo> <mn>2</mn> <mtext>x</mtext> </mtd> <mtd> </mtd> <mtd> <mtext>x</mtext> </mtd> <mtd> </mtd> <mtd> <mn>3</mn> <mtext>x</mtext> </mtd> </mtr> </mtable> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math> <mrow> <mn>7</mn> <mn>6</mn> <mo>+</mo> <mn>2</mn> <mtext>x</mtext> <mo>=</mo> <mn>7</mn> <mn>6</mn> <mo>+</mo> <mn>1</mn> <mn>8</mn> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math> <mrow> <mn>2</mn> <mtext>x</mtext> <mo>=</mo> <mn>1</mn> <mn>8</mn> </mrow> </math><br /><br /><math> <mrow> <mo>∴&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</mo> <mtext>x</mtext> <mo>=</mo> <mn>9</mn> </mrow> </math><br /><br /><math> <mrow> <mo>∴&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</mo> <msub> <mtext>p</mtext> <msub> <mtext>H</mtext> <mn>2</mn> </msub> </msub> <mo>=</mo> <mn>3</mn> <mo>×</mo> <mn>9</mn> </mrow> </math><br /><br />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<math> <mrow> <mo>=</mo> <mtext>&nbsp;27 cm of Hg</mtext> </mrow> </math>",
