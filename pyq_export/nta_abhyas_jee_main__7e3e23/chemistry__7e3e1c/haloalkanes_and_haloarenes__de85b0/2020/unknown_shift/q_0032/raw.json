  "question": {
    "text": "Consider the following bromides <br/><img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/79bb01e0-ab34-4adc-b7d6-aac58fa0d4e4.png\" style=\"width:4.13403in;height:1.05347in\"> <br/>The correct order of <math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">N</mi></mrow></msub><mn>1</mn></math> reactivity is",
    "image": null
  },
