    {
      "text": "<math><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">g</mi><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mn>2</mn></mrow></msub></math>",
