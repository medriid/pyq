  "question": {
    "text": "Which of the following compounds is expected to be coloured?"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">u</mi><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mn>2</mn></mrow></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">u</mi><mrow><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">l</mi></mrow></math>",
