    {
      "text": "<math><mi mathvariant=\"normal\">A</mi><msub><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">S</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub></math>",
      "is_correct": false
