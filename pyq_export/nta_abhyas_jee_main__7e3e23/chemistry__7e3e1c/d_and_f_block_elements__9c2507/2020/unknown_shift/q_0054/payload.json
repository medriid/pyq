  "question": {
    "text": "Compound that is both paramagnetic and coloured is"
  },
  "options": [
    {
      "text": "K<sub>2</sub>Cr<sub>2</sub>O<sub>7</sub>",
      "is_correct": false
    },
    {
      "text": "(NH<sub>4</sub>)<sub>2</sub> [TiCl<sub>6</sub>]",
      "is_correct": false
    },
    {
      "text": "VOSO<sub>4</sub>",
      "is_correct": true
    },
    {
      "text": "K<sub>3</sub>[Cu(CN)<sub>4</sub>]",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "K<sub>2</sub>Cr<sub>2</sub>O<sub>7</sub> contains Cr<sup>+6</sup>(3d<sup>0</sup>) which is diamagnetic but coloured due to charge transfer spectra.<br /><br />(NH<sub>4</sub>)<sub>2</sub>[TiCl<sub>6</sub>] contains Ti<sup>4+</sup>(3d<sup>0</sup>), which is diamagnetic and colourless.<br /><br />VOSO<sub>4</sub> contains V<sup>4+</sup>(3d<sup>1</sup>), which is paramagnetic and coloured.<br /><br />K<sub>3</sub>[Cu(CN)<sub>4</sub>] contains Cu<sup>+</sup>(3d<sup>10</sup>), which is diamagnetic and colourless."
  }
