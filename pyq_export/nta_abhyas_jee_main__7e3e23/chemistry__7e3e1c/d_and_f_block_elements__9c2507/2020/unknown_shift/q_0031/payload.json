  "question": {
    "text": "Which of the following is coloured compound?"
  },
  "options": [
    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">F</mi></mrow><mrow><mn>2</mn></mrow></msub></math>",
      "is_correct": true
    },
