  "question": {
    "text": "Which of the following is an amphoteric oxide?"
  },
  "options": [
    {
      "text": "<math> <mrow> <msub> <mtext>V</mtext> <mtext>2</mtext> </msub> <msub> <mtext>O</mtext> <mtext>5</mtext> </msub> <msub> <mrow> <mtext>,Cr</mtext></mrow> <mtext>2</mtext> </msub> <msub> <mtext>O</mtext> <mtext>3</mtext> </msub> </mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>Mn</mtext></mrow>   <mtext>2</mtext>  </msub>  <msub>   <mtext>O</mtext>   <mtext>7</mtext>  </msub>  <msub>   <mrow>    <mtext>,Cr</mtext></mrow>   <mtext>2</mtext>  </msub>  <msub>   <mtext>O</mtext>   <mtext>3</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>CrO,V</mtext></mrow>   <mtext>2</mtext>  </msub>  <msub>   <mtext>O</mtext>   <mtext>5</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mtext>V</mtext>   <mtext>2</mtext>  </msub>  <msub>   <mtext>O</mtext>   <mtext>5</mtext>  </msub>  <msub>   <mrow>    <mtext>,V</mtext></mrow>   <mtext>2</mtext>  </msub>  <msub>   <mtext>O</mtext>   <mtext>4</mtext>  </msub>  </mrow></math>",
