/mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></math><br /><br />(iii) <math><msub><mrow><mi mathvariant=\"normal\">I</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>10</mn><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>3</mn></mrow></msub><mo>→</mo><munder><mrow><mn>2</mn><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">I</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">R</mi></mrow></mfenced></mrow></munder><mo>+</mo><mn>10</mn><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>4</mn><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></math><br /><br />Here <math> <mrow> <mtext>x&nbsp;=&nbsp;2,&nbsp;y&nbsp;=&nbsp;8</mtext></mrow> </math> and <math> <mrow> <mtext>z&nbsp;=&nbsp;10</mtext></mrow> </math><br /><br />Hence, <math> <mrow> <mtext>x&nbsp;+&nbsp;y&nbsp;+&nbsp;z&nbsp;=&nbsp;2&nbsp;+&nbsp;8&nbsp;+&nbsp;10&nbsp;=&nbsp;20</mtext></mrow> </math>",
