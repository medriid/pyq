    "text": "<math><mtext>3C</mtext><msub><mrow><mtext>l</mtext></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mtext>6NaOH</mtext><mo>→</mo><mn>5</mn><mtext>NaCl</mtext><mo>+</mo><mtext>NaCl</mtext><msub><mrow><mtext>O</mtext></mrow><mrow><mn>3</mn></mrow></msub><mo>+</mo><mtext>3</mtext><msub><mrow><mtext>H</mtext></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></math><br /><math> <mrow> <mtext>NaCl</mtext><mtext> </mtext><mtext>+</mtext><mtext> </mtext><msub> <mrow> <mtext>AgNO</mtext></mrow> <mtext>3</mtext> </msub> <mo>→</mo><munder> <mrow> <mtext>AgCl</mtext></mrow> <mrow> <mtext>White</mtext><mtext> </mtext><mtext>ppt</mtext></mrow> </munder> <mtext> </mtext><mtext>+</mtext><mtext> </mtext><msub> <mrow> <mtext>NaNO</mtext></mrow> <mtext>3</mtext> </msub> </mrow> </math><br />Q is <math><mtext>NaCl</mtext><msub><mrow><mtext>O</mtext></mrow><mrow><mn>3</mn></mrow></msub><mo>→</mo><mtext>Cl</mtext><msubsup><mrow><mtext>O</mtext></mrow><mrow><mn>3</mn></mrow><mrow><mo>-</mo></mrow></msubsup></math><br /><img src=\"assets\\st0068_b9062feda0c6.jpeg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 300px; height: 111px;\" /><br />Bond order <math><mo>=</mo><mfrac><mrow><mn>5</mn></mrow><mrow><mn>3</mn></mrow></mfrac><mo>=</mo><mn>1.67</mn></math>"
