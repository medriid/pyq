  "question": {
    "text": "Consider the following molecules<br />\r<br />\r<math><munder><mrow><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">I</mi></mrow></munder><mo>,</mo><munder><mrow><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">s</mi><msub><mrow><mi mathvariant=\"normal\">F</mi></mrow><mrow><mn>6</mn></mrow></msub></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">I</mi></mrow></munder><mo>,</mo><munder><mrow><mi mathvariant=\"normal\">K</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">I</mi></mrow></munder></math><br />\r<br />\rChoose the correct answer regarding O-O bond from the following.",
    "image": null
  },
  "options": [
    {
      "id": "hdqZT",
      "text": "The correct decreasing bond order is I &gt; III &gt; II",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mIA11",
      "text": "The correct decreasing order of bond length is III > I > II",
