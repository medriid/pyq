    {
      "id": "uFjic",
      "text": "<math><msubsup><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow><mrow><mn>2</mn><mo>+</mo></mrow></msubsup></math>",
      "image": null,
