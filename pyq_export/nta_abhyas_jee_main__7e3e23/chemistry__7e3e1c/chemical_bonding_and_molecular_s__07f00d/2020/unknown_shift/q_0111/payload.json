nder><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mo>+</mo></mrow></msup><mo>→</mo><munder><mrow><mi mathvariant=\"normal\">N</mi><msubsup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>4</mn></mrow><mrow><mo>+</mo></mrow></msubsup></mrow><mrow><mi mathvariant=\"normal\">s</mi><msup><mrow><mi mathvariant=\"normal\">p</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></munder></math><br /><math><munder><mrow><mn>2</mn><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">s</mi><msup><mrow><mi mathvariant=\"normal\">p</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></munder><mo>⇌</mo><munder><mrow><mn>2</mn><mi mathvariant=\"normal\">N</mi><msubsup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow><mrow><mo>-</mo></mrow></msubsup></mrow><mrow><mi mathvariant=\"normal\">s</mi><msup><mrow><mi mathvariant=\"normal\">p</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></munder><mo>+</mo><munder><mrow><mi mathvariant=\"normal\">N</mi><msubsup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>4</mn></mrow><mrow><mo>+</mo></mrow></msubsup></mrow><mrow><mi mathvariant=\"normal\">s</mi><msup><mrow><mi mathvariant=\"normal\">p</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></munder></math><br /><math><munder><mrow><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></mrow><mrow><mi mathvariant=\"normal\">s</mi><msup><mrow><mi mathvariant=\"normal\">p</mi></mrow><mrow><mn>3</mn></mrow></msup></mrow></munder><mo>+</mo><msup><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mo>+</mo></mrow></msup><mo>⇌</mo><munder><mrow><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>3</mn></mrow></msub><msup><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mo>+</mo></mrow></msup></mrow><mrow><mi mathvariant=\"normal\">s</mi><msup><mrow><mi mathvariant=\"normal\