  "question": {
    "text": "Among the following the molecule with the highest dipole moment is"
  },
  "options": [
    {
      "text": "<math> <mrow> <msub> <mrow> <mtext>CH</mtext></mrow> <mtext>3</mtext> </msub> <mtext>Cl</mtext></mrow> </math>",
      "is_correct": true
    },
    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>CH</mtext></mrow>   <mtext>2</mtext>  </msub>  <msub>   <mrow>    <mtext>Cl</mtext></mrow>   <mtext>2</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>CHCl</mtext></mrow>   <mtext>3</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>CCl</mtext></mrow>   <mtext>4</mtext>  </msub>  </mrow></math>",
