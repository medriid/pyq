qrt></math> for AX<br /><math><mi mathvariant=\"normal\">S</mi><mo>=</mo><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">p</mi></mrow></msub></mrow><mrow><mn>4</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></msup></math> for <math><msub><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">X</mi></math><br /><math><mi mathvariant=\"normal\">S</mi><mo>=</mo><msup><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><msub><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mi mathvariant=\"normal\">s</mi><mi mathvariant=\"normal\">p</mi></mrow></msub></mrow><mrow><mn>108</mn></mrow></mfrac></mrow></mfenced></mrow><mrow><mn>1</mn><mo>/</mo><mn>5</mn></mrow></msup></math> for <math><msub><mrow><mi mathvariant=\"normal\">A</mi></mrow><mrow><mn>2</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">X</mi></mrow><mrow><mn>3</mn></mrow></msub></math><br />So <math><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">III</mi></mrow></msub><mo>&gt;</mo><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">II</mi></mrow></msub><mo>&gt;</mo><msub><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mi mathvariant=\"normal\">I</mi></mrow></msub></math>.",
