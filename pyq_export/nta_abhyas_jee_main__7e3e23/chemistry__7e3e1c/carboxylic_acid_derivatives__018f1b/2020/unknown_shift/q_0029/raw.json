  "question": {
    "text": "The number of <math><mi mathvariant=\"normal\">π</mi></math> bonds in the major product will be _____.<br />\r<img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/7adbed0e-31fb-4acc-ba69-1691fcc7cb9a.png\" style=\"width:2.98681in;height:1.25347in\" />",
    "image": null
