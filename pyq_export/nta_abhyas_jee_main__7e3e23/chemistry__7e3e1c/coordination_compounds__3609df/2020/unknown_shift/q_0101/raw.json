  "question": {
    "text": "Aqueous solution of Ni<sup>2+</sup> contains [Ni (H<sub>2</sub>O)<sub>6</sub>]<sup>2+</sup> and its magnetic moment is 2.83 BM when ammonia is added in it , commment on the magnetic moment of solution.",
    "image": null
  },
  "options": [
    {
      "id": "94OW2",
      "text": "It decreases from 2.83 BM",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZwnPi",
      "text": "It increases from 2.83 BM",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hrMrs",
      "text": "It will remains same",
      "image": null,
      "isCorrect": true
    },
    {
