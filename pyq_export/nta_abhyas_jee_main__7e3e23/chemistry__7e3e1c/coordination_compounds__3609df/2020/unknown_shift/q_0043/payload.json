  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "As <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>EDTA</mi></math> is hexadentate ligand. Hence, only one <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>EDTA</mi></math> (ethylenediamine tetraacetate) molecule is required to make an octahedral complex with <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>Ca</mi><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>.<br /><br /><img alt=\"\" src=\"assets\\st0043_063f92351a5b.png\" style=\"width: 240px; height: 112px;\" /><br />"
  }
