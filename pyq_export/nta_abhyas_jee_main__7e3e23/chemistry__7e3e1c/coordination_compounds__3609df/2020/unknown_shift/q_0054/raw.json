    {
      "id": "2BDl2",
      "text": "intraligand  <math><mi mathvariant=\"normal\">π</mi><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">π</mi></mrow><mrow><mi mathvariant=\"normal\">*</mi></mrow></msup></math>  transition",
      "image": null,
