idth:100%; object-fit:contain\" style=\"width: 421px; height: 153px;\" /><br /><br />IV. <math> <mrow> <msup> <mrow> <mfenced close=\"]\" open=\"[\"> <mrow> <msub> <mrow> <mtext>CoF</mtext></mrow> <mtext>6</mtext> </msub> </mrow> </mfenced></mrow> <mrow> <mtext>3</mtext><mo>−</mo></mrow> </msup> </mrow> </math><br />Here <math> <mrow> <mtext>Co</mtext></mrow> </math> is present as <math> <mrow> <msup> <mrow> <mtext>Co</mtext></mrow> <mrow> <mtext>3+</mtext></mrow> </msup> </mrow> </math> ion, <math> <mtext>F</mtext> </math> being weak field ligand is unable to pair up its unpaired electrons.<br /><math> <mrow> <msup> <mrow> <mtext>Co</mtext></mrow> <mrow> <mtext>3+</mtext></mrow> </msup> <mtext> </mtext><mtext>=</mtext><mtext> </mtext><mtext>[Ar]</mtext><mtext> </mtext><msup> <mrow> <mtext>3d</mtext></mrow> <mtext>6</mtext> </msup> <msup> <mrow> <mtext>4s</mtext></mrow> <mtext>0</mtext> </msup> </mrow> </math><br /><br /><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/150939_d1.PNG\" style=\"max-width:100%; object-fit:contain\" style=\"width: 461px; height: 137px;\" />",
