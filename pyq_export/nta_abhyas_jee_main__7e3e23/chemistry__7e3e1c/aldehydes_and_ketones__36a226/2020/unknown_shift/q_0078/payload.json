      "text": "<math><msub><mrow><mfenced separators=\"|\"><mrow><mtext>C</mtext><msub><mrow><mtext>H</mtext></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub><mtext>C</mtext><mtext>H</mtext><mtext>O</mtext><mtext>H</mtext></math>",
      "is_correct": true
