    {
      "text": "<math><mtext>C</mtext><msub><mrow><mtext>H</mtext></mrow><mrow><mn>3</mn></mrow></msub><mtext>C</mtext><mtext>O</mtext><mtext>C</mtext><msub><mrow><mtext>H</mtext></mrow><mrow><mn>3</mn></mrow></msub></math>",
