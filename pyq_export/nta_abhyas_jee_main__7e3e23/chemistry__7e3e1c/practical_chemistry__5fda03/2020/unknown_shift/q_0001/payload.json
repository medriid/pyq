  "question": {
    "text": "The correct match between item 'I' and item 'II' is\r<table border=\"1px solid\">\r\t<thead>\r\t\t<tr>\r\t\t\t<th>Item I (Compound)</th>\r\t\t\t<th>Item II (Reagent)</th>\r\t\t</tr>\r\t</thead>\r\t<tbody>\r\t\t<tr>\r\t\t\t<td>(1) Lysine</td>\r\t\t\t<td>(P) 1-naphthol</td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>(2) Furfural</td>\r\t\t\t<td>(Q) ninhydrin</td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>(3) Isopropyl alcohol</td>\r\t\t\t<td>(R) <math><msub><mrow><mi mathvariant=\"normal\">K</mi><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub></math></td>\r\t\t</tr>\r\t\t<tr>\r\t\t\t<td>(4) Vinyl benzene (Styrene)</td>\r\t\t\t<td>(S) Ceric ammonium Nitrate</td>\r\t\t</tr>\r\t</tbody>\r</table>\r"
  },
  "options": [
