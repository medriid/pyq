  "question": {
    "text": "Among given compounds, how many compounds will react with NaHCO<sub>3</sub> or soluble in NaHCO<sub>3</sub> ?<br />\r<br />\r<u><strong><img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0023017_Quest_1_1.jpg\" style=\"width: 358px; height: 140px;\" /><br />\r<img alt=\"\" src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/EM0023017_Quest_1_2.jpg\" style=\"width: 358px; height: 140px;\" /></strong></u>",
    "image": null
  },
