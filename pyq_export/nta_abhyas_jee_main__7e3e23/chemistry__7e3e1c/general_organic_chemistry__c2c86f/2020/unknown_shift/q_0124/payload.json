  "question": {
    "text": "Arrange the following in increasing order of acidic strength<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0124_8eb0785b5aa1.jpeg\" style=\"max-width:100%; object-fit:contain\" style=\"width: 500px; height: 260px;\" />"
