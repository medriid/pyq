  "question": {
    "text": "<div>\r<p align=\"left\" style=\"text-align:left\"><span>Which of the following will have least hindered rotation about carbon-carbon bond?</span></p>\r</div>\r",
    "image": null
  },
  "options": [
    {
      "id": "nkMTr",
      "text": "<div><p align=\"left\" style=\"text-align:left\"><span>Acetylene</span></p></div>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7Q6qV",
      "text": "<div><p align=\"left\" style=\"text-align:left\"><span>Hexachloroethane</span></p></div>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "b6jxJ",
      "text": "<div><p align=\"left\" style=\"text-align:left\"><span>Ethane</span></p></div>",
