  "question": {
    "text": "Write the IUPAC name of the following compound<br />\r<br />\r<img alt=\"\" src=\"assets\\qt0145_a2b7400595a5.jpg\" style=\"max-width:\"100%\"; object-fit:contain\" style=\"width: 200px; height: 108px;\" />"
  },
  "options": [
