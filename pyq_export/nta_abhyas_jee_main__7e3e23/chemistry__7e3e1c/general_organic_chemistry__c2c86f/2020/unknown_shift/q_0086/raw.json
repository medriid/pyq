  "question": {
    "text": "The order of ka values of the following acids is :-<br />\r<br />\r<img src=\"https://cdn-question-pool.getmarks.app/nta_abhyas/jee_main/images/xzfgjmvcrktjwlvajdibmlqlkiyzqgmknwdamqkvlddzaacmma.png\" />",
