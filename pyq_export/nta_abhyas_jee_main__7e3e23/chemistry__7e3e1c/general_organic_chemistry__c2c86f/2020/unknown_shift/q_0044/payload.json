  "question": {
    "text": "The order of stability of the following tautomeric compound is<br />\r<br />\r<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mrow><msub><mi>CH</mi><mn>2</mn></msub><mo>=</mo><mi mathvariant=\"normal\">C</mi><mo>(</mo><mi>OH</mi><mo>)</mo><mo>-</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>-</mo><mi>CO</mi><mo>-</mo><msub><mi>CH</mi><mn>3</mn></msub></mrow><mfenced separators=\"|\"><mi mathvariant=\"normal\">I</mi></mfenced></munder><mo>→</mo><munder><mrow><msub><mi>CH</mi><mn>3</mn></msub><mo>-</mo><mi>CO</mi><mo>-</mo><msub><mi>CH</mi><mn>2</mn></msub><mo>-</mo><mi>CO</mi><mo>-</mo><msub><mi>CH</mi><mn>3</mn></msub></mrow><mfenced separators=\"|\"><mi>II</mi></mfenced></munder><mo>→</mo><munder><mrow><msub><mi>CH</mi><mn>3</mn></msub><mo>-</mo><mi mathvariant=\"normal\">C</mi><mo>(</mo><mi>OH</mi><mo>)</mo><mo>=</mo><mi>CH</mi><mo>-</mo><mi>CO</mi><mo>-</mo><msub><mi>CH</mi><mn>3</mn></msub></mrow><mfenced separators=\"|\"><mi>III</mi></mfenced></munder></math>"
  },
  "options": [
    {
      "text": "III &gt; II &gt; I",
      "is_correct": true
    },
