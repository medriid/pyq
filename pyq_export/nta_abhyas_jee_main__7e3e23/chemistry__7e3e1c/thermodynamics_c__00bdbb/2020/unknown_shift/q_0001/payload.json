    },
    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">W</mi></mrow><mrow><mtext>isothermal</mtext></mrow></msub><mo>&gt;</mo><msub><mrow><mi mathvariant=\"normal\">w</mi></mrow><mrow><mtext>adiabatic</mtext></mrow></msub></math>",
