      "is_correct": true
    },
    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>2</mn></mrow></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">Δ</mi><msub><mrow><mi mathvariant=\"normal\">U</mi></mrow><mrow><mtext>isothermal</mtext></mrow></msub><mo>&gt;</mo><mi mathvariant=\"normal\">Δ</mi><msub><mrow><mi mathvariant=\"normal\">U</mi></mrow><mrow><mtext>adiabatic</mtext></mrow></msub></math>",
