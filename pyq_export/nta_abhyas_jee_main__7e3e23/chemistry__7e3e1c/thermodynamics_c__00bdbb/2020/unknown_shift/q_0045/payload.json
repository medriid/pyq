o><mi mathvariant=\"normal\">S</mi></math> …(ii)<br />From equations. (i) and (ii)<br /><math><mi mathvariant=\"normal\">G</mi><mo>=</mo><mi mathvariant=\"normal\">H</mi><mo>+</mo><mi mathvariant=\"normal\">T</mi><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">G</mi></mrow><mrow><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">T</mi></mrow></mfrac></math><br />or <math><mi mathvariant=\"normal\">G</mi><mo>=</mo><mi mathvariant=\"normal\">H</mi><mo>+</mo><mi mathvariant=\"normal\">T</mi><msub><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mo>∂</mo><mi mathvariant=\"normal\">G</mi></mrow><mrow><mo>∂</mo><mi mathvariant=\"normal\">T</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">P</mi></mrow></msub></math><br /><math><mo>-</mo><mfrac><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>=</mo><mo>-</mo><mfrac><mrow><mi mathvariant=\"normal\">G</mi></mrow><mrow><msup><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">T</mi></mrow></mfrac><msub><mrow><mfenced separators=\"|\"><mrow><mfrac><mrow><mo>∂</mo><mi mathvariant=\"normal\">G</mi></mrow><mrow><mo>∂</mo><mi mathvariant=\"normal\">T</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">P</mi></mrow></msub><mo>=</mo><msub><mrow><mfenced close=\"]\" open=\"[\" separators=\"|\"><mrow><mfrac><mrow><mo>∂</mo><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">G</mi><mo>/</mo><mi mathvariant=\"normal\">T</mi></mrow></mfenced></mrow><mrow><mo>∂</mo><mi mathvariant=\"normal\">T</mi></mrow></mfrac></mrow></mfenced></mrow><mrow><mi mathvariant=\"normal\">P</mi></mrow></msub></math><br /><math><mi mathvariant=\"normal\">H</mi><mo>=</mo><mo>-</mo><msup><mrow><mi mathvariant=\"normal\">T</mi></mrow><mrow><mn>2</mn></mrow></