    {
      "text": "only ethane",
      "is_correct": false
    },
    {
      "text": "only ethene",
      "is_correct": true
    },
    {
      "text": "1:1 mixtures of two gases",
      "is_correct": false
    },
    {
      "text": "some unknown mixture of the two gases",
      "is_correct": false
