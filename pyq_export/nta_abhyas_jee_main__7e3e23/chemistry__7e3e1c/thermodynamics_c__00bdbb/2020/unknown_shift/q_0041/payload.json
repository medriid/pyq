  "question": {
    "text": "When one mole of zinc dust and one mole of sulphuric acid react in a bomb calorimeter, then <math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi></math> and <math><mi mathvariant=\"normal\">w</mi></math> correspond to"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mo>&gt;</mo><mn>0</mn><mo>,</mo><mo> </mo><mi mathvariant=\"normal\">w</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": true
    },
    {
      "text": "<math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mo>&lt;</mo><mn>0</mn><mo>,</mo><mo> </mo><mi mathvariant=\"normal\">w</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mo>=</mo><mn>0</mn><mo>,</mo><mo> </mo><mi mathvariant=\"normal\">w</mi><mo>=</mo><mn>0</mn></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">U</mi><mo>&lt;</mo><mn>0</mn><mo>,</mo><mo> </mo><mi mathvariant=\"normal\">w</mi><mo>&gt;</mo><mn>0</mn></math>",
