    {
      "text": "<table border=\"1\"><tr><td> q</td><td> w</td><td> <math><mi mathvariant=\"normal\">Δ</mi><mi mathvariant=\"normal\">E</mi></math></td></tr><tr><td> 250 J</td><td> 460 J</td><td> 710 J</td></tr></table>",
