mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">P</mi></mrow><mrow><mi mathvariant=\"normal\">P</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">V</mi></mrow></mfrac><mo>×</mo><mn>100</mn><mo>=</mo><mn>0</mn></math><br><br><math ><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">P</mi></mrow><mrow><mi mathvariant=\"normal\">P</mi></mrow></mfrac><mo>×</mo><mn>100</mn><mo>=</mo><mo>-</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mfrac><mrow><mi mathvariant=\"normal\">d</mi><mi mathvariant=\"normal\">V</mi></mrow><mrow><mi mathvariant=\"normal\">V</mi></mrow></mfrac><mo>×</mo><mn>100</mn></math><br><br><math ><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>×</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>4</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn></mrow><mrow><mn>16</mn></mrow></mfrac></math>"
