  "question": {
    "text": "Which is best method for leaching of bauxite ore of aluminium,&nbsp; containing impurities of iron oxide?"
  },
  "options": [
    {
      "text": "Electrolytic reduction",
      "is_correct": false
    },
    {
      "text": "Halt and Heroult process",
      "is_correct": false
    },
    {
      "text": "Baeyer's process",
      "is_correct": true
    },
    {
      "text": "Serpeck's process",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "For the leaching of red bauxite which contains iron oxide as impurity Baeyer's process is used. For the purification of white bauxite which contains silica as the main impurity Serpeck's process is used."
