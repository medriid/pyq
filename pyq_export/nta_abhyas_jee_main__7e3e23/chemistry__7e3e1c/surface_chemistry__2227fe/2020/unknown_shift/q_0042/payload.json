    {
      "text": "<math><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">h</mi><msub><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">S</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub></mrow></mfenced></mrow><mrow><mn>2</mn></mrow></msub></math>",
