    {
      "text": "<math><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">l</mi><msub><mrow><mfenced separators=\"|\"><mrow><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>3</mn></mrow></msub></mrow></mfenced></mrow><mrow><mn>3</mn></mrow></msub></math>",
      "is_correct": false
