  "question": {
    "text": "Which of the following electrolytes will have maximum coagulating value for  <math><mfrac><mrow><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">I</mi></mrow><mrow><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mo>+</mo></mrow></msup></mrow></mfrac></math>  sol?"
  },
  "options": [
    {
      "text": "<math><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">S</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math><mi mathvariant=\"normal\">N</mi><msub><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>3</mn></mrow></msub><mi mathvariant=\"normal\">P</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub></math>",
