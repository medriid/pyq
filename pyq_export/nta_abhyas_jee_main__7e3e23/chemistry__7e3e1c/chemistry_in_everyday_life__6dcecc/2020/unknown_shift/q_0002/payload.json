  "question": {
    "text": "Food preservatives prevent spoilage of food due to microbial growth. The most commonly used preservatives are"
  },
  "options": [
    {
      "text": "table salt, sugar",
      "is_correct": false
    },
    {
      "text": "vegetable oils and sodium benzoate",
      "is_correct": false
    },
    {
      "text": "<math><msub><mrow><mi mathvariant=\"normal\">C</mi></mrow><mrow><mn>6</mn></mrow></msub><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>5</mn></mrow></msub><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">O</mi><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">a</mi></math>",
      "is_correct": false
    },
    {
      "text": "all of the above",
      "is_correct": true
