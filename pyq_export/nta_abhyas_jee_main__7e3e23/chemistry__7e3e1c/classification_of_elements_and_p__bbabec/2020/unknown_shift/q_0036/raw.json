  "question": {
    "text": "Identify the correct decreasing order of acid strength for the following compounds:<br />\r<br />\r<math> <mrow> <mtext>(I)</mtext><mtext> </mtext><mtext>HClO,</mtext><mtext> </mtext><mtext>(II)</mtext><mtext> </mtext><mtext>HBrO,</mtext><mtext> </mtext><mtext>(III)</mtext><mtext> </mtext><mtext>HIO</mtext></mrow> </math>",
    "image": null
  },
  "options": [
    {
      "id": "HivoM",
      "text": "I &gt; II &gt; III",
      "image": null,
      "isCorrect": true
    },
    {
