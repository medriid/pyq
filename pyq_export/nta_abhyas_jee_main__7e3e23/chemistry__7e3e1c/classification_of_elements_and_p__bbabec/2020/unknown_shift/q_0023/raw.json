  "question": {
    "text": "Which of the following represents the correct order of increasing first ionization enthalpy for Ca, Ba, S, Se and Ar ?",
    "image": null
  },
  "options": [
    {
      "id": "vrfEf",
      "text": "Ba &lt; Ca &lt; Se &lt; S &lt; Ar",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "mSRmp",
