  "question": {
    "text": "<p>Electron gain enthalpy and ionisation energy of an atom are –a and +b eV respectively. The electronegativity of that atom on Mulliken scale is given by :</p>\r",
    "image": null
  },
  "options": [
    {
      "id": "WnFaW",
      "text": "a &ndash; b",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9m5AC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">b</mi><mo>-</mo><mi mathvariant=\"normal\">a</mi></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6NImU",
      "text": "a + b",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xFmLW",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi mathvariant=\"normal\">a</mi><mo>+</mo><mi mathvariant=\"normal\">b</mi></mrow><mn>2</mn></mfrac></math>",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>EN</mtext><mo>=</mo><mfrac><mrow><mtext>IE</mtext><mo>+</mo><mi mathvariant=\"normal\">E</mi><mo>⁡</mo><mi mathvariant=\"normal\">A</mi><mo>⁡</mo></mrow><mn>2</mn></mfrac><mspace width=\"0.5em\"></mspace><mtext>and</mtext><mspace width=\"0.5em\"></mspace><mi mathvariant=\"normal\">E</mi><mo>⁡</mo><mi mathvariant=\"normal\">A</mi><mo>⁡</mo><mo>=</mo><mo>-</mo><mi mathvariant=\"normal\">E</mi><msub><mo>⁡</mo><mrow><mtext>g</mtext><mi mathvariant=\"normal\">a</mi></mrow></msub></math>",
