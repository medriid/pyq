  "question": {
    "text": "The effective nuclear charge of an element with three valence electrons is 2.60. What is the minimum atomic number of the element?",
    "image": null
  },
  "options": [
    {
      "id": "wdpdK",
      "text": "5",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "j26hC",
      "text": "4",
