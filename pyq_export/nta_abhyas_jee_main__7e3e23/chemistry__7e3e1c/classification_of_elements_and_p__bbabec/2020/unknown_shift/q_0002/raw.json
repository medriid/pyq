  "question": {
    "text": "Which of the following order is correct for the property mentioned in brackets?",
    "image": null
  },
  "options": [
    {
      "id": "FRBHp",
      "text": "<math><msup><mrow><mi mathvariant=\"normal\">S</mi></mrow><mrow><mn>2</mn><mo>-</mo></mrow></msup><mo>&gt;</mo><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">l</mi></mrow><mrow><mo>-</mo></mrow></msup><mo>&gt;</mo><msup><mrow><mi mathvariant=\"normal\">K</mi></mrow><mrow><mo>+</mo></mrow></msup><mo>&gt;</mo><mi mathvariant=\"normal\">C</mi><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mn>2</mn><mo>+</mo></mrow></msup></math> (Ionization energy)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "L7fwx",
      "text": "<math><mi mathvariant=\"normal\">C</mi><mo>&lt;</mo><mi mathvariant=\"normal\">N</mi><mo>&lt;</mo><mi mathvariant=\"normal\">F</mi><mo>&lt;</mo><mi mathvariant=\"normal\">O</mi></math> (2nd Ionization energy)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "0JlhC",
      "text": "<math><mi mathvariant=\"normal\">B</mi><mo>&gt;</mo><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">l</mi><mo>&gt;</mo><mi mathvariant=\"normal\">G</mi><mi mathvariant=\"normal\">a</mi><mo>&gt;</mo><mi mathvariant=\"normal\">I</mi><mi mathvariant=\"normal\">n</mi><mo>&gt;</mo><mi mathvariant=\"normal\">T</mi><mi mathvariant=\"normal\">l</mi></math> (Electronegativity)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BQawD",
      "text": "<math><mi mathvariant=\"normal\">N</mi><msup><mrow><mi mathvariant=\"normal\">a</mi></mrow><mrow><mo>+</mo></mrow></msup><mo>&gt;</mo><mi mathvariant=\"normal\">L</mi><msup><mrow><mi mathvariant=\"normal\">i</mi></mrow><mrow><mo>+</mo></mrow></msup><mo>&gt;</mo><mi mathvariant=\"normal\">M</mi><msup><mrow><mi mathvariant=\"normal\">g</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup><mo>&gt;</mo><mi mathvariant=\"normal\">B</mi><msup><mrow><mi mathvariant=\"normal\">e</mi></mrow><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&gt;</mo><mi mathvariant=\"normal\">A</mi><msup><mrow><mi mathvariant=\"normal\">l</mi></mrow><mrow><mn>3</mn><mo>+</mo></mrow></msup></math> (Ionic radius)",
