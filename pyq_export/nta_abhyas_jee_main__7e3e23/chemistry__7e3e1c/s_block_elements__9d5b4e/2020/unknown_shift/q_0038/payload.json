  "question": {
    "text": "When potassium is reacted with oxygen, which of the following compound(s) is/are formed?"
  },
  "options": [
    {
      "text": "<math> <mrow>  <msub>   <mtext>K</mtext>   <mtext>2</mtext>  </msub>  <mtext>O</mtext></mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mrow>    <mtext>KO</mtext></mrow>   <mtext>2</mtext>  </msub>  </mrow></math>",
      "is_correct": true
    },
    {
      "text": "Both <math> <mrow>  <msub>   <mtext>K</mtext>   <mtext>2</mtext>  </msub>  <mtext>O</mtext></mrow></math> and <math> <mrow>  <msub>   <mrow>    <mtext>KO</mtext></mrow>   <mtext>2</mtext>  </msub>  </mrow></math>",
      "is_correct": false
    },
    {
      "text": "<math> <mrow>  <msub>   <mtext>K</mtext>   <mtext>2</mtext>  </msub>  <msub>   <mtext>O</mtext>   <mtext>2</mtext>  </msub>  </mrow></math>",
