  "question": {
    "text": "Which one of the following pairs of substances on reaction will not evolve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub></math> gas?"
  },
  "options": [
    {
      "text": "Iron and steam",
      "is_correct": false
    },
    {
      "text": "Iron and&nbsp;<math><mrow><msub><mtext>H</mtext> <mn>2</mn> </msub> <mtext>S</mtext><msub> <mtext>O</mtext> <mn>4</mn> </msub> </mrow> </math> (aqueous)",
      "is_correct": false
