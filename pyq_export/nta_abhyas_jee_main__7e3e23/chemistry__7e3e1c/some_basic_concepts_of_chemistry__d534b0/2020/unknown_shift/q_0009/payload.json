  "solution": {
    "text": "<math><munder><mrow><mn>2</mn><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">l</mi></mrow><mrow><munder><mrow><mn>2</mn><mtext> moles</mtext></mrow><mrow><mfenced separators=\"|\"><mrow><mn>2</mn><mo>×</mo><mn>58.5</mn><mo>=</mo><mn>117</mn><mi mathvariant=\"normal\">g</mi></mrow></mfenced></mrow></munder></mrow></munder><mo>+</mo><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">n</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>2</mn></mrow></msub><mo>+</mo><mn>3</mn><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">S</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub><mo>→</mo><mn>2</mn><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">H</mi><mi mathvariant=\"normal\">S</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub><mo>+</mo><mi mathvariant=\"normal\">M</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">S</mi><msub><mrow><mi mathvariant=\"normal\">O</mi></mrow><mrow><mn>4</mn></mrow></msub><mo>+</mo><munder><mrow><mi mathvariant=\"normal\">C</mi><msub><mrow><mi mathvariant=\"normal\">l</mi></mrow><mrow><mn>2</mn></mrow></msub></mrow><mrow><munder><mrow><mn>1</mn><mtext> mole</mtext></mrow><mrow><mn>22.4</mn><mtext> L</mtext><mfenced separators=\"|\"><mrow><mtext>STP</mtext></mrow></mfenced></mrow></munder></mrow></munder><mo>+</mo><mn>2</mn><msub><mrow><mi mathvariant=\"normal\">H</mi></mrow><mrow><mn>2</mn></mrow></msub><mi mathvariant=\"normal\">O</mi></math> <br/><br/>117 g of NaCl  <math><mo>≡</mo><mn>22.4</mn></math>  L of  <math><mi mathvariant=\"normal\">C</mi><msub><mrow><mi mathvariant=\"normal\">l</mi></mrow><mrow><mn>2</mn></mrow></msub></math> <br/><br/>50 g of  <math><mi mathvariant=\"normal\">N</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant