  "question": {
    "text": "The sequence of an mRNA molecule produced from a DNA template strand with the composition <br/><br/>5'-AGCTACACT-3' is",
    "image": null
  },
  "options": [
    {
      "id": "1mvA9",
      "text": "5'-AGUGUAGCU-3'",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "10EcD",
      "text": "5'-UCGAUGUGA-3'",
      "image": null,
      "isCorrect": true
    },
    {
