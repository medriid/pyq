  "question": {
    "text": "Which of the following compound does not follow Huckel&#39;s rule?&nbsp;"
  },
  "options": [
    {
      "text": "<p><img src=\"assets\\ot1_0021_f6ce9d8b0eff.png\" style=\"width: 120px; height: 117px;\" /></p>",
