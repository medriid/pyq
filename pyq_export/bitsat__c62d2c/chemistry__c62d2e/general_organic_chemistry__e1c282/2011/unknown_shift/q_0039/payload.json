      "text": "$\\mathrm{CH}_{3} \\mathrm{CHDCH}_{2} \\mathrm{Cl}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{CH}_{3} \\mathrm{CHClCH}_{2} \\mathrm{D}$",
      "is_correct": false
    },
    {
