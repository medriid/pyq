  "question": {
    "text": "What is $\\left[\\mathrm{NH}_4^{+}\\right]$in a solution that is $0.02 \\mathrm{M} \\mathrm{NH}_3$ $0.01 \\mathrm{M} \\mathrm{KOH} ?\\left[K_b\\left(\\mathrm{NH}_3\\right)=1.8 \\times 10^{-5}\\right]$"
  },
  "options": [
    {
      "text": "\r\n$3.6 \\times 10^{-5} \\mathrm{M}$\r\n",
      "is_correct": true
    },
    {
      "text": "\r\n$1.8 \\times 10^{-5} \\mathrm{M}$\r\n",
      "is_correct": false
    },
    {
      "text": "\r\n$0.9 \\times 10^{-5} \\mathrm{M}$\r\n",
      "is_correct": false
    },
    {
      "text": "\r\n$7.2 \\times 10^{-5} \\mathrm{M}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{NH}_4 \\mathrm{OH} \\rightleftharpoons \\mathrm{NH}_4^{+}+\\mathrm{OH}^{-}$\r\n$K_b=\\frac{\\left[\\mathrm{NH}_4^{+}\\right]\\left[\\mathrm{OH}^{-}\\right]}{\\left[\\mathrm{NH}_4 \\mathrm{OH}\\right]}$\r\n$1.8 \\times 10^{-5}=\\frac{\\left[\\mathrm{NH}_4^{+}\\right][0.01]}{[0.02]}$\r\n$\\therefore \\quad\\left[\\mathrm{NH}_4^{+}\\right]=3.6 \\times 10^{-5} \\mathrm{M}$"
  }
}