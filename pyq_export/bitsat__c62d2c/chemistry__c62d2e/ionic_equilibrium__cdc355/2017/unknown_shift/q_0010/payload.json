  "question": {
    "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>BF</mi><mn>3</mn></msub></math> is an acid, according to"
  },
  "options": [
    {
      "text": "Lewis",
      "is_correct": true
    },
    {
      "text": "Arrhenius",
      "is_correct": false
