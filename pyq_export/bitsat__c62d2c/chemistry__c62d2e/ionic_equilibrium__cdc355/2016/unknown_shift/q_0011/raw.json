  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "For a sparingly soluble salt $A_{p} B_{q}$, the relationship of its solubility product $L s \\rightarrow K_{s p}$ with its solubility (S) is",
    "image": null
  },
  "options": [
    {
      "id": "bKdDV",
      "text": "$\\quad \\mathrm{Ls} \\rightarrow \\mathrm{K}_{\\mathrm{sp}}=\\mathrm{S}^{\\mathrm{pq}}(\\mathrm{pq})^{\\mathrm{P}+\\mathrm{q}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SiZxz",
      "text": "$\\mathrm{Ls}=\\mathrm{S}^{\\mathrm{p}+\\mathrm{q}} \\cdot \\mathrm{p}^{\\mathrm{p}} \\mathrm{q}^{\\mathrm{q}}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "6iXyW",
      "text": "$\\quad \\mathrm{Ls} \\rightarrow \\mathrm{K}_{\\mathrm{sp}}=\\mathrm{S}^{\\mathrm{p}+\\mathrm{q}} \\cdot \\mathrm{p}^{\\mathrm{q}} \\mathrm{q}^{\\mathrm{p}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "MXPfM",
      "text": "$\\quad \\mathrm{Ls} \\rightarrow \\mathrm{K}_{\\mathrm{sp}}=\\mathrm{S}^{\\mathrm{pq}} \\mathrm{p}^{\\mathrm{P}} \\mathrm{q}^{\\mathrm{q}}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{ApBq} \\rightleftharpoons \\mathrm{pA}_{\\mathrm{Sp}}^{+}+\\mathrm{qB}_{\\mathrm{Sq}}$\r\n\r\nLet the solubility be $\\mathrm{S} \\mathrm{mol} /$ liter Thus,\r\n\r\n\\begin{aligned}\r\n\r\n\\mathrm{K}_{\\mathrm{sp}} &=\\left[\\mathrm{A}^{+}\\right]^{\\mathrm{p}}\\left[\\mathrm{B}^{-}\\right]^{\\mathrm{q}} \\\\\r\n\r\n&=[\\mathrm{Sp}]^{\\mathrm{p}}[\\mathrm{Sq}]^{\\mathrm{q}}=\\mathrm{p}^{\\mathrm{p} \\cdot} \\mathrm{q}^{\\mathrm{q}}(\\mathrm{S})^{\\mathrm{p}+\\mathrm{q}}\r\n\r\n\\end{aligned}",
    "image": null
  },
