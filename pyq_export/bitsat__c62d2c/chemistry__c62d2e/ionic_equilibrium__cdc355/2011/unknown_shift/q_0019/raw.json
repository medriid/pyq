  "question": {
    "text": "The pH of a solution is increased from 3 to 6 ; its $\\mathrm{H}^{+}$ ion concentration will be",
    "image": null
  },
  "options": [
    {
      "id": "eHgcH",
      "text": "reduced to half",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "y53CI",
      "text": "doubled",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WWmWE",
      "text": "reduced by 1000 times",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "aIqiz",
      "text": "increased by 1000 times",
      "image": null,
      "isCorrect": false
    }
