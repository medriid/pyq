  "question": {
    "text": "The pH of a solution is increased from 3 to 6 ; its $\\mathrm{H}^{+}$ ion concentration will be"
  },
  "options": [
    {
      "text": "reduced to half",
      "is_correct": false
    },
    {
      "text": "doubled",
      "is_correct": false
    },
    {
      "text": "reduced by 1000 times",
      "is_correct": true
    },
    {
      "text": "increased by 1000 times",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{pH}=3 \\ldots\\left[\\mathrm{H}^{+}\\right]=10^{-3} ; \\quad \\mathrm{pH}=6$\n$\\therefore\\left[\\mathrm{H}^{+}\\right]=10^{-6}$. Hence $\\left[\\mathrm{H}^{+}\\right]$ is reduced by\n$10^{-3}$ times."
  }
}