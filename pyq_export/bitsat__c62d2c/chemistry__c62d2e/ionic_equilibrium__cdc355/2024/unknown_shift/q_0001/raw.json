  "question": {
    "text": "The pH of 1 N aqueous solutions of HCl , $\\mathrm{CH}_3 \\mathrm{COOH}$ and HCOOH follows the order:",
    "image": null
  },
  "options": [
    {
      "id": "2XKqU",
      "text": "$\\mathrm{HCl}\\gt\\mathrm{HCOOH}\\gt\\mathrm{CH}_3 \\mathrm{OOH}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6iLDy",
      "text": "$\\mathrm{HCl}=\\mathrm{HCOOH}\\gt\\mathrm{CH}_3 \\mathrm{COOH}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "sbOl0",
      "text": "$\\mathrm{CH}_3 \\mathrm{COOH}\\gt\\mathrm{HCOOH}\\gt\\mathrm{HCl}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "6Jar1",
      "text": "$\\mathrm{CH}_3 \\mathrm{COOH}=\\mathrm{HCOOH}\\gt\\mathrm{HCl}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Stronger the acid, lower is the pH or weaker the acid, higher the pH .\nThe strength of the given acid is in the order\n$\\mathrm{HCl}\\gt\\mathrm{HCOOH}\\gt\\mathrm{CH}_3 \\mathrm{COOH}$\nHence, their pH is in the order\n$\\mathrm{CH}_3 \\mathrm{COOH}\\gt\\mathrm{HCOOH}\\gt\\mathrm{HCl}$",
    "image": null
  },
