  "question": {
    "text": "A certain metal sulphide, $M S_2$, is used extensively as a high temperature lubricant. If $\\mathrm{MS}_2$ is $40.06 \\%$ by mass sulphur, metal $M$ has atomic mass."
  },
  "options": [
    {
      "text": "\r\n$160 \\mathrm{u}$\r\n",
      "is_correct": false
    },
    {
      "text": "\r\n$64 \\mathrm{u}$\r\n",
      "is_correct": false
    },
    {
      "text": "\r\n$40 \\mathrm{u}$\r\n",
      "is_correct": false
    },
    {
      "text": "\r\n$96 \\mathrm{u}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$M S_2=M+32 \\times 2=M+64$\r\n$\\%$ of sulphur $=\\left(\\frac{64}{M+64}\\right) \\times 100=40.06$\r\n$M+64=\\frac{6400}{40.06}$\r\n$M+64=160$\r\n$M=160-64=96$ u"
  }
}