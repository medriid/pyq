  "question": {
    "text": "Which of the following has the largest&nbsp;number of moles?",
    "image": null
  },
  "options": [
    {
      "id": "D8g5m",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>8</mn><mo>&#160;</mo><mi mathvariant=\"normal\">g</mi></math>&nbsp;of oxygen atoms",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "TGxlL",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><mo>&#160;</mo><mi mathvariant=\"normal\">g</mi></math> of oxygen gas",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "7jwRE",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>14</mn><mo>&#160;</mo><mi mathvariant=\"normal\">g</mi></math> of nitrogen gas <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><msub><mi mathvariant=\"normal\">N</mi><mn>2</mn></msub></mfenced></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "zCu2x",
      "text": "All have the same number of&nbsp;moles",
      "isCorrect": true,
      "image": null
