  "question": {
    "text": "The fraction of total volume occupied by the atoms present in a simple cube is"
  },
  "options": [
    {
      "text": "$\\frac{\\pi}{3 \\sqrt{2}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{4 \\sqrt{2}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\pi}{6}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Number of atoms per unit cell $=1$ Atoms touch each other along edges. Hence $r=\\frac{a}{2}$\n$(\\mathrm{r}=$ radius of atom and $\\mathrm{a}=$ edge length)\nTherefore $\\%$ $=\\frac{\\frac{4}{3} \\pi r^{3}}{(2 r)^{3}}=\\frac{\\pi}{6}$"
  }
}