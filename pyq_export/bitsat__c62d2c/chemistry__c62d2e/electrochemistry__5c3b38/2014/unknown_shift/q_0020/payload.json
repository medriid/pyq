  "question": {
    "text": "$\\mathrm{Cu}_{\\mathrm{aq}}^{+}$ is unstable in solution and undergoes simultaneous oxidation and reduction according to the reaction :\r\n\r\n$2 \\mathrm{Cu}^{+}(\\mathrm{aq}) \\rightleftharpoons \\mathrm{Cu}^{2+}(\\mathrm{aq})+\\mathrm{Cu}(\\mathrm{s})$\r\n\r\nchoose correct $\\mathrm{E}^{\\circ}$ for above reaction if\r\n\r\n$\\mathrm{E}^{\\circ} \\mathrm{Cu}^{2+}=0.34 \\mathrm{~V}$ and $\\mathrm{E}^{\\circ} \\mathrm{Cu}^{2+}=0.15 \\mathrm{~V}$"
  },
  "options": [
    {
      "text": "$-0.38 \\mathrm{~V}$",
      "is_correct": false
    },
    {
      "text": "$+0.49 \\mathrm{~V}$",
      "is_correct": false
    },
    {
      "text": "$+0.38 \\mathrm{~V}$",
      "is_correct": true
    },
    {
      "text": "$-0.19 \\mathrm{~V}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$2 \\mathrm{Cu}^{+} \\longrightarrow \\mathrm{Cu}^{+2}+\\mathrm{Cu}$\r\n\r\n$2 \\mathrm{e}^{-}+\\mathrm{Cu}^{+2} \\longrightarrow \\mathrm{Cu} ; \\mathrm{E}_{1}^{\\circ}=0.34 \\mathrm{~V} ; \\ldots$ (i)\r\n\r\n$\\mathrm{e}^{-}+\\mathrm{Cu}^{+2} \\longrightarrow \\mathrm{Cu}^{+} ; \\mathrm{E}_{2}^{\\circ}=0.15 \\mathrm{~V} ; \\ldots$ (ii)\r\n\r\n$\\mathrm{Cu}^{+}+\\mathrm{e}^{-} \\rightarrow \\mathrm{Cu} ; \\mathrm{E}_{3}^{\\circ}=?$ ...(iii)\r\n\r\nNow, $\\Delta \\mathrm{G}_{1}^{\\circ}=-\\mathrm{nFE}_{1}^{\\circ}=-2 \\times 0.34 \\mathrm{~F}$\r\n\r\n$\\Delta \\mathrm{G}_{2}^{\\circ}=-1 \\times 0.15 \\mathrm{~F}, \\Delta \\mathrm{G}_{3}^{\\circ}=-1 \\times \\mathrm{E}_{3}^{\\circ} \\mathrm{F}$\r\n\r\nAgain, $\\Delta \\mathrm{G}_{1}^{\\circ}=\\Delta \\mathrm{G}_{2}^{\\circ}+\\Delta \\mathrm{G}_{3}^{\\circ}$\r\n\r\n$\\Rightarrow-0.68 \\mathrm{~F}=-0.15 \\mathrm{~F}-\\mathrm{E}_{3} \\mathrm{~F}$\r\n\r\n$0 \\Rightarrow \\mathrm{E}_{3}^{\\circ}=0.68-0.15=0.53 \\mathrm{~V}$\r\n\r\n$\\mathrm{E}_{\\text {cell }}^{\\circ}=\\mathrm{E}_{\\text {cathode }}^{\\circ}\\left(\\mathrm{Cu}^{+} / \\mathrm{Cu}\\right)$\r\n\r\n$=0.53-0.15=0.38 \\mathrm{~V}$"
  }
