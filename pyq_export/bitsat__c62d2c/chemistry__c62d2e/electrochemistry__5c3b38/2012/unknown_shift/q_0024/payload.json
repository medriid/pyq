  "question": {
    "text": "The ionic conductance of $\\mathrm{Ba}^{2+}$ and $\\mathrm{Cl}^{-}$ respectively are 127 and $76 \\Omega^{-1} \\mathrm{~cm}^{2}$ at infinite dilution. The equivalent conductance of $\\mathrm{BaCl}_{2}$, at infinite dilution will be"
  },
  "options": [
    {
      "text": "$330 \\Omega^{-1} \\mathrm{~cm}^{2}$",
      "is_correct": false
    },
    {
      "text": "$203 \\Omega^{-1} \\mathrm{~cm}^{2}$",
      "is_correct": false
    },
    {
      "text": "$139 \\Omega^{-1} \\mathrm{~cm}^{2}$",
      "is_correct": true
    },
    {
      "text": "$51 \\Omega^{-1} \\mathrm{~cm}^{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\lambda_{\\mathrm{m}}^{\\circ} \\text { for } \\mathrm{BaCl}_{2}=\\lambda_{\\mathrm{m}}^{\\circ} \\mathrm{Ba}^{2+}+\\lambda_{\\mathrm{m}}^{\\circ} \\mathrm{Cl}^{-} \\\\ &=\\frac{1}{2} \\times 127+76=139.5 \\Omega^{-1} \\mathrm{~cm}^{2} \\end{aligned}$"
  }
}