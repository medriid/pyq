  "question": {
    "text": "The efficiency of fuel cell is given by the expression, $\\eta$ is"
  },
  "options": [
    {
      "text": "$\\eta=-\\frac{\\mathrm{nFE}_{\\text {cell }}}{\\Delta \\mathrm{H}} \\times 100$",
      "is_correct": true
    },
    {
      "text": "$\\eta=-\\frac{\\mathrm{nFE}_{\\text {cell }}}{\\Delta \\mathrm{S}} \\times 100$",
      "is_correct": false
    },
    {
      "text": "$\\eta=-\\frac{\\mathrm{nFE}_{\\text {cell }}}{\\Delta \\mathrm{A}} \\times 100$",
      "is_correct": false
    },
    {
      "text": "None of the above",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Efficiency of fuel cell is:\r\n\r\n$\\eta=\\frac{-n F E_{\\text {cell }}}{\\Delta H} \\times 100$"
  }
