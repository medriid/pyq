  "question": {
    "text": "At $25^{\\circ} \\mathrm{C}$, the molar conductance at infinite dilution for the strong electrolytes $\\mathrm{NaOH}, \\mathrm{NaCl}$ and $\\mathrm{BaCl}_{2}$ are $248 \\times 10^{-4}, 126 \\times 10^{-4}$ and $280 \\times 10^{-4} \\mathrm{Sm}^{2} \\mathrm{~mol}^{-1}$ respectively. $\\Delta_{\\mathrm{m}}{ }^{0} \\mathrm{Ba}(\\mathrm{OH})_{2}$ in $\\mathrm{Sm}^{2} \\mathrm{~mol}^{-1}$ is"
  },
  "options": [
    {
      "text": "$52.4 \\times 10^{-4}$",
      "is_correct": false
    },
    {
      "text": "$524 \\times 10^{-4}$",
      "is_correct": true
    },
    {
      "text": "$402 \\times 10^{-4}$",
      "is_correct": false
    },
    {
      "text": "$262 \\times 10^{-4}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\Delta_{\\mathrm{Na}^{+}}^{\\circ}+\\Delta_{\\mathrm{OH}^{-}}^{\\circ}=248 \\times 10^{-4} \\mathrm{Sm}^{2} \\mathrm{~mol}^{-1}$ $\\Delta_{\\mathrm{Na}^{+}}^{\\circ}+\\Delta_{\\mathrm{Cl}^{-}}^{\\circ}=126 \\times 10^{-4} \\mathrm{Sm}^{2} \\mathrm{~mol}^{-1}$ $\\Delta_{\\mathrm{Ba}}^{\\circ}{ }^{2+}+\\Delta{ }_{2 \\mathrm{Cl}^{-}}^{\\circ}=280 \\times 10^{-4} \\mathrm{Sm}^{2} \\mathrm{~mol}^{-1}$ $\\mathrm{NoW}$, $\\Delta_{\\mathrm{Ba}(\\mathrm{OH})_{2}}^{\\circ}=\\Delta_{\\mathrm{BaCl}_{2}}^{\\circ}+2 \\Delta{ }^{\\circ}{ }_{\\mathrm{NaOH}}^{\\circ}-2 \\Delta{ }_{\\mathrm{NaC} 1}^{\\circ}$ $\\Delta{ }_{\\mathrm{Ba}(\\mathrm{OH})_{2}}^{\\circ}=280 \\times 10^{-4}+2 \\times 248 \\times 10^{-4}-2 \\times 126 \\times 10^{-4}$ $\\Delta_{\\mathrm{Ba}(\\mathrm{OH})_{2}}^{\\circ}=524 \\times 10^{-4} \\mathrm{Sm}^{2} \\mathrm{~mol}^{-1}$"
  }
