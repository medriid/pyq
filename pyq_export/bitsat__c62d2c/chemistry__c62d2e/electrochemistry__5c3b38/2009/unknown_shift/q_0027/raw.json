  "question": {
    "text": "The conductivity of a saturated solution of $\\mathrm{BaSO}_{4}$ is $3.06 \\times 10^{-6} \\mathrm{ohm}^{-1} \\mathrm{~cm}^{-1}$ and its equivalent conductance is $1.53 \\mathrm{ohm}^{-1} \\mathrm{~cm}^{2}$ equiv $^{-1}$. The $\\mathrm{K}_{\\mathrm{sp}}$ for $\\mathrm{BaSO}_{4}$ will be",
    "image": null
  },
  "options": [
    {
      "id": "WQdlH",
      "text": "$4 \\times 10^{-12}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lDHXc",
      "text": "$2.5 \\times 10^{-9}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TrBvH",
      "text": "$2.5 \\times 10^{-13}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Jjvos",
      "text": "$4 \\times 10^{-6}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Solublity $=\\frac{\\text { conductivity } \\times 1000}{\\Lambda_{\\text {eq }}}$\n$$\n\\begin{array}{l}\n=\\frac{3.06 \\times 10^{-6} \\times 1000}{1.53}=2 \\times 10^{-3} \\\\\nK_{\\text {sp }}=\\mathrm{S}^{2}=4 \\times 10^{-6}\n\\end{array}\n$$",
    "image": null
  },
