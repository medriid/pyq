  "question": {
    "text": "How much ethyl alcohol must be added to 1 litre of water so that the solution will freeze at $14^{\\circ} \\mathrm{C}$ ?<br />$\\left(\\mathrm{K}_{\\mathrm{f}}\\right.$ for water $\\left.=1.86^{\\circ} \\mathrm{C} / \\mathrm{mol}\\right)$",
    "image": null
  },
  "options": [
