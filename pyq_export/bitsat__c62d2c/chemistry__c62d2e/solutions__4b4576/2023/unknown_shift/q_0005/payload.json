  "question": {
    "text": "How much ethyl alcohol must be added to 1 litre of water so that the solution will freeze at $14^{\\circ} \\mathrm{C}$ ?<br />$\\left(\\mathrm{K}_{\\mathrm{f}}\\right.$ for water $\\left.=1.86^{\\circ} \\mathrm{C} / \\mathrm{mol}\\right)$"
  },
  "options": [
    {
      "text": "$7.5 \\mathrm{~mol}$",
      "is_correct": true
    },
    {
      "text": "$8.5 \\mathrm{~mol}$",
      "is_correct": false
    },
    {
      "text": "$9.5 \\mathrm{~mol}$",
      "is_correct": false
    },
    {
      "text": "$10.5 \\mathrm{~mol}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$7.5 \\mathrm{~mol}$<br />$\\Delta T_f=K_f m$<br />$\\Delta T_f=K_f \\frac{n_2 \\times 1000}{w_1}$<br />$\\Rightarrow 14=1.86 \\times \\frac{n_2 \\times 1000}{1000}$<br />$n_2=7.5 \\mathrm{~mol}$"
  }
}