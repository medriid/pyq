  "question": {
    "text": "$1.00 \\mathrm{~g}$ of a non-electrolyte solute (molar mass $\\left.250 \\mathrm{~g} \\mathrm{~mol}^{-1}\\right)$ was dissolved in $51.2 \\mathrm{~g}$ of benzene. If the freezing point depression constant, $\\mathrm{K}_{\\mathrm{f}}$ of benzene is $5.12 \\mathrm{~K} \\mathrm{~kg} \\mathrm{~mol}^{-1}$, the freezing point of benzene will be lowered by"
  },
  "options": [
    {
      "text": "$0.3 \\mathrm{~K}$",
      "is_correct": false
    },
    {
      "text": "$0.5 \\mathrm{~K}$",
      "is_correct": false
    },
    {
      "text": "$0.4 \\mathrm{~K}$",
      "is_correct": true
    },
    {
      "text": "0.2",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\Delta \\mathrm{T}_{\\mathrm{f}}=\\mathrm{K}_{\\mathrm{f}} \\mathrm{m}=5.12 \\times \\frac{1}{250} \\times \\frac{1000}{51.2}=0.4 \\mathrm{~K}$"
  }
}