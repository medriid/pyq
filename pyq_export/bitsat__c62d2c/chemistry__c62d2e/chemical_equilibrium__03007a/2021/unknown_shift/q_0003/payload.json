  "question": {
    "text": "$\\mathrm{PCl}_{5}$ is dissociating $50 \\%$ at $250^{\\circ} \\mathrm{C}$ at a total pressure of $\\mathrm{P}$ atm. If equilibrium constant is $\\mathrm{K}_{p}$, then which of the following relation is numerically correct -"
  },
  "options": [
    {
      "text": "$\\mathrm{K}_{p}=3 \\mathrm{P}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{P}=3 \\mathrm{~K}_{p}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{P}=\\frac{2 K_{\\mathrm{P}}}{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{~K}_{p}=\\frac{2 \\mathrm{P}}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "<img src=\"assets\\st0003_fedf0996cb5e.png\"><br>\r\n\r\n$\\mathrm{K}_{\\mathrm{p}}=\\frac{\\frac{\\mathrm{P}}{3} \\times \\frac{\\mathrm{P}}{3}}{\\frac{\\mathrm{P}}{3}}=\\frac{\\mathrm{P}}{3}$"
  }
}