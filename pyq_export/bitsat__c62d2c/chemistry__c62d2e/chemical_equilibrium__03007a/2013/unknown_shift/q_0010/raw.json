  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "For the reaction $\\mathrm{CO}(\\mathrm{g})+(1 / 2) \\mathrm{O}_{2}(\\mathrm{~g}) \\longrightarrow \\mathrm{CO}_{2}(\\mathrm{~g}), \\mathrm{K}_{\\mathrm{p}} / \\mathrm{K}_{\\mathrm{c}}$ is",
    "image": null
  },
  "options": [
    {
      "id": "WZsg0",
      "text": "$\\mathrm{RT}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "4UoVa",
      "text": "$(\\mathrm{RT})^{-1}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "pQsfp",
      "text": "$(\\mathrm{RT})^{-1 / 2}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "hgyzU",
      "text": "$(\\mathrm{RT})^{1 / 2}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{K}_{\\mathrm{p}}=\\mathrm{K}_{\\mathrm{c}}(\\mathrm{RT})^{\\Delta n},$\r\n\r\n$\\Delta \\mathrm{n}=1-\\left(1+\\frac{1}{2}\\right)=1-\\frac{3}{2}=-\\frac{1}{2}$\r\n\r\n$\\therefore \\frac{\\mathrm{K}_{\\mathrm{p}}}{\\mathrm{K}_{\\mathrm{c}}}=(\\mathrm{RT})^{-1 / 2}$",
    "image": null
  },
