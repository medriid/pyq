  "question": {
    "text": "The ratio $\\frac{K_{p}}{K_{c}}$ for the reaction\r\n\r\n$\\mathrm{CO}(g)+\\frac{1}{2} \\mathrm{O}_{2}(g) \\rightleftharpoons \\mathrm{CO}_{2}(g)$ is:"
  },
  "options": [
    {
      "text": "$\\frac{1}{\\sqrt{R T}}$",
      "is_correct": true
    },
    {
      "text": "$(R T)^{1 / 2}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{RT}$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$K_{P}=K_{C}(R T)^{\\Delta n_{\\text {g }}}$\r\n\r\nFor the reaction\r\n\r\n$\\mathrm{CO}(\\mathrm{g})+\\frac{1}{2} \\mathrm{O}_{2}(g) \\leftrightharpoons \\mathrm{CO}_{2}(\\mathrm{~g})$\r\n\r\n$\\Delta n_{g}=1-\\left(1+\\frac{1}{2}\\right)=-\\frac{1}{2}$\r\n\r\n$\\therefore \\quad \\mathrm{K}_{\\mathrm{P}}=\\frac{\\mathrm{K}_{\\mathrm{C}}}{\\sqrt{\\mathrm{RT}}} ; \\quad \\frac{\\mathrm{K}_{\\mathrm{P}}}{\\mathrm{K}_{\\mathrm{C}}}=\\frac{1}{\\sqrt{\\mathrm{RT}}}$"
  }
}