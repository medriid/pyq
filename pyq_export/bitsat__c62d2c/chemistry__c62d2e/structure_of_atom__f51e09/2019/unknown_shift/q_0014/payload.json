  "question": {
    "text": "In a homonuclear molecule, which of the following set of orbitals is degenerated?"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#963;</mi><mn>1</mn><mi mathvariant=\"normal\">s</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#963;</mi><mn>2</mn><mi mathvariant=\"normal\">s</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn><msub><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">x</mi></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">&#960;</mi><mn>2</mn><msub><mi mathvariant=\"normal\">p</mi><mi mathvariant=\"normal\">y</mi></msub></math>",
