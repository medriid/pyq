  "question": {
    "text": "If the radius of the $3 \\mathrm{rd}$ Bohr's orbit of hydrogen atom is $r_3$ and the radius of $4^{\\text {th }}$ Bohr's orbit is $r_4$. Then:",
    "image": null
  },
  "options": [
    {
      "id": "olra7",
      "text": "$r_4=\\frac{9}{16} r_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gppyh",
      "text": "$r_4=\\frac{16}{9} r_3$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "diWuA",
      "text": "$r_4=\\frac{3}{4} r_3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "3XuGn",
      "text": "$r_4=\\frac{4}{3} r_3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<br />$\\begin{aligned} & r=0.529 \\times \\frac{n^2}{Z} Å \\\\ & r_3=0.529 \\times \\frac{3^2}{1} \\Rightarrow r_4=0.529 \\times \\frac{4^2}{1} \\\\ & \\frac{r_4}{r_3}=\\frac{4^2}{3^2}=\\frac{16}{9} \\Rightarrow r_4=\\frac{16 r_3}{9}\\end{aligned}$",
    "image": null
  },
