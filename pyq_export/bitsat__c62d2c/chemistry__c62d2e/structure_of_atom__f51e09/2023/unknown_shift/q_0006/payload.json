  "question": {
    "text": "Observe the given boundary surface diagrams of two orbitals I and II and choose the correct option.<br /><img src=\"assets\\qt0006_60d5f9f129a8.png\"><br>"
  },
  "options": [
    {
      "text": "$\\mathrm{I}-d_{x^2-y^2}, \\mathrm{II}-d_{y z}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{I}-d_{y z}, \\mathrm{II}-d_{x^2-y^2}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{I}-d_{x z}, \\mathrm{II}-d_{z^2}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{I}-d_{x y}, \\mathrm{II}-d_{x z}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "In boundary surface diagram (1) the four lobes lie between $y$ and $z$-axis $\\left(d_{y z}\\right)$ whereas, in boundary surface diagram (2) the four lobes lie on the $x$ and $y$-axis $\\left(d_{x^2-y^2}\\right)$."
  }
