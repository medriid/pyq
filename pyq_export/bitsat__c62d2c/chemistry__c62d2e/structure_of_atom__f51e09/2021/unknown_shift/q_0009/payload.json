  "question": {
    "text": "Calculate the wavelength (in nanometer) associated with a proton moving at $1.0 \\times 10^{3} \\mathrm{~ms}^{-1}$.\r\n(Mass of proton $=1.67 \\times 10^{-27} \\mathrm{~kg}$ and $\\left.\\mathrm{h}=6.63 \\times 10^{-34} \\mathrm{Js}\\right)$"
  },
  "options": [
    {
      "text": "$0.40 \\mathrm{~nm}$",
      "is_correct": true
    },
    {
      "text": "$2.5 \\mathrm{~nm}$",
      "is_correct": false
    },
    {
      "text": "$14.0 \\mathrm{~nm}$",
      "is_correct": false
    },
    {
      "text": "$0.32 \\mathrm{~nm}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\lambda &=\\frac{h}{m v}=\\frac{6.63 \\times 10^{-34}}{1.67 \\times 10^{-27} \\times 1 \\times 10^{3}} \\\\ &=3.97 \\times 10^{-10} \\text { meter }=0.397 \\text { nanometer } \\approx 0.40 \\mathrm{~nm} \\end{aligned}$"
  }
}