  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} \\mathrm{v} &=\\frac{1}{\\mathrm{~h}} \\times \\mathrm{IE} \\times\\left[\\frac{1}{\\mathrm{n}_{1}{ }^{2}}-\\frac{1}{\\mathrm{n}_{2}{ }^{2}}\\right] \\\\ &=\\frac{2.18 \\times 10^{-18}}{6.625 \\times 10^{-34}} \\times\\left[\\frac{1}{1}-\\frac{1}{16}\\right]=3.08 \\times 10^{15} \\mathrm{~s}^{-1} \\end{aligned}$",
