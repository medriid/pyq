  "question": {
    "text": "What is the maximum wavelength line in the Lyman series of $\\mathrm{He}^{+}$ ion?"
  },
  "options": [
    {
      "text": "$3 R$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{\\mathrm{R}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{3 R}$",
      "is_correct": true
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{1}{\\lambda}=\\mathrm{RZ}^{2}\\left[\\frac{1}{\\mathrm{n}_{1}^{2}}-\\frac{1}{\\mathrm{n}_{2}^{2}}\\right]=\\mathrm{R} \\times 2^{2}\\left[\\frac{1}{\\mathrm{l}^{2}}-\\frac{1}{2^{2}}\\right]$\r\n\r\n$\\Rightarrow 3 \\mathrm{R} ; \\lambda=\\frac{1}{3 \\mathrm{R}}$"
  }
