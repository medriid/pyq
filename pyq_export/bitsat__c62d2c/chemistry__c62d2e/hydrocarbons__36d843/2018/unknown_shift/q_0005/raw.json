  "question": {
    "text": "<p>Consider the following sequence of reactions.</p><p>&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Z</mi><mover><mo>&#8594;</mo><msub><mi>PCl</mi><mn>5</mn></msub></mover><mi mathvariant=\"normal\">X</mi><mover><mo>&#8594;</mo><mrow><mi>Alc</mi><mo>.</mo><mi>KOH</mi></mrow></mover><mi mathvariant=\"normal\">Y</mi><munderover><mo>&#8594;</mo><mrow><mn>2</mn><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi><mo>/</mo><mi mathvariant=\"normal\">&#916;</mi></mrow><mrow><mi>Conc</mi><mo>.</mo><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><msub><mi>SO</mi><mn>4</mn></msub></mrow></munderover><mi mathvariant=\"normal\">Z</mi></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>&#39;</mo><mi mathvariant=\"normal\">Z</mi><mo>&#39;</mo></math>&nbsp;is</p>",
    "image": null
  },
  "options": [
    {
      "id": "c0v5S",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><msub><mi>CH</mi><mn>2</mn></msub><mi>OH</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ReQRf",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><msub><mi>CH</mi><mn>3</mn></msub><msub><mo>)</mo><mn>2</mn></msub><mi mathvariant=\"normal\">C</mi><mo>=</mo><mi mathvariant=\"normal\">O</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "irx23",
      "text": "<p><img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/48422fc8-f78d-442b-94fe-38675e3be1a7-image.png\" style=\"width: 195px; height: 90px;\" /></p>",
