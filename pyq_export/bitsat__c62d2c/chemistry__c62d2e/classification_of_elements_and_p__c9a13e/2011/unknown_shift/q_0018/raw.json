  "question": {
    "text": "The correct order of radii is",
    "image": null
  },
  "options": [
    {
      "id": "QwXm3",
      "text": "$\\quad \\mathrm{N}<\\mathrm{Be}<\\mathrm{B}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5nMdt",
      "text": "$\\mathrm{F}^{-}<\\mathrm{O}^{2-}<\\mathrm{N}^{3-}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "fd81T",
      "text": "$\\quad \\mathrm{Na}<\\mathrm{L}_{1}<\\mathrm{K}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4lrTd",
      "text": "$\\mathrm{Fe}^{3+}<\\mathrm{Fe}^{2+}<\\mathrm{Fe}^{4+}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Effective nuclear charge (i,e. Z/e ratio) decreases from $\\mathrm{F}^{-}$ to $\\mathrm{N}^{3-}$ hence the radii follows the order: $\\mathrm{F}^{-}<\\mathrm{O}^{2-}<\\mathrm{N}^{3-} . \\mathrm{Z} / \\mathrm{e}$ for\n$\\mathrm{F}^{-}=9 / 10=0.9,$ for $\\mathrm{O}^{2-}=8 / 10=.8,$ for $\\mathrm{N}^{3-}=0.7$",
    "image": null
  },
