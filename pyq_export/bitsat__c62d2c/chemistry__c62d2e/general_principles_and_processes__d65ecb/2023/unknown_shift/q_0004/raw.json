  "question": {
    "text": "The reaction that does NOT take place in a blast furnace between $900 \\mathrm{~K}$ to $1500 \\mathrm{~K}$ temperature range during extraction of iron is :",
    "image": null
  },
  "options": [
    {
      "id": "B6wMf",
      "text": "$\\mathrm{Fe}_2 \\mathrm{O}_3+\\mathrm{CO} \\rightarrow 2 \\mathrm{FeO}+\\mathrm{CO}_2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "c4nnS",
      "text": "$\\mathrm{FeO}+\\mathrm{CO} \\rightarrow \\mathrm{Fe}+\\mathrm{CO}_2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PqP27",
      "text": "$\\mathrm{C}+\\mathrm{CO}_2 \\rightarrow 2 \\mathrm{CO}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ATJU5",
      "text": "$\\mathrm{CaO}+\\mathrm{SiO}_2 \\rightarrow \\mathrm{CaSiO}_3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "At $900-1500 \\mathrm{~K}$ (higher temperature range in the blast furnace)<br />Reaction which take place are:<br />$\\mathrm{C}+\\mathrm{CO}_2 \\longrightarrow 2 \\mathrm{CO}$<br />$\\mathrm{FeO}+\\mathrm{CO} \\longrightarrow \\mathrm{Fe}+\\mathrm{CO}_2$<br />$\\mathrm{CaO}+\\mathrm{SiO}_2 \\longrightarrow \\mathrm{CaSiO}_3$ (Slag formation)<br />$\\mathrm{Fe}_2 \\mathrm{O}_3+\\mathrm{CO} \\longrightarrow 2 \\mathrm{FeO}+\\mathrm{CO}_2$ at $500-800 \\mathrm{~K}$",
    "image": null
  },
