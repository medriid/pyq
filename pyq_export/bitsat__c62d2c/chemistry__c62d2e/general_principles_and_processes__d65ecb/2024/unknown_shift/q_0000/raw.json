  "question": {
    "text": "The chemical composition of 'slag' formed during the smelting process in the extraction of copper is",
    "image": null
  },
  "options": [
    {
      "id": "rhEG7",
      "text": "$\\mathrm{Cu}_2 \\mathrm{O}+\\mathrm{FeS}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MutiU",
      "text": "$\\mathrm{FeSiO}_3$",
      "image": null,
      "isCorrect": true
    },
    {
