      "text": "$\\mathrm{CuFeS}_2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "969MA",
      "text": "$\\mathrm{Cu}_2 \\mathrm{~S}+\\mathrm{FeO}$",
      "image": null,
      "isCorrect": false
