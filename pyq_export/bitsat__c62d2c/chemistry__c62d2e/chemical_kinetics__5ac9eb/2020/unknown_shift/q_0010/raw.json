  "question": {
    "text": "A radioactive isotope having a half - life period of 3 days was received after 12 days. If $3 \\mathrm{~g}$ of the isotope is left in the container, what would be the initial mass of the isotope?",
    "image": null
  },
  "options": [
    {
      "id": "Yqb90",
      "text": "$12 \\mathrm{~g}$",
      "isCorrect": false,
      "image": null
