  "question": {
    "text": "Calculate the activation energy of a reaction, whose rate constant doubles on raising the temperature from 300 K to 600 K ."
  },
  "options": [
    {
      "text": "$3.45 \\mathrm{~kJ} / \\mathrm{mol}$",
      "is_correct": true
    },
    {
      "text": "$6.90 \\mathrm{~kJ} / \\mathrm{mol}$",
      "is_correct": false
    },
    {
      "text": "$9.68 \\mathrm{~kJ} / \\mathrm{mol}$",
      "is_correct": false
    },
    {
      "text": "$19.6 \\mathrm{~kJ} / \\mathrm{mol}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\log \\left(\\frac{k_2}{k_1}\\right)=\\frac{E_a}{2.303 R}\\left[\\frac{1}{T_1}-\\frac{1}{T_2}\\right]$\nor, $\\log \\left(\\frac{2 k}{k}\\right)=\\frac{E_a}{2.303 \\times 8.3} \\times \\frac{[600-300]}{300 \\times 600}$\n$E_a \\approx 3.45 \\mathrm{~kJ} / \\mathrm{mol}$"
  }
