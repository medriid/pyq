  "question": {
    "text": "Hydrolysis of $\\mathrm{NCl}_{3}$ gives $\\mathrm{NH}_{3}$ and $\\mathrm{X}$. Which of the following is $\\mathrm{X}$ ?"
  },
  "options": [
    {
      "text": "$\\mathrm{HClO}_{4}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{HClO}_{3}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{HOCl}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{HClO}_{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Completing the reaction, we get\r\n\r\n$\\mathrm{NCl}_{3}+3 \\mathrm{H}_{2} \\mathrm{O} \\rightarrow 3 \\underset{' \\mathrm{x}^{\\prime}}{\\mathrm{HClO}}+\\mathrm{NH}_{3}$"
  }
