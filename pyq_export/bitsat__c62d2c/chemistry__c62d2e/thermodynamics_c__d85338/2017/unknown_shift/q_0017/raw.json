  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "<p>Which of the following show an increase in entropy?</p><p>I. Boiling of water</p><p>II. Melting of ice</p><p>III. Freezing of water</p><p>IV. Formation of hydrogen gas from water</p>",
    "image": null
  },
  "options": [
