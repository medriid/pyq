      "id": "50ISa",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi mathvariant=\"normal\">I</mi><mo>)</mo></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>II</mi><mo>)</mo></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "rqfog",
      "text": "Only <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mi>III</mi><mo>)</mo></math>",
