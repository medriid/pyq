  "question": {
    "text": "At a constant volume the specific heat of a gas is 0.075 and its molecular weight is $40 .$ The gas is:",
    "image": null
  },
  "options": [
    {
      "id": "aFwZp",
      "text": "Monoatomic",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iwxOe",
      "text": "Diatomic",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Rcqah",
      "text": "Triatomic",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "jqkYJ",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & q=\\frac{c}{m} \\\\ & \\Rightarrow C_{v}=q \\times m \\\\ &=0.075 \\times 40 \\\\ &=3.0 \\mathrm{cal} \\\\ & C_{P}-C_{v}=R \\\\ & C_{P}=C_{V}+R \\\\ &=3+2=5 \\\\ & \\frac{C_{P}}{C_{V}}=\\frac{5}{3}=1.66 \\end{aligned}$\nMonoatomic gas",
    "image": null
  },
