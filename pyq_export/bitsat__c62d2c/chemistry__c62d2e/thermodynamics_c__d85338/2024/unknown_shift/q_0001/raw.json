  "question": {
    "text": "What would be the amount of heat absorbed in the cyclic process shown below?\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/XAgTcKPNrcjhEQTh7Xrkn5Jf9dM6V4C67IuH3gGXLxA.original.fullsize.png\"/><br/>",
