  "question": {
    "text": "For the dissociation reaction, $\\mathrm{H}_{2}(\\mathrm{~g}) \\rightarrow 2 \\mathrm{H}(\\mathrm{g}) \\quad \\Delta \\mathrm{H}=162 \\mathrm{Kcal}$\r\n\r\nheat of atomisation of $\\mathrm{H}$ is"
  },
  "options": [
    {
      "text": "$81 \\mathrm{Kcal}$",
      "is_correct": true
    },
    {
      "text": "$162 \\mathrm{Kcal}$",
      "is_correct": false
    },
    {
      "text": "$208 \\mathrm{Kcal}$",
      "is_correct": false
    },
    {
      "text": "$218 \\mathrm{Kcal}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\Delta \\mathrm{H}=\\Delta \\mathrm{H}_{\\text {(product) }}-\\Delta \\mathrm{H}_{\\text {(reactant) }}$\r\n\r\n$162=2 \\times \\Delta \\mathrm{H}_{\\mathrm{H}}-\\Delta \\mathrm{H}_{\\mathrm{H}_{2}}$\r\n\r\n$\\Delta \\mathrm{H}_{\\mathrm{H}}=\\frac{162}{2} \\quad\\left(\\because \\Delta \\mathrm{H}_{\\mathrm{H}_{2}}=0\\right)$\r\n\r\n$\\Delta \\mathrm{H}_{\\mathrm{H}}=81 \\mathrm{Kcal}$"
  }
}