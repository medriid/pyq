  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "For the combustion reaction at $298 \\mathrm{~K}$\r\n\r\n$2 \\mathrm{Ag}(\\mathrm{s})+1 / 2 \\mathrm{O}_{2}(\\mathrm{~g}) \\longrightarrow 2 \\mathrm{Ag}_{2} \\mathrm{O}(\\mathrm{s})$\r\n\r\nWhich of the following alternatives is correct?",
    "image": null
  },
  "options": [
    {
      "id": "qHouN",
      "text": "$\\Delta \\mathrm{H}=\\Delta \\mathrm{U}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SHrgf",
      "text": "$\\Delta \\mathrm{H}>\\Delta \\mathrm{U}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "sLO6E",
      "text": "$\\Delta \\mathrm{H}<\\Delta \\mathrm{U}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "7qeiE",
      "text": "$\\Delta \\mathrm{H}$ and $\\Delta \\mathrm{U}$ has no relation with each other",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\mathrm{H}=\\Delta \\mathrm{U}+\\Delta \\mathrm{nRT}$\r\n\r\n$\\Delta \\mathrm{n}=\\mathrm{n}_{\\mathrm{p}}-\\mathrm{n}_{\\mathrm{R}}$\r\n\r\nNow, $\\Delta \\mathrm{n}=2-\\frac{5}{2}=-\\frac{1}{2}$\r\n\r\n$\\therefore \\Delta \\mathrm{H}=\\Delta \\mathrm{U}-\\frac{1}{2} \\mathrm{RT}$\r\n\r\nThus, $\\Delta \\mathrm{U}=\\Delta \\mathrm{H}+\\frac{1}{2} \\mathrm{RT}$\r\n\r\n$\\therefore \\Delta \\mathrm{U}>\\Delta \\mathrm{H}$",
    "image": null
  },
