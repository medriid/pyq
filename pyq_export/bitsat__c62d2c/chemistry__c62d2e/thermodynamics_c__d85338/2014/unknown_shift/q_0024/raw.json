  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "If the enthalpy of vaporization of water is 186.5 $\\mathrm{kJmol}^{-1}$, the entropy if its vaporization will be:",
    "image": null
  },
  "options": [
    {
      "id": "JMPAz",
      "text": "$0.5 \\mathrm{kJK}^{-1} \\mathrm{~mol}^{-1}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "I3diY",
      "text": "$1.0 \\mathrm{kJK}^{-1} \\mathrm{~mol}^{-1}$",
      "isCorrect": false,
