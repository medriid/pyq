    },
    {
      "id": "8xYUZ",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mfenced><msub><mi>CH</mi><mn>3</mn></msub></mfenced><mn>3</mn></msub><mo>&#183;</mo><mi mathvariant=\"normal\">N</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "xeEhl",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>PhNH</mi><mn>2</mn></msub></math>",
