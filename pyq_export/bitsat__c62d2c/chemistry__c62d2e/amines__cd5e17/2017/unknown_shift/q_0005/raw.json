  "question": {
    "text": "The most reactive amine towards reactions with dil.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>HCl</mi></math> is",
    "image": null
  },
  "options": [
    {
      "id": "4UEtM",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>CH</mi><mn>3</mn></msub><mo>-</mo><msub><mi>NH</mi><mn>2</mn></msub></math>",
