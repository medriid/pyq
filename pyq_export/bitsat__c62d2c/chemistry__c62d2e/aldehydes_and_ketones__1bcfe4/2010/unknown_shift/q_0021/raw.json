  "question": {
    "text": "Which of the following will not form a yellow precipitate on heating with an alkaline solution of iodine?",
    "image": null
  },
  "options": [
    {
      "id": "MluzM",
      "text": "$\\mathrm{CH}_{3} \\mathrm{CH}(\\mathrm{OH}) \\mathrm{CH}_{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SrQhL",
      "text": "$\\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{CH}(\\mathrm{OH}) \\mathrm{CH}_{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DFSIq",
      "text": "$\\mathrm{CH}_{3} \\mathrm{OH}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Gnp3Z",
      "text": "$\\mathrm{CH}_{3} \\mathrm{CH}_{2} \\mathrm{OH}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{CH}_{3} \\mathrm{OH}$ does not have $-\\mathrm{CH}(\\mathrm{OH}) \\mathrm{CH}_{3}$ group\nhence it will not form yellow precipitate with an alkaline solution of iodine (haloform reaction).",
    "image": null
  },
