  "question": {
    "text": "Which of the following compounds is thermodynamically is the most stable?",
    "image": null
  },
  "options": [
    {
      "id": "rnXA6",
      "text": "\r\n$\\mathrm{BaCO}_3$\r\n",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Zj6UF",
      "text": "\r\n$\\mathrm{MgCO}_3$\r\n",
