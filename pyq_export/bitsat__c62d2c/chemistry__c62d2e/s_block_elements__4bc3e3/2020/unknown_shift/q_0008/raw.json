  "question": {
    "text": "$\\mathrm{BeF}_2,$ is soluble in water whereas fluorides of other alkaline earth metals are insoluble because of",
    "image": null
  },
  "options": [
    {
      "id": "bl3oF",
      "text": "ionic nature of $\\mathrm{BeF}_{2}$.",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "vdMB0",
      "text": "covalent nature of $\\mathrm{BeF}_{2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "A19vz",
      "text": "greater hydration energy of $\\mathrm{Be}^{2+}$ ion as compared to its lattice energy.",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Rzat0",
      "text": "none of these.",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{Be}^{2+}$ being small in size is heavily hydrated and heat of hydration exceeds the lattice energy. Hence $\\mathrm{BeF}_{2}$ is soluble in water.",
    "image": null
  },
