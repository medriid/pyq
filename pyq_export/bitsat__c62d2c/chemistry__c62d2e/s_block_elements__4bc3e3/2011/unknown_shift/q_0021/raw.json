  "question": {
    "text": "When a crystal of caustic soda is exposed to air, a liquid layer is deposited because :",
    "image": null
  },
  "options": [
    {
      "id": "PIM0w",
      "text": "Crystal loses water",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "gQfmr",
      "text": "Crystal absorbs moisture and $\\mathrm{CO}_{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "nzHY6",
      "text": "Crystal melts",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "zKZql",
      "text": "Crystal sublimes",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "It is hygroscopic and deliquescent and hence absorbs moisture and $\\mathrm{CO}_{2}$ to form $\\mathrm{Na}_{2} \\mathrm{CO}_{3}$\n$$\n2 \\mathrm{NaOH}+\\mathrm{CO}_{2} \\longrightarrow \\mathrm{Na}_{2} \\mathrm{CO}_{3}+\\mathrm{H}_{2} \\mathrm{O}\n$$",
    "image": null
  },
