  "question": {
    "text": "The correct order of melting points of the following salts is\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/VjsWsP5Dro-Rd0Dy6T8mgq1mZsPQQ61axmIwru6fQwc.original.fullsize.png\"/><br/>",
