  "question": {
    "text": "A gas $X$ at 1 atm is bubbled through a solution containing a mixture of $1 \\mathrm{M} \\mathrm{Y}^{-}$ and $1 \\mathrm{M} \\mathrm{Z}^{-}$ at $25^{\\circ} \\mathrm{C}$. If the reduction potential is $Z>Y>X$, then"
  },
  "options": [
    {
      "text": "$\\mathrm{Y}$ will oxidise $\\mathrm{X}$ and $\\mathrm{not} \\mathrm{Z}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{Y}$ will oxidise $Z$ and $\\mathrm{not} \\mathrm{X}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Y}$ will oxidise both $\\mathrm{X}$ and $\\mathrm{Z}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{Y}$ will reduce both $\\mathrm{X}$ and $\\mathrm{Z}$",
      "is_correct": false
    }
  ],
