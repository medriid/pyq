  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "The $d$ -electron configurations of $\\mathrm{Cr}^{2+}, \\mathrm{Mn}^{2+}, \\mathrm{Fe}^{2+}$ and $\\mathrm{Co}^{2+}$ are $d^{4}, d^{5}, d^{6}$ and $d^{7}$ respectively. Which one of the following will exhibit the lowest paramagnetic behaviour?  (Atomic no. $\\mathrm{Cr}=24, \\mathrm{Mn}=25, \\mathrm{Fe}=26, \\mathrm{Co}=27)$",
    "image": null
  },
  "options": [
    {
      "id": "rriHM",
      "text": "$\\left[\\mathrm{Co}\\left(\\mathrm{H}_{2} \\mathrm{O}\\right)_{6}\\right]^{2+}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "vSjsO",
      "text": "$\\left[\\mathrm{Cr}\\left(\\mathrm{H}_{2} \\mathrm{O}\\right)_{6}\\right]^{2+}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XRgzt",
      "text": "$\\left[\\mathrm{Mn}\\left(\\mathrm{H}_{2} \\mathrm{O}\\right)_{6}\\right]^{2+}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "49P8b",
      "text": "$\\left[\\mathrm{Fe}\\left(\\mathrm{H}_{2} \\mathrm{O}\\right)_{6}\\right]^{2+}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/vbd2kuAN3rND1Bi_t98U12zf5nOBeglEF_jqJmrl2Tk.original.fullsize.png\"><br>\r\n\r\n$\\therefore$ Since $\\mathrm{Co}^{2+}$ has lowest no. of unpaired electrons hence lowest paramagnetic behaviour is shown by $\\left[\\mathrm{Co}\\left(\\mathrm{H}_{2} \\mathrm{O}\\right)_{6}\\right]^{2+}$",
    "image": null
