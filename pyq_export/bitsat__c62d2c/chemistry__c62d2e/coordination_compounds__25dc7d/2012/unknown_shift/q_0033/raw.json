  "question": {
    "text": "Among the following the lowest degree of paramagnetism per mole of the compound at 298 $\\mathrm{K}$ will be shown by",
    "image": null
  },
  "options": [
    {
      "id": "6Mm9A",
      "text": "$\\mathrm{MnSO}_{4} \\cdot 4 \\mathrm{H}_{2} \\mathrm{O}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "AGHUk",
      "text": "$\\mathrm{CuSO}_{4} .5 \\mathrm{H}_{2} \\mathrm{O}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Pwjia",
      "text": "$\\mathrm{FeSO}_{4} \\cdot 6 \\mathrm{H}_{2} \\mathrm{O}$",
      "isCorrect": false,
      "image": null
