  "question": {
    "text": "Which of the following is the correct order for the wavelength if absorption in the visible region."
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NO</mi><mn>2</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>4</mn><mo>-</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NO</mi><mn>2</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>4</mn><mo>-</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NO</mi><mn>2</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>4</mn><mo>-</mo></mrow></msup></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NH</mi><mn>3</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><mrow><msub><mi mathvariant=\"normal\">H</mi><mn>2</mn></msub><mi mathvariant=\"normal\">O</mi></mrow></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>2</mn><mo>+</mo></mrow></msup><mo>&#60;</mo><msup><mfenced open=\"[\" close=\"]\"><mrow><mi>Ni</mi><msub><mfenced><msub><mi>NO</mi><mn>2</mn></msub></mfenced><mn>6</mn></msub></mrow></mfenced><mrow><mn>4</mn><mo>-</mo></mrow></msup></math>",
