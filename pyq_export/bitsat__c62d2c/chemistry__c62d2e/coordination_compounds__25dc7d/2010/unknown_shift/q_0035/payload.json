  "question": {
    "text": "Which of the following has square planar geometry?"
  },
  "options": [
    {
      "text": "$\\left[\\mathrm{PtCl}_{4}\\right]^{2-}$",
      "is_correct": true
    },
    {
      "text": "$\\left[\\mathrm{NiCl}_{4}\\right]^{2-}$",
      "is_correct": false
