    {
      "id": "sRJAf",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">A</mi><mn>2</mn></msub><msub><mi mathvariant=\"normal\">B</mi><mn>3</mn></msub></math>",
