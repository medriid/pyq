  "question": {
    "text": "<p>Which of the following are isoelectronic species?</p><p>I. <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi mathvariant=\"normal\">C</mi><mo>+</mo></mover><msub><mi mathvariant=\"normal\">H</mi><mn>3</mn></msub></math></p><p>II.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>NH</mi><mn>2</mn><mo>-</mo></msubsup></math></p><p>III.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>NH</mi><mn>4</mn><mo>+</mo></msubsup></math></p><p>IV.&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>NH</mi><mn>3</mn></msub></math></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>,</mo><mo>&#160;</mo><mi>II</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>III</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi><mo>,</mo><mo>&#160;</mo><mi>III</mi></math><span style=\"background-color:null;\"> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IV</mi></math></span>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>,</mo><mo>&#160;</mo><mi>II</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IV</mi></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi></math>&nbsp;and&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi></math>",
      "is_correct": false
