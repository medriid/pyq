    {
      "id": "pacwt",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">I</mi><mo>,</mo><mo>&#160;</mo><mi>II</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IV</mi></math>",
      "isCorrect": false,
