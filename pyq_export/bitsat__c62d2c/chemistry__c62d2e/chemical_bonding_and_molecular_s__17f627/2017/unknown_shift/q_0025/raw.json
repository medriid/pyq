    {
      "id": "Rsc35",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>II</mi><mo>,</mo><mo>&#160;</mo><mi>III</mi></math><span style=\"background-color:null;\"> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>IV</mi></math></span>",
      "isCorrect": true,
