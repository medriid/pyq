    },
    {
      "id": "jOmsp",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi mathvariant=\"normal\">O</mi><mn>2</mn><mrow><mn>2</mn><mo>-</mo></mrow></msubsup></math>",
      "isCorrect": false,
