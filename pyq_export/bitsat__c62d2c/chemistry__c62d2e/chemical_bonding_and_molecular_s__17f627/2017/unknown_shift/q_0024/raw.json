  "level": 1,
  "question": {
    "text": "Which of the following show maximum bond-order?&nbsp;",
    "image": null
  },
  "options": [
    {
      "id": "3wJmz",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi mathvariant=\"normal\">O</mi><mn>2</mn></msub></math>",
