    {
      "text": "$\\mathrm{HCl}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{NH}_{4}^{+}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{Cl}^{-}$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{H}_{2} \\mathrm{O}_{2}$",
