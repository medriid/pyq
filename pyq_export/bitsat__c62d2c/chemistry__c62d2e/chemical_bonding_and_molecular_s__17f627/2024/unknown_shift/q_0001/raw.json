  "question": {
    "text": "In the following species, how many species have same magnetic moment?\n(i) $\\mathrm{Cr}^{2+}$\n(ii) $\\mathrm{Mn}^{3+}$\n(iii) $\\mathrm{Ni}^{3+}$\n(iv) $\\mathrm{Sc}^{2+}$\n(v) $\\mathrm{Zn}^{2+}$\n(vi) $\\mathrm{V}^{3+}$\n(vii) $\\mathrm{Ti}^{+}$",
    "image": null
  },
  "options": [
    {
      "id": "6RZSz",
      "text": "1",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yQ9Fu",
      "text": "3",
      "image": null,
      "isCorrect": false
    },
    {
