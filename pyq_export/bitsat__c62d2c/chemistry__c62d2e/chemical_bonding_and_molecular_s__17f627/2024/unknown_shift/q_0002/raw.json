  "question": {
    "text": "The hybridisation scheme for the central atom includes a $d$-orbital contribution in",
    "image": null
  },
  "options": [
    {
      "id": "p2FAM",
      "text": "$\\mathrm{I}_3^{-}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "npOjV",
      "text": "$\\mathrm{PCl}_3$",
      "image": null,
      "isCorrect": false
    },
    {
