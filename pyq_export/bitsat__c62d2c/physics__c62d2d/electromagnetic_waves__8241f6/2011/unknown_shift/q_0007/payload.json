  "question": {
    "text": "An electromagnetic wave passes through space and its equation is given by $\\mathrm{E}=\\mathrm{E}_{0} \\sin (\\omega \\mathrm{t}-\\mathrm{kx})$\nwhere $\\mathrm{E}$ is electric field. Energy density of electromagnetic wave in space is"
  },
  "options": [
    {
      "text": "$\\frac{1}{2} \\varepsilon_{0} \\mathrm{E}_{0}^{2}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{4} \\varepsilon_{0} \\mathrm{E}_{0}^{2}$",
      "is_correct": false
    },
    {
      "text": "$\\varepsilon_{0} \\mathrm{E}_{0}^{2}$",
      "is_correct": false
    },
    {
      "text": "$2 \\varepsilon_{0} \\mathrm{E}_{0}^{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Energy density\n$$\n=\\varepsilon_{0} \\mathrm{E}_{\\mathrm{rm}}^{2}=\\varepsilon_{0}\\left(\\frac{\\mathrm{E}_{0}}{\\sqrt{2}}\\right)^{2}=\\frac{1}{2} \\varepsilon_{0} \\mathrm{E}_{0}^{2}\n$$"
  }
}