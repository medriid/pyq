  "question": {
    "text": "If $\\overrightarrow{\\mathrm{E}}$ and $\\overrightarrow{\\mathrm{K}}$ represent electric field and propagation vectors of the EM waves in vacuum, then magnetic field vector is given by: ( $\\omega$ - angular frequency) :",
    "image": null
  },
  "options": [
    {
      "id": "3ZuJi",
      "text": "$\\frac{1}{\\omega}(\\overrightarrow{\\mathrm{K}} \\times \\overrightarrow{\\mathrm{E}})$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "DvSMx",
      "text": "$\\omega(\\overrightarrow{\\mathrm{E}} \\times \\overrightarrow{\\mathrm{K}})$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wiCY8",
      "text": "$\\omega(\\overrightarrow{\\mathrm{K}} \\times \\overrightarrow{\\mathrm{E}})$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mkFzp",
      "text": "$\\overrightarrow{\\mathrm{K}} \\times \\overrightarrow{\\mathrm{E}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For an EM wave<br />$\\overrightarrow{\\mathrm{B}}=\\frac{1}{\\omega}(\\overrightarrow{\\mathrm{K}} \\times \\overrightarrow{\\mathrm{E}})$",
    "image": null
  },
