  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "An electromagnetic wave is propagating along $X$-axis. At $x=1 \\mathrm{~cm}$ and $t=18 \\mathrm{~s}$, its electric vector $|E|=8 \\mathrm{~V} / \\mathrm{m}$, then the magnitude of its magnetic vector is",
    "image": null
  },
  "options": [
    {
      "id": "eOvfz",
      "text": "\r\n$266 \\times 10^{-8}$\r\n",
      "isCorrect": true,
      "image": null
    },
    {
