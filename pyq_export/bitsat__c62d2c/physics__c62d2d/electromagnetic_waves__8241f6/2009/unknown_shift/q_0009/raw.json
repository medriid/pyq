  "question": {
    "text": "The magnetic field in a travelling electromagnetic wave has a peak value of $20 \\mathrm{nT}$. The peak value of electric field strength is",
    "image": null
  },
  "options": [
    {
      "id": "sbNoo",
      "text": "$3 \\mathrm{~V} / \\mathrm{m}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "V443v",
      "text": "$6 \\mathrm{~V} / \\mathrm{m}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "sOzOi",
      "text": "$9 \\mathrm{~V} / \\mathrm{m}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cYoDM",
      "text": "$12 \\mathrm{~V} / \\mathrm{m}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\overrightarrow{\\mathrm{E}}_{0}=\\overrightarrow{\\mathrm{B}}_{0} \\times \\overrightarrow{\\mathrm{C}}$\n$$\n\\left|\\overrightarrow{\\mathrm{E}}_{0}\\right|=\\left|\\mathrm{B}_{0}\\right| \\cdot|\\overrightarrow{\\mathrm{C}}|=20 \\times 10^{-9} \\times 3 \\times 10^{8}=6 \\mathrm{~V} / \\mathrm{m}\n$$",
    "image": null
  },
