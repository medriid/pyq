  "question": {
    "text": "The stopping potential $\\left(V_0\\right)$ versus frequency $(v)$ of a graph for photoelectric effect in a metal. From the graph, the planck's constant $(h)$ is.\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/UFPKmTwLy7iBIZh1vRP5f2ZEs3UvEx26A1Sm-ij5hc0.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "pRrsg",
      "text": "\r\n$6.60 \\times 10^{-34} \\mathrm{~J}-\\mathrm{s}$ \r\n",
      "isCorrect": true,
