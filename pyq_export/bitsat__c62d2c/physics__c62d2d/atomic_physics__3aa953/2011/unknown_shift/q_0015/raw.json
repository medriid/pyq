  "question": {
    "text": "The energies of energy levels $\\mathrm{A}, \\mathrm{B}$ and $\\mathrm{C}$ for a given atom are in the sequence $\\mathrm{E}_{\\mathrm{A}}<\\mathrm{E}_{\\mathrm{B}}<\\mathrm{E}_{\\mathrm{C}}$. If\nthe radiations of wavelengths $\\lambda_{1}, \\lambda_{2}$ and $\\lambda_{3}$ are emitted due to the atomic transitions $\\mathrm{C}$ to $\\mathrm{B}, \\mathrm{B}$ to A and $C$ to A respectively then which of the following relations is correct?",
    "image": null
  },
  "options": [
    {
      "id": "yvTfi",
      "text": "$\\lambda_{1}+\\lambda_{2}+\\lambda_{3}=0$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hEOEw",
      "text": "$\\lambda_{3}=\\lambda_{1}^{2}+\\lambda_{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WEGuR",
      "text": "$\\lambda_{3}=\\lambda_{1}+\\lambda_{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "4yxeK",
      "text": "$\\lambda_{3}=\\frac{\\lambda_{1} \\lambda_{2}}{\\lambda_{1}+\\lambda_{2}}$",
      "image": null,
      "isCorrect": true
    }
