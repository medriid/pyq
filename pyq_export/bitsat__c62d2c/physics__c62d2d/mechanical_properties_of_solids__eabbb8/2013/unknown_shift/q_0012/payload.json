  "question": {
    "text": "A cube is subjected to a uniform volume compression. If the side of the cube decreases by $2 \\%$ the bulk strain is"
  },
  "options": [
    {
      "text": "0.02",
      "is_correct": false
    },
    {
      "text": "0.03",
      "is_correct": false
    },
    {
      "text": "0.04",
      "is_correct": false
    },
    {
      "text": "0.06",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "\\(\\begin{aligned} \\frac{\\Delta a}{d} &=2 \\% \\\\ v &=a^{3} \\\\ \\frac{\\Delta v}{v} &=3 \\frac{\\Delta a}{d} \\\\ &=6 \\% \\\\ &=0.06 \\end{aligned}\\)"
  }
