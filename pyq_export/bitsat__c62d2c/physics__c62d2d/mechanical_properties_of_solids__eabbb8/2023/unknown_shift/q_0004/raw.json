  "question": {
    "text": "A $100 \\mathrm{~m}$ long wire having cross-sectional area $6.25 \\times 10^{-4} \\mathrm{~m}^2$ and Young's modulus is $10^{10}$ $\\mathrm{Nm}^{-2}$ is subjected to a load of $250 \\mathrm{~N}$, then the elongation in the wire will be :",
    "image": null
  },
  "options": [
    {
      "id": "owm4a",
      "text": "$6.25 \\times 10^{-3} \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "owPmJ",
      "text": "$4 \\times 10^{-4} \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "IpubQ",
      "text": "$6.25 \\times 10^{-6} \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SZYTQ",
      "text": "$4 \\times 10^{-3} \\mathrm{~m}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\Delta \\ell=\\frac{F \\ell}{Y A}=\\frac{250 \\times 100}{10^{10} \\times 6.25 \\times 10^{-4}}=40 \\times 10^{-4} \\mathrm{~m}$<br />$=4 \\times 10^{-3} \\mathrm{~m}$",
    "image": null
  },
