  "question": {
    "text": "An iron rod of length $2 \\mathrm{~m}$ and cross-sectional area of $50 \\mathrm{~mm}^{2}$ stretched by $0.5 \\mathrm{~mm}$, when a mass of $250 \\mathrm{~kg}$ is hung from its lower end. Young's modulus of iron rod is"
  },
  "options": [
    {
      "text": "$19.6 \\times 10^{20} \\mathrm{~N} / \\mathrm{m}^{2}$",
      "is_correct": false
    },
    {
      "text": "$19.6 \\times 10^{18} \\mathrm{~N} / \\mathrm{m}^{2}$",
      "is_correct": false
    },
    {
      "text": "$19.6 \\times 10^{10} \\mathrm{~N} / \\mathrm{m}^{2}$",
      "is_correct": true
    },
    {
      "text": "$19.6 \\times 10^{15} \\mathrm{~N} / \\mathrm{m}^{2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$Y=\\frac{\\mathrm{F} / \\mathrm{A}}{\\Delta \\ell / \\ell}=\\frac{\\frac{250 \\times 9.8}{50 \\times 10^{-6}}}{\\frac{0.5 \\times 10^{-3}}{2}}$\n$=\\frac{250 \\times 9.8}{50 \\times 10^{-6}} \\times \\frac{2}{0.5 \\times 10^{-3}} \\Rightarrow 19.6 \\times 10^{10} \\mathrm{~N} / \\mathrm{m}^{2}$"
  }
