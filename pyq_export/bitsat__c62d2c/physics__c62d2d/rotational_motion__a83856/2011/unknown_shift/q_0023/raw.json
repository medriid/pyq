  "question": {
    "text": "A constant torque of $31.4 \\mathrm{~N}-\\mathrm{m}$ is exerted on a pivoted wheel. If angular acceleration of wheel is $4 \\pi \\mathrm{rad} / \\mathrm{s}^{2},$ then the moment of inertia of the wheel is",
    "image": null
  },
  "options": [
    {
      "id": "uHbeB",
      "text": "$2.5 \\mathrm{~kg} \\mathrm{~m}^{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "ebiBM",
      "text": "$3.5 \\mathrm{~kg} \\mathrm{~m}^{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "MzC7f",
      "text": "$4.5 \\mathrm{~kg} \\mathrm{~m}^{2}$",
      "image": null,
      "isCorrect": false
    },
    {
