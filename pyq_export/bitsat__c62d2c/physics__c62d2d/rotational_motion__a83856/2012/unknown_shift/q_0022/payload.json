  "question": {
    "text": "What is the moment of inertia of a solid sphere of density $\\rho$ and radius $\\mathrm{R}$ about its diameter?"
  },
  "options": [
    {
      "text": "$\\frac{105}{176} \\mathrm{R}^{5} \\rho$",
      "is_correct": false
    },
    {
      "text": "$\\frac{105}{176} \\mathrm{R}^{2} \\rho$",
      "is_correct": false
    },
    {
      "text": "$\\frac{176}{105} \\mathrm{R}^{5} \\rho$",
      "is_correct": true
    },
    {
      "text": "$\\frac{176}{105} \\mathrm{R}^{2} \\rho$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "For solid sphere\r\n$\\begin{array}{l}\r\nI=\\frac{2}{5} M R^{2}=\\frac{2}{5}\\left(\\frac{4}{3} \\pi R^{3} \\rho\\right) R^{2} \\\\\r\n\\rho=\\frac{176}{105} R^{5} \\rho\r\n\\end{array}$"
  }
