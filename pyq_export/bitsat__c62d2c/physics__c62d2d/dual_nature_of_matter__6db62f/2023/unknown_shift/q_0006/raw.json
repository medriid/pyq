  "question": {
    "text": "Proton (p) and electron (e) will have same deBroglie wavelength when the ratio of their momentum is (assume, $m_p=1849 \\mathrm{~m}_{\\mathrm{e}}$ )",
    "image": null
  },
  "options": [
