  "question": {
    "text": "A particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>X</mi></math> of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math>&nbsp;and initial velocity <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>u</mi></math> collides with another particle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Y</mi></math> of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><mi>m</mi></mrow><mn>4</mn></mfrac></math>, which is at rest. The collision is head-on and perfectly elastic. The ratio of de-Broglie wavelengths <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#955;</mi><mi>Y</mi></msub></math>&nbsp;and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#955;</mi><mi>X</mi></msub></math> after the collision is,"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>:</mo><mn>3</mn></math>",
      "is_correct": false
    },
