  "question": {
    "text": "If the kinetic energy of a free electron doubles, it's de-Broglie wavelength changes by the factor",
    "image": null
  },
  "options": [
    {
      "id": "DAxY8",
      "text": "$2$",
      "image": null,
      "isCorrect": false
    },
    {
