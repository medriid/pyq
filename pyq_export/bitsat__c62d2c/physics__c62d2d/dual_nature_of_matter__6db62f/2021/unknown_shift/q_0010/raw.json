      "text": "$9 \\times 10^{17}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\lambda=667 \\times 10^{-9} m, \\mathrm{P}=9 \\times 10^{-3} \\mathrm{~W}$\r\n\r\n$\\mathrm{P}=\\frac{\\text { Nhc }}{\\lambda}, \\mathrm{N}=$ No. of photons emitted/sec.\r\n\r\n$\\mathrm{N}=\\frac{9 \\times 10^{-3} \\times 667 \\times 10^{-9}}{6.6 \\times 10^{-34} \\times 3 \\times 10^{8}}=3 \\times 10^{16} / \\mathrm{sec}$",
    "image": null
