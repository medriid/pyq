  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "Monochromatic light of wavelength $667 \\mathrm{~nm}$ is produced by a helium neon laser. The power emitted is $9 \\mathrm{~mW}$. The number of photons arriving per sec on the average at a target irradiated by this beam is:",
    "image": null
  },
  "options": [
    {
      "id": "Lx22k",
      "text": "$3 \\times 10^{16}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "bu4N8",
      "text": "$9 \\times 10^{15}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "OG6YY",
      "text": "$3 \\times 10^{19}$",
      "isCorrect": false,
      "image": null
    },
    {
