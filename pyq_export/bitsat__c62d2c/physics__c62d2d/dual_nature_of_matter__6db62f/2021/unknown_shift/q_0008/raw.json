  "question": {
    "text": "A plane electromagnetic wave is incident on a plane surface of area A, normally and is perfectly reflected. If energy E strikes the surface in time $t$ then force exerted on the surface is ( $c=$ speed of light)",
    "image": null
  },
  "options": [
    {
      "id": "lGEeQ",
      "text": "$\\frac{2 \\mathrm{E}}{\\mathrm{Atc}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "BbIK5",
      "text": "$\\frac{\\mathrm{E}}{2 \\mathrm{c}}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "fTLrl",
      "text": "$\\frac{2 \\mathrm{E}}{\\mathrm{ct}}$",
      "isCorrect": true,
