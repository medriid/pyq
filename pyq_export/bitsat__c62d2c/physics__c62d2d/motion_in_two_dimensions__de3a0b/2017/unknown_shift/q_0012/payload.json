  "question": {
    "text": "The horizontal range and maximum height attained by a projectile are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>H</mi></math> respectively. If a constant horizontal acceleration <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mo>=</mo><mfrac><mi>g</mi><mn>4</mn></mfrac></math> is imparted to the projectile due to wind, then its horizontal range and maximum height will be&nbsp;"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>R</mi><mo>+</mo><mi>H</mi></mrow></mfenced><mo>,</mo><mfrac><mi>H</mi><mn>2</mn></mfrac></math>",
      "is_correct": false
    },
