  "question": {
    "text": "Two projectiles $\\mathrm{A}$ and $\\mathrm{B}$ are thrown with the same speed but angles are $40^{\\circ}$ and $50^{\\circ}$ with the horizontal. Then",
    "image": null
  },
  "options": [
    {
      "id": "RTC9x",
      "text": "A will fall earlier",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "RjLHe",
      "text": "$\\mathrm{B}$ will fall earlier",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mBn51",
      "text": "both will fall at the same time",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A2Cwv",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{T}=\\frac{2 \\mathrm{u} \\sin \\theta}{\\mathrm{g}},$ lesser is the value of $\\theta$, lesser is $\\sin \\theta$ and hence lesser will be the time taken. Hence A will fall earlier.",
    "image": null
  },
