  "question": {
    "text": "A body is thrown with a velocity of 9.8 ms making an angle of $30^{\\circ}$ with the horizontal. It will hit the ground after a time"
  },
  "options": [
    {
      "text": "3.0 s",
      "is_correct": false
    },
    {
      "text": "2.0 s",
      "is_correct": false
    },
    {
      "text": "1.5 s",
      "is_correct": false
    },
    {
      "text": "1 s",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Time of flight $=\\frac{2 u \\sin \\theta}{g}$\n$=\\frac{2 \\times 9.8 \\times \\sin 30^{\\circ}}{9.8}=2 \\times \\frac{1}{2}=1 \\mathrm{sec}$"
  }
