  "question": {
    "text": "A body is thrown with a velocity of 9.8 ms making an angle of $30^{\\circ}$ with the horizontal. It will hit the ground after a time",
    "image": null
  },
  "options": [
    {
      "id": "tOAZt",
      "text": "3.0 s",
      "image": null,
      "isCorrect": false
