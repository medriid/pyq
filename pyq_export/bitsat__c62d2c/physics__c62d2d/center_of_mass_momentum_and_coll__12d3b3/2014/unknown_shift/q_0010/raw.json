  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "A rifle man, who together with his rifle has a mass of $100 \\mathrm{~kg}$, stands on a smooth surface and fires 10 shots horizontally. Each bullet has a mass $10 \\mathrm{~g}$ and a muzzle velocity of $800 \\mathrm{~ms}^{-1}$. The velocity which the rifle man attains after firing 10 shots is",
    "image": null
  },
  "options": [
    {
      "id": "U431d",
      "text": "$8 \\mathrm{~ms}^{-1}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Xvvno",
      "text": "$0.8 \\mathrm{~ms}^{-1}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "5Vgrw",
      "text": "$0.08 \\mathrm{~ms}^{-1}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "63L1D",
      "text": "$-0.8 \\mathrm{~ms}^{-1}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "According to law of conservation of momentum,\r\n\r\n$$\r\n\r\n\\begin{array}{l}\r\n\r\n100 \\mathrm{v}=-\\frac{10}{1000} \\times 10 \\times 800 \\\\\r\n\r\n\\text { i.e., } \\mathrm{v}=0.8 \\mathrm{~ms}^{-1}\r\n\r\n\\end{array}\r\n\r\n$$",
    "image": null
  },
