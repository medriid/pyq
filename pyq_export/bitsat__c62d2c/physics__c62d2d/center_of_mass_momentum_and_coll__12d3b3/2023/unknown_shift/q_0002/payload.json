  "question": {
    "text": "Two bodies are having kinetic energies in the ratio $16: 9$. If they have same linear momentum, the ratio of their masses respectively is:"
  },
  "options": [
    {
      "text": "<br />4 : 3",
      "is_correct": false
    },
    {
      "text": "<br />3 : 4",
      "is_correct": false
    },
    {
      "text": "<br />16 : 9",
      "is_correct": false
    },
    {
      "text": "<br />9 : 16",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "<br />$\\begin{aligned} & \\text { K.E. }=\\frac{\\mathrm{p}^2}{2 \\mathrm{~m}} \\\\ & \\therefore \\frac{\\mathrm{K}_1}{\\mathrm{~K}_2}=\\frac{\\mathrm{p}_1^2}{2 \\mathrm{~m}_1} \\times \\frac{2 \\mathrm{~m}_2}{\\mathrm{p}_2^2}=\\frac{\\mathrm{m}_2}{\\mathrm{~m}_1}=\\frac{16}{9} \\\\ & \\therefore \\frac{\\mathrm{m}_1}{\\mathrm{~m}_2}=\\frac{9}{16}\\end{aligned}$"
  }
}