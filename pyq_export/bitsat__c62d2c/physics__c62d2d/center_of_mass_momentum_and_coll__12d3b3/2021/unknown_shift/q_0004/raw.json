  "question": {
    "text": "Three bricks each of length $L$ and mass $M$ are arranged as shown from the wall. The distance of the centre of mass of the system from the wall is\r\n\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/qMdxJfwjUdkLzDUsPKM0YdQXmw-xVZisZyfqigQuYY8.original.fullsize.png\">",
    "image": null
  },
  "options": [
