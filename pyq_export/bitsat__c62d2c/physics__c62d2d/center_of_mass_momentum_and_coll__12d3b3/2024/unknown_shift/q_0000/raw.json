  "question": {
    "text": "A ball falling freely from a height of $4.9 \\mathrm{~m} / \\mathrm{s}$, hits a horizontal surface. If $e=\\frac{3}{4}$, then the ball will hit the surface, second time after",
    "image": null
  },
  "options": [
    {
      "id": "QqjTf",
      "text": "1.0 s",
      "image": null,
      "isCorrect": false
    },
