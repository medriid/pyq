  "level": 1,
  "question": {
    "text": "A body of mass $2 \\mathrm{~kg}$ is placed on a horizontal surface having kinetic friction 0.4 and static friction $0.5 .$ If the force applied on the body is $2.5 \\mathrm{~N},$ then the frictional force acting on the body will be $\\left[\\mathrm{g}=10 \\mathrm{~ms}^{-2}\\right]$",
    "image": null
  },
  "options": [
