      "id": "y4dM6",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow></mfrac></math>",
