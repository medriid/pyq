    },
    {
      "id": "BNxGa",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow><mn>5</mn></mfrac></math>",
      "isCorrect": false,
      "image": null
    },
