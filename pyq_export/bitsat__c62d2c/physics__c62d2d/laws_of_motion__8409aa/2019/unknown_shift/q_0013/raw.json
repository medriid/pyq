  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "<p>A maximum of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>&nbsp;force can be applied on&nbsp;a&nbsp;block, down the incline, that&nbsp;would still&nbsp;not&nbsp;move the block which is&nbsp;placed on a rough inclined plane as shown in the figure. The maximum external force up the inclined plane that does not move the block is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>12</mn><mo>&#160;</mo><mi mathvariant=\"normal\">N</mi></math>. The coefficient of static friction between the block and the plane is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced close=\"]\" open=\"[\"><mrow><mi>Take</mi><mo>&#160;</mo><mi>g</mi><mo>=</mo><mn>10</mn><mo>&#160;</mo><mi mathvariant=\"normal\">m</mi><mo>&#160;</mo><msup><mi mathvariant=\"normal\">s</mi><mrow><mo>-</mo><mn>2</mn></mrow></msup></mrow></mfenced></math></p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/3fdda621-387e-4e66-9b7d-a5659fe711f3-image.png\" style=\"width: 180px; height: 130px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "6VOup",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msqrt><mn>3</mn></msqrt><mn>5</mn></mfrac></math>",
      "isCorrect": false,
