  "question": {
    "text": "The minimum velocity (in $\\mathrm{ms}^{-1}$ ) with which a car driver must traverse a flat curve of radius $150 \\mathrm{~m}$ and coefficient of friction 0.6 to avoid skidding is"
  },
  "options": [
    {
      "text": "60",
      "is_correct": false
    },
    {
      "text": "30",
      "is_correct": true
    },
    {
      "text": "15",
      "is_correct": false
    },
    {
      "text": "25",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "The condition to avoid skidding,\r\n\r\n$$\r\n\r\n\\mathrm{v}=\\sqrt{\\mu \\mathrm{rg}}=\\sqrt{0.6 \\times 150 \\times 10}=30 \\mathrm{~m} / \\mathrm{s}\r\n\r\n$$"
  }
}