  "question": {
    "text": "Two mercury drops (each of radius $\\mathrm{r}$ ) merge to form a bigger drop. The surface energy of the bigger drop, if $\\mathrm{T}$ is the surface tension, is",
    "image": null
  },
  "options": [
    {
      "id": "3WcZ8",
      "text": "$2^{5 / 3} \\pi r^{2} T$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "qweqS",
      "text": "$4 \\pi \\mathrm{r}^{2} \\mathrm{~T}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "kk5fo",
      "text": "$2 \\pi^{2} T$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "weppL",
      "text": "$2^{8 / 3} \\pi \\mathrm{r}^{2} \\mathrm{~T}$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{4}{3} \\pi R^{3}=2 \\times \\frac{4}{3} \\pi r^{3} \\Rightarrow \\mathrm{R}=2^{1 / 3} \\mathrm{r}$\nSurface energy of bigger drop,\n$\\mathrm{E}=4 \\pi R^{2} T=4 \\times 2^{2 / 3} \\pi r^{2} T=2^{8 / 3} \\pi r^{2} T$",
    "image": null
  },
