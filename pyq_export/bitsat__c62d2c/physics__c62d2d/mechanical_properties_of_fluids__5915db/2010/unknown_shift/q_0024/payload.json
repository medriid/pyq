  "question": {
    "text": "Two circular plates of radius $5 \\mathrm{~cm}$ each, have a 0.01 mm thick water film between them. Then what will be the force required to separate these plate (S.T. of water $=73$ dyne/cm)?"
  },
  "options": [
    {
      "text": "$125 \\mathrm{~N}$",
      "is_correct": false
    },
    {
      "text": "$95 \\mathrm{~N}$",
      "is_correct": false
    },
    {
      "text": "$115 \\mathrm{~N}$",
      "is_correct": true
    },
    {
      "text": "$105 \\mathrm{~N}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\mathrm{F}=& \\frac{2 \\mathrm{AT}}{\\mathrm{d}}=\\frac{2 \\times \\pi \\times(0.05)^{2} \\times 73 \\times 10^{-3}}{0.01 \\times 10^{-3}} \\\\=& 36.5 \\pi \\approx 115 \\text { newton } \\end{aligned}$"
  }
}