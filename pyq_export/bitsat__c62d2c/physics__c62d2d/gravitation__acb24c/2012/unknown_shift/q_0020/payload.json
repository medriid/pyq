  "question": {
    "text": "If the radius of the earth were to shrink by one per cent, its mass remaining the same, the value of g on the earth's surface would"
  },
  "options": [
    {
      "text": "increase by $0.5 \\%$",
      "is_correct": false
    },
    {
      "text": "increase by $2 \\%$",
      "is_correct": true
    },
    {
      "text": "decrease by $0.5 \\%$",
      "is_correct": false
    },
    {
      "text": "decrease by $2 \\%$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\quad \\mathrm{g}=\\frac{\\mathrm{GM}}{\\mathrm{R}^{2}} \\Rightarrow \\frac{\\mathrm{dg}}{\\mathrm{g}}=-2 \\frac{\\mathrm{dR}}{\\mathrm{R}}$\r\n$\\frac{\\mathrm{dR}}{\\mathrm{R}}=-1 \\% \\Rightarrow \\frac{\\mathrm{dg}}{\\mathrm{g}}=2 \\%$"
  }
}