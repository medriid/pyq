  "question": {
    "text": "For a particle inside a uniform spherical shell, the gravitational force on the particle is",
    "image": null
  },
  "options": [
    {
      "id": "QEuNk",
      "text": "infinite",
      "image": null,
      "isCorrect": false
    },
    {
