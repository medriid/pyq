      "text": "zero",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "GFsxq",
      "text": "$\\frac{-G m_1 m_2}{r^2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LCwZQ",
      "text": "$\\frac{\\mathrm{Gm}_1 \\mathrm{~m}_2}{\\mathrm{r}^2}$",
