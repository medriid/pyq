  "question": {
    "text": "For a particle inside a uniform spherical shell, the gravitational force on the particle is"
  },
  "options": [
    {
      "text": "infinite",
      "is_correct": false
    },
    {
      "text": "zero",
      "is_correct": true
    },
    {
      "text": "$\\frac{-G m_1 m_2}{r^2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{Gm}_1 \\mathrm{~m}_2}{\\mathrm{r}^2}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Various regions of spherical shell attract the point mass inside it in various directions. These forces cancel each other completely. Therefore the gravitational force on the particle is zero."
