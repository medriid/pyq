  "question": {
    "text": "Two planets $A$ and $B$ of radii $R$ and $1.5 R$ have densities $\\rho$ and $\\rho / 2$ respectively. The ratio of acceleration due to gravity at the surface of $B$ to A is :",
    "image": null
  },
  "options": [
    {
      "id": "59452",
      "text": "$2: 3$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "oqRlE",
      "text": "$2: 1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YgyTn",
      "text": "$3: 4$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zCTmV",
      "text": "$4: 3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Acceleration due to gravity,<br />$\\mathrm{g}=\\frac{\\mathrm{GM}}{\\mathrm{R}^2}=\\frac{4}{3} \\pi \\mathrm{G} \\rho \\mathrm{R}$<br />$\\therefore \\frac{g_2}{g_1}=\\frac{\\rho_2}{\\rho_1} \\times \\frac{R_2}{R_1}=\\frac{1}{2} \\times 1.5=\\frac{3}{4}$",
    "image": null
  },
