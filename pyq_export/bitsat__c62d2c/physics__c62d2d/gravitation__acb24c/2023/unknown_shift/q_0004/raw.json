  "question": {
    "text": "If $\\mathrm{V}$ is the gravitational potential due to sphere of uniform density on it's surface, then it's value at the center of sphere will be:",
    "image": null
  },
  "options": [
    {
      "id": "mGuhy",
      "text": "$\\frac{3 V}{2}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "HhlDv",
      "text": "<br />V",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "2q9Pv",
      "text": "$\\frac{4}{3} \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HmNRu",
      "text": "$\\frac{\\mathrm{V}}{2}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Potential due to sphere<br />$\\mathrm{V}=\\frac{\\mathrm{GM}}{2 \\mathrm{R}^3}\\left(3 \\mathrm{R}^2-\\mathrm{r}^2\\right)$<br />At surface $r=R \\Rightarrow V=\\left(\\frac{G M}{R}\\right)$<br />At centre, $r=0$<br />$\\therefore \\mathrm{V}_0=\\frac{3 \\mathrm{GM}}{2 \\mathrm{R}}=\\left(\\frac{3 \\mathrm{~V}}{2}\\right)$",
    "image": null
  },
