  "question": {
    "text": "The susceptibility of a magnetism at $300 \\mathrm{~K}$ is $1.2 \\times 10^{-5}$. The temperature at which the susceptibility increases to $1.8 \\times 10^{-5}$ is"
  },
  "options": [
    {
      "text": "$150 \\mathrm{~K}$",
      "is_correct": false
    },
    {
      "text": "$200 \\mathrm{~K}$",
      "is_correct": true
    },
    {
      "text": "$250 \\mathrm{~K}$",
      "is_correct": false
    },
    {
      "text": "$20 \\mathrm{~K}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\chi=\\frac{\\mathrm{C}}{\\mathrm{T}} \\\\ & \\Rightarrow \\frac{\\chi_{1}}{\\chi_{2}}=\\frac{\\mathrm{T}_{2}}{\\mathrm{~T}_{1}} \\Rightarrow \\frac{1.2 \\times 10^{-5}}{1.8 \\times 10^{-5}}=\\frac{\\mathrm{T}_{2}}{300} \\\\ & \\Rightarrow \\mathrm{T}_{2} \\Rightarrow \\frac{12}{18} \\times 300=200 \\mathrm{~K} \\end{aligned}$"
  }
}