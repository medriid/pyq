  "question": {
    "text": "The distance travelled by a particle starting from rest and moving with an acceleration $\\frac{4}{3} \\mathrm{~ms}^{-2}$, in the third second is:",
    "image": null
  },
  "options": [
    {
      "id": "9emtN",
      "text": "6 m",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AXJRi",
      "text": "4 m",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AYBlO",
      "text": "$\\frac{10}{3} \\mathrm{~m}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "xOex8",
      "text": "$\\frac{19}{3} \\mathrm{~m}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Distance travelled in the nth second is given by\n$\\mathrm{t}_{\\mathrm{n}}=\\mathrm{u}+\\frac{\\mathrm{a}}{2}(2 \\mathrm{n}-1)$\nput $\\mathrm{u}=0, \\mathrm{a}=\\frac{4}{3} \\mathrm{~ms}^{-2}, \\mathrm{n}=3$\n$\\therefore \\quad d=0+\\frac{4}{3 \\times 2}(2 \\times 3-1)=\\frac{4}{6} \\times 5=\\frac{10}{3} m$",
    "image": null
  },
