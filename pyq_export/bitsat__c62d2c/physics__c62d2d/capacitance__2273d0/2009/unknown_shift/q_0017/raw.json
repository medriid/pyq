  "question": {
    "text": "Calculate the area of the plates of a one farad parallel plate capacitor if separation between plates is $1 \\mathrm{~mm}$ and plates are in vacuum",
    "image": null
  },
  "options": [
    {
      "id": "xOuVs",
      "text": "$18 \\times 10^{8} \\mathrm{~m}^{2}$",
      "image": null,
