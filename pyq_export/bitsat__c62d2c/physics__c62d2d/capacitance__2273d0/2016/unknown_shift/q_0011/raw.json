  "level": 1,
  "question": {
    "text": "In the figure below, what is the potential difference between the point $A$ and $B$ and between $B$ and $C$ respectively in steady state\r\n\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/05n1XZBNDOJvFz3awJy97ZmZHCfchGzAyeAunMvSmJM.original.fullsize.png\">",
    "image": null
  },
  "options": [
    {
      "id": "YcTuo",
      "text": "$\\quad V_{A B}=V_{B C}=100 \\mathrm{~V}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "EGX66",
      "text": "$\\quad V_{A B}=75 V, V_{B C}=25 V$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "JZUnK",
