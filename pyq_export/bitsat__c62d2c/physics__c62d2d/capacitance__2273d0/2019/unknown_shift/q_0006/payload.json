  "question": {
    "text": "<p>When a capacitor is fully charged as shown in the following figure, then current drawn from the cell is</p><p><img src=\"assets\\qt0006_51698b04e23d.png\" style=\"width: 230px; height: 156px;\" /></p>"
  },
