  "question": {
    "text": "Electric field in theregion is given by $\\mathrm{E}=\\left(\\frac{\\mathrm{M}}{\\mathrm{x}^{3}}\\right) \\hat{\\mathrm{i}}$, then the correct expression for the potential in the region is [assume potential at infinity is zero]"
  },
  "options": [
    {
      "text": "$\\frac{\\mathrm{M}}{2 \\mathrm{x}^{2}}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{Mx}^{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{M}}{3 \\mathrm{x}^{4}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\mathrm{M}}{\\mathrm{x}^{2}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$V=-\\int_{\\infty}^{x} E \\cdot d r=-\\int_{\\infty}^{x} \\frac{M}{x^{3}} d x=\\frac{M}{2 x^{2}}$"
  }
}