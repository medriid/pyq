  "question": {
    "text": "The electric potential $V$ is given as a function of distance $\\times($ metre $)$ by $V=\\left(5 x^{2}+10 x-4\\right)$ volt.\r\n\r\n<strong>Question:</strong> Value of electric field at $x=1 \\mathrm{~m}$ is"
  },
  "options": [
    {
      "text": "$-23 \\mathrm{~V} / \\mathrm{m}$",
      "is_correct": false
    },
    {
      "text": "$11 \\mathrm{~V} / \\mathrm{m}$",
      "is_correct": false
    },
    {
      "text": "$6 \\mathrm{~V} / \\mathrm{m}$",
      "is_correct": false
    },
    {
      "text": "$-20 \\mathrm{~V} / \\mathrm{m}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{V}=5 x^{2}+10 x-4$\r\n\r\n$\\mathrm{E}=\\frac{-\\mathrm{dV}}{\\mathrm{dx}}=-(10 x+10)$\r\n\r\nAt $x=1 m, \\mathrm{E}=-20 \\mathrm{~V} / m$"
  }
}