  "question": {
    "text": "If an electron has an initial velocity in a direction different from that of an electric field, the path of the electron is",
    "image": null
  },
  "options": [
    {
      "id": "RTD0r",
      "text": "a straight line",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "WQV36",
      "text": "a circle",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QQMd4",
      "text": "an ellipse",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "BvaoT",
      "text": "a parabola",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The path is a parabola, because initial velocity can be resolved into two rectangular components, one along $\\overrightarrow{\\mathrm{E}}$ and other $\\perp$ to $\\overrightarrow{\\mathrm{E}}$. The former decreases at a constant rate and latter is unaffected. The resultant path is therefore a parabola.",
    "image": null
  },
