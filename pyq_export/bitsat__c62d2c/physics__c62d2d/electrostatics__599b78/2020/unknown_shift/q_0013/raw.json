  "question": {
    "text": "Three charge q, Q and 4q are placed in a straight line of length $l$ at points distant $0, \\frac{1}{2}$ and $l$ respectively from one end. In order to make the net froce on q zero, the charge Q must be equal to",
    "image": null
  },
  "options": [
    {
      "id": "lmYCI",
      "text": "$-\\mathrm{q}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "XKc5L",
      "text": "$-2 q$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "otl9h",
      "text": "$\\frac{-\\mathrm{q}}{2}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "GJ39t",
      "text": "q",
      "isCorrect": false,
      "image": null
    }
