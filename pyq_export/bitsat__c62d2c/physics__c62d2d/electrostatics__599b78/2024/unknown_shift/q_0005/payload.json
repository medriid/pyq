  "question": {
    "text": "If two charges $q_1$ and $q_2$ are separated with distance ' $d$ ' and placed in a medium of dielectric constant $K$. What will be the equivalent distance between charges in air for the same electrostatic force ?"
  },
  "options": [
    {
      "text": "$d \\sqrt{K}$",
      "is_correct": true
    },
    {
      "text": "$K \\sqrt{d}$",
      "is_correct": false
    },
    {
      "text": "$1.5 d \\sqrt{K}$",
      "is_correct": false
    },
    {
      "text": "$2 d \\sqrt{K}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "As. $F$(air)=$F$(medium)\n$\\Rightarrow \\frac{1}{4 \\pi \\epsilon_0} \\frac{\\mathrm{q}_1 \\mathrm{q}_2}{\\mathrm{~d}_{\\text {air }}^2}=\\frac{1}{\\mathrm{~K}} \\frac{1}{4 \\pi \\epsilon_0} \\frac{\\mathrm{q}_1 \\mathrm{q}_2}{\\mathrm{~d}^2} \\Rightarrow \\mathrm{~d}_{\\text {air }}=\\mathrm{d} \\sqrt{\\mathrm{K}}$"
  }
}