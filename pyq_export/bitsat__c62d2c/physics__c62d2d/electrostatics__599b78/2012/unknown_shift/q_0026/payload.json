  "question": {
    "text": "The electric field intensity just sufficient to balance the earth's gravitational attraction on an electron will be: (given mass and charge of an electron respectively are $9.1 \\times 10^{-31} \\mathrm{~kg}$ and $1.6 \\times$ $\\left.10^{-19} \\mathrm{C} .\\right)$"
  },
  "options": [
    {
      "text": "$-5.6 \\times 10^{-11} \\mathrm{~N} / \\mathrm{C}$",
      "is_correct": true
    },
    {
      "text": "$-4.8 \\times 10^{-15} \\mathrm{~N} / \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$-1.6 \\times 10^{-19} \\mathrm{~N} / \\mathrm{C}$",
      "is_correct": false
    },
    {
      "text": "$-3.2 \\times 10^{-19} \\mathrm{~N} / \\mathrm{C}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$-\\mathrm{eE}=\\mathrm{mg}$\r\n$\\overrightarrow{\\mathrm{E}}=-\\frac{9.1 \\times 10^{-31} \\times 10}{1.6 \\times 10^{-19}}=-5.6 \\times 10^{-11} \\mathrm{~N} / \\mathrm{C}$"
  }
