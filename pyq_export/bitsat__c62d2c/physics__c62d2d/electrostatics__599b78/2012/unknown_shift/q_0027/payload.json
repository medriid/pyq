  "question": {
    "text": "In a region of space having a uniform electric field $\\mathrm{E}$, a hemispherical bowl of radius $\\mathrm{r}$ is placed. The electric flux $\\phi$ through the bowl is"
  },
  "options": [
    {
      "text": "$2 \\pi \\mathrm{RE}$",
      "is_correct": false
    },
    {
      "text": "$4 \\pi R^{2} E$",
      "is_correct": false
    },
    {
      "text": "$2 \\pi R^{2} E$",
      "is_correct": true
    },
    {
      "text": "$\\pi R^{2} E$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\phi=\\mathrm{E}(\\mathrm{ds}) \\cos \\theta=\\mathrm{E}\\left(2 \\pi \\mathrm{r}^{2}\\right) \\cos 0^{\\circ}=2 \\pi \\mathrm{r}^{2} \\mathrm{E}$"
  }
}