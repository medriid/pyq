  "question": {
    "text": "Three equal charges (q) are placed at corners of an equilateral triangle of side $a$. The force on any charge is"
  },
  "options": [
    {
      "text": "zero",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{3} \\frac{\\mathrm{Kq}^{2}}{\\mathrm{a}^{2}}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{\\mathrm{Kq}^{2}}{\\sqrt{3} \\mathrm{a}^{2}}$",
      "is_correct": false
    },
    {
      "text": "$3 \\sqrt{3} \\frac{\\mathrm{Kq}^{2}}{\\mathrm{a}^{2}}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\mathrm{F}_{\\text {net }}=\\sqrt{\\mathrm{F}^{2}+\\mathrm{F}^{2}+2 \\mathrm{~F}^{2} \\cos 60^{\\circ}}=\\sqrt{3} \\mathrm{~F}$"
  }
}