  "question": {
    "text": "The speed of sound in oxygen at S.T.P. will be approximately:\n(Given, $\\left.\\mathrm{R}=8.3 \\mathrm{JK}^{-1}, \\gamma=1.4\\right)$",
    "image": null
  },
  "options": [
