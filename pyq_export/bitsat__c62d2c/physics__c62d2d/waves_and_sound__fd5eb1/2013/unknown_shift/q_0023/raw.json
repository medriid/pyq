  "question": {
    "text": "Two waves of wavelengths $99 \\mathrm{~cm}$ and $100 \\mathrm{~cm}$ both travelling with velocity $396 \\mathrm{~m} / \\mathrm{s}$ are made to interfere. The number of beats produced by them per second is",
    "image": null
  },
  "options": [
