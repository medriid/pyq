  "question": {
    "text": "A whistle of frequency $1000 \\mathrm{~Hz}$ is sounded on a car travelling towards a cliff with velocity of 18 $\\mathrm{~m} \\mathrm{~s}^{-1}$ normal to the cliff. If $\\mathrm{c}=330 \\mathrm{~m} \\mathrm{~s}^{-1}$, then the apparent frequency of the echo as heard by the car driver is nearly",
    "image": null
  },
  "options": [
    {
      "id": "go6CC",
      "text": "$1115 \\mathrm{~Hz}$",
      "isCorrect": true,
      "image": null
    },
    {
