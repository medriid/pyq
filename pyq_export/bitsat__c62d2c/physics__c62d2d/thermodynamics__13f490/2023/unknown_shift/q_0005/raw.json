    },
    {
      "id": "uSBLy",
      "text": "$200 \\mathrm{~J}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Work done $=$ Area under the curve<br />$\\Rightarrow \\mathrm{W}=\\frac{1}{2} \\times(4-2) \\times(400-100)=\\frac{1}{2}(2) \\times 300$<br />$\\mathrm{W}=300 \\mathrm{~J}$",
    "image": null
