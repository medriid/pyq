  "question": {
    "text": "A thermodynamic system is taken through cyclic process. The total work done in the process is :<br /><img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/r_k-pTakueAeath94qEiCmm7MqVo46295nTfgzwVCcw.original.fullsize.png\"><br>",
    "image": null
  },
  "options": [
    {
      "id": "ES1Sb",
      "text": "$100 \\mathrm{~J}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "AkX8u",
      "text": "$300 \\mathrm{~J}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "yjcBc",
      "text": "Zero",
      "image": null,
