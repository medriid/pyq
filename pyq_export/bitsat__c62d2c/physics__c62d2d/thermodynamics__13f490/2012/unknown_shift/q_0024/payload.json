  "question": {
    "text": "For an isothermal expansion of a perfect gas, the value of $\\frac{\\Delta P}{P}$ is equal to"
  },
  "options": [
    {
      "text": "$-\\gamma^{1 / 2} \\frac{\\Delta V}{V}$",
      "is_correct": false
    },
    {
      "text": "$-\\frac{\\Delta V}{V}$",
      "is_correct": true
    },
    {
      "text": "$-\\gamma \\frac{\\Delta V}{V}$",
      "is_correct": false
    },
    {
      "text": "$-\\gamma^{2} \\frac{\\Delta V}{V}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Differentiate $P V=$ constant w.r.t $V$\r\n$\\Rightarrow P \\Delta V+V \\Delta P=0 \\quad \\Rightarrow \\frac{\\Delta P}{P}=-\\frac{\\Delta V}{V}$"
  }
}