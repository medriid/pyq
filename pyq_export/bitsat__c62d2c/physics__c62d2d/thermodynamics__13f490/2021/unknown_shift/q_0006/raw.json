  "level": 2,
  "question": {
    "text": "The compressibility of water is $4 \\times 10^{-5}$ per unit atmospheric pressure. The decrease in volume of $100 \\mathrm{~cm}^{3}$ of water under a pressure of 100 atmosphere will be",
    "image": null
  },
  "options": [
    {
      "id": "3TMLR",
      "text": "$0.4 \\mathrm{~cm}^{3}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "NedUF",
      "text": "$4 \\times 10^{-5} \\mathrm{~cm}^{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "SkROf",
      "text": "$0.025 \\mathrm{~cm}^{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "mthBb",
      "text": "$0.004 \\mathrm{~cm}^{3}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Compressibility $=\\frac{1}{\\mathrm{~B}}=\\frac{\\Delta \\mathrm{V} / \\mathrm{V}}{\\mathrm{P}}$.\r\n\r\nHere, $\\mathrm{P}=100 \\mathrm{~atm}$\r\n\r\nCompressibility $=4 \\times 10^{-5}$ and $\\mathrm{V}=100 \\mathrm{~cm}^{3}$\r\n\r\nHence, $\\Delta \\mathrm{V}=0.4 \\mathrm{~cm}^{3}$",
    "image": null
  },
