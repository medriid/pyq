  "question": {
    "text": "<p>The pressure versus temperature graph of an ideal gas is shown in the figure below. If the density of gas at point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi></math> is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>&#961;</mi><mn>0</mn></msub></math>, then the density of the gas at point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math>&nbsp;will be</p><p><img src=\"assets\\qt0010_326270573554.png\" style=\"width: 313px; height: 238px;\" /></p>"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msub><mi>&#961;</mi><mn>0</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>3</mn></mfrac><msub><mi>&#961;</mi><mn>0</mn></msub></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>3</mn><mn>2</mn></mfrac><msub><mi>&#961;</mi><mn>0</mn></msub></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><msub><mi>&#961;</mi><mn>0</mn></msub></math>",
