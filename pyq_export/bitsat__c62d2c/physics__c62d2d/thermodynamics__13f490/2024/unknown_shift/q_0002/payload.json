  "question": {
    "text": "On celcius scale the temperature of body increases by $40^{\\circ} \\mathrm{C}$. The increase in temperature on Fahrenheit scale is:"
  },
  "options": [
    {
      "text": "$70^{\\circ} \\mathrm{F}$",
      "is_correct": false
    },
    {
      "text": "$68^{\\circ} \\mathrm{F}$",
      "is_correct": false
    },
    {
      "text": "$72^{\\circ} \\mathrm{F}$",
      "is_correct": true
    },
    {
      "text": "$75^{\\circ} \\mathrm{F}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Since $\\frac{F-32}{9}=\\frac{C}{5}$\n$\\Rightarrow \\Delta \\mathrm{C}=\\frac{5}{9} \\Delta \\mathrm{~F}$\n$\\Rightarrow 40=\\frac{5}{9} \\Delta \\mathrm{~F} \\Rightarrow \\Delta \\mathrm{~F}=72^{\\circ} \\mathrm{F}$"
  }
}