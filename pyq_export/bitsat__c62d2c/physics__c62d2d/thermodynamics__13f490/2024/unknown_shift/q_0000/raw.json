  "question": {
    "text": "In the given cycle $A B C D A$, the heat required for an ideal monoatomic gas will be\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/Cis1pidkMZJI1eQWoa0vIHk3Vz8_TvySvBnwCR-HfWc.original.fullsize.png\"/><br/>",
    "image": null
