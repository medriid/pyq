      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>6</mn><mo>&#160;</mo><mi>mm</mi></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "HR7PR",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mi>mm</mi></math>",
      "isCorrect": false,
      "image": null
    },
    {
