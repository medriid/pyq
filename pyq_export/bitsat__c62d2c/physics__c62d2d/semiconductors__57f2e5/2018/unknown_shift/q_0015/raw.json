  "level": 1,
  "question": {
    "text": "At a certain temperature, the number density of charge carriers in a semiconductor is <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math>. When an electric field is applied to it, the charge carriers drift with an average speed <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math>. If the temperature of the semiconductor is raised.",
    "image": null
  },
  "options": [
    {
      "id": "OVI9a",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> will increase but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> will decrease",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "8NE5e",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> will decrease but <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> will increase",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "qSrl9",
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> will increase",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "bwqUr",
      "text": "Both <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>v</mi></math> will decrease",
      "isCorrect": false,
