  "question": {
    "text": "If the forward voltage in a semiconductor diode is changed from $0.5 \\mathrm{~V}$ to $0.7 \\mathrm{~V}$, then the forward current changes by $1.0 \\mathrm{~mA}$. The forward resistance of diode junction will be"
  },
  "options": [
    {
      "text": "$100 \\Omega$",
      "is_correct": false
    },
    {
      "text": "$120 \\Omega$",
      "is_correct": false
    },
    {
      "text": "$200 \\Omega$",
      "is_correct": true
    },
    {
      "text": "$240 \\Omega$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Forward resistance\r\n\r\n$=\\frac{\\Delta \\mathrm{V}}{\\Delta \\mathrm{I}}=\\frac{0.7-0.5}{1.0 \\times 10^{-3}}=200 \\Omega$"
  }
}