  "question": {
    "text": "<p>In the following circuit diagram, the current through the battery is</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/fcbfcbd8-29e0-45c2-9d2c-d24c806846cf-image.png\" style=\"width: 180px; height: 217px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "5Qys3",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>4</mn><mo>&#160;</mo><mi mathvariant=\"normal\">A</mi></math>",
