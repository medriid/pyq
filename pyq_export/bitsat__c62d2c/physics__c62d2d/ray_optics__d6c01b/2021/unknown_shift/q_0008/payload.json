  "question": {
    "text": "Green light of wavelength $5460 Å$ is incident on an airglass interface. If the refractive index of glass is $1.5$, the wavelength of light in glass would be $\\left(\\mathrm{c}=3 \\times 10^{8} \\mathrm{~ms}^{-1}\\right)$"
  },
  "options": [
    {
      "text": "$3640 Å$",
      "is_correct": true
    },
    {
      "text": "$5460 Å$",
      "is_correct": false
    },
    {
      "text": "$4861 Å$",
      "is_correct": false
    },
    {
      "text": "None of the above",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{a}^{\\lambda} \\mathrm{g}=\\frac{\\lambda_{\\mathrm{a}}}{\\mu}=\\frac{5460}{1.5}=3640 Å$"
  }
}