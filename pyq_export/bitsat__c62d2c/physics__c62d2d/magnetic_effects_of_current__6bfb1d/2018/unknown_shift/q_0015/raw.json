  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "<p>A copper rod of mass <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> slides under gravity on two smooth parallel rails <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math> distance apart and set an angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#952;</mi></math> to the horizontal. At the bottom, the rails are joined by a resistance <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> in figure. There is a uniform magnetic field <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> perpendicular&nbsp;to the plane of the rails. The terminal velocity of rod is</p><p><img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/f9f90ec0-b008-4e91-bc69-94f4537499cc-image.png\" style=\"width: 200px; height: 181px;\" /></p>",
    "image": null
  },
  "options": [
    {
      "id": "MfMLf",
      "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>g</mi><mi>R</mi><mi>tan</mi><mi>&#952;</mi></mrow><mrow><msup><mi>B</mi><mn>2</mn></msup><msup><mi>l</mi><mn>2</mn></msup></mrow></mfrac></math></p>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "fuJQC",
      "text": "<p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>g</mi><mi>R</mi><mi>cot</mi><mi>&#952;</mi></mrow><mrow><msup><mi>B</mi><mn>2</mn></msup><msup><mi>l</mi><mn>2</mn></msup></mrow></mfrac></math></p>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "5Drkk",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>g</mi><mi>R</mi><mi>sin</mi><mi>&#952;</mi></mrow><mrow><msup><mi>B</mi><mn>2</mn></msup><msup><mi>l</mi><mn>2</mn></msup></mrow></mfrac></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "1zL9l",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>g</mi><mi>R</mi><mi>cos</mi><mi>&#952;</mi></mrow><mrow><msup><mi>B</mi><mn>2</mn></msup><msup><mi>l</mi><mn>2</mn></msup></mrow></mfrac></math>",
