  },
  "options": [
    {
      "id": "MM2CI",
      "text": "Increases by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>15</mn><mo>&#160;</mo><mo>%</mo></math>",
      "isCorrect": false,
      "image": null
    },
    {
