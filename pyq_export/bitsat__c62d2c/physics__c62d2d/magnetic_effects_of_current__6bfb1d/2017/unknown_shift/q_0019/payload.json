  "question": {
    "text": "A coil in the shape of an equilateral triangle of side <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math> is suspended between the pole pieces of a permanent magnet such that <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi></math> is in plane of the coil. If due to a current <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>i</mi></math> in the triangle, a torque <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#964;</mi></math> rests on it, the side <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>l</mi></math> of the triangle is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mfenced><mfrac><mi>&#964;</mi><mrow><msqrt><mn>3</mn></msqrt><mi>B</mi><mi>i</mi></mrow></mfrac></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><msqrt><mn>3</mn></msqrt></mfrac><mfenced><mfrac><mi>&#964;</mi><mrow><mi>B</mi><mi>i</mi></mrow></mfrac></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<span style=\"color:null;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msup><mfenced><mfrac><mi>&#964;</mi><mrow><mi>B</mi><mi>i</mi></mrow></mfrac></mfenced><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></math></span>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><msqrt><mn>3</mn></msqrt></mfrac><mfenced><mfrac><mi>&#964;</mi><mrow><mi>B</mi><mi>i</mi></mrow></mfrac></mfenced></math>",
      "is_correct": false
