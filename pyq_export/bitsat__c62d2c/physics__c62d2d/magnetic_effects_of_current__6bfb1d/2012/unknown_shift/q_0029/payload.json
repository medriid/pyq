  "question": {
    "text": "Magnetic moment of bar magnet is $\\mathrm{M}$. The work done to turn the magnet by $90^{\\circ}$ of magnet in direction of magnetic field $\\mathrm{B}$ will be"
  },
  "options": [
    {
      "text": "zero",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{2} \\mathrm{MB}$",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{MB}$",
      "is_correct": false
    },
