  "question": {
    "text": "The magnetic moments associated with two closely wound circular coils A and B of radius $r_A=10 \\mathrm{~cm}$ and $r_B=20 \\mathrm{~cm}$ respectively are equal if: (Where $\\mathrm{N}_A, \\mathrm{I}_A$ and $\\mathrm{N}_{\\mathrm{B}}, \\mathrm{I}_{\\mathrm{B}}$ are number of turn and current of $A$ and $B$ respectively)",
    "image": null
  },
  "options": [
    {
      "id": "RZefh",
      "text": "$2 \\mathrm{~N}_{\\mathrm{A}} \\mathrm{I}_{\\mathrm{A}}=\\mathrm{N}_{\\mathrm{B}} \\mathrm{I}_{\\mathrm{B}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Yy3D4",
      "text": "$\\mathrm{N}_{\\mathrm{A}}=2 \\mathrm{~N}_{\\mathrm{B}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9V32B",
      "text": "$\\mathrm{N}_{\\mathrm{A}} \\mathrm{I}_{\\mathrm{A}}=4 \\mathrm{~N}_{\\mathrm{B}} \\mathrm{I}_{\\mathrm{B}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "VYT8z",
      "text": "$4 \\mathrm{~N}_{\\mathrm{A}} \\mathrm{I}_{\\mathrm{A}}=\\mathrm{N}_{\\mathrm{B}} \\mathrm{I}_{\\mathrm{B}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The magnetic moment associated with circular coil,<br />$\\begin{aligned}<br />& M=N I A \\\\<br />& M_A=M_B \\\\<br />& \\therefore N_A I_A A_A=N_B I_B A_B \\\\<br />& \\therefore N_A I_A \\pi(0.1)^2=N_B I_B \\pi(0.2)^2\\left(\\because A=\\pi r^2\\right) \\\\<br />& \\therefore N_A I_A=4 N_B I_B<br />\\end{aligned}$",
    "image": null
  },
