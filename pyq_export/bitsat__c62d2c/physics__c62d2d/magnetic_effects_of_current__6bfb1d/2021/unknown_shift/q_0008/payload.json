  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$r=\\frac{m v \\sin \\theta}{\\mathrm{B} e}=\\frac{3 \\times 10^{5} \\sin 30^{\\circ}}{0.3 \\times 10^{8}}$\r\n\r\n$\\frac{3 \\times 10^{5} \\times \\frac{1}{2}}{3 \\times 10^{7}}=0.5 \\times 10^{-2}$\r\n\r\n$m=0.5 \\mathrm{~cm}$"
  }
