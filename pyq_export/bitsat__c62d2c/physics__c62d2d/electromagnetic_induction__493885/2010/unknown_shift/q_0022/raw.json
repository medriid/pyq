  "question": {
    "text": "The back emf induced in a coil, when current changes from 1 ampere to zero in one milli-second, is 4 volts, the self inductance of the coil is",
    "image": null
  },
  "options": [
    {
      "id": "3lCxK",
      "text": "1 henry",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "QYZz8",
      "text": "4 henry",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "48Ut0",
      "text": "$10^{-3}$ henry",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CSv1U",
      "text": "$4 \\times 10^{-3}$ henry",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{e}=-\\mathrm{L} \\frac{\\mathrm{di}}{\\mathrm{dt}}$\nBut $\\mathrm{e}=4 \\mathrm{~V}$ and $\\frac{\\mathrm{di}}{\\mathrm{dt}}=\\frac{0-1}{10^{-3}}=-1 / 10^{-3}$\n$\\therefore \\frac{-1}{10^{-3}}(-\\mathrm{L})=4 \\Rightarrow \\mathrm{L}=4 \\times 10^{-3}$ henry",
    "image": null
  },
