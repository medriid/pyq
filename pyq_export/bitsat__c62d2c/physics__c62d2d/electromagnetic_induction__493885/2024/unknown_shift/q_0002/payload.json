  "question": {
    "text": "A rectangular loop of length 2.5 m and width 2 m is placed at $60^{\\circ}$ to a magnetic field of 4 T . The loop is removed from the field in 10 sec . The average emf induced in the loop during this time is"
  },
  "options": [
    {
      "text": "$-2 \\mathrm{~V}$",
      "is_correct": false
    },
    {
      "text": "$+2 \\mathrm{~V}$",
      "is_correct": false
    },
    {
      "text": "$+1 \\mathrm{~V}$",
      "is_correct": true
    },
    {
      "text": "$-1 \\mathrm{~V}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Averageemf, $\\mathrm{e}=\\frac{\\text { Changein flux }}{\\text { Time }}=-\\frac{\\Delta \\phi}{\\Delta \\mathrm{t}}$\n$=-\\frac{0-\\left(4 \\times(2.5 \\times 2) \\cos 60^{\\circ}\\right)}{10}=+1 \\mathrm{~V}$"
  }
}