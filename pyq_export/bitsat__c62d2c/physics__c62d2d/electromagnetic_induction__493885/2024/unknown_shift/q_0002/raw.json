  "question": {
    "text": "A rectangular loop of length 2.5 m and width 2 m is placed at $60^{\\circ}$ to a magnetic field of 4 T . The loop is removed from the field in 10 sec . The average emf induced in the loop during this time is",
    "image": null
  },
  "options": [
    {
      "id": "Wj1bw",
      "text": "$-2 \\mathrm{~V}$",
      "image": null,
      "isCorrect": false
