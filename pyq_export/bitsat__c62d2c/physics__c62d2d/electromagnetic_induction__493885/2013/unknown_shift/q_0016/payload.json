  "question": {
    "text": "The ratio of secondary and primary turns of step-up transformer is $4: 1 .$ If a current of 4 A is applied to the primary, the induced current in secondary will be"
  },
  "options": [
    {
      "text": "$8 \\mathrm{~A}$",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{~A}$",
      "is_correct": false
    },
    {
      "text": "$1 \\mathrm{~A}$",
      "is_correct": true
    },
    {
      "text": "$0.5 \\mathrm{~A}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{I}_{\\mathrm{S}}}{\\mathrm{I}_{\\mathrm{P}}}=\\frac{\\mathrm{N}_{\\mathrm{P}}}{\\mathrm{N}_{\\mathrm{S}}}=\\frac{1}{4} \\Rightarrow \\mathrm{I}_{\\mathrm{S}}=\\frac{1}{4} \\times 4=1 \\mathrm{~A}$"
  }
}