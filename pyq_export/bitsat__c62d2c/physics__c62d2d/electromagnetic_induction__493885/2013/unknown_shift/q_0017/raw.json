  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} M &=\\frac{\\mu_{0} \\mathrm{~N}_{1} \\mathrm{~N}_{2} \\mathrm{~A}}{\\ell} \\\\ &=\\frac{4 \\pi \\times 10^{-7} \\times 300 \\times 400 \\times 100 \\times 10^{-4}}{0.2} \\\\ &=2.4 \\pi \\times 10^{-4} \\mathrm{H} \\end{aligned}$\r\n\r\n#",
