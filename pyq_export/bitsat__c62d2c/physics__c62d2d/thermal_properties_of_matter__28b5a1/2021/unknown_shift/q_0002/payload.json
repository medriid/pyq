  },
  "question": {
    "text": "The two ends of a rod of length $L$ and a uniform crosssectional area $A$ are kept at two temperatures $T_{1}$ and $\\mathrm{T}_{2}\\left(\\mathrm{~T}_{1}>\\mathrm{T}_{2}\\right)$. The rate of heat transfer, $\\frac{\\mathrm{dQ}}{\\mathrm{dt}}$ through the rod in a steady state is given by:"
  },
  "options": [
    {
      "text": "$\\frac{k\\left(T_{1}-T_{2}\\right)}{L A}$",
      "is_correct": false
    },
    {
      "text": "$k L A\\left(T_{1}-T_{2}\\right)$",
      "is_correct": false
    },
    {
      "text": "$\\frac{k A\\left(T_{1}-T_{2}\\right)}{L}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{k L\\left(T_{1}-T_{2}\\right)}{A}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\frac{\\mathrm{dQ}}{\\mathrm{dt}}=\\frac{\\mathrm{kA}\\left(\\mathrm{T}_{1}-\\mathrm{T}_{2}\\right)}{\\mathrm{L}}$ $\\left[\\left(\\mathrm{T}_{1}-\\mathrm{T}_{2}\\right)\\right.$ is the temperature difference $]$"
  }
}