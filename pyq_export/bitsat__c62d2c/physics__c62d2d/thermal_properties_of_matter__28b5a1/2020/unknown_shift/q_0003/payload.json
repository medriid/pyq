  "question": {
    "text": "A crystal has a coefficient of expansion $13 \\times 10^{-7}$ in one direction and $231 \\times 10^{-7}$ in every direction at right angles to it. Then the cubical coefficient of expansion is"
  },
  "options": [
    {
      "text": "$462 \\times 10^{-7}$",
      "is_correct": false
    },
    {
      "text": "$244 \\times 10^{-7}$",
      "is_correct": false
    },
    {
      "text": "$475 \\times 10^{-7}$",
      "is_correct": true
    },
    {
      "text": "$257 \\times 10^{-7}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\gamma &=\\alpha_{1}+\\alpha_{2}+\\alpha_{3} \\\\ &=13 \\times 10^{-7}+231 \\times 10^{-7}+231 \\times 10^{-7} \\\\ &=475 \\times 10^{-7} \\end{aligned}$"
  }
