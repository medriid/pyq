  "question": {
    "text": "A body of length $1 \\mathrm{~m}$ having cross-sectional area $0.75 \\mathrm{~m}^{2}$ has heat flow through it at the rate of 6000 Joule/sec. Then find the temperature difference if $\\mathrm{K}=200 \\mathrm{Jm}^{-1} \\mathrm{~K}^{-1}$",
    "image": null
  },
  "options": [
    {
      "id": "TfRc8",
      "text": "$20^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FQanM",
      "text": "$40^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "iI9uO",
      "text": "$80^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "uU3ZZ",
      "text": "$100^{\\circ} \\mathrm{C}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\frac{Q}{t}=\\frac{\\operatorname{KA} \\Delta \\theta}{\\ell} \\Rightarrow 6000=\\frac{200 \\times 0.75 \\times \\Delta \\theta}{1}$\n$\\therefore \\Delta \\theta=\\frac{6000 \\times 1}{200 \\times 0.75}=40^{\\circ} \\mathrm{C}$",
    "image": null
  },
