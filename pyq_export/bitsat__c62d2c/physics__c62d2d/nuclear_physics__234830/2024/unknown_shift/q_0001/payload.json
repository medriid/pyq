  "question": {
    "text": "The nucleus having highest binding energy per nucleon is"
  },
  "options": [
    {
      "text": "${ }_8^{16} \\mathrm{O}$",
      "is_correct": false
    },
    {
      "text": "${ }_{26}^{56} \\mathrm{Fe}$",
