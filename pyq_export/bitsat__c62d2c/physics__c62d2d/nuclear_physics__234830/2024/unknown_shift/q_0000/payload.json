  "question": {
    "text": "The atomic mass of ${ }_6 \\mathrm{C}^{12}$ is 12.000000 u and that of ${ }_6 \\mathrm{C}^{13}$ is 13.003354 u . The required energy to remove a neutron from ${ }_6 \\mathrm{C}^{13}$, if mass of neutron is 1.008665 u , will be:"
  },
  "options": [
    {
      "text": "62.5 MeV",
      "is_correct": false
    },
    {
      "text": "6.25 MeV",
      "is_correct": false
    },
    {
      "text": "4.95 MeV",
      "is_correct": true
    },
    {
      "text": "49.5 MeV",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "${ }_6 \\mathrm{C}^{13}+$ Energy $\\rightarrow{ }_6 \\mathrm{C}^{12}+{ }_0 \\mathrm{n}^1$\nMass defect, $\\Delta \\mathrm{m}=(12.000000+1.008665)-$ 13.003354\n$=-0.00531 \\mathrm{u}$\n$\\therefore$ Energyrequired $=\\Delta \\mathrm{m} \\times 931.5=0.00531 \\times 931.5$\n$\\mathrm{MeV}=4.95 \\mathrm{MeV}$"
  }
}