  "correctValue": null,
  "solution": {
    "text": "${ }_6 \\mathrm{C}^{13}+$ Energy $\\rightarrow{ }_6 \\mathrm{C}^{12}+{ }_0 \\mathrm{n}^1$\nMass defect, $\\Delta \\mathrm{m}=(12.000000+1.008665)-$ 13.003354\n$=-0.00531 \\mathrm{u}$\n$\\therefore$ Energyrequired $=\\Delta \\mathrm{m} \\times 931.5=0.00531 \\times 931.5$\n$\\mathrm{MeV}=4.95 \\mathrm{MeV}$",
    "image": null
