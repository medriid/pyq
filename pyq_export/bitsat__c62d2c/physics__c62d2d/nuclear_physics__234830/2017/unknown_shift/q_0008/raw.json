  "question": {
    "text": "The activity of a radioactive sample is measured as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>N</mi><mn>0</mn></msub></math> counts per minute at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>0</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msub><mi>N</mi><mn>0</mn></msub><mi>e</mi></mfrac></math> counts per minute at <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>t</mi><mo>=</mo><mn>5</mn><mo>&#160;</mo><mi>min</mi></math>. The time (in minutes) at which the activity reduces to half its value is",
    "image": null
  },
  "options": [
    {
      "id": "HlxKm",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>log</mi><mi>e</mi></msub><mfrac><mn>2</mn><mn>5</mn></mfrac></math>",
