  "question": {
    "text": "For a gas if ratio of specific heats at constant pressure and volume is $\\gamma$ then value of degrees of freedom is"
  },
  "options": [
    {
      "text": "$\\frac{3 \\gamma-1}{2 \\gamma-1}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2}{\\gamma-1}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{9}{2}(\\gamma-1)$",
      "is_correct": false
    },
    {
      "text": "$\\frac{25}{2}(\\gamma-1)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\begin{aligned} & \\gamma=1+\\frac{2}{f}, \\Rightarrow \\gamma-1=\\frac{2}{f} \\\\ & \\Rightarrow \\frac{f}{2}=\\frac{1}{\\gamma-1} \\Rightarrow f=\\frac{2}{\\gamma-1} \\end{aligned}$"
  }
}