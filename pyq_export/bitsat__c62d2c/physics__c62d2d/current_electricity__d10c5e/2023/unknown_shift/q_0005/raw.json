  "question": {
    "text": "Ratio of thermal energy released in two resistor $R$ and $3 R$ connected in parallel in an electric circuit is :",
    "image": null
  },
  "options": [
    {
      "id": "ZfEkf",
      "text": "<br />3 : 1",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "aWa4e",
      "text": "<br />1 : 1",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KebZi",
      "text": "<br />1 : 3",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "V3svY",
      "text": "<br />1 : 27",
      "image": null,
      "isCorrect": false
