  "question": {
    "text": "A moving coil galvanometer has resistance of $10 \\Omega$ and full scale deflection of $0.01 \\mathrm{~A}$. It can be converted into voltmeter of $10 \\mathrm{~V}$ full scale by connecting into resistance of"
  },
  "options": [
    {
      "text": "$9.90 \\Omega$ in series",
      "is_correct": false
    },
    {
      "text": "$10 \\Omega$ in series",
      "is_correct": false
    },
    {
      "text": "$990 \\Omega$ in series",
      "is_correct": true
    },
    {
      "text": "$0.10 \\Omega$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{R}=\\frac{\\mathrm{V}}{\\mathrm{I}_{\\mathrm{g}}}-\\mathrm{G}=\\frac{10}{0.01}-10=990 \\Omega$ in series."
  }
