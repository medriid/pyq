  "question": {
    "text": "If $\\mathrm{T}=2 \\pi \\sqrt{\\frac{\\mathrm{ML}^{3}}{3 \\mathrm{Yq}}}$ then find the dimensions of q. Where $\\mathrm{T}$ is the time period of bar of mass $\\mathrm{M}$ length $\\mathrm{L}$ and Young modulus $\\mathrm{Y}$.",
    "image": null
  },
  "options": [
    {
      "id": "OvsmR",
      "text": "$[\\mathrm{L}]$",
      "image": null,
      "isCorrect": false
    },
