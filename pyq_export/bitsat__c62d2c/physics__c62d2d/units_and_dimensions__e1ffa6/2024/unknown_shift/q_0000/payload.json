  "question": {
    "text": "The dimensional formula of latent heat is:"
  },
  "options": [
    {
      "text": "$\\left[\\mathrm{M}^0 \\mathrm{LT}^{-2}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\mathrm{MLT}^{-2}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\mathrm{M}^0 \\mathrm{~L}^2 \\mathrm{~T}^{-2}\\right]$",
      "is_correct": true
    },
    {
      "text": "$\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2}\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Heat, $\\mathrm{Q}=\\mathrm{mL} \\quad$ where, $\\mathrm{L}=$ latent heat\n$\\therefore \\mathrm{L}=\\frac{\\mathrm{Q}}{\\mathrm{m}}=\\frac{\\mathrm{ML}^2 \\mathrm{~T}^{-2}}{\\mathrm{M}}=\\mathrm{M}^0 \\mathrm{~L}^2 \\mathrm{~T}^{-2}$"
  }
}