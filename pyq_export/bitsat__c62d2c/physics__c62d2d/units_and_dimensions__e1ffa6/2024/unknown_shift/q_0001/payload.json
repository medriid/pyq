  "question": {
    "text": "The dimensions of coefficient of self inductance are"
  },
  "options": [
    {
      "text": "$\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2} \\mathrm{~A}^{-2}\\right]$",
      "is_correct": true
    },
    {
      "text": "$\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2} \\mathrm{~A}^{-1}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\mathrm{MLT}^{-2} \\mathrm{~A}^{-2}\\right]$",
      "is_correct": false
    },
    {
      "text": "$\\left[\\mathrm{MLT}^{-2} \\mathrm{~A}^{-1}\\right]$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Energy stored in an inductor, $\\mathrm{U}=\\frac{1}{2} \\mathrm{LI}^2$\n$\\Rightarrow \\quad \\mathrm{L}=\\frac{2 \\mathrm{U}}{\\mathrm{I}^2}$\n$[\\mathrm{L}]=\\frac{\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2}\\right]}{[\\mathrm{A}]^2}=\\left[\\mathrm{ML}^2 \\mathrm{~T}^{-2} \\mathrm{~A}^{-2}\\right]$"
  }
