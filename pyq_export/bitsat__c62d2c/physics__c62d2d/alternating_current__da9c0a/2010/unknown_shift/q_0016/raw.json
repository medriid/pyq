    {
      "id": "p6K8L",
      "text": "80,120,60 volt",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{V}_{\\mathrm{R}}=\\mathrm{i} \\mathrm{R}=5 \\times 16=80 \\mathrm{Volt}$\n$$\n\\begin{array}{l}\n\\mathrm{V}_{\\mathrm{L}}=\\mathrm{i} \\times(\\omega \\mathrm{L})=5 \\times 24=120 \\mathrm{Volt} \\\\\n\\mathrm{V}_{\\mathrm{C}}=\\mathrm{i} \\times(\\mathrm{l} / \\omega \\mathrm{C})=5 \\times 12=60 \\mathrm{Volt}\n\\end{array}\n$$",
