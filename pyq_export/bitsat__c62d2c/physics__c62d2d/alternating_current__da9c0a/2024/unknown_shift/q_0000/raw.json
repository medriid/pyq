  "question": {
    "text": "Find the average value of current shown graphically from $t=0$ to $t=2 \\mathrm{~s}$.\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/iUWimKZhttquCKNCq2-3k6pbi9tKdoQFJjAziDKZ1HE.original.fullsize.png\"/><br/>",
    "image": null
  },
  "options": [
    {
      "id": "rLtz3",
      "text": "3 A",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "lNhxV",
      "text": "5 A",
      "image": null,
      "isCorrect": true
    },
    {
