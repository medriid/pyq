  "question": {
    "text": "An alternating voltage $V(t)=220 \\sin 100 \\pi t$ volt is applied to a purely resistive load of $50 \\Omega$. The time taken for the current to rise from half of the peak value to the peak value is:",
    "image": null
  },
  "options": [
    {
      "id": "1ryys",
      "text": "5 ms",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aQQhT",
      "text": "3.3 ms",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "7YJTf",
      "text": "7.2 ms",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "Dbu6P",
      "text": "2.2 ms",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Rising half to peak\n$t=T / 6$\n$\\mathrm{t}=\\frac{2 \\pi}{6 \\omega}=\\frac{\\pi}{3 \\omega}=\\frac{\\pi}{300 \\pi}=\\frac{1}{300}=3.3 \\mathrm{~ms}$\nHere $\\omega=100 \\pi \\mathrm{rad} / \\mathrm{s}$",
    "image": null
