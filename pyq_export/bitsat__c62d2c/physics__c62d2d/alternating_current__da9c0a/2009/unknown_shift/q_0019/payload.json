  "question": {
    "text": "The instantaneous current from an a.c. source is $\\mathrm{I}=6 \\sin 314 \\mathrm{t}$. What is the rms value of the current?"
  },
  "options": [
    {
      "text": "$3 \\sqrt{2} \\mathrm{amp}$",
      "is_correct": true
    },
    {
      "text": "$2 \\sqrt{2}$ amp",
      "is_correct": false
    },
    {
      "text": "$\\sqrt{2} \\mathrm{amp}$",
      "is_correct": false
    },
    {
      "text": "$2 \\mathrm{amp}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\mathrm{I}_{\\mathrm{rms}}=\\frac{\\mathrm{I}_{0}}{\\sqrt{2}}=\\frac{6}{\\sqrt{2}}=3 \\sqrt{2} \\mathrm{amp} .$"
  }
