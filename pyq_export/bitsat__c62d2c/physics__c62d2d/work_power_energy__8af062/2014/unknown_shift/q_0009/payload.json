  "question": {
    "text": "A small block of mass $\\mathrm{m}$ is kept on a rough inclined surface of inclination $\\theta$ fixed in a elevator. The elevator goes up with a uniform velocity $\\mathrm{v}$ and the block does not slide on the wedge. The work done by the force of friction on the block in time t will be:"
  },
  "options": [
    {
      "text": "zero",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{mgvt} \\cos ^{2} \\theta$",
      "is_correct": false
    },
    {
      "text": "$\\mathrm{mgvt} \\sin ^{2} \\theta$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{mgvt} \\sin 2 \\theta$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "\\(\\mathrm{W}_{\\mathrm{f}}=\\mathrm{f} \\sin \\theta \\mathrm{S}\\)\r\n\r\n\\(=(\\mathrm{mg} \\sin \\theta)(\\sin \\theta)(\\mathrm{vt})\\)\r\n\r\n\\(=\\mathrm{mg} \\sin ^{2} \\theta \\mathrm{vt}\\)"
  }
}