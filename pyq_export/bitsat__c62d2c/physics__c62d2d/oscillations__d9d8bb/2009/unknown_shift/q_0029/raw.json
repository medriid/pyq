  "question": {
    "text": "A pendulum bob carries a +ve charge $+\\mathrm{q} . \\mathrm{A}$ positive charge $+\\mathrm{q}$ is held at the point of support. Then the time period of the bob is [where, $\\mathrm{L}=$ length of pendulum, $\\mathrm{g}_{\\mathrm{eff}}=$ effective value of $\\mathrm{g}]$",
    "image": null
  },
  "options": [
    {
      "id": "rDG6U",
      "text": "greater than $2 \\pi \\sqrt{\\mathrm{L} / \\mathrm{g}_{\\text {eff }}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "DEg8m",
      "text": "less than $2 \\pi \\sqrt{\\mathrm{L} / \\mathrm{g}_{\\text {eff }}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "S3exT",
      "text": "equal to $2 \\pi \\sqrt{\\mathrm{L} / \\mathrm{g}_{\\text {eff }}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YrBRP",
      "text": "equal to $2 \\pi \\sqrt{2 \\mathrm{~L} / \\mathrm{g}_{\\text {eff }}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Effective $g^{\\prime}=g-\\frac{k q^{2}}{d^{2} m}, \\quad T \\propto \\frac{1}{\\sqrt{g_{\\text {eff }}}}$",
    "image": null
  },
