  "question": {
    "text": "A simple pendulum has time period 't'. Its time period in a lift which is moving upwards with acceleration $3 \\mathrm{~ms}^{-2}$ is",
    "image": null
  },
  "options": [
    {
      "id": "2oJdy",
      "text": "$t \\sqrt{\\frac{9.8}{12.8}}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "WotGw",
      "text": "$t \\sqrt{\\frac{12.8}{9.8}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "YJfvE",
      "text": "$\\mathrm{t} \\sqrt{\\frac{9.8}{6.8}}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "diYMy",
      "text": "$\\mathrm{t} \\sqrt{\\frac{6.8}{9.8}}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{t} \\propto \\frac{1}{\\sqrt{9.8}}, \\mathrm{t}^{\\prime} \\propto \\frac{1}{\\sqrt{12.8}}$\n$\\left(\\because \\mathrm{g}^{\\prime}=9.8+3=12.8\\right)$\n$\\therefore \\frac{\\mathrm{t}^{\\prime}}{\\mathrm{t}}=\\sqrt{\\frac{9.8}{12.8}} \\Rightarrow \\mathrm{t}^{\\prime}=\\sqrt{\\frac{9.8}{12.8}} \\mathrm{t}$",
    "image": null
  },
