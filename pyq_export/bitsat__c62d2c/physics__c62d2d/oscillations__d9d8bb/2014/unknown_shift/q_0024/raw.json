  "question": {
    "text": "Two particles $\\mathrm{P}$ and $\\mathrm{Q}$ describe S.H.M. of same amplitude a, same frequency $\\mathrm{f}$ along the same straight line. The maximum distance between the two particles is $\\mathrm{a} \\sqrt{2}$. The initial phase difference between the particle is $-$",
    "image": null
  },
  "options": [
    {
      "id": "sZdIY",
      "text": "zero",
