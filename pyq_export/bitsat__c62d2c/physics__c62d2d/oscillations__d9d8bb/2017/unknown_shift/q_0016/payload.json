    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>m</mi><mi>g</mi></mrow><mi>k</mi></mfrac><msqrt><mn>1</mn><mo>+</mo><mfrac><mrow><mn>2</mn><mi>h</mi><mi>k</mi></mrow><mrow><mi>m</mi><mi>g</mi></mrow></mfrac></msqrt></math>",
      "is_correct": true
