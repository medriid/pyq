      "isCorrect": true,
      "image": null
    },
    {
      "id": "PDJKv",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>T</mi><mo>&#8733;</mo><mfrac><mn>1</mn><mi>&#961;</mi></mfrac></math>",
      "isCorrect": false,
