  "question": {
    "text": "Given that $\\overrightarrow{\\mathrm{A}}+\\overrightarrow{\\mathrm{B}}=\\overrightarrow{\\mathrm{R}}$ and $\\mathrm{A}^{2}+\\mathrm{B}^{2}=\\mathrm{R}^{2}$. The angle between $\\overrightarrow{\\mathrm{A}}$ and $\\overrightarrow{\\mathrm{B}}$ is",
    "image": null
  },
  "options": [
    {
      "id": "KT2CN",
      "text": "0",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HktK6",
      "text": "$\\pi / 4$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "rCrtt",
      "text": "$\\pi / 2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "b6x6K",
      "text": "$\\pi$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\cos \\theta=\\frac{\\mathrm{R}^{2}-\\mathrm{A}^{2}-\\mathrm{B}^{2}}{2 \\mathrm{~A} \\mathrm{~B}}=\\frac{\\mathrm{R}^{2}-\\mathrm{R}^{2}}{2 \\mathrm{AB}}=0$\n$\\therefore \\theta=\\pi / 2$",
    "image": null
  },
