  "question": {
    "text": "The heat generated in a circuit is given by $\\mathrm{Q}=\\mathrm{I}^{2} \\mathrm{Rt},$ where I is current, $\\mathrm{R}$ is resistance and tis time. If the percentage errors in measuring I. $\\mathrm{R}$ and $\\mathrm{t}$ are $2 \\%, 1 \\%$ and $1 \\%$ respectively, then the maximum error in measuring heat will be"
  },
  "options": [
    {
      "text": "$2 \\%$",
      "is_correct": false
    },
    {
      "text": "$3 \\%$",
      "is_correct": false
    },
    {
      "text": "$4 \\%$",
      "is_correct": false
    },
    {
      "text": "$6 \\%$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\frac{\\Delta Q}{Q} \\times 100 &=\\frac{2 \\Delta I}{I} \\times 100+\\frac{\\Delta R}{R} \\times 100+\\frac{\\Delta t}{t} \\times 100 \\\\ &=2 \\times 2 \\%+1 \\%+1 \\%=6 \\% \\end{aligned}$"
  }
}