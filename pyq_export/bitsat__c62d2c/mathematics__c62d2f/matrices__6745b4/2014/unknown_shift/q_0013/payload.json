  "question": {
    "text": "If $\\left[\\begin{array}{cc}\\alpha & \\beta \\\\ \\gamma & -\\alpha\\end{array}\\right]$ is square root of identity matrix of order 2 then -"
  },
  "options": [
    {
      "text": "$1+\\alpha^{2}+\\beta \\gamma=0$",
      "is_correct": false
    },
    {
      "text": "$1+\\alpha^{2}-\\beta \\gamma=0$",
      "is_correct": false
    },
    {
      "text": "$1-\\alpha^{2}+\\beta \\gamma=0$",
      "is_correct": false
    },
    {
      "text": "$\\alpha^{2}+\\beta \\gamma=1$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\left[\\begin{array}{cc}\\alpha & \\beta \\\\ \\gamma & -\\alpha\\end{array}\\right]=\\sqrt{\\mathrm{I}_{2}}$;\r\n\r\n$\\left[\\begin{array}{lc}\\alpha & \\beta \\\\ \\gamma & -\\alpha\\end{array}\\right]\\left[\\begin{array}{cc}\\alpha & \\beta \\\\ \\gamma & -\\alpha\\end{array}\\right]=\\left[\\begin{array}{cc}1 & 0 \\\\ 0 & 1\\end{array}\\right]$\r\n\r\n$\\Rightarrow \\alpha^{2}+\\beta \\gamma=1$"
  }
