  "question": {
    "text": "The vertices of the hyperbola $9 x^2-16 y^2-36 x+96 y-252=0$ are",
    "image": null
  },
  "options": [
    {
      "id": "hSIlm",
      "text": "$(6,3),(-2,3)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "vPZh7",
      "text": "$(6,3),(-6,3)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "PvMgQ",
      "text": "$(-6,3),(-6,-3)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7RghM",
      "text": "$(2,3),(-2,3)$",
