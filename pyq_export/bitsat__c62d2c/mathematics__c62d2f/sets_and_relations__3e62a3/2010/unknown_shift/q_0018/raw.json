  "question": {
    "text": "Let \\(\\mathrm{A}=\\{x: x \\in \\mathrm{R},|x|  < 1\\}\\);\n\\(\\mathrm{B}=\\{x: x \\in \\mathrm{R},|x-1| \\geq 1\\} \\text { and } \\mathrm{A} \\cup \\mathrm{B}=\\mathrm{R}-\\mathrm{D} \\text {, }\\)\nthen the set \\(\\mathrm{D}\\) is",
    "image": null
  },
  "options": [
    {
      "id": "dmMSU",
      "text": "\\(\\{x: 1  < x \\leq 2\\}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "KGc2i",
      "text": "\\(\\{x: 1 \\leq x  < 2\\}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "WuDWJ",
      "text": "\\(\\{x: 1 \\leq x \\leq 2\\}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CFXpF",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\mathrm{A}=[x: x \\in \\mathrm{R},-1  < x < 1] \\\\\n& \\mathrm{B}=[x: x \\in \\mathrm{R}: x-1 \\leq-1 \\text { or } x-1 \\geq 1] \\\\\n&=[x: x \\in R: x \\leq 0 \\text { or } x \\geq 2] \\\\\n& \\therefore A \\cup B=R-D,\n\\end{aligned}\\)\nwhere \\(D=[x: x \\in R, 1 \\leq x < 2]\\)",
    "image": null
  },
