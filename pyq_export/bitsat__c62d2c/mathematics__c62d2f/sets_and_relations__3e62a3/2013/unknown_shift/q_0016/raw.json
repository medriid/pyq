  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & n(\\mathrm{M} \\text { alone }) \\\\ &=n(\\mathrm{M})-n(\\mathrm{M} \\cap \\mathrm{C})-n(\\mathrm{M} \\cap \\mathrm{P})+n(\\mathrm{M} \\cap \\mathrm{C} \\cap \\mathrm{P}) \\\\ &=100-28-30+18=60 \\end{aligned}$\r\n\r\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/4cmZ9HmBbcB8qSB0F-frwWesAJkLfXEnrdlHo_3SXNQ.original.fullsize.png\">",
