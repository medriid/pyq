  "question": {
    "text": "A class has 175 students. The following data shows the number of students obtaining one or more subjects. Mathematics 100 , Physics 70 , Chemistry 40; Mathematics and Physics 30 , Mathematics and Chemistry 28 , Physics and Chemistry 23; Mathematics, Physics and Chemistry $18 .$ How many students have offered Mathematics alone?"
  },
  "options": [
    {
      "text": "35",
      "is_correct": false
    },
    {
      "text": "48",
      "is_correct": false
    },
    {
      "text": "60",
      "is_correct": true
    },
    {
      "text": "22",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} & n(\\mathrm{M} \\text { alone }) \\\\ &=n(\\mathrm{M})-n(\\mathrm{M} \\cap \\mathrm{C})-n(\\mathrm{M} \\cap \\mathrm{P})+n(\\mathrm{M} \\cap \\mathrm{C} \\cap \\mathrm{P}) \\\\ &=100-28-30+18=60 \\end{aligned}$\r\n\r\n<img src=\"assets\\st0016_df38a8d0bee5.png\">"
  }
