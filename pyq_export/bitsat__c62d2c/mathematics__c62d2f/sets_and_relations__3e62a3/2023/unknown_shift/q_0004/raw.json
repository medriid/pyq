  "question": {
    "text": "If $n(\\mathrm{~A})=1000, n(\\mathrm{~B})=500$ and if $n(\\mathrm{~A} \\cap \\mathrm{B}) \\geq 1$ and $n(\\mathrm{~A} \\cup \\mathrm{B})=p$, then",
    "image": null
  },
  "options": [
    {
      "id": "7P9uj",
      "text": "$500 \\leq p \\leq 1000$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8M2zb",
      "text": "$1001 \\leq p \\leq 1498$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "yOEiz",
      "text": "$1000 \\leq p \\leq 1498$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "L6S6t",
      "text": "$1000 \\leq p \\leq 1499$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\mathrm{n}(\\mathrm{A})=1000, \\mathrm{n}(\\mathrm{B})=500, \\mathrm{n}(\\mathrm{A} \\cap \\mathrm{B}) \\geq 1$, $n(A \\cup B)=p ; n(A \\cup B)=n(A)+n(B)-n(A \\cap B)$ $\\mathrm{p}=1000+500-\\mathrm{n}(\\mathrm{A} \\cap \\mathrm{B}) \\Rightarrow 1 \\leq \\mathrm{n}(\\mathrm{A} \\cap \\mathrm{B}) \\leq 500$<br />Hence $p \\leq 1499$ and $p \\geq 1000 \\Rightarrow 1000 \\leq p \\leq 1499$",
    "image": null
  },
