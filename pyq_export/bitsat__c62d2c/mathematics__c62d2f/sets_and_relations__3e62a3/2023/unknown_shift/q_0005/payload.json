  "question": {
    "text": "A set $A$ has 3 elements and another set B has 6 elements. Then"
  },
  "options": [
    {
      "text": "$3 \\leq \\mathrm{n}(\\mathrm{A} \\cup \\mathrm{B}) \\leq 6$",
      "is_correct": false
    },
    {
      "text": "$3 \\leq \\mathrm{n}(\\mathrm{A} \\cup \\mathrm{B}) \\leq 9$",
      "is_correct": false
    },
    {
      "text": "$6 \\leq \\mathrm{n}(\\mathrm{A} \\cup \\mathrm{B}) \\leq 9$",
      "is_correct": true
    },
    {
      "text": "$0 \\leq n(A \\cup B) \\leq 9$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "We have<br />$\\min n(A \\cup B)=\\max \\{n(A), n(B)\\}=\\max \\{3,6\\}=6$<br />$\\operatorname{Max} n(A \\cup B)=n(A)+n(B)=9$<br />$\\therefore 6 \\leq n(A \\cup B) \\leq 9$"
  }
}