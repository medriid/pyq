  "question": {
    "text": "Let A and B be two sets then $(\\mathrm{A} \\cup \\mathrm{B}) \\cup\\left(\\mathrm{A}^{\\prime} \\cap \\mathrm{B}\\right)$ is equal to"
  },
  "options": [
    {
      "text": "$\\mathrm{A}^{\\prime}$",
      "is_correct": true
    },
    {
      "text": "$\\mathrm{A}$",
      "is_correct": false
    },
    {
      "text": "B'",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\text { From Venn-Euler's Diagram. }$\r\n<img src=\"assets\\st0017_4d8f2d8d6bdf.png\"><br>\r\n$\\therefore(\\mathrm{A} \\cup \\mathrm{B})^{\\prime} \\cup\\left(\\mathrm{A}^{\\prime} \\cap \\mathrm{B}\\right)=\\mathrm{A}^{\\prime}$"
  }
}