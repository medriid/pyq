  "level": 1,
  "question": {
    "text": "Two finite sets have $m$ and $n$ elements. The number of subsets of the first set is 112 more than that of the second set. The values of $m$ and $n$ respectively are,",
    "image": null
  },
  "options": [
    {
      "id": "NvYFq",
      "text": "4,7",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "cqRRw",
      "text": "7,4",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "dKyuM",
      "text": "4,4",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Kmrsx",
      "text": "7,7",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$2^{m}-2^{n}=112 \\Rightarrow 2^{n}\\left(2^{m-n}-1\\right)=16.7$\r\n\r\n$\\quad \\therefore \\quad 2^{n}\\left(2^{m-n}-1\\right)=2^{4}\\left(2^{3}-1\\right)$\r\n\r\nComparing we get $n=4$ and $m-n=3$ $\\Rightarrow n=4$ and $m=7$",
    "image": null
  },
