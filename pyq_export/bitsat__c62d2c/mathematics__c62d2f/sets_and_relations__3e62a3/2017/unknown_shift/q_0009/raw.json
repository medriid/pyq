  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mo>=</mo><mo>{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo>}</mo></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> be a relation defined by <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi><mo>=</mo><mo>{</mo><mo>(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>)</mo><mo>:</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>&#8712;</mo><mi>A</mi><mo>,</mo><mi>x</mi><mo>+</mo><mi>y</mi><mo>=</mo><mn>5</mn><mo>}</mo></math>.&nbsp;Then,&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>R</mi></math> is",
    "image": null
  },
  "options": [
    {
      "id": "58cH1",
      "text": "reflexive and symmetric but not transitive",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "JzdiR",
      "text": "an equivalence relation",
      "isCorrect": false,
      "image": null
    },
    {
