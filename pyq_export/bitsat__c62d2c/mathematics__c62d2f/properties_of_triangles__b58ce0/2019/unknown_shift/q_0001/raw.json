  "question": {
    "text": "Let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mi>C</mi></math> be an acute-angled triangle and let <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>D</mi></math> be the mid-point of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>B</mi><mi>C</mi></math>. If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>A</mi><mi>B</mi><mo>=</mo><mi>A</mi><mi>D</mi></math>, then <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>tan</mi><mi>B</mi></mrow><mrow><mi>tan</mi><mi>C</mi></mrow></mfrac></math>&nbsp;equal",
    "image": null
  },
