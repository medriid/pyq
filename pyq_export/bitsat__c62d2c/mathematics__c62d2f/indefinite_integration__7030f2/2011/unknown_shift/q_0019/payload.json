  "question": {
    "text": "Evaluate \\(\\int \\frac{x^2}{x^2-1} d x\\)"
  },
  "options": [
    {
      "text": "\\(x-\\frac{1}{2} \\log \\left(\\frac{\\mathrm{x}-1}{\\mathrm{x}+1}\\right)+\\mathrm{c}\\)",
      "is_correct": false
    },
    {
      "text": "\\(x+\\frac{1}{2} \\log \\left(\\frac{x+1}{x-1}\\right)+c\\)",
      "is_correct": false
    },
    {
      "text": "\\(x+\\frac{1}{2} \\log \\left(\\frac{\\mathrm{x}-1}{\\mathrm{x}+1}\\right)+\\mathrm{c}\\)",
      "is_correct": true
    },
