  "question": {
    "text": "If \\(\\int \\frac{2 \\cos x-\\sin x+\\lambda}{\\cos x+\\sin x-2} d x\\) \\(=A \\ln |\\cos x+\\sin x-2|+B x+C\\).\nThen the ordered triplet \\(A, B, \\lambda\\) is -"
  },
  "options": [
    {
      "text": "\\(\\left(\\frac{1}{2}, \\frac{3}{2},-1\\right)\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\left(\\frac{3}{2}, \\frac{1}{2},-1\\right)\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\left(\\frac{1}{2},-1, \\frac{3}{2}\\right)\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\left(\\frac{3}{2},-1, \\frac{1}{2}\\right)\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\frac{\\mathrm{d}}{\\mathrm{dx}}(\\mathrm{A} \\ln |\\cos \\mathrm{x}+\\sin \\mathrm{x}-2|+\\mathrm{Bx}+\\mathrm{C}) \\\\\n&= \\mathrm{A} \\frac{\\cos \\mathrm{x}-\\sin \\mathrm{x}}{\\cos \\mathrm{x}+\\sin \\mathrm{x}-2}+\\mathrm{B} \\\\\n&= \\frac{\\mathrm{A} \\cos \\mathrm{x}-\\mathrm{A} \\sin \\mathrm{x}+\\mathrm{B} \\cos \\mathrm{x}+\\mathrm{B} \\sin \\mathrm{x}-2 \\mathrm{~B}}{\\cos \\mathrm{x}+\\sin \\mathrm{x}-2} \\\\\n& \\therefore 2=\\mathrm{A}+\\mathrm{B} \\text { or }-1=-\\mathrm{A}+\\mathrm{B} ; \\lambda=-2 \\mathrm{~B} \\\\\n& \\therefore \\mathrm{A}=3 / 2, \\mathrm{~B}=1 / 2, \\lambda=-1\n\\end{aligned}\\)"
  }
