  "question": {
    "text": "$\\int \\frac{\\left(\\mathrm{x}^{2}-1\\right)}{\\left(\\mathrm{x}^{2}+1\\right) \\sqrt{\\mathrm{x}^{4}+1}} \\mathrm{dx}$ is equal to"
  },
  "options": [
    {
      "text": "$\\sec ^{-1}\\left(\\frac{x^{2}+1}{\\sqrt{2} x}\\right)+c$",
