  "question": {
    "text": "$\\int \\frac{x+3}{(x+4)^2} e^x d x$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "5LxsA",
      "text": "$e^x\\left(\\frac{1}{x+4}\\right)+C$",
