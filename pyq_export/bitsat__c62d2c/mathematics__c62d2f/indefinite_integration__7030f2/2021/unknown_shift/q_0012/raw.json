  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "If $\\int \\frac{\\sin x}{\\sin (x-\\alpha)} \\mathrm{d} \\mathrm{x}=\\mathrm{A} x+\\mathrm{B} \\log \\sin (x-\\alpha)+\\mathrm{C}$, then value of $(A, B)$ is",
    "image": null
  },
  "options": [
    {
      "id": "rjHHZ",
      "text": "$(-\\cos \\alpha, \\sin \\alpha)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "XJVHh",
      "text": "$(\\cos \\alpha, \\sin \\alpha)$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "vzs9h",
      "text": "$(-\\sin \\alpha, \\cos \\alpha)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "NccVz",
      "text": "$(\\sin \\alpha, \\cos \\alpha)$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\int \\frac{\\sin x}{\\sin (x-\\alpha)} \\mathrm{dx}=\\int \\frac{\\sin (x-\\alpha+\\alpha}{\\sin (x-\\alpha)} \\mathrm{dx}$\r\n\r\n$=\\int \\frac{\\sin (x-\\alpha) \\cos \\alpha+\\cos (x-\\alpha) \\sin \\alpha}{\\sin (x-\\alpha)} \\mathrm{d} \\mathrm{x}$\r\n\r\n$=\\int\\{\\cos \\alpha+\\sin \\alpha \\cot (x-\\alpha)\\} \\mathrm{d} \\mathrm{x}$\r\n\r\n$=(\\cos \\alpha) x+(\\sin \\alpha) \\log \\sin (x-\\alpha)+\\mathrm{C}$\r\n\r\n$\\therefore \\mathrm{A}=\\cos \\alpha, \\mathrm{B}=\\sin \\alpha$",
    "image": null
  },
