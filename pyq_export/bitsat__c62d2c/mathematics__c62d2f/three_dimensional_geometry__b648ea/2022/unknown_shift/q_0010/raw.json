  "question": {
    "text": "If the plane $3 x+y+2 z+6=0$ is parallel to the line $\\frac{3 x-1}{2 b}=3-y=\\frac{z-1}{a}$, then the value of $3 a+3 b$ is",
    "image": null
  },
  "options": [
    {
      "id": "Ea7rK",
      "text": "\r\n$\\frac{1}{2}$\r\n",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "LKuyv",
      "text": "\r\n$\\frac{3}{2}$\r\n",
      "isCorrect": true,
      "image": null
    },
    {
