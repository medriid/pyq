  "question": {
    "text": "If the line \\(\\frac{x-4}{1}=\\frac{y-2}{1}=\\frac{z-k}{2}\\) lies in the plane \\(2 x-4 y+z=7\\), then the value of \\(k\\) is"
  },
  "options": [
    {
      "text": "4",
      "is_correct": false
    },
    {
      "text": "-7",
      "is_correct": false
    },
    {
      "text": "7",
      "is_correct": true
    },
    {
      "text": "No real value",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "The point \\((4,2, k)\\) on the line also lies on the plane \\(2 x-4 y+z=7\\)\nSo, \\(8-8+\\mathrm{k}=7 \\Rightarrow \\mathrm{k}=7\\)"
  }
}