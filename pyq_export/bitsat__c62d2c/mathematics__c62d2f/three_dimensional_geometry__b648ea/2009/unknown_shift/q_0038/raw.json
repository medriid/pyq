    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The point \\((4,2, k)\\) on the line also lies on the plane \\(2 x-4 y+z=7\\)\nSo, \\(8-8+\\mathrm{k}=7 \\Rightarrow \\mathrm{k}=7\\)",
    "image": null
  },
