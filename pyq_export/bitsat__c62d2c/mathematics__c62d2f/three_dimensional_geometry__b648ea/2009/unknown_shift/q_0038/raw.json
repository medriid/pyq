  "question": {
    "text": "If the line \\(\\frac{x-4}{1}=\\frac{y-2}{1}=\\frac{z-k}{2}\\) lies in the plane \\(2 x-4 y+z=7\\), then the value of \\(k\\) is",
    "image": null
  },
  "options": [
    {
      "id": "yyYUY",
      "text": "4",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "OJ8UM",
      "text": "-7",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tPnnF",
      "text": "7",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "smyWd",
      "text": "No real value",
      "image": null,
