  "question": {
    "text": "Solution of the differential equation \\(\\frac{d y}{d x}+\\frac{y}{x}=\\sin x\\) is",
    "image": null
  },
  "options": [
    {
      "id": "LHzIH",
      "text": "\\(x(y+\\cos x)=\\cos x+C\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "0i40D",
      "text": "\\(x(y-\\cos x)=\\sin x+C\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "x41DK",
      "text": "\\(x(y+\\cos x)=\\sin x+C\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "zEq0p",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\frac{d y}{d x}+\\frac{1}{x} \\cdot y=\\sin x\\left[\\text { Type } \\frac{d y}{d x}+P y=Q\\right] \\\\\n& e^{\\int P d x}=e^{\\int \\frac{1}{x} d x}=e^{\\log x}=x\n\\end{aligned}\\)\n\\(\\therefore\\) Sol. is \\(\\mathrm{yx}=\\int \\mathrm{x} \\sin \\mathrm{xdx}+\\mathrm{C}\\)\n\\(\\begin{aligned}\n& =x(-\\cos x)-\\int 1 \\cdot(-\\cos x) d x+C \\\\\n& =-x \\cos x+\\sin x+C \\Rightarrow x(y+\\cos x)=\\sin x+C\n\\end{aligned}\\)",
    "image": null
  },
