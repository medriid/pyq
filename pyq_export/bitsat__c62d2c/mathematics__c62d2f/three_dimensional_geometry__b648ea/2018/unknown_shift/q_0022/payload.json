    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1</mn><mo>+</mo><mi>cos</mi><mn>2</mn><mi>&#945;</mi></math>",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
