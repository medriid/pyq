    },
    {
      "id": "2Ym0q",
      "text": "<span style=\"background-color:null;\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>2</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>7</mn><mo>)</mo></math></span>",
