  "question": {
    "text": "If $f(x)=\\left\\{\\begin{array}{cl}\\frac{x^{2}+3 x-10}{x^{2}+2 x-15} & \\text { , when } x \\neq-5 \\\\ \\text { a }, & \\text { when } x=-5\\end{array}\\right.$\r\n\r\nis continuous at $x=-5$, then the value of 'a' will be"
  },
  "options": [
    {
      "text": "$3 / 2$",
      "is_correct": false
    },
    {
      "text": "$7 / 8$",
      "is_correct": true
    },
    {
      "text": "$8 / 7$",
      "is_correct": false
    },
    {
      "text": "$2 / 3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\lim _{x \\rightarrow-5} f(x)=\\frac{(x-2)(x+5)}{(x+5)(x-3)}=\\frac{-7}{-8}=\\frac{7}{8}$"
  }
}