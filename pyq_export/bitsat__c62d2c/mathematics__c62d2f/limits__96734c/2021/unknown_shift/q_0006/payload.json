  "question": {
    "text": "$\\lim _{x \\rightarrow 0} \\sqrt{\\frac{x-\\sin x}{x+\\sin ^{2} x}}$ is equal to"
  },
  "options": [
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "0",
      "is_correct": true
    },
    {
      "text": "$\\infty$",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$\\lim _{x \\rightarrow 0} \\sqrt{\\frac{x-\\sin x}{x+\\sin ^{2} x}=\\lim _{x \\rightarrow 0} \\sqrt{\\frac{1-\\frac{\\sin x}{x}}{1+\\frac{\\sin ^{2} x}{x}}}}$\r\n\r\n$=\\lim _{x \\rightarrow 0} \\sqrt{\\frac{1-\\frac{\\sin x}{x}}{1+\\left(\\frac{\\sin x}{x}\\right) \\sin x}}=\\sqrt{\\frac{1-1}{1+1 \\times 0}}=0$"
  }
}