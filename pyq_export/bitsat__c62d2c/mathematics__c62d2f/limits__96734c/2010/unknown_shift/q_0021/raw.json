  "question": {
    "text": "The minimum value of \\(\\frac{x^4+y^4+z^2}{x y z}\\) for positive real number \\(x, y, z\\) is",
    "image": null
  },
  "options": [
    {
      "id": "5VGGn",
      "text": "\\(\\sqrt{2}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cfWuS",
      "text": "\\(2 \\sqrt{2}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "X76fN",
      "text": "\\(4 \\sqrt{2}\\)",
      "image": null,
      "isCorrect": false
    },
