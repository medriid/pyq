  "question": {
    "text": "The minimum value of \\(\\frac{x^4+y^4+z^2}{x y z}\\) for positive real number \\(x, y, z\\) is"
  },
  "options": [
    {
      "text": "\\(\\sqrt{2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(2 \\sqrt{2}\\)",
      "is_correct": true
    },
    {
      "text": "\\(4 \\sqrt{2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(8 \\sqrt{2}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "By A.M. \\(\\geq\\) G.M.\n\\(x^4+y^4 \\geq 2 x^2 y^2\\) and \\(2 x^2 y^2+z^2 \\geq \\sqrt{8} x y z\\).\n\\(\\Rightarrow \\frac{x^4+y^4+z^2}{x y z} \\geq \\sqrt{8}\\)"
  }
}