  "question": {
    "text": "$\\lim _{x \\rightarrow 0} \\frac{|\\sin x|}{x}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "k0SdE",
      "text": "1",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VMdXG",
      "text": "-1",
      "image": null,
      "isCorrect": false
    },
    {
