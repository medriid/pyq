  "question": {
    "text": "If the focus of parabola $(y-k)^2=4(x-h)$ always lies between the lines $x+y=1$ and $x+y$ $=3$ then"
  },
  "options": [
    {
      "text": "$0 \\lt h+k \\lt 2$",
      "is_correct": true
    },
    {
      "text": "$0 \\lt h+k \\lt 1$",
      "is_correct": false
    },
    {
      "text": "$1 \\lt h+k \\lt 2$",
      "is_correct": false
    },
    {
      "text": "$1 \\lt h+k \\lt 3$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Coordinate of focus will be $(h+1, k)$\nNow focus should lie to the opposite side of origin with respect to line $x+y-1=0$ and same side as origin with respect to line $x+y-3=0$\n<img src=\"assets\\st0000_ae55c0c0f84a.png\"/>\nHence $h+k\\gt0$ and $h+k \\lt 2$."
  }
}