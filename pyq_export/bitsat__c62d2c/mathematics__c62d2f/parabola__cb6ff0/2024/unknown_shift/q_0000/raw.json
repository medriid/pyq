  "question": {
    "text": "If the focus of parabola $(y-k)^2=4(x-h)$ always lies between the lines $x+y=1$ and $x+y$ $=3$ then",
    "image": null
  },
  "options": [
    {
      "id": "OeVHl",
      "text": "$0 \\lt h+k \\lt 2$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Hy8re",
      "text": "$0 \\lt h+k \\lt 1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DpfCY",
      "text": "$1 \\lt h+k \\lt 2$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "9jsEC",
      "text": "$1 \\lt h+k \\lt 3$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Coordinate of focus will be $(h+1, k)$\nNow focus should lie to the opposite side of origin with respect to line $x+y-1=0$ and same side as origin with respect to line $x+y-3=0$\n<img src=\"https://cdn-question-pool.getmarks.app/pyq/bitsat/fdTEuHK189IRVanbSf-fKb92yc4KighvaLBkklCp8Gs.original.fullsize.png\"/>\nHence $h+k\\gt0$ and $h+k \\lt 2$.",
    "image": null
  },
