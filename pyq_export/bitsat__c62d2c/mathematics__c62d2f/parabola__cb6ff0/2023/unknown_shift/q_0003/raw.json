  "question": {
    "text": "The equation of a common tangent to the parabolas $y=x^2$ and $y=-(x-2)^2$ is",
    "image": null
  },
  "options": [
    {
      "id": "IXRPC",
      "text": "$y=4(x-2)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TUSEO",
      "text": "$y=4(x-1)$",
      "image": null,
      "isCorrect": true
    },
