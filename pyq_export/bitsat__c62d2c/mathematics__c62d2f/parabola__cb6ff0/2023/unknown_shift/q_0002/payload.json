  "question": {
    "text": "If vertex of a parabola is $(2,-1)$ and the equation of its directrix is $4 x-3 y=21$, then the length of its latus rectum is"
  },
  "options": [
    {
      "text": "<br />2",
      "is_correct": false
    },
    {
      "text": "<br />8",
      "is_correct": true
    },
