    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mfrac><mn>9</mn><mi>m</mi></mfrac><mo>,</mo><mo>-</mo><mfrac><mrow><mn>6</mn><mi>a</mi></mrow><mi>m</mi></mfrac></mrow></mfenced></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfenced><mrow><mi>a</mi><msup><mi>m</mi><mn>2</mn></msup><mo>,</mo><mo>-</mo><mn>2</mn><mi>a</mi><mi>m</mi></mrow></mfenced></math>",
      "is_correct": false
    },
