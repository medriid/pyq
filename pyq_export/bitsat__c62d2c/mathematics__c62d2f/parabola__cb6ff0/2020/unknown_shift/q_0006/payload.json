  "question": {
    "text": "The length of the latus rectum of the parabola which has focus at (-1,1) and the directrix is $4 \\mathrm{x}$ $+3 y-24=0$ is"
  },
  "options": [
    {
      "text": "4",
      "is_correct": false
    },
    {
      "text": "6",
      "is_correct": false
    },
    {
      "text": "8",
      "is_correct": false
    },
    {
      "text": "10",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Length of latus rectum $=2 \\times$ distance of focus from directrix $=2 \\times \\frac{|1-4+3-24|}{5}=10$"
  }
