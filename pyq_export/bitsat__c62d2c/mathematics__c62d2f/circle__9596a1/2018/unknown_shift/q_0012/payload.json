  "question": {
    "text": "The area of the triangle formed by joining the origin to the point of intersection of the line <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><msqrt><mn>5</mn></msqrt><mo>+</mo><mn>2</mn><mi>y</mi><mo>=</mo><mn>3</mn><msqrt><mn>5</mn></msqrt></math> and circle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>10</mn></math>&nbsp;is"
  },
  "options": [
