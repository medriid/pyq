  "question": {
    "text": "A circle touches both the $y$-axis and the line $x+$ $y=0$. Then the locus of its center is"
  },
  "options": [
    {
      "text": "$y=\\sqrt{2} x$",
      "is_correct": false
    },
    {
      "text": "$x=\\sqrt{2} y$",
      "is_correct": false
    },
    {
      "text": "$y^2-x^2=2 x y$",
      "is_correct": false
    },
    {
      "text": "$x^2-y^2=2 x y$",
      "is_correct": true
    }
  ],
