  "question": {
    "text": "If the lines \\(3 x-4 y+4=0\\) and \\(6 x-8 y-7=0\\) are tangents to a circle, then the radius of the circle is",
    "image": null
  },
  "options": [
    {
      "id": "IZ2Aq",
      "text": "\\(3 / 2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "xqnq6",
      "text": "\\(3 / 4\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "5zChJ",
      "text": "\\(1 / 10\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "mnTAa",
      "text": "\\(1 / 20\\)",
      "image": null,
      "isCorrect": false
    }
