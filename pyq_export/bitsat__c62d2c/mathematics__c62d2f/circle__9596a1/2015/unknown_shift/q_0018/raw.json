  "question": {
    "text": "Area of the circle in which a chord of length $\\sqrt{2}$ makes an angle $\\pi / 2$ at the centre, is",
    "image": null
  },
  "options": [
    {
      "id": "s9aBk",
      "text": "$\\pi / 2$ sq units",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "jfMal",
      "text": "$2 \\pi$ sq units",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "EKk45",
      "text": "$\\pi$ sq units",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Jw3jm",
      "text": "$\\pi / 4 \\mathrm{sq}$ units",
      "isCorrect": false,
