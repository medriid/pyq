    }
  ],
  "question": {
    "text": "If p : It raining today, $\\mathrm{q}:$ I go to school, r : I shall meet any friends and s : I shall go for a movie, then which of the following is the proposition : 'If it does not rain or if I do not go to school, then I shall meet my friend and go for a movie'?",
    "image": null
  },
  "options": [
    {
      "id": "zmKIE",
      "text": "$\\sim(p \\wedge q) \\Rightarrow(r \\wedge s)$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "jJ9vr",
      "text": "$\\sim(\\mathrm{p} \\wedge \\sim \\mathrm{q}) \\Rightarrow(\\mathrm{r} \\wedge \\mathrm{s})$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "NnbIo",
      "text": "$\\sim(p \\wedge q) \\Rightarrow(r \\vee s)$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ztQk0",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Correct result is $(\\sim \\mathrm{p} \\vee \\sim \\mathrm{q}) \\Rightarrow(\\mathrm{r} \\wedge \\mathrm{s})$\nSo, $\\sim(p \\wedge q) \\Rightarrow(r \\wedge s)$",
    "image": null
  },
