  "question": {
    "text": "The Boolean expression $\\sim(p \\vee q) \\vee(\\sim p \\wedge q)$ is equivalent to",
    "image": null
  },
  "options": [
    {
      "id": "GYJUh",
      "text": "$p$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SLhRw",
      "text": "$q$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "CzZYL",
      "text": "$\\sim q$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "SGC3l",
      "text": "$\\sim p$",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} & \\text {  Given, } \\sim(p \\vee q) \\vee(\\sim p \\wedge q) \\\\ & \\Rightarrow(\\sim p \\wedge \\sim q) \\vee(\\sim p \\wedge q) \\text { (By De Morgan's Law) } \\\\ & \\Rightarrow \\sim p \\wedge(\\sim q \\vee q) \\text { (Distributive Law) } \\\\ & \\Rightarrow \\sim p \\wedge t \\text { (By complement law, where } t=\\text { tautology) } \\\\ & \\Rightarrow \\sim p \\text { (Identity law) }\\end{aligned}$",
    "image": null
  },
