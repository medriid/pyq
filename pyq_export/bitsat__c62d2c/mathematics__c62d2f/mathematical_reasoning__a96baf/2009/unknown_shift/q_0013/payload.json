  "question": {
    "text": "If \\(f(t)=\\frac{1-t}{1+t}\\), then \\(f^{\\prime}(1 / t)\\) is equal to"
  },
  "options": [
    {
      "text": "\\(\\frac{1}{(1+t)^2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{(t-1)^2}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{-2 t^2}{(t+1)^2}\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{2}{(t-1)^2}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& f^{\\prime}(t)=\\frac{d}{d t}\\left[\\frac{1-t}{1+t}\\right]=\\frac{(1+t)(-1)-(1-t) \\times(1)}{(1+t)^2} \\\\\n& =\\frac{-1-t-1+t}{(1+t)^2}=\\frac{-2}{(1+t)^2}\n\\end{aligned}\\)\n\\(f^{\\prime}[1 / t]=\\frac{-2}{\\left(1+\\frac{1}{t}\\right)^2}=\\frac{-2 t^2}{(t+1)^2}\\)"
  }
}