  "question": {
    "text": "The sum to $\\mathrm{n}$ terms of the series\r\n\r\n$\\frac{1}{2}+\\frac{3}{4}+\\frac{7}{8}+\\frac{15}{16}+\\ldots \\ldots \\ldots \\ldots$ is",
    "image": null
  },
  "options": [
