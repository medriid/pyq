  "question": {
    "text": "The sum to $\\mathrm{n}$ terms of the series\r\n\r\n$\\frac{1}{2}+\\frac{3}{4}+\\frac{7}{8}+\\frac{15}{16}+\\ldots \\ldots \\ldots \\ldots$ is"
  },
  "options": [
    {
      "text": "$n-1-2^{-n}$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "$n-1+2^{-n}$",
      "is_correct": true
    },
    {
      "text": "$1+2^{-n}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\frac{1}{2}+\\frac{3}{4}+\\frac{7}{8}+\\frac{15}{16}+\\ldots \\\\=&\\left(1-\\frac{1}{2}\\right)+\\left(1-\\frac{1}{4}\\right)+\\left(1-\\frac{1}{8}\\right)+\\left(1-\\frac{1}{16}\\right)+\\ldots . \\\\=& \\mathrm{n}-\\frac{\\frac{1}{2}\\left\\{1-\\frac{1}{2^{\\mathrm{n}}}\\right\\}}{1-\\frac{1}{2}}=\\mathrm{n}-1+2^{-\\mathrm{n}} \\end{aligned}$"
  }
}