  "level": 3,
  "question": {
    "text": "$\\left(x+\\frac{1}{x}\\right)^{2}+\\left(x^{2}+\\frac{1}{x^{2}}\\right)^{2}+$\r\n\r\n$\\left(x^{3}+\\frac{1}{x^{3}}\\right)^{2} \\quad \\ldots .$ upto $n$ terms is",
    "image": null
  },
  "options": [
    {
      "id": "yXuWd",
      "text": "$\\frac{x^{2 n}-1}{x^{2}-1} \\times \\frac{x^{2 n+2}+1}{x^{2 n}}+2 n$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "sS49Q",
      "text": "$\\frac{x^{2 n}+1}{x^{2}+1} \\times \\frac{x^{2 n+2}-1}{x^{2 n}}-2 n$",
