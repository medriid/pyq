  "question": {
    "text": "The sum of the infinite series $\\frac{2^{2}}{2 !}+\\frac{2^{4}}{4 !}+\\frac{2^{6}}{6 !}+\\ldots$\r\n\r\nis equal to",
    "image": null
  },
  "options": [
