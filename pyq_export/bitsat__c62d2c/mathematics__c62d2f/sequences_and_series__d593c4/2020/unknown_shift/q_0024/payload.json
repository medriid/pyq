  "question": {
    "text": "If $a, b, c$ are positive numbers, then least value of $(a+b+c)\\left(\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}\\right)$ is"
  },
  "options": [
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "6",
      "is_correct": false
    },
    {
      "text": "9",
      "is_correct": true
    },
    {
      "text": "None",
      "is_correct": false
