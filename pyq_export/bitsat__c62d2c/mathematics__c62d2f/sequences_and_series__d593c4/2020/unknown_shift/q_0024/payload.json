  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$\\mathrm{AM} \\geq \\mathrm{HM}$\r\n\r\n$\\Rightarrow \\frac{a+b+c}{3} \\geq \\frac{3}{\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}}$\r\n\r\n$\\Rightarrow(a+b+c)\\left(\\frac{1}{a}+\\frac{1}{b}+\\frac{1}{c}\\right) \\geq 9$"
  }
