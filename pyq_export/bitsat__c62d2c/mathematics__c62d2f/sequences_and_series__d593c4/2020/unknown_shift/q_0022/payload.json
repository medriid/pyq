  "question": {
    "text": "A student read common difference of an A. P. as\r\n\r\n-2 instead of 2 and got the sum of first 5 terms as -5 . Actual sum of first five terms is"
  },
  "options": [
    {
      "text": "25",
      "is_correct": false
    },
    {
      "text": "-25",
      "is_correct": false
    },
    {
      "text": "-35",
      "is_correct": false
    },
    {
      "text": "35",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\frac{5}{2}\\{2 \\mathrm{a}+4(-2)\\}=-5 \\Rightarrow 2 \\mathrm{a}=6$\r\n\r\n$\\therefore$ Actual sum $=\\frac{5}{2}\\{6+4(2)\\}=35$"
  }
}