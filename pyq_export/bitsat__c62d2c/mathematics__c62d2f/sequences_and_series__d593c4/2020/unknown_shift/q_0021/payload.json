  "question": {
    "text": "If $a>0, b>0, c>0$ and $a, b, c$ are distinct, then $(a+$b) $(b+c)(c+a)$ is greater than"
  },
  "options": [
    {
      "text": "$2(a+b+c)$",
      "is_correct": false
    },
    {
      "text": "$3(a+b+c)$",
      "is_correct": false
    },
    {
      "text": "$6 \\mathrm{abc}$",
      "is_correct": false
    },
    {
      "text": "$8 \\mathrm{abc}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "$\\mathrm{AM}>\\mathrm{GM}$\r\n\r\n$\\Rightarrow \\frac{\\mathrm{a}+\\mathrm{b}}{2}>\\sqrt{\\mathrm{ab}}, \\frac{\\mathrm{b}+\\mathrm{c}}{2}>\\sqrt{\\mathrm{bc}}, \\frac{\\mathrm{c}+\\mathrm{a}}{2}>\\sqrt{\\mathrm{ca}}$\r\n\r\nSo, $(a+b)(b+c)(c+a)>8 a b c$"
  }
}