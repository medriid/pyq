      "text": "\\(40 x+25 y\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "Exk9J",
      "text": "\\(400 \\mathrm{x}+600 \\mathrm{y}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZWZLN",
      "text": "\\(\\frac{400}{40} \\mathrm{x}+\\frac{600}{25} \\mathrm{y}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "For maximum profit, \\(z=40 x+25 y\\).",
