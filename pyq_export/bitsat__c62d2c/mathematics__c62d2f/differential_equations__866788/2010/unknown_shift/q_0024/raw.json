  "question": {
    "text": "What is the solution of \\(\\frac{d y}{d x}+2 y=1\\) satisfying \\(y(0)=0\\) ?",
    "image": null
  },
  "options": [
    {
      "id": "7Os3n",
      "text": "\\(y=\\frac{1-e^{-2 x}}{2}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "RAFXF",
      "text": "\\(y=\\frac{1+e^{-2 x}}{2}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "w3jlq",
      "text": "\\(y=1+e^x\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ZmsNf",
      "text": "\\(y=\\frac{1+e^x}{2}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\frac{d y}{d x}+2 y=1 \\Rightarrow \\frac{d y}{d x}=1-2 y \\\\\n& \\int \\frac{d y}{1-2 y}=\\int d x-\\frac{1}{2} \\log |1-2 y|=x+C \\\\\n& \\text { at } x=0, y=0 ;-\\frac{1}{2} \\log 1=0+C \\Rightarrow C=0 \\\\\n& 1-2 y=e^{-2 x} \\Rightarrow y=\\frac{1-e^{-2 x}}{2}\n\\end{aligned}\\)",
    "image": null
  },
