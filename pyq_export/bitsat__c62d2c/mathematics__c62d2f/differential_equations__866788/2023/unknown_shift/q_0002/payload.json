  "question": {
    "text": "The integrating factor of $\\frac{x d y}{d x}-y=x^4-3 x$ is"
  },
  "options": [
    {
      "text": "<br />x",
      "is_correct": false
    },
    {
      "text": "$\\log x$",
      "is_correct": false
    },
    {
      "text": "$\\frac{1}{x}$",
      "is_correct": true
    },
    {
      "text": "$-\\mathbf{X}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "<br />$\\begin{aligned}<br />& \\text { (c) Since } x \\frac{d y}{d x}-y=x^4-3 x \\\\<br />& \\therefore \\frac{d y}{d x}-\\frac{y}{x}=x^3-3<br />\\end{aligned}$<br />Hence $I F=e^{\\int P d x}=e^{-\\int \\frac{1}{x} d x}=e^{-\\log x}=\\frac{1}{x}$"
  }
}