  "question": {
    "text": "The differential equation whose solution is $A x^{2}+B y^{2}=1$ where $A$ and $B$ are arbitrary constants is of",
    "image": null
  },
  "options": [
    {
      "id": "geph7",
      "text": "second order and second degree",
      "isCorrect": false,
      "image": null
    },
    {
