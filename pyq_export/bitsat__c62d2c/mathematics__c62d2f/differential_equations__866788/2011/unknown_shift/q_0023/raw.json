  "question": {
    "text": "The degree of the differential equation \\(\\left(\\frac{d^3 y}{d x^3}\\right)^{2 / 3}+4-3 \\frac{d^2 y}{d x^2}+5 \\frac{d y}{d x}=0\\) is",
    "image": null
  },
  "options": [
    {
      "id": "vs78e",
      "text": "1",
      "image": null,
      "isCorrect": false
    },
    {
