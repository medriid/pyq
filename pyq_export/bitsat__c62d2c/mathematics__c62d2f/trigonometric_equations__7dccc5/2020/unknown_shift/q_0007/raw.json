  "question": {
    "text": "The value of $\\sin \\left[\\mathrm{n} \\pi+(-1)^{\\mathrm{n}} \\frac{\\pi}{4}\\right], \\mathrm{n} \\in \\mathrm{I}$ is",
    "image": null
  },
  "options": [
