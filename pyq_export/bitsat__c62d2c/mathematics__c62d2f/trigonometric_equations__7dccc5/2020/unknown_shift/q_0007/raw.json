  ],
  "correctValue": null,
  "solution": {
    "text": "$\\sin \\left[\\mathrm{n} \\pi+(-1)^{\\mathrm{n}} \\frac{\\pi}{4}\\right]=(-1)^{\\mathrm{n}} \\sin \\left[(-1)^{\\mathrm{n}} \\frac{\\pi}{4}\\right]$\r\n\r\n$\\left[\\because \\sin (\\mathrm{n} \\pi+\\theta)=(-1)^{\\mathrm{n}} \\sin \\theta\\right]$\r\n\r\n$\\begin{aligned} &=(-1)^{\\mathrm{n}}(-1)^{\\mathrm{n}} \\sin \\frac{\\pi}{4} \\\\ \\therefore \\sin &\\left.\\left[(-1)^{\\mathrm{n}} \\theta\\right]=(-1)^{\\mathrm{n}} \\sin \\theta\\right] \\\\ &=(-1)^{2 \\mathrm{n}} \\sin \\frac{\\pi}{4}=\\sin \\frac{\\pi}{4}=\\frac{1}{\\sqrt{2}} \\end{aligned}$",
    "image": null
  },
