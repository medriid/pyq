  "question": {
    "text": "General solution of $\\tan 5 \\theta=\\cot 2 \\theta$ is"
  },
  "options": [
    {
      "text": "$\\theta=\\frac{n \\pi}{7}+\\frac{\\pi}{14}$",
      "is_correct": true
    },
    {
      "text": "$\\theta=\\frac{n \\pi}{7}+\\frac{\\pi}{5}$",
      "is_correct": false
    },
    {
      "text": "$\\theta=\\frac{\\mathrm{n} \\pi}{7}+\\frac{\\pi}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\theta=\\frac{\\mathrm{n} \\pi}{7}+\\frac{\\pi}{3}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "We have $\\tan 5 \\theta=\\cot 2 \\theta$<br />$\\begin{aligned}<br />& \\Rightarrow \\tan 5 \\theta=\\tan \\left(\\frac{\\pi}{2}-2 \\theta\\right) \\ldots \\\\<br />& \\left[\\because \\tan \\left(\\frac{\\pi}{2}-\\theta\\right)=\\cot \\theta\\right] \\\\<br />& \\Rightarrow 5 \\theta=n \\pi+\\frac{\\pi}{2}-2 \\theta \\Rightarrow 7 \\theta=n \\pi+\\frac{\\pi}{2} \\\\<br />& \\Rightarrow \\quad \\theta=\\frac{n \\pi}{7}+\\frac{\\pi}{14} .<br />\\end{aligned}$"
  }
}