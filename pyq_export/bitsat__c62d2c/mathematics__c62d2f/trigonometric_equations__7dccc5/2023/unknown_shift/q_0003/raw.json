  "question": {
    "text": "If $\\sec ^2 \\theta=\\frac{4}{3}$, then the general value of $\\theta$ is",
    "image": null
  },
  "options": [
    {
      "id": "XIUAj",
      "text": "$2 \\mathrm{n} \\pi \\pm \\frac{\\pi}{6}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HNypo",
      "text": "$\\mathrm{n} \\pi \\pm \\frac{\\pi}{6}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "QuSRw",
      "text": "$2 \\mathrm{n} \\pi \\pm \\frac{\\pi}{3}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "v5sYE",
      "text": "$\\mathrm{n} \\pi \\pm \\frac{\\pi}{3}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "We have $\\sec ^2 \\theta=\\frac{4}{3} \\Rightarrow \\cos ^2 \\theta=\\frac{3}{4}$<br />$\\Rightarrow \\cos ^2 \\theta=\\cos ^2\\left(\\frac{\\pi}{6}\\right) \\Rightarrow$<br />$\\theta=n \\pi \\pm \\frac{\\pi}{6} \\ldots \\ldots \\ldots$",
    "image": null
  },
