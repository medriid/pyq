  "question": {
    "text": "If \\(y=\\frac{2 \\sin \\alpha}{1+\\cos \\alpha+\\sin \\alpha}\\), then value of \\(\\frac{1-\\cos \\alpha+\\sin \\alpha}{1+\\sin \\alpha}\\) is"
  },
  "options": [
    {
      "text": "\\(\\frac{y}{3}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\mathrm{y}\\)",
      "is_correct": true
    },
    {
      "text": "\\(2 y\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{3}{2} y\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\frac{1-\\cos \\alpha+\\sin \\alpha}{1+\\sin \\alpha} \\\\\n& =\\frac{1-\\cos \\alpha+\\sin \\alpha}{1+\\sin \\alpha} \\cdot \\frac{1+\\cos \\alpha+\\sin \\alpha}{1+\\cos \\alpha+\\sin \\alpha} \\\\\n& =\\frac{(1+\\sin \\alpha)^2-\\cos ^2 \\alpha}{(1+\\sin \\alpha)(1+\\cos \\alpha+\\sin \\alpha)} \\\\\n& =\\frac{2 \\sin \\alpha(1+\\sin \\alpha)}{(1+\\sin \\alpha)(1+\\cos \\alpha+\\sin \\alpha)} \\\\\n& =\\frac{2 \\sin \\alpha}{1+\\cos \\alpha+\\sin \\alpha}=y\n\\end{aligned}\\)"
  }
}