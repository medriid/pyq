  "question": {
    "text": "If $y=\\frac{2 \\sin \\alpha}{1+\\cos \\alpha+\\sin \\alpha}$, then value of $\\frac{1-\\cos \\alpha+\\sin \\alpha}{1+\\sin \\alpha}$ is",
    "image": null
  },
  "options": [
    {
      "id": "IslkJ",
      "text": "$\\frac{y}{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ANZZX",
      "text": "$y$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "jAs2S",
      "text": "$2 y$",
      "isCorrect": false,
      "image": null
    },
    {
