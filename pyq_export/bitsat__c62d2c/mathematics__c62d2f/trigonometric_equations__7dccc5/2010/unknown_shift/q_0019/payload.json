  "question": {
    "text": "If \\(12 \\cot ^2 \\theta-31 \\operatorname{coses} \\theta+32=0\\), then the value of \\(\\sin \\theta\\) is"
  },
  "options": [
    {
      "text": "\\(\\frac{3}{5}\\) or 1",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{2}{3}\\) or \\(\\frac{-2}{3}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{4}{5}\\) or \\(\\frac{3}{4}\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\pm \\frac{1}{2}\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& 12 \\cot ^2 \\theta-31 \\operatorname{cosec} \\theta+32=0 \\\\\n& \\Rightarrow 12\\left(\\operatorname{cosec}^2 \\theta-1\\right)-31 \\operatorname{cosec} \\theta+32=0 \\\\\n& \\Rightarrow \\quad 12 \\operatorname{cosec}^2 \\theta-31 \\operatorname{cosec} \\theta+20=0 \\\\\n& \\Rightarrow \\quad 12 \\operatorname{cosec}^2 \\theta-16 \\operatorname{cosec} \\theta-15 \\operatorname{cosec} \\theta+20=0 \\\\\n& \\Rightarrow \\quad(4 \\operatorname{cosec} \\theta-5)(3 \\operatorname{cosec} \\theta-4)=0 \\\\\n& \\Rightarrow \\quad \\operatorname{cosec} \\theta=\\frac{5}{4}, \\frac{4}{3} ; \\therefore \\sin \\theta=\\frac{4}{5}, \\frac{3}{4}\n\\end{aligned}\\)"
  }
}