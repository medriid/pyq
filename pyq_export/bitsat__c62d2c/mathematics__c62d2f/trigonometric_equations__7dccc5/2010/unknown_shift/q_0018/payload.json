  "question": {
    "text": "\\(\\tan 20^{\\circ}+\\tan 40^{\\circ}+\\sqrt{3} \\tan 20^{\\circ} \\tan 40^{\\circ}\\) is equal to"
  },
  "options": [
    {
      "text": "\\(\\sqrt{3} / 2\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\sqrt{3} / 4\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\sqrt{3}\\)",
      "is_correct": true
    },
    {
      "text": "1",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n\\sqrt{3} & =\\tan 60^{\\circ}=\\tan \\left(40^{\\circ}+20^{\\circ}\\right) \\\\\n& =\\frac{\\tan 40^{\\circ}+\\tan 20^{\\circ}}{1-\\tan 40^{\\circ} \\tan 20^{\\circ}} \\\\\n\\therefore \\quad & \\sqrt{3}-\\sqrt{3} \\tan 40^{\\circ} \\tan 20^{\\circ} \\\\\n& =\\tan 40^{\\circ}+\\tan 20^{\\circ}\n\\end{aligned}\\)\nHence \\(\\tan 40^{\\circ}+\\tan 20^{\\circ}+\\sqrt{3} \\tan 40^{\\circ} \\tan 20^{\\circ}\\) \\(=\\sqrt{3}\\)"
  }
