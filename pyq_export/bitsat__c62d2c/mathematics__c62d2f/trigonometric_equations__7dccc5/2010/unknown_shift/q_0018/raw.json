  "question": {
    "text": "\\(\\tan 20^{\\circ}+\\tan 40^{\\circ}+\\sqrt{3} \\tan 20^{\\circ} \\tan 40^{\\circ}\\) is equal to",
    "image": null
  },
  "options": [
    {
      "id": "qt5r2",
      "text": "\\(\\sqrt{3} / 2\\)",
      "image": null,
      "isCorrect": false
    },
