  "question": {
    "text": "A ladder rests against a wall so that its top touches the roof of the house. If the ladder makes an angle of \\(60^{\\circ}\\) with the horizontal and height of the house be \\(6 \\sqrt{3}\\) meters, then the length of the ladder in meters is",
    "image": null
  },
  "options": [
    {
      "id": "Im9WX",
      "text": "\\(12 \\sqrt{3}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8Qo17",
      "text": "12",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "09lfJ",
      "text": "\\(12 / \\sqrt{3}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "FFrPg",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Length of ladder \\(=\\frac{6 \\sqrt{3}}{\\sin 60^{\\circ}}=12 \\mathrm{~m}\\)",
    "image": null
  },
