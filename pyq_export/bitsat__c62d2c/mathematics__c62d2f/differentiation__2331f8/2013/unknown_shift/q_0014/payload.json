  "question": {
    "text": "If $y=1+x+\\frac{x^{2}}{2 !}+\\frac{x^{3}}{3 !}+\\ldots . \\infty,$ then $\\frac{d y}{d x}$ is equal to"
  },
  "options": [
    {
      "text": "$x$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": false
    },
    {
      "text": "$y$",
      "is_correct": true
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$y=e^{x} \\Rightarrow \\frac{d y}{d x}=e^{x}=y$"
  }
}