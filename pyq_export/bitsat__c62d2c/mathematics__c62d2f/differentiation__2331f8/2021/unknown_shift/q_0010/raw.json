  "question": {
    "text": "$\\text { If } 2^{x}+2^{y}=2^{x+y} \\text {, then } \\frac{d y}{d x}=$",
    "image": null
  },
  "options": [
    {
      "id": "SGOv6",
      "text": "$2^{x-y} \\frac{2^{y}-1}{2^{x}-1}$",
