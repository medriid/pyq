  "question": {
    "text": "If \\(y=x^{x^2}\\), then \\(\\frac{d y}{d x}\\) is equal to",
    "image": null
  },
  "options": [
    {
      "id": "CAFsM",
      "text": "\\((2 \\ln x)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "8vyC8",
      "text": "\\((2 \\ln x+1)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "wjz12",
      "text": "\\((\\ln \\ln x+1) x^{x^2}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "hISP9",
      "text": "None of these",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Consider \\(y=x^{x^2} \\Rightarrow \\ln y=x^2 \\ln x\\)\n\\(\\begin{aligned}\n& \\frac{1}{y} \\frac{d y}{d x}=2 x \\ln x+x^2 \\cdot \\frac{1}{x}=x(1+2 \\ln x) \\\\\n& \\frac{d y}{d x}=x^{x^2} \\cdot x(1+2 \\ln x)=x^{x^2+1}(1+2 \\ln x)\n\\end{aligned}\\)",
    "image": null
  },
