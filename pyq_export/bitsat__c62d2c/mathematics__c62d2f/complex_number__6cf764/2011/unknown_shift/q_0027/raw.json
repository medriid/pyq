  "question": {
    "text": "If \\(a > 0, a \\in R, z=a+2 i\\) and \\(z|z|-a z+1=0\\) then",
    "image": null
  },
  "options": [
    {
      "id": "wZCmv",
      "text": "\\(z\\) is always a positive real number",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "L5Dv4",
      "text": "\\(z\\) is always a negative real number",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "5EsYn",
      "text": "\\(z\\) is purely imaginary number",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7fHGP",
      "text": "such a complex z does not exist",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Putting \\(z=a+2 i\\) in the given equation and comparing imaginary parts, we get \\(\\mathrm{a}^2+4=\\mathrm{a}^2\\), which is not possible.",
    "image": null
  },
