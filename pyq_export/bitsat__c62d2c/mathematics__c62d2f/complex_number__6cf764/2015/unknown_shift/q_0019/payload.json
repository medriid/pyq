  "question": {
    "text": "The root of the equation\r\n\r\n$2(1+i) x^{2}-4(2-i) x-5-3 i=0$ which has\r\n\r\ngreater modulus is"
  },
  "options": [
    {
      "text": "$\\frac{3-5 i}{2}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{5-3 \\mathrm{i}}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3-i}{2}$",
      "is_correct": false
    },
    {
      "text": "none",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} \\text { Roots } &=\\frac{4(2-i) \\pm \\sqrt{16(2-i)^{2}+8(1+i)(5+3 i)}}{4(1+i)} \\\\ &=\\frac{4-i}{1+i} \\text { or } \\frac{-i}{1+i}=\\frac{3-5 i}{2} \\text { or } \\frac{-1-i}{2} \\end{aligned}$"
  }
}