  "question": {
    "text": "The root of the equation\r\n\r\n$2(1+i) x^{2}-4(2-i) x-5-3 i=0$ which has\r\n\r\ngreater modulus is",
    "image": null
  },
  "options": [
    {
      "id": "9rynk",
      "text": "$\\frac{3-5 i}{2}$",
      "isCorrect": true,
      "image": null
    },
