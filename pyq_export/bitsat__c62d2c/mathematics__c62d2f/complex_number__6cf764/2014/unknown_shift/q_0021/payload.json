  "question": {
    "text": "$i^{57}+\\frac{1}{i^{25}},$ when simplified has the value"
  },
  "options": [
    {
      "text": "0",
      "is_correct": true
    },
    {
      "text": "$2 i$",
      "is_correct": false
    },
    {
      "text": "$-2 i$",
      "is_correct": false
    },
    {
      "text": "2",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "$\\begin{aligned} i^{57}+\\frac{1}{i^{25}}=\\left(i^{4}\\right)^{14} \\cdot i &+\\frac{1}{\\left(i^{4}\\right)^{6} \\cdot i} \\\\=i+\\frac{1}{i}\\left(\\because i^{4}=1\\right) &=i-i\\left(\\because \\frac{1}{i}=-i\\right) \\\\ &=0 \\end{aligned}$"
  }
}