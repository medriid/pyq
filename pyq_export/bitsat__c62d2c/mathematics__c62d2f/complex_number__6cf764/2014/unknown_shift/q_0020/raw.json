  "question": {
    "text": "The complex number $z=z+i y$ which satisfies\r\n\r\nthe equation $\\left|\\frac{z-3 i}{z+3 i}\\right|=1,$ lies on",
    "image": null
  },
  "options": [
    {
      "id": "do3jY",
      "text": "the $X$ -axis",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "My2pW",
      "text": "the straight line $y=3$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "QugIM",
      "text": "a circle passing through origin",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ZXZ5q",
      "text": "None of the above",
      "isCorrect": false,
      "image": null
