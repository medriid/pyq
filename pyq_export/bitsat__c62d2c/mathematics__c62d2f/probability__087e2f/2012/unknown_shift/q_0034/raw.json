  "question": {
    "text": "Two dice are thrown together 4 times. The probability that both dice will show same numbers twice is -",
    "image": null
  },
  "options": [
    {
      "id": "exQ7G",
      "text": "$\\frac{1}{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "OZAMZ",
      "text": "$\\frac{25}{36}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "eDYFk",
      "text": "$\\frac{25}{216}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "piFlx",
      "text": "None of these",
      "isCorrect": false,
