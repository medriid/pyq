  "level": 1,
  "question": {
    "text": "The mean and variance of a random variable $\\mathrm{X}$ having binomial distribution are 4 and 2 respectively, then $\\mathrm{P}(\\mathrm{X}=1)$ is",
    "image": null
  },
  "options": [
    {
      "id": "oD0Ki",
      "text": "$\\frac{1}{4}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "gas4V",
      "text": "$\\frac{1}{32}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "BwxEe",
      "text": "$\\frac{1}{16}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "6gDgN",
      "text": "$\\frac{1}{8}$",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$\\begin{aligned} n p &=4 \\\\ n p q &=2 \\\\ \\Rightarrow q &=\\frac{1}{2}, p=\\frac{1}{2}, n=8 \\\\ \\mathrm{P}(\\mathrm{X}&=1)={ }^{8} \\mathrm{C}_{1}\\left(\\frac{1}{2}\\right)\\left(\\frac{1}{2}\\right)^{7}=8 \\cdot \\frac{1}{2^{8}}=\\frac{1}{2^{5}}=\\frac{1}{32} \\end{aligned}$",
    "image": null
  },
