  "level": 2,
  "question": {
    "text": "Girl students constitute $10 \\%$ of I year and $5 \\%$ of II year at Roorkee University. During summer holidays $70 \\%$ of the I year and $30 \\%$ of II year students are given a project. The girls take turns on duty in canteen. The chance that I year girl student is on duty in a randomly selected day is",
    "image": null
  },
  "options": [
