  "question": {
    "text": "Girl students constitute $10 \\%$ of I year and $5 \\%$ of II year at Roorkee University. During summer holidays $70 \\%$ of the I year and $30 \\%$ of II year students are given a project. The girls take turns on duty in canteen. The chance that I year girl student is on duty in a randomly selected day is"
  },
  "options": [
    {
      "text": "$\\frac{3}{17}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{14}{17}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{3}{10}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{7}{10}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "The desired probability\r\n\r\n$=\\frac{\\frac{10}{100} \\times \\frac{70}{100}}{\\frac{10}{100} \\times \\frac{70}{100}+\\frac{5}{100} \\times \\frac{30}{100}}=\\frac{14}{17}$"
  }
}