  "question": {
    "text": "The probability that a card drawn from a pack of 52 cards will be a diamond or king is:",
    "image": null
  },
  "options": [
    {
      "id": "i0zPW",
      "text": "$\\frac{1}{52}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "6Lt4e",
      "text": "$\\frac{2}{13}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "A9BmP",
      "text": "$\\frac{4}{13}$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "EM5CC",
      "text": "$\\frac{1}{13}$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Total no. of cards $=52$<br />13 cards are diamonds and 4 cards are king.<br />There is only one card which is a king of diamond.<br />$\\therefore \\mathrm{P}($ card is diamond $)=\\frac{13}{52}, \\mathrm{P}$ (card is king)<br />$=\\frac{4}{52}$<br />$\\mathrm{P}($ card is king of diamond $)=\\frac{1}{52}$<br />$\\therefore \\quad P$ (card is diamond or king)<br />$=\\frac{13}{52}+\\frac{4}{52}-\\frac{1}{52}=\\frac{16}{52}=\\frac{4}{13}$",
    "image": null
  },
