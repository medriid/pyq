  "question": {
    "text": "If $\\mathrm{E}$ and $\\mathrm{F}$ are events such that $0 < \\mathrm{P}(\\mathrm{F}) < 1$, then",
    "image": null
  },
  "options": [
    {
      "id": "0st74",
      "text": "$P(E \\mid F)+P(\\bar{E} \\mid F)=1$",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "uWgYN",
      "text": "$P(E \\mid F)+P(E \\mid \\bar{F})=1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "aTrgz",
      "text": "$P(\\bar{E} \\mid F)+P(E \\mid \\bar{F})=1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "vvWNL",
      "text": "$P(E \\mid \\bar{F})+P(\\bar{E} \\mid \\bar{F})=0$",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "$P(E \\mid F)+P(\\bar{E} \\mid F)$<br />$=\\frac{P(E \\cap F)+P(\\bar{E} \\cap F)}{P(F)}=\\frac{P((E \\cup \\bar{E}) \\cap F)}{P(F)}=\\frac{P(F)}{P(F)}=1$",
    "image": null
  },
