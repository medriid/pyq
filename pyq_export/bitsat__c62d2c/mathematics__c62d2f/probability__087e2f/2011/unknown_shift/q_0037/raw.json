  "question": {
    "text": "A die is loaded such that the probability of throwing the number \\(i\\) is proportional to its reciprocal. The probability that 3 appears in a single throw is-",
    "image": null
  },
  "options": [
    {
      "id": "9lz3A",
      "text": "\\(3 / 22\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TGEex",
      "text": "\\(3 / 11\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "DrBX2",
      "text": "\\(9 / 22\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "cb6Vi",
      "text": "None of these",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\mathrm{P}(\\mathrm{i})=\\frac{\\mathrm{k}}{\\mathrm{i}} \\Rightarrow \\mathrm{1}=\\sum_{\\mathrm{i}=1}^6 \\mathrm{P}(\\mathrm{i})=\\mathrm{k} \\sum_{\\mathrm{i}=1}^6 \\frac{1}{\\mathrm{i}}=\\mathrm{k} \\frac{49}{20} \\\\\n& \\Rightarrow \\mathrm{k}=\\frac{20}{49} . \\mathrm{P}(3)=\\frac{20}{147}\n\\end{aligned}\\)",
    "image": null
  },
