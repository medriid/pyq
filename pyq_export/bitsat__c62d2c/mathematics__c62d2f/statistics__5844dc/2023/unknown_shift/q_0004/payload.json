  "question": {
    "text": "The standard deviation of 5 scores $1,2,3,4,5$ is $\\sqrt{a}$. The value of ' $a$ ' is"
  },
  "options": [
    {
      "text": "<br />2",
      "is_correct": true
    },
    {
      "text": "<br />3",
      "is_correct": false
    },
    {
      "text": "<br />5",
      "is_correct": false
    },
    {
      "text": "<br />1",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<br />$\\begin{aligned} & \\text { Mean }(\\bar{x})=\\frac{1+2+3+4+5}{5}=3 \\\\ & \\text { S.D }=\\sigma=\\sqrt{\\frac{1}{5}(1+4+9+16+25)-9}=\\sqrt{11-9} \\\\ & =\\sqrt{2}\\end{aligned}$"
  }
}