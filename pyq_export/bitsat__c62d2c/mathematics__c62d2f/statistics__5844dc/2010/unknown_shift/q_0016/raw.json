  "question": {
    "text": "Mean of 25 observations was found to be 78.4. But later on it was found that 96 was misread 69 . The correct mean is",
    "image": null
  },
  "options": [
    {
      "id": "gHLi7",
      "text": "79.24",
      "image": null,
      "isCorrect": false
    },
