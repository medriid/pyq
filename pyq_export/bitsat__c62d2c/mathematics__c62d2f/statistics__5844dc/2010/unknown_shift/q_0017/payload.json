  "question": {
    "text": "Find the value of \\(\\lim _{x \\rightarrow 0} \\frac{\\sqrt{\\left(1+x^2\\right)}-\\sqrt{1-x^2}}{x^2}\\)"
  },
  "options": [
    {
      "text": "1",
      "is_correct": true
    },
    {
      "text": "2",
