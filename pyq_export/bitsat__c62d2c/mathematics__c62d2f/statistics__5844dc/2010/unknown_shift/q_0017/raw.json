  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\lim _{x \\rightarrow 0} \\frac{\\sqrt{1+x^2}-\\sqrt{1-x^2}}{x^2} \\cdot \\frac{\\sqrt{1+x^2}+\\sqrt{1-x^2}}{\\sqrt{1+x^2}+\\sqrt{1-x^2}} \\\\\n\\Rightarrow & \\lim _{x \\rightarrow 0} \\frac{1+x^2-1+x^2}{x^2\\left(\\sqrt{1+x^2}+\\sqrt{1-x^2}\\right)} \\\\\n\\Rightarrow & \\lim _{x \\rightarrow 0} \\frac{2 x^2}{x^2\\left(\\sqrt{1+x^2}+\\sqrt{1-x^2}\\right)}=\\frac{2}{\\sqrt{1}+\\sqrt{1}}=\\frac{2}{2}=1\n\\end{aligned}\\)",
    "image": null
  },
