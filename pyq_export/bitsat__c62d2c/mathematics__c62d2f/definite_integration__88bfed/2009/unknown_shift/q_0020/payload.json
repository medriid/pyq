  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\int \\frac{\\mathrm{dx}}{\\sqrt{2-\\mathrm{x}^2}}=\\sin ^{-1} \\frac{\\mathrm{x}}{\\sqrt{2}}+\\mathrm{c} \\\\\n& \\text {So } \\int_0^1 \\frac{\\mathrm{dx}}{\\sqrt{2-\\mathrm{x}^2}}=\\left.\\sin ^{-1} \\frac{\\mathrm{x}}{\\sqrt{2}}\\right|_0 ^1 \\\\\n= & \\sin ^{-1}\\left(\\frac{1}{\\sqrt{2}}\\right)+c-\\sin ^{-1}(0)-c=\\frac{\\pi}{4}-0=\\frac{\\pi}{4}\n\\end{aligned}\\)"
  }
