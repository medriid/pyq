  "question": {
    "text": "Evaluate: \\(\\int x \\tan ^{-1} x d x\\)"
  },
  "options": [
    {
      "text": "\\(\\frac{1}{2}\\left(x^2+1\\right) \\tan ^{-1} x-\\frac{1}{2} x+c\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\frac{1}{2}\\left(x^2+1\\right) \\tan ^{-1} x+\\frac{1}{2} x+c\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{1}{2}\\left(\\mathrm{x}^2-1\\right) \\tan ^{-1} \\mathrm{x}-\\frac{1}{2} \\mathrm{x}+\\mathrm{c}\\)",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\int x \\tan ^{-1} x d x=\\frac{x^2}{2} \\tan ^{-1} x-\\frac{1}{2} \\int \\frac{x^2}{1+x^2} d x \\\\\n& =\\frac{x^2}{2} \\tan ^{-1} x-\\frac{1}{2} \\int\\left[1-\\frac{1}{1+x^2}\\right] d x \\\\\n& =\\frac{1}{2}\\left(x^2+1\\right) \\tan ^{-1} x-\\frac{1}{2} x+c\n\\end{aligned}\\)"
  }
