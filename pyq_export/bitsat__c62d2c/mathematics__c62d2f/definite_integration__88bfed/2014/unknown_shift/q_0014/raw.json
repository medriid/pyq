  "question": {
    "text": "$\\int_{0}^{10} \\frac{x^{10}}{(10-x)^{10}+x^{10}} d x$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "h8qpM",
      "text": "10",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "sqtxO",
      "text": "5",
      "isCorrect": true,
      "image": null
    },
    {
