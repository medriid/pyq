  "question": {
    "text": "The value of definite integral $\\int_0^{\\pi / 2} \\log (\\tan x) d x$ is",
    "image": null
  },
  "options": [
    {
      "id": "O4U2t",
      "text": "0",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "a8LZE",
      "text": "$\\frac{\\pi}{4}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "RSnRV",
      "text": "$\\frac{\\pi}{2}$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "7K0kB",
      "text": "$\\pi$",
      "image": null,
      "isCorrect": false
    }
