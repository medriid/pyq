  "question": {
    "text": "Let \\(\\mathrm{I}_1=\\int_1^2 \\frac{1}{\\sqrt{1+\\mathrm{x}^2}} \\mathrm{dx}\\) and \\(\\mathrm{I}_2=\\int_1^2 \\frac{1}{x} d x\\), then",
    "image": null
  },
  "options": [
    {
      "id": "epAa7",
      "text": "\\(\\mathrm{I}_1 > \\mathrm{I}_2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "R2pCK",
      "text": "\\(\\mathrm{I}_2 > \\mathrm{I}_1\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "lml4h",
      "text": "\\(\\mathrm{I}_1=\\mathrm{I}_2\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "ATRqY",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "If \\(I_1=\\int_1^2 \\frac{\\mathrm{dx}}{\\sqrt{1+\\mathrm{x}^2}}, I_2=\\int_1^2 \\frac{\\mathrm{dx}}{\\mathrm{x}}\\)\n\\(I_1=\\ell n \\left(\\frac{2+\\sqrt{5}}{1+\\sqrt{2}}\\right), \\quad I_2=\\ell n 2 \\Rightarrow I_1  < I_2\\)",
    "image": null
  },
