  "question": {
    "text": "$\\int_{\\pi / 3}^{\\pi / 2} x \\sin (\\pi[x]-x) \\mathrm{dx}$ is equal to"
  },
  "options": [
    {
      "text": "$\\frac{1}{2}+\\frac{\\pi}{6}$",
      "is_correct": false
    },
    {
      "text": "$1-\\frac{\\sqrt{3}}{2}+\\frac{\\pi}{6}$",
      "is_correct": true
    },
    {
      "text": "$-\\frac{1}{2}-\\frac{\\pi}{6}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{\\sqrt{3}}{2}-1-\\frac{\\pi}{6}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "In the interval $\\frac{\\pi}{3}$ to $\\frac{\\pi}{2},[\\mathrm{x}]=1$ $\\begin{aligned} \\therefore \\mathrm{I} &=\\int_{\\pi / 3}^{\\pi / 2} \\mathrm{x} \\sin (\\pi-\\mathrm{x}) \\mathrm{dx}=\\int_{\\pi / 3}^{\\pi / 2} \\mathrm{x} \\sin \\mathrm{x} \\mathrm{d} \\mathrm{x} \\\\ &=[-\\mathrm{x} \\cos \\mathrm{x}+\\sin \\mathrm{x}]_{\\pi / 3}^{\\pi / 2}=1-\\frac{\\sqrt{3}}{2}+\\frac{\\pi}{6} \\end{aligned}$"
  }
}