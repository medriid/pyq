    "text": "<p>Given,&nbsp;</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>c</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>a</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>)</mo><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>)</mo><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>=</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mover><mi>a</mi><mo>&#8594;</mo></mover><mn>2</mn></msup><mo>-</mo><msup><mover><mi>b</mi><mo>&#8594;</mo></mover><mn>2</mn></msup><mo>=</mo><mo>(</mo><mover><mi>b</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>)</mo><mo>&#183;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>-</mo><mo>(</mo><mover><mi>c</mi><mo>&#8594;</mo></mover><mo>&#215;</mo><mover><mi>a</mi><mo>&#8594;</mo></mover><mo>)</mo><mo>&#183;</mo><mover><mi>b</mi><mo>&#8594;</mo></mover></math></p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>=</mo><mo>[<