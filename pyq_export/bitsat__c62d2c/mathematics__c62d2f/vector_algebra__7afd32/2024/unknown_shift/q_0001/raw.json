  "correctValue": null,
  "solution": {
    "text": "$\\hat{i} \\times(\\bar{a} \\times \\hat{i})=(\\hat{i} \\cdot \\hat{i}) \\bar{a}-(\\hat{i} \\cdot \\bar{a}) \\hat{i}=\\hat{j}+2 \\hat{k}$\n$\\begin{aligned}\n& \\text { Similarly, } \\hat{j} \\times(\\bar{a} \\times \\hat{j})=2 \\hat{i}+2 \\hat{k} \\\\\n& \\hat{k} \\times(\\bar{a} \\times \\hat{k})=2 \\hat{i}+\\hat{j} \\\\\n& \\Rightarrow \\|\\hat{j}+2 \\hat{k}|^2+|2 \\hat{i}+2 \\hat{k}|^2+|2 \\hat{i}+\\hat{j}|^2 \\\\\n& =5+8+5=18\n\\end{aligned}$",
    "image": null
  },
