  "question": {
    "text": "If $\\vec{r}$ and $\\vec{s}$ arenon-zero constant vectors and the scalar $b$ is chosen such that $|\\vec{r}+b \\vec{s}|$ is minimum, then the value of $|b \\vec{s}|^{2}+|\\vec{r}+b \\vec{s}|^{2}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "abLnS",
