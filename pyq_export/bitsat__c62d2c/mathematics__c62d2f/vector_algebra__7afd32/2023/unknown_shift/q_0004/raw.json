  "question": {
    "text": "If $\\vec{a}=\\hat{i}+\\hat{j}+\\hat{k}, \\vec{a} \\cdot \\vec{b}=1$ and $\\vec{a} \\times \\vec{b}=\\vec{j}-\\vec{k}$, then $\\vec{b}$ is",
    "image": null
  },
  "options": [
    {
      "id": "0CVlf",
      "text": "$\\hat{i}-\\hat{j}+\\hat{k}$",
      "image": null,
