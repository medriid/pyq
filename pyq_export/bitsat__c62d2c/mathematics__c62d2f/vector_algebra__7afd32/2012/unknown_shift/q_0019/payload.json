  "question": {
    "text": "The unit vector perpendicular to the vectors $6 \\hat{i}+2 \\hat{j}+3 \\hat{k}$ and $3 \\hat{i}-6 \\hat{j}-2 \\hat{k}$ is $-$"
  },
  "options": [
    {
      "text": "$\\frac{2 \\hat{i}-3 \\hat{j}+6 \\hat{k}}{7}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2 \\hat{\\mathrm{i}}-3 \\hat{\\mathrm{j}}-6 \\hat{\\mathrm{k}}}{7}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{2 \\hat{\\mathrm{i}}+3 \\hat{\\mathrm{j}}-6 \\hat{\\mathrm{k}}}{7}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{2 \\hat{i}+3 \\hat{j}+6 \\hat{k}}{7}$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Unit vector perpendicular to both the given vectors is, $\\frac{(6 \\hat{i}+2 \\hat{j}+3 \\hat{k}) \\times(3 \\hat{i}-6 \\hat{j}-2 \\hat{k})}{|(6 \\hat{i}+2 \\hat{j}+3 \\hat{k}) \\times(3 \\hat{i}-6 \\hat{j}-2 \\hat{k})|}=\\frac{2 \\hat{i}+3 \\hat{j}-6 \\hat{k}}{7}$"
  }
}