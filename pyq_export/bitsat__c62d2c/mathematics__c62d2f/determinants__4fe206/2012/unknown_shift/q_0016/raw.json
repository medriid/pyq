  "level": 1,
  "question": {
    "text": "The equations $2 x+3 y+4=0 ; 3 x+4 y+6=0$ and $4 x+5 y+8=0$ are",
    "image": null
  },
  "options": [
    {
      "id": "kCCWx",
      "text": "consistent with unique solution",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "C63P8",
      "text": "inconsistent",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "rwpSl",
      "text": "consistent with infinitely many solutions",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "oV3A2",
      "text": "None of the above",
      "isCorrect": false,
      "image": null
    }
