      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi><mi>b</mi><mi>c</mi><mo>-</mo><mi>a</mi><mo>-</mo><mi>b</mi><mo>-</mo><mi>c</mi><mo>+</mo><mn>3</mn><mo>=</mo><mn>0</mn></math>",
