  "question": {
    "text": "If $x$ is a complex root of the equation\n$\\left|\\begin{array}{ccc}1 & x & x \\\\ x & 1 & x \\\\ x & x & 1\\end{array}\\right|+\\left|\\begin{array}{ccc}1-x & 1 & 1 \\\\ 1 & 1-x & 1 \\\\ 1 & 1 & 1-x\\end{array}\\right|=0$,\nthen $x^{2007}+x^{-2007}=$",
    "image": null
  },
  "options": [
    {
      "id": "Nmdie",
      "text": "$1$",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GdKzx",
      "text": "$-1$",
      "image": null,
      "isCorrect": false
    },
    {
