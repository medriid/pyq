  "question": {
    "text": "If [ ] denotes the greatest integer less than or equal to the real number under consideration and $-1 \\leq x<0 ; 0 \\leq y<1 ; 1 \\leq z<2,$ then the value of the determinant\r\n\r\n<img src=\"assets\\qt0010_89b614ffb58a.png\"><br> is"
  },
  "options": [
    {
      "text": "$[z]$",
      "is_correct": true
    },
    {
      "text": "$[y]$",
      "is_correct": false
    },
    {
      "text": "$[\\mathrm{x}]$",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "Since, $-1 \\leq x<0$ $\\begin{array}{ll}\\therefore \\quad & {[\\mathrm{x}]=-1} \\\\ & 0 \\leq \\mathrm{y}<1 \\quad \\therefore[\\mathrm{y}]=0 \\\\ & 1 \\leq \\mathrm{z}<2 \\quad \\therefore[\\mathrm{z}]=1 \\\\ \\therefore \\quad & \\text { Given determinant }=\\left|\\begin{array}{ccc}0 & 0 & 1 \\\\ -1 & 1 & 1 \\\\ -1 & 0 & 2\\end{array}\\right|=1=[\\mathrm{z}]\\end{array}$"
  }
}