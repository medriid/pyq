    },
    {
      "id": "nIXX2",
      "text": "\\(-\\mathrm{M}(\\beta) \\mathrm{M}(\\alpha)\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\left.[\\mathrm{M}(\\alpha) \\mathrm{M}(\\beta)]^{-1}=\\mathrm{M}(\\beta)^{-1} \\mathrm{M}(\\alpha)^{-1}\\right] \\\\\n& \\operatorname{Now~M(\\alpha )^{-1}}=\\left[\\begin{array}{ccc}\n\\cos \\alpha & \\sin \\alpha & 0 \\\\\n-\\sin \\alpha & \\cos \\alpha & 0 \\\\\n0 & 0 & 1\n\\end{array}\\right] \\\\\n& =\\left[\\begin{array}{ccc}\n\\cos (-\\alpha) & -\\sin (-\\alpha) & 0 \\\\\n\\sin (-\\alpha) & \\cos (-\\alpha) & 0 \\\\\n0 & 0 & 1\n\\end{array}\\right]=\\mathrm{M}(-\\alpha) \\\\\n& M(\\beta)^{-1}=\\left[\\begin{array}{ccc}\n\\cos \\beta & 0 & -\\sin \\beta \\\\\n0 & 1 & 0 \\\\\n\\sin \\beta & 0 & \\cos \\beta\n\\end{array}\\right] \\\\\n& =\\left[\\begin{array}{ccc}\n\\cos (-\\beta) & 0 & \\sin (-\\beta) \\\\\n0 & 1 & 0 \\\\\n-\\sin (-\\beta) & 0 & \\cos (-\\beta)\n\\end{array}\\right]=\\mathrm{M}(-\\beta) \\\\\n& {[\\mathrm{M}(\\alpha) \\mathrm{M}(\\beta)]^{-1}=\\mathrm{M}(-\\beta) \\mathrm{M}(-\\alpha)} \\\\\n&\n\\end{aligned}\\)",
