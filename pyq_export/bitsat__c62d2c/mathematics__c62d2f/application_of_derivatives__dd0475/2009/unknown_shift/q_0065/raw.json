  "question": {
    "text": "The set of points of discontinuity of the function \\(1 / \\log |\\mathrm{x}|\\) is -",
    "image": null
  },
  "options": [
    {
      "id": "BhUbl",
      "text": "\\(\\{-1,0,1\\}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "kJgaH",
      "text": "\\(\\{0\\}\\)",
      "image": null,
      "isCorrect": false
    },
    {
