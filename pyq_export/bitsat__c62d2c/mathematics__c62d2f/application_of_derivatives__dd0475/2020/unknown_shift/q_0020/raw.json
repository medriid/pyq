  "level": 1,
  "question": {
    "text": "Let $x+y=3-\\cos 4 \\theta$ and $x-y=4 \\sin 2 \\theta$ then the greatest of $x y$ is",
    "image": null
  },
  "options": [
    {
      "id": "AF9ae",
      "text": "$\\frac{3}{4}$",
      "isCorrect": false,
      "image": null
    },
    {
