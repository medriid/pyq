  "question": {
    "text": "Let $x+y=3-\\cos 4 \\theta$ and $x-y=4 \\sin 2 \\theta$ then the greatest of $x y$ is"
  },
  "options": [
    {
      "text": "$\\frac{3}{4}$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": true
    },
    {
      "text": "$\\frac{1}{2}$",
      "is_correct": false
    },
    {
      "text": "2",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$x=\\frac{3-\\cos 4 \\theta+4 \\sin 2 \\theta}{2}$\r\n\r\n$=\\frac{3-\\left(1-\\sin ^{2} 2 \\theta\\right)+4 \\sin 2 \\theta}{2}=(1+\\sin 2 \\theta)^{2}$\r\n\r\n$y=\\frac{3-\\cos 4 \\theta-4 \\sin 2 \\theta}{2}$\r\n\r\n$=\\frac{3-\\left(1-\\sin ^{2} 2 \\theta\\right)+4 \\sin 2 \\theta}{2}=(1-\\sin 2 \\theta)^{2}$\r\n\r\n$\\therefore x y=\\left(1-\\sin ^{2} 2 \\theta\\right)^{2}=\\cos ^{4} 2 \\theta \\leq 1$"
  }
}