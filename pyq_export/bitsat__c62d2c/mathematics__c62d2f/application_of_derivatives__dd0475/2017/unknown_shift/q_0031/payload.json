  "question": {
    "text": "If the curve <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msup><mi>a</mi><mi>x</mi></msup></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi><mo>=</mo><msup><mi>b</mi><mi>x</mi></msup></math> intersect at angle <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>&#945;</mi></math>, then&nbsp;<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>tan</mi><mi>&#945;</mi></math> is equal to"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>-</mo><mi>b</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>a</mi><mi>b</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>log</mi><mi>a</mi><mo>-</mo><mi>log</mi><mi>b</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>log</mi><mi>a</mi><mi>log</mi><mi>b</mi></mrow></mfrac></math>",
      "is_correct": true
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>a</mi><mi>b</mi></mrow></mfrac></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><mi>log</mi><mi>a</mi><mo>+</mo><mi>log</mi><mi>b</mi></mrow><mrow><mn>1</mn><mo>-</mo><mi>log</mi><mi>a</mi><mi>log</mi><mi>b</mi></mrow></mfrac></math>",
      "is_correct": false
