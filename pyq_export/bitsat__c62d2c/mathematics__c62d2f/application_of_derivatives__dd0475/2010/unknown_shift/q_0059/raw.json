  "question": {
    "text": "The function \\(\\mathrm{f}(\\mathrm{x})=\\tan \\mathrm{x}-4 \\mathrm{x}\\) is strictly decreasing on",
    "image": null
  },
  "options": [
    {
      "id": "EnQB0",
      "text": "\\(\\left(-\\frac{\\pi}{3}, \\frac{\\pi}{3}\\right)\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "p3xEY",
      "text": "\\(\\left(\\frac{\\pi}{3}, \\frac{\\pi}{2}\\right)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "TEAnZ",
      "text": "\\(\\left(-\\frac{\\pi}{3}, \\frac{\\pi}{2}\\right)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "IWBnp",
      "text": "\\(\\left(\\frac{\\pi}{2}, \\pi\\right)\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(f(x)=\\tan x-4 x \\Rightarrow f^{\\prime}(x)=\\sec ^2 x-4\\)\nWhen \\(\\frac{-\\pi}{3}  < \\mathrm{x} < \\frac{\\pi}{3}, 1 < \\sec \\mathrm{x} < 2\\)\nTherefore, \\(1 < \\sec ^2 x < 4\\)\n\\(\\Rightarrow-3 < \\left(\\sec ^2 x-4\\right) < 0\\)\nThus, for \\(\\frac{-\\pi}{3} < \\mathrm{x} < \\frac{\\pi}{3}, \\mathrm{f}^{\\prime}(\\mathrm{x}) < 0\\)\nHence, \\(\\mathrm{f}\\) is strictly decreasing on \\(\\left(\\frac{-\\pi}{3}, \\frac{\\pi}{3}\\right)\\)",
    "image": null
  },
