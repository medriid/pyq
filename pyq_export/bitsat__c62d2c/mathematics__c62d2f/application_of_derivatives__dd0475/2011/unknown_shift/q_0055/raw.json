  "question": {
    "text": "The curve \\(y-e^{x y}+x=0\\) has a vertical tangent at",
    "image": null
  },
  "options": [
    {
      "id": "cv2Fy",
      "text": "\\((1,1)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "LUPbk",
      "text": "\\((0,1)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "HNQOp",
      "text": "\\((1,0)\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "evtXy",
      "text": "no point",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& y-e^{x y}+x=0 \\\\\n& \\therefore \\frac{d y}{d x}-e^{x y}\\left(y+x \\frac{d y}{d x}\\right)+1=0 \\\\\n& \\text {i.e., } \\frac{d y}{d x}-y(x+y)-x(x+y) \\frac{d y}{d x}+1=0 \\\\\n& \\text {i.e., }[1-x(x+y)] \\frac{d y}{d x}=y(x+y)-1\n\\end{aligned}\\)\nfor the vertical tangents\n\\(1-x(x+y)=0\\) i.e., \\(\\quad y=\\frac{1-x^2}{x}\\)\n\\(\\therefore \\mathrm{x}=1\\) and \\(\\mathrm{y}=0\\)",
    "image": null
  },
