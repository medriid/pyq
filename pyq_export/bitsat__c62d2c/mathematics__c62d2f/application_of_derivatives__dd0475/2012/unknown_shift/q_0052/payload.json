  "question": {
    "text": "If $\\mathrm{f}(\\mathrm{x})=\\frac{\\mathrm{a}^{2}-1}{\\mathrm{a}^{2}+1} \\mathrm{x}^{3}-3 \\mathrm{x}+5$ is a decreasing\r\nfunction of $\\mathrm{x}$ in $\\mathbf{R}$, then the set of possible values of a (independent of $\\mathrm{x}$ ) is"
  },
  "options": [
    {
      "text": "$(1, \\infty)$",
      "is_correct": false
    },
    {
      "text": "$(-\\infty,-1)$",
      "is_correct": false
    },
    {
      "text": "[-1,1]",
      "is_correct": true
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "$f^{\\prime}(x)=3\\left(\\frac{a^{2}-1}{a^{2}+1}\\right) x^{2}-3$\r\n$\\mathrm{f}^{\\prime}(\\mathrm{x})<0$ for all $\\mathrm{x}$ if $\\mathrm{a}^{2}-1 \\leq 0 \\Rightarrow-1 \\leq \\mathrm{a} \\leq 1$"
  }
}