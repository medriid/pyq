  "question": {
    "text": "If $\\mathrm{f}(\\mathrm{x})=\\frac{\\mathrm{a}^{2}-1}{\\mathrm{a}^{2}+1} \\mathrm{x}^{3}-3 \\mathrm{x}+5$ is a decreasing\r\nfunction of $\\mathrm{x}$ in $\\mathbf{R}$, then the set of possible values of a (independent of $\\mathrm{x}$ ) is",
    "image": null
  },
  "options": [
    {
      "id": "3sZXC",
      "text": "$(1, \\infty)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "hvfUN",
      "text": "$(-\\infty,-1)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Noekr",
      "text": "[-1,1]",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "rj9Ky",
      "text": "None of these",
      "isCorrect": false,
      "image": null
    }
