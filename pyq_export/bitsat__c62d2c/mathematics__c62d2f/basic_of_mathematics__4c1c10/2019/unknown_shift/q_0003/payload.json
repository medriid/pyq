  "question": {
    "text": "If <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>=</mo><msub><mi>log</mi><mn>5</mn></msub><mn>3</mn><mo>+</mo><msub><mi>log</mi><mn>7</mn></msub><mn>5</mn><mo>+</mo><msub><mi>log</mi><mn>9</mn></msub><mn>7</mn></math>, then"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>&#62;</mo><mfrac><mn>3</mn><mn>2</mn></mfrac></math>",
