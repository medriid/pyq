  "question": {
    "text": "The solution set of $(x-2)^{x^3-6 x+8}>1$ is"
  },
  "options": [
    {
      "text": "$(2, \\infty)$",
      "is_correct": false
    },
    {
      "text": "$(2,3) \\cup(4, \\infty)$",
      "is_correct": true
    },
    {
      "text": "$(4,5) \\cup(5, \\infty)$",
      "is_correct": false
    },
    {
      "text": "$(2,3) \\cup(4,5)$",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Clearly $x>2$. Write the given inequality<br />as<br />$\\begin{aligned}<br />& \\left(x^2-6 x+8\\right) \\log (x-2)>0 \\Leftrightarrow(x-2)(x-4) \\log (x-2)> \\\\<br />& 0 \\\\<br />& \\Leftrightarrow(x-4) \\log (x-2)>0 \\quad[\\therefore x>2]<br />\\end{aligned}$<br /><img src=\"assets\\st0000_7bf457fa112e.png\"><br>"
  }
}