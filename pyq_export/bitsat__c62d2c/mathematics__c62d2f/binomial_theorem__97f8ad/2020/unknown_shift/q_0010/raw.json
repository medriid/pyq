  "question": {
    "text": "If a, b, c are three natural numbers in AP and a + $\\mathrm{b}+\\mathrm{c}=21$ then the possible number of values of the ordered triplet $(\\mathrm{a}, \\mathrm{b}, \\mathrm{c})$ is",
    "image": null
  },
  "options": [
