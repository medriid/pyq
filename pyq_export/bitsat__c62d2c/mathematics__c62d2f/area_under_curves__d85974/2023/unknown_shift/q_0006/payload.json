  "question": {
    "text": "The area enclosed between the curve $y=\\log _e(x+e)$ and the coordinate axes is"
  },
  "options": [
    {
      "text": "1",
      "is_correct": true
    },
    {
      "text": "2",
      "is_correct": false
    },
    {
      "text": "3",
      "is_correct": false
    },
    {
      "text": "4",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "<br /><img src=\"assets\\st0006_11f58b3d291e.png\"><br><br />Required area $A=\\int_{1-e}^0 y d x=\\int_{1-e}^0 \\log _e(x+e) d x$<br />put $x+e=t \\Rightarrow d x=d t$ also when $x=1-e, t=$ 1 and when $x=0, t=e$<br />$\\therefore A=\\int_1^e \\log _e t d t=\\left[t \\log _e t-t\\right]_1^e$<br />$e-e-0+1=1$"
  }
}