  "correctValue": null,
  "solution": {
    "text": "Required area \\(=\\int_0^{\\frac{\\pi}{4}} \\tan x d x\\)\n\\(=\\ln |\\sec 1|_0^{\\frac{\\pi}{4}}=\\ln \\sqrt{2}=\\frac{\\ln 2}{2}\\)",
    "image": null
  },
