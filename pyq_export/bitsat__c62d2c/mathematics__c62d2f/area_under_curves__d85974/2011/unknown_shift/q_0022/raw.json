  "question": {
    "text": "What is the area bounded by \\(y=\\tan x, y=0\\) and \\(x=\\frac{\\pi}{4} ?\\)",
    "image": null
  },
  "options": [
    {
      "id": "t4g3P",
      "text": "\\(\\ell n ~2~ \\mathrm{sq}\\). units",
      "image": null,
      "isCorrect": false
    },
    {
