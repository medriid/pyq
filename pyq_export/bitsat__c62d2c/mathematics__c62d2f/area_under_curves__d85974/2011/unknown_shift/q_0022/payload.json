  "question": {
    "text": "What is the area bounded by \\(y=\\tan x, y=0\\) and \\(x=\\frac{\\pi}{4} ?\\)"
  },
  "options": [
    {
      "text": "\\(\\ell n ~2~ \\mathrm{sq}\\). units",
      "is_correct": false
    },
    {
      "text": "\\(\\frac{\\ell n 2}{2} ~\\mathrm{sq}\\). units",
      "is_correct": true
    },
    {
      "text": "\\(2~(\\ell n ~2)~ \\mathrm{sq}\\). units",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "Required area \\(=\\int_0^{\\frac{\\pi}{4}} \\tan x d x\\)\n\\(=\\ln |\\sec 1|_0^{\\frac{\\pi}{4}}=\\ln \\sqrt{2}=\\frac{\\ln 2}{2}\\)"
  }
