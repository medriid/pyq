  "question": {
    "text": "The area bounded by the curve $y=\\sin x, x$ -axis and the ordinates $x=0$ and $x=\\pi / 2$ is",
    "image": null
  },
  "options": [
    {
      "id": "MGgkb",
      "text": "$\\pi$",
