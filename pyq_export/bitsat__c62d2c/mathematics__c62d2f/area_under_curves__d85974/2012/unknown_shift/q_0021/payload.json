  },
  "question": {
    "text": "The area bounded by the curve $y=\\sin x, x$ -axis and the ordinates $x=0$ and $x=\\pi / 2$ is"
  },
  "options": [
    {
      "text": "$\\pi$",
      "is_correct": false
    },
    {
      "text": "$\\pi / 2$",
      "is_correct": false
    },
    {
      "text": "1",
      "is_correct": true
    },
    {
      "text": "2",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Area $=\\int_{0}^{\\pi / 2} \\mathrm{y} \\mathrm{dx}=\\int_{0}^{\\pi / 2} \\sin \\mathrm{x} \\mathrm{dx}=[-\\cos \\mathrm{x}]_{0}^{\\pi / 2}=1$"
  }
}