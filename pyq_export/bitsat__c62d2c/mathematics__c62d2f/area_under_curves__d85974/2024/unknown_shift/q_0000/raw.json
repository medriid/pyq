  "question": {
    "text": "The area enclosed by the curves $y=x^3$ and $y=\\sqrt{x}$ is",
    "image": null
  },
  "options": [
    {
      "id": "cpBaA",
      "text": "$\\frac{5}{3}$ sq. units",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "XNQUu",
      "text": "$\\frac{5}{4}$ sq. units",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "tptoX",
      "text": "$\\frac{5}{12}$ sq. unit",
      "image": null,
      "isCorrect": true
