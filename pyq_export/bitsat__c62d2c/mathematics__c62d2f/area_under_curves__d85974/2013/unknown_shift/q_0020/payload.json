  "question": {
    "text": "Area intercepted by the curves $y=\\cos x$ $\\mathrm{x} \\in[0, \\pi]$ and $\\mathrm{y}=\\cos 2 \\mathrm{x}, \\mathrm{x} \\in[0, \\pi],$ is"
  },
  "options": [
    {
      "text": "$\\frac{3 \\pi}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3 \\sqrt{3}}{2}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3 \\pi}{4}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{3 \\sqrt{3}}{4}$",
      "is_correct": true
    }
  ],
  "correct_answer": [
