  "solution": {
    "text": "\\({ }^{20} \\mathrm{C}_{\\mathrm{r}}={ }^{20} \\mathrm{C}_{\\mathrm{r}-10} \\Rightarrow \\mathrm{r}+(\\mathrm{r}-10)=20 \\Rightarrow \\mathrm{r}=15\\)\n\\(\\therefore \\quad{ }^{18} \\mathrm{C}_{\\mathrm{r}}={ }^{18} \\mathrm{C}_{15}={ }^{18} \\mathrm{C}_3=\\frac{18 \\cdot 17 \\cdot 16}{1 \\cdot 2 \\cdot 3}=816\\)"
  }
