  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "The number of all three elements subsets of the set $\\left\\{a_{1}, a_{2}, a_{3} \\ldots a_{n}\\right\\}$ which contain $a_{3}$ is",
    "image": null
  },
  "options": [
    {
      "id": "fHPO4",
      "text": "${ }^{\\mathrm{n}} \\mathrm{C}_{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "yOAK0",
      "text": "${ }^{\\mathrm{n}-1} \\mathrm{C}_{3}$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "1gjJH",
      "text": "${ }^{\\mathrm{n}-1} \\mathrm{C}_{2}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "Dz2HF",
      "text": "None of these",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "The number of three elements subsets containing $\\mathrm{a}_{3}$ is equal to the number of ways of selecting 2 elements out of $\\mathrm{n}-1$ elements. So, the required number of subsets is ${ }^{\\mathrm{n}-1} \\mathrm{C}_{2}$",
    "image": null
  },
