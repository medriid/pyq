  "question": {
    "text": "If a parallelogram is cut by two sets of <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>m</mi></math> lines parallel to its sides, then the number of parallelogram thus formed, is"
  },
  "options": [
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mmultiscripts><mi>C</mi><mn>2</mn><none/><mprescripts/><none/><mi>m</mi></mmultiscripts><mo>&#215;</mo><mmultiscripts><mi>C</mi><mn>2</mn><none/><mprescripts/><none/><mi>m</mi></mmultiscripts></math>",
      "is_correct": false
    },
    {
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mfenced><mmultiscripts><mi>C</mi><mn>2</mn><none/><mprescripts/><none/><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></mmultiscripts></mfenced></math>",
