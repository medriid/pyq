  "question": {
    "text": "If \\(\\frac{2 x+3}{5}  < \\frac{4 x-1}{2}\\), then \\(x\\) lies in the interval",
    "image": null
  },
  "options": [
    {
      "id": "3M8Nm",
      "text": "\\(\\left[0, \\frac{11}{16}\\right)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "R8cp2",
      "text": "\\(\\left[\\frac{11}{16}, \\infty\\right)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "VJIxz",
      "text": "\\(\\left(0, \\frac{11}{16}\\right)\\)",
      "image": null,
