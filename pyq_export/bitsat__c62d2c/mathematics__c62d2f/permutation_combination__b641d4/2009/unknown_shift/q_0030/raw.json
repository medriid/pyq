    },
    {
      "id": "KyEtc",
      "text": "\\(\\left(\\frac{11}{16}, \\infty\\right)\\)",
      "image": null,
      "isCorrect": true
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\frac{2 x+3}{5}  < \\frac{4 x-1}{2} \\Rightarrow-16 x < -11 \\\\\n& \\Rightarrow 16 x > 11 \\Rightarrow x > \\frac{11}{16} \\\\\n& \\text { Hence, } x \\in\\left(\\frac{11}{16}, \\infty\\right)\n\\end{aligned}\\)",
    "image": null
  },
