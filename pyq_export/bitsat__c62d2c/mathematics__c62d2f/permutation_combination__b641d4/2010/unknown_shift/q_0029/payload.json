  "question": {
    "text": "If \\(\\frac{1-i \\alpha}{1+i \\alpha}=A+i B\\), then \\(A^2+B^2\\) equals to"
  },
  "options": [
    {
      "text": "1",
      "is_correct": true
    },
    {
      "text": "\\(\\alpha^2\\)",
      "is_correct": false
    },
    {
      "text": "-1",
      "is_correct": false
    },
    {
      "text": "\\(-\\alpha^2\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& A+i B=\\frac{1-i \\alpha}{1+i \\alpha} \\Rightarrow A-i B=\\frac{1+i \\alpha}{1-i \\alpha} \\\\\n& \\Rightarrow(A+i B)(A-i B)=\\frac{(1-i \\alpha)(1+i \\alpha)}{(1+i \\alpha)(1-i \\alpha)}=1 \\\\\n& \\Rightarrow A^2+B^2=1\n\\end{aligned}\\)"
  }
}