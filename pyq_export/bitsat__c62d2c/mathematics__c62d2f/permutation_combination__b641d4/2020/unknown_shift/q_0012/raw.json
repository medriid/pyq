  "type": "singleCorrect",
  "level": 2,
  "question": {
    "text": "The number of possible outcomes in a throw of n ordinary dice in which at least one of the dice shows an odd number is",
    "image": null
  },
  "options": [
    {
      "id": "iGfWN",
      "text": "$6^{n}-1$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "o4Boz",
      "text": "$3^{n}-1$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "fE4eO",
      "text": "$6^{n}-3^{n}$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "eN4XZ",
      "text": "None of these",
      "isCorrect": false,
      "image": null
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "Total number of ways $=6 \\times 6 \\times \\ldots \\ldots$ to $n$ times $=6^{n}$ Total number of ways to show only even number $=3 \\times 3 \\times \\ldots \\ldots$ to $n$ times $=3^{n}$\r\n\r\n$\\therefore$ required number of ways $=6^{\\mathrm{n}}-3^{\\mathrm{n}}$",
    "image": null
  },
