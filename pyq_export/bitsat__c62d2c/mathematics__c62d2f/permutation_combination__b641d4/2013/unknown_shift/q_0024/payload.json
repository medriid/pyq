  "question": {
    "text": "In how many ways can 5 boys and 5 girls be seated at a round table so that no two girls may be together?"
  },
  "options": [
    {
      "text": "$4 !$",
      "is_correct": false
    },
    {
      "text": "$5 !$",
      "is_correct": false
    },
    {
      "text": "$4 !+5 !$",
      "is_correct": false
    },
    {
      "text": "$4 ! \\times 5 !$",
      "is_correct": true
    }
  ],
  "correct_answer": [
    "D"
  ],
  "solution": {
    "text": "Leaving one seat vacant between two boys, 5 boys may be seated in $4 !$ ways. Then at remaining 5 seats, 5 girls any sit in $5 !$ ways. Hence the required number $=4 ! \\times 5 !$"
  }
}