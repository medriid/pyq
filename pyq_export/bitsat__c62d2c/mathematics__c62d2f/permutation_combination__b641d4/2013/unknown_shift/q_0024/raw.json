  "type": "singleCorrect",
  "level": 1,
  "question": {
    "text": "In how many ways can 5 boys and 5 girls be seated at a round table so that no two girls may be together?",
    "image": null
  },
  "options": [
    {
      "id": "HWyq8",
      "text": "$4 !$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "Mop3w",
      "text": "$5 !$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "6FbeW",
      "text": "$4 !+5 !$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "ORcqj",
      "text": "$4 ! \\times 5 !$",
      "isCorrect": true,
      "image": null
