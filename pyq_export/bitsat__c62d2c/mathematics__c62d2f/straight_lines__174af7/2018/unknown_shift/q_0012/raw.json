      "id": "cxUjC",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mn>7</mn><mi>y</mi><mo>+</mo><mn>13</mn><mo>=</mo><mn>0</mn><mtext>&#160;or&#160;</mtext><mn>7</mn><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mn>9</mn><mo>=</mo><mn>0</mn></math>",
