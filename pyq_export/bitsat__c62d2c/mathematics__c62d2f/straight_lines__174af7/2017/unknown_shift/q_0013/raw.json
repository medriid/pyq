  "question": {
    "text": "Two equal sides of an isosceles triangle are <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>7</mn><mi>x</mi><mo>-</mo><mi>y</mi><mo>+</mo><mn>3</mn><mo>=</mo><mn>0</mn></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mi>y</mi><mo>-</mo><mn>3</mn><mo>=</mo><mn>0</mn></math> and its third side passes through the point <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>(</mo><mn>1</mn><mo>,</mo><mo>-</mo><mn>10</mn><mo>)</mo></math>. The equation of the third side is",
    "image": null
  },
  "options": [
    {
      "id": "hqcRN",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo><mn>3</mn><mi>y</mi><mo>=</mo><mo>-</mo><mn>31</mn></math>",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "gNSsU",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>-</mo><mn>3</mn><mi>y</mi><mo>=</mo><mn>31</mn></math>",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "JxkmT",
      "text": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo>=</mo><mn>31</mn></math>",
      "isCorrect": false,
