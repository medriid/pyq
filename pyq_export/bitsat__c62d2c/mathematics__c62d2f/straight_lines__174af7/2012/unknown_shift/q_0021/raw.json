  "question": {
    "text": "The nearest point on the line $3 x+4 y=12$ from the origin is",
    "image": null
  },
  "options": [
    {
      "id": "imRZC",
      "text": "$\\left(\\frac{36}{25}, \\frac{48}{25}\\right)$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "a4Ydq",
      "text": "$\\left(3, \\frac{3}{4}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "BaYep",
      "text": "$\\left(2, \\frac{3}{2}\\right)$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "J143D",
      "text": "None of these",
      "isCorrect": false,
      "image": null
    }
