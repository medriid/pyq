  "question": {
    "text": "The distance between the parallel lines $3 x-4 y+7=0$ and $3 x-4 y+5=0$ is $\\frac{a}{b}$. Value of $a+b$ is"
  },
  "options": [
    {
      "text": "2",
      "is_correct": false
    },
    {
      "text": "5",
      "is_correct": false
    },
    {
      "text": "7",
      "is_correct": true
    },
    {
      "text": "3",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "C"
  ],
  "solution": {
    "text": "Given parallel lines are\r\n\r\n$3 x-4 y+7=0$ and $3 x-4 y+5=0$\r\n\r\nRequired distance $=\\frac{|7-5|}{\\sqrt{(3)^{2}+(-4)^{2}}}=\\frac{2}{5}$ $\\Rightarrow a=2, b=5$"
  }
}