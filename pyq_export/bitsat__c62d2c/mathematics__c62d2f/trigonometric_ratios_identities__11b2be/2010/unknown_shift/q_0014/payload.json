  "question": {
    "text": "If \\(\\mathrm{P}(\\mathrm{A} \\cup \\mathrm{B})=\\frac{2}{3}, \\mathrm{P}(\\mathrm{A} \\cap \\mathrm{B})=\\frac{1}{6}\\) and \\(\\mathrm{P}(\\mathrm{A})=\\frac{1}{3}\\) then"
  },
  "options": [
    {
      "text": "A and \\(\\mathrm{B}\\) are independent events",
      "is_correct": true
    },
    {
      "text": "A and \\(\\mathrm{B}\\) are disjoint events",
      "is_correct": false
    },
    {
      "text": "A and \\(\\mathrm{B}\\) are dependent events",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "A"
  ],
  "solution": {
    "text": "\\(\\mathrm{P}(\\mathrm{A} \\cup \\mathrm{B})=\\mathrm{P}(\\mathrm{A})+\\mathrm{P}(\\mathrm{B})-\\mathrm{P}(\\mathrm{AB})\\)\n\\(\\Rightarrow \\frac{2}{3}=\\frac{1}{3}+\\mathrm{P}(\\mathrm{B})-\\frac{1}{6} \\Rightarrow \\mathrm{P}(\\mathrm{B})=\\frac{1}{2}\\)\nNow, \\(\\mathrm{P}(\\mathrm{AB})=\\mathrm{P}(\\mathrm{A})~ \\mathrm{P}(\\mathrm{B}), \\mathrm{A}\\) and \\(\\mathrm{B}\\) are independent events."
  }
}