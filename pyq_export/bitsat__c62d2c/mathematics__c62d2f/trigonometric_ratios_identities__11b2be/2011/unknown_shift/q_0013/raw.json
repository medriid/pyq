  "question": {
    "text": "If, \\(\\tan \\mathrm{A}=\\frac{1}{2}\\) and \\(\\tan B=\\frac{1}{3}\\), then find the value of \\(\\mathrm{A}+\\mathrm{B}\\)",
    "image": null
  },
  "options": [
    {
      "id": "s0jD3",
      "text": "\\(\\pi\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "GhI1P",
      "text": "\\(\\frac{\\pi}{2}\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "crgYa",
      "text": "\\(\\frac{\\pi}{4}\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "XnitJ",
      "text": "\\(\\frac{-\\pi}{4}\\)",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\tan (A+B)=\\frac{\\tan A+\\tan B}{1-\\tan A \\tan B}=\\frac{\\frac{1}{2}+\\frac{1}{3}}{1-\\frac{1}{2} \\cdot \\frac{1}{3}}=1 \\\\\n& \\therefore A+B=45^{\\circ}=\\frac{\\pi}{4}\n\\end{aligned}\\)",
    "image": null
  },
