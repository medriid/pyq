  "question": {
    "text": "\\(\\frac{\\cos \\theta}{1-\\tan \\theta}+\\frac{\\sin \\theta}{1-\\cot \\theta}\\) is equal to"
  },
  "options": [
    {
      "text": "\\(\\sin \\theta-\\cos \\theta\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\sin \\theta+\\cos \\theta\\)",
      "is_correct": true
    },
    {
      "text": "\\(\\tan \\theta+\\cot \\theta\\)",
      "is_correct": false
    },
    {
      "text": "\\(\\tan \\theta-\\cot \\theta\\)",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\frac{\\cos \\theta}{1-\\tan \\theta}+\\frac{\\sin \\theta}{1-\\cot \\theta}=\\frac{\\cos \\theta}{1-\\frac{\\sin \\theta}{\\cos \\theta}}+\\frac{\\sin \\theta}{1-\\frac{\\cos \\theta}{\\sin \\theta}} \\\\\n= & \\frac{\\cos ^2 \\theta}{\\cos \\theta-\\sin \\theta}-\\frac{\\sin ^2 \\theta}{\\cos \\theta-\\sin \\theta}=\\cos \\theta+\\sin \\theta\n\\end{aligned}\\)"
  }
}