  "question": {
    "text": "If $\\cos ^{-1} x-\\cos ^{-1} \\frac{y}{2}=\\alpha$,\r\n\r\nthen $4 x^{2}-4 x y \\cos \\alpha+y^{2}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "zlyom",
      "text": "$2 \\sin 2 \\alpha$",
      "isCorrect": false,
      "image": null
    },
