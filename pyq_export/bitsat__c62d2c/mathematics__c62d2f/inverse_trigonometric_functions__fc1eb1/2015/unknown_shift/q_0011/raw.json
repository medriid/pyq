      "text": "$4 \\sin ^{2} \\alpha$",
      "isCorrect": true,
      "image": null
    },
    {
      "id": "X82wc",
      "text": "$-4 \\sin ^{2} \\alpha$",
      "isCorrect": false,
      "image": null
