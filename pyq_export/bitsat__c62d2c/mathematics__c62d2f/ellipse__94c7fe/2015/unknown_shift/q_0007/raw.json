  "question": {
    "text": "The eccentricity of an ellipse, with its centre at the origin, is $1 / 2$. If one of the directrices is $\\mathrm{x}=4$ then the equation of the ellipse is:",
    "image": null
  },
  "options": [
    {
      "id": "38qfY",
      "text": "$4 x^{2}+3 y^{2}=1$",
      "isCorrect": false,
      "image": null
    },
    {
      "id": "qPMhj",
      "text": "$3 x^{2}+4 y^{2}=12$",
