  "question": {
    "text": "If \\(\\arg \\left(\\bar{z}_1\\right)=\\arg \\left(z_2\\right)\\), then",
    "image": null
  },
  "options": [
    {
      "id": "zxilx",
      "text": "\\(\\mathrm{z}_2=\\mathrm{kz}_1^{-1}(\\mathrm{k} > 0)\\)",
      "image": null,
      "isCorrect": true
    },
    {
      "id": "BnSy6",
      "text": "\\(\\mathrm{z}_2=k \\mathrm{z}_1(\\mathrm{k} > 0)\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "1NVCy",
      "text": "\\(\\left|z_2\\right|=\\left|\\bar{z}_1\\right|\\)",
      "image": null,
      "isCorrect": false
    },
    {
      "id": "k0JWV",
      "text": "None of these",
      "image": null,
      "isCorrect": false
    }
  ],
  "correctValue": null,
  "solution": {
    "text": "\\(\\begin{aligned}\n& \\bar{z}_1=\\frac{z_1 \\bar{z}_1}{z_1}=\\left|\\mathrm{z}_1\\right|^2 \\mathrm{z}_1^{-1} \\\\\n& \\Rightarrow \\arg \\left(\\mathrm{z}_1^{-1}\\right)=\\arg \\left(\\bar{z}_1\\right) \\Rightarrow \\arg \\left(\\mathrm{z}_2\\right) \\\\\n& \\Rightarrow \\mathrm{z}_2=\\mathrm{kz}_1^{-1}(\\mathrm{k} > 0)\n\\end{aligned}\\)",
    "image": null
  },
