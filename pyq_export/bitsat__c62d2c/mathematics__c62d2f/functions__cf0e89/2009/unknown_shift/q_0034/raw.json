  "question": {
    "text": "If \\(y=e^{-x} \\cos x\\) and \\(y_4+k y=0\\), where \\(y_4=\\frac{d^4 y}{d x^4}\\), then \\(k=\\)",
    "image": null
  },
  "options": [
    {
      "id": "69RcV",
