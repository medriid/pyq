  "question": {
    "text": "Consider the function $\\mathrm{f}$ in $\\mathrm{A}=\\mathrm{R}-\\left\\{\\frac{2}{3}\\right\\}$ defined as $f(x)=\\frac{4 x+3}{6 x-4}$, then $f^{-1}$ is equal to",
    "image": null
  },
  "options": [
    {
      "id": "P0Pt7",
      "text": "$\\frac{3+4 x}{6 x-4}$",
      "image": null,
      "isCorrect": true
    },
    {
