  "question": {
    "text": "If $f(x)=\\frac{x}{\\sqrt{1+x^2}}$, then (fof of) $(x)$ is"
  },
  "options": [
    {
      "text": "$\\frac{3 x}{\\sqrt{1+x^2}}$",
      "is_correct": false
    },
    {
      "text": "$\\frac{x}{\\sqrt{1+3 x^2}}$",
      "is_correct": true
    },
    {
      "text": "$\\frac{3 x}{\\sqrt{1-x^2}}$",
      "is_correct": false
    },
    {
      "text": "None of these",
      "is_correct": false
    }
  ],
  "correct_answer": [
    "B"
  ],
  "solution": {
    "text": "$f(x)=\\frac{x}{\\sqrt{1+x^2}}$<br />fof$=\\frac{\\frac{x}{\\sqrt{1+x^2}}}{\\sqrt{1+\\frac{x^2}{1+x^2}}}=\\frac{x}{\\sqrt{2 x^2+1}}$<br />fofof $=\\frac{\\frac{x}{\\sqrt{2 x^2+1}}}{\\sqrt{1+\\frac{x^2}{2 x^2+1}}}=\\frac{x}{\\sqrt{1+3 x^2}}$"
  }
}